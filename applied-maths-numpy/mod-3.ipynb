          "python",
          "import numpy as np\n\n# Linear algebra basics for ML\n# Vectors\nv1 = np.array([1, 2, 3])\nv2 = np.array([4, 5, 6])\n\ndot_product = np.dot(v1, v2)  # scalar: 32\nprint(f\"Dot product: {dot_product}\")\n\n# Matrices\nA = np.array([[1, 2], [3, 4]])\nB = np.array([[5, 6], [7, 8]])\n\nproduct = A @ B  # matrix multiplication\nprint(f\"Matrix product:\\n{product}\")\n\n# Eigenvalues (important for PCA, etc.)\neigenvalues, eigenvectors = np.linalg.eig(A)\nprint(f\"\\nEigenvalues: {eigenvalues}\")\n\n# Statistics\ndata = np.random.normal(0, 1, 1000)\nprint(f\"\\nMean: {data.mean():.4f}\")\nprint(f\"Std: {data.std():.4f}\")\nprint(f\"Variance: {data.var():.4f}\")\n\n# Gradient descent (core of ML optimization)\ndef gradient_descent(f_grad, x0, lr=0.01, steps=100):\n    x = x0\n    for _ in range(steps):\n        x = x - lr * f_grad(x)\n    return x\n\n# Minimize f(x) = x^2, gradient = 2x\nminimum = gradient_descent(lambda x: 2*x, x0=5.0)\nprint(f\"\\nMinimum of x\u00b2: {minimum:.6f}\")  # \u2248 0"
        ]
      ]
    }
