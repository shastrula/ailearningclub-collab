          "python",
          "import numpy as np\n\n# Approximate derivative using finite differences\ndef derivative(f, x, h=1e-5):\n    return (f(x + h) - f(x - h)) / (2 * h)\n\n# Example: f(x) = x\u00b2\ndef f(x):\n    return x**2\n\n# Derivative at x=3 should be 6\nprint(derivative(f, 3))  # \u2248 6.0"
        ]
      ]
    }
