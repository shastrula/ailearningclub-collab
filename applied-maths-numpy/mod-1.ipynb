      "source": [
        [
          "python",
          "import numpy as np\n\n# 1D array (vector)\na = np.array([1, 2, 3])\n\n# 2D array (matrix)\nA = np.array([[1, 2], [3, 4]])\n\n# Array of zeros\nzeros = np.zeros((2, 3))\n\n# Array of ones\nones = np.ones((2, 3))\n\n# Range of values\nrange_arr = np.arange(0, 10, 2)  # [0, 2, 4, 6, 8]\n\n# Random array\nrandom_arr = np.random.rand(3, 3)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "a = np.array([1, 2, 3])\nb = np.array([4, 5, 6])\n\n# Element-wise operations\nprint(a + b)      # [5, 7, 9]\nprint(a * b)      # [4, 10, 18]\nprint(a / b)      # [0.25, 0.4, 0.5]\n\n# Scalar operations\nprint(a * 2)      # [2, 4, 6]\nprint(a + 10)     # [11, 12, 13]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "A = np.array([[1, 2, 3], [4, 5, 6]])\n\nprint(A.shape)    # (2, 3) - 2 rows, 3 columns\nprint(A.size)     # 6 - total elements\nprint(A.dtype)    # int64 - data type\nprint(A.ndim)     # 2 - number of dimensions"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "a = np.array([10, 20, 30, 40, 50])\n\nprint(a[0])       # 10 - first element\nprint(a[-1])      # 50 - last element\nprint(a[1:4])     # [20, 30, 40] - elements 1 to 3\nprint(a[::2])     # [10, 30, 50] - every 2nd element"
        ]
      ]
    },
