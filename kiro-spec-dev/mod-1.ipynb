      "source": [
        [
          "typescript",
          "// Kiro spec-driven development patterns\n\ninterface Requirement {\n  id: string;\n  description: string;\n  acceptance_criteria: string[];\n}\n\ninterface DesignDoc {\n  requirements: Requirement[];\n  architecture: string;\n  implementation_plan: string[];\n}\n\n// Example: Define a feature spec\nconst feature: DesignDoc = {\n  requirements: [\n    {\n      id: \"REQ-001\",\n      description: \"User authentication with OAuth\",\n      acceptance_criteria: [\n        \"Users can sign in with Google\",\n        \"Session persists across page reloads\",\n        \"Sign out clears all session data\"\n      ]\n    }\n  ],\n  architecture: \"Client-side OAuth flow with JWT tokens\",\n  implementation_plan: [\n    \"Set up OAuth provider configuration\",\n    \"Implement sign-in flow\",\n    \"Add session management\",\n    \"Create protected route middleware\",\n    \"Write integration tests\"\n  ]\n};\n\nconsole.log(`Feature: ${feature.requirements[0].description}`);\nconsole.log(`Steps: ${feature.implementation_plan.length}`);"
        ]
      ]
    }
  ],
