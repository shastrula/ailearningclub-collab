{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Conda Package Management And Environments - mod-2\n\n",
        "**Course:** conda-package-management-and-environments\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Download (substitute arm64 for Apple Silicon)\ncurl -o ~/miniconda.sh https://repo.anaconda.com/miniconda/Miniconda3-latest-MacOSX-x86_64.sh\n\n# Install\nbash ~/miniconda.sh\n\n# Respond to prompts:\n# - Read license (press ENTER, then Q)\n# - Type \"yes\" to accept license\n# - Press ENTER for default location\n# - Type \"yes\" to initialize conda\n\n# Clean up\nrm ~/miniconda.sh\n\n# Verify (open new terminal)\nconda --version"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Download (choose linux version)\nwget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh\n\n# Or with curl\ncurl -o ~/miniconda.sh https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh\n\n# Install\nbash ~/miniconda.sh\n\n# Follow prompts (yes to initialize)\n\n# Clean up\nrm ~/miniconda.sh\n\n# Refresh shell\nsource ~/.bashrc  # Or source ~/.zshrc if using zsh\n\n# Verify\nconda --version"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "powershell",
          "# Download (this downloads to your Downloads folder)\nInvoke-WebRequest -Uri \"https://repo.anaconda.com/miniconda/Miniconda3-latest-Windows-x86_64.exe\" -OutFile ~/Downloads/miniconda.exe\n\n# Install (may require admin privileges)\n~/Downloads/miniconda.exe /InstallationType=JustMe /RegisterPython=0 /S /D=%UserProfile%\\miniconda3\n\n# Close and reopen PowerShell\n\n# Verify\nconda --version"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Check version\nconda --version\n# Output: conda 23.5.0\n\n# See conda info\nconda info\n# Output shows:\n#   base environment: /Users/username/miniconda3\n#   conda version: 23.5.0\n#   python version: 3.11.0\n#   channels: defaults\n#   etc.\n\n# List environments\nconda env list\n# Output:\n# # conda environments:\n# #\n# base                  *  /Users/username/miniconda3\n\n# Update conda itself\nconda update conda\n\n# Check which Python is active\nwhich python  # or \"where python\" on Windows\n# Output: /Users/username/miniconda3/bin/python\n\n# Verify Python version\npython --version\n# Output: Python 3.11.0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Install mamba in base environment\nconda install -c conda-forge mamba\n\n# Now use mamba instead of conda for faster installs\nmamba create -n myenv python=3.11\nmamba install numpy pandas\n\n# mamba uses identical syntax to conda"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Add conda-forge as default\nconda config --add channels conda-forge\n\n# Verify channels\nconda config --show channels\n# Output:\n# channels:\n#   - conda-forge\n#   - defaults\n\n# Set priority (strict = conda-forge first)\nconda config --set channel_priority strict\n\n# View configuration file\ncat ~/.condarc  # On Windows: %USERPROFILE%\\.condarc"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Don't auto-activate base\nconda config --set auto_activate_base false\n\n# Manually activate when needed\nconda activate base"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# View what conda added\ncat ~/.bashrc | grep conda\n\n# If not present, initialize conda in your shell\nconda init bash  # or zsh, fish, powershell, etc.\n\n# Then reload\nsource ~/.bashrc"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Default channel (Anaconda curated)\nconda install numpy\n# Searches: https://repo.anaconda.com/pkgs/main\n\n# conda-forge (community)\nconda install -c conda-forge numpy\n# Searches: https://conda-forge.org\n\n# Multiple channels\nconda install -c conda-forge -c defaults numpy\n# Searches conda-forge first, then defaults\n\n# View active channels\nconda config --show channels\n\n# Permanently add channel\nconda config --add channels conda-forge"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Find conda installation\nfind ~ -name \"conda\" -type f\n\n# If found, add to PATH\nexport PATH=\"/path/to/miniconda3/bin:$PATH\"\n\n# Or reinitialize\n~/miniconda3/bin/conda init bash\nsource ~/.bashrc"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Installer script needs execute permission\nchmod +x ~/miniconda.sh\nbash ~/miniconda.sh"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create lean environment for development\nconda create -n dev python=3.11\n\n# Keep base minimal\nconda remove --name base numpy pandas  # etc."
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Install mamba\nconda install -c conda-forge mamba\n\n# Use for installations\nmamba install numpy pandas scipy\n# Much faster!"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "~/miniconda3/                   # Installation root\n\u251c\u2500\u2500 bin/                        # Executables (python, conda, pip)\n\u251c\u2500\u2500 lib/                        # Libraries (site-packages, system libs)\n\u251c\u2500\u2500 include/                    # C headers\n\u251c\u2500\u2500 envs/                       # Additional environments\n\u2502   \u251c\u2500\u2500 myenv/                 # First environment\n\u2502   \u2502   \u251c\u2500\u2500 bin/\n\u2502   \u2502   \u251c\u2500\u2500 lib/\n\u2502   \u2502   \u2514\u2500\u2500 ...\n\u2502   \u2514\u2500\u2500 another-env/           # Second environment\n\u251c\u2500\u2500 pkgs/                       # Package cache\n\u2514\u2500\u2500 conda-meta/                 # Metadata about installations\n\n# By default, environments are in ~/miniconda3/envs\n# You can change this with CONDA_ENVS_PATH\n\nexport CONDA_ENVS_PATH=\"/custom/path\"\nconda info  # Will show custom path"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create environment for data science\nconda create -n datasci python=3.11 numpy pandas matplotlib jupyter -c conda-forge\n\n# Activate it\nconda activate datasci\n\n# You're now in isolated environment with Python 3.11 + packages\npython --version\npython -c \"import numpy, pandas; print('Ready!')\"\n\n# List packages in this environment\nconda list\n\n# Deactivate (back to base)\nconda deactivate\n\n# Or switch to another environment\nconda activate base"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# If something goes wrong, view logs\nconda install --debug numpy\n\n# Show where packages are downloaded from\nconda install --verbose numpy\n\n# Clear package cache (safe to do)\nconda clean --all\n\n# Verify conda installation integrity\nconda verify\n\n# Recreate base environment if corrupted (nuclear option)\nconda update --force-reinstall -y -q -nbase conda"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "#!/bin/bash\n# verify_conda.sh\n\necho \"=== Conda Verification ===\"\necho \"Conda version:\"\nconda --version\n\necho -e \"\\nPython version:\"\npython --version\n\necho -e \"\\nEnvironments:\"\nconda env list\n\necho -e \"\\nBase packages:\"\nconda list | head -10\n\necho -e \"\\nTesting imports:\"\npython -c \"import sys; print(f'Python path: {sys.executable}')\"\npython -c \"import json; print('Standard library: OK')\"\n\necho -e \"\\n=== All checks passed! ===\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "chmod +x verify_conda.sh\n./verify_conda.sh"
        ]
      ]
    }
