{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Conda Package Management And Environments - mod-5\n\n",
        "**Course:** conda-package-management-and-environments\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Install single package\nconda install numpy\n\n# Install multiple packages\nconda install numpy pandas scipy scikit-learn\n\n# Install specific version\nconda install numpy=1.24.0\n\n# Install from specific channel\nconda install -c conda-forge numpy\n\n# Install from multiple channels\nconda install -c conda-forge -c defaults numpy scipy\n\n# Dry-run (see what would be installed without installing)\nconda install --dry-run numpy\n\n# Force reinstall\nconda install --force-reinstall numpy\n\n# Quiet mode (less output)\nconda install -q numpy\n\n# In specific environment (not currently active)\nconda install -n myenv numpy"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Exact version\nconda install numpy=1.24.0  # Only 1.24.0\n\n# Minimum version (any higher)\nconda install \"numpy>=1.24.0\"  # 1.24.0 or higher\n\n# Version range\nconda install \"numpy>=1.24.0,<2.0\"  # 1.24.x but not 2.0+\n\n# Approximate version (often used)\nconda install \"numpy~=1.24.0\"  # Compatible with 1.24 (\u22651.24, <1.25)\n\n# Multiple package versions\nconda install \"numpy=1.24\" \"pandas>=1.5,<2\" \"scikit-learn~=1.2\"\n\n# Version with build string\nconda install \"numpy=1.24=py311_0\"  # Specific build for Python 3.11"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# environment.yml\nname: datasci-project\nchannels:\n  - conda-forge\n  - defaults\ndependencies:\n  - python=3.11\n  - numpy=1.24.0\n  - pandas=1.5.3\n  - scikit-learn~=1.2\n  - matplotlib=3.7.1\n  - jupyter\n  - pip\n  - pip:\n    - requests==2.28.0\n    - python-dotenv~=0.20\n\n# Usage:\n# conda env create -f environment.yml"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Export exact versions (includes build strings)\nconda env export > environment.yml\n\n# Export without build info (more portable across systems)\nconda env export --no-builds > environment.yml\n\n# View what would be exported without writing\nconda env export --no-builds --json | jq '.dependencies' | head -20"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Conflict scenario\n# You have: numpy=1.23.0\n# You want to install: scipy=1.10.0 (requires numpy>=1.24)\n\nconda install scipy=1.10.0\n# Conda output:\n# The following packages will be UPDATED:\n#   numpy 1.23.0 --> 1.24.0\n\n# Accept the change or use --force-reinstall to keep numpy at 1.23\n\n# View what would change before installing\nconda install --dry-run scipy=1.10.0\n\n# Force specific versions (may cause errors)\nconda install scipy=1.10.0 numpy=1.23.0  # Might fail if incompatible\n\n# Remove conflicting package first\nconda remove scipy\nconda install scipy=1.10.0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Try mamba (faster, better solver)\nmamba install package1 package2\n\n# Or specify all versions explicitly\nconda install \"package1=X.Y\" \"package2=A.B\" \"shared_dep>=Z\"\n\n# Last resort: create fresh environment\nconda create -n fresh python=3.11 package1 package2"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create environment with conda\nconda create -n myenv python=3.11 numpy pandas\n\n# Activate it\nconda activate myenv\n\n# Use conda for conda-forge/complex packages\nconda install -c conda-forge scikit-learn\n\n# Use pip for PyPI-only packages\npip install requests\n\n# View both\nconda list  # Shows both conda and pip packages\n\n# Export environment with both\nconda env export > environment.yml\n# Generated file has:\n# dependencies:\n#   - python=3.11\n#   - numpy\n#   - pandas\n#   - scikit-learn\n#   - pip\n#   - pip:\n#     - requests"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Search for packages\nconda search numpy\n# Output shows all available versions\n\n# Search on conda-forge\nconda search -c conda-forge numpy\n\n# Search online (faster)\n# Visit: https://anaconda.org/search for packages\n# Visit: https://conda-forge.org for conda-forge packages\n\n# Check package info\nconda info numpy\n# Shows: dependencies, build info, channel\n\n# What installed a package (reverse dependencies)\nconda depends numpy  # Packages depending on numpy"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Update package to latest compatible\nconda update numpy\n\n# Update all packages in environment\nconda update --all\n\n# Update conda itself\nconda update conda\n\n# Update mamba\nconda update -c conda-forge mamba\n\n# Remove package\nconda remove numpy\n\n# Remove multiple packages\nconda remove numpy scipy matplotlib\n\n# Remove environment\nconda remove -n myenv --all\n\n# List packages\nconda list\n\n# List in specific environment\nconda list -n myenv\n\n# Search local packages\nconda list | grep numpy"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Remove unused packages\nconda clean --all\n\n# Remove only unused tarballs (safe)\nconda clean --tarballs\n\n# Remove index cache\nconda clean --index-cache\n\n# Verify conda installation\nconda verify"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# Good: pins critical packages, flexible on others\nname: ml-pipeline\nchannels:\n  - conda-forge\n  - defaults\ndependencies:\n  - python=3.11          # Pin major version\n  - numpy~=1.24          # Approximate match\n  - scikit-learn=1.2     # Exact for reproducibility\n  - pandas               # Any recent version\n  - jupyter\n  - pip\n  - pip:\n    - requests~=2.28     # Approximate match\n    - boto3              # Latest"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Export without build strings for sharing\nconda env export --no-builds > environment.yml\n\n# Or create manually for control\n# This is more portable across systems"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# .github/workflows/test.yml\n- name: Setup conda environment\n  uses: conda-incubator/setup-miniconda@v2\n  with:\n    environment-file: environment.yml\n    python-version: '3.11'\n\n- name: Install dependencies\n  run: |\n    conda activate test\n    conda list"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "name: gpu-project\nchannels:\n  - pytorch\n  - conda-forge\n  - defaults\ndependencies:\n  - python=3.11\n  - pytorch::pytorch::*[version='>=2.0',build='cuda*']  # GPU version\n  - pytorch::torchvision\n  - pytorch::torchaudio\n  - pytorch::pytorch-cuda=11.8\n  - numpy\n  - pip\n  \n# Installation notes:\n# Requires NVIDIA GPU with CUDA 11.8+\n# See: https://pytorch.org/get-started/locally/"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create environment\nconda create -n datasci python=3.11 \\\n  -c conda-forge \\\n  numpy pandas scikit-learn matplotlib seaborn jupyter \\\n  sqlalchemy psycopg2\n\n# Activate and add PyPI packages\nconda activate datasci\npip install kaggle mlflow\n\n# Export\nconda env export > environment.yml\n\n# Share with team\n# Team member:\ngit clone <repo>\nconda env create -f environment.yml\nconda activate datasci\njupyter notebook"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create environment with minimal overhead\nconda create -n web-dev python=3.11 \\\n  -c conda-forge \\\n  flask postgresql\n\n# Add PyPI packages\nconda activate web-dev\npip install flask-sqlalchemy python-dotenv pytest\n\n# Export (no builds for portability)\nconda env export --no-builds > requirements-conda.yml\n\n# Deploy to production (uses exact environment)\nconda env create -f requirements-conda.yml"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create GPU-enabled environment\nconda create -n ml-gpu python=3.11 \\\n  -c pytorch \\\n  pytorch torchvision torchaudio pytorch-cuda=11.8\n\n# Activate and verify GPU\nconda activate ml-gpu\npython -c \"import torch; print(torch.cuda.is_available())\"  # Should be True\n\n# Add additional packages\nconda install -c conda-forge numpy pandas jupyter\n\n# Export\nconda env export > ml-gpu-environment.yml"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Install multiple packages together (better solver)\nconda install numpy pandas scipy scikit-learn\n# Better than separate installs (solver sees all constraints)\n\n# Use mamba for speed\nmamba install package1 package2 package3\n# Installs faster with better solver\n\n# Batch operations\n# Instead of: conda install pkg1; conda install pkg2; conda install pkg3\n# Do: conda install pkg1 pkg2 pkg3\n\n# Update regularly but carefully\nconda update --all --dry-run  # See what would change\nconda update --all            # Apply updates"
        ]
      ]
    }
