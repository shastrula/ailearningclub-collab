      "outputs": [],
      "source": [
        [
          "python",
          "import lightgbm as lgb\nfrom sklearn.datasets import load_iris\nfrom sklearn.model_selection import train_test_split, cross_val_score\n\nX, y = load_iris(return_X_y=True)\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3,\n                                                    random_state=42)\n\n# Classification\nclassifier = lgb.LGBMClassifier(\n    n_estimators=100,\n    max_depth=5,\n    num_leaves=31,\n    learning_rate=0.1,\n    random_state=42,\n    verbose=-1\n)\n\nclassifier.fit(X_train, y_train)\nscore = classifier.score(X_test, y_test)\nprint(f'Classification Accuracy: {score:.4f}')\n\n# Regression\nfrom sklearn.datasets import load_diabetes\n\nX_reg, y_reg = load_diabetes(return_X_y=True)\nX_train_reg, X_test_reg, y_train_reg, y_test_reg = train_test_split(\n    X_reg, y_reg, test_size=0.3, random_state=42)\n\nregressor = lgb.LGBMRegressor(\n    n_estimators=100,\n    max_depth=5,\n    learning_rate=0.1,\n    random_state=42,\n    verbose=-1\n)\n\nregressor.fit(X_train_reg, y_train_reg)\nreg_score = regressor.score(X_test_reg, y_test_reg)\nprint(f'Regression R\u00b2 Score: {reg_score:.4f}')"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from lightgbm import LGBMClassifier\nfrom xgboost import XGBClassifier\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import cross_val_score\nimport time\n\n# Create a moderately large dataset\nX, y = make_classification(n_samples=10000, n_features=100, n_informative=50,\n                          random_state=42)\n\n# LightGBM\nstart = time.time()\nlgb = LGBMClassifier(n_estimators=100, random_state=42, verbose=-1)\nlgb_score = cross_val_score(lgb, X, y, cv=5).mean()\nlgb_time = time.time() - start\n\nprint(f'LightGBM - Score: {lgb_score:.4f}, Time: {lgb_time:.2f}s')\n\n# XGBoost\nstart = time.time()\nxgb = XGBClassifier(n_estimators=100, random_state=42, verbosity=0)\nxgb_score = cross_val_score(xgb, X, y, cv=5).mean()\nxgb_time = time.time() - start\n\nprint(f'XGBoost - Score: {xgb_score:.4f}, Time: {xgb_time:.2f}s')\n\n# LightGBM typically 3-5x faster with similar or better accuracy"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from lightgbm import LGBMClassifier\nfrom sklearn.model_selection import GridSearchCV\nfrom sklearn.datasets import load_breast_cancer\n\nX, y = load_breast_cancer(return_X_y=True)\n\n# Start with wide parameter range\nparam_grid = {\n    'n_estimators': [50, 100, 200],\n    'max_depth': [3, 5, 7],\n    'learning_rate': [0.01, 0.1, 0.3],\n    'min_child_samples': [5, 10, 20]\n}\n\nlgb = LGBMClassifier(random_state=42, verbose=-1)\ngrid_search = GridSearchCV(lgb, param_grid, cv=5, n_jobs=-1, scoring='accuracy')\ngrid_search.fit(X, y)\n\nprint(f'Best Parameters: {grid_search.best_params_}')\nprint(f'Best CV Score: {grid_search.best_score_:.4f}')\n\n# Fine-tune around best parameters\nfine_param_grid = {\n    'learning_rate': [0.08, 0.1, 0.12],\n    'n_estimators': [100, 150, 200]\n}\n\nfine_search = GridSearchCV(\n    LGBMClassifier(max_depth=5, min_child_samples=10, random_state=42, verbose=-1),\n    fine_param_grid, cv=5, n_jobs=-1, scoring='accuracy'\n)\nfine_search.fit(X, y)\nprint(f'\\nFinal Best Score: {fine_search.best_score_:.4f}')"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from lightgbm import LGBMClassifier\nfrom sklearn.model_selection import train_test_split\n\nX, y = load_breast_cancer(return_X_y=True)\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3,\n                                                    random_state=42)\n\nlgb = LGBMClassifier(\n    n_estimators=1000,  # Large number; early stopping will reduce it\n    max_depth=5,\n    learning_rate=0.1,\n    min_child_samples=10,\n    random_state=42,\n    verbose=-1\n)\n\n# Early stopping: stop if validation score doesn't improve for 50 rounds\nlgb.fit(X_train, y_train,\n        eval_set=[(X_test, y_test)],\n        eval_metric='binary_logloss',\n        callbacks=[\n            lgb.early_stopping(50),\n            lgb.log_evaluation(period=0)\n        ])\n\nprint(f'Optimal n_estimators: {lgb.n_estimators_}')\nprint(f'Test Score: {lgb.score(X_test, y_test):.4f}')"
        ]
      ]
    }
