    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Level-wise tree:          Leaf-wise tree:\n        root                    root\n       /    \\                  /    \\\n      A      B               A      B\n     / \\    / \\                    / \\\n    C   D  E   F               C   D   E"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import lightgbm as lgb\nimport numpy as np\nfrom sklearn.datasets import load_breast_cancer\nfrom sklearn.model_selection import train_test_split\n\nX, y = load_breast_cancer(return_X_y=True)\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, \n                                                    random_state=42)\n\n# LightGBM with GOSS enabled (default)\nlgb_goss = lgb.LGBMClassifier(\n    n_estimators=100,\n    subsample_freq=1,  # Apply sampling every iteration\n    subsample=0.9,     # 90% of samples\n    random_state=42,\n    verbose=-1\n)\n\nlgb_goss.fit(X_train, y_train)\ngoss_score = lgb_goss.score(X_test, y_test)\nprint(f'LightGBM with GOSS: {goss_score:.4f}')\n\n# LightGBM without subsampling (uses full data per iteration)\nlgb_full = lgb.LGBMClassifier(\n    n_estimators=100,\n    subsample=1.0,  # Use all samples\n    random_state=42,\n    verbose=-1\n)\n\nlgb_full.fit(X_train, y_train)\nfull_score = lgb_full.score(X_test, y_test)\nprint(f'LightGBM without GOSS: {full_score:.4f}')\n\n# GOSS typically matches or beats full data training with 3-5x speedup"
        ]
      ]
    },
