          "python",
          "from sklearn.ensemble import RandomForestClassifier, BaggingClassifier\nfrom sklearn.datasets import load_iris\nfrom sklearn.model_selection import cross_val_score\nfrom sklearn.tree import DecisionTreeClassifier\n\n# Load data\nX, y = load_iris(return_X_y=True)\n\n# Single decision tree (high variance)\ndt = DecisionTreeClassifier(random_state=42)\ndt_score = cross_val_score(dt, X, y, cv=5).mean()\nprint(f'Decision Tree CV Score: {dt_score:.4f}')\n\n# Bagging with decision trees\nbg = BaggingClassifier(estimator=DecisionTreeClassifier(), \n                       n_estimators=50, random_state=42)\nbg_score = cross_val_score(bg, X, y, cv=5).mean()\nprint(f'Bagging CV Score: {bg_score:.4f}')\n\n# Random forest (bagging + feature subsampling)\nrf = RandomForestClassifier(n_estimators=50, random_state=42)\nrf_score = cross_val_score(rf, X, y, cv=5).mean()\nprint(f'Random Forest CV Score: {rf_score:.4f}')\n\n# Output shows: individual trees ~0.95, bagging/RF ~0.97\n# Ensemble variance reduction in action"
        ]
      ]
