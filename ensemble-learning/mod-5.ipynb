      "source": [
        "# Ensemble Learning - mod-5\n\n",
        "**Course:** ensemble-learning\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom sklearn.tree import DecisionTreeClassifier\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import train_test_split\n\n# Create a moderately difficult problem\nX, y = make_classification(n_samples=500, n_features=10, n_informative=5,\n                          n_redundant=3, n_clusters_per_class=2, random_state=42)\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, \n                                                    random_state=42)\n\n# Manual AdaBoost implementation to illustrate the concept\nn_iterations = 10\nmodels = []\nmodel_weights = []\nsample_weights = np.ones(len(X_train)) / len(X_train)\n\nfor iteration in range(n_iterations):\n    # Train weak learner on weighted data\n    dt = DecisionTreeClassifier(max_depth=1, random_state=42)\n    dt.fit(X_train, y_train, sample_weight=sample_weights)\n    \n    # Calculate error rate\n    predictions = dt.predict(X_train)\n    incorrect = predictions != y_train\n    error_rate = np.sum(sample_weights * incorrect)\n    \n    # Calculate model weight (higher accuracy = higher weight)\n    alpha = 0.5 * np.log((1 - error_rate) / max(error_rate, 1e-10))\n    \n    # Update sample weights (exponentially increase for misclassified)\n    sample_weights *= np.exp(-alpha * y_train * (2 * predictions - 1))\n    sample_weights /= np.sum(sample_weights)  # Normalize\n    \n    models.append(dt)\n    model_weights.append(alpha)\n    \n    train_error = np.mean(incorrect)\n    print(f'Iteration {iteration+1}: error={train_error:.3f}, alpha={alpha:.3f}')\n\n# Predictions: weighted vote of all models\ndef adaboost_predict(X, models, weights):\n    predictions = np.array([m.predict(X) for m in models])\n    weighted_votes = weights * (2 * predictions - 1)  # Convert 0/1 to -1/1\n    return (np.sum(weighted_votes, axis=0) > 0).astype(int)\n\ntest_score = np.mean(adaboost_predict(X_test, models, model_weights) == y_test)\nprint(f'\\nTest Accuracy: {test_score:.4f}')"
        ]
      ]
    },
    {
