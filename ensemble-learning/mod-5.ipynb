        [
          "python",
          "from sklearn.ensemble import AdaBoostClassifier\nfrom sklearn.tree import DecisionTreeClassifier\nfrom sklearn.model_selection import cross_val_score\nfrom sklearn.datasets import load_breast_cancer\n\nX, y = load_breast_cancer(return_X_y=True)\n\n# Single stump (barely better than random)\nstump = DecisionTreeClassifier(max_depth=1, random_state=42)\nstump_score = cross_val_score(stump, X, y, cv=5).mean()\nprint(f'Single Stump CV Score: {stump_score:.4f}')\n\n# AdaBoost with stumps (very strong classifier)\nada_stump = AdaBoostClassifier(estimator=DecisionTreeClassifier(max_depth=1),\n                              n_estimators=50, random_state=42)\nada_score = cross_val_score(ada_stump, X, y, cv=5).mean()\nprint(f'AdaBoost (50 Stumps) CV Score: {ada_score:.4f}')\n\n# Full tree (overfits on this high-dimensional data)\ntree = DecisionTreeClassifier(random_state=42)\ntree_score = cross_val_score(tree, X, y, cv=5).mean()\nprint(f'Full Tree CV Score: {tree_score:.4f}')\n\n# Output typically: stump ~0.58, AdaBoost ~0.96, tree ~0.90"
        ]
      ]
    },
    {
      "cell_type": "code",
