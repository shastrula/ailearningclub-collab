          "python",
          "from sklearn.model_selection import StratifiedKFold\nfrom sklearn.datasets import make_classification\nimport numpy as np\n\nX, y = make_classification(n_samples=300, n_features=20, weights=[0.9, 0.1], random_state=42)\n\nskf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n\nfor fold, (train_idx, test_idx) in enumerate(skf.split(X, y)):\n    train_positive_ratio = y[train_idx].sum() / len(train_idx)\n    test_positive_ratio = y[test_idx].sum() / len(test_idx)\n    print(f\"Fold {fold}: Train positive ratio: {train_positive_ratio:.3f}, Test: {test_positive_ratio:.3f}\")"
