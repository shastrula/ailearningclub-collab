        [
          "python",
          "Top 10 Parameter Combinations (GridSearchCV):\n--------------------------------------------------------------------------------\nRank 1 | CV R\u00b2: 0.8140 \u00b1 0.0074 | Train R\u00b2: 0.9720\n         n_est=300, depth=30, split=2, leaf=1\n\nRank 2 | CV R\u00b2: 0.8137 \u00b1 0.0076 | Train R\u00b2: 0.9718\n         n_est=200, depth=30, split=2, leaf=1\n\nRank 3 | CV R\u00b2: 0.8134 \u00b1 0.0076 | Train R\u00b2: 0.9718\n         n_est=300, depth=None, split=2, leaf=1\n\nRank 4 | CV R\u00b2: 0.8131 \u00b1 0.0079 | Train R\u00b2: 0.9715\n         n_est=200, depth=None, split=2, leaf=1\n\nRank 5 | CV R\u00b2: 0.8123 \u00b1 0.0078 | Train R\u00b2: 0.9690\n         n_est=300, depth=20, split=2, leaf=1\n\nOverfitting Analysis (top model):\n  Train R\u00b2: 0.9720\n  CV Test R\u00b2: 0.8140\n  Gap: 0.1580\n  \u26a0\ufe0f Possible overfitting"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Refined search: add regularization constraints\nrefined_grid = {\n    'n_estimators': [300, 400, 500],\n    'max_depth': [15, 20, 25],\n    'min_samples_split': [5, 10, 15],\n    'min_samples_leaf': [2, 4, 6],\n    'max_features': ['sqrt', 0.5, 0.7]\n}\n\nrefined_search = GridSearchCV(\n    estimator=RandomForestRegressor(random_state=42),\n    param_grid=refined_grid,\n    cv=5,\n    scoring='r2',\n    n_jobs=-1,\n    return_train_score=True\n)\nrefined_search.fit(X_train, y_train)\n\n# Evaluate\nrefined_pred = refined_search.predict(X_test)\nrefined_r2 = r2_score(y_test, refined_pred)\nrefined_rmse = np.sqrt(mean_squared_error(y_test, refined_pred))\n\n# Check overfitting\nbest_idx = refined_search.best_index_\nrv = pd.DataFrame(refined_search.cv_results_)\ntrain_r2 = rv.loc[best_idx, 'mean_train_score']\ncv_r2 = rv.loc[best_idx, 'mean_test_score']\n\nprint(\"Refined Model (with regularization):\")\nprint(f\"  Best params: {refined_search.best_params_}\")\nprint(f\"  Train R\u00b2: {train_r2:.4f}\")\nprint(f\"  CV R\u00b2: {cv_r2:.4f}\")\nprint(f\"  Gap: {train_r2 - cv_r2:.4f}\")\nprint(f\"  Test R\u00b2: {refined_r2:.4f}\")\nprint(f\"  Test RMSE: {refined_rmse:.4f}\")"
        ]
      ]
    },
