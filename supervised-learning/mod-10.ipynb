          "python",
          "from sklearn.svm import OneClassSVM\nfrom sklearn.preprocessing import StandardScaler\nimport numpy as np\n\n# Normal data (e.g., network traffic patterns)\nX_normal = np.random.randn(100, 10)\n\n# Standardize\nscaler = StandardScaler()\nX_normal_scaled = scaler.fit_transform(X_normal)\n\n# Train one-class SVM\noc_svm = OneClassSVM(nu=0.05)  # nu = expected fraction of outliers\noc_svm.fit(X_normal_scaled)\n\n# Predict (-1 = anomaly, 1 = normal)\nanomaly_scores = oc_svm.decision_function(X_normal_scaled)\npredictions = oc_svm.predict(X_normal_scaled)\n\n# Test on new data with anomalies\nX_test = np.vstack([np.random.randn(10, 10), np.random.randn(2, 10) * 5])  # 2 anomalies\nX_test_scaled = scaler.transform(X_test)\ntest_predictions = oc_svm.predict(X_test_scaled)\nprint(f\"Detected {(test_predictions == -1).sum()} anomalies in test set\")"
        ]
      ]
    }
