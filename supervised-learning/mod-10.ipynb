          "python",
          "from sklearn.datasets import make_circles, make_moons\nfrom sklearn.svm import SVC\nfrom sklearn.preprocessing import StandardScaler\nimport matplotlib.pyplot as plt\nimport numpy as np\n\n# Create nonlinear datasets\ndatasets = [\n    make_circles(n_samples=200, noise=0.1, random_state=42),\n    make_moons(n_samples=200, noise=0.1, random_state=42)\n]\n\nfig, axes = plt.subplots(2, 3, figsize=(15, 10))\nfig.suptitle('SVM with Different Kernels')\n\nkernels = ['linear', 'poly', 'rbf']\nh = 0.02\n\nfor row, (X, y) in enumerate(datasets):\n    # Scale data\n    scaler = StandardScaler()\n    X = scaler.fit_transform(X)\n    \n    for col, kernel in enumerate(kernels):\n        ax = axes[row, col]\n        \n        if kernel == 'poly':\n            svm = SVC(kernel='poly', degree=3, C=1, random_state=42)\n        else:\n            svm = SVC(kernel=kernel, C=1, random_state=42)\n        \n        svm.fit(X, y)\n        \n        # Create mesh\n        x_min, x_max = X[:, 0].min() - 1, X[:, 0].max() + 1\n        y_min, y_max = X[:, 1].min() - 1, X[:, 1].max() + 1\n        xx, yy = np.meshgrid(np.arange(x_min, x_max, h), np.arange(y_min, y_max, h))\n        \n        # Predict\n        Z = svm.decision_function(np.c_[xx.ravel(), yy.ravel()])\n        Z = Z.reshape(xx.shape)\n        \n        # Plot\n        ax.contourf(xx, yy, Z, levels=20, cmap='viridis', alpha=0.6)\n        ax.scatter(X[:, 0], X[:, 1], c=y, cmap='viridis', edgecolors='k')\n        ax.scatter(svm.support_vectors_[:, 0], svm.support_vectors_[:, 1],\n                  s=200, facecolors='none', edgecolors='red')\n        \n        ax.set_title(f'{[\"Circles\", \"Moons\"][row]} - {kernel.upper()} Kernel')\n        ax.set_xlim(x_min, x_max)\n        ax.set_ylim(y_min, y_max)"
        ]
      ]
