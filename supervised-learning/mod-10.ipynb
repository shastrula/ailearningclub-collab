          "python",
          "from sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.svm import LinearSVC\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.datasets import fetch_20newsgroups\n\n# Sample documents\ndocs = fetch_20newsgroups(subset='train', categories=['alt.atheism', 'talk.religion.misc'], \n                          remove=('headers', 'footers', 'quotes'))\n\n# Pipeline: TF-IDF \u2192 SVM\npipeline = Pipeline([\n    ('tfidf', TfidfVectorizer(max_features=1000, stop_words='english')),\n    ('svm', LinearSVC(max_iter=2000))\n])\n\npipeline.fit(docs.data, docs.target)\n\n# Predictions on new documents\nnew_docs = [\"I believe in God\", \"I don't believe in religion\"]\npredictions = pipeline.predict(new_docs)"
        ]
