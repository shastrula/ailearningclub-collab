        [
          "python",
          "# Residuals vs Predicted values (check for patterns)\nprint(\"Residuals vs Predicted Values (sampled):\")\nprint(f\"{'Predicted':>10} {'Residual':>10} {'Actual':>10}\")\nprint(\"-\" * 32)\n# Show 10 evenly spaced samples sorted by predicted value\nsorted_idx = np.argsort(y_pred)\nsample_idx = sorted_idx[::len(sorted_idx)//10][:10]\nfor i in sample_idx:\n    print(f\"{y_pred[i]:10.3f} {residuals[i]:10.3f} {y_test[i]:10.3f}\")"
