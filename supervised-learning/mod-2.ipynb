      "outputs": [],
      "source": [
        [
          "python",
          "# Feature scaling and coefficient comparison\nfrom sklearn.preprocessing import StandardScaler\n\n# Create second model with scaled features\nscaler = StandardScaler()\nX_train_scaled = scaler.fit_transform(X_train)\nX_test_scaled = scaler.transform(X_test)\n\nmodel_scaled = LinearRegression()\nmodel_scaled.fit(X_train_scaled, y_train)\n\nprint(\"Coefficients (unscaled features):\", model.coef_)\nprint(\"Coefficients (scaled features):\", model_scaled.coef_)\nprint(\"\\nWith scaling, all coefficients are on comparable scales\")\nprint(\"This makes feature importance comparison meaningful\")\n\n# Predictions are identical\ny_pred_scaled = model_scaled.predict(X_test_scaled)\nprint(f\"\\nR\u00b2 with unscaled: {r2_score(y_test, y_pred_test):.3f}\")\nprint(f\"R\u00b2 with scaled: {r2_score(y_test, y_pred_scaled):.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
