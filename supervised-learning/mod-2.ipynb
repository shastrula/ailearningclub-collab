      "source": [
        [
          "python",
          "# Diagnostic plots\nimport matplotlib.pyplot as plt\n\nfig, axes = plt.subplots(2, 2, figsize=(12, 10))\n\n# Residuals vs Fitted\nresiduals = y_test - y_pred_test\naxes[0, 0].scatter(y_pred_test, residuals, alpha=0.6)\naxes[0, 0].axhline(y=0, color='r', linestyle='--')\naxes[0, 0].set_title('Residuals vs Fitted Values')\n\n# Q-Q plot for normality\nfrom scipy import stats\nstats.probplot(residuals, dist=\"norm\", plot=axes[0, 1])\naxes[0, 1].set_title('Q-Q Plot')\n\n# Scale-Location plot\nstandardized_residuals = residuals / np.std(residuals)\naxes[1, 0].scatter(y_pred_test, np.sqrt(np.abs(standardized_residuals)), alpha=0.6)\naxes[1, 0].set_title('Scale-Location Plot')\n\n# Residuals histogram\naxes[1, 1].hist(residuals, bins=20, edgecolor='black')\naxes[1, 1].set_title('Residuals Histogram')\n\nplt.tight_layout()\nprint(\"Diagnostic plots help validate regression assumptions\")"
        ]
