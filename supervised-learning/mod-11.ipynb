          "python",
          "from sklearn.svm import SVC\nfrom sklearn.datasets import make_circles\nfrom sklearn.preprocessing import StandardScaler\nimport matplotlib.pyplot as plt\nimport numpy as np\n\n# Create nonlinear dataset\nX, y = make_circles(n_samples=300, noise=0.1, random_state=42)\nX = StandardScaler().fit_transform(X)\n\ngamma_values = [0.001, 0.01, 0.1, 1, 10, 100]\nfig, axes = plt.subplots(2, 3, figsize=(15, 10))\nfig.suptitle('Effect of Gamma on RBF Kernel Decision Boundary')\n\nh = 0.02\nx_min, x_max = X[:, 0].min() - 1, X[:, 0].max() + 1\ny_min, y_max = X[:, 1].min() - 1, X[:, 1].max() + 1\nxx, yy = np.meshgrid(np.arange(x_min, x_max, h), np.arange(y_min, y_max, h))\n\nfor idx, gamma in enumerate(gamma_values):\n    ax = axes[idx // 3, idx % 3]\n    \n    # Train SVM\n    svm = SVC(kernel='rbf', gamma=gamma, C=1.0)\n    svm.fit(X, y)\n    \n    # Predict on mesh\n    Z = svm.decision_function(np.c_[xx.ravel(), yy.ravel()])\n    Z = Z.reshape(xx.shape)\n    \n    # Plot\n    ax.contourf(xx, yy, Z, levels=20, cmap='viridis', alpha=0.6)\n    ax.scatter(X[:, 0], X[:, 1], c=y, cmap='viridis', edgecolors='k', s=50)\n    ax.scatter(svm.support_vectors_[:, 0], svm.support_vectors_[:, 1],\n              s=200, facecolors='none', edgecolors='red')\n    \n    accuracy = svm.score(X, y)\n    ax.set_title(f'\u03b3={gamma} (Acc: {accuracy:.3f})')\n    ax.set_xlim(x_min, x_max)\n    ax.set_ylim(y_min, y_max)\n\nplt.tight_layout()"
