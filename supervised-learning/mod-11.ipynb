        [
          "python",
          "# Example: Time series SVM with custom kernel\nfrom sklearn.svm import SVC\nfrom sklearn.metrics.pairwise import pairwise_kernels\nimport numpy as np\n\ndef dtw_distance(x, y):\n    \"\"\"Simplified Dynamic Time Warping distance\"\"\"\n    n, m = len(x), len(y)\n    dtw_matrix = np.full((n + 1, m + 1), np.inf)\n    dtw_matrix[0, 0] = 0\n    \n    for i in range(1, n + 1):\n        for j in range(1, m + 1):\n            cost = abs(x[i-1] - y[j-1])\n            dtw_matrix[i, j] = cost + min(dtw_matrix[i-1, j], \n                                         dtw_matrix[i, j-1], \n                                         dtw_matrix[i-1, j-1])\n    return dtw_matrix[n, m]\n\n# DTW kernel (similarity based on distance)\ndef dtw_kernel(X, Y=None):\n    n = X.shape[0]\n    m = Y.shape[0] if Y is not None else n\n    K = np.zeros((n, m))\n    \n    for i in range(n):\n        for j in range(m):\n            y_data = Y[j] if Y is not None else X[j]\n            dist = dtw_distance(X[i], y_data)\n            K[i, j] = np.exp(-dist / 100)  # RBF-like kernel on DTW distance\n    \n    return K\n\n# Train SVM with precomputed DTW kernel\nX_train = np.random.randn(20, 50)  # 20 time series of length 50\ny_train = np.random.randint(0, 2, 20)\n\nK_train = dtw_kernel(X_train)\n\nsvm_dtw = SVC(kernel='precomputed')\nsvm_dtw.fit(K_train, y_train)\n\nprint(f\"SVM with DTW kernel trained on {len(svm_dtw.support_vectors_)} support vectors\")"
        ]
      ]
