          "python",
          "from sklearn.ensemble import RandomForestClassifier\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import cross_val_score\nimport numpy as np\n\n# Create imbalanced dataset\nX, y = make_classification(n_samples=5000, n_features=30, weights=[0.95, 0.05], random_state=42)\n\n# Baseline: No class balancing\nrf_baseline = RandomForestClassifier(n_estimators=100, random_state=42)\n\n# With class balancing\nrf_balanced = RandomForestClassifier(n_estimators=100, class_weight='balanced', random_state=42)\n\n# Compare using ROC-AUC (better for imbalanced data)\nbaseline_auc = cross_val_score(rf_baseline, X, y, cv=5, scoring='roc_auc').mean()\nbalanced_auc = cross_val_score(rf_balanced, X, y, cv=5, scoring='roc_auc').mean()\n\nprint(f\"Baseline ROC-AUC: {baseline_auc:.4f}\")\nprint(f\"Balanced ROC-AUC: {balanced_auc:.4f}\")\nprint(f\"Improvement: {(balanced_auc - baseline_auc)*100:.1f}%\")"
