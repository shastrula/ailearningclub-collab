          "import numpy as np\nimport pandas as pd\nfrom sklearn.datasets import fetch_california_housing\n\n# Load California Housing dataset\nhousing = fetch_california_housing()\nX = pd.DataFrame(housing.data, columns=housing.feature_names)\ny = housing.target\n\n# Demonstrate bootstrap sampling\nnp.random.seed(42)\nn_samples = len(X)\n\n# Create one bootstrap sample\nbootstrap_indices = np.random.choice(n_samples, size=n_samples, replace=True)\nunique_samples = len(np.unique(bootstrap_indices))\n\nprint(f\"Original dataset size: {n_samples}\")\nprint(f\"Bootstrap sample size: {len(bootstrap_indices)}\")\nprint(f\"Unique samples in bootstrap: {unique_samples}\")\nprint(f\"Percentage of unique samples: {unique_samples/n_samples*100:.1f}%\")\nprint(f\"Out-of-bag samples: {n_samples - unique_samples}\")\nprint(f\"OOB percentage: {(n_samples - unique_samples)/n_samples*100:.1f}%\")"
