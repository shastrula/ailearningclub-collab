          "python",
          "from sklearn.ensemble import RandomForestClassifier\nfrom sklearn.datasets import load_breast_cancer\nfrom sklearn.metrics import accuracy_score\n\n# Load data\nX, y = load_breast_cancer(return_X_y=True)\n\n# Train Random Forest with OOB score computation\nrf = RandomForestClassifier(n_estimators=100, oob_score=True, random_state=42)\nrf.fit(X, y)\n\n# OOB score is computed during training\nprint(f\"OOB Score (accuracy): {rf.oob_score_:.4f}\")\nprint(f\"Training Score: {rf.score(X, y):.4f}\")\n\n# OOB predictions can also be accessed\n# (available after fitting)\nprint(f\"OOB predictions shape: {rf.oob_prediction_.shape}\")"
        ]
      ]
