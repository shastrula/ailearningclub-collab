      "source": [
        [
          "python",
          "from sklearn.ensemble import RandomForestClassifier\nfrom sklearn.datasets import make_classification\n\n# Create a synthetic dataset\nX, y = make_classification(n_samples=1000, n_features=20, n_informative=10, \n                           n_redundant=5, random_state=42)\n\n# Random Forest with default parameters\nrf = RandomForestClassifier(n_estimators=100, random_state=42)\nrf.fit(X, y)\n\n# Key parameters controlling randomness:\n# max_features: Number of features to consider at each split (default: 'sqrt' for classification)\n# bootstrap: Whether to use bootstrap sampling (default: True)\n# max_samples: Number of samples to draw for training each tree (default: None, meaning n_samples)\n\nprint(f\"Number of trees: {rf.n_estimators}\")\nprint(f\"Max features per split: {rf.max_features}\")\nprint(f\"Bootstrap sampling: {rf.bootstrap}\")\nprint(f\"Training accuracy: {rf.score(X, y):.4f}\")"
        ]
      ]
