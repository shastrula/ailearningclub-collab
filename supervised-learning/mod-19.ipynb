          "python",
          "from sklearn.ensemble import AdaBoostClassifier, GradientBoostingClassifier\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import cross_val_score\n\nX, y = make_classification(n_samples=300, n_features=20, n_informative=10, random_state=42)\n\n# AdaBoost\nadaboost = AdaBoostClassifier(\n    n_estimators=50,\n    learning_rate=1.0,\n    random_state=42\n)\n\n# Gradient Boosting\ngb = GradientBoostingClassifier(\n    n_estimators=50,\n    learning_rate=0.1,\n    max_depth=3,\n    random_state=42\n)\n\nada_score = cross_val_score(adaboost, X, y, cv=5, scoring='accuracy').mean()\ngb_score = cross_val_score(gb, X, y, cv=5, scoring='accuracy').mean()\n\nprint(\"Boosting Methods:\\n\")\nprint(f\"AdaBoost:       {ada_score:.4f}\")\nprint(f\"Gradient Boost: {gb_score:.4f}\")"
        ]
