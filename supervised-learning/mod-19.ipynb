        [
          "python",
          "from sklearn.ensemble import RandomForestClassifier\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import cross_val_score\nimport numpy as np\n\nX, y = make_classification(n_samples=300, n_features=20, n_informative=10, random_state=42)\n\n# Compare different ensemble methods\ndt = DecisionTreeClassifier(max_depth=10, random_state=42)\nbagging = BaggingClassifier(DecisionTreeClassifier(max_depth=10), n_estimators=50, random_state=42)\nrf = RandomForestClassifier(n_estimators=50, max_depth=10, random_state=42)\n\ndt_score = cross_val_score(dt, X, y, cv=5, scoring='accuracy')\nbagging_score = cross_val_score(bagging, X, y, cv=5, scoring='accuracy')\nrf_score = cross_val_score(rf, X, y, cv=5, scoring='accuracy')\n\nprint(\"Ensemble Method Comparison:\\n\")\nprint(f\"Decision Tree:       {dt_score.mean():.4f} \u00b1 {dt_score.std():.4f}\")\nprint(f\"Bagging:             {bagging_score.mean():.4f} \u00b1 {bagging_score.std():.4f}\")\nprint(f\"Random Forest:       {rf_score.mean():.4f} \u00b1 {rf_score.std():.4f}\")\n\n# Feature importance\nrf_model = RandomForestClassifier(n_estimators=50, random_state=42)\nrf_model.fit(X, y)\nimportances = rf_model.feature_importances_\ntop_5_features = np.argsort(importances)[-5:]\n\nprint(f\"\\nTop 5 features in RF: {top_5_features}\")"
        ]
      ]
