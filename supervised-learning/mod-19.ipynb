        [
          "python",
          "from sklearn.ensemble import BaggingClassifier\nfrom sklearn.tree import DecisionTreeClassifier\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import cross_val_score\nimport numpy as np\n\nX, y = make_classification(n_samples=300, n_features=20, n_informative=10, random_state=42)\n\n# Single decision tree (high variance)\ndt = DecisionTreeClassifier(max_depth=10, random_state=42)\n\n# Bagging ensemble (reduced variance)\nbagging = BaggingClassifier(\n    estimator=DecisionTreeClassifier(max_depth=10),\n    n_estimators=50,\n    random_state=42\n)\n\ndt_score = cross_val_score(dt, X, y, cv=5, scoring='accuracy')\nbagging_score = cross_val_score(bagging, X, y, cv=5, scoring='accuracy')\n\nprint(\"Bagging Effect on Variance:\\n\")\nprint(f\"Single Tree - Mean: {dt_score.mean():.4f}, Std: {dt_score.std():.4f}\")\nprint(f\"Bagging (50) - Mean: {bagging_score.mean():.4f}, Std: {bagging_score.std():.4f}\")\nprint(f\"\\nVariance reduction: {(1 - bagging_score.std()/dt_score.std())*100:.1f}%\")"
        ]
      ]
    },
    {
