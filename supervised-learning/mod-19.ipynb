      "source": [
        [
          "python",
          "from sklearn.ensemble import VotingClassifier\nfrom sklearn.tree import DecisionTreeClassifier\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.svm import SVC\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import cross_val_score\nimport numpy as np\n\nX, y = make_classification(n_samples=300, n_features=20, n_informative=10, random_state=42)\n\n# Individual models\ndt = DecisionTreeClassifier(max_depth=5, random_state=42)\nlr = LogisticRegression(max_iter=1000, random_state=42)\nsvc = SVC(kernel='rbf', probability=True, random_state=42)\n\n# Hard voting: majority vote\nvoting_hard = VotingClassifier(\n    estimators=[('dt', dt), ('lr', lr), ('svc', svc)],\n    voting='hard'\n)\n\n# Soft voting: averaged probabilities\nvoting_soft = VotingClassifier(\n    estimators=[('dt', dt), ('lr', lr), ('svc', svc)],\n    voting='soft'\n)\n\n# Evaluate\ndt_score = cross_val_score(dt, X, y, cv=5, scoring='accuracy').mean()\nlr_score = cross_val_score(lr, X, y, cv=5, scoring='accuracy').mean()\nsvc_score = cross_val_score(svc, X, y, cv=5, scoring='accuracy').mean()\nhard_score = cross_val_score(voting_hard, X, y, cv=5, scoring='accuracy').mean()\nsoft_score = cross_val_score(voting_soft, X, y, cv=5, scoring='accuracy').mean()\n\nprint(\"Voting Classifier Performance:\\n\")\nprint(f\"Decision Tree:       {dt_score:.4f}\")\nprint(f\"Logistic Regression: {lr_score:.4f}\")\nprint(f\"SVM:                 {svc_score:.4f}\")\nprint(f\"Voting (hard):       {hard_score:.4f}\")\nprint(f\"Voting (soft):       {soft_score:.4f}\")\nprint(f\"\\nBest individual: {max(dt_score, lr_score, svc_score):.4f}\")\nprint(f\"Ensemble improvement: +{(soft_score - max(dt_score, lr_score, svc_score))*100:.2f}%\")"
        ]
      ]
    },
    {
