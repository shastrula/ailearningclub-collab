          "python",
          "print(\"\\n\" + \"=\"*70)\nprint(\"ENSEMBLE METHODS: COMPLETE PERFORMANCE COMPARISON\")\nprint(\"=\"*70)\nprint(f\"{'Method':<35} {'Test R\u00b2':<10} {'Test RMSE':<10} {'vs Best Single':<15}\")\nprint(\"-\"*70)\n\nall_results = {\n    'Ridge (individual)': (model_scores['Ridge'], 0.7253),\n    'KNN (individual)': (model_scores['KNN'], 0.6156),\n    'Random Forest (individual)': (model_scores['Random Forest'], 0.5094),\n    'Gradient Boosting (individual)': (model_scores['Gradient Boosting'], 0.5390),\n    'Decision Tree (individual)': (model_scores['Decision Tree'], 0.4826),\n    'Voting (equal weights)': (voting_r2, voting_rmse),\n    'Voting (weighted)': (weighted_r2, weighted_rmse),\n    'Stacking (Ridge meta)': (stacking_r2, stacking_rmse),\n    'Blending': (blend_r2, blend_rmse),\n    'Advanced Stacking (GB meta)': (adv_r2, adv_rmse),\n}\n\nbest_single = model_scores[best_individual]\nfor name, (r2, rmse) in all_results.items():\n    diff = f\"+{(r2-best_single)*100:.2f}%\" if r2 > best_single else f\"{(r2-best_single)*100:.2f}%\"\n    marker = \" \u2190\" if r2 == max(v[0] for v in all_results.values()) else \"\"\n    print(f\"{name:<35} {r2:<10.4f} {rmse:<10.4f} {diff:<15}{marker}\")\n\nprint(\"=\"*70)"
        ]
