      "source": [
        [
          "python",
          "# Feature selection using SelectKBest\nfrom sklearn.feature_selection import SelectKBest, f_regression\n\n# Create synthetic data with many features\nnp.random.seed(42)\nn_samples, n_features = 200, 15\nX_many = np.random.randn(n_samples, n_features)\n# Only first 3 features are actually important\ny_many = 2*X_many[:, 0] - X_many[:, 1] + 0.5*X_many[:, 2] + np.random.randn(n_samples) * 0.5\n\nX_train_m, X_test_m, y_train_m, y_test_m = train_test_split(\n    X_many, y_many, test_size=0.2, random_state=42\n)\n\n# Select best 5 features\nselector = SelectKBest(score_func=f_regression, k=5)\nX_train_selected = selector.fit_transform(X_train_m, y_train_m)\nX_test_selected = selector.transform(X_test_m)\n\n# Train on selected features\nmodel_selected = LinearRegression()\nmodel_selected.fit(X_train_selected, y_train_m)\nr2_selected = r2_score(y_test_m, model_selected.predict(X_test_selected))\n\n# Train on all features\nmodel_all = LinearRegression()\nmodel_all.fit(X_train_m, y_train_m)\nr2_all = r2_score(y_test_m, model_all.predict(X_test_m))\n\nselected_indices = selector.get_support(indices=True)\nprint(f\"Selected feature indices: {selected_indices}\")\nprint(f\"R\u00b2 with selected features: {r2_selected:.3f}\")\nprint(f\"R\u00b2 with all features: {r2_all:.3f}\")"
        ]
      ]
