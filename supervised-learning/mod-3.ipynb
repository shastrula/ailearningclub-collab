          "python",
          "# Multicollinearity detection with VIF\nfrom statsmodels.stats.outliers_influence import variance_inflation_factor\nfrom sklearn.preprocessing import StandardScaler\n\n# Create dataset with multicollinearity\nnp.random.seed(42)\nn = 100\nx1 = np.random.randn(n)\nx2 = x1 + 0.1 * np.random.randn(n)  # Highly correlated with x1\nx3 = np.random.randn(n)  # Independent\ny = 2*x1 - x2 + x3 + np.random.randn(n) * 0.5\n\nX = np.column_stack([x1, x2, x3])\n\n# Calculate VIF\nvif_data = pd.DataFrame()\nvif_data[\"Feature\"] = [\"x1 (collinear)\", \"x2 (collinear)\", \"x3 (independent)\"]\nvif_data[\"VIF\"] = [variance_inflation_factor(X, i) for i in range(X.shape[1])]\nprint(\"Variance Inflation Factors:\")\nprint(vif_data)\nprint(\"\\nx1 and x2 have high VIF due to correlation\")\nprint(\"x3 has VIF \u2248 1 (independent)\")\n\n# Ridge helps with multicollinearity\nmodel_ols = LinearRegression()\nmodel_ols.fit(X, y)\n\nmodel_ridge = Ridge(alpha=1.0)\nmodel_ridge.fit(X, y)\n\nprint(f\"\\nOLS coefficients: {model_ols.coef_}\")\nprint(f\"Ridge coefficients: {model_ridge.coef_}\")\nprint(\"Ridge shrinks coefficients, stabilizing estimates with multicollinearity\")"
        ]
      ]
    },
    {
