          "python",
          "from sklearn.compose import ColumnTransformer\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\n\n# Feature preprocessing\npreprocessor = ColumnTransformer([\n    ('numeric', StandardScaler(), ['tenure', 'monthly_charge']),\n    ('categorical', OneHotEncoder(drop='first'), ['contract_type'])\n])\n\n# Pipeline with logistic regression\npipeline = Pipeline([\n    ('preprocessor', preprocessor),\n    ('classifier', LogisticRegression(max_iter=1000, class_weight='balanced'))\n])\n\npipeline.fit(X_train, y_train)\n\n# Evaluate with business metrics\ny_pred_proba = pipeline.predict_proba(X_test)[:, 1]\nthreshold = 0.3  # Lower threshold to catch more churners\n\ny_pred = (y_pred_proba >= threshold).astype(int)\nrecall = recall_score(y_test, y_pred)  # Catch churners\nprecision = precision_score(y_test, y_pred)  # Minimize false alerts\n\nprint(f\"Recall (catch churners): {recall:.2%}\")\nprint(f\"Precision (accuracy of alerts): {precision:.2%}\")\n\n# Business impact\n# Cost: $50/month per customer; churn prevention: $200\n# Focus on high-churn customers for retention campaigns"
