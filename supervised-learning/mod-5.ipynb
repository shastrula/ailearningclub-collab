      "source": [
        "# Supervised Learning - mod-5\n\n",
        "**Course:** supervised-learning\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "P(class_k) = exp(z_k) / sum(exp(z_j) for all j)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.datasets import load_iris\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import (accuracy_score, confusion_matrix, \n                             classification_report, roc_curve, auc)\n\n# Demonstrate softmax\ndef softmax(z):\n    exp_z = np.exp(z - np.max(z))  # subtract max for numerical stability\n    return exp_z / exp_z.sum()\n\n# Example: 3 raw scores for 3 classes\nraw_scores = np.array([2.0, 1.0, 0.1])\nprobs = softmax(raw_scores)\nprint(\"Softmax Example (3 classes):\")\nprint(f\"  Raw scores: {raw_scores}\")\nprint(f\"  Probabilities: {probs.round(4)}\")\nprint(f\"  Sum: {probs.sum():.4f}\")\nprint(f\"  Predicted class: {np.argmax(probs)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Softmax Example (3 classes):\n  Raw scores: [2.0, 1.0, 0.1]\n  Probabilities: [0.6590 0.2424 0.0986]\n  Sum: 1.0000\n  Predicted class: 0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Load Iris dataset\niris = load_iris()\ndf = pd.DataFrame(iris.data, columns=iris.feature_names)\ndf['species'] = iris.target\n\nprint(f\"Dataset shape: {df.shape}\")\nprint(f\"Classes: {list(iris.target_names)}\")\nprint(f\"\\nClass distribution:\")\nfor i, name in enumerate(iris.target_names):\n    count = np.sum(iris.target == i)\n    print(f\"  {name}: {count} samples\")\nprint(f\"\\nFeature statistics:\")\nprint(df.describe().round(2).to_string())"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Dataset shape: (150, 5)\nClasses: ['setosa', 'versicolor', 'virginica']\n\nClass distribution:\n  setosa: 50 samples\n  versicolor: 50 samples\n  virginica: 50 samples\n\nFeature statistics:\n       sepal length (cm)  sepal width (cm)  petal length (cm)  petal width (cm)  species\ncount             150.00            150.00             150.00            150.00   150.00\nmean                5.84              3.06               3.76              1.20     1.00\nstd                 0.83              0.44               1.77              0.76     0.82\nmin                 4.30              2.00               1.00              0.10     0.00\n25%                 5.10              2.80               1.60              0.30     0.00\n50%                 5.80              3.00               4.35              1.30     1.00\n75%                 6.40              3.30               5.10              1.80     2.00\nmax                 7.90              4.40               6.90              2.50     2.00"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Prepare data\nX = iris.data\ny = iris.target\n\nX_train, X_test, y_train, y_test = train_test_split(\n    X, y, test_size=0.3, random_state=42\n)\n\nscaler = StandardScaler()\nX_train_scaled = scaler.fit_transform(X_train)\nX_test_scaled = scaler.transform(X_test)\n\n# Train multinomial logistic regression\nmodel_multi = LogisticRegression(\n    multi_class='multinomial', \n    solver='lbfgs', \n    max_iter=1000, \n    random_state=42\n)\nmodel_multi.fit(X_train_scaled, y_train)\n\n# Train OvR logistic regression for comparison\nmodel_ovr = LogisticRegression(\n    multi_class='ovr', \n    solver='lbfgs', \n    max_iter=1000, \n    random_state=42\n)\nmodel_ovr.fit(X_train_scaled, y_train)\n\n# Compare\ny_pred_multi = model_multi.predict(X_test_scaled)\ny_pred_ovr = model_ovr.predict(X_test_scaled)\n\nprint(\"Multiclass Strategy Comparison:\")\nprint(f\"  Multinomial (softmax) accuracy: {accuracy_score(y_test, y_pred_multi):.4f}\")\nprint(f\"  One-vs-Rest (OvR) accuracy:     {accuracy_score(y_test, y_pred_ovr):.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Multiclass Strategy Comparison:\n  Multinomial (softmax) accuracy: 0.9778\n  One-vs-Rest (OvR) accuracy:     0.9778"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Confusion matrix\ncm = confusion_matrix(y_test, y_pred_multi)\nprint(\"Confusion Matrix (Multinomial):\")\nprint(f\"{'':>15} {'Predicted':^30}\")\nprint(f\"{'':>15} {'setosa':>10} {'versicolor':>10} {'virginica':>10}\")\nprint(\"-\" * 55)\nfor i, name in enumerate(iris.target_names):\n    print(f\"  Actual {name:>10} {cm[i,0]:>10} {cm[i,1]:>10} {cm[i,2]:>10}\")\n\nprint(f\"\\nPer-class accuracy:\")\nfor i, name in enumerate(iris.target_names):\n    class_total = cm[i].sum()\n    class_correct = cm[i, i]\n    print(f\"  {name}: {class_correct}/{class_total} ({class_correct/class_total*100:.1f}%)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Confusion Matrix (Multinomial):\n                        Predicted\n                   setosa versicolor  virginica\n-------------------------------------------------------\n  Actual     setosa         19          0          0\n  Actual versicolor          0         12          1\n  Actual  virginica          0          0         13\n\nPer-class accuracy:\n  setosa: 19/19 (100.0%)\n  versicolor: 12/13 (92.3%)\n  virginica: 13/13 (100.0%)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "print(\"Full Classification Report:\")\nprint(classification_report(y_test, y_pred_multi, target_names=iris.target_names))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Full Classification Report:\n              precision    recall  f1-score   support\n\n      setosa       1.00      1.00      1.00        19\n  versicolor       1.00      0.92      0.96        13\n   virginica       0.93      1.00      0.96        13\n\n    accuracy                           0.98        45\n   macro avg       0.98      0.97      0.97        45\nweighted avg       0.98      0.98      0.98        45"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Test different regularization strengths\nC_values = [0.01, 0.1, 1.0, 10.0, 100.0]\n\nprint(\"Regularization Strength (C) Effect:\")\nprint(f\"{'C':>8} {'Train Acc':>10} {'Test Acc':>10} {'Max |Coef|':>12}\")\nprint(\"-\" * 44)\n\nfor C in C_values:\n    model = LogisticRegression(C=C, multi_class='multinomial', \n                               solver='lbfgs', max_iter=1000, random_state=42)\n    model.fit(X_train_scaled, y_train)\n    train_acc = model.score(X_train_scaled, y_train)\n    test_acc = model.score(X_test_scaled, y_test)\n    max_coef = np.max(np.abs(model.coef_))\n    print(f\"{C:>8.2f} {train_acc:>10.4f} {test_acc:>10.4f} {max_coef:>12.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Regularization Strength (C) Effect:\n       C  Train Acc   Test Acc   Max |Coef|\n--------------------------------------------\n    0.01     0.8476     0.8222       0.5933\n    0.10     0.9524     0.9556       1.5497\n    1.00     0.9810     0.9778       2.7543\n   10.00     0.9905     0.9778       4.4253\n  100.00     0.9905     0.9778       6.1449"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Get probability predictions\ny_prob = model_multi.predict_proba(X_test_scaled)\n\n# Compute ROC AUC for each class\nprint(\"ROC AUC per Class (One-vs-Rest):\")\nprint(f\"{'Class':<15} {'AUC':>8} {'Interpretation'}\")\nprint(\"-\" * 45)\n\nfrom sklearn.preprocessing import label_binarize\ny_test_bin = label_binarize(y_test, classes=[0, 1, 2])\n\nfor i, name in enumerate(iris.target_names):\n    fpr, tpr, thresholds = roc_curve(y_test_bin[:, i], y_prob[:, i])\n    roc_auc = auc(fpr, tpr)\n    interp = \"Perfect\" if roc_auc > 0.99 else \"Excellent\" if roc_auc > 0.95 else \"Good\"\n    print(f\"{name:<15} {roc_auc:>8.4f} {interp}\")\n\n# Macro average AUC\nmacro_auc = np.mean([auc(roc_curve(y_test_bin[:, i], y_prob[:, i])[0], \n                         roc_curve(y_test_bin[:, i], y_prob[:, i])[1]) \n                     for i in range(3)])\nprint(f\"\\n{'Macro Avg AUC':<15} {macro_auc:>8.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "ROC AUC per Class (One-vs-Rest):\nClass               AUC Interpretation\n---------------------------------------------\nsetosa             1.0000 Perfect\nversicolor         0.9953 Excellent\nvirginica          0.9977 Excellent\n\nMacro Avg AUC      0.9977"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.datasets import load_breast_cancer\n\n# Reload breast cancer data\ncancer = load_breast_cancer()\nX_bc = cancer.data\ny_bc = cancer.target\n\nX_train_bc, X_test_bc, y_train_bc, y_test_bc = train_test_split(\n    X_bc, y_bc, test_size=0.2, random_state=42\n)\n\nscaler_bc = StandardScaler()\nX_train_bc_s = scaler_bc.fit_transform(X_train_bc)\nX_test_bc_s = scaler_bc.transform(X_test_bc)\n\nmodel_bc = LogisticRegression(max_iter=10000, random_state=42)\nmodel_bc.fit(X_train_bc_s, y_train_bc)\n\n# Get probabilities for positive class (benign)\ny_prob_bc = model_bc.predict_proba(X_test_bc_s)[:, 1]\n\n# Try different thresholds\nprint(\"Threshold Tuning (Breast Cancer - detecting malignant):\")\nprint(f\"{'Threshold':>10} {'Accuracy':>9} {'Recall(M)':>10} {'Precision(M)':>13} {'FP':>4} {'FN':>4}\")\nprint(\"-\" * 55)\n\nfor threshold in [0.3, 0.4, 0.5, 0.6, 0.7, 0.8]:\n    y_pred_t = (y_prob_bc >= threshold).astype(int)\n    acc = accuracy_score(y_test_bc, y_pred_t)\n    cm_t = confusion_matrix(y_test_bc, y_pred_t)\n    tn, fp, fn, tp = cm_t.ravel()\n    # Recall for malignant (class 0): how many malignant correctly identified\n    recall_m = tn / (tn + fp) if (tn + fp) > 0 else 0\n    # Precision for malignant: of those predicted malignant, how many correct\n    prec_m = tn / (tn + fn) if (tn + fn) > 0 else 0\n    print(f\"{threshold:>10.1f} {acc:>9.4f} {recall_m:>10.4f} {prec_m:>13.4f} {fp:>4} {fn:>4}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Threshold Tuning (Breast Cancer - detecting malignant):\n Threshold  Accuracy Recall(M)  Precision(M)   FP   FN\n-------------------------------------------------------\n       0.3    0.9561     1.0000        0.9149    0    5\n       0.4    0.9649     1.0000        0.9348    0    4\n       0.5    0.9737     0.9302        1.0000    3    0\n       0.6    0.9737     0.9302        1.0000    3    0\n       0.7    0.9649     0.9070        1.0000    4    0\n       0.8    0.9561     0.8837        1.0000    5    0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
