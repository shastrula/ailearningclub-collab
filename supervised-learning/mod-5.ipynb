      "outputs": [],
      "source": [
        [
          "python",
          "# ROC curve for breast cancer\nfpr_bc, tpr_bc, thresholds_bc = roc_curve(y_test_bc, y_prob_bc)\nroc_auc_bc = auc(fpr_bc, tpr_bc)\n\nprint(f\"Breast Cancer Model ROC AUC: {roc_auc_bc:.4f}\")\nprint(f\"\\nROC Curve Points (sampled):\")\nprint(f\"{'FPR':>8} {'TPR':>8} {'Threshold':>10}\")\nprint(\"-\" * 30)\n\n# Sample key points from the curve\nsample_idx = np.linspace(0, len(fpr_bc)-1, 8, dtype=int)\nfor idx in sample_idx:\n    t = thresholds_bc[idx] if idx < len(thresholds_bc) else 0\n    print(f\"{fpr_bc[idx]:>8.4f} {tpr_bc[idx]:>8.4f} {t:>10.4f}\")"
        ]
      ]
