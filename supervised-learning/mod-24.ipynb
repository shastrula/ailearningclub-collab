          "python",
          "# Feature importance: how much each feature contributes to predictions\nimportances = tree_pruned.feature_importances_\nfeature_names = X.columns\n\n# Normalize to percentages\nimportances_pct = 100 * importances / importances.sum()\n\nfeature_importance_df = pd.DataFrame({\n    'Feature': feature_names,\n    'Importance': importances,\n    'Importance %': importances_pct\n}).sort_values('Importance', ascending=False)\n\nprint(\"Feature Importance:\")\nprint(feature_importance_df)\n\n# Visualize\nplt.figure(figsize=(10, 6))\nplt.barh(feature_importance_df['Feature'], feature_importance_df['Importance %'], \n         edgecolor='black', alpha=0.7)\nplt.xlabel('Importance (%)')\nplt.title('Feature Importance in Pruned Tree')\nplt.grid(True, alpha=0.3, axis='x')\nplt.tight_layout()\nplt.show()\n\n# Top 3 important features\ntop_features = feature_importance_df.head(3)['Feature'].tolist()\nprint(f\"\\nTop 3 decision drivers: {', '.join(top_features)}\")"
