      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.datasets import load_iris\n\n# Load dataset\niris = load_iris()\ndf = pd.DataFrame(iris.data, columns=iris.feature_names)\ndf['species'] = iris.target\ndf['species_name'] = df['species'].map({0: 'setosa', 1: 'versicolor', 2: 'virginica'})\n\nprint(\"Dataset Shape:\", df.shape)\nprint(f\"\\nClasses: {list(iris.target_names)}\")\nprint(f\"\\nClass Distribution:\")\nprint(df['species_name'].value_counts())\nprint(f\"\\nFeature Statistics:\")\nprint(df.describe().round(2))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Dataset Shape: (150, 6)\n\nClasses: ['setosa', 'versicolor', 'virginica']\n\nClass Distribution:\nspecies_name\nsetosa        50\nversicolor    50\nvirginica     50\nName: count, dtype: int64\n\nFeature Statistics:\n       sepal length (cm)  sepal width (cm)  petal length (cm)  petal width (cm)  species\ncount             150.00            150.00             150.00            150.00   150.00\nmean                5.84              3.06               3.76              1.20     1.00\nstd                 0.83              0.44               1.77              0.76     0.82\nmin                 4.30              2.00               1.00              0.10     0.00\n25%                 5.10              2.80               1.60              0.30     0.00\n50%                 5.80              3.00               4.35              1.30     1.00\n75%                 6.40              3.30               5.10              1.80     2.00\nmax                 7.90              4.40               6.90              2.50     2.00"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Mean features by species\nprint(\"=== Mean Features by Species ===\")\nfeature_means = df.groupby('species_name')[iris.feature_names].mean().round(2)\nprint(feature_means)\n\n# Feature separation analysis\nprint(\"\\n\\n=== Feature Discriminative Power ===\")\nfor feat in iris.feature_names:\n    range_total = df[feat].max() - df[feat].min()\n    between_class_var = df.groupby('species')[feat].mean().var()\n    within_class_var = df.groupby('species')[feat].var().mean()\n    ratio = between_class_var / within_class_var if within_class_var > 0 else 0\n    print(f\"  {feat:20s}: Between/Within variance ratio = {ratio:.2f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "=== Mean Features by Species ===\n              sepal length (cm)  sepal width (cm)  petal length (cm)  petal width (cm)\nspecies_name\nsetosa                     5.01              3.43               1.46              0.25\nversicolor                 5.94              2.77               4.26              1.33\nvirginica                  6.59              2.97               5.55              2.03\n\n=== Feature Discriminative Power ===\n  sepal length (cm)   : Between/Within variance ratio = 1.82\n  sepal width (cm)    : Between/Within variance ratio = 0.59\n  petal length (cm)   : Between/Within variance ratio = 19.05\n  petal width (cm)    : Between/Within variance ratio = 16.04"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.model_selection import train_test_split\nfrom sklearn.tree import DecisionTreeClassifier\n\n# Prepare data\nX = df[iris.feature_names]\ny = df['species']\n\n# Train/test split\nX_train, X_test, y_train, y_test = train_test_split(\n    X, y, test_size=0.3, random_state=42, stratify=y\n)\n\nprint(f\"Training samples: {X_train.shape[0]}\")\nprint(f\"Test samples: {X_test.shape[0]}\")\n\n# Train unrestricted tree (no pruning)\ntree_full = DecisionTreeClassifier(random_state=42)\ntree_full.fit(X_train, y_train)\n\ntrain_acc = tree_full.score(X_train, y_train)\ntest_acc = tree_full.score(X_test, y_test)\n\nprint(f\"\\n=== Unrestricted Decision Tree ===\")\nprint(f\"Tree Depth: {tree_full.get_depth()}\")\nprint(f\"Number of Leaves: {tree_full.get_n_leaves()}\")\nprint(f\"Training Accuracy: {train_acc:.4f} ({train_acc*100:.2f}%)\")\nprint(f\"Test Accuracy:     {test_acc:.4f} ({test_acc*100:.2f}%)\")\nprint(f\"Overfitting Gap:   {(train_acc - test_acc)*100:.2f}%\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Training samples: 105\nTest samples: 45\n\n=== Unrestricted Decision Tree ===\nTree Depth: 5\nNumber of Leaves: 9\nTraining Accuracy: 1.0000 (100.00%)\nTest Accuracy:     0.9556 (95.56%)\nOverfitting Gap:   4.44%"
        ]
