          "python",
          "# Random baseline: predict majority class\nbaseline_pred = np.ones(len(y_test)) * y_test.mode()[0]\nbaseline_acc = accuracy_score(y_test, baseline_pred)\n\n# Always approve\nalways_approve = np.ones(len(y_test))\nalways_approve_acc = accuracy_score(y_test, always_approve)\n\n# Tree performance\ntree_acc = tree_pruned.score(X_test, y_test)\n\n# Compare\nprint(\"Accuracy Comparison:\")\nprint(f\"Always approve: {always_approve_acc:.4f}\")\nprint(f\"Majority class baseline: {baseline_acc:.4f}\")\nprint(f\"Decision tree: {tree_acc:.4f}\")\n\nimprovement = tree_acc - baseline_acc\nprint(f\"\\nImprovement over baseline: {improvement:.4f} ({improvement*100:.2f}%)\")\n\nif improvement > 0.05:\n    print(\"\u2713 Tree provides meaningful improvement over baseline\")\nelse:\n    print(\"\u26a0\ufe0f Improvement is modest\u2014consider more features or different model\")\n\n# Detailed comparison\ncm_tree = confusion_matrix(y_test, tree_pruned.predict(X_test))\ncm_baseline = confusion_matrix(y_test, baseline_pred)\n\nprint(f\"\\nTree confusion matrix:\\n{cm_tree}\")\nprint(f\"Baseline confusion matrix:\\n{cm_baseline}\")\n\nprint(\"\\nTree classification report:\")\nprint(classification_report(y_test, tree_pruned.predict(X_test), \n                           target_names=['Rejected', 'Approved']))\n\n# Business metrics\napproved_by_tree = tree_pruned.predict(X_test).sum()\napproved_by_baseline = always_approve_acc * len(y_test)\ncorrectly_approved = cm_tree[1, 1]\n\nprint(f\"\\nBusiness Impact:\")\nprint(f\"Baseline approves: {int(approved_by_baseline)} applications\")\nprint(f\"Tree approves: {approved_by_tree} applications\")\nprint(f\"Of tree approvals, {correctly_approved} are actually approved (quality check)\")"
