      "source": [
        [
          "python",
          "# Trace a prediction through the tree\nsample_idx = 0\nsample = X_test.iloc[sample_idx:sample_idx+1]\nprediction = tree_best.predict(sample)[0]\nprobabilities = tree_best.predict_proba(sample)[0]\n\nprint(\"=== Prediction Walkthrough ===\")\nprint(f\"Sample features:\")\nfor feat, val in zip(iris.feature_names, sample.values[0]):\n    print(f\"  {feat}: {val:.1f}\")\nprint(f\"\\nPredicted class: {prediction} ({iris.target_names[prediction]})\")\nprint(f\"Actual class:    {y_test.iloc[sample_idx]} ({iris.target_names[y_test.iloc[sample_idx]]})\")\nprint(f\"Class probabilities: {dict(zip(iris.target_names, probabilities.round(3)))}\")\n\n# Show decision path\nprint(f\"\\nDecision Path:\")\nnode_indicator = tree_best.decision_path(sample)\nnode_ids = node_indicator.indices\nfeature = tree_best.tree_.feature\nthreshold = tree_best.tree_.threshold\nfor node_id in node_ids:\n    if feature[node_id] >= 0:\n        feat_name = iris.feature_names[feature[node_id]]\n        thresh = threshold[node_id]\n        val = sample.values[0][feature[node_id]]\n        direction = \"<=\" if val <= thresh else \">\"\n        print(f\"  Node {node_id}: {feat_name} = {val:.2f} {direction} {thresh:.2f}\")\n    else:\n        print(f\"  Node {node_id}: LEAF \u2192 class {prediction}\")"
        ]
