        [
          "python",
          "=== Detailed Comparison ===\n\n--- max_depth = 2 ---\n              precision    recall  f1-score   support\n\n      setosa       1.00      1.00      1.00        15\n  versicolor       0.88      1.00      0.94        15\n   virginica       1.00      0.87      0.93        15\n\n    accuracy                           0.96        45\n   macro avg       0.96      0.96      0.96        45\nweighted avg       0.96      0.96      0.96        45\n\n--- max_depth = 3 ---\n              precision    recall  f1-score   support\n\n      setosa       1.00      1.00      1.00        15\n  versicolor       0.94      0.93      0.93        15\n   virginica       0.93      0.93      0.93        15\n\n    accuracy                           0.96        45\n   macro avg       0.96      0.96      0.96        45\nweighted avg       0.96      0.96      0.96        45\n\n--- max_depth = Full ---\n              precision    recall  f1-score   support\n\n      setosa       1.00      1.00      1.00        15\n  versicolor       0.94      0.93      0.93        15\n   virginica       0.93      0.93      0.93        15\n\n    accuracy                           0.96        45\n   macro avg       0.96      0.96      0.96        45\nweighted avg       0.96      0.96      0.96        45"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Feature importance from the best model (depth=3)\ntree_best = DecisionTreeClassifier(max_depth=3, random_state=42)\ntree_best.fit(X_train, y_train)\n\nprint(\"=== Feature Importance (max_depth=3) ===\")\nimportances = tree_best.feature_importances_\nsorted_idx = np.argsort(importances)[::-1]\n\nfor idx in sorted_idx:\n    bar = \"\u2588\" * int(importances[idx] * 40)\n    print(f\"  {iris.feature_names[idx]:20s}: {importances[idx]:.4f} {bar}\")\n\nprint(f\"\\n=== Feature Importance Comparison Across Depths ===\")\nprint(f\"{'Feature':<22} {'Depth=2':<10} {'Depth=3':<10} {'Full':<10}\")\nfor feat_idx in range(4):\n    imp_2 = DecisionTreeClassifier(max_depth=2, random_state=42).fit(X_train, y_train).feature_importances_[feat_idx]\n    imp_3 = tree_best.feature_importances_[feat_idx]\n    imp_f = tree_full.feature_importances_[feat_idx]\n    print(f\"  {iris.feature_names[feat_idx]:<22} {imp_2:<10.4f} {imp_3:<10.4f} {imp_f:<10.4f}\")"
        ]
      ]
