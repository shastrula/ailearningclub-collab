      "source": [
        [
          "python",
          "# Train initial tree (no depth limit\u2014will overfit)\ntree_full = DecisionTreeClassifier(random_state=42)\ntree_full.fit(X_train, y_train)\n\nprint(f\"Full tree depth: {tree_full.get_depth()}\")\nprint(f\"Full tree leaves: {tree_full.get_n_leaves()}\")\n\n# Visualize the tree\nplt.figure(figsize=(20, 12))\nplot_tree(tree_full, feature_names=X.columns, class_names=['Rejected', 'Approved'],\n          filled=True, rounded=True, fontsize=10)\nplt.title(\"Decision Tree (Unpruned)\")\nplt.tight_layout()\nplt.show()\n\n# Training and test accuracy\ntrain_acc_full = tree_full.score(X_train, y_train)\ntest_acc_full = tree_full.score(X_test, y_test)\n\nprint(f\"Full tree training accuracy: {train_acc_full:.4f}\")\nprint(f\"Full tree test accuracy: {test_acc_full:.4f}\")\n\nif train_acc_full - test_acc_full > 0.1:\n    print(\"\u26a0\ufe0f Large gap between training and test accuracy\u2014significant overfitting\")"
        ]
      ]
    },
    {
