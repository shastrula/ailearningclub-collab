      "source": [
        [
          "python",
          "from sklearn.tree import export_text\n\n# Text visualization of the tree\ntree_rules = export_text(tree_full, feature_names=iris.feature_names, max_depth=3)\nprint(\"=== Decision Tree Rules (first 3 levels) ===\")\nprint(tree_rules)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "=== Decision Tree Rules (first 3 levels) ===\n|--- petal width (cm) <= 0.75\n|   |--- class: 0\n|--- petal width (cm) >  0.75\n|   |--- petal width (cm) <= 1.75\n|   |   |--- petal length (cm) <= 4.95\n|   |   |   |--- class: 1\n|   |   |--- petal length (cm) >  4.95\n|   |   |   |--- class: 2\n|   |--- petal width (cm) >  1.75\n|   |   |--- petal length (cm) <= 4.85\n|   |   |   |--- class: 2\n|   |   |--- petal length (cm) >  4.85\n|   |   |   |--- class: 2"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Experiment with different max_depth values\nprint(\"=== Pruning Experiment: max_depth ===\")\nprint(f\"{'max_depth':<12} {'Train Acc':<12} {'Test Acc':<12} {'Gap':<10} {'Leaves':<8} {'Status'}\")\nprint(\"-\" * 70)\n\nresults = []\nfor depth in [1, 2, 3, 4, 5, 6, None]:\n    tree = DecisionTreeClassifier(max_depth=depth, random_state=42)\n    tree.fit(X_train, y_train)\n    train_a = tree.score(X_train, y_train)\n    test_a = tree.score(X_test, y_test)\n    gap = train_a - test_a\n    leaves = tree.get_n_leaves()\n    depth_str = str(depth) if depth else \"None\"\n\n    if gap < 0.02:\n        status = \"Good generalization\"\n    elif gap < 0.05:\n        status = \"Mild overfitting\"\n    else:\n        status = \"Overfitting\"\n\n    results.append({'depth': depth, 'train': train_a, 'test': test_a, 'gap': gap, 'leaves': leaves})\n    print(f\"  {depth_str:<12} {train_a:<12.4f} {test_a:<12.4f} {gap:<10.4f} {leaves:<8} {status}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "=== Pruning Experiment: max_depth ===\nmax_depth    Train Acc    Test Acc     Gap        Leaves   Status\n----------------------------------------------------------------------\n  1            0.6667       0.6667       0.0000   2        Good generalization\n  2            0.9619       0.9556       0.0063   4        Good generalization\n  3            0.9810       0.9556       0.0254   7        Mild overfitting\n  4            0.9905       0.9556       0.0349   8        Mild overfitting\n  5            1.0000       0.9556       0.0444   9        Mild overfitting\n  6            1.0000       0.9556       0.0444   9        Mild overfitting\n  None         1.0000       0.9556       0.0444   9        Mild overfitting"
