        [
          "python",
          "# Pruning: remove branches that don't improve validation performance\n# Use cost_complexity_pruning to find optimal alpha (complexity parameter)\n\npath = tree_full.cost_complexity_pruning_path(X_train, y_train)\nccp_alphas = path.ccp_alphas\nimpurities = path.impurities\n\n# Train trees with different complexity parameters\ntrees = []\nfor ccp_alpha in ccp_alphas:\n    tree = DecisionTreeClassifier(random_state=42, ccp_alpha=ccp_alpha)\n    tree.fit(X_train, y_train)\n    trees.append(tree)\n\n# Track performance across alphas\ntrain_scores = [tree.score(X_train, y_train) for tree in trees]\ntest_scores = [tree.score(X_test, y_test) for tree in trees]\ndepths = [tree.get_depth() for tree in trees]\n\n# Plot pruning curves\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\naxes[0].plot(ccp_alphas, train_scores, marker='o', label='Training', drawstyle='steps-post')\naxes[0].plot(ccp_alphas, test_scores, marker='s', label='Test', drawstyle='steps-post')\naxes[0].set_xlabel('Alpha (Complexity Parameter)')\naxes[0].set_ylabel('Accuracy')\naxes[0].set_title('Pruning Curve: Accuracy vs Complexity')\naxes[0].legend()\naxes[0].grid(True, alpha=0.3)\n\naxes[1].plot(ccp_alphas, depths, marker='o', drawstyle='steps-post')\naxes[1].set_xlabel('Alpha')\naxes[1].set_ylabel('Tree Depth')\naxes[1].set_title('Tree Depth vs Complexity')\naxes[1].grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.show()\n\n# Find optimal alpha (best test accuracy)\noptimal_idx = np.argmax(test_scores)\noptimal_alpha = ccp_alphas[optimal_idx]\ntree_pruned = trees[optimal_idx]\n\nprint(f\"\\nOptimal alpha: {optimal_alpha:.6f}\")\nprint(f\"Optimal tree depth: {tree_pruned.get_depth()}\")\nprint(f\"Optimal tree leaves: {tree_pruned.get_n_leaves()}\")\nprint(f\"Pruned tree test accuracy: {test_scores[optimal_idx]:.4f}\")\n\n# Visualize pruned tree (much simpler!)\nplt.figure(figsize=(14, 8))\nplot_tree(tree_pruned, feature_names=X.columns, class_names=['Rejected', 'Approved'],\n          filled=True, rounded=True, fontsize=10)\nplt.title(\"Decision Tree (Pruned)\")\nplt.tight_layout()\nplt.show()"
