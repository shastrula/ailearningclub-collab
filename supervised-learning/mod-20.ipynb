          "python",
          "from sklearn.ensemble import GradientBoostingClassifier\nfrom sklearn.metrics import roc_auc_score\n\n# Simulate credit scoring dataset\nnp.random.seed(42)\nn_samples = 2000\n\ncredit_data = pd.DataFrame({\n    'income': np.random.lognormal(10.5, 0.5, n_samples),\n    'age': np.random.normal(40, 12, n_samples).clip(18, 75),\n    'employment_years': np.random.exponential(5, n_samples).clip(0, 30),\n    'debt_to_income': np.random.beta(2, 5, n_samples),\n    'num_credit_lines': np.random.poisson(5, n_samples),\n    'credit_utilization': np.random.beta(3, 7, n_samples),\n    'num_late_payments': np.random.poisson(1, n_samples),\n    'loan_amount': np.random.lognormal(10, 0.8, n_samples),\n})\n\n# Generate default probability based on features\ndefault_score = (\n    -0.3 * (credit_data['income'] / credit_data['income'].max()) +\n    0.4 * credit_data['debt_to_income'] +\n    0.3 * (credit_data['num_late_payments'] / 5) +\n    0.2 * credit_data['credit_utilization'] +\n    -0.1 * (credit_data['employment_years'] / 30) +\n    np.random.normal(0, 0.1, n_samples)\n)\ny_credit = (default_score > default_score.quantile(0.8)).astype(int)\n\nprint(\"APPLICATION 3: CREDIT SCORING\")\nprint(\"=\"*60)\nprint(f\"Dataset: {n_samples} applicants, {credit_data.shape[1]} features\")\nprint(f\"Default rate: {y_credit.mean()*100:.1f}%\")\nprint(f\"\\nFeature summary:\")\nprint(credit_data.describe().round(2).to_string())\n\n# Split\nX_train_cr, X_test_cr, y_train_cr, y_test_cr = train_test_split(\n    credit_data, y_credit, test_size=0.2, random_state=42, stratify=y_credit\n)\n\n# Credit scoring model: Gradient Boosting\ncredit_model = GradientBoostingClassifier(\n    n_estimators=100, max_depth=4, learning_rate=0.1, random_state=42\n)\ncredit_model.fit(X_train_cr, y_train_cr)\ny_pred_cr = credit_model.predict(X_test_cr)\ny_prob_cr = credit_model.predict_proba(X_test_cr)[:, 1]\n\nprint(f\"\\nModel: Gradient Boosting Classifier\")\nprint(f\"Accuracy: {accuracy_score(y_test_cr, y_pred_cr):.4f}\")\nprint(f\"AUC-ROC: {roc_auc_score(y_test_cr, y_prob_cr):.4f}\")\nprint(f\"\\nClassification Report:\")\nprint(classification_report(y_test_cr, y_pred_cr,\n      target_names=['No Default', 'Default']))\n\n# Feature importance\nimportances = pd.Series(\n    credit_model.feature_importances_, index=credit_data.columns\n).sort_values(ascending=False)\nprint(\"\\nFeature Importance (top predictors of default):\")\nfor feat, imp in importances.items():\n    bar = '\u2588' * int(imp * 50)\n    print(f\"  {feat:<22} {imp:.4f} {bar}\")"
