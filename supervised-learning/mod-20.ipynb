        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.model_selection import train_test_split, cross_val_score\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.naive_bayes import MultinomialNB\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import classification_report, accuracy_score\nfrom sklearn.pipeline import Pipeline\n\n# Simulated email dataset (realistic patterns)\nnp.random.seed(42)\nspam_phrases = [\n    \"win free money now\", \"congratulations you won lottery\",\n    \"click here for prize\", \"limited time offer buy now\",\n    \"earn cash from home guaranteed\", \"free gift card claim now\",\n    \"urgent action required bank account\", \"discount pills cheap\",\n    \"make money fast online\", \"special promotion exclusive deal\",\n    \"hot stock tip invest now\", \"weight loss miracle pill\",\n    \"credit card pre-approved apply\", \"nigerian prince transfer funds\",\n    \"you have been selected winner\", \"claim your reward immediately\"\n]\nham_phrases = [\n    \"meeting tomorrow at 3pm conference room\",\n    \"please review the attached document\", \"project deadline friday\",\n    \"lunch today at noon cafeteria\", \"quarterly report attached\",\n    \"team standup moved to 10am\", \"can you review my pull request\",\n    \"client meeting rescheduled to wednesday\",\n    \"budget approval needed for Q3\", \"happy birthday celebration friday\",\n    \"performance review scheduled next week\",\n    \"new hire orientation monday morning\",\n    \"code review comments on the feature branch\",\n    \"server maintenance window tonight 2am\",\n    \"holiday schedule reminder for next month\",\n    \"updated project timeline attached\"\n]\n\n# Generate 1000 emails\nemails = []\nlabels = []\nfor _ in range(500):\n    base = np.random.choice(spam_phrases)\n    noise = ' '.join(np.random.choice(['free', 'money', 'click', 'offer', 'now', 'win',\n                                        'limited', 'act', 'fast', 'guaranteed'], size=3))\n    emails.append(f\"{base} {noise}\")\n    labels.append(1)  # spam\n\nfor _ in range(500):\n    base = np.random.choice(ham_phrases)\n    noise = ' '.join(np.random.choice(['please', 'thanks', 'team', 'update', 'meeting',\n                                        'review', 'attached', 'schedule', 'project'], size=3))\n    emails.append(f\"{base} {noise}\")\n    labels.append(0)  # ham\n\nX_emails = pd.Series(emails)\ny_emails = np.array(labels)\n\n# Split\nX_train_e, X_test_e, y_train_e, y_test_e = train_test_split(\n    X_emails, y_emails, test_size=0.2, random_state=42, stratify=y_emails\n)\n\n# Build spam detection pipeline\nspam_pipeline = Pipeline([\n    ('tfidf', TfidfVectorizer(max_features=500, stop_words='english')),\n    ('classifier', MultinomialNB())\n])\n\nspam_pipeline.fit(X_train_e, y_train_e)\ny_pred_spam = spam_pipeline.predict(X_test_e)\n\nprint(\"APPLICATION 1: SPAM DETECTION\")\nprint(\"=\"*60)\nprint(f\"Dataset: {len(X_emails)} emails (50% spam, 50% ham)\")\nprint(f\"Features: TF-IDF (max 500 terms)\")\nprint(f\"Model: Multinomial Naive Bayes\")\nprint(f\"\\nAccuracy: {accuracy_score(y_test_e, y_pred_spam):.4f}\")\nprint(f\"\\nClassification Report:\")\nprint(classification_report(y_test_e, y_pred_spam, \n      target_names=['Ham', 'Spam']))\n\n# Test with new emails\nnew_emails = [\n    \"free money click here to win prize now\",\n    \"team meeting rescheduled to 2pm tomorrow\",\n    \"earn cash guaranteed fast no risk\"\n]\npredictions = spam_pipeline.predict(new_emails)\nprint(\"Predictions on new emails:\")\nfor email, pred in zip(new_emails, predictions):\n    print(f\"  '{email[:45]}...' \u2192 {'SPAM' if pred == 1 else 'HAM'}\")"
        ]
      ]
    },
