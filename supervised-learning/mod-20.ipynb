          "python",
          "from sklearn.ensemble import RandomForestRegressor\nfrom sklearn.metrics import mean_absolute_error\n\n# Simulate movie rating dataset\nnp.random.seed(42)\nn_users = 200\nn_movies = 50\n\n# Movie features\nmovie_features = pd.DataFrame({\n    'movie_id': range(n_movies),\n    'action': np.random.binomial(1, 0.3, n_movies),\n    'comedy': np.random.binomial(1, 0.25, n_movies),\n    'drama': np.random.binomial(1, 0.35, n_movies),\n    'scifi': np.random.binomial(1, 0.15, n_movies),\n    'romance': np.random.binomial(1, 0.2, n_movies),\n    'avg_rating': np.random.uniform(2.5, 4.5, n_movies),\n    'year': np.random.randint(1990, 2024, n_movies),\n    'duration_min': np.random.normal(120, 25, n_movies).clip(80, 200),\n})\n\n# User preferences (hidden patterns)\nuser_prefs = pd.DataFrame({\n    'user_id': range(n_users),\n    'likes_action': np.random.uniform(0, 1, n_users),\n    'likes_comedy': np.random.uniform(0, 1, n_users),\n    'likes_drama': np.random.uniform(0, 1, n_users),\n    'prefers_new': np.random.uniform(0, 1, n_users),\n})\n\n# Generate ratings based on user-movie compatibility\nratings = []\nfor user_id in range(n_users):\n    movies_rated = np.random.choice(n_movies, size=20, replace=False)\n    for movie_id in movies_rated:\n        movie = movie_features.iloc[movie_id]\n        user = user_prefs.iloc[user_id]\n        \n        # Rating based on preference match\n        rating = 3.0\n        rating += user['likes_action'] * movie['action'] * 1.5\n        rating += user['likes_comedy'] * movie['comedy'] * 1.0\n        rating += user['likes_drama'] * movie['drama'] * 0.8\n        rating += user['prefers_new'] * (movie['year'] - 2000) / 24\n        rating += np.random.normal(0, 0.5)  # noise\n        rating = np.clip(rating, 1, 5)\n        \n        ratings.append({\n            'user_id': user_id,\n            'movie_id': movie_id,\n            'rating': round(rating, 1),\n            'action': movie['action'],\n            'comedy': movie['comedy'],\n            'drama': movie['drama'],\n            'scifi': movie['scifi'],\n            'romance': movie['romance'],\n            'avg_rating': movie['avg_rating'],\n            'year': movie['year'],\n            'duration_min': movie['duration_min'],\n        })\n\nratings_df = pd.DataFrame(ratings)\nprint(\"APPLICATION 4: MOVIE RECOMMENDATION\")\nprint(\"=\"*60)\nprint(f\"Dataset: {len(ratings_df)} ratings from {n_users} users on {n_movies} movies\")\nprint(f\"Rating distribution:\")\nprint(ratings_df['rating'].describe().round(2))\n\n# Features for prediction\nfeature_cols = ['action', 'comedy', 'drama', 'scifi', 'romance',\n                'avg_rating', 'year', 'duration_min']\nX_ratings = ratings_df[feature_cols]\ny_ratings = ratings_df['rating']\n\n# Split\nX_train_r, X_test_r, y_train_r, y_test_r = train_test_split(\n    X_ratings, y_ratings, test_size=0.2, random_state=42\n)\n\n# Recommendation model\nrec_model = RandomForestRegressor(n_estimators=100, max_depth=10, random_state=42)\nrec_model.fit(X_train_r, y_train_r)\ny_pred_r = rec_model.predict(X_test_r)\n\nrec_r2 = r2_score(y_test_r, y_pred_r)\nrec_mae = mean_absolute_error(y_test_r, y_pred_r)\nrec_rmse = np.sqrt(mean_squared_error(y_test_r, y_pred_r))\n\nprint(f\"\\nModel: Random Forest Regressor\")\nprint(f\"R\u00b2 Score: {rec_r2:.4f}\")\nprint(f\"MAE: {rec_mae:.4f} stars\")\nprint(f\"RMSE: {rec_rmse:.4f} stars\")\n\n# Feature importance for recommendations\nimportances_rec = pd.Series(\n    rec_model.feature_importances_, index=feature_cols\n).sort_values(ascending=False)\nprint(f\"\\nWhat drives ratings (feature importance):\")\nfor feat, imp in importances_rec.items():\n    bar = '\u2588' * int(imp * 40)\n    print(f\"  {feat:<15} {imp:.4f} {bar}\")\n\n# Sample predictions\nprint(f\"\\nSample predictions vs actual:\")\nsample_idx = X_test_r.index[:5]\nfor idx in sample_idx:\n    actual = y_ratings[idx]\n    predicted = rec_model.predict(X_ratings.iloc[[idx]])[0]\n    print(f\"  Actual: {actual:.1f} | Predicted: {predicted:.1f} | Error: {abs(actual-predicted):.2f}\")"
        ]
