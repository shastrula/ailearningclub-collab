          "python",
          "from sklearn.datasets import load_breast_cancer\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.svm import SVC\nfrom sklearn.metrics import confusion_matrix\n\n# Load real breast cancer dataset\ncancer = load_breast_cancer()\nX_cancer = pd.DataFrame(cancer.data, columns=cancer.feature_names)\ny_cancer = cancer.target  # 0=malignant, 1=benign\n\nprint(\"APPLICATION 2: MEDICAL DIAGNOSIS (Breast Cancer)\")\nprint(\"=\"*60)\nprint(f\"Dataset: {X_cancer.shape[0]} samples, {X_cancer.shape[1]} features\")\nprint(f\"Classes: Malignant={sum(y_cancer==0)}, Benign={sum(y_cancer==1)}\")\nprint(f\"\\nTop features: {list(cancer.feature_names[:5])}\")\n\n# Split data\nX_train_c, X_test_c, y_train_c, y_test_c = train_test_split(\n    X_cancer, y_cancer, test_size=0.2, random_state=42, stratify=y_cancer\n)\n\n# Medical diagnosis pipeline: SVM with careful scaling\nmedical_pipeline = Pipeline([\n    ('scaler', StandardScaler()),\n    ('svm', SVC(kernel='rbf', C=10, gamma='scale', probability=True))\n])\n\nmedical_pipeline.fit(X_train_c, y_train_c)\ny_pred_cancer = medical_pipeline.predict(X_test_c)\ny_prob_cancer = medical_pipeline.predict_proba(X_test_c)\n\nprint(f\"\\nModel: SVM (RBF kernel, C=10)\")\nprint(f\"Accuracy: {accuracy_score(y_test_c, y_pred_cancer):.4f}\")\nprint(f\"\\nClassification Report:\")\nprint(classification_report(y_test_c, y_pred_cancer,\n      target_names=['Malignant', 'Benign']))\n\n# Confusion Matrix\ncm = confusion_matrix(y_test_c, y_pred_cancer)\nprint(\"Confusion Matrix:\")\nprint(f\"                Predicted\")\nprint(f\"              Malig  Benign\")\nprint(f\"  Actual Malig   {cm[0][0]:3d}    {cm[0][1]:3d}\")\nprint(f\"  Actual Benign  {cm[1][0]:3d}    {cm[1][1]:3d}\")\n\n# Critical metric: False Negatives (missed cancer)\nfn = cm[1][0] if cm.shape == (2,2) else 0\nprint(f\"\\n\u26a0\ufe0f  False Negatives (missed malignant): {cm[0][1]}\")\nprint(f\"In medical diagnosis, minimizing false negatives is CRITICAL\")\nprint(f\"Sensitivity (Recall for Malignant): {cm[0][0]/(cm[0][0]+cm[0][1]):.4f}\")"
        ]
