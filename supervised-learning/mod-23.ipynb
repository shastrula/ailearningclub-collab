      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.metrics import roc_auc_score, roc_curve\n\n# ROC AUC\nauc_score = roc_auc_score(y_test, y_prob)\nprint(f\"=== ROC Analysis ===\")\nprint(f\"AUC Score: {auc_score:.4f}\")\nprint(f\"\\nInterpretation: {auc_score:.1%} probability that the model ranks\")\nprint(f\"a random benign sample higher than a random malignant sample.\")\n\n# Key points on the ROC curve\nfpr, tpr, thresholds = roc_curve(y_test, y_prob)\nprint(f\"\\nROC Curve Key Points:\")\nprint(f\"{'Threshold':<12} {'FPR':<8} {'TPR':<8}\")\nfor i in range(0, len(thresholds), max(1, len(thresholds)//8)):\n    print(f\"  {thresholds[i]:<12.4f} {fpr[i]:<8.4f} {tpr[i]:<8.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "=== ROC Analysis ===\nAUC Score: 0.9977\n\nInterpretation: 99.8% probability that the model ranks\na random benign sample higher than a random malignant sample.\n\nROC Curve Key Points:\nThreshold    FPR      TPR\n  1.9979      0.0000   0.0000\n  0.9985      0.0000   0.5634\n  0.9975      0.0000   0.6620\n  0.9921      0.0000   0.8169\n  0.9542      0.0233   0.9577\n  0.5223      0.0465   0.9859\n  0.0177      0.0698   1.0000\n  0.0001      1.0000   1.0000"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Test different thresholds\nprint(\"=== Threshold Tuning ===\")\nprint(f\"{'Threshold':<12} {'Accuracy':<10} {'Mal Recall':<12} {'Ben Recall':<12} {'F1':<8} {'FP':<5} {'FN':<5}\")\n\nthresholds_to_test = [0.3, 0.4, 0.5, 0.6, 0.7, 0.8, 0.9]\nfor thresh in thresholds_to_test:\n    y_pred_t = (y_prob >= thresh).astype(int)\n    cm_t = confusion_matrix(y_test, y_pred_t)\n    tn_t, fp_t, fn_t, tp_t = cm_t.ravel()\n    acc = (tn_t + tp_t) / len(y_test)\n    mal_recall = tn_t / (tn_t + fp_t) if (tn_t + fp_t) > 0 else 0\n    ben_recall = tp_t / (tp_t + fn_t) if (tp_t + fn_t) > 0 else 0\n    f1 = f1_score(y_test, y_pred_t)\n    print(f\"  {thresh:<12.1f} {acc:<10.4f} {mal_recall:<12.4f} {ben_recall:<12.4f} {f1:<8.4f} {fp_t:<5} {fn_t:<5}\")\n\nprint(f\"\\nRecommendation: For cancer screening, use threshold=0.7 or higher\")\nprint(f\"to minimize false positives (missed cancers), accepting more false negatives.\")"
        ]
      ]
    },
