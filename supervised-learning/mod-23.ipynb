          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import StandardScaler, LabelEncoder\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import (confusion_matrix, classification_report, \n                             roc_curve, auc, precision_recall_curve, f1_score)\nimport matplotlib.pyplot as plt\nimport seaborn as sns\n\n# Create a synthetic churn dataset (in practice, you'd load real data)\nnp.random.seed(42)\nn_samples = 5000\n\ndata = {\n    'MonthlyCharges': np.random.uniform(18, 118, n_samples),\n    'Tenure': np.random.uniform(0, 72, n_samples),\n    'TotalCharges': np.random.uniform(20, 8500, n_samples),\n    'ContractLength': np.random.choice([1, 2, 3], n_samples),\n    'InternetService': np.random.choice(['Fiber', 'DSL', 'None'], n_samples),\n}\n\n# Create churn based on rules (realistic patterns)\nchurn_prob = (0.5 - 0.008 * data['Tenure'] + \n              0.003 * data['MonthlyCharges'] + \n              0.1 * (data['ContractLength'] == 1))\nchurn_prob = np.clip(churn_prob, 0, 1)\ndata['Churn'] = (np.random.random(n_samples) < churn_prob).astype(int)\n\ndf = pd.DataFrame(data)\n\n# Explore data\nprint(f\"Dataset shape: {df.shape}\")\nprint(f\"\\nChurn distribution:\\n{df['Churn'].value_counts(normalize=True)}\")\nprint(f\"\\nChurned customers: {df['Churn'].sum()} ({df['Churn'].mean()*100:.1f}%)\")\n\n# Visualize class imbalance\nplt.figure(figsize=(12, 4))\n\nplt.subplot(1, 2, 1)\ndf['Churn'].value_counts().plot(kind='bar', edgecolor='black', alpha=0.7)\nplt.title('Class Distribution (Imbalanced)')\nplt.ylabel('Count')\nplt.xticks([0, 1], ['No Churn', 'Churn'], rotation=0)\n\nplt.subplot(1, 2, 2)\ndf.groupby('Churn')['Tenure'].hist(alpha=0.7, bins=20)\nplt.xlabel('Tenure (months)')\nplt.title('Tenure by Churn Status')\nplt.legend(['No Churn', 'Churn'])\n\nplt.tight_layout()\nplt.show()\n\n# Feature engineering\ndf_clean = df.copy()\nencoder = LabelEncoder()\ndf_clean['InternetService'] = encoder.fit_transform(df_clean['InternetService'])\n\nX = df_clean.drop('Churn', axis=1)\ny = df_clean['Churn']\n\nprint(f\"\\nFeature statistics:\\n{X.describe()}\")"
