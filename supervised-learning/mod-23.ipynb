          "python",
          "from sklearn.model_selection import cross_validate, StratifiedKFold\n\n# Stratified K-fold ensures balanced class distribution in each fold\ncv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n\nscoring = ['accuracy', 'precision', 'recall', 'f1', 'roc_auc']\ncv_results = cross_validate(model, X_train_scaled, y_train, cv=cv, scoring=scoring)\n\nprint(\"Cross-Validation Results (5-fold):\")\nfor metric in scoring:\n    scores = cv_results[f'test_{metric}']\n    print(f\"{metric:10s}: {scores.mean():.4f} (+/- {scores.std():.4f})\")\n\n# If scores vary widely, the model may be unstable\nif cv_results['test_f1'].std() > 0.05:\n    print(\"\\n\u26a0\ufe0f High variance in F1 score across folds\u2014model may be unstable\")\nelse:\n    print(\"\\n\u2713 Consistent performance across folds\")"
