          "python",
          "# Coefficient interpretation\nfeature_names = X.columns\ncoefficients = pd.DataFrame({\n    'Feature': feature_names,\n    'Coefficient': model.coef_[0]\n}).sort_values('Coefficient', key=abs, ascending=False)\n\nprint(\"Feature Coefficients (impact on churn probability):\")\nprint(coefficients)\n\nprint(\"\\nInterpretation:\")\nfor idx, row in coefficients.iterrows():\n    direction = \"increases\" if row['Coefficient'] > 0 else \"decreases\"\n    print(f\"  \u2022 {row['Feature']}: {direction} churn probability (coef: {row['Coefficient']:.4f})\")\n\n# Odds ratio: exp(coefficient) shows multiplicative change\nprint(\"\\nOdds Ratios:\")\ncoefficients['OddsRatio'] = np.exp(coefficients['Coefficient'])\nfor idx, row in coefficients.iterrows():\n    change = (row['OddsRatio'] - 1) * 100\n    print(f\"  \u2022 {row['Feature']}: {change:+.1f}% change in odds per unit increase\")\n\n# Probability predictions for specific customer profiles\ncustomer_profiles = pd.DataFrame({\n    'MonthlyCharges': [50, 100],\n    'Tenure': [2, 60],\n    'TotalCharges': [100, 5000],\n    'ContractLength': [1, 3],\n    'InternetService': [0, 1]  # 0=Fiber, 1=DSL\n})\n\ncustomer_profiles_scaled = scaler.transform(customer_profiles)\nchurn_probabilities = model.predict_proba(customer_profiles_scaled)[:, 1]\n\nprint(\"\\nChurn Risk for Customer Profiles:\")\nprint(f\"New customer (low tenure, short contract): {churn_probabilities[0]:.1%} churn risk\")\nprint(f\"Loyal customer (high tenure, long contract): {churn_probabilities[1]:.1%} churn risk\")"
