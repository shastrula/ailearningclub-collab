      "outputs": [],
      "source": [
        [
          "python",
          "# Statistical summary of key features\nkey_features = ['mean radius', 'mean texture', 'mean perimeter', 'mean area',\n                'mean concavity', 'worst radius', 'worst concavity']\n\nprint(\"=== Key Feature Statistics by Class ===\\n\")\nfor feat in key_features:\n    benign_mean = df[df['target'] == 1][feat].mean()\n    malignant_mean = df[df['target'] == 0][feat].mean()\n    ratio = malignant_mean / benign_mean\n    print(f\"{feat:20s}: Benign={benign_mean:.2f}, Malignant={malignant_mean:.2f}, Ratio={ratio:.2f}x\")\n\n# Top correlations with target\nprint(\"\\n\\nTop 10 Features Correlated with Target:\")\ncorrelations = df.corr()['target'].drop('target').abs().sort_values(ascending=False)\nfor feat, corr in correlations.head(10).items():\n    print(f\"  {feat:30s}: {corr:.4f}\")"
        ]
      ]
    },
    {
