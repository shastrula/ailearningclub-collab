          "python",
          "# ROC curve\nfpr, tpr, thresholds = roc_curve(y_test, y_test_pred_proba)\nroc_auc = auc(fpr, tpr)\n\n# Precision-Recall curve\nprecision_vals, recall_vals, pr_thresholds = precision_recall_curve(\n    y_test, y_test_pred_proba\n)\n\n# Plot curves\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n# ROC curve\naxes[0].plot(fpr, tpr, label=f'ROC (AUC = {roc_auc:.3f})', linewidth=2)\naxes[0].plot([0, 1], [0, 1], 'k--', label='Random Classifier')\naxes[0].set_xlabel('False Positive Rate')\naxes[0].set_ylabel('True Positive Rate')\naxes[0].set_title('ROC Curve')\naxes[0].legend()\naxes[0].grid(True, alpha=0.3)\n\n# Precision-Recall curve\naxes[1].plot(recall_vals, precision_vals, label='PR Curve', linewidth=2)\naxes[1].set_xlabel('Recall')\naxes[1].set_ylabel('Precision')\naxes[1].set_title('Precision-Recall Curve')\naxes[1].legend()\naxes[1].grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.show()\n\nprint(f\"ROC AUC Score: {roc_auc:.4f}\")\n\n# Threshold optimization: find best threshold for business goal\n# Goal: balance catching churners vs. false alarms\nf1_scores = []\nthresholds_to_test = np.linspace(0.1, 0.9, 50)\n\nfor threshold in thresholds_to_test:\n    y_pred_threshold = (y_test_pred_proba >= threshold).astype(int)\n    f1 = f1_score(y_test, y_pred_threshold)\n    f1_scores.append(f1)\n\noptimal_idx = np.argmax(f1_scores)\noptimal_threshold = thresholds_to_test[optimal_idx]\noptimal_f1 = f1_scores[optimal_idx]\n\nprint(f\"\\nOptimal threshold (maximizing F1): {optimal_threshold:.3f}\")\nprint(f\"F1 score at optimal threshold: {optimal_f1:.4f}\")\n\n# Apply optimal threshold\ny_test_pred_optimized = (y_test_pred_proba >= optimal_threshold).astype(int)\nprint(\"\\nClassification Report (Optimized Threshold):\")\nprint(classification_report(y_test, y_test_pred_optimized, target_names=['No Churn', 'Churn']))\n\n# Business analysis\ndefault_alerts = (y_test_pred >= 0.5).sum()\noptimized_alerts = (y_test_pred_optimized >= optimal_threshold).sum()\nprint(f\"\\nAlerts with default threshold (0.5): {default_alerts}\")\nprint(f\"Alerts with optimized threshold ({optimal_threshold:.3f}): {optimized_alerts}\")"
