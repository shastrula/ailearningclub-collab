          "python",
          "from sklearn.ensemble import RandomForestRegressor\nfrom sklearn.inspection import partial_dependence\nfrom sklearn.datasets import fetch_california_housing\nimport numpy as np\nimport pandas as pd\n\nhousing = fetch_california_housing()\nX = pd.DataFrame(housing.data, columns=housing.feature_names)\ny = housing.target\n\nrf = RandomForestRegressor(n_estimators=200, max_depth=8, random_state=42, n_jobs=-1)\nrf.fit(X, y)\n\n# Compute partial dependence for top features\nfeatures_to_check = ['MedInc', 'HouseAge', 'AveOccup']\n\nfor feature in features_to_check:\n    pdp = partial_dependence(rf, X, features=[feature], kind='average', grid_resolution=10)\n    values = pdp['values'][0]\n    avg_pred = pdp['average'][0]\n    \n    print(f\"\\nPartial Dependence: {feature}\")\n    print(f\"{'Value':<12} {'Avg Prediction':<15}\")\n    print(\"-\" * 27)\n    for v, p in zip(values, avg_pred):\n        print(f\"{v:<12.2f} {p:<15.4f}\")"
        ]
      ]
