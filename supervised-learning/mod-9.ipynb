        [
          "python",
          "import matplotlib.pyplot as plt\nfrom sklearn.ensemble import RandomForestRegressor\nfrom sklearn.inspection import PartialDependenceDisplay\nfrom sklearn.datasets import load_diabetes\n\n# Load regression data\nX, y = load_diabetes(return_X_y=True)\nfeature_names = load_diabetes().feature_names\n\n# Train Random Forest regressor\nrf = RandomForestRegressor(n_estimators=100, random_state=42)\nrf.fit(X, y)\n\n# Create partial dependence plots for top 4 features\nfig, axes = plt.subplots(2, 2, figsize=(10, 8))\nfig.suptitle(\"Partial Dependence Plots\")\n\nfor i, ax in enumerate(axes.flat):\n    feature_idx = i\n    PartialDependenceDisplay.from_estimator(\n        rf, X, features=[feature_idx], ax=ax, feature_names=feature_names\n    )\n    ax.set_title(f\"Feature: {feature_names[feature_idx]}\")\n\nplt.tight_layout()\n# plt.show()  # Uncomment to display\n\nprint(\"Partial dependence plots created\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.ensemble import RandomForestClassifier\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import cross_val_score\nimport time\n\nX, y = make_classification(n_samples=5000, n_features=50, n_informative=20, random_state=42)\n\nn_estimator_values = [10, 20, 50, 100, 200, 500, 1000]\ncv_scores = []\ntrain_times = []\n\nfor n_est in n_estimator_values:\n    rf = RandomForestClassifier(n_estimators=n_est, random_state=42, n_jobs=-1)\n    \n    start_time = time.time()\n    scores = cross_val_score(rf, X, y, cv=3)\n    train_time = time.time() - start_time\n    \n    cv_scores.append(scores.mean())\n    train_times.append(train_time)\n    \n    print(f\"n_estimators={n_est}: CV Score={scores.mean():.4f} \u00b1 {scores.std():.4f}, Time={train_time:.2f}s\")\n\n# Find diminishing returns point\nfor i in range(1, len(cv_scores)):\n    improvement = cv_scores[i] - cv_scores[i-1]\n    print(f\"Improvement from {n_estimator_values[i-1]} to {n_estimator_values[i]}: {improvement:.4f}\")"
        ]
      ]
    },
