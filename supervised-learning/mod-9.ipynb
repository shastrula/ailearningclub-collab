          "python",
          "from sklearn.ensemble import RandomForestRegressor\nfrom sklearn.model_selection import cross_val_score\nfrom sklearn.datasets import fetch_california_housing\nimport numpy as np\nimport pandas as pd\n\nhousing = fetch_california_housing()\nX = pd.DataFrame(housing.data, columns=housing.feature_names)\ny = housing.target\n\n# Step 1: Use cross-validation for robust estimates\nrf_final = RandomForestRegressor(\n    n_estimators=300,\n    max_depth=8,\n    max_features=0.5,\n    min_samples_leaf=3,\n    random_state=42,\n    n_jobs=-1\n)\n\ncv_scores = cross_val_score(rf_final, X, y, cv=5, scoring='r2')\ncv_rmse = cross_val_score(rf_final, X, y, cv=5, scoring='neg_root_mean_squared_error')\n\nprint(\"5-Fold Cross-Validation Results:\")\nprint(f\"  R\u00b2 scores: {cv_scores.round(4)}\")\nprint(f\"  Mean R\u00b2: {cv_scores.mean():.4f} \u00b1 {cv_scores.std():.4f}\")\nprint(f\"  RMSE scores: {(-cv_rmse).round(4)}\")\nprint(f\"  Mean RMSE: {(-cv_rmse).mean():.4f} \u00b1 {(-cv_rmse).std():.4f}\")"
        ]
