          "python",
          "from sklearn.impute import SimpleImputer\nfrom sklearn.preprocessing import OneHotEncoder\n\n# Work with a copy\ndf = titanic.drop('AgeGroup', axis=1).copy()\n\n# Separate features and target\nX = df.drop('Survived', axis=1)\ny = df['Survived']\n\n# Phase 2: Feature Engineering\nprint(\"\\nPHASE 2: DATA CLEANING & FEATURE ENGINEERING\")\nprint(\"=\"*60)\n\n# Step 1: Handle missing values\nprint(\"\\nStep 1: Imputation\")\nprint(f\"  Age: Fill with median ({X['Age'].median():.1f})\")\nprint(f\"  Embarked: Fill with mode ({X['Embarked'].mode()[0]})\")\n\nX['Age'].fillna(X['Age'].median(), inplace=True)\nX['Embarked'].fillna(X['Embarked'].mode()[0], inplace=True)\n\n# Step 2: Create new features\nprint(\"\\nStep 2: Feature Engineering\")\nX['FamilySize'] = X['SibSp'] + X['Parch'] + 1\nX['IsAlone'] = (X['FamilySize'] == 1).astype(int)\nX['FarePerPerson'] = X['Fare'] / X['FamilySize']\nX['AgeBin'] = pd.cut(X['Age'], bins=[0, 12, 18, 35, 60, 80],\n                      labels=[0, 1, 2, 3, 4]).astype(int)\nX['IsChild'] = (X['Age'] < 15).astype(int)\nX['HighFare'] = (X['Fare'] > X['Fare'].quantile(0.75)).astype(int)\n\nprint(f\"  FamilySize = SibSp + Parch + 1\")\nprint(f\"  IsAlone = 1 if FamilySize == 1\")\nprint(f\"  FarePerPerson = Fare / FamilySize\")\nprint(f\"  AgeBin = binned age (0-4)\")\nprint(f\"  IsChild = 1 if Age < 15\")\nprint(f\"  HighFare = 1 if Fare > 75th percentile\")\n\n# Step 3: Encode categorical variables\nprint(\"\\nStep 3: Encoding\")\nX['Sex_encoded'] = (X['Sex'] == 'female').astype(int)\nembarked_dummies = pd.get_dummies(X['Embarked'], prefix='Embarked', drop_first=True)\nX = pd.concat([X, embarked_dummies], axis=1)\n\n# Drop original categorical columns\nX = X.drop(['Sex', 'Embarked'], axis=1)\n\nprint(f\"  Sex \u2192 Sex_encoded (female=1, male=0)\")\nprint(f\"  Embarked \u2192 Embarked_Q, Embarked_S (one-hot, drop first)\")\n\nprint(f\"\\nFinal feature set ({X.shape[1]} features):\")\nprint(f\"  {list(X.columns)}\")\nprint(f\"\\nShape: {X.shape}\")\nprint(f\"Missing values: {X.isnull().sum().sum()}\")"
