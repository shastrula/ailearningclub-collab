          "python",
          "# Create an ensemble of the top 3 models\nprint(\"\\nPHASE 4: ENSEMBLE & FINAL MODEL\")\nprint(\"=\"*70)\n\n# Voting ensemble of top performers\nensemble = VotingClassifier(\n    estimators=[\n        ('rf', RandomForestClassifier(n_estimators=200, max_depth=7, random_state=42)),\n        ('gb', GradientBoostingClassifier(n_estimators=100, max_depth=4,\n                                           learning_rate=0.1, random_state=42)),\n        ('lr', Pipeline([('scaler', StandardScaler()),\n                         ('model', LogisticRegression(max_iter=1000, random_state=42))]))\n    ],\n    voting='soft'  # Use probability averaging\n)\n\nensemble.fit(X_train, y_train)\nensemble_pred = ensemble.predict(X_test)\nensemble_prob = ensemble.predict_proba(X_test)[:, 1]\nensemble_acc = accuracy_score(y_test, ensemble_pred)\nensemble_auc = roc_auc_score(y_test, ensemble_prob)\n\nprint(f\"Ensemble (Soft Voting: RF + GB + LR)\")\nprint(f\"  Test Accuracy: {ensemble_acc:.4f}\")\nprint(f\"  Test AUC: {ensemble_auc:.4f}\")\nprint(f\"  vs Best Single: {'+'if ensemble_auc > model_results[best_model_name]['test_auc'] else ''}\"\n      f\"{(ensemble_auc - model_results[best_model_name]['test_auc'])*100:.2f}% AUC\")\n\n# Detailed classification report for final model\nprint(f\"\\nFinal Model Classification Report:\")\nprint(classification_report(y_test, ensemble_pred,\n      target_names=['Did Not Survive', 'Survived']))\n\n# Confusion Matrix\ncm = confusion_matrix(y_test, ensemble_pred)\nprint(\"Confusion Matrix:\")\nprint(f\"                    Predicted\")\nprint(f\"                 Not Surv  Survived\")\nprint(f\"  Actual Not Surv   {cm[0][0]:4d}     {cm[0][1]:4d}\")\nprint(f\"  Actual Survived   {cm[1][0]:4d}     {cm[1][1]:4d}\")\nprint(f\"\\n  Total correct: {cm[0][0]+cm[1][1]}/{len(y_test)} ({ensemble_acc*100:.1f}%)\")"
