          "python",
          "# Survival analysis by features\nprint(\"\\nSurvival Rate by Feature:\")\nprint(\"-\"*50)\n\n# By Sex\nprint(\"\\nBy Sex:\")\nsex_surv = titanic.groupby('Sex')['Survived'].agg(['mean', 'count'])\nfor idx, row in sex_surv.iterrows():\n    print(f\"  {idx:<8} Survival: {row['mean']*100:.1f}%  (n={int(row['count'])})\")\n\n# By Class\nprint(\"\\nBy Passenger Class:\")\nclass_surv = titanic.groupby('Pclass')['Survived'].agg(['mean', 'count'])\nfor idx, row in class_surv.iterrows():\n    print(f\"  Class {idx}  Survival: {row['mean']*100:.1f}%  (n={int(row['count'])})\")\n\n# By Age group\ntitanic['AgeGroup'] = pd.cut(titanic['Age'], bins=[0, 15, 30, 50, 80],\n                              labels=['Child', 'Young', 'Middle', 'Senior'])\nprint(\"\\nBy Age Group:\")\nage_surv = titanic.groupby('AgeGroup', observed=True)['Survived'].agg(['mean', 'count'])\nfor idx, row in age_surv.iterrows():\n    print(f\"  {idx:<8} Survival: {row['mean']*100:.1f}%  (n={int(row['count'])})\")\n\n# Correlation with survival\nprint(\"\\nCorrelation with Survival (numeric features):\")\nnumeric_cols = ['Pclass', 'Age', 'SibSp', 'Parch', 'Fare']\ncorrelations = titanic[numeric_cols + ['Survived']].corr()['Survived'].drop('Survived')\nfor feat, corr in correlations.sort_values(ascending=False).items():\n    direction = \"\u2191\" if corr > 0 else \"\u2193\"\n    print(f\"  {feat:<10} {corr:+.4f} {direction}\")"
