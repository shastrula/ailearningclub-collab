          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.model_selection import train_test_split, cross_val_score, StratifiedKFold\nfrom sklearn.preprocessing import StandardScaler, LabelEncoder\nfrom sklearn.metrics import (accuracy_score, classification_report,\n                              confusion_matrix, roc_auc_score)\n\n# Create Titanic-like dataset with realistic patterns\nnp.random.seed(42)\nn_passengers = 891\n\n# Generate realistic features\npclass = np.random.choice([1, 2, 3], n_passengers, p=[0.24, 0.21, 0.55])\nsex = np.random.choice(['male', 'female'], n_passengers, p=[0.65, 0.35])\nage = np.where(pclass == 1, np.random.normal(40, 12, n_passengers),\n        np.where(pclass == 2, np.random.normal(30, 10, n_passengers),\n                 np.random.normal(25, 10, n_passengers)))\nage = np.clip(age, 0.5, 80)\n\nsibsp = np.random.choice([0,1,2,3,4,5], n_passengers, p=[0.68, 0.23, 0.05, 0.02, 0.01, 0.01])\nparch = np.random.choice([0,1,2,3,4,5], n_passengers, p=[0.76, 0.13, 0.07, 0.02, 0.01, 0.01])\n\nfare = np.where(pclass == 1, np.random.lognormal(3.8, 0.5, n_passengers),\n         np.where(pclass == 2, np.random.lognormal(2.8, 0.4, n_passengers),\n                  np.random.lognormal(2.2, 0.6, n_passengers)))\n\nembarked = np.random.choice(['S', 'C', 'Q'], n_passengers, p=[0.72, 0.19, 0.09])\n\n# Generate survival based on real Titanic patterns\nsurvival_prob = np.zeros(n_passengers)\nsurvival_prob += np.where(sex == 'female', 0.35, -0.15)  # Women survived more\nsurvival_prob += np.where(pclass == 1, 0.2, np.where(pclass == 2, 0.05, -0.15))\nsurvival_prob += np.where(age < 15, 0.15, 0)  # Children survived more\nsurvival_prob += np.where(fare > 50, 0.1, 0)\nsurvival_prob += np.random.normal(0, 0.1, n_passengers)  # noise\n\nsurvived = (survival_prob > 0).astype(int)\n\n# Create DataFrame\ntitanic = pd.DataFrame({\n    'Survived': survived,\n    'Pclass': pclass,\n    'Sex': sex,\n    'Age': age.round(1),\n    'SibSp': sibsp,\n    'Parch': parch,\n    'Fare': fare.round(2),\n    'Embarked': embarked,\n})\n\n# Introduce realistic missing values\nmissing_age_idx = np.random.choice(n_passengers, size=177, replace=False)\ntitanic.loc[missing_age_idx, 'Age'] = np.nan\nmissing_embarked_idx = np.random.choice(n_passengers, size=2, replace=False)\ntitanic.loc[missing_embarked_idx, 'Embarked'] = np.nan\n\nprint(\"PHASE 1: EXPLORATORY DATA ANALYSIS\")\nprint(\"=\"*60)\nprint(f\"\\nDataset Shape: {titanic.shape}\")\nprint(f\"\\nFirst 5 rows:\")\nprint(titanic.head().to_string())\n\nprint(f\"\\nMissing Values:\")\nmissing = titanic.isnull().sum()\nfor col, count in missing[missing > 0].items():\n    print(f\"  {col}: {count} ({count/len(titanic)*100:.1f}%)\")\n\nprint(f\"\\nSurvival Rate: {titanic['Survived'].mean()*100:.1f}%\")"
        ]
      ]
