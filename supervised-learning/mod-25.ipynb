      "source": [
        [
          "python",
          "# Error analysis by price range\nprint(\"=== Error Analysis by Price Range ===\")\nprint(f\"{'Price Range':<20} {'Count':<8} {'Avg Error':<12} {'RMSE':<10} {'Notes'}\")\nprint(\"-\" * 65)\n\nranges = [(0, 1.5, \"Budget\"), (1.5, 2.5, \"Moderate\"), (2.5, 3.5, \"Upper\"), (3.5, 5.01, \"Premium\")]\nfor low, high, label in ranges:\n    mask = (y_test >= low) & (y_test < high)\n    if mask.sum() > 0:\n        errors = y_test[mask] - y_pred_final[mask]\n        rmse_range = np.sqrt(mean_squared_error(y_test[mask], y_pred_final[mask]))\n        avg_err = np.mean(np.abs(errors))\n        note = \"Best\" if rmse_range < 0.4 else (\"Challenging\" if rmse_range > 0.7 else \"Good\")\n        print(f\"  ${low*100:.0f}K-${high*100:.0f}K {label:<8} {mask.sum():<8} ${avg_err*100:.0f}K       {rmse_range:<10.4f} {note}\")\n\nprint(f\"\\nOverall distribution of errors:\")\nall_errors = np.abs(y_test - y_pred_final)\nprint(f\"  Within $25K: {(all_errors < 0.25).mean()*100:.1f}% of predictions\")\nprint(f\"  Within $50K: {(all_errors < 0.50).mean()*100:.1f}% of predictions\")\nprint(f\"  Within $75K: {(all_errors < 0.75).mean()*100:.1f}% of predictions\")"
        ]
      ]
    },
