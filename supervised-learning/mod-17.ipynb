          "python",
          "import numpy as np\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.preprocessing import PolynomialFeatures\nfrom sklearn.metrics import mean_squared_error\nimport matplotlib.pyplot as plt\n\nnp.random.seed(42)\n\n# True function: quadratic\nx = np.linspace(-2, 2, 100)\ny_true = 2 * x**2 + 3\n\n# Generate multiple training sets with noise\ntrain_sets = []\nfor i in range(20):\n    x_train = np.random.uniform(-2, 2, 20)\n    y_train = 2 * x_train**2 + 3 + np.random.normal(0, 2, 20)\n    train_sets.append((x_train, y_train))\n\n# Model 1: Linear (high bias, low variance)\npredictions_linear = []\nfor x_train, y_train in train_sets:\n    model = LinearRegression()\n    model.fit(x_train.reshape(-1, 1), y_train)\n    pred = model.predict(x.reshape(-1, 1))\n    predictions_linear.append(pred)\n\npredictions_linear = np.array(predictions_linear)\nbias_linear = ((predictions_linear.mean(axis=0) - y_true)**2).mean()\nvariance_linear = predictions_linear.var(axis=0).mean()\n\n# Model 2: Polynomial degree 5 (low bias, high variance)\npredictions_poly = []\nfor x_train, y_train in train_sets:\n    poly = PolynomialFeatures(degree=5)\n    x_train_poly = poly.fit_transform(x_train.reshape(-1, 1))\n    x_poly = poly.transform(x.reshape(-1, 1))\n    model = LinearRegression()\n    model.fit(x_train_poly, y_train)\n    pred = model.predict(x_poly)\n    predictions_poly.append(pred)\n\npredictions_poly = np.array(predictions_poly)\nbias_poly = ((predictions_poly.mean(axis=0) - y_true)**2).mean()\nvariance_poly = predictions_poly.var(axis=0).mean()\n\nprint(\"Linear Model (High Bias, Low Variance):\")\nprint(f\"  Bias\u00b2: {bias_linear:.4f}, Variance: {variance_linear:.4f}, Total: {bias_linear + variance_linear:.4f}\")\n\nprint(\"\\nPolynomial Model (Low Bias, High Variance):\")\nprint(f\"  Bias\u00b2: {bias_poly:.4f}, Variance: {variance_poly:.4f}, Total: {bias_poly + variance_poly:.4f}\")"
        ]
      ]
    },
    {
