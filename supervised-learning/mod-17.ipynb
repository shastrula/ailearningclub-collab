        [
          "python",
          "# Strategy 1: Ensemble to reduce variance\nfrom sklearn.ensemble import BaggingRegressor\n\n# High-variance base model\nbase_tree = DecisionTreeRegressor(max_depth=None, random_state=42)\nbase_tree.fit(X_train, y_train)\nbase_test_r2 = base_tree.score(X_test, y_test)\n\n# Bagging: average many high-variance models\nbagged = BaggingRegressor(\n    estimator=DecisionTreeRegressor(max_depth=None),\n    n_estimators=100,\n    random_state=42\n)\nbagged.fit(X_train, y_train)\nbagged_test_r2 = bagged.score(X_test, y_test)\n\nprint(\"Strategy: Bagging to Reduce Variance\")\nprint(f\"  Single deep tree Test R\u00b2: {base_test_r2:.4f}\")\nprint(f\"  Bagged (100 trees) Test R\u00b2: {bagged_test_r2:.4f}\")\nprint(f\"  Variance reduction: +{(bagged_test_r2 - base_test_r2)*100:.2f}%\")\n\n# Strategy 2: Regularization to increase bias slightly\nfrom sklearn.linear_model import Ridge\n\nprint(\"\\nStrategy: Regularization (Ridge) on Polynomial Features\")\nfrom sklearn.preprocessing import PolynomialFeatures\nfrom sklearn.pipeline import Pipeline\n\nfor alpha in [0.01, 0.1, 1.0, 10.0, 100.0]:\n    pipe = Pipeline([\n        ('poly', PolynomialFeatures(degree=2, include_bias=False)),\n        ('model', Ridge(alpha=alpha))\n    ])\n    pipe.fit(X_train, y_train)\n    train_r2 = pipe.score(X_train, y_train)\n    test_r2 = pipe.score(X_test, y_test)\n    print(f\"  Alpha={alpha:<6} Train R\u00b2={train_r2:.4f}, Test R\u00b2={test_r2:.4f}, Gap={train_r2-test_r2:.4f}\")"
        ]
      ]
