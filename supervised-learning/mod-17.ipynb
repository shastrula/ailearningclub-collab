      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Find the optimal depth\nbest_idx = results_df['test_mse'].idxmin()\nbest_depth = results_df.loc[best_idx, 'depth']\nbest_test_mse = results_df.loc[best_idx, 'test_mse']\nbest_test_r2 = results_df.loc[best_idx, 'test_r2']\n\nprint(f\"Optimal depth: {best_depth}\")\nprint(f\"Best test MSE: {best_test_mse:.4f}\")\nprint(f\"Best test R\u00b2: {best_test_r2:.4f}\")\nprint(f\"\\nAt this depth:\")\nprint(f\"  Train R\u00b2: {results_df.loc[best_idx, 'train_r2']:.4f}\")\nprint(f\"  Test R\u00b2: {results_df.loc[best_idx, 'test_r2']:.4f}\")\nprint(f\"  Gap: {results_df.loc[best_idx, 'train_r2'] - results_df.loc[best_idx, 'test_r2']:.4f}\")\n\n# Compare with extremes\nprint(f\"\\nComparison:\")\nprint(f\"  Depth 1 (high bias):    Train R\u00b2={results_df.iloc[0]['train_r2']:.4f}, \"\n      f\"Test R\u00b2={results_df.iloc[0]['test_r2']:.4f}\")\nprint(f\"  Depth {best_depth} (optimal): Train R\u00b2={results_df.loc[best_idx, 'train_r2']:.4f}, \"\n      f\"Test R\u00b2={best_test_r2:.4f}\")\nprint(f\"  Depth None (high var):  Train R\u00b2={results_df.iloc[-1]['train_r2']:.4f}, \"\n      f\"Test R\u00b2={results_df.iloc[-1]['test_r2']:.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Optimal depth: 10\nBest test MSE: 0.2330\nBest test R\u00b2: 0.8253\n\nAt this depth:\n  Train R\u00b2: 0.9672\n  Test R\u00b2: 0.8253\n  Gap: 0.1419\n\nComparison:\n  Depth 1 (high bias):    Train R\u00b2=0.3245, Test R\u00b2=0.3115\n  Depth 10 (optimal): Train R\u00b2=0.9672, Test R\u00b2=0.8253\n  Depth None (high var):  Train R\u00b2=1.0000, Test R\u00b2=0.7612"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.utils import resample\n\ndef bias_variance_decomposition(X_train, y_train, X_test, y_test, \n                                 max_depth, n_bootstraps=50):\n    \"\"\"Estimate bias and variance through bootstrap.\"\"\"\n    predictions = np.zeros((n_bootstraps, len(y_test)))\n    \n    for i in range(n_bootstraps):\n        # Bootstrap sample\n        X_boot, y_boot = resample(X_train, y_train, random_state=i)\n        \n        # Train model\n        dt = DecisionTreeRegressor(max_depth=max_depth, random_state=42)\n        dt.fit(X_boot, y_boot)\n        predictions[i] = dt.predict(X_test)\n    \n    # Mean prediction across bootstraps\n    mean_pred = predictions.mean(axis=0)\n    \n    # Bias\u00b2 = (mean_prediction - true_value)\u00b2\n    bias_sq = np.mean((mean_pred - y_test) ** 2)\n    \n    # Variance = variance of predictions across bootstraps\n    variance = np.mean(predictions.var(axis=0))\n    \n    # Total MSE\n    total_mse = np.mean((predictions - y_test) ** 2)\n    \n    return bias_sq, variance, total_mse\n\n# Compute for different depths\nprint(\"Bias-Variance Decomposition (50 bootstrap samples)\")\nprint(\"=\"*65)\nprint(f\"{'Depth':<8} {'Bias\u00b2':<12} {'Variance':<12} {'Total MSE':<12} {'Dominant':<12}\")\nprint(\"-\"*65)\n\ndecomp_depths = [1, 3, 5, 7, 10, 15, 20, None]\ndecomp_results = []\n\nfor depth in decomp_depths:\n    bias_sq, variance, total = bias_variance_decomposition(\n        X_train, y_train, X_test, y_test, max_depth=depth\n    )\n    dominant = \"Bias\" if bias_sq > variance else \"Variance\"\n    depth_str = str(depth) if depth else \"None\"\n    print(f\"{depth_str:<8} {bias_sq:<12.4f} {variance:<12.4f} {total:<12.4f} {dominant:<12}\")\n    decomp_results.append({\n        'depth': depth_str,\n        'bias_sq': bias_sq,\n        'variance': variance,\n        'total': total\n    })\n\nprint(\"=\"*65)"
        ]
      ]
    },
