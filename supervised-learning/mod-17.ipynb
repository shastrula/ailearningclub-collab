          "python",
          "from sklearn.ensemble import BaggingClassifier, VotingClassifier\nfrom sklearn.tree import DecisionTreeClassifier\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import cross_val_score\nimport numpy as np\n\nX, y = make_classification(n_samples=300, n_features=20, random_state=42)\n\n# Single model (high variance)\ndt = DecisionTreeClassifier(max_depth=10, random_state=42)\nsingle_score = cross_val_score(dt, X, y, cv=5, scoring='accuracy')\n\n# Bagging reduces variance by averaging\nbagging = BaggingClassifier(estimator=DecisionTreeClassifier(max_depth=10), n_estimators=50, random_state=42)\nbagging_score = cross_val_score(bagging, X, y, cv=5, scoring='accuracy')\n\n# Voting reduces variance by combining models\nvoting = VotingClassifier(\n    estimators=[('dt', DecisionTreeClassifier(max_depth=10)), ('lr', LogisticRegression(max_iter=1000))],\n    voting='soft'\n)\nvoting_score = cross_val_score(voting, X, y, cv=5, scoring='accuracy')\n\nprint(\"Variance Reduction via Ensembles:\")\nprint(f\"Single Decision Tree: {single_score.mean():.4f} \u00b1 {single_score.std():.4f}\")\nprint(f\"Bagging (50 trees): {bagging_score.mean():.4f} \u00b1 {bagging_score.std():.4f}\")\nprint(f\"Voting (DT + LR): {voting_score.mean():.4f} \u00b1 {voting_score.std():.4f}\")\n\nprint(\"\\nNote: Voting std shows variance reduction; bagging std also improves\")"
        ]
