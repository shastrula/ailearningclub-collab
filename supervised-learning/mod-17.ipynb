        [
          "python",
          "# How training set size affects the tradeoff\ntrain_sizes = [500, 1000, 2000, 5000, 10000, 16512]\ndepth_for_demo = 15  # High variance model\n\nprint(f\"Effect of Training Size on Depth={depth_for_demo} Tree\")\nprint(\"=\"*60)\nprint(f\"{'Train Size':<12} {'Train R\u00b2':<10} {'Test R\u00b2':<10} {'Gap':<8} {'Status':<15}\")\nprint(\"-\"*60)\n\nfor size in train_sizes:\n    X_sub = X_train.iloc[:size]\n    y_sub = y_train.iloc[:size]\n    \n    dt = DecisionTreeRegressor(max_depth=depth_for_demo, random_state=42)\n    dt.fit(X_sub, y_sub)\n    \n    train_r2 = dt.score(X_sub, y_sub)\n    test_r2 = dt.score(X_test, y_test)\n    gap = train_r2 - test_r2\n    \n    status = \"Overfitting\" if gap > 0.15 else \"Acceptable\" if gap > 0.05 else \"Good\"\n    print(f\"{size:<12} {train_r2:<10.4f} {test_r2:<10.4f} {gap:<8.4f} {status:<15}\")\n\nprint(\"=\"*60)\nprint(\"\\nAs training size increases, the gap narrows (variance decreases)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
