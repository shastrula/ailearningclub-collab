          "python",
          "# Tune max_depth with best learning rate\nprint(\"=== Tuning max_depth (XGBoost, lr=0.1, n_estimators=300) ===\")\nprint(f\"{'max_depth':<12} {'Train RMSE':<12} {'Test RMSE':<12} {'Test R\u00b2':<10} {'Gap'}\")\nprint(\"-\" * 55)\n\ndepth_results = []\nfor depth in [3, 4, 5, 6, 7, 8, 10]:\n    xgb = XGBRegressor(\n        learning_rate=0.1, n_estimators=300, max_depth=depth,\n        random_state=42, verbosity=0\n    )\n    xgb.fit(X_train, y_train)\n    train_rmse = np.sqrt(mean_squared_error(y_train, xgb.predict(X_train)))\n    test_rmse = np.sqrt(mean_squared_error(y_test, xgb.predict(X_test)))\n    test_r2 = r2_score(y_test, xgb.predict(X_test))\n    gap = train_rmse - test_rmse\n    depth_results.append({'depth': depth, 'test_rmse': test_rmse, 'test_r2': test_r2})\n    print(f\"  {depth:<12} {train_rmse:<12.4f} {test_rmse:<12.4f} {test_r2:<10.4f} {gap:.4f}\")\n\nbest_depth = min(depth_results, key=lambda x: x['test_rmse'])\nprint(f\"\\nBest max_depth: {best_depth['depth']} (RMSE={best_depth['test_rmse']:.4f})\")"
        ]
      ]
