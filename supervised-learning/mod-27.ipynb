          "python",
          "# Feature importance from trained model\nfeature_importance = model.get_score(importance_type='weight')\n\nfi_df = pd.DataFrame(list(feature_importance.items()), columns=['Feature', 'Importance'])\nfi_df = fi_df.sort_values('Importance', ascending=False)\n\nprint(\"Feature Importance (# of splits):\")\nprint(fi_df)\n\nplt.figure(figsize=(10, 6))\nplt.barh(fi_df['Feature'], fi_df['Importance'], edgecolor='black', alpha=0.7)\nplt.xlabel('Number of Splits')\nplt.title('Feature Importance in XGBoost Model')\nplt.grid(True, alpha=0.3, axis='x')\nplt.tight_layout()\nplt.show()\n\n# SHAP values: local interpretability for individual predictions\n# SHAP explains how features contribute to each prediction\nimport shap\n\n# Create explainer\nexplainer = shap.TreeExplainer(model)\nshap_values = explainer.shap_values(xgb.DMatrix(X_test))\n\n# Summary plot: average impact magnitude\nplt.figure(figsize=(10, 6))\nshap.summary_plot(shap_values, X_test, plot_type='bar', show=False)\nplt.title('SHAP: Average |Impact| on Output')\nplt.tight_layout()\nplt.show()\n\n# Detailed summary: color by feature value\nplt.figure(figsize=(10, 6))\nshap.summary_plot(shap_values, X_test, show=False)\nplt.title('SHAP: Feature Impact on Predictions')\nplt.tight_layout()\nplt.show()\n\n# Force plot for single prediction\nidx = 0  # Examine first test sample\nexpected_value = explainer.expected_value\nprediction = y_test_pred[idx]\nshap_values_sample = shap_values[idx]\nfeatures = X_test.iloc[idx]\n\nprint(f\"\\nSample {idx} Explanation:\")\nprint(f\"Actual target: {y_test.iloc[idx]:.2f}\")\nprint(f\"Model prediction: {prediction:.2f}\")\nprint(f\"Base value (expected): {expected_value:.2f}\")\nprint(f\"\\nFeature contributions:\")\n\ncontributions = pd.DataFrame({\n    'Feature': X_test.columns,\n    'Value': features.values,\n    'SHAP': shap_values_sample\n}).sort_values('SHAP', key=abs, ascending=False)\n\nprint(contributions)\n\n# Waterfall plot\nshap.plots._waterfall.waterfall_legacy(\n    expected_value, shap_values_sample, features, \n    feature_names=X_test.columns.tolist()\n)\nplt.title(f'SHAP Waterfall: Prediction for Sample {idx}')\nplt.tight_layout()\nplt.show()"
