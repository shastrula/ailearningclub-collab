        [
          "python",
          "# Gradient boosting with early stopping\n# Early stopping: stop training if validation performance plateaus\n\ndtrain = xgb.DMatrix(X_train, label=y_train)\ndval = xgb.DMatrix(X_val, label=y_val)\ndtest = xgb.DMatrix(X_test, label=y_test)\n\n# XGBoost hyperparameters\nparams = {\n    'objective': 'reg:squarederror',  # Regression task\n    'max_depth': 6,                    # Tree depth (prevent overfitting)\n    'learning_rate': 0.1,              # Shrinkage (conservative updates)\n    'subsample': 0.8,                  # Row sampling (prevent overfitting)\n    'colsample_bytree': 0.8,           # Column sampling\n    'lambda': 1.0,                     # L2 regularization\n    'alpha': 0.0,                      # L1 regularization\n    'random_state': 42,\n}\n\n# Train with early stopping\nevals_result = {}\nevals = [(dtrain, 'train'), (dval, 'validation')]\n\nmodel = xgb.train(\n    params,\n    dtrain,\n    num_boost_round=500,              # Maximum iterations\n    evals=evals,\n    evals_result=evals_result,\n    early_stopping_rounds=20,          # Stop if no improvement for 20 rounds\n    verbose_eval=50\n)\n\n# Check stopping point\nn_rounds = len(evals_result['train']['rmse'])\nprint(f\"\\nTraining stopped at round {n_rounds}\")\nprint(f\"Early stopping triggered: no improvement for 20 rounds\")\n\n# Plot training curves\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\naxes[0].plot(evals_result['train']['rmse'], label='Training RMSE', linewidth=2)\naxes[0].plot(evals_result['validation']['rmse'], label='Validation RMSE', linewidth=2)\naxes[0].axvline(n_rounds - 1, color='r', linestyle='--', label='Early Stopping Point')\naxes[0].set_xlabel('Boosting Round')\naxes[0].set_ylabel('RMSE')\naxes[0].set_title('Training Curves with Early Stopping')\naxes[0].legend()\naxes[0].grid(True, alpha=0.3)\n\naxes[1].plot(evals_result['train']['rmse'], label='Training RMSE')\naxes[1].plot(evals_result['validation']['rmse'], label='Validation RMSE')\naxes[1].set_xlim([max(0, n_rounds - 100), n_rounds])  # Zoom to last 100 rounds\naxes[1].set_xlabel('Boosting Round')\naxes[1].set_ylabel('RMSE')\naxes[1].set_title('Last 100 Rounds (Zoomed)')\naxes[1].legend()\naxes[1].grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.show()\n\n# Predictions\ny_train_pred = model.predict(dtrain)\ny_val_pred = model.predict(dval)\ny_test_pred = model.predict(dtest)\n\n# Evaluate on all sets\ntrain_rmse = np.sqrt(mean_squared_error(y_train, y_train_pred))\nval_rmse = np.sqrt(mean_squared_error(y_val, y_val_pred))\ntest_rmse = np.sqrt(mean_squared_error(y_test, y_test_pred))\n\ntrain_r2 = r2_score(y_train, y_train_pred)\ntest_r2 = r2_score(y_test, y_test_pred)\n\nprint(f\"\\nPerformance Metrics:\")\nprint(f\"Training RMSE: {train_rmse:.4f} | R\u00b2: {train_r2:.4f}\")\nprint(f\"Validation RMSE: {val_rmse:.4f}\")\nprint(f\"Test RMSE: {test_rmse:.4f} | R\u00b2: {test_r2:.4f}\")"
        ]
