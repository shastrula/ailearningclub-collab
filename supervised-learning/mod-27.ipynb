          "python",
          "from sklearn.linear_model import LinearRegression\nfrom sklearn.tree import DecisionTreeRegressor\nfrom sklearn.ensemble import RandomForestRegressor\n\n# Scale for linear models\nscaler = StandardScaler()\nX_train_scaled = scaler.fit_transform(X_train)\nX_test_scaled = scaler.transform(X_test)\n\n# Train all models\nmodels = {\n    'Linear Regression': LinearRegression(),\n    'Decision Tree': DecisionTreeRegressor(max_depth=10, random_state=42),\n    'Random Forest': RandomForestRegressor(n_estimators=200, max_depth=20, random_state=42),\n    'SVR (RBF)': None,  # Special handling\n    'sklearn GradientBoosting': GradientBoostingRegressor(\n        learning_rate=0.1, n_estimators=300, max_depth=5, random_state=42),\n    'XGBoost': XGBRegressor(\n        learning_rate=0.1, n_estimators=300, max_depth=5, random_state=42, verbosity=0),\n}\n\nprint(\"=\" * 80)\nprint(\"  FINAL MODEL COMPARISON: California Housing Price Prediction\")\nprint(\"=\" * 80)\nprint(f\"\\n{'Model':<25} {'RMSE':<12} {'MAE':<12} {'R\u00b2':<10} {'Error ($)':<12} {'Time (s)'}\")\nprint(\"-\" * 80)\n\nresults = []\nfor name, model in models.items():\n    if name == 'SVR (RBF)':\n        from sklearn.svm import SVR\n        model = SVR(kernel='rbf', C=10, gamma=0.01)\n        start = time.time()\n        model.fit(X_train_scaled, y_train)\n        elapsed = time.time() - start\n        y_pred = model.predict(X_test_scaled)\n    elif name == 'Linear Regression':\n        start = time.time()\n        model.fit(X_train_scaled, y_train)\n        elapsed = time.time() - start\n        y_pred = model.predict(X_test_scaled)\n    else:\n        start = time.time()\n        model.fit(X_train, y_train)\n        elapsed = time.time() - start\n        y_pred = model.predict(X_test)\n\n    rmse = np.sqrt(mean_squared_error(y_test, y_pred))\n    mae = mean_absolute_error(y_test, y_pred)\n    r2 = r2_score(y_test, y_pred)\n    results.append({'name': name, 'rmse': rmse, 'mae': mae, 'r2': r2, 'time': elapsed})\n    print(f\"  {name:<25} {rmse:<12.4f} {mae:<12.4f} {r2:<10.4f} ${mae*100:.0f}K      {elapsed:.3f}\")\n\n# Rank models\nprint(f\"\\n{'='*80}\")\nprint(\"  MODEL RANKINGS\")\nprint(f\"{'='*80}\")\nsorted_by_rmse = sorted(results, key=lambda x: x['rmse'])\nprint(f\"\\n  By RMSE (lower is better):\")\nfor rank, r in enumerate(sorted_by_rmse, 1):\n    medal = \"\ud83e\udd47\" if rank == 1 else \"\ud83e\udd48\" if rank == 2 else \"\ud83e\udd49\" if rank == 3 else \"  \"\n    print(f\"    {medal} {rank}. {r['name']:<25} RMSE={r['rmse']:.4f}\")\n\nsorted_by_r2 = sorted(results, key=lambda x: x['r2'], reverse=True)\nprint(f\"\\n  By R\u00b2 (higher is better):\")\nfor rank, r in enumerate(sorted_by_r2, 1):\n    medal = \"\ud83e\udd47\" if rank == 1 else \"\ud83e\udd48\" if rank == 2 else \"\ud83e\udd49\" if rank == 3 else \"  \"\n    print(f\"    {medal} {rank}. {r['name']:<25} R\u00b2={r['r2']:.4f}\")"
        ]
