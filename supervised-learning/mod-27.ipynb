        [
          "python",
          "from sklearn.ensemble import GradientBoostingRegressor\n\n# Default gradient boosting\nstart = time.time()\ngb_default = GradientBoostingRegressor(random_state=42)\ngb_default.fit(X_train, y_train)\ntrain_time_gb = time.time() - start\n\ny_pred_gb = gb_default.predict(X_test)\nrmse_gb = np.sqrt(mean_squared_error(y_test, y_pred_gb))\nmae_gb = mean_absolute_error(y_test, y_pred_gb)\nr2_gb = r2_score(y_test, y_pred_gb)\n\nprint(\"=== Scikit-learn GradientBoosting (Default) ===\")\nprint(f\"Parameters: n_estimators=100, learning_rate=0.1, max_depth=3\")\nprint(f\"Training time: {train_time_gb:.2f}s\")\nprint(f\"RMSE: {rmse_gb:.4f} (${rmse_gb*100:.0f}K)\")\nprint(f\"MAE:  {mae_gb:.4f} (${mae_gb*100:.0f}K)\")\nprint(f\"R\u00b2:   {r2_gb:.4f}\")"
        ]
      ]
