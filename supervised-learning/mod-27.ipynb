          "python",
          "# Final tuned model\nxgb_final = XGBRegressor(\n    learning_rate=0.1,\n    n_estimators=300,\n    max_depth=5,\n    random_state=42,\n    verbosity=0\n)\nxgb_final.fit(X_train, y_train)\ny_pred_final = xgb_final.predict(X_test)\n\nrmse_final = np.sqrt(mean_squared_error(y_test, y_pred_final))\nmae_final = mean_absolute_error(y_test, y_pred_final)\nr2_final = r2_score(y_test, y_pred_final)\n\nprint(\"=== Final Tuned XGBoost ===\")\nprint(f\"Parameters: lr=0.1, n_estimators=300, max_depth=5\")\nprint(f\"RMSE: {rmse_final:.4f} (${rmse_final*100:.0f}K)\")\nprint(f\"MAE:  {mae_final:.4f} (${mae_final*100:.0f}K)\")\nprint(f\"R\u00b2:   {r2_final:.4f}\")\n\n# Feature importance\nprint(f\"\\n=== Feature Importance ===\")\nimportances = xgb_final.feature_importances_\nsorted_idx = np.argsort(importances)[::-1]\nfor idx in sorted_idx:\n    bar = \"\u2588\" * int(importances[idx] * 40)\n    print(f\"  {housing.feature_names[idx]:12s}: {importances[idx]:.4f} {bar}\")"
        ]
