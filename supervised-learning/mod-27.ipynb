          "python",
          "# Sklearn GB with tuned parameters for fair comparison\nfrom sklearn.ensemble import GradientBoostingRegressor\n\ngb_tuned = GradientBoostingRegressor(\n    learning_rate=0.1, n_estimators=300, max_depth=5, random_state=42\n)\nstart = time.time()\ngb_tuned.fit(X_train, y_train)\nsklearn_time = time.time() - start\n\nstart = time.time()\nxgb_final.fit(X_train, y_train)\nxgb_time = time.time() - start\n\ny_pred_sklearn = gb_tuned.predict(X_test)\nrmse_sklearn = np.sqrt(mean_squared_error(y_test, y_pred_sklearn))\nr2_sklearn = r2_score(y_test, y_pred_sklearn)\n\nprint(\"=== sklearn GradientBoosting vs XGBoost (same params) ===\")\nprint(f\"{'Metric':<20} {'sklearn GB':<15} {'XGBoost':<15} {'Winner'}\")\nprint(\"-\" * 55)\nprint(f\"  {'RMSE':<20} {rmse_sklearn:<15.4f} {rmse_final:<15.4f} {'XGBoost' if rmse_final < rmse_sklearn else 'sklearn'}\")\nprint(f\"  {'R\u00b2':<20} {r2_sklearn:<15.4f} {r2_final:<15.4f} {'XGBoost' if r2_final > r2_sklearn else 'sklearn'}\")\nprint(f\"  {'Training Time':<20} {sklearn_time:<15.2f} {xgb_time:<15.2f} {'XGBoost' if xgb_time < sklearn_time else 'sklearn'}\")\nprint(f\"  {'Speedup':<20} {'\u2014':<15} {f'{sklearn_time/xgb_time:.1f}x':<15}\")"
