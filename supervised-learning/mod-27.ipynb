          "python",
          "from xgboost import XGBRegressor\n\n# XGBoost with default parameters\nstart = time.time()\nxgb_default = XGBRegressor(random_state=42, verbosity=0)\nxgb_default.fit(X_train, y_train)\ntrain_time_xgb = time.time() - start\n\ny_pred_xgb = xgb_default.predict(X_test)\nrmse_xgb = np.sqrt(mean_squared_error(y_test, y_pred_xgb))\nmae_xgb = mean_absolute_error(y_test, y_pred_xgb)\nr2_xgb = r2_score(y_test, y_pred_xgb)\n\nprint(\"=== XGBoost (Default) ===\")\nprint(f\"Training time: {train_time_xgb:.2f}s\")\nprint(f\"RMSE: {rmse_xgb:.4f} (${rmse_xgb*100:.0f}K)\")\nprint(f\"MAE:  {mae_xgb:.4f} (${mae_xgb*100:.0f}K)\")\nprint(f\"R\u00b2:   {r2_xgb:.4f}\")\nprint(f\"\\nXGBoost vs sklearn GB:\")\nprint(f\"  Speed: {train_time_gb/train_time_xgb:.1f}x faster\")\nprint(f\"  RMSE:  {'better' if rmse_xgb < rmse_gb else 'worse'} by {abs(rmse_xgb-rmse_gb):.4f}\")"
        ]
      ]
    },
