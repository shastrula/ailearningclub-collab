          "python",
          "# Grid search for optimal XGBoost parameters\nfrom sklearn.model_selection import GridSearchCV\nimport warnings\nwarnings.filterwarnings('ignore')\n\nparam_grid = {\n    'max_depth': [3, 4, 6, 8],\n    'learning_rate': [0.01, 0.05, 0.1],\n    'subsample': [0.7, 0.8, 0.9],\n    'colsample_bytree': [0.7, 0.8, 0.9],\n    'lambda': [0.5, 1.0, 1.5],\n}\n\n# Use smaller subset for speed\nsubset_size = 1000\nxgb_model = xgb.XGBRegressor(random_state=42, n_estimators=100, n_jobs=-1)\n\n# Note: Full GridSearchCV with XGBoost on all params is computationally expensive\n# In practice, use Optuna or Bayesian optimization for large param spaces\n\n# Alternative: manual testing of key params\nbest_params = params.copy()\nbest_score = float('inf')\n\nprint(\"Testing key parameter combinations...\")\nfor max_depth in [4, 6, 8]:\n    for lr in [0.05, 0.1]:\n        test_params = best_params.copy()\n        test_params['max_depth'] = max_depth\n        test_params['learning_rate'] = lr\n        \n        dtrain_subset = xgb.DMatrix(X_train[:subset_size], label=y_train[:subset_size])\n        dval_subset = xgb.DMatrix(X_val, label=y_val)\n        \n        model_test = xgb.train(\n            test_params,\n            dtrain_subset,\n            num_boost_round=200,\n            evals=[(dval_subset, 'val')],\n            evals_result={},\n            early_stopping_rounds=10,\n            verbose_eval=False\n        )\n        \n        val_pred = model_test.predict(dval_subset)\n        val_rmse = np.sqrt(mean_squared_error(y_val, val_pred))\n        \n        print(f\"  max_depth={max_depth}, lr={lr}: RMSE={val_rmse:.4f}\")\n        \n        if val_rmse < best_score:\n            best_score = val_rmse\n            best_params['max_depth'] = max_depth\n            best_params['learning_rate'] = lr\n\nprint(f\"\\nBest parameters found: max_depth={best_params['max_depth']}, lr={best_params['learning_rate']}\")\n\n# Final model with optimized params\nfinal_model = xgb.train(\n    best_params,\n    dtrain,\n    num_boost_round=500,\n    evals=evals,\n    early_stopping_rounds=20,\n    verbose_eval=False\n)\n\ny_final_pred = final_model.predict(dtest)\nfinal_rmse = np.sqrt(mean_squared_error(y_test, y_final_pred))\nfinal_r2 = r2_score(y_test, y_final_pred)\n\nprint(f\"\\nFinal model test RMSE: {final_rmse:.4f} | R\u00b2: {final_r2:.4f}\")"
