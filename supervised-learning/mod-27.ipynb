          "python",
          "# Compare learning rates with XGBoost\nprint(\"=== Learning Rate Comparison (XGBoost) ===\")\nprint(f\"{'Learning Rate':<15} {'n_estimators':<14} {'Train RMSE':<12} {'Test RMSE':<12} {'Test R\u00b2':<10} {'Time'}\")\nprint(\"-\" * 75)\n\nlr_results = []\nfor lr, n_est in [(0.01, 1000), (0.05, 500), (0.1, 300), (0.2, 200), (0.3, 150), (0.5, 100)]:\n    start = time.time()\n    xgb = XGBRegressor(\n        learning_rate=lr, n_estimators=n_est, max_depth=5,\n        random_state=42, verbosity=0\n    )\n    xgb.fit(X_train, y_train)\n    elapsed = time.time() - start\n\n    y_pred_train = xgb.predict(X_train)\n    y_pred_test = xgb.predict(X_test)\n    train_rmse = np.sqrt(mean_squared_error(y_train, y_pred_train))\n    test_rmse = np.sqrt(mean_squared_error(y_test, y_pred_test))\n    test_r2 = r2_score(y_test, y_pred_test)\n    lr_results.append({'lr': lr, 'n_est': n_est, 'test_rmse': test_rmse, 'test_r2': test_r2})\n    print(f\"  {lr:<15} {n_est:<14} {train_rmse:<12.4f} {test_rmse:<12.4f} {test_r2:<10.4f} {elapsed:.2f}s\")\n\nbest_lr = min(lr_results, key=lambda x: x['test_rmse'])\nprint(f\"\\nBest: lr={best_lr['lr']}, n_estimators={best_lr['n_est']} (RMSE={best_lr['test_rmse']:.4f})\")"
        ]
