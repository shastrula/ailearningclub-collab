          "python",
          "# Text-based bar chart of feature importance\ntop_n = 10\ntop_features = imp_d3.sort_values(ascending=False).head(top_n)\n\nprint(\"\\nFeature Importance Bar Chart (Shallow Tree, depth=3):\")\nprint(\"=\" * 55)\nmax_bar_width = 40\n\nfor feature, importance in top_features.items():\n    bar_length = int(importance * max_bar_width / top_features.max())\n    bar = '\u2588' * bar_length\n    if importance > 0:\n        print(f\"  {feature:<24} {bar} {importance:.4f}\")\n    else:\n        print(f\"  {feature:<24} {'\u00b7':} {importance:.4f}\")\n\nprint(\"=\" * 55)\nprint(f\"\\n  Summary: {np.sum(imp_d3 > 0)} features used, {np.sum(imp_d3 == 0)} features ignored\")\nprint(f\"  Top feature alone explains {top_features.iloc[0]*100:.1f}% of decisions\")"
