          "python",
          "# 5-fold cross-validation for key configurations\nconfigs = [\n    (\"max_depth=3\", {'max_depth': 3}),\n    (\"max_depth=5\", {'max_depth': 5}),\n    (\"min_split=20\", {'min_samples_split': 20}),\n    (\"min_leaf=10\", {'min_samples_leaf': 10}),\n    (\"ccp_alpha=0.01\", {'ccp_alpha': 0.01}),\n    (\"Full (no limits)\", {}),\n]\n\nprint(\"5-Fold Cross-Validation Results:\")\nprint(f\"{'Configuration':<20} {'Mean CV Acc':>12} {'Std':>8} {'Min':>8} {'Max':>8}\")\nprint(\"-\" * 60)\n\nfor name, params in configs:\n    tree = DecisionTreeClassifier(random_state=42, **params)\n    cv_scores = cross_val_score(tree, X, y, cv=5, scoring='accuracy')\n    print(f\"{name:<20} {cv_scores.mean():>12.4f} {cv_scores.std():>8.4f} {cv_scores.min():>8.4f} {cv_scores.max():>8.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
