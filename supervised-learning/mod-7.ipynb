          "python",
          "# Grid search over combinations\nfrom itertools import product\n\ndepths = [3, 5, 7]\nmin_leaves = [1, 5, 10]\n\nprint(\"Combined Hyperparameter Grid:\")\nprint(f\"{'max_depth':>10} {'min_leaf':>9} {'Train Acc':>10} {'Test Acc':>10} {'CV Mean':>8} {'Leaves':>7}\")\nprint(\"-\" * 58)\n\nbest_cv = 0\nbest_config = \"\"\n\nfor depth, leaf in product(depths, min_leaves):\n    tree = DecisionTreeClassifier(\n        max_depth=depth, \n        min_samples_leaf=leaf, \n        random_state=42\n    )\n    tree.fit(X_train, y_train)\n    train_acc = tree.score(X_train, y_train)\n    test_acc = tree.score(X_test, y_test)\n    cv = cross_val_score(tree, X, y, cv=5).mean()\n    \n    if cv > best_cv:\n        best_cv = cv\n        best_config = f\"depth={depth}, min_leaf={leaf}\"\n    \n    print(f\"{depth:>10} {leaf:>9} {train_acc:>10.4f} {test_acc:>10.4f} {cv:>8.4f} {tree.get_n_leaves():>7}\")\n\nprint(f\"\\nBest configuration: {best_config} (CV accuracy: {best_cv:.4f})\")"
        ]
      ]
