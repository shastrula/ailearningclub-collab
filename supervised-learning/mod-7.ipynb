        [
          "python",
          "# Compare feature importance between shallow and deep trees\ntree_d3 = DecisionTreeClassifier(max_depth=3, random_state=42)\ntree_d3.fit(X_train, y_train)\n\ntree_d7 = DecisionTreeClassifier(max_depth=None, random_state=42)\ntree_d7.fit(X_train, y_train)\n\n# Get top features for each\nimp_d3 = pd.Series(tree_d3.feature_importances_, index=cancer.feature_names)\nimp_full = pd.Series(tree_d7.feature_importances_, index=cancer.feature_names)\n\n# Combine and show top features\ncomparison = pd.DataFrame({\n    'Shallow (d=3)': imp_d3,\n    'Full Tree': imp_full\n}).sort_values('Full Tree', ascending=False)\n\nprint(\"Feature Importance: Shallow vs Full Tree (Top 10):\")\nprint(f\"{'Feature':<25} {'Shallow (d=3)':>13} {'Full Tree':>10} {'Difference':>11}\")\nprint(\"-\" * 63)\nfor feat in comparison.head(10).index:\n    d3_val = comparison.loc[feat, 'Shallow (d=3)']\n    full_val = comparison.loc[feat, 'Full Tree']\n    diff = full_val - d3_val\n    print(f\"{feat:<25} {d3_val:>13.4f} {full_val:>10.4f} {diff:>+11.4f}\")"
        ]
      ]
