          "python",
          "# Effect of min_samples_leaf\nprint(\"\\nEffect of min_samples_leaf (no depth limit):\")\nprint(f\"{'min_samples_leaf':>17} {'Train Acc':>10} {'Test Acc':>10} {'Depth':>6} {'Leaves':>7}\")\nprint(\"-\" * 55)\n\nfor min_leaf in [1, 3, 5, 10, 20, 50]:\n    tree = DecisionTreeClassifier(min_samples_leaf=min_leaf, random_state=42)\n    tree.fit(X_train, y_train)\n    print(f\"{min_leaf:>17} {tree.score(X_train, y_train):>10.4f} {tree.score(X_test, y_test):>10.4f} {tree.get_depth():>6} {tree.get_n_leaves():>7}\")"
