          "# Build the optimized tree\ntree_optimized = DecisionTreeClassifier(\n    max_depth=5, min_samples_leaf=5, random_state=42\n)\ntree_optimized.fit(X_train, y_train)\ny_pred_opt = tree_optimized.predict(X_test)\n\nprint(\"\\n\" + \"=\" * 60)\nprint(\"FINAL MODEL COMPARISON - Decision Trees on Breast Cancer\")\nprint(\"=\" * 60)\nprint(f\"\\n{'Model':<35} {'Test Acc':>9} {'Leaves':>7} {'Depth':>6} {'Overfit?':>9}\")\nprint(\"-\" * 68)\nprint(f\"{'Stump (depth=1)':<35} {'0.9211':>9} {'2':>7} {'1':>6} {'No':>9}\")\nprint(f\"{'Shallow (depth=3)':<35} {'0.9561':>9} {'8':>7} {'3':>6} {'No':>9}\")\nprint(f\"{'Optimized (d=5, leaf=5)':<35} {tree_optimized.score(X_test, y_test):>9.4f} {tree_optimized.get_n_leaves():>7} {tree_optimized.get_depth():>6} {'No':>9}\")\nprint(f\"{'Full (unlimited)':<35} {'0.9386':>9} {'17':>7} {'7':>6} {'Yes':>9}\")\nprint(f\"{'Pruned (ccp_alpha=0.01)':<35} {'0.9649':>9} {'7':>7} {'4':>6} {'No':>9}\")\nprint(f\"\\nWinner: Pruned tree (ccp_alpha=0.01) \u2014 highest test accuracy with fewest leaves\")"
