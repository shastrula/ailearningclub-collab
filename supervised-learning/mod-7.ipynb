          "python",
          "# Effect of min_samples_split\nprint(\"Effect of min_samples_split (no depth limit):\")\nprint(f\"{'min_samples_split':>18} {'Train Acc':>10} {'Test Acc':>10} {'Depth':>6} {'Leaves':>7}\")\nprint(\"-\" * 55)\n\nfor min_split in [2, 5, 10, 20, 50, 100]:\n    tree = DecisionTreeClassifier(min_samples_split=min_split, random_state=42)\n    tree.fit(X_train, y_train)\n    print(f\"{min_split:>18} {tree.score(X_train, y_train):>10.4f} {tree.score(X_test, y_test):>10.4f} {tree.get_depth():>6} {tree.get_n_leaves():>7}\")"
        ]
