          "python",
          "from sklearn.model_selection import cross_validate\nfrom sklearn.tree import DecisionTreeClassifier\nfrom sklearn.datasets import make_classification\nimport numpy as np\n\nX, y = make_classification(n_samples=300, n_features=20, random_state=42)\n\ndt_simple = DecisionTreeClassifier(max_depth=3, random_state=42)\ndt_complex = DecisionTreeClassifier(max_depth=15, random_state=42)\n\nresults_simple = cross_validate(dt_simple, X, y, cv=5, scoring='accuracy', return_train_score=True)\nresults_complex = cross_validate(dt_complex, X, y, cv=5, scoring='accuracy', return_train_score=True)\n\nprint(\"Cross-Validation Overfitting Analysis\\n\")\nprint(\"Simple Model (max_depth=3):\")\nprint(f\"  Train accuracy: {results_simple['train_score'].mean():.4f} \u00b1 {results_simple['train_score'].std():.4f}\")\nprint(f\"  Test accuracy:  {results_simple['test_score'].mean():.4f} \u00b1 {results_simple['test_score'].std():.4f}\")\nprint(f\"  Gap: {(results_simple['train_score'] - results_simple['test_score']).mean():.4f}\")\n\nprint(\"\\nComplex Model (max_depth=15):\")\nprint(f\"  Train accuracy: {results_complex['train_score'].mean():.4f} \u00b1 {results_complex['train_score'].std():.4f}\")\nprint(f\"  Test accuracy:  {results_complex['test_score'].mean():.4f} \u00b1 {results_complex['test_score'].std():.4f}\")\nprint(f\"  Gap: {(results_complex['train_score'] - results_complex['test_score']).mean():.4f}\")\n\nprint(\"\\nConclusion: Complex model shows larger train-test gap (overfitting)\")"
        ]
      ]
    }
