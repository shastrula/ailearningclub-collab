          "python",
          "from sklearn.ensemble import RandomForestRegressor\n\n# Tree regularization parameters\ntree_configs = {\n    'No limits': {'max_depth': None, 'min_samples_leaf': 1, 'min_samples_split': 2},\n    'max_depth=10': {'max_depth': 10, 'min_samples_leaf': 1, 'min_samples_split': 2},\n    'min_leaf=5': {'max_depth': None, 'min_samples_leaf': 5, 'min_samples_split': 2},\n    'min_split=20': {'max_depth': None, 'min_samples_leaf': 1, 'min_samples_split': 20},\n    'Combined': {'max_depth': 15, 'min_samples_leaf': 4, 'min_samples_split': 10},\n}\n\nprint(\"Tree Regularization: Decision Tree Constraints\")\nprint(\"=\"*70)\nprint(f\"{'Config':<20} {'Train R\u00b2':<10} {'Test R\u00b2':<10} {'Gap':<8} {'Leaves':<8} {'Status':<12}\")\nprint(\"-\"*70)\n\nfor name, params in tree_configs.items():\n    dt = DecisionTreeRegressor(random_state=42, **params)\n    dt.fit(X_train, y_train)\n    train_r2 = dt.score(X_train, y_train)\n    test_r2 = dt.score(X_test, y_test)\n    gap = train_r2 - test_r2\n    n_leaves = dt.get_n_leaves()\n    status = \"Overfitting\" if gap > 0.15 else \"Good\" if gap < 0.1 else \"Moderate\"\n    print(f\"{name:<20} {train_r2:<10.4f} {test_r2:<10.4f} {gap:<8.4f} {n_leaves:<8} {status:<12}\")\n\nprint(\"=\"*70)"
