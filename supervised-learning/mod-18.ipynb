        [
          "python",
          "from imblearn.over_sampling import SMOTE\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import cross_val_score\nfrom sklearn.ensemble import RandomForestClassifier\nimport numpy as np\n\nX, y = make_classification(n_samples=300, n_features=20, weights=[0.9, 0.1], random_state=42)\n\nprint(\"Overfitting with Imbalanced Data:\\n\")\n\n# Imbalanced dataset\nprint(f\"Original class distribution: {np.bincount(y)}\")\nrf = RandomForestClassifier(n_estimators=100, random_state=42)\nimbalanced_score = cross_val_score(rf, X, y, cv=5, scoring='f1_weighted').mean()\nprint(f\"CV F1 score (imbalanced): {imbalanced_score:.4f}\")\n\n# Apply SMOTE to augment minority class\nsmote = SMOTE(random_state=42)\nX_aug, y_aug = smote.fit_resample(X, y)\n\nprint(f\"\\nAfter SMOTE augmentation: {np.bincount(y_aug)}\")\naugmented_score = cross_val_score(rf, X_aug, y_aug, cv=5, scoring='f1_weighted').mean()\nprint(f\"CV F1 score (augmented): {augmented_score:.4f}\")\nprint(f\"\\nImprovement: {(augmented_score - imbalanced_score)*100:.2f}%\")"
        ]
      ]
    },
    {
