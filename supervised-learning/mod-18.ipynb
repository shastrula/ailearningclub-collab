        [
          "python",
          "from sklearn.model_selection import learning_curve\n\ndef plot_learning_curve_data(model, X, y, model_name):\n    \"\"\"Compute learning curve data.\"\"\"\n    train_sizes, train_scores, val_scores = learning_curve(\n        model, X, y,\n        train_sizes=np.linspace(0.1, 1.0, 10),\n        cv=5,\n        scoring='r2',\n        n_jobs=-1,\n        random_state=42\n    )\n    \n    train_mean = train_scores.mean(axis=1)\n    train_std = train_scores.std(axis=1)\n    val_mean = val_scores.mean(axis=1)\n    val_std = val_scores.std(axis=1)\n    \n    print(f\"\\nLearning Curve: {model_name}\")\n    print(\"-\"*65)\n    print(f\"{'Train Size':<12} {'Train R\u00b2 (mean\u00b1std)':<22} {'Val R\u00b2 (mean\u00b1std)':<22}\")\n    print(\"-\"*65)\n    for i in range(len(train_sizes)):\n        print(f\"{train_sizes[i]:<12.0f} {train_mean[i]:.4f} \u00b1 {train_std[i]:.4f}       \"\n              f\"{val_mean[i]:.4f} \u00b1 {val_std[i]:.4f}\")\n    \n    return train_sizes, train_mean, val_mean\n\n# Learning curve for underfitting model\nprint(\"=\"*65)\nprint(\"LEARNING CURVES ANALYSIS\")\nprint(\"=\"*65)\n\n# Underfitting: Simple linear model\nunderfit_model = LinearRegression()\nsizes_u, train_u, val_u = plot_learning_curve_data(\n    underfit_model, X_train[['MedInc']], y_train, \n    \"Linear Regression (1 feature) - UNDERFITTING\"\n)\n\n# Good fit: Ridge with polynomial features\ngoodfit_model = Pipeline([\n    ('poly', PolynomialFeatures(degree=2, include_bias=False)),\n    ('model', Ridge(alpha=1.0))\n])\nsizes_g, train_g, val_g = plot_learning_curve_data(\n    goodfit_model, X_train, y_train,\n    \"Ridge + Poly Features - GOOD FIT\"\n)\n\n# Overfitting: Unlimited depth tree\noverfit_model = DecisionTreeRegressor(max_depth=None, random_state=42)\nsizes_o, train_o, val_o = plot_learning_curve_data(\n    overfit_model, X_train, y_train,\n    \"Decision Tree (no limit) - OVERFITTING\"\n)"
        ]
