          "python",
          "from sklearn.ensemble import GradientBoostingRegressor\n\n# Scenario: Overfitting Gradient Boosting\nprint(\"CASE STUDY: Fixing Overfitting in Gradient Boosting\")\nprint(\"=\"*70)\n\n# Overfitting config (too many trees, too deep, low learning rate)\ngb_overfit = GradientBoostingRegressor(\n    n_estimators=500, max_depth=10, learning_rate=0.1,\n    min_samples_leaf=1, random_state=42\n)\ngb_overfit.fit(X_train, y_train)\noverfit_train = gb_overfit.score(X_train, y_train)\noverfit_test = gb_overfit.score(X_test, y_test)\n\n# Fixed config (regularized)\ngb_fixed = GradientBoostingRegressor(\n    n_estimators=200, max_depth=5, learning_rate=0.1,\n    min_samples_leaf=5, subsample=0.8, random_state=42\n)\ngb_fixed.fit(X_train, y_train)\nfixed_train = gb_fixed.score(X_train, y_train)\nfixed_test = gb_fixed.score(X_test, y_test)\n\nprint(f\"\\n{'Configuration':<40} {'Train R\u00b2':<10} {'Test R\u00b2':<10} {'Gap':<8}\")\nprint(\"-\"*70)\nprint(f\"{'Overfit (500 trees, depth=10)':<40} {overfit_train:<10.4f} {overfit_test:<10.4f} \"\n      f\"{overfit_train-overfit_test:<8.4f}\")\nprint(f\"{'Fixed (200 trees, depth=5, subsample)':<40} {fixed_train:<10.4f} {fixed_test:<10.4f} \"\n      f\"{fixed_train-fixed_test:<8.4f}\")\nprint(\"-\"*70)\n\nprint(f\"\\nFixes applied:\")\nprint(f\"  1. Reduced n_estimators: 500 \u2192 200\")\nprint(f\"  2. Reduced max_depth: 10 \u2192 5\")\nprint(f\"  3. Added min_samples_leaf: 1 \u2192 5\")\nprint(f\"  4. Added subsampling: 1.0 \u2192 0.8 (stochastic gradient boosting)\")\nprint(f\"\\nResult:\")\nprint(f\"  Gap reduced: {overfit_train-overfit_test:.4f} \u2192 {fixed_train-fixed_test:.4f}\")\nprint(f\"  Test R\u00b2 change: {overfit_test:.4f} \u2192 {fixed_test:.4f}\")"
        ]
