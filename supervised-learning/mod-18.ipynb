          "python",
          "from sklearn.linear_model import Ridge, Lasso, ElasticNet\n\n# Create polynomial features for regularization demo\npoly = PolynomialFeatures(degree=3, include_bias=False)\nX_train_poly = poly.fit_transform(X_train)\nX_test_poly = poly.transform(X_test)\n\nprint(f\"Polynomial degree 3: {X_train_poly.shape[1]} features from {X_train.shape[1]} original\")\nprint(\"\\nRegularization Comparison (Polynomial degree=3)\")\nprint(\"=\"*70)\nprint(f\"{'Model':<30} {'Train R\u00b2':<10} {'Test R\u00b2':<10} {'Gap':<8} {'Non-zero coefs':<15}\")\nprint(\"-\"*70)\n\n# No regularization - likely overfitting with many features\nlr = LinearRegression()\nlr.fit(X_train_poly, y_train)\nlr_train = lr.score(X_train_poly, y_train)\nlr_test = lr.score(X_test_poly, y_test)\nn_nonzero_lr = np.sum(np.abs(lr.coef_) > 1e-10)\nprint(f\"{'No regularization':<30} {lr_train:<10.4f} {lr_test:<10.4f} \"\n      f\"{lr_train-lr_test:<8.4f} {n_nonzero_lr:<15}\")\n\n# Ridge (L2 regularization)\nfor alpha in [0.1, 1.0, 10.0, 100.0]:\n    ridge = Ridge(alpha=alpha)\n    ridge.fit(X_train_poly, y_train)\n    r_train = ridge.score(X_train_poly, y_train)\n    r_test = ridge.score(X_test_poly, y_test)\n    n_nonzero = np.sum(np.abs(ridge.coef_) > 1e-10)\n    print(f\"{'Ridge (\u03b1=' + str(alpha) + ')':<30} {r_train:<10.4f} {r_test:<10.4f} \"\n          f\"{r_train-r_test:<8.4f} {n_nonzero:<15}\")\n\n# Lasso (L1 regularization - feature selection)\nfor alpha in [0.001, 0.01, 0.1, 1.0]:\n    lasso = Lasso(alpha=alpha, max_iter=10000)\n    lasso.fit(X_train_poly, y_train)\n    l_train = lasso.score(X_train_poly, y_train)\n    l_test = lasso.score(X_test_poly, y_test)\n    n_nonzero = np.sum(np.abs(lasso.coef_) > 1e-10)\n    print(f\"{'Lasso (\u03b1=' + str(alpha) + ')':<30} {l_train:<10.4f} {l_test:<10.4f} \"\n          f\"{l_train-l_test:<8.4f} {n_nonzero:<15}\")\n\nprint(\"=\"*70)"
