      "source": [
        [
          "python",
          "from sklearn.tree import DecisionTreeRegressor\n\n# Deliberately overfit: no depth limit\noverfit_tree = DecisionTreeRegressor(random_state=42)  # No max_depth!\noverfit_tree.fit(X_train_scaled, y_train)\n\n# Good model: limited depth\ngood_tree = DecisionTreeRegressor(max_depth=6, random_state=42)\ngood_tree.fit(X_train_scaled, y_train)\n\nprint(\"OVERFITTING DEMONSTRATION\")\nprint(\"=\" * 60)\nprint(f\"\\n{'Model':<25} {'Train RMSE':>12} {'Test RMSE':>12} {'Gap':>8}\")\nprint(f\"{'-'*25} {'-'*12} {'-'*12} {'-'*8}\")\n\nfor name, model in [(\"Overfit Tree (no limit)\", overfit_tree), (\"Good Tree (depth=6)\", good_tree), (\"Linear Regression\", lr)]:\n    train_rmse = np.sqrt(mean_squared_error(y_train, model.predict(X_train_scaled)))\n    test_rmse = np.sqrt(mean_squared_error(y_test, model.predict(X_test_scaled)))\n    gap = test_rmse - train_rmse\n    print(f\"{name:<25} {train_rmse:>12.4f} {test_rmse:>12.4f} {gap:>8.4f}\")"
        ]
      ]
    },
    {
