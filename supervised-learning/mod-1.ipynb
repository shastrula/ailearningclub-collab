      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.linear_model import LinearRegression, LogisticRegression\nfrom sklearn.metrics import mean_squared_error, accuracy_score\n\n# Create synthetic regression dataset\nnp.random.seed(42)\nX = np.random.randn(100, 1) * 10\ny_regression = 2 * X.ravel() + np.random.randn(100) * 5  # Linear with noise\n\n# Create synthetic classification dataset\nX_class = np.random.randn(100, 2)\ny_classification = (X_class[:, 0] + X_class[:, 1] > 0).astype(int)\n\n# Split data: 80% training, 20% testing\nX_train_r, X_test_r, y_train_r, y_test_r = train_test_split(\n    X, y_regression, test_size=0.2, random_state=42\n)\nX_train_c, X_test_c, y_train_c, y_test_c = train_test_split(\n    X_class, y_classification, test_size=0.2, random_state=42\n)\n\n# REGRESSION: Training & Inference\nreg_model = LinearRegression()\nreg_model.fit(X_train_r, y_train_r)  # Training phase\ny_pred_r = reg_model.predict(X_test_r)  # Inference phase\nmse = mean_squared_error(y_test_r, y_pred_r)\nprint(f\"Regression MSE: {mse:.2f}\")\n\n# CLASSIFICATION: Training & Inference\nclf_model = LogisticRegression()\nclf_model.fit(X_train_c, y_train_c)  # Training phase\ny_pred_c = clf_model.predict(X_test_c)  # Inference phase\naccuracy = accuracy_score(y_test_c, y_pred_c)\nprint(f\"Classification Accuracy: {accuracy:.2f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Demonstrating overfitting with polynomial features\nfrom sklearn.preprocessing import PolynomialFeatures\nfrom sklearn.pipeline import Pipeline\n\n# Create simple 1D regression data\nnp.random.seed(42)\nX_simple = np.linspace(0, 10, 30).reshape(-1, 1)\ny_simple = 2 * X_simple.ravel() + np.random.randn(30) * 3\n\nX_train_s, X_test_s, y_train_s, y_test_s = train_test_split(\n    X_simple, y_simple, test_size=0.2, random_state=42\n)\n\n# Low complexity model (good generalization)\nsimple_model = LinearRegression()\nsimple_model.fit(X_train_s, y_train_s)\ntrain_error_simple = mean_squared_error(y_train_s, simple_model.predict(X_train_s))\ntest_error_simple = mean_squared_error(y_test_s, simple_model.predict(X_test_s))\n\n# High complexity model (overfitting)\npoly_pipeline = Pipeline([\n    ('poly_features', PolynomialFeatures(degree=9)),\n    ('linear_model', LinearRegression())\n])\npoly_pipeline.fit(X_train_s, y_train_s)\ntrain_error_poly = mean_squared_error(y_train_s, poly_pipeline.predict(X_train_s))\ntest_error_poly = mean_squared_error(y_test_s, poly_pipeline.predict(X_test_s))\n\nprint(f\"Simple Model - Train MSE: {train_error_simple:.2f}, Test MSE: {test_error_simple:.2f}\")\nprint(f\"Poly Model - Train MSE: {train_error_poly:.2f}, Test MSE: {test_error_poly:.2f}\")\nprint(f\"Overfitting gap (Poly): {test_error_poly - train_error_poly:.2f}\")"
        ]
      ]
    }
