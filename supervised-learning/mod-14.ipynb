      "source": [
        [
          "python",
          "# Demonstrate difference with outliers\nfrom sklearn.datasets import make_regression\nfrom sklearn.metrics import mean_squared_error, mean_absolute_error\nimport numpy as np\n\nX, y = make_regression(n_samples=100, n_features=5, noise=5, random_state=42)\ny_pred = y + np.random.normal(0, 5, len(y))\n\n# Add one large outlier\ny_pred[-1] += 100\n\nmse = mean_squared_error(y, y_pred)\nmae = mean_absolute_error(y, y_pred)\n\nprint(f\"MSE: {mse:.4f}  (heavily penalizes the outlier)\")\nprint(f\"MAE: {mae:.4f}  (outlier has equal weight)\")\n\n# Remove outlier\ny_test_clean = np.concatenate([y[:-1], y[-1:]])\ny_pred_clean = np.concatenate([y_pred[:-1], y_pred[-1:] - 100])\n\nmse_clean = mean_squared_error(y_test_clean, y_pred_clean)\nmae_clean = mean_absolute_error(y_test_clean, y_pred_clean)\n\nprint(f\"\\nWithout outlier:\")\nprint(f\"MSE: {mse_clean:.4f}\")\nprint(f\"MAE: {mae_clean:.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
