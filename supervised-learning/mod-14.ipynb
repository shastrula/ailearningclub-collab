          "python",
          "import numpy as np\nfrom sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\n\n# Simulate imbalanced scenario: 95% benign, 5% malignant\nnp.random.seed(42)\nn = 1000\ny_true = np.array([0]*50 + [1]*950)  # 5% malignant\n\n# \"Lazy model\" that always predicts benign\ny_lazy = np.ones(n)\n\n# \"Smart model\" that catches 80% of malignant\ny_smart = y_true.copy()\ny_smart[:10] = 1  # Misses 10 malignant (80% recall)\ny_smart[950:970] = 0  # 20 false positives\n\nprint(\"The Accuracy Trap (95% Benign, 5% Malignant):\")\nprint(f\"{'Metric':<12} {'Lazy (always benign)':<22} {'Smart model':<22}\")\nprint(\"-\" * 56)\nprint(f\"{'Accuracy':<12} {accuracy_score(y_true, y_lazy):<22.4f} {accuracy_score(y_true, y_smart):<22.4f}\")\nprint(f\"{'Precision':<12} {0.0:<22} {precision_score(y_true, y_smart, pos_label=0):<22.4f}\")\nprint(f\"{'Recall':<12} {0.0:<22} {recall_score(y_true, y_smart, pos_label=0):<22.4f}\")\nprint(f\"{'F1':<12} {0.0:<22} {f1_score(y_true, y_smart, pos_label=0):<22.4f}\")\n\nprint(f\"\\nThe lazy model has 95% accuracy but catches ZERO malignant tumors!\")\nprint(f\"The smart model has lower accuracy but catches 80% of cancers.\")\nprint(f\"\\nLesson: NEVER use accuracy alone for imbalanced datasets.\")"
