    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.preprocessing import StandardScaler, MinMaxScaler\nfrom sklearn.datasets import load_diabetes\nimport numpy as np\nimport pandas as pd\n\nX, y = load_diabetes(return_X_y=True)\n\n# StandardScaler: (x - mean) / std, results in mean=0, std=1\nscaler_std = StandardScaler()\nX_standardized = scaler_std.fit_transform(X)\n\n# MinMaxScaler: (x - min) / (max - min), results in [0, 1]\nscaler_minmax = MinMaxScaler()\nX_normalized = scaler_minmax.fit_transform(X)\n\nprint(f\"Standardized - Mean: {X_standardized.mean(axis=0)[0]:.4f}, Std: {X_standardized.std(axis=0)[0]:.4f}\")\nprint(f\"Normalized - Min: {X_normalized.min(axis=0)[0]:.4f}, Max: {X_normalized.max(axis=0)[0]:.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.preprocessing import RobustScaler\n\n# RobustScaler uses median and IQR: (x - median) / IQR\nscaler_robust = RobustScaler()\nX_robust = scaler_robust.fit_transform(X)\n\n# Create synthetic data with outliers\nX_with_outliers = X.copy()\nX_with_outliers[0, 0] = 1000  # Extreme outlier\n\nprint(\"Effect of outliers:\")\nprint(f\"StandardScaler: {StandardScaler().fit_transform(X_with_outliers)[0, 0]:.2f}\")\nprint(f\"RobustScaler: {RobustScaler().fit_transform(X_with_outliers)[0, 0]:.2f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.preprocessing import KBinsDiscretizer\n\n# Equal-width binning: divides range into equal intervals\ndiscretizer = KBinsDiscretizer(n_bins=5, encode='ordinal', strategy='quantile')\nX_binned = discretizer.fit_transform(X[:, :1])\n\nprint(\"Original feature range:\", X[:, 0].min(), \"to\", X[:, 0].max())\nprint(\"Binned values (sample):\", X_binned[:5].flatten())"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.preprocessing import OneHotEncoder\nimport pandas as pd\n\n# Sample categorical data\ndf = pd.DataFrame({\n    'color': ['red', 'blue', 'red', 'green', 'blue'],\n    'size': ['S', 'M', 'L', 'M', 'S']\n})\n\nencoder = OneHotEncoder(sparse_output=False)\nencoded = encoder.fit_transform(df)\n\nfeature_names = encoder.get_feature_names_out(['color', 'size'])\nprint(\"Encoded features:\", feature_names)\nprint(\"Encoded data shape:\", encoded.shape)"
        ]
      ]
    },
    {
      "cell_type": "code",
