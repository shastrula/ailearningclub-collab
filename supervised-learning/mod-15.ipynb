      "source": [
        [
          "python",
          "from sklearn.preprocessing import OneHotEncoder\n\n# Create a categorical feature: California region based on latitude\ndef assign_region(lat):\n    if lat < 34:\n        return 'SoCal'\n    elif lat < 37:\n        return 'Central'\n    elif lat < 39:\n        return 'BayArea'\n    else:\n        return 'NorCal'\n\nX_train_cat = X_train.copy()\nX_test_cat = X_test.copy()\nX_train_cat['Region'] = X_train['Latitude'].apply(assign_region)\nX_test_cat['Region'] = X_test['Latitude'].apply(assign_region)\n\nprint(\"Region distribution:\")\nprint(X_train_cat['Region'].value_counts())\n\n# One-hot encode the Region column\nencoder = OneHotEncoder(sparse_output=False, drop='first')\nregion_train = encoder.fit_transform(X_train_cat[['Region']])\nregion_test = encoder.transform(X_test_cat[['Region']])\n\nprint(f\"\\nEncoded columns: {encoder.get_feature_names_out(['Region'])}\")\n\n# Add encoded features, drop original categorical\nX_train_encoded = X_train_cat.drop('Region', axis=1)\nregion_df_train = pd.DataFrame(region_train,\n    columns=encoder.get_feature_names_out(['Region']),\n    index=X_train_encoded.index)\nX_train_encoded = pd.concat([X_train_encoded, region_df_train], axis=1)\n\nX_test_encoded = X_test_cat.drop('Region', axis=1)\nregion_df_test = pd.DataFrame(region_test,\n    columns=encoder.get_feature_names_out(['Region']),\n    index=X_test_encoded.index)\nX_test_encoded = pd.concat([X_test_encoded, region_df_test], axis=1)\n\n# Evaluate\nohe_pipe = Pipeline([\n    ('scaler', StandardScaler()),\n    ('model', LinearRegression())\n])\nohe_pipe.fit(X_train_encoded, y_train)\nohe_test = ohe_pipe.score(X_test_encoded, y_test)\nprint(f\"\\nWith One-Hot Region R\u00b2 (test): {ohe_test:.4f}\")\nprint(f\"Improvement over baseline: +{(ohe_test - baseline_test)*100:.2f}%\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Region distribution:\nCentral    5339\nSoCal      4764\nBayArea    4229\nNorCal     2180\nName: Region, dtype: int64\n\nEncoded columns: ['Region_Central' 'Region_NorCal' 'Region_SoCal']\n\nWith One-Hot Region R\u00b2 (test): 0.6081\nImprovement over baseline: +0.26%"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Create a high-cardinality feature: location cluster\nfrom sklearn.cluster import KMeans\n\n# Create 50 location clusters from Lat/Long\nkmeans = KMeans(n_clusters=50, random_state=42, n_init=10)\nX_train_te = X_train.copy()\nX_test_te = X_test.copy()\n\nX_train_te['LocationCluster'] = kmeans.fit_predict(\n    X_train[['Latitude', 'Longitude']]\n)\nX_test_te['LocationCluster'] = kmeans.predict(\n    X_test[['Latitude', 'Longitude']]\n)\n\n# Target encoding: replace cluster ID with mean target value\ncluster_means = y_train.groupby(X_train_te['LocationCluster']).mean()\nX_train_te['LocationCluster_encoded'] = X_train_te['LocationCluster'].map(cluster_means)\nX_test_te['LocationCluster_encoded'] = X_test_te['LocationCluster'].map(cluster_means)\n\n# Fill any missing (clusters in test not in train) with global mean\nX_test_te['LocationCluster_encoded'].fillna(y_train.mean(), inplace=True)\n\n# Drop original cluster column, keep encoded\nX_train_te = X_train_te.drop('LocationCluster', axis=1)\nX_test_te = X_test_te.drop('LocationCluster', axis=1)\n\nprint(\"Target-encoded LocationCluster (sample values):\")\nprint(X_train_te['LocationCluster_encoded'].describe().round(4))\n\n# Evaluate\nte_pipe = Pipeline([\n    ('scaler', StandardScaler()),\n    ('model', LinearRegression())\n])\nte_pipe.fit(X_train_te, y_train)\nte_test = te_pipe.score(X_test_te, y_test)\nprint(f\"\\nWith Target-Encoded Location R\u00b2 (test): {te_test:.4f}\")\nprint(f\"Improvement over baseline: +{(te_test - baseline_test)*100:.2f}%\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
