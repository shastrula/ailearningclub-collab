        [
          "python",
          "from sklearn.ensemble import GradientBoostingRegressor\n\n# Combine: interactions + target-encoded location + polynomial on key features\nX_train_full = X_train.copy()\nX_test_full = X_test.copy()\n\n# Add interaction features\nX_train_full['RoomsPerPerson'] = X_train['AveRooms'] / X_train['AveOccup']\nX_test_full['RoomsPerPerson'] = X_test['AveRooms'] / X_test['AveOccup']\nX_train_full['IncomeRooms'] = X_train['MedInc'] * X_train['AveRooms']\nX_test_full['IncomeRooms'] = X_test['MedInc'] * X_test['AveRooms']\nX_train_full['BedroomRatio'] = X_train['AveBedrms'] / X_train['AveRooms']\nX_test_full['BedroomRatio'] = X_test['AveBedrms'] / X_test['AveRooms']\n\n# Add target-encoded location clusters\nX_train_full['LocationCluster'] = kmeans.predict(X_train[['Latitude', 'Longitude']])\nX_test_full['LocationCluster'] = kmeans.predict(X_test[['Latitude', 'Longitude']])\nX_train_full['LocEncoded'] = X_train_full['LocationCluster'].map(cluster_means)\nX_test_full['LocEncoded'] = X_test_full['LocationCluster'].map(cluster_means)\nX_test_full['LocEncoded'].fillna(y_train.mean(), inplace=True)\nX_train_full.drop('LocationCluster', axis=1, inplace=True)\nX_test_full.drop('LocationCluster', axis=1, inplace=True)\n\n# Add polynomial on MedInc (strongest predictor)\nX_train_full['MedInc_sq'] = X_train['MedInc'] ** 2\nX_test_full['MedInc_sq'] = X_test['MedInc'] ** 2\n\n# Clean infinities\nX_train_full.replace([np.inf, -np.inf], np.nan, inplace=True)\nX_test_full.replace([np.inf, -np.inf], np.nan, inplace=True)\nX_train_full.fillna(X_train_full.median(), inplace=True)\nX_test_full.fillna(X_train_full.median(), inplace=True)\n\nprint(f\"Total engineered features: {X_train_full.shape[1]}\")\nprint(f\"Feature list: {list(X_train_full.columns)}\")\n\n# Evaluate with Linear Regression\nfull_pipe = Pipeline([\n    ('scaler', StandardScaler()),\n    ('model', LinearRegression())\n])\nfull_pipe.fit(X_train_full, y_train)\nfull_linear_test = full_pipe.score(X_test_full, y_test)\n\n# Also evaluate with GradientBoosting\ngb_pipe = Pipeline([\n    ('scaler', StandardScaler()),\n    ('model', GradientBoostingRegressor(n_estimators=200, random_state=42))\n])\ngb_pipe.fit(X_train_full, y_train)\nfull_gb_test = gb_pipe.score(X_test_full, y_test)\n\nprint(f\"\\n{'='*50}\")\nprint(f\"RESULTS COMPARISON\")\nprint(f\"{'='*50}\")\nprint(f\"{'Model':<35} {'Test R\u00b2':<10}\")\nprint(f\"{'-'*45}\")\nprint(f\"{'Baseline (raw features + LR)':<35} {baseline_test:<10.4f}\")\nprint(f\"{'Engineered features + LR':<35} {full_linear_test:<10.4f}\")\nprint(f\"{'Engineered features + GBR':<35} {full_gb_test:<10.4f}\")\nprint(f\"{'-'*45}\")\nprint(f\"LR improvement: +{(full_linear_test - baseline_test)*100:.2f}%\")\nprint(f\"GBR improvement: +{(full_gb_test - baseline_test)*100:.2f}%\")"
        ]
      ]
