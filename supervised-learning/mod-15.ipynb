      "source": [
        [
          "python",
          "from sklearn.preprocessing import OrdinalEncoder\n\ndf = pd.DataFrame({\n    'education': ['high_school', 'bachelor', 'master', 'high_school'],\n    'rating': ['low', 'medium', 'high', 'low']\n})\n\nencoder = OrdinalEncoder(categories=[['high_school', 'bachelor', 'master'], ['low', 'medium', 'high']])\nencoded = encoder.fit_transform(df)\nprint(\"Ordinal encoded:\\n\", encoded)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.preprocessing import PolynomialFeatures\nimport numpy as np\n\nX = np.array([[1, 2], [3, 4], [5, 6]])\n\n# degree=2 generates: [1, x1, x2, x1*x1, x1*x2, x2*x2]\npoly = PolynomialFeatures(degree=2, include_bias=False)\nX_poly = poly.fit_transform(X)\n\nprint(\"Original shape:\", X.shape)\nprint(\"With interactions:\", X_poly.shape)\nprint(\"Feature names:\", poly.get_feature_names_out(['age', 'income']))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.feature_extraction.text import TfidfVectorizer\n\ntexts = [\n    \"machine learning is powerful\",\n    \"deep learning transforms AI\",\n    \"machine learning powers AI\",\n    \"data science is essential\"\n]\n\nvectorizer = TfidfVectorizer(max_features=10, stop_words='english')\ntfidf_matrix = vectorizer.fit_transform(texts)\n\nprint(\"TF-IDF shape:\", tfidf_matrix.shape)\nprint(\"Vocabulary size:\", len(vectorizer.vocabulary_))\nprint(\"Feature names:\", vectorizer.get_feature_names_out())"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
