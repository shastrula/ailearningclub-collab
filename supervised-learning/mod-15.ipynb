      "outputs": [],
      "source": [
        [
          "python",
          "import pandas as pd\nimport numpy as np\n\n# Customer data\ncustomers = pd.DataFrame({\n    'monthly_bill': [50, 80, 120, 45],\n    'account_age_months': [12, 36, 24, 6],\n    'support_calls': [0, 5, 2, 8]\n})\n\n# Domain-specific features\ncustomers['bill_to_support_ratio'] = customers['monthly_bill'] / (customers['support_calls'] + 1)\ncustomers['lifetime_value'] = customers['monthly_bill'] * customers['account_age_months']\ncustomers['support_intensity'] = customers['support_calls'] / customers['account_age_months']\n\nprint(\"Domain features engineered:\")\nprint(customers)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.feature_selection import SelectKBest, f_classif\nfrom sklearn.datasets import make_classification\n\nX, y = make_classification(n_samples=100, n_features=20, n_informative=5, random_state=42)\n\nselector = SelectKBest(score_func=f_classif, k=5)\nX_selected = selector.fit_transform(X, y)\n\nprint(f\"Selected {X_selected.shape[1]} features from {X.shape[1]}\")\nprint(\"Selected feature indices:\", selector.get_support(indices=True))"
        ]
      ]
    },
    {
      "cell_type": "code",
