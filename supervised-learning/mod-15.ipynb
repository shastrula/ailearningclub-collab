        [
          "python",
          "Target-encoded LocationCluster (sample values):\ncount    16512.0000\nmean         2.0716\nstd          0.7640\nmin          0.9233\n25%          1.4802\n50%          1.9450\n75%          2.5371\nmax          4.1268\nName: LocationCluster_encoded, dtype: float64\n\nWith Target-Encoded Location R\u00b2 (test): 0.7012\nImprovement over baseline: +9.57%"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Create meaningful interaction features\nX_train_inter = X_train.copy()\nX_test_inter = X_test.copy()\n\n# Feature: Rooms per person\nX_train_inter['RoomsPerPerson'] = X_train['AveRooms'] / X_train['AveOccup']\nX_test_inter['RoomsPerPerson'] = X_test['AveRooms'] / X_test['AveOccup']\n\n# Feature: Income \u00d7 Rooms (luxury indicator)\nX_train_inter['IncomeRooms'] = X_train['MedInc'] * X_train['AveRooms']\nX_test_inter['IncomeRooms'] = X_test['MedInc'] * X_test['AveRooms']\n\n# Feature: Bedrooms ratio\nX_train_inter['BedroomRatio'] = X_train['AveBedrms'] / X_train['AveRooms']\nX_test_inter['BedroomRatio'] = X_test['AveBedrms'] / X_test['AveRooms']\n\n# Feature: Population density proxy\nX_train_inter['PopDensity'] = X_train['Population'] / X_train['AveOccup']\nX_test_inter['PopDensity'] = X_test['Population'] / X_test['AveOccup']\n\n# Replace inf values with NaN, then fill with median\nX_train_inter.replace([np.inf, -np.inf], np.nan, inplace=True)\nX_test_inter.replace([np.inf, -np.inf], np.nan, inplace=True)\nX_train_inter.fillna(X_train_inter.median(), inplace=True)\nX_test_inter.fillna(X_train_inter.median(), inplace=True)\n\nprint(f\"Features added: RoomsPerPerson, IncomeRooms, BedroomRatio, PopDensity\")\nprint(f\"Total features: {X_train_inter.shape[1]}\")\n\n# Evaluate\ninter_pipe = Pipeline([\n    ('scaler', StandardScaler()),\n    ('model', LinearRegression())\n])\ninter_pipe.fit(X_train_inter, y_train)\ninter_test = inter_pipe.score(X_test_inter, y_test)\nprint(f\"\\nWith Interaction Features R\u00b2 (test): {inter_test:.4f}\")\nprint(f\"Improvement over baseline: +{(inter_test - baseline_test)*100:.2f}%\")"
        ]
      ]
    },
    {
      "cell_type": "code",
