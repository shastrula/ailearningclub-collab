      "outputs": [],
      "source": [
        [
          "python",
          "Original features: 8\nPolynomial features (degree=2): 44\n\nSample feature names (first 15):\n['MedInc' 'HouseAge' 'AveRooms' 'AveBedrms' 'Population' 'AveOccup'\n 'Latitude' 'Longitude' 'MedInc^2' 'MedInc HouseAge' 'MedInc AveRooms'\n 'MedInc AveBedrms' 'MedInc Population' 'MedInc AveOccup' 'MedInc Latitude']\n\nPolynomial Features R\u00b2 (test): 0.6734\nImprovement over baseline: +6.79%"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.preprocessing import KBinsDiscretizer\n\n# Bin HouseAge into categories\nbinner = KBinsDiscretizer(n_bins=5, encode='onehot-dense', strategy='quantile')\n\n# Apply binning to HouseAge column\nX_train_binned = X_train.copy()\nX_test_binned = X_test.copy()\n\nage_bins_train = binner.fit_transform(X_train[['HouseAge']])\nage_bins_test = binner.transform(X_test[['HouseAge']])\n\n# Show bin edges\nprint(\"HouseAge bin edges:\", binner.bin_edges_[0].round(1))\nprint(f\"Bin counts (train):\")\nfor i in range(5):\n    count = age_bins_train[:, i].sum()\n    print(f\"  Bin {i}: {int(count)} samples\")\n\n# Add binned features to dataset\nbin_cols = [f'HouseAge_bin_{i}' for i in range(5)]\nX_train_with_bins = pd.concat([\n    X_train.reset_index(drop=True),\n    pd.DataFrame(age_bins_train, columns=bin_cols)\n], axis=1)\nX_test_with_bins = pd.concat([\n    X_test.reset_index(drop=True),\n    pd.DataFrame(age_bins_test, columns=bin_cols)\n], axis=1)\n\n# Evaluate\nbin_pipe = Pipeline([\n    ('scaler', StandardScaler()),\n    ('model', LinearRegression())\n])\nbin_pipe.fit(X_train_with_bins, y_train)\nbin_test = bin_pipe.score(X_test_with_bins, y_test)\nprint(f\"\\nWith HouseAge bins R\u00b2 (test): {bin_test:.4f}\")\nprint(f\"Improvement over baseline: +{(bin_test - baseline_test)*100:.2f}%\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
