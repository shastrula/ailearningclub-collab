          "python",
          "import numpy as np\nfrom sklearn.tree import DecisionTreeRegressor\nfrom sklearn.datasets import make_regression\nfrom sklearn.metrics import mean_squared_error\nimport matplotlib.pyplot as plt\n\n# Create synthetic data\nX, y = make_regression(n_samples=200, n_features=1, noise=10, random_state=42)\n\n# Simple gradient boosting implementation (for illustration)\nn_iterations = 50\nlearning_rate = 0.1\ntree_depth = 3\n\npredictions = np.zeros(len(y))\nresiduals_history = []\n\nfor iteration in range(n_iterations):\n    # Compute residuals\n    residuals = y - predictions\n    residuals_history.append(np.mean(residuals**2))\n    \n    # Train tree on residuals\n    tree = DecisionTreeRegressor(max_depth=tree_depth, random_state=42)\n    tree.fit(X, residuals)\n    \n    # Add predictions scaled by learning rate\n    predictions += learning_rate * tree.predict(X)\n\n# Plot: Error decreases as we add more trees\nplt.figure(figsize=(10, 6))\nplt.plot(residuals_history)\nplt.xlabel('Iteration')\nplt.ylabel('Mean Squared Error')\nplt.title('Boosting: Error Decreases with Each Tree')\nplt.grid(True)\n\nfinal_mse = mean_squared_error(y, predictions)\nprint(f\"Final MSE: {final_mse:.2f}\")\nprint(f\"Initial MSE: {residuals_history[0]:.2f}\")"
        ]
      ]
    },
