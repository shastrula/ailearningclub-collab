          "python",
          "# Feature preprocessing\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.preprocessing import StandardScaler, OrdinalEncoder\n\npreprocessor = ColumnTransformer([\n    ('numeric', StandardScaler(), ['age', 'income', 'credit_score']),\n    ('ordinal', OrdinalEncoder(), ['education_level', 'employment_status'])\n])\n\n# Random forest for loan approval\nfrom sklearn.ensemble import RandomForestClassifier\n\npipeline = Pipeline([\n    ('preprocessor', preprocessor),\n    ('classifier', RandomForestClassifier(n_estimators=100, max_depth=10, random_state=42))\n])\n\npipeline.fit(X_train, y_train)\n\n# Feature importance reveals key drivers\nfeature_names = ['age', 'income', 'credit_score', 'education', 'employment']\nimportances = pipeline.named_steps['classifier'].feature_importances_\nimportance_df = pd.DataFrame({\n    'Feature': feature_names,\n    'Importance': importances\n}).sort_values('Importance', ascending=False)\n\nprint(\"Loan Approval Decision Drivers:\")\nprint(importance_df)\n\n# Example: Income is most important, suggesting ability to repay drives decisions"
