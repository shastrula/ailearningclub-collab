      "source": [
        [
          "python",
          "import xgboost as xgb\nimport lightgbm as lgb\nfrom catboost import CatBoostClassifier\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.model_selection import cross_val_score\n\nX, y = load_breast_cancer(return_X_y=True)\n\n# Train three models\nxgb_model = xgb.XGBClassifier(n_estimators=200, learning_rate=0.05, max_depth=6, random_state=42)\nlgb_model = lgb.LGBMClassifier(n_estimators=200, learning_rate=0.05, max_depth=6, random_state=42)\ncb_model = CatBoostClassifier(iterations=200, learning_rate=0.05, depth=6, verbose=False)\n\nxgb_score = cross_val_score(xgb_model, X, y, cv=5, scoring='roc_auc').mean()\nlgb_score = cross_val_score(lgb_model, X, y, cv=5, scoring='roc_auc').mean()\ncb_score = cross_val_score(cb_model, X, y, cv=5, scoring='roc_auc').mean()\n\nprint(f\"XGBoost CV-AUC: {xgb_score:.4f}\")\nprint(f\"LightGBM CV-AUC: {lgb_score:.4f}\")\nprint(f\"CatBoost CV-AUC: {cb_score:.4f}\")\n\n# Ensemble: use weights based on performance\nweights = np.array([xgb_score, lgb_score, cb_score])\nweights = weights / weights.sum()\n\n# Retrain on full data\nxgb_model.fit(X, y)\nlgb_model.fit(X, y)\ncb_model.fit(X, y)\n\n# Ensemble predictions\ndef ensemble_predict(X):\n    preds = (weights[0] * xgb_model.predict_proba(X)[:, 1] +\n             weights[1] * lgb_model.predict_proba(X)[:, 1] +\n             weights[2] * cb_model.predict_proba(X)[:, 1])\n    return preds\n\nensemble_score = roc_auc_score(y, ensemble_predict(X))\nprint(f\"Ensemble AUC: {ensemble_score:.4f}\")"
        ]
      ]
    }
