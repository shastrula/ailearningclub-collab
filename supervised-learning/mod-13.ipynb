          "python",
          "import pandas as pd\nfrom catboost import CatBoostClassifier\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import accuracy_score, roc_auc_score\nimport shap\n\n# Create dataset with categorical features\ndata = pd.DataFrame({\n    'age': np.random.randint(20, 80, 1000),\n    'income': np.random.randint(20000, 150000, 1000),\n    'category': np.random.choice(['A', 'B', 'C'], 1000),\n    'region': np.random.choice(['North', 'South', 'East', 'West'], 1000)\n})\ny = (data['age'] > 50).astype(int) ^ (data['income'] > 80000).astype(int)\n\nX_train, X_test, y_train, y_test = train_test_split(data, y, test_size=0.2, random_state=42)\n\n# Train with early stopping and categorical features\ncat_features = ['category', 'region']\nmodel = CatBoostClassifier(\n    iterations=500,\n    learning_rate=0.1,\n    depth=6,\n    cat_features=cat_features,\n    early_stopping_rounds=20,\n    verbose=False\n)\n\n# Use validation set for early stopping\nX_tr, X_val, y_tr, y_val = train_test_split(X_train, y_train, test_size=0.2, random_state=42)\nmodel.fit(X_tr, y_tr, eval_set=(X_val, y_val))\n\n# Evaluation\ny_pred = model.predict(X_test)\ny_pred_proba = model.predict_proba(X_test)[:, 1]\n\nprint(f\"Test Accuracy: {accuracy_score(y_test, y_pred):.4f}\")\nprint(f\"Test ROC-AUC: {roc_auc_score(y_test, y_pred_proba):.4f}\")"
        ]
