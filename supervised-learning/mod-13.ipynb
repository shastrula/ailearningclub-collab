          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.datasets import fetch_california_housing\nfrom xgboost import XGBRegressor\nfrom lightgbm import LGBMRegressor\nfrom catboost import CatBoostRegressor\n\nhousing = fetch_california_housing()\nX = pd.DataFrame(housing.data, columns=housing.feature_names)\ny = housing.target\n\n# Train all three\nxgb = XGBRegressor(n_estimators=500, learning_rate=0.05, max_depth=5, random_state=42, n_jobs=-1)\nlgbm = LGBMRegressor(n_estimators=500, learning_rate=0.05, num_leaves=31, random_state=42, n_jobs=-1, verbose=-1)\ncat = CatBoostRegressor(iterations=500, learning_rate=0.05, depth=6, random_seed=42, verbose=0)\n\nxgb.fit(X, y)\nlgbm.fit(X, y)\ncat.fit(X, y)\n\n# Compare feature importances\nimportance_df = pd.DataFrame({\n    'Feature': housing.feature_names,\n    'XGBoost': xgb.feature_importances_,\n    'LightGBM': lgbm.feature_importances_ / lgbm.feature_importances_.sum(),\n    'CatBoost': cat.feature_importances_ / cat.feature_importances_.sum(),\n})\n\n# Sort by average importance\nimportance_df['Average'] = importance_df[['XGBoost', 'LightGBM', 'CatBoost']].mean(axis=1)\nimportance_df = importance_df.sort_values('Average', ascending=False)\n\nprint(\"Feature Importance Comparison:\")\nprint(f\"{'Feature':<12} {'XGBoost':<10} {'LightGBM':<10} {'CatBoost':<10} {'Average':<10}\")\nprint(\"=\" * 52)\nfor _, row in importance_df.iterrows():\n    print(f\"{row['Feature']:<12} {row['XGBoost']:<10.4f} {row['LightGBM']:<10.4f} \"\n          f\"{row['CatBoost']:<10.4f} {row['Average']:<10.4f}\")"
