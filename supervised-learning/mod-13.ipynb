          "import shap\nimport xgboost as xgb\nfrom sklearn.datasets import load_breast_cancer\n\nX, y = load_breast_cancer(return_X_y=True)\nmodel = xgb.XGBClassifier(n_estimators=100)\nmodel.fit(X, y)\n\nexplainer = shap.TreeExplainer(model)\nshap_values = explainer.shap_values(X[:100])\n\n# Main effects SHAP importance\nshap_importance = np.abs(shap_values).mean(axis=0)\n\n# Dependence plot: how feature values correlate with SHAP values\n# shap.dependence_plot(0, shap_values, X)  # Feature 0\n\n# Interaction: which features interact with feature 0\n# interaction_values = explainer.shap_interaction_values(X[:100])\n# shap.dependence_plot((0, 1), interaction_values, X)  # Interaction of features 0 and 1"
