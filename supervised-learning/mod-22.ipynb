        [
          "python",
          "# Check normality of residuals\nfrom scipy import stats\n\nstat, p_value = stats.shapiro(residuals[:5000])  # Shapiro-Wilk test\nprint(f\"Normality test p-value: {p_value:.4f}\")\nif p_value < 0.05:\n    print(\"\u26a0\ufe0f Residuals may not be normally distributed\")\n\n# Calculate Variance Inflation Factor (VIF) for multicollinearity\nfrom statsmodels.stats.outliers_influence import variance_inflation_factor\n\nvif_data = pd.DataFrame()\nvif_data['Feature'] = feature_names\nvif_data['VIF'] = [variance_inflation_factor(X_train_scaled, i) for i in range(X_train_scaled.shape[1])]\nprint(\"\\nVariance Inflation Factor (VIF):\")\nprint(vif_data.sort_values('VIF', ascending=False))\nprint(\"(VIF > 5 indicates potential multicollinearity)\")\n\n# Confidence intervals for predictions\nfrom scipy.stats import t\n\nn = len(y_test)\ndof = n - X_test_scaled.shape[1] - 1\nt_val = t.ppf(0.975, dof)\nrmse = np.sqrt(mean_squared_error(y_test, y_test_pred))\nci_width = t_val * rmse\n\nprint(f\"\\n95% prediction intervals width: \u00b1${ci_width:.4f}M\")"
