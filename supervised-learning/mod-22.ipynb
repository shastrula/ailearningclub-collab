    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.model_selection import train_test_split\n\n# Define features\nX_simple = df[['MedInc']]  # Single best predictor\nX_multiple = df[['MedInc', 'AveRooms', 'HouseAge', 'Latitude', 'Longitude']]  # Top 5\ny = df['Price']\n\n# Train/test split (same random state for fair comparison)\nX_train_s, X_test_s, y_train, y_test = train_test_split(\n    X_simple, y, test_size=0.2, random_state=42\n)\nX_train_m, X_test_m, _, _ = train_test_split(\n    X_multiple, y, test_size=0.2, random_state=42\n)\n\nprint(f\"Training samples: {X_train_s.shape[0]}\")\nprint(f\"Test samples: {X_test_s.shape[0]}\")\nprint(f\"Simple model features: {list(X_simple.columns)}\")\nprint(f\"Multiple model features: {list(X_multiple.columns)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Training samples: 16512\nTest samples: 4128\nSimple model features: ['MedInc']\nMultiple model features: ['MedInc', 'AveRooms', 'HouseAge', 'Latitude', 'Longitude']"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.linear_model import LinearRegression\n\n# Simple regression (one feature: MedInc)\nmodel_simple = LinearRegression()\nmodel_simple.fit(X_train_s, y_train)\n\nprint(\"=== Simple Linear Regression ===\")\nprint(f\"Coefficient (slope): {model_simple.coef_[0]:.4f}\")\nprint(f\"Intercept: {model_simple.intercept_:.4f}\")\nprint(f\"\\nEquation: Price = {model_simple.intercept_:.4f} + {model_simple.coef_[0]:.4f} * MedInc\")\n\n# Predictions\ny_pred_simple = model_simple.predict(X_test_s)\nprint(f\"\\nSample Predictions vs Actual (first 5):\")\nfor i in range(5):\n    print(f\"  Predicted: {y_pred_simple[i]:.3f}, Actual: {y_test.iloc[i]:.3f}, \"\n          f\"Error: {abs(y_pred_simple[i] - y_test.iloc[i]):.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "=== Simple Linear Regression ===\nCoefficient (slope): 0.4179\nIntercept: 0.4500\n\nEquation: Price = 0.4500 + 0.4179 * MedInc\n\nSample Predictions vs Actual (first 5):\n  Predicted: 1.892, Actual: 0.477, Error: 1.415\n  Predicted: 2.172, Actual: 0.458, Error: 1.714\n  Predicted: 3.662, Actual: 5.000, Error: 1.338\n  Predicted: 2.268, Actual: 2.186, Error: 0.082\n  Predicted: 2.688, Actual: 2.780, Error: 0.108"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Multiple regression (5 features)\nmodel_multiple = LinearRegression()\nmodel_multiple.fit(X_train_m, y_train)\n\nprint(\"=== Multiple Linear Regression ===\")\nprint(\"Coefficients:\")\nfor feat, coef in zip(X_multiple.columns, model_multiple.coef_):\n    print(f\"  {feat:12s}: {coef:.4f}\")\nprint(f\"  {'Intercept':12s}: {model_multiple.intercept_:.4f}\")\n\n# Predictions\ny_pred_multiple = model_multiple.predict(X_test_m)\nprint(f\"\\nSample Predictions vs Actual (first 5):\")\nfor i in range(5):\n    print(f\"  Predicted: {y_pred_multiple[i]:.3f}, Actual: {y_test.iloc[i]:.3f}, \"\n          f\"Error: {abs(y_pred_multiple[i] - y_test.iloc[i]):.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "=== Multiple Linear Regression ===\nCoefficients:\n  MedInc      : 0.4476\n  AveRooms    : -0.0094\n  HouseAge    : 0.0095\n  Latitude    : -0.4225\n  Longitude   : -0.4347\n  Intercept   : -36.3511\n\nSample Predictions vs Actual (first 5):\n  Predicted: 1.498, Actual: 0.477, Error: 1.021\n  Predicted: 1.732, Actual: 0.458, Error: 1.274\n  Predicted: 3.696, Actual: 5.000, Error: 1.304\n  Predicted: 2.340, Actual: 2.186, Error: 0.154\n  Predicted: 2.893, Actual: 2.780, Error: 0.113"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.metrics import mean_squared_error, r2_score, mean_absolute_error\n\n# Evaluation metrics\ndef evaluate_model(y_true, y_pred, model_name):\n    rmse = np.sqrt(mean_squared_error(y_true, y_pred))\n    mae = mean_absolute_error(y_true, y_pred)\n    r2 = r2_score(y_true, y_pred)\n    print(f\"\\n{model_name}:\")\n    print(f\"  RMSE: {rmse:.4f} (${rmse * 100000:.0f})\")\n    print(f\"  MAE:  {mae:.4f} (${mae * 100000:.0f})\")\n    print(f\"  R\u00b2:   {r2:.4f}\")\n    return rmse, mae, r2\n\nrmse_s, mae_s, r2_s = evaluate_model(y_test, y_pred_simple, \"Simple Regression (MedInc only)\")\nrmse_m, mae_m, r2_m = evaluate_model(y_test, y_pred_multiple, \"Multiple Regression (5 features)\")\n\nprint(f\"\\n=== Improvement from Simple to Multiple ===\")\nprint(f\"RMSE reduced by: {(rmse_s - rmse_m) / rmse_s * 100:.1f}%\")\nprint(f\"R\u00b2 improved by: {(r2_m - r2_s):.4f} ({(r2_m - r2_s) / r2_s * 100:.1f}%)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Simple Regression (MedInc only):\n  RMSE: 0.8469 ($84690)\n  MAE:  0.6373 ($63730)\n  R\u00b2:   0.4639\n\nMultiple Regression (5 features):\n  RMSE: 0.7396 ($73960)\n  MAE:  0.5500 ($55000)\n  R\u00b2:   0.5912\n\n=== Improvement from Simple to Multiple ===\nRMSE reduced by: 12.7%\nR\u00b2 improved by: 0.1273 (27.4%)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Residual analysis for multiple regression\nresiduals = y_test.values - y_pred_multiple\n\nprint(\"=== Residual Analysis ===\")\nprint(f\"Mean of residuals: {residuals.mean():.6f}\")\nprint(f\"Std of residuals:  {residuals.std():.4f}\")\nprint(f\"Min residual:      {residuals.min():.4f}\")\nprint(f\"Max residual:      {residuals.max():.4f}\")\n\n# Check for patterns: residuals by prediction range\nprint(\"\\nResiduals by Prediction Range:\")\nprint(f\"{'Range':<20} {'Count':<8} {'Mean Residual':<15} {'Std Residual'}\")\nfor low, high in [(0, 1.5), (1.5, 2.5), (2.5, 3.5), (3.5, 5.0)]:\n    mask = (y_pred_multiple >= low) & (y_pred_multiple < high)\n    if mask.sum() > 0:\n        print(f\"  [{low:.1f}, {high:.1f})       {mask.sum():<8} {residuals[mask].mean():<15.4f} {residuals[mask].std():.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "=== Residual Analysis ===\nMean of residuals: -0.000050\nStd of residuals:  0.7396\nMin residual:      -3.7428\nMax residual:      4.6571\n\nResiduals by Prediction Range:\nRange                Count    Mean Residual   Std Residual\n  [0.0, 1.5)       1048     0.1598          0.5161\n  [1.5, 2.5)       1593     -0.0524         0.6213\n  [2.5, 3.5)       1020     -0.0299         0.8172\n  [3.5, 5.0)       467      -0.1310         1.0539"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.preprocessing import StandardScaler\n\n# Standardize features for comparable coefficients\nscaler = StandardScaler()\nX_train_scaled = scaler.fit_transform(X_train_m)\nX_test_scaled = scaler.transform(X_test_m)\n\nmodel_scaled = LinearRegression()\nmodel_scaled.fit(X_train_scaled, y_train)\n\nprint(\"=== Standardized Coefficients (Feature Importance) ===\")\nimportance = sorted(zip(X_multiple.columns, model_scaled.coef_),\n                   key=lambda x: abs(x[1]), reverse=True)\nfor feat, coef in importance:\n    direction = \"+\" if coef > 0 else \"-\"\n    print(f\"  {feat:12s}: {coef:+.4f} [{direction} effect on price]\")"
        ]
      ]
