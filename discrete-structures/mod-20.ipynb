          "python",
          "import heapq\n\ndef prim(adj_weighted, start):\n    \"\"\"\n    Find MST using Prim's algorithm.\n    adj_weighted: {v: [(neighbor, weight), ...]}\n    \"\"\"\n    visited = {start}\n    mst = []\n    total_weight = 0\n    \n    # Priority queue: (weight, from_vertex, to_vertex)\n    heap = [(w, start, u) for u, w in adj_weighted[start]]\n    heapq.heapify(heap)\n    \n    while heap and len(visited) < len(adj_weighted):\n        weight, u, v = heapq.heappop(heap)\n        if v in visited:\n            continue\n        visited.add(v)\n        mst.append((u, v, weight))\n        total_weight += weight\n        for neighbor, w in adj_weighted[v]:\n            if neighbor not in visited:\n                heapq.heappush(heap, (w, v, neighbor))\n    \n    return mst, total_weight\n\nadj_w = {\n    'A': [('B', 4), ('C', 8)],\n    'B': [('A', 4), ('C', 2), ('D', 7)],\n    'C': [('A', 8), ('B', 2), ('D', 1), ('E', 6)],\n    'D': [('B', 7), ('C', 1), ('E', 3)],\n    'E': [('C', 6), ('D', 3)]\n}\n\nmst, weight = prim(adj_w, 'A')\nprint(f\"\\nMinimum Spanning Tree (Prim's):\")\nfor u, v, w in mst:\n    print(f\"  {u} -- {v} (weight {w})\")\nprint(f\"Total weight: {weight}\")"
        ]
