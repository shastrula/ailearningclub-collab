        [
          "python",
          "def is_tree(adj_list):\n    \"\"\"Check if an undirected graph is a tree.\"\"\"\n    n = len(adj_list)\n    \n    # Count edges (each edge counted twice in undirected adjacency list)\n    edge_count = sum(len(neighbors) for neighbors in adj_list.values()) // 2\n    \n    # Must have exactly n-1 edges\n    if edge_count != n - 1:\n        return False, f\"Has {edge_count} edges, need {n-1}\"\n    \n    # Must be connected (BFS from any vertex reaches all)\n    from collections import deque\n    start = next(iter(adj_list))\n    visited = {start}\n    queue = deque([start])\n    while queue:\n        v = queue.popleft()\n        for u in adj_list[v]:\n            if u not in visited:\n                visited.add(u)\n                queue.append(u)\n    \n    if len(visited) == n:\n        return True, \"Connected with n-1 edges\"\n    return False, \"Not connected\"\n\n# Test\ntree = {'A': ['B', 'C'], 'B': ['A', 'D', 'E'], 'C': ['A'], 'D': ['B'], 'E': ['B']}\nnot_tree = {'A': ['B', 'C'], 'B': ['A', 'C'], 'C': ['A', 'B']}  # Has a cycle\n\nresult, reason = is_tree(tree)\nprint(f\"Tree: {result} ({reason})\")\nresult, reason = is_tree(not_tree)\nprint(f\"Triangle: {result} ({reason})\")"
        ]
      ]
    },
