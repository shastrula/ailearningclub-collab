          "python",
          "from collections import deque\n\ndef find_spanning_tree_bfs(adj_list):\n    \"\"\"Find a spanning tree using BFS.\"\"\"\n    start = next(iter(adj_list))\n    visited = {start}\n    queue = deque([start])\n    tree_edges = []\n    \n    while queue:\n        v = queue.popleft()\n        for u in adj_list[v]:\n            if u not in visited:\n                visited.add(u)\n                queue.append(u)\n                tree_edges.append((v, u))\n    \n    return tree_edges\n\ngraph = {\n    'A': ['B', 'C', 'D'],\n    'B': ['A', 'C', 'D'],\n    'C': ['A', 'B', 'D'],\n    'D': ['A', 'B', 'C']\n}\n\nspanning = find_spanning_tree_bfs(graph)\nprint(f\"Graph has {len(graph)} vertices\")\nprint(f\"Spanning tree edges ({len(spanning)}): {spanning}\")"
        ]
