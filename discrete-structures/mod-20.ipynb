          "python",
          "class TreeNode:\n    def __init__(self, value):\n        self.value = value\n        self.children = []\n    \n    def add_child(self, child_node):\n        self.children.append(child_node)\n\ndef tree_height(node):\n    \"\"\"Compute height of a rooted tree.\"\"\"\n    if not node.children:\n        return 0\n    return 1 + max(tree_height(child) for child in node.children)\n\ndef count_leaves(node):\n    \"\"\"Count leaf nodes.\"\"\"\n    if not node.children:\n        return 1\n    return sum(count_leaves(child) for child in node.children)\n\ndef count_nodes(node):\n    \"\"\"Count all nodes.\"\"\"\n    return 1 + sum(count_nodes(child) for child in node.children)\n\n# Build a tree\nroot = TreeNode('CEO')\nvp1 = TreeNode('VP Engineering')\nvp2 = TreeNode('VP Sales')\nroot.add_child(vp1)\nroot.add_child(vp2)\nvp1.add_child(TreeNode('Dev Lead'))\nvp1.add_child(TreeNode('QA Lead'))\nvp2.add_child(TreeNode('Sales Rep 1'))\nvp2.add_child(TreeNode('Sales Rep 2'))\nvp2.add_child(TreeNode('Sales Rep 3'))\n\nprint(f\"Height: {tree_height(root)}\")\nprint(f\"Leaves: {count_leaves(root)}\")\nprint(f\"Total nodes: {count_nodes(root)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
