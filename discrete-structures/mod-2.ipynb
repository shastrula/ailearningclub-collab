        "# Discrete Structures - mod-2\n\n",
        "**Course:** discrete-structures\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Propositional logic in Python\n\ndef implies(p, q):\n    \"\"\"Logical implication: p -> q\"\"\"\n    return (not p) or q\n\ndef biconditional(p, q):\n    \"\"\"Logical biconditional: p <-> q\"\"\"\n    return p == q\n\ndef xor(p, q):\n    \"\"\"Exclusive or: p XOR q\"\"\"\n    return p != q\n\n# Demonstrate all connectives\nprint(\"p | q | ~p | p^q | pvq | p->q | p<->q | XOR\")\nprint(\"-\" * 50)\nfor p in [True, False]:\n    for q in [True, False]:\n        neg_p = not p\n        conj = p and q\n        disj = p or q\n        impl = implies(p, q)\n        bicon = biconditional(p, q)\n        ex_or = xor(p, q)\n        print(f\"{int(p)} | {int(q)} |  {int(neg_p)} |  {int(conj)}  |  {int(disj)}  |  {int(impl)}  |   {int(bicon)}   |  {int(ex_or)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Translating a real-world statement to logic\n# \"You can ride the roller coaster if you are at least 48 inches tall\n#  and you are not afraid of heights\"\n\ndef can_ride(height_inches, afraid_of_heights):\n    \"\"\"\n    p: height >= 48\n    q: afraid of heights\n    Ride condition: p AND (NOT q)\n    \"\"\"\n    p = height_inches >= 48\n    q = afraid_of_heights\n    return p and (not q)\n\n# Test cases\nprint(can_ride(50, False))  # True: tall enough, not afraid\nprint(can_ride(50, True))   # False: tall enough, but afraid\nprint(can_ride(45, False))  # False: not tall enough\nprint(can_ride(45, True))   # False: neither condition met"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Bitwise operations correspond to logical connectives\na = 0b11001010  # 202 in decimal\nb = 0b10101100  # 172 in decimal\n\nprint(f\"a     = {a:08b}\")\nprint(f\"b     = {b:08b}\")\nprint(f\"a & b = {a & b:08b}\")   # Bitwise AND\nprint(f\"a | b = {a | b:08b}\")   # Bitwise OR\nprint(f\"a ^ b = {a ^ b:08b}\")   # Bitwise XOR\nprint(f\"~a    = {~a & 0xFF:08b}\")  # Bitwise NOT (8-bit)"
        ]
      ]
    }
