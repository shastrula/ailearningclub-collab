      "source": [
        "# Discrete Structures - mod-10\n\n",
        "**Course:** discrete-structures\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def is_equivalence_relation(relation, elements):\n    \"\"\"Check if a relation is an equivalence relation.\"\"\"\n    A = elements\n    reflexive = all((a, a) in relation for a in A)\n    symmetric = all((b, a) in relation for (a, b) in relation)\n    transitive = all(\n        (a, c) in relation\n        for (a, b) in relation\n        for (b2, c) in relation\n        if b == b2\n    )\n    return reflexive and symmetric and transitive\n\n# Congruence mod 3 on {0, 1, ..., 8}\nA = set(range(9))\nmod3 = {(a, b) for a in A for b in A if (a - b) % 3 == 0}\nprint(f\"Congruence mod 3 is equivalence relation: {is_equivalence_relation(mod3, A)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def get_equivalence_classes(relation, elements):\n    \"\"\"Find all equivalence classes.\"\"\"\n    A = sorted(elements)\n    classes = []\n    classified = set()\n    \n    for a in A:\n        if a not in classified:\n            eq_class = frozenset(b for b in A if (a, b) in relation)\n            classes.append(eq_class)\n            classified.update(eq_class)\n    \n    return classes\n\n# Equivalence classes of congruence mod 3\nA = set(range(12))\nmod3 = {(a, b) for a in A for b in A if (a - b) % 3 == 0}\nclasses = get_equivalence_classes(mod3, A)\n\nprint(\"Equivalence classes of congruence mod 3 on {0,...,11}:\")\nfor i, cls in enumerate(classes):\n    print(f\"  Class {i}: {sorted(cls)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def partition_to_relation(partition, elements):\n    \"\"\"Convert a partition to its induced equivalence relation.\"\"\"\n    relation = set()\n    for block in partition:\n        for a in block:\n            for b in block:\n                relation.add((a, b))\n    return relation\n\n# Start with a partition\npartition = [{0, 3, 6, 9}, {1, 4, 7, 10}, {2, 5, 8, 11}]\nA = set(range(12))\n\n# Convert to relation\nrelation = partition_to_relation(partition, A)\nprint(f\"Partition induces equivalence relation: {is_equivalence_relation(relation, A)}\")\n\n# Convert back to classes\nclasses = get_equivalence_classes(relation, A)\nprint(\"Recovered classes:\")\nfor cls in classes:\n    print(f\"  {sorted(cls)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def is_partial_order(relation, elements):\n    \"\"\"Check if a relation is a partial order.\"\"\"\n    A = elements\n    reflexive = all((a, a) in relation for a in A)\n    antisymmetric = all(\n        a == b\n        for (a, b) in relation\n        if (b, a) in relation\n    )\n    transitive = all(\n        (a, c) in relation\n        for (a, b) in relation\n        for (b2, c) in relation\n        if b == b2\n    )\n    return reflexive and antisymmetric and transitive\n\n# Divisibility on {1, 2, 3, 4, 6, 12}\nA = {1, 2, 3, 4, 6, 12}\ndivides = {(a, b) for a in A for b in A if b % a == 0}\nprint(f\"Divisibility is a partial order: {is_partial_order(divides, A)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Show incomparable elements in subset ordering\nS = {1, 2, 3}\npower = [frozenset(s) for s in [set(), {1}, {2}, {3}, {1,2}, {1,3}, {2,3}, {1,2,3}]]\n\n# Find incomparable pairs\nincomparable = []\nfor i, a in enumerate(power):\n    for b in power[i+1:]:\n        if not (a <= b) and not (b <= a):\n            incomparable.append((set(a), set(b)))\n\nprint(f\"Incomparable pairs in P({{1,2,3}}):\")\nfor a, b in incomparable[:6]:\n    print(f\"  {a if a else '{}'} and {b if b else '{}'}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def hasse_edges(relation, elements):\n    \"\"\"Find the covering relation (edges of the Hasse diagram).\"\"\"\n    A = sorted(elements)\n    covers = set()\n    \n    # (a,b) is a cover if a < b and no c exists with a < c < b\n    for a in A:\n        for b in A:\n            if (a, b) in relation and a != b:\n                # Check if any c is between a and b\n                has_between = any(\n                    (a, c) in relation and (c, b) in relation and c != a and c != b\n                    for c in A\n                )\n                if not has_between:\n                    covers.add((a, b))\n    return covers\n\nA = {1, 2, 3, 4, 6, 12}\ndivides = {(a, b) for a in A for b in A if b % a == 0}\ncovers = hasse_edges(divides, A)\n\nprint(\"Hasse diagram edges for divisibility on {1,2,3,4,6,12}:\")\nfor (a, b) in sorted(covers):\n    print(f\"  {a} -> {b}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
