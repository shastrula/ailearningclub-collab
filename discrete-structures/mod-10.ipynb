      "source": [
        [
          "python",
          "def find_extremal(relation, elements):\n    \"\"\"Find extremal elements of a poset.\"\"\"\n    A = elements\n    \n    maximum = [a for a in A if all((b, a) in relation for b in A)]\n    minimum = [a for a in A if all((a, b) in relation for b in A)]\n    maximal = [a for a in A if not any((a, b) in relation and a != b for b in A)]\n    minimal = [a for a in A if not any((b, a) in relation and b != a for b in A)]\n    \n    return {\n        'maximum': maximum,\n        'minimum': minimum,\n        'maximal': maximal,\n        'minimal': minimal\n    }\n\nA = {1, 2, 3, 4, 6, 12}\ndivides = {(a, b) for a in A for b in A if b % a == 0}\nextremal = find_extremal(divides, A)\n\nprint(\"Extremal elements for (A, divides):\")\nfor kind, elems in extremal.items():\n    print(f\"  {kind}: {elems}\")"
        ]
      ]
    }
