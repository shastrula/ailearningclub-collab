      "source": [
        "# Discrete Structures - mod-4\n\n",
        "**Course:** discrete-structures\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Predicates as Python functions\ndef P(x):\n    \"\"\"P(x): x is a prime number\"\"\"\n    if x < 2:\n        return False\n    for i in range(2, int(x**0.5) + 1):\n        if x % i == 0:\n            return False\n    return True\n\ndef Q(x, y):\n    \"\"\"Q(x, y): x divides y evenly\"\"\"\n    return y % x == 0\n\n# Evaluate predicates\nprint(f\"P(7) = {P(7)}\")     # True (7 is prime)\nprint(f\"P(10) = {P(10)}\")   # False (10 is not prime)\nprint(f\"Q(3, 12) = {Q(3, 12)}\")  # True (3 divides 12)\nprint(f\"Q(5, 12) = {Q(5, 12)}\")  # False (5 does not divide 12)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def for_all(predicate, domain):\n    \"\"\"Check if predicate holds for all elements in domain.\"\"\"\n    for x in domain:\n        if not predicate(x):\n            return False, x  # Return counterexample\n    return True, None\n\n# forall x in {1,...,100}, x^2 >= x\ndomain = range(1, 101)\nresult, counter = for_all(lambda x: x**2 >= x, domain)\nprint(f\"forall x in [1,100], x^2 >= x: {result}\")  # True\n\n# forall x in {-10,...,10}, x^2 > x\ndomain = range(-10, 11)\nresult, counter = for_all(lambda x: x**2 > x, domain)\nprint(f\"forall x in [-10,10], x^2 > x: {result}, counterexample: {counter}\")\n# False, counterexample: 0 (since 0^2 = 0, not > 0)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def there_exists(predicate, domain):\n    \"\"\"Check if predicate holds for at least one element in domain.\"\"\"\n    for x in domain:\n        if predicate(x):\n            return True, x  # Return witness\n    return False, None\n\n# exists x in {1,...,1000}, x is prime and x > 900\ndomain = range(1, 1001)\nresult, witness = there_exists(lambda x: P(x) and x > 900, domain)\nprint(f\"exists prime > 900 in [1,1000]: {result}, witness: {witness}\")\n# True, witness: 907"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Demonstrate that quantifier order matters\ndomain = range(-5, 6)\n\n# forall x, exists y such that x + y = 0\ndef check_forall_exists():\n    for x in domain:\n        found = False\n        for y in domain:\n            if x + y == 0:\n                found = True\n                break\n        if not found:\n            return False\n    return True\n\n# exists y such that forall x, x + y = 0\ndef check_exists_forall():\n    for y in domain:\n        all_true = True\n        for x in domain:\n            if x + y != 0:\n                all_true = False\n                break\n        if all_true:\n            return True\n    return False\n\nprint(f\"forall x, exists y, x+y=0: {check_forall_exists()}\")  # True\nprint(f\"exists y, forall x, x+y=0: {check_exists_forall()}\")  # False"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def exists_unique(predicate, domain):\n    \"\"\"Check if exactly one element satisfies the predicate.\"\"\"\n    witnesses = [x for x in domain if predicate(x)]\n    return len(witnesses) == 1, witnesses\n\n# exists unique x in [1,20] such that x^2 = 16 and x > 0\ndomain = range(1, 21)\nresult, witnesses = exists_unique(lambda x: x**2 == 16, domain)\nprint(f\"Unique x in [1,20] with x^2=16: {result}, found: {witnesses}\")\n# True, found: [4]"
        ]
      ]
    }
