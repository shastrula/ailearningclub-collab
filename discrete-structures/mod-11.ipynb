      "source": [
        "# Discrete Structures - mod-11\n\n",
        "**Course:** discrete-structures\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Functions as dictionaries\nf = {1: 'a', 2: 'b', 3: 'c', 4: 'a'}\ndomain = {1, 2, 3, 4}\ncodomain = {'a', 'b', 'c', 'd'}\nrange_f = set(f.values())\n\nprint(f\"f = {f}\")\nprint(f\"Domain = {domain}\")\nprint(f\"Codomain = {codomain}\")\nprint(f\"Range = {range_f}\")\nprint(f\"Range == Codomain? {range_f == codomain}\")  # False ('d' not hit)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def is_injective(f, domain):\n    \"\"\"Check if function f is injective.\"\"\"\n    seen_outputs = set()\n    for x in domain:\n        y = f(x)\n        if y in seen_outputs:\n            return False\n        seen_outputs.add(y)\n    return True\n\n# f(x) = 2x is injective\nprint(f\"f(x)=2x injective: {is_injective(lambda x: 2*x, range(-10, 11))}\")\n\n# f(x) = x^2 on all integers is NOT injective\nprint(f\"f(x)=x^2 on Z injective: {is_injective(lambda x: x**2, range(-10, 11))}\")\n\n# f(x) = x^2 on non-negative integers IS injective\nprint(f\"f(x)=x^2 on N injective: {is_injective(lambda x: x**2, range(0, 11))}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def is_surjective(f, domain, codomain):\n    \"\"\"Check if function f is surjective onto codomain.\"\"\"\n    range_f = {f(x) for x in domain}\n    return codomain.issubset(range_f)\n\n# f(x) = x mod 3, domain = {0,...,9}, codomain = {0, 1, 2}\ndomain = set(range(10))\ncodomain = {0, 1, 2}\nprint(f\"f(x)=x%3 surjective onto {{0,1,2}}: {is_surjective(lambda x: x%3, domain, codomain)}\")\n\n# f(x) = x^2, domain = {-3,...,3}, codomain = {0,1,...,9}\ncodomain2 = set(range(10))\nprint(f\"f(x)=x^2 surjective onto {{0..9}}: {is_surjective(lambda x: x**2, range(-3,4), codomain2)}\")\n# False: 2, 3, 5, 6, 7, 8 are not hit"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def is_bijective(f, domain, codomain):\n    \"\"\"Check if f is a bijection from domain to codomain.\"\"\"\n    return is_injective(f, domain) and is_surjective(f, domain, codomain)\n\n# f: {0,1,2,3} -> {0,1,2,3} defined by f(x) = (x + 1) % 4\ndomain = {0, 1, 2, 3}\ncodomain = {0, 1, 2, 3}\nf = lambda x: (x + 1) % 4\nprint(f\"f(x)=(x+1)%4 is bijection: {is_bijective(f, domain, codomain)}\")\n# True: it's a rotation\n\n# Caesar cipher is a bijection on the alphabet\ndef caesar(c, shift=3):\n    if 'a' <= c <= 'z':\n        return chr((ord(c) - ord('a') + shift) % 26 + ord('a'))\n    return c\n\nalphabet = set('abcdefghijklmnopqrstuvwxyz')\nprint(f\"Caesar cipher is bijection: {is_bijective(lambda c: caesar(c), alphabet, alphabet)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Function composition\ndef compose(g, f):\n    \"\"\"Return the composition g(f(x)).\"\"\"\n    return lambda x: g(f(x))\n\nf = lambda x: x + 1      # f(x) = x + 1\ng = lambda x: x * 2      # g(x) = 2x\n\ngf = compose(g, f)       # g(f(x)) = 2(x+1)\nfg = compose(f, g)       # f(g(x)) = 2x + 1\n\nprint(f\"g(f(3)) = g(4) = {gf(3)}\")   # 8\nprint(f\"f(g(3)) = f(6) = {fg(3)}\")   # 7\nprint(f\"Composition is NOT commutative: g(f(3)) != f(g(3))\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def find_inverse(f, domain, codomain):\n    \"\"\"Find the inverse function if f is bijective.\"\"\"\n    # Build the mapping\n    mapping = {x: f(x) for x in domain}\n    \n    # Check bijective\n    range_f = set(mapping.values())\n    if len(mapping) != len(range_f) or range_f != codomain:\n        return None  # Not bijective\n    \n    # Invert\n    inverse = {v: k for k, v in mapping.items()}\n    return inverse\n\n# Inverse of f(x) = 2x + 1 on {0,1,2,3,4}\ndomain = {0, 1, 2, 3, 4}\nf = lambda x: 2 * x + 1\ncodomain = {f(x) for x in domain}  # {1, 3, 5, 7, 9}\n\ninv = find_inverse(f, domain, codomain)\nprint(f\"f = {{x: 2x+1 for x in {sorted(domain)}}}\")\nprint(f\"f inverse = {inv}\")\n\n# Verify: f_inv(f(x)) = x\nfor x in domain:\n    assert inv[f(x)] == x\nprint(\"Verified: f_inv(f(x)) = x for all x in domain\")"
        ]
      ]
    },
    {
