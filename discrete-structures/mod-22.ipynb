      "source": [
        [
          "python",
          "def is_valid_coloring(adj_list, coloring):\n    \"\"\"Check if a vertex coloring is proper (no adjacent same-color).\"\"\"\n    for v in adj_list:\n        for u in adj_list[v]:\n            if coloring.get(v) == coloring.get(u):\n                return False\n    return True\n\ndef greedy_coloring(adj_list, vertex_order=None):\n    \"\"\"\n    Color a graph using greedy algorithm.\n    Returns coloring dict and number of colors used.\n    \"\"\"\n    if vertex_order is None:\n        vertex_order = list(adj_list.keys())\n    \n    coloring = {}\n    \n    for v in vertex_order:\n        # Find colors used by neighbors\n        neighbor_colors = {coloring[u] for u in adj_list[v] if u in coloring}\n        \n        # Assign the smallest available color\n        color = 0\n        while color in neighbor_colors:\n            color += 1\n        coloring[v] = color\n    \n    num_colors = max(coloring.values()) + 1\n    return coloring, num_colors\n\n# Example: Petersen-like graph\ngraph = {\n    'A': ['B', 'E', 'F'],\n    'B': ['A', 'C', 'G'],\n    'C': ['B', 'D', 'H'],\n    'D': ['C', 'E', 'I'],\n    'E': ['D', 'A', 'J'],\n    'F': ['A', 'H', 'I'],\n    'G': ['B', 'I', 'J'],\n    'H': ['C', 'F', 'J'],\n    'I': ['D', 'F', 'G'],\n    'J': ['E', 'G', 'H']\n}\n\ncoloring, num_colors = greedy_coloring(graph)\nprint(f\"Greedy coloring used {num_colors} colors:\")\nfor v in sorted(coloring.keys()):\n    print(f\"  {v}: color {coloring[v]}\")\nprint(f\"Valid coloring: {is_valid_coloring(graph, coloring)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def analyze_chromatic_bounds(adj_list):\n    \"\"\"Compute bounds on the chromatic number.\"\"\"\n    degrees = {v: len(adj_list[v]) for v in adj_list}\n    max_deg = max(degrees.values())\n    n = len(adj_list)\n    \n    # Greedy upper bound\n    _, greedy_colors = greedy_coloring(adj_list)\n    \n    # Try all vertex orderings for better greedy result (just a few)\n    import random\n    best_greedy = greedy_colors\n    vertices = list(adj_list.keys())\n    for _ in range(100):\n        random.shuffle(vertices)\n        _, nc = greedy_coloring(adj_list, vertices)\n        best_greedy = min(best_greedy, nc)\n    \n    print(f\"  Vertices: {n}\")\n    print(f\"  Max degree: {max_deg}\")\n    print(f\"  Upper bound (max_deg + 1): {max_deg + 1}\")\n    print(f\"  Greedy coloring (best of 100): {best_greedy}\")\n    \n    return best_greedy\n\nprint(\"Chromatic number analysis:\")\nanalyze_chromatic_bounds(graph)"
        ]
      ]
    },
