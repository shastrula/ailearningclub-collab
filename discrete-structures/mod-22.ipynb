          "python",
          "# Scheduling example: exam scheduling\n# Each course is a vertex; edge if they share students\nexam_conflicts = {\n    'Math': ['Physics', 'CS'],\n    'Physics': ['Math', 'Chemistry', 'CS'],\n    'CS': ['Math', 'Physics', 'English'],\n    'Chemistry': ['Physics', 'Biology'],\n    'Biology': ['Chemistry'],\n    'English': ['CS', 'History'],\n    'History': ['English']\n}\n\ncoloring, num_slots = greedy_coloring(exam_conflicts)\nprint(f\"\\nExam scheduling ({num_slots} time slots needed):\")\nslots = {}\nfor course, slot in coloring.items():\n    if slot not in slots:\n        slots[slot] = []\n    slots[slot].append(course)\n\nfor slot in sorted(slots.keys()):\n    print(f\"  Slot {slot + 1}: {', '.join(sorted(slots[slot]))}\")"
        ]
      ]
