        [
          "python",
          "# Demonstrate: a planar graph (map) colored with 4 colors\n# US states map (simplified) - states sharing a border are adjacent\nus_map = {\n    'WA': ['OR', 'ID'],\n    'OR': ['WA', 'ID', 'CA', 'NV'],\n    'CA': ['OR', 'NV', 'AZ'],\n    'ID': ['WA', 'OR', 'NV', 'UT', 'MT', 'WY'],\n    'NV': ['OR', 'CA', 'AZ', 'UT', 'ID'],\n    'AZ': ['CA', 'NV', 'UT', 'NM'],\n    'UT': ['ID', 'NV', 'AZ', 'CO', 'WY'],\n    'MT': ['ID', 'WY', 'ND', 'SD'],\n    'WY': ['MT', 'ID', 'UT', 'CO', 'NE', 'SD'],\n    'CO': ['WY', 'UT', 'NM', 'KS', 'NE'],\n    'NM': ['AZ', 'CO', 'TX', 'OK'],\n    'ND': ['MT', 'SD', 'MN'],\n    'SD': ['ND', 'MT', 'WY', 'NE', 'MN', 'IA'],\n    'NE': ['SD', 'WY', 'CO', 'KS', 'IA', 'MO'],\n    'KS': ['NE', 'CO', 'OK', 'MO'],\n    'OK': ['KS', 'CO', 'NM', 'TX', 'MO', 'AR'],\n    'TX': ['NM', 'OK', 'AR', 'LA'],\n    'MN': ['ND', 'SD', 'IA', 'WI'],\n    'IA': ['MN', 'SD', 'NE', 'MO', 'WI', 'IL'],\n    'MO': ['IA', 'NE', 'KS', 'OK', 'AR', 'IL', 'KY', 'TN'],\n    'AR': ['MO', 'OK', 'TX', 'LA', 'MS', 'TN'],\n    'LA': ['TX', 'AR', 'MS'],\n    'WI': ['MN', 'IA', 'IL', 'MI'],\n    'IL': ['WI', 'IA', 'MO', 'KY', 'IN'],\n    'MI': ['WI', 'IN', 'OH'],\n    'IN': ['MI', 'IL', 'KY', 'OH'],\n    'OH': ['MI', 'IN', 'KY', 'WV', 'PA'],\n    'KY': ['OH', 'IN', 'IL', 'MO', 'TN', 'WV', 'VA'],\n    'TN': ['KY', 'MO', 'AR', 'MS', 'AL', 'GA', 'NC', 'VA'],\n    'MS': ['TN', 'AR', 'LA', 'AL'],\n    'AL': ['TN', 'MS', 'GA', 'FL'],\n    'GA': ['TN', 'AL', 'FL', 'SC', 'NC'],\n    'FL': ['AL', 'GA'],\n    'WV': ['OH', 'KY', 'VA', 'PA', 'MD'],\n    'VA': ['WV', 'KY', 'TN', 'NC', 'MD'],\n    'NC': ['VA', 'TN', 'GA', 'SC'],\n    'SC': ['NC', 'GA'],\n    'PA': ['OH', 'WV', 'MD', 'NJ', 'NY'],\n    'MD': ['PA', 'WV', 'VA'],\n    'NJ': ['PA', 'NY'],\n    'NY': ['PA', 'NJ', 'VT', 'MA', 'CT'],\n    'VT': ['NY', 'MA', 'NH'],\n    'NH': ['VT', 'MA', 'ME'],\n    'ME': ['NH'],\n    'MA': ['NY', 'VT', 'NH', 'CT', 'RI'],\n    'CT': ['NY', 'MA', 'RI'],\n    'RI': ['MA', 'CT']\n}\n\ncoloring, num_colors = greedy_coloring(us_map)\nprint(f\"US map colored with {num_colors} colors\")\nprint(f\"Valid coloring: {is_valid_coloring(us_map, coloring)}\")\n\n# Count states per color\nfrom collections import Counter\ncolor_counts = Counter(coloring.values())\nfor color, count in sorted(color_counts.items()):\n    print(f\"  Color {color}: {count} states\")"
