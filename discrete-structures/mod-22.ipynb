          "python",
          "# Euler's formula verification for known planar graphs\ndef verify_euler_formula(name, V, E, F):\n    \"\"\"Verify V - E + F = 2 for a planar graph.\"\"\"\n    result = V - E + F\n    print(f\"  {name}: V={V}, E={E}, F={F}, V-E+F={result} {'(valid)' if result == 2 else '(ERROR)'}\")\n\nprint(\"Euler's formula V - E + F = 2:\")\nverify_euler_formula(\"Tetrahedron (K4)\", 4, 6, 4)\nverify_euler_formula(\"Cube\", 8, 12, 6)\nverify_euler_formula(\"Octahedron\", 6, 12, 8)\nverify_euler_formula(\"Single triangle\", 3, 3, 2)\nverify_euler_formula(\"Tree (5 nodes)\", 5, 4, 1)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def check_planarity_necessary(n_vertices, n_edges, has_triangles=True):\n    \"\"\"Check necessary conditions for planarity.\"\"\"\n    if n_vertices < 3:\n        return True, \"Too small to test\"\n    \n    if has_triangles:\n        max_edges = 3 * n_vertices - 6\n    else:\n        max_edges = 2 * n_vertices - 4\n    \n    if n_edges > max_edges:\n        return False, f\"E={n_edges} > {max_edges} (max for {'general' if has_triangles else 'triangle-free'} planar)\"\n    return True, f\"E={n_edges} <= {max_edges} (necessary condition met)\"\n\n# Test some graphs\nprint(\"\\nPlanarity necessary conditions:\")\nprint(f\"  K5: {check_planarity_necessary(5, 10)}\")\nprint(f\"  K4: {check_planarity_necessary(4, 6)}\")\nprint(f\"  K3,3: {check_planarity_necessary(6, 9, has_triangles=False)}\")\nprint(f\"  K2,3: {check_planarity_necessary(5, 6, has_triangles=False)}\")"
        ]
      ]
    },
