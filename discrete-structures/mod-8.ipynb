          "python",
          "# Demonstrate the bijection between subsets and binary strings\nS = ['a', 'b', 'c', 'd']\nn = len(S)\n\nprint(f\"{'Binary':<8} {'Subset'}\")\nprint(\"-\" * 30)\nfor i in range(2**n):\n    binary = f\"{i:0{n}b}\"\n    subset = {S[j] for j in range(n) if (i >> j) & 1}\n    print(f\"{binary:<8} {subset if subset else '{}'}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def subset_sum(numbers, target):\n    \"\"\"Find a subset of numbers that sums to target (brute force).\"\"\"\n    n = len(numbers)\n    for i in range(2**n):\n        subset = [numbers[j] for j in range(n) if (i >> j) & 1]\n        if sum(subset) == target:\n            return subset\n    return None\n\nnumbers = [3, 7, 1, 8, 4]\ntarget = 12\nresult = subset_sum(numbers, target)\nprint(f\"Numbers: {numbers}, Target: {target}\")\nprint(f\"Subset summing to {target}: {result}\")\nprint(f\"Verification: sum = {sum(result)}\")"
        ]
      ]
    }
