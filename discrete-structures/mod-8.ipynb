    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Verifying set identities computationally\nU = set(range(1, 21))  # Universal set {1, ..., 20}\nA = {1, 2, 3, 4, 5, 6, 7}\nB = {5, 6, 7, 8, 9, 10}\nC = {3, 6, 9, 12, 15, 18}\n\ndef complement(S):\n    return U - S\n\n# Distributive law: A union (B inter C) = (A union B) inter (A union C)\nlhs = A | (B & C)\nrhs = (A | B) & (A | C)\nprint(f\"Distributive: A|(B&C) == (A|B)&(A|C): {lhs == rhs}\")\n\n# De Morgan's: complement(A union B) = complement(A) inter complement(B)\nlhs = complement(A | B)\nrhs = complement(A) & complement(B)\nprint(f\"De Morgan 1: ~(A|B) == ~A & ~B: {lhs == rhs}\")\n\n# De Morgan's: complement(A inter B) = complement(A) union complement(B)\nlhs = complement(A & B)\nrhs = complement(A) | complement(B)\nprint(f\"De Morgan 2: ~(A&B) == ~A | ~B: {lhs == rhs}\")\n\n# Absorption: A union (A inter B) = A\nprint(f\"Absorption 1: A|(A&B) == A: {A | (A & B) == A}\")\nprint(f\"Absorption 2: A&(A|B) == A: {A & (A | B) == A}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Verify: A - B = A intersection complement(B)\nA = {1, 2, 3, 4, 5}\nB = {3, 4, 5, 6, 7}\nU = set(range(1, 11))\n\nmethod1 = A - B\nmethod2 = A & (U - B)\nprint(f\"A - B = {method1}\")\nprint(f\"A & ~B = {method2}\")\nprint(f\"Equal: {method1 == method2}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def power_set(s):\n    \"\"\"Generate the power set of s.\"\"\"\n    s = list(s)\n    n = len(s)\n    result = []\n    for i in range(2**n):\n        subset = set()\n        for j in range(n):\n            if i & (1 << j):\n                subset.add(s[j])\n        result.append(frozenset(subset))\n    return result\n\n# Power set of {1, 2, 3}\nS = {1, 2, 3}\nps = power_set(S)\nprint(f\"S = {S}\")\nprint(f\"|P(S)| = {len(ps)} (expected {2**len(S)})\")\nprint(\"P(S) =\")\nfor subset in sorted(ps, key=lambda x: (len(x), sorted(x))):\n    print(f\"  {set(subset) if subset else '{}'}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
