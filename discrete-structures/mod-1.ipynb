      "source": [
        [
          "python",
          "# Exploring discrete vs continuous in Python\nimport math\n\n# Discrete: counting divisors of a number\ndef count_divisors(n):\n    \"\"\"Count the number of positive divisors of n.\"\"\"\n    count = 0\n    for i in range(1, n + 1):\n        if n % i == 0:\n            count += 1\n    return count\n\n# Example: divisors of 12\nn = 12\nprint(f\"Number of divisors of {n}: {count_divisors(n)}\")\n# Output: Number of divisors of 12: 6\n# The divisors are: 1, 2, 3, 4, 6, 12\n\n# Python supports arbitrary precision integers (discrete!)\nlarge_number = 2**100\nprint(f\"2^100 = {large_number}\")\n# No overflow, exact discrete value\n\n# Sets in Python mirror mathematical sets\nA = {1, 2, 3, 4, 5}\nB = {4, 5, 6, 7, 8}\nprint(f\"A union B = {A | B}\")\nprint(f\"A intersection B = {A & B}\")\nprint(f\"A difference B = {A - B}\")\nprint(f\"A symmetric difference B = {A ^ B}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Verifying a simple theorem: the sum of first n natural numbers\ndef sum_formula(n):\n    \"\"\"Sum of 1 + 2 + ... + n using the formula n(n+1)/2\"\"\"\n    return n * (n + 1) // 2\n\ndef sum_direct(n):\n    \"\"\"Sum of 1 + 2 + ... + n by direct computation\"\"\"\n    return sum(range(1, n + 1))\n\n# Verify for several values\nfor n in [1, 5, 10, 100, 1000]:\n    assert sum_formula(n) == sum_direct(n)\n    print(f\"Sum(1..{n}) = {sum_formula(n)}\")"
        ]
      ]
    }
