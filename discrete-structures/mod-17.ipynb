          "python",
          "# Using generating functions conceptually:\n# The generating function for geometric series a_n = r^n is 1/(1-rx)\n# We can verify by partial sums\n\ndef partial_generating_sum(seq, x, terms):\n    \"\"\"Compute partial sum of generating function.\"\"\"\n    return sum(a * x**n for n, a in enumerate(seq[:terms]))\n\n# For geometric sequence a_n = 2^n, G(x) = 1/(1-2x)\nseq = [2**n for n in range(20)]\nx = 0.1\npartial = partial_generating_sum(seq, x, 20)\nexact = 1 / (1 - 2*x)\nprint(f\"Geometric G(0.1): partial sum = {partial:.6f}, 1/(1-2x) = {exact:.6f}\")"
        ]
      ]
