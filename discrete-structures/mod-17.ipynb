        [
          "python",
          "# Binet's formula for Fibonacci numbers\nphi = (1 + math.sqrt(5)) / 2  # Golden ratio\npsi = (1 - math.sqrt(5)) / 2\n\ndef fibonacci_binet(n):\n    \"\"\"Compute F_n using Binet's formula.\"\"\"\n    return round((phi**n - psi**n) / math.sqrt(5))\n\n# Verify\nprint(\"Binet's formula verification:\")\nfib_iter = [0, 1]\nfor i in range(2, 20):\n    fib_iter.append(fib_iter[-1] + fib_iter[-2])\n\nfor n in range(20):\n    binet = fibonacci_binet(n)\n    assert binet == fib_iter[n], f\"Mismatch at n={n}\"\nprint(f\"  Verified for n=0..19\")\nprint(f\"  Golden ratio phi = {phi:.10f}\")\nprint(f\"  F_n ~ phi^n / sqrt(5) for large n\")\nprint(f\"  F_20 = {fibonacci_binet(20)}, phi^20/sqrt(5) = {phi**20/math.sqrt(5):.2f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Example: a_n = 2*a_{n-1} + 3, a_0 = 1\n# Homogeneous: a_n = 2*a_{n-1} -> solution: C * 2^n\n# Particular: try a_n = A (constant)\n#   A = 2A + 3 -> A = -3\n# General: a_n = C * 2^n - 3\n# Initial: a_0 = C - 3 = 1 -> C = 4\n# Solution: a_n = 4 * 2^n - 3 = 2^{n+2} - 3\n\ndef example_recurrence(n):\n    \"\"\"Iterative computation of a_n = 2*a_{n-1} + 3, a_0 = 1.\"\"\"\n    a = 1\n    for _ in range(n):\n        a = 2 * a + 3\n    return a\n\ndef example_closed(n):\n    \"\"\"Closed form: a_n = 2^{n+2} - 3.\"\"\"\n    return 2**(n+2) - 3\n\nprint(\"a_n = 2*a_{n-1} + 3, a_0 = 1:\")\nprint(\"Closed form: a_n = 2^(n+2) - 3\")\nfor n in range(10):\n    assert example_recurrence(n) == example_closed(n)\n    print(f\"  a_{n} = {example_closed(n)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Master Theorem examples\ndef master_theorem(a, b, d):\n    \"\"\"Apply the Master Theorem to T(n) = aT(n/b) + O(n^d).\"\"\"\n    log_b_a = math.log(a) / math.log(b)\n    \n    if abs(d - log_b_a) < 0.001:\n        return f\"O(n^{d} * log n)\", \"Case 2: d = log_b(a)\"\n    elif d > log_b_a:\n        return f\"O(n^{d})\", \"Case 1: d > log_b(a)\"\n    else:\n        return f\"O(n^{log_b_a:.4f})\", \"Case 3: d < log_b(a)\"\n\n# Common algorithms\nalgorithms = [\n    (\"Binary Search\", 1, 2, 0),      # T(n) = T(n/2) + O(1)\n    (\"Merge Sort\", 2, 2, 1),          # T(n) = 2T(n/2) + O(n)\n    (\"Karatsuba\", 3, 2, 1),           # T(n) = 3T(n/2) + O(n)\n    (\"Strassen\", 7, 2, 2),            # T(n) = 7T(n/2) + O(n^2)\n    (\"Naive multiply\", 4, 2, 1),      # T(n) = 4T(n/2) + O(n)\n]\n\nprint(\"Master Theorem Applications:\")\nprint(f\"{'Algorithm':<20} {'Recurrence':<25} {'Complexity':<20} {'Case'}\")\nprint(\"-\" * 85)\nfor name, a, b, d in algorithms:\n    complexity, case = master_theorem(a, b, d)\n    rec = f\"T(n) = {a}T(n/{b}) + O(n^{d})\"\n    print(f\"{name:<20} {rec:<25} {complexity:<20} {case}\")"
        ]
      ]
    },
