      "source": [
        [
          "python",
          "# First-order recurrence solutions\ndef first_order_homogeneous(a0, c, n):\n    \"\"\"Solve a_n = c * a_{n-1}, a_0 = a0.\"\"\"\n    return a0 * c**n\n\n# Tower of Hanoi: a_n = 2*a_{n-1} + 1, a_0 = 0\n# Solution: a_n = 2^n - 1\ndef hanoi_closed(n):\n    return 2**n - 1\n\n# Verify\nfor n in range(10):\n    iterative = 0\n    for _ in range(n):\n        iterative = 2 * iterative + 1\n    closed = hanoi_closed(n)\n    assert iterative == closed\nprint(\"Hanoi closed form verified: T(n) = 2^n - 1\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import math\n\ndef solve_second_order(c1, c2, a0, a1):\n    \"\"\"\n    Solve a_n = c1*a_{n-1} + c2*a_{n-2} with a(0)=a0, a(1)=a1.\n    Returns a function that computes a_n.\n    \"\"\"\n    # Characteristic equation: r^2 - c1*r - c2 = 0\n    discriminant = c1**2 + 4*c2\n    \n    if discriminant > 0:\n        # Two distinct real roots\n        r1 = (c1 + math.sqrt(discriminant)) / 2\n        r2 = (c1 - math.sqrt(discriminant)) / 2\n        # Solve: A*r1^0 + B*r2^0 = a0, A*r1^1 + B*r2^1 = a1\n        # A + B = a0, A*r1 + B*r2 = a1\n        B = (a1 - a0 * r1) / (r2 - r1)\n        A = a0 - B\n        return lambda n: A * r1**n + B * r2**n, f\"a_n = {A:.4f}*{r1:.4f}^n + {B:.4f}*{r2:.4f}^n\"\n    elif discriminant == 0:\n        # Repeated root\n        r = c1 / 2\n        # A*r^0 + B*0*r^0 = a0 -> A = a0\n        # A*r + B*r = a1 -> B = a1/r - A\n        A = a0\n        B = a1 / r - A if r != 0 else a1\n        return lambda n: (A + B*n) * r**n, f\"a_n = ({A:.4f} + {B:.4f}*n)*{r:.4f}^n\"\n    else:\n        # Complex roots (beyond our scope but noting it)\n        return None, \"Complex roots\"\n\n# Solve Fibonacci: a_n = a_{n-1} + a_{n-2}, a_0=0, a_1=1\nfib_fn, fib_formula = solve_second_order(1, 1, 0, 1)\nprint(f\"Fibonacci closed form: {fib_formula}\")\nprint(f\"  (This is Binet's formula using the golden ratio)\")\nprint()\n\n# Verify Fibonacci\nprint(\"Verifying Fibonacci closed form:\")\nfor n in range(10):\n    closed = round(fib_fn(n))\n    print(f\"  F({n}) = {closed}\")"
        ]
      ]
    },
    {
