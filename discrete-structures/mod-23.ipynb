        [
          "python",
          "# Boolean algebra verification\ndef verify_boolean_laws():\n    \"\"\"Verify Boolean algebra laws for all inputs.\"\"\"\n    results = {}\n    \n    for x in [0, 1]:\n        for y in [0, 1]:\n            for z in [0, 1]:\n                # Distributive: x*(y+z) = xy + xz\n                lhs = x & (y | z)\n                rhs = (x & y) | (x & z)\n                assert lhs == rhs\n                \n                # De Morgan: ~(x|y) = ~x & ~y\n                lhs = (~(x | y)) & 1\n                rhs = ((~x) & 1) & ((~y) & 1)\n                assert lhs == rhs\n    \n    print(\"All Boolean algebra laws verified for 2-valued logic\")\n\nverify_boolean_laws()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Logic gate implementations\ndef AND(a, b): return a & b\ndef OR(a, b): return a | b\ndef NOT(a): return 1 - a\ndef NAND(a, b): return NOT(AND(a, b))\ndef NOR(a, b): return NOT(OR(a, b))\ndef XOR(a, b): return a ^ b\n\n# Demonstrate universality of NAND\n# NOT(x) = NAND(x, x)\n# AND(x,y) = NOT(NAND(x,y)) = NAND(NAND(x,y), NAND(x,y))\n# OR(x,y) = NAND(NOT(x), NOT(y)) = NAND(NAND(x,x), NAND(y,y))\n\ndef NAND_NOT(x):\n    return NAND(x, x)\n\ndef NAND_AND(x, y):\n    return NAND(NAND(x, y), NAND(x, y))\n\ndef NAND_OR(x, y):\n    return NAND(NAND(x, x), NAND(y, y))\n\n# Verify\nprint(\"NAND universality verification:\")\nfor a in [0, 1]:\n    for b in [0, 1]:\n        assert NAND_AND(a, b) == AND(a, b)\n        assert NAND_OR(a, b) == OR(a, b)\n    assert NAND_NOT(a) == NOT(a)\nprint(\"  NOT, AND, OR all implemented using only NAND gates\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from itertools import product\n\ndef truth_table(f, n_vars):\n    \"\"\"Generate truth table for an n-variable Boolean function.\"\"\"\n    print(f\"{'Inputs':<{3*n_vars+2}} | Output\")\n    print(\"-\" * (3*n_vars + 12))\n    for inputs in product([0, 1], repeat=n_vars):\n        output = f(*inputs)\n        input_str = \" \".join(str(i) for i in inputs)\n        print(f\"  {input_str:<{3*n_vars}} |   {output}\")\n\n# Example: majority function (output 1 if majority of inputs are 1)\ndef majority(a, b, c):\n    return int((a + b + c) >= 2)\n\nprint(\"Majority function (3 inputs):\")\ntruth_table(majority, 3)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def to_sop(f, variables):\n    \"\"\"Convert a Boolean function to Sum of Products form.\"\"\"\n    n = len(variables)\n    minterms = []\n    \n    for inputs in product([0, 1], repeat=n):\n        if f(*inputs):\n            term_parts = []\n            for i, val in enumerate(inputs):\n                if val == 1:\n                    term_parts.append(variables[i])\n                else:\n                    term_parts.append(f\"{variables[i]}'\")\n            minterms.append(\"\".join(term_parts))\n    \n    return \" + \".join(minterms)\n\n# Majority function SOP\nvariables = ['a', 'b', 'c']\nsop = to_sop(majority, variables)\nprint(f\"Majority SOP: F = {sop}\")\n# Should be: a'bc + ab'c + abc' + abc\n# Simplified: ab + ac + bc"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Verify simplification: abc + ab'c + a'bc + abc' = ab + ac + bc\ndef original(a, b, c):\n    return int((not a and b and c) or (a and not b and c) or \n               (a and b and not c) or (a and b and c))\n\ndef simplified(a, b, c):\n    return int((a and b) or (a and c) or (b and c))\n\n# Verify equivalence\nfor inputs in product([0, 1], repeat=3):\n    assert original(*inputs) == simplified(*inputs)\nprint(\"Simplification verified: a'bc + ab'c + abc' + abc = ab + ac + bc\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def kmap_2var(f):\n    \"\"\"Display a 2-variable K-map.\"\"\"\n    print(\"    b=0  b=1\")\n    print(f\"a=0  {f(0,0)}    {f(0,1)}\")\n    print(f\"a=1  {f(1,0)}    {f(1,1)}\")\n\ndef kmap_3var(f):\n    \"\"\"Display a 3-variable K-map.\"\"\"\n    print(\"      bc=00 bc=01 bc=11 bc=10\")\n    print(f\"a=0    {f(0,0,0)}     {f(0,0,1)}     {f(0,1,1)}     {f(0,1,0)}\")\n    print(f\"a=1    {f(1,0,0)}     {f(1,0,1)}     {f(1,1,1)}     {f(1,1,0)}\")\n\nprint(\"K-map for majority function:\")\nkmap_3var(majority)\nprint(\"\\nGroups: ab (row 1, cols 11,10), ac (row 1, cols 01,11), bc (both rows, col 11)\")\nprint(\"Simplified: F = ab + ac + bc\")"
        ]
      ]
    },
    {
