          "python",
          "# 2-to-1 Multiplexer: selects between inputs based on selector\ndef mux_2to1(a, b, sel):\n    \"\"\"Output a if sel=0, b if sel=1.\"\"\"\n    return (NOT(sel) & a) | (sel & b)\n\n# 2-to-4 Decoder: activates one of 4 outputs based on 2-bit input\ndef decoder_2to4(a, b):\n    \"\"\"Return which of 4 outputs is active.\"\"\"\n    return [\n        AND(NOT(a), NOT(b)),  # output 0: a'b'\n        AND(NOT(a), b),       # output 1: a'b\n        AND(a, NOT(b)),       # output 2: ab'\n        AND(a, b)             # output 3: ab\n    ]\n\nprint(\"2-to-1 MUX (sel=0 picks a, sel=1 picks b):\")\nfor sel in [0, 1]:\n    for a, b in product([0, 1], repeat=2):\n        print(f\"  a={a}, b={b}, sel={sel} -> {mux_2to1(a, b, sel)}\")"
        ]
      ]
