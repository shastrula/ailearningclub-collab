        [
          "python",
          "def full_adder(a, b, c):\n    \"\"\"1-bit full adder: returns (sum, carry_out).\"\"\"\n    s = a ^ b ^ c                    # XOR for sum\n    cout = (a & b) | (a & c) | (b & c)  # Majority for carry\n    return s, cout\n\n# Truth table for full adder\nprint(\"Full Adder Truth Table:\")\nprint(\"a b cin | sum cout\")\nprint(\"-\" * 22)\nfor a, b, c in product([0, 1], repeat=3):\n    s, cout = full_adder(a, b, c)\n    print(f\"{a} {b}  {c}  |  {s}    {cout}\")\n\n# Build a 4-bit adder from full adders\ndef four_bit_adder(a_bits, b_bits):\n    \"\"\"4-bit ripple carry adder.\"\"\"\n    carry = 0\n    result = []\n    for i in range(4):\n        s, carry = full_adder(a_bits[i], b_bits[i], carry)\n        result.append(s)\n    return result, carry\n\n# Add 5 (0101) + 3 (0011) = 8 (1000)\na = [1, 0, 1, 0]  # 5 in LSB-first\nb = [1, 1, 0, 0]  # 3 in LSB-first\nresult, overflow = four_bit_adder(a, b)\ndecimal_result = sum(bit * 2**i for i, bit in enumerate(result)) + overflow * 16\n\nprint(f\"\\n4-bit addition: 5 + 3 = {decimal_result}\")\nprint(f\"  A = {a} (LSB first)\")\nprint(f\"  B = {b} (LSB first)\")\nprint(f\"  Result = {result}, overflow = {overflow}\")"
        ]
      ]
    },
