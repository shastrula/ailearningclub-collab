      "source": [
        "# Discrete Structures - mod-7\n\n",
        "**Course:** discrete-structures\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Sets in Python\nA = {1, 2, 3, 4, 5}\nB = {1, 2, 3}\nC = {4, 5, 6, 7}\n\n# Membership\nprint(f\"3 in A: {3 in A}\")           # True\nprint(f\"7 in A: {7 in A}\")           # False\n\n# Subset\nprint(f\"B subset of A: {B <= A}\")     # True (B is subset of A)\nprint(f\"A subset of B: {A <= B}\")     # False\nprint(f\"B proper subset of A: {B < A}\")  # True\n\n# Equality (same elements)\nD = {3, 1, 2}\nprint(f\"B == D: {B == D}\")           # True (order doesn't matter)\n\n# Empty set\nempty = set()\nprint(f\"empty subset of A: {empty <= A}\")  # True (always)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "A = {1, 2, 3, 4, 5}\nB = {4, 5, 6, 7, 8}\n\n# Union\nprint(f\"A | B = {A | B}\")           # {1, 2, 3, 4, 5, 6, 7, 8}\n\n# Intersection\nprint(f\"A & B = {A & B}\")           # {4, 5}\n\n# Difference\nprint(f\"A - B = {A - B}\")           # {1, 2, 3}\nprint(f\"B - A = {B - A}\")           # {6, 7, 8}\n\n# Symmetric difference\nprint(f\"A ^ B = {A ^ B}\")           # {1, 2, 3, 6, 7, 8}\n\n# Complement (relative to a universal set)\nU = set(range(1, 11))\nA_complement = U - A\nprint(f\"U = {U}\")\nprint(f\"A' = {A_complement}\")       # {6, 7, 8, 9, 10}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "A = {1, 2, 3, 4, 5, 6}\nB = {4, 5, 6, 7, 8, 9}\n\n# Verify inclusion-exclusion\nlhs = len(A | B)\nrhs = len(A) + len(B) - len(A & B)\nprint(f\"|A union B| = {lhs}\")\nprint(f\"|A| + |B| - |A inter B| = {len(A)} + {len(B)} - {len(A & B)} = {rhs}\")\nprint(f\"Inclusion-exclusion verified: {lhs == rhs}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "A = {1, 2, 3}\nB = {'a', 'b'}\n\n# Cartesian product\ncartesian = {(a, b) for a in A for b in B}\nprint(f\"A x B = {cartesian}\")\nprint(f\"|A x B| = {len(cartesian)}\")  # 3 * 2 = 6\n\n# This is fundamental for databases (JOIN operation)\n# and for defining relations"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Partition example: partition integers 1-12 by remainder mod 3\nS = set(range(1, 13))\nR0 = {x for x in S if x % 3 == 0}  # {3, 6, 9, 12}\nR1 = {x for x in S if x % 3 == 1}  # {1, 4, 7, 10}\nR2 = {x for x in S if x % 3 == 2}  # {2, 5, 8, 11}\n\n# Verify partition properties\nprint(f\"R0 = {sorted(R0)}\")\nprint(f\"R1 = {sorted(R1)}\")\nprint(f\"R2 = {sorted(R2)}\")\nprint(f\"Pairwise disjoint: {len(R0 & R1) == 0 and len(R1 & R2) == 0 and len(R0 & R2) == 0}\")\nprint(f\"Union equals S: {R0 | R1 | R2 == S}\")\nprint(f\"All non-empty: {len(R0) > 0 and len(R1) > 0 and len(R2) > 0}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from collections import Counter\n\n# Multisets using Counter\nms1 = Counter(['a', 'a', 'b', 'c'])\nms2 = Counter(['a', 'b', 'b', 'd'])\n\nprint(f\"ms1 = {dict(ms1)}\")  # {'a': 2, 'b': 1, 'c': 1}\nprint(f\"ms2 = {dict(ms2)}\")  # {'a': 1, 'b': 2, 'd': 1}\n\n# Multiset union (max of counts)\nprint(f\"Union: {dict(ms1 | ms2)}\")        # {'a': 2, 'b': 2, 'c': 1, 'd': 1}\n\n# Multiset intersection (min of counts)\nprint(f\"Intersection: {dict(ms1 & ms2)}\") # {'a': 1, 'b': 1}\n\n# Multiset sum (add counts)\nprint(f\"Sum: {dict(ms1 + ms2)}\")          # {'a': 3, 'b': 3, 'c': 1, 'd': 1}"
        ]
      ]
    }
