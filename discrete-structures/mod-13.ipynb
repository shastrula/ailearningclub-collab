      "source": [
        [
          "python",
          "# Tree diagram: counting outcomes of flipping a coin 3 times\ndef generate_sequences(choices, length):\n    \"\"\"Generate all sequences of given length from choices.\"\"\"\n    if length == 0:\n        return [[]]\n    shorter = generate_sequences(choices, length - 1)\n    return [seq + [c] for seq in shorter for c in choices]\n\n# All outcomes of 3 coin flips\noutcomes = generate_sequences(['H', 'T'], 3)\nprint(f\"3 coin flips: {len(outcomes)} outcomes\")\nfor outcome in outcomes:\n    print(f\"  {''.join(outcome)}\")\n\n# Count those with at least 2 heads\nat_least_2h = [o for o in outcomes if o.count('H') >= 2]\nprint(f\"At least 2 heads: {len(at_least_2h)}\")"
        ]
      ]
    }
