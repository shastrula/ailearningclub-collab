      "source": [
        [
          "python",
          "# Rule of Product examples\n\n# License plates: 3 letters + 4 digits\nletters = 26\ndigits = 10\nplates = letters**3 * digits**4\nprint(f\"License plates (3 letters + 4 digits): {plates:,}\")\n\n# Passwords: 8 characters, each can be letter (upper/lower) or digit\nchar_choices = 26 + 26 + 10  # 62 choices per position\npasswords_8 = char_choices**8\nprint(f\"8-char passwords (alphanumeric): {passwords_8:,}\")\n\n# Binary strings of length n\nn = 10\nbinary_strings = 2**n\nprint(f\"Binary strings of length {n}: {binary_strings}\")\n\n# Functions from A to B: |B|^|A| total functions\nA_size = 3\nB_size = 4\ntotal_functions = B_size**A_size\nprint(f\"Functions from |A|={A_size} to |B|={B_size}: {total_functions}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Rule of Sum examples\n\n# Choosing a variable name: single lowercase letter OR single uppercase letter\nsingle_char_names = 26 + 26  # lowercase or uppercase\nprint(f\"Single character variable names: {single_char_names}\")\n\n# Bit strings of length 1, 2, or 3\ntotal = 2**1 + 2**2 + 2**3  # 2 + 4 + 8\nprint(f\"Bit strings of length 1, 2, or 3: {total}\")\n\n# Passwords that are either 6, 7, or 8 characters (alphanumeric)\nchars = 62\npw_6_7_8 = chars**6 + chars**7 + chars**8\nprint(f\"Passwords of length 6-8: {pw_6_7_8:,}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Subtraction rule example\n# Bit strings of length 8 that start with 1 OR end with 00\n\nstart_1 = 2**7          # 1XXXXXXX\nend_00 = 2**6           # XXXXXX00\nboth = 2**5             # 1XXXXX00\ntotal = start_1 + end_00 - both\n\nprint(f\"Start with 1: {start_1}\")\nprint(f\"End with 00: {end_00}\")\nprint(f\"Both: {both}\")\nprint(f\"Total (inclusion-exclusion): {total}\")\n\n# Verify by enumeration\ncount = 0\nfor i in range(256):  # All 8-bit strings\n    bits = f\"{i:08b}\"\n    if bits[0] == '1' or bits[-2:] == '00':\n        count += 1\nprint(f\"Verified by enumeration: {count}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Division rule: seating at a round table\n# n people at a round table, rotations are the same arrangement\n# Linear arrangements: n!\n# Circular arrangements: n!/n = (n-1)!\n\nimport math\n\nn = 6\nlinear = math.factorial(n)\ncircular = math.factorial(n - 1)\nprint(f\"{n} people at round table:\")\nprint(f\"  Linear arrangements: {linear}\")\nprint(f\"  Circular arrangements: {circular}\")\nprint(f\"  Ratio: {linear // circular} (= n)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import math\n\ndef count_injections(m, n):\n    \"\"\"Count injective functions from |A|=m to |B|=n.\"\"\"\n    if m > n:\n        return 0\n    return math.factorial(n) // math.factorial(n - m)\n\n# Functions from {1,2,3} to {a,b,c,d}\nm, n = 3, 4\nprint(f\"Functions from |A|={m} to |B|={n}:\")\nprint(f\"  Total functions: {n**m}\")\nprint(f\"  Injections: {count_injections(m, n)}\")\nprint(f\"  Non-injections: {n**m - count_injections(m, n)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Count bit strings of length n with various constraints\nn = 8\n\n# Total bit strings\ntotal = 2**n\nprint(f\"Total {n}-bit strings: {total}\")\n\n# Strings with exactly k ones\nfrom math import comb\nfor k in [0, 1, 2, 3, 4]:\n    print(f\"  Exactly {k} ones: {comb(n, k)}\")\n\n# Strings that start with 11 or end with 01\nstart_11 = 2**(n-2)    # 11XXXXXX\nend_01 = 2**(n-2)      # XXXXXX01\nboth_11_01 = 2**(n-4)  # 11XXXX01\nresult = start_11 + end_01 - both_11_01\nprint(f\"Start with 11 or end with 01: {result}\")\n\n# Verify\ncount = sum(1 for i in range(2**n) \n            if f\"{i:0{n}b}\"[:2] == '11' or f\"{i:0{n}b}\"[-2:] == '01')\nprint(f\"Verified: {count}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
