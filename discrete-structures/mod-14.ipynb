      "source": [
        [
          "python",
          "import math\n\ndef permutations(n, r):\n    \"\"\"Calculate P(n, r) = n! / (n-r)!\"\"\"\n    return math.factorial(n) // math.factorial(n - r)\n\n# Examples\nprint(f\"P(10, 3) = {permutations(10, 3)}\")   # 720 - arrange 3 from 10\nprint(f\"P(5, 5) = {permutations(5, 5)}\")     # 120 = 5! - arrange all 5\nprint(f\"P(26, 4) = {permutations(26, 4)}\")   # 4-letter words from alphabet (no repeats)\n\n# Application: How many ways to award gold, silver, bronze to 8 runners?\nprint(f\"Medal arrangements for 8 runners: {permutations(8, 3)}\")  # 336"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def combinations(n, r):\n    \"\"\"Calculate C(n, r) = n! / (r! * (n-r)!)\"\"\"\n    return math.factorial(n) // (math.factorial(r) * math.factorial(n - r))\n\n# Also available as math.comb(n, r) in Python 3.8+\nprint(f\"C(10, 3) = {combinations(10, 3)}\")    # 120\nprint(f\"C(52, 5) = {combinations(52, 5)}\")    # 2,598,960 (poker hands)\nprint(f\"C(100, 2) = {combinations(100, 2)}\")  # 4,950 (pairs from 100)\n\n# Relationship: P(n,r) = C(n,r) * r!\nn, r = 10, 3\nprint(f\"\\nP({n},{r}) = {permutations(n,r)}\")\nprint(f\"C({n},{r}) * {r}! = {combinations(n,r)} * {math.factorial(r)} = {combinations(n,r) * math.factorial(r)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Verify properties of binomial coefficients\nn = 10\n\n# Symmetry: C(n,r) = C(n, n-r)\nfor r in range(n + 1):\n    assert math.comb(n, r) == math.comb(n, n - r)\nprint(f\"Symmetry verified for n={n}\")\n\n# Pascal's identity: C(n,r) = C(n-1, r-1) + C(n-1, r)\nfor r in range(1, n):\n    assert math.comb(n, r) == math.comb(n-1, r-1) + math.comb(n-1, r)\nprint(f\"Pascal's identity verified for n={n}\")\n\n# Sum of row = 2^n\nrow_sum = sum(math.comb(n, r) for r in range(n + 1))\nprint(f\"Sum of row {n}: {row_sum} = 2^{n} = {2**n}\")\n\n# Pascal's Triangle\nprint(\"\\nPascal's Triangle (first 8 rows):\")\nfor i in range(8):\n    row = [math.comb(i, j) for j in range(i + 1)]\n    print(f\"  {'  ' * (7-i)}{' '.join(f'{x:3d}' for x in row)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Binomial theorem verification\ndef binomial_expand(n):\n    \"\"\"Show the expansion of (x + y)^n.\"\"\"\n    terms = []\n    for k in range(n + 1):\n        coeff = math.comb(n, k)\n        if n - k == 0:\n            x_part = \"\"\n        elif n - k == 1:\n            x_part = \"x\"\n        else:\n            x_part = f\"x^{n-k}\"\n        if k == 0:\n            y_part = \"\"\n        elif k == 1:\n            y_part = \"y\"\n        else:\n            y_part = f\"y^{k}\"\n        \n        term = f\"{coeff}{x_part}{y_part}\"\n        terms.append(term)\n    return \" + \".join(terms)\n\nfor n in range(1, 6):\n    print(f\"(x+y)^{n} = {binomial_expand(n)}\")\n\n# Numerical verification: (1+1)^n = sum C(n,k) = 2^n\nfor n in [5, 10, 15]:\n    total = sum(math.comb(n, k) for k in range(n+1))\n    print(f\"(1+1)^{n} = {total} = 2^{n}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Permutations with repetition\nfrom collections import Counter\n\ndef multiset_permutations(word):\n    \"\"\"Count distinct permutations of a word with repeated letters.\"\"\"\n    counts = Counter(word)\n    n = len(word)\n    denom = 1\n    for c in counts.values():\n        denom *= math.factorial(c)\n    return math.factorial(n) // denom\n\nwords = [\"MISSISSIPPI\", \"BANANA\", \"AABBCC\", \"ABCDEF\"]\nfor word in words:\n    count = multiset_permutations(word)\n    print(f\"'{word}': {count:,} distinct arrangements\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Combinations with repetition (stars and bars)\ndef combinations_with_rep(n, r):\n    \"\"\"C(n+r-1, r): choose r items from n types with repetition.\"\"\"\n    return math.comb(n + r - 1, r)\n\n# Buy 5 donuts from 4 flavors\nprint(f\"5 donuts, 4 flavors: {combinations_with_rep(4, 5)} ways\")\n\n# Distribute 10 identical balls into 3 boxes\nprint(f\"10 balls in 3 boxes: {combinations_with_rep(3, 10)} ways\")\n\n# Solutions to x1 + x2 + x3 + x4 = 12 where xi >= 0\nprint(f\"Solutions to x1+x2+x3+x4=12: {combinations_with_rep(4, 12)} ways\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Counting binary strings with exactly k ones\nn = 12  # string length\nfor k in range(n + 1):\n    count = math.comb(n, k)\n    if k <= 4 or k >= n - 1:\n        print(f\"  {n}-bit strings with exactly {k} ones: {count}\")\n\n# Committee selection problem\n# From 8 men and 5 women, select a committee of 5 with at least 2 women\ntotal = 0\nfor w in range(2, 6):  # 2, 3, 4, or 5 women\n    m = 5 - w\n    if m <= 8:\n        ways = math.comb(5, w) * math.comb(8, m)\n        total += ways\n        print(f\"  {w} women, {m} men: {ways} ways\")\nprint(f\"  Total committees: {total}\")"
        ]
      ]
    }
