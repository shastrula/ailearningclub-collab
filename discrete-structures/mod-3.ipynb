      "outputs": [],
      "source": [
        [
          "python",
          "from itertools import product\n\ndef is_tautology(formula, n_vars):\n    \"\"\"\n    Check if a formula is a tautology.\n    formula: function taking n boolean arguments, returns boolean\n    n_vars: number of propositional variables\n    \"\"\"\n    for values in product([True, False], repeat=n_vars):\n        if not formula(*values):\n            return False\n    return True\n\ndef is_contradiction(formula, n_vars):\n    \"\"\"Check if a formula is a contradiction.\"\"\"\n    for values in product([True, False], repeat=n_vars):\n        if formula(*values):\n            return False\n    return True\n\n# Test: p OR (NOT p) is a tautology\ntaut = lambda p: p or (not p)\nprint(f\"p OR ~p is a tautology: {is_tautology(taut, 1)}\")  # True\n\n# Test: p AND (NOT p) is a contradiction\ncontra = lambda p: p and (not p)\nprint(f\"p AND ~p is a contradiction: {is_contradiction(contra, 1)}\")  # True\n\n# Test: p -> (q -> p) is a tautology\nimpl_taut = lambda p, q: (not p) or ((not q) or p)\nprint(f\"p -> (q -> p) is a tautology: {is_tautology(impl_taut, 2)}\")  # True"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def are_equivalent(formula1, formula2, n_vars):\n    \"\"\"Check if two formulas are logically equivalent.\"\"\"\n    for values in product([True, False], repeat=n_vars):\n        if formula1(*values) != formula2(*values):\n            return False\n    return True\n\n# Verify: p -> q == (NOT p) OR q\nf1 = lambda p, q: (not p) or q           # p -> q\nf2 = lambda p, q: (not p) or q           # NOT p OR q\nprint(f\"p -> q == ~p OR q: {are_equivalent(f1, f2, 2)}\")  # True\n\n# Verify De Morgan's Law: NOT(p AND q) == (NOT p) OR (NOT q)\ndm1 = lambda p, q: not (p and q)\ndm2 = lambda p, q: (not p) or (not q)\nprint(f\"~(p AND q) == ~p OR ~q: {are_equivalent(dm1, dm2, 2)}\")  # True"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Verify the proof computationally\nlhs = lambda p, q: not ((not p) or q)  # NOT(p -> q)\nrhs = lambda p, q: p and (not q)       # p AND NOT q\nprint(f\"~(p -> q) == p AND ~q: {are_equivalent(lhs, rhs, 2)}\")  # True"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
