      "source": [
        [
          "python",
          "def find_satisfying_assignment(formula, n_vars):\n    \"\"\"Find a truth assignment that satisfies the formula, or None.\"\"\"\n    for values in product([True, False], repeat=n_vars):\n        if formula(*values):\n            return values\n    return None\n\n# Example: (p OR q) AND (NOT p OR r) AND (NOT q OR NOT r)\nformula = lambda p, q, r: (p or q) and ((not p) or r) and ((not q) or (not r))\nresult = find_satisfying_assignment(formula, 3)\nprint(f\"Satisfying assignment: p={result[0]}, q={result[1]}, r={result[2]}\")\n\n# Count all satisfying assignments\ncount = sum(1 for v in product([True, False], repeat=3) if formula(*v))\nprint(f\"Total satisfying assignments: {count} out of 8\")"
        ]
      ]
    }
