      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Generating common sequences\ndef arithmetic_seq(a0, d, n):\n    \"\"\"Generate first n terms of arithmetic sequence.\"\"\"\n    return [a0 + i * d for i in range(n)]\n\ndef geometric_seq(a0, r, n):\n    \"\"\"Generate first n terms of geometric sequence.\"\"\"\n    return [a0 * r**i for i in range(n)]\n\ndef fibonacci(n):\n    \"\"\"Generate first n Fibonacci numbers.\"\"\"\n    if n == 0:\n        return []\n    if n == 1:\n        return [0]\n    fib = [0, 1]\n    for i in range(2, n):\n        fib.append(fib[-1] + fib[-2])\n    return fib\n\nprint(f\"Arithmetic (a0=2, d=3): {arithmetic_seq(2, 3, 8)}\")\nprint(f\"Geometric (a0=3, r=2):  {geometric_seq(3, 2, 8)}\")\nprint(f\"Fibonacci:              {fibonacci(12)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Verify closed-form formulas\ndef verify_sum_formula(direct_sum, formula, n, name):\n    \"\"\"Compare direct summation with closed formula.\"\"\"\n    direct = direct_sum(n)\n    closed = formula(n)\n    match = abs(direct - closed) < 1e-10\n    print(f\"{name} (n={n}): direct={direct}, formula={closed}, match={match}\")\n\n# Sum of 1 to n\nverify_sum_formula(\n    lambda n: sum(range(1, n+1)),\n    lambda n: n * (n + 1) // 2,\n    100, \"sum(1..n)\"\n)\n\n# Sum of squares\nverify_sum_formula(\n    lambda n: sum(i**2 for i in range(1, n+1)),\n    lambda n: n * (n + 1) * (2*n + 1) // 6,\n    50, \"sum(i^2)\"\n)\n\n# Sum of cubes\nverify_sum_formula(\n    lambda n: sum(i**3 for i in range(1, n+1)),\n    lambda n: (n * (n + 1) // 2) ** 2,\n    30, \"sum(i^3)\"\n)\n\n# Geometric sum\ndef geo_sum_direct(r, n):\n    return sum(r**i for i in range(n+1))\n\ndef geo_sum_formula(r, n):\n    return (r**(n+1) - 1) / (r - 1)\n\nr, n = 2, 10\nprint(f\"Geometric sum (r={r}, n={n}): direct={geo_sum_direct(r,n)}, formula={geo_sum_formula(r,n)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Telescoping sum example\ndef telescoping_direct(n):\n    \"\"\"Direct computation of sum 1/(i*(i+1))\"\"\"\n    return sum(1/(i*(i+1)) for i in range(1, n+1))\n\ndef telescoping_formula(n):\n    \"\"\"Closed form: n/(n+1)\"\"\"\n    return n / (n + 1)\n\nfor n in [5, 10, 50, 100]:\n    d = telescoping_direct(n)\n    f = telescoping_formula(n)\n    print(f\"n={n:3d}: direct={d:.10f}, formula={f:.10f}, diff={abs(d-f):.2e}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Analysis of nested loops\ndef nested_loop_count(n):\n    \"\"\"Count operations in a nested loop.\"\"\"\n    count = 0\n    for i in range(n):\n        for j in range(i + 1):\n            count += 1\n    return count\n\n# The count equals sum_{i=0}^{n-1} (i+1) = sum_{i=1}^{n} i = n(n+1)/2\nfor n in [10, 50, 100]:\n    actual = nested_loop_count(n)\n    formula = n * (n + 1) // 2\n    print(f\"n={n:3d}: loop count={actual}, n(n+1)/2={formula}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Harmonic numbers: H_n = sum_{i=1}^{n} 1/i ~ ln(n) + 0.5772...\nimport math\n\ndef harmonic(n):\n    return sum(1/i for i in range(1, n+1))\n\neuler_gamma = 0.5772156649\n\nfor n in [10, 100, 1000, 10000]:\n    h = harmonic(n)\n    approx = math.log(n) + euler_gamma\n    print(f\"H_{n:5d} = {h:.6f}, ln(n)+gamma = {approx:.6f}, error = {abs(h-approx):.6f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Double summation: sum_{i=1}^{n} sum_{j=1}^{i} j\n# Inner sum = i(i+1)/2, so total = sum_{i=1}^n i(i+1)/2 = n(n+1)(n+2)/6\n\ndef double_sum_direct(n):\n    total = 0\n    for i in range(1, n+1):\n        for j in range(1, i+1):\n            total += j\n    return total\n\ndef double_sum_formula(n):\n    return n * (n + 1) * (n + 2) // 6\n\nfor n in [5, 10, 20]:\n    print(f\"n={n}: direct={double_sum_direct(n)}, formula={double_sum_formula(n)}\")"
        ]
      ]
    },
    {
