        [
          "python",
          "# Factorials and products\ndef factorial(n):\n    result = 1\n    for i in range(1, n + 1):\n        result *= i\n    return result\n\n# Verify: product of first n terms of geometric sequence\n# prod_{i=0}^{n-1} ar^i = a^n * r^(n(n-1)/2)\na, r, n = 2, 3, 5\ndirect = 1\nfor i in range(n):\n    direct *= a * r**i\n\nformula = a**n * r**(n*(n-1)//2)\nprint(f\"Geometric product: direct={direct}, formula={formula}\")"
        ]
      ]
