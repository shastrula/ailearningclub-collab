      "outputs": [],
      "source": [
        [
          "python",
          "# Defining relations as sets of pairs\nA = {1, 2, 3, 4, 5, 6}\n\n# \"divides\" relation on A\ndivides = {(a, b) for a in A for b in A if b % a == 0}\nprint(\"Divides relation:\")\nfor a in sorted(A):\n    related_to = sorted([b for b in A if (a, b) in divides])\n    print(f\"  {a} divides: {related_to}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def relation_to_matrix(relation, elements):\n    \"\"\"Convert a relation to its matrix representation.\"\"\"\n    elements = sorted(elements)\n    n = len(elements)\n    idx = {e: i for i, e in enumerate(elements)}\n    matrix = [[0] * n for _ in range(n)]\n    for (a, b) in relation:\n        matrix[idx[a]][idx[b]] = 1\n    return matrix, elements\n\n# Display the divides relation as a matrix\nA = {1, 2, 3, 4}\ndivides = {(a, b) for a in A for b in A if b % a == 0}\nmatrix, elems = relation_to_matrix(divides, A)\n\nprint(\"Matrix for 'divides' on {1,2,3,4}:\")\nprint(\"    \" + \"  \".join(map(str, elems)))\nfor i, row in enumerate(matrix):\n    print(f\"  {elems[i]} {row}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def check_properties(relation, elements):\n    \"\"\"Check all properties of a relation.\"\"\"\n    A = elements\n    \n    # Reflexive: (a,a) in R for all a\n    reflexive = all((a, a) in relation for a in A)\n    \n    # Irreflexive: (a,a) not in R for all a\n    irreflexive = all((a, a) not in relation for a in A)\n    \n    # Symmetric: (a,b) in R implies (b,a) in R\n    symmetric = all((b, a) in relation for (a, b) in relation)\n    \n    # Antisymmetric: (a,b) in R and (b,a) in R implies a == b\n    antisymmetric = all(\n        a == b\n        for (a, b) in relation\n        if (b, a) in relation\n    )\n    \n    # Transitive: (a,b) in R and (b,c) in R implies (a,c) in R\n    transitive = all(\n        (a, c) in relation\n        for (a, b) in relation\n        for (b2, c) in relation\n        if b == b2\n    )\n    \n    return {\n        'reflexive': reflexive,\n        'irreflexive': irreflexive,\n        'symmetric': symmetric,\n        'antisymmetric': antisymmetric,\n        'transitive': transitive\n    }\n\nA = {1, 2, 3, 4, 5, 6}\n\n# Divides relation\ndivides = {(a, b) for a in A for b in A if b % a == 0}\nprint(\"'Divides' relation properties:\")\nfor prop, val in check_properties(divides, A).items():\n    print(f\"  {prop}: {val}\")\n\nprint()\n\n# Less than relation\nless_than = {(a, b) for a in A for b in A if a < b}\nprint(\"'Less than' relation properties:\")\nfor prop, val in check_properties(less_than, A).items():\n    print(f\"  {prop}: {val}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Composition of relations\nA = {1, 2, 3, 4}\n\nR = {(1,2), (2,3), (3,4), (1,3)}  # Some relation\nS = {(2,1), (3,2), (4,3), (3,1)}  # Another relation\n\n# Compose S with R: (a,c) where exists b: (a,b) in R and (b,c) in S\ncomposition = set()\nfor (a, b1) in R:\n    for (b2, c) in S:\n        if b1 == b2:\n            composition.add((a, c))\n\nprint(f\"R = {sorted(R)}\")\nprint(f\"S = {sorted(S)}\")\nprint(f\"S composed with R = {sorted(composition)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def transitive_closure(relation, elements):\n    \"\"\"Compute transitive closure using Warshall's algorithm.\"\"\"\n    # Convert to adjacency matrix\n    elems = sorted(elements)\n    n = len(elems)\n    idx = {e: i for i, e in enumerate(elems)}\n    \n    # Initialize matrix\n    reach = [[False] * n for _ in range(n)]\n    for (a, b) in relation:\n        reach[idx[a]][idx[b]] = True\n    \n    # Warshall's algorithm\n    for k in range(n):\n        for i in range(n):\n            for j in range(n):\n                reach[i][j] = reach[i][j] or (reach[i][k] and reach[k][j])\n    \n    # Convert back to set of pairs\n    closure = set()\n    for i in range(n):\n        for j in range(n):\n            if reach[i][j]:\n                closure.add((elems[i], elems[j]))\n    return closure\n\nA = {1, 2, 3, 4}\nR = {(1, 2), (2, 3), (3, 4)}\ntc = transitive_closure(R, A)\nprint(f\"R = {sorted(R)}\")\nprint(f\"Transitive closure = {sorted(tc)}\")\n# Should include (1,3), (1,4), (2,4) in addition to original pairs"
        ]
      ]
    }
