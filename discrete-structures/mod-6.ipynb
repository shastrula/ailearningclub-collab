      "source": [
        "# Discrete Structures - mod-6\n\n",
        "**Course:** discrete-structures\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Verify the sum formula\ndef sum_formula(n):\n    return n * (n + 1) // 2\n\n# Check for many values\nfor n in range(1, 101):\n    direct_sum = sum(range(1, n + 1))\n    assert direct_sum == sum_formula(n), f\"Failed at n={n}\"\n\nprint(\"Sum formula verified for n = 1 to 100\")\nprint(f\"Example: sum(1..50) = {sum_formula(50)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Verify the inequality 2^n > n^2 for n >= 5\nfailures = []\nfor n in range(5, 100):\n    if not (2**n > n**2):\n        failures.append(n)\n\nprint(f\"2^n > n^2 holds for all n in [5, 99]: {len(failures) == 0}\")\nprint(f\"Example: 2^10 = {2**10}, 10^2 = {10**2}\")\nprint(f\"Example: 2^20 = {2**20}, 20^2 = {20**2}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Verify divisibility\nfor n in range(1, 50):\n    assert (4**n - 1) % 3 == 0, f\"Failed at n={n}\"\nprint(\"3 | (4^n - 1) verified for n = 1 to 49\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def prime_factorization(n):\n    \"\"\"Find the prime factorization of n.\"\"\"\n    factors = []\n    d = 2\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 1\n    if n > 1:\n        factors.append(n)\n    return factors\n\n# Demonstrate: every integer >= 2 has a prime factorization\nfor n in range(2, 30):\n    factors = prime_factorization(n)\n    product = 1\n    for f in factors:\n        product *= f\n    assert product == n\n    print(f\"{n} = {' x '.join(map(str, factors))}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Structural induction example with binary trees\nclass Tree:\n    def __init__(self, left=None, right=None):\n        self.left = left\n        self.right = right\n\ndef count_nodes(tree):\n    if tree is None:\n        return 0\n    return 1 + count_nodes(tree.left) + count_nodes(tree.right)\n\n# Build some full binary trees and verify node count is odd\nt1 = Tree()  # single node: 1\nt2 = Tree(Tree(), Tree())  # 3 nodes\nt3 = Tree(Tree(Tree(), Tree()), Tree())  # 5 nodes\nt4 = Tree(Tree(Tree(), Tree()), Tree(Tree(), Tree()))  # 7 nodes\n\nfor i, t in enumerate([t1, t2, t3, t4], 1):\n    n = count_nodes(t)\n    print(f\"Tree {i}: {n} nodes, odd: {n % 2 == 1}\")"
        ]
      ]
    }
