          "python",
          "def topological_sort(adj_list):\n    \"\"\"Topological sort of a DAG using DFS.\"\"\"\n    visited = set()\n    result = []\n    \n    def dfs(v):\n        visited.add(v)\n        for u in adj_list[v]:\n            if u not in visited:\n                dfs(u)\n        result.append(v)\n    \n    for v in adj_list:\n        if v not in visited:\n            dfs(v)\n    \n    return list(reversed(result))\n\n# Course prerequisites DAG\ncourses = {\n    'Calc1': ['Calc2', 'LinearAlg'],\n    'Calc2': ['DiffEq'],\n    'LinearAlg': ['DiffEq'],\n    'DiffEq': [],\n    'Intro': ['DataStructures', 'Calc1'],\n    'DataStructures': ['Algorithms'],\n    'Algorithms': []\n}\n\norder = topological_sort(courses)\nprint(f\"Course order: {order}\")"
        ]
