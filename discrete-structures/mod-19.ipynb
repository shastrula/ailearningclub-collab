          "python",
          "def has_cycle_undirected(adj_list):\n    \"\"\"Detect if an undirected graph has a cycle using DFS.\"\"\"\n    visited = set()\n    \n    def dfs(v, parent):\n        visited.add(v)\n        for u in adj_list[v]:\n            if u not in visited:\n                if dfs(u, v):\n                    return True\n            elif u != parent:\n                return True  # Back edge found\n        return False\n    \n    for v in adj_list:\n        if v not in visited:\n            if dfs(v, None):\n                return True\n    return False\n\n# Graph with cycle\ncyclic = {'A': ['B', 'C'], 'B': ['A', 'C'], 'C': ['A', 'B']}\n# Graph without cycle (tree)\nacyclic = {'A': ['B', 'C'], 'B': ['A'], 'C': ['A', 'D'], 'D': ['C']}\n\nprint(f\"Cyclic graph has cycle: {has_cycle_undirected(cyclic)}\")\nprint(f\"Tree has cycle: {has_cycle_undirected(acyclic)}\")"
        ]
      ]
    },
