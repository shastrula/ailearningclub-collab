          "python",
          "def find_components(adj_list):\n    \"\"\"Find all connected components using BFS.\"\"\"\n    visited = set()\n    components = []\n    \n    for v in adj_list:\n        if v not in visited:\n            component = []\n            queue = deque([v])\n            visited.add(v)\n            while queue:\n                node = queue.popleft()\n                component.append(node)\n                for u in adj_list[node]:\n                    if u not in visited:\n                        visited.add(u)\n                        queue.append(u)\n            components.append(component)\n    \n    return components\n\n# Disconnected graph\ndisconnected = {\n    'A': ['B'], 'B': ['A', 'C'], 'C': ['B'],\n    'D': ['E'], 'E': ['D'],\n    'F': []\n}\n\ncomponents = find_components(disconnected)\nprint(f\"Connected components: {components}\")\nprint(f\"Number of components: {len(components)}\")"
        ]
