        [
          "python",
          "def dfs_iterative(adj_list, start):\n    \"\"\"Depth-first search using an explicit stack.\"\"\"\n    visited = set()\n    stack = [start]\n    order = []\n    \n    while stack:\n        v = stack.pop()\n        if v not in visited:\n            visited.add(v)\n            order.append(v)\n            # Add neighbors in reverse for consistent ordering\n            for u in reversed(adj_list[v]):\n                if u not in visited:\n                    stack.append(u)\n    \n    return order\n\ndef dfs_recursive(adj_list, start, visited=None, order=None):\n    \"\"\"Depth-first search using recursion.\"\"\"\n    if visited is None:\n        visited = set()\n        order = []\n    visited.add(start)\n    order.append(start)\n    for u in adj_list[start]:\n        if u not in visited:\n            dfs_recursive(adj_list, u, visited, order)\n    return order\n\nprint(\"DFS from A (iterative):\", dfs_iterative(graph, 'A'))\nprint(\"DFS from A (recursive):\", dfs_recursive(graph, 'A'))"
        ]
      ]
    },
