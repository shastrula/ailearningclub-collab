        [
          "python",
          "from collections import deque\n\ndef bfs(adj_list, start):\n    \"\"\"\n    Breadth-first search returning distances and parent pointers.\n    \"\"\"\n    visited = {start}\n    queue = deque([start])\n    distance = {start: 0}\n    parent = {start: None}\n    order = []\n    \n    while queue:\n        v = queue.popleft()\n        order.append(v)\n        for u in adj_list[v]:\n            if u not in visited:\n                visited.add(u)\n                queue.append(u)\n                distance[u] = distance[v] + 1\n                parent[u] = v\n    \n    return order, distance, parent\n\n# Example graph\ngraph = {\n    'A': ['B', 'C'],\n    'B': ['A', 'D', 'E'],\n    'C': ['A', 'F'],\n    'D': ['B'],\n    'E': ['B', 'F'],\n    'F': ['C', 'E']\n}\n\norder, dist, parent = bfs(graph, 'A')\nprint(\"BFS from A:\")\nprint(f\"  Visit order: {order}\")\nprint(f\"  Distances: {dist}\")\n\n# Reconstruct shortest path from A to F\ndef reconstruct_path(parent, target):\n    path = []\n    current = target\n    while current is not None:\n        path.append(current)\n        current = parent[current]\n    return list(reversed(path))\n\npath = reconstruct_path(parent, 'F')\nprint(f\"  Shortest path A->F: {' -> '.join(path)} (length {dist['F']})\")"
        ]
      ]
    },
    {
