        [
          "python",
          "class AdjacencyMatrix:\n    def __init__(self, vertices):\n        self.vertices = vertices\n        self.n = len(vertices)\n        self.idx = {v: i for i, v in enumerate(vertices)}\n        self.matrix = [[0] * self.n for _ in range(self.n)]\n    \n    def add_edge(self, u, v, directed=False):\n        i, j = self.idx[u], self.idx[v]\n        self.matrix[i][j] = 1\n        if not directed:\n            self.matrix[j][i] = 1\n    \n    def has_edge(self, u, v):\n        return self.matrix[self.idx[u]][self.idx[v]] == 1\n    \n    def neighbors(self, v):\n        i = self.idx[v]\n        return [self.vertices[j] for j in range(self.n) if self.matrix[i][j] == 1]\n    \n    def display(self):\n        print(\"   \" + \" \".join(str(v) for v in self.vertices))\n        for i, v in enumerate(self.vertices):\n            print(f\"{v}: {self.matrix[i]}\")\n\n# Example\ng = AdjacencyMatrix(['A', 'B', 'C', 'D'])\ng.add_edge('A', 'B')\ng.add_edge('A', 'C')\ng.add_edge('B', 'D')\ng.add_edge('C', 'D')\ng.display()\nprint(f\"Neighbors of A: {g.neighbors('A')}\")\nprint(f\"Edge A-D exists: {g.has_edge('A', 'D')}\")"
        ]
      ]
    },
