      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Representing graphs in Python\n\n# Adjacency list representation (most common)\ngraph_undirected = {\n    'A': ['B', 'C', 'D'],\n    'B': ['A', 'C'],\n    'C': ['A', 'B', 'D'],\n    'D': ['A', 'C']\n}\n\n# Directed graph\ngraph_directed = {\n    'A': ['B', 'C'],\n    'B': ['C'],\n    'C': ['D'],\n    'D': ['A']\n}\n\n# Weighted graph (adjacency list with weights)\ngraph_weighted = {\n    'A': [('B', 4), ('C', 2)],\n    'B': [('A', 4), ('C', 1), ('D', 5)],\n    'C': [('A', 2), ('B', 1), ('D', 8)],\n    'D': [('B', 5), ('C', 8)]\n}\n\nprint(\"Undirected graph adjacency list:\")\nfor vertex, neighbors in graph_undirected.items():\n    print(f\"  {vertex}: {neighbors}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def compute_degrees(adj_list):\n    \"\"\"Compute degree of each vertex in an undirected graph.\"\"\"\n    degrees = {}\n    for v in adj_list:\n        degrees[v] = len(adj_list[v])\n    return degrees\n\ndef compute_directed_degrees(adj_list):\n    \"\"\"Compute in-degree and out-degree for a directed graph.\"\"\"\n    out_deg = {v: len(adj_list[v]) for v in adj_list}\n    in_deg = {v: 0 for v in adj_list}\n    for v in adj_list:\n        for u in adj_list[v]:\n            in_deg[u] = in_deg.get(u, 0) + 1\n    return in_deg, out_deg\n\n# Undirected degrees\ndegrees = compute_degrees(graph_undirected)\nprint(\"Degrees (undirected):\")\nfor v, d in sorted(degrees.items()):\n    print(f\"  deg({v}) = {d}\")\n\n# Directed degrees\nin_deg, out_deg = compute_directed_degrees(graph_directed)\nprint(\"\\nDegrees (directed):\")\nfor v in sorted(graph_directed.keys()):\n    print(f\"  {v}: in-degree={in_deg[v]}, out-degree={out_deg[v]}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Verify the Handshaking Lemma\ndef count_edges(adj_list):\n    \"\"\"Count edges in an undirected graph (each edge counted once).\"\"\"\n    edge_set = set()\n    for v in adj_list:\n        for u in adj_list[v]:\n            edge = tuple(sorted([v, u]))\n            edge_set.add(edge)\n    return len(edge_set)\n\ndegrees = compute_degrees(graph_undirected)\nsum_degrees = sum(degrees.values())\nnum_edges = count_edges(graph_undirected)\n\nprint(f\"Sum of degrees: {sum_degrees}\")\nprint(f\"2 * |E|: {2 * num_edges}\")\nprint(f\"Handshaking lemma verified: {sum_degrees == 2 * num_edges}\")\n\n# Count vertices with odd degree\nodd_degree_count = sum(1 for d in degrees.values() if d % 2 == 1)\nprint(f\"Vertices with odd degree: {odd_degree_count} (always even)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Generating special graphs\ndef complete_graph(n):\n    \"\"\"Generate the complete graph K_n.\"\"\"\n    vertices = list(range(n))\n    adj = {v: [u for u in vertices if u != v] for v in vertices}\n    return adj\n\ndef cycle_graph(n):\n    \"\"\"Generate the cycle graph C_n.\"\"\"\n    adj = {i: [(i-1) % n, (i+1) % n] for i in range(n)}\n    return adj\n\ndef complete_bipartite(m, n):\n    \"\"\"Generate K_{m,n}.\"\"\"\n    left = [f'L{i}' for i in range(m)]\n    right = [f'R{j}' for j in range(n)]\n    adj = {}\n    for v in left:\n        adj[v] = list(right)\n    for v in right:\n        adj[v] = list(left)\n    return adj\n\n# Properties of complete graphs\nfor n in range(2, 8):\n    k = complete_graph(n)\n    edges = count_edges(k)\n    print(f\"K_{n}: {edges} edges = {n}*{n-1}/2 = {n*(n-1)//2}\")\n\nprint(f\"\\nC_5 degrees: {compute_degrees(cycle_graph(5))}\")\nprint(f\"K_3,4 edges: {count_edges(complete_bipartite(3, 4))} = 3*4 = 12\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def degree_sequence(adj_list):\n    \"\"\"Return the sorted degree sequence of a graph.\"\"\"\n    degrees = [len(neighbors) for neighbors in adj_list.values()]\n    return sorted(degrees, reverse=True)\n\n# Two graphs that might be isomorphic\nG1 = {'a': ['b', 'c'], 'b': ['a', 'd'], 'c': ['a', 'd'], 'd': ['b', 'c']}\nG2 = {1: [2, 4], 2: [1, 3], 3: [2, 4], 4: [1, 3]}\n\nseq1 = degree_sequence(G1)\nseq2 = degree_sequence(G2)\nprint(f\"G1 degree sequence: {seq1}\")\nprint(f\"G2 degree sequence: {seq2}\")\nprint(f\"Could be isomorphic (same degree seq): {seq1 == seq2}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def is_connected(adj_list):\n    \"\"\"Check if an undirected graph is connected using BFS.\"\"\"\n    if not adj_list:\n        return True\n    start = next(iter(adj_list))\n    visited = set()\n    queue = [start]\n    visited.add(start)\n    while queue:\n        v = queue.pop(0)\n        for u in adj_list[v]:\n            if u not in visited:\n                visited.add(u)\n                queue.append(u)\n    return len(visited) == len(adj_list)\n\n# Connected graph\nprint(f\"Graph connected: {is_connected(graph_undirected)}\")\n\n# Disconnected graph\ndisconnected = {\n    'A': ['B'], 'B': ['A'],\n    'C': ['D'], 'D': ['C']\n}\nprint(f\"Disconnected graph connected: {is_connected(disconnected)}\")"
        ]
      ]
    }
