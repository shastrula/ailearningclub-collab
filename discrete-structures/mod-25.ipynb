      "source": [
        [
          "python",
          "from itertools import product\nimport random\n\n# Sample space: rolling two dice\nS_two_dice = [(i, j) for i in range(1, 7) for j in range(1, 7)]\nprint(f\"Two dice: |S| = {len(S_two_dice)}\")\n\n# Event: sum equals 7\nE_sum7 = [(i, j) for i, j in S_two_dice if i + j == 7]\nprint(f\"Sum = 7: |E| = {len(E_sum7)}, P = {len(E_sum7)}/{len(S_two_dice)} = {len(E_sum7)/len(S_two_dice):.4f}\")\n\n# Event: both dice show same number (doubles)\nE_doubles = [(i, j) for i, j in S_two_dice if i == j]\nprint(f\"Doubles: |E| = {len(E_doubles)}, P = {len(E_doubles)/len(S_two_dice):.4f}\")\n\n# Event: sum >= 10\nE_high = [(i, j) for i, j in S_two_dice if i + j >= 10]\nprint(f\"Sum >= 10: |E| = {len(E_high)}, P = {len(E_high)/len(S_two_dice):.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Complement rule: P(at least one 6) = 1 - P(no sixes)\n# When rolling 4 dice\nn_dice = 4\np_no_six_one_die = 5/6\np_no_six_all = p_no_six_one_die ** n_dice\np_at_least_one_six = 1 - p_no_six_all\nprint(f\"P(at least one 6 in {n_dice} dice) = 1 - (5/6)^{n_dice} = {p_at_least_one_six:.4f}\")\n\n# Verify by simulation\ntrials = 100000\nsuccesses = 0\nfor _ in range(trials):\n    rolls = [random.randint(1, 6) for _ in range(n_dice)]\n    if 6 in rolls:\n        successes += 1\nprint(f\"Simulated: {successes/trials:.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Conditional probability example\n# Drawing cards: P(second card is ace | first card was ace)\n# Without replacement from a 52-card deck\n\n# P(both aces) = 4/52 * 3/51 = 12/2652\np_both_aces = (4/52) * (3/51)\n\n# P(first is ace) = 4/52\np_first_ace = 4/52\n\n# P(second ace | first ace) = P(both aces) / P(first ace) = 3/51\np_second_given_first = p_both_aces / p_first_ace\nprint(f\"P(2nd ace | 1st ace) = {p_second_given_first:.4f} = 3/51 = {3/51:.4f}\")\n\n# Independence: two events are independent if P(A|B) = P(A)\n# Equivalently: P(A inter B) = P(A) * P(B)\n\n# Two coin flips are independent\np_hh = 1/4\np_h1 = 1/2\np_h2 = 1/2\nprint(f\"\\nCoin flips independent: P(HH) = {p_hh} = P(H1)*P(H2) = {p_h1*p_h2}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Bayes' Theorem example: Medical testing\n# Disease prevalence: 1% of population has disease\n# Test sensitivity: 99% (P(positive | has disease) = 0.99)\n# Test specificity: 95% (P(negative | no disease) = 0.95)\n# Question: P(has disease | tests positive)?\n\np_disease = 0.01\np_healthy = 0.99\np_pos_given_disease = 0.99    # Sensitivity\np_pos_given_healthy = 0.05    # False positive rate (1 - specificity)\n\n# P(positive) = P(pos|disease)*P(disease) + P(pos|healthy)*P(healthy)\np_positive = p_pos_given_disease * p_disease + p_pos_given_healthy * p_healthy\n\n# Bayes' theorem\np_disease_given_pos = (p_pos_given_disease * p_disease) / p_positive\n\nprint(\"Medical test (Bayes' Theorem):\")\nprint(f\"  Prior P(disease) = {p_disease}\")\nprint(f\"  P(positive) = {p_positive:.4f}\")\nprint(f\"  P(disease | positive) = {p_disease_given_pos:.4f}\")\nprint(f\"  Surprisingly low! Most positives are false positives.\")\nprint(f\"  This is because the disease is rare (base rate fallacy)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Random variable: sum of two dice\ndef dice_sum_distribution():\n    \"\"\"Compute the distribution of the sum of two dice.\"\"\"\n    S = [(i, j) for i in range(1, 7) for j in range(1, 7)]\n    dist = {}\n    for outcome in S:\n        total = sum(outcome)\n        dist[total] = dist.get(total, 0) + 1/36\n    return dist\n\ndist = dice_sum_distribution()\nprint(\"Distribution of sum of two dice:\")\nprint(f\"{'Sum':<5} {'P(X=k)':<10} {'Bar'}\")\nfor k in sorted(dist.keys()):\n    bar = '#' * int(dist[k] * 72)\n    print(f\"  {k:<3} {dist[k]:.4f}    {bar}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def expected_value(distribution):\n    \"\"\"Compute E[X] from a probability distribution {value: probability}.\"\"\"\n    return sum(x * p for x, p in distribution.items())\n\n# Expected sum of two dice\nex_two_dice = expected_value(dice_sum_distribution())\nprint(f\"E[sum of two dice] = {ex_two_dice}\")  # 7\n\n# Expected value of a single die\nsingle_die = {i: 1/6 for i in range(1, 7)}\nex_single = expected_value(single_die)\nprint(f\"E[single die] = {ex_single}\")  # 3.5\nprint(f\"E[two dice] = 2 * E[one die] = {2 * ex_single}\")  # Linearity!\n\n# Application: expected number of comparisons in linear search\n# Searching for an element known to be in a list of n elements\n# If equally likely to be at any position: E[comparisons] = (n+1)/2\nn = 100\nexpected_linear_search = (n + 1) / 2\nprint(f\"\\nLinear search in list of {n}: E[comparisons] = {expected_linear_search}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import math\n\ndef variance(distribution):\n    \"\"\"Compute Var(X) from a probability distribution.\"\"\"\n    ex = expected_value(distribution)\n    ex_squared = sum(x**2 * p for x, p in distribution.items())\n    return ex_squared - ex**2\n\n# Variance of a single die\nvar_die = variance(single_die)\nstd_die = math.sqrt(var_die)\nprint(f\"Single die: E[X]={expected_value(single_die):.4f}, Var(X)={var_die:.4f}, SD={std_die:.4f}\")\n\n# Compare: fair coin (X=0 or 1)\ncoin = {0: 0.5, 1: 0.5}\nprint(f\"Fair coin: E[X]={expected_value(coin):.4f}, Var(X)={variance(coin):.4f}\")\n\n# Loaded die vs fair die\nfair = {i: 1/6 for i in range(1, 7)}\nloaded = {1: 0.1, 2: 0.1, 3: 0.1, 4: 0.1, 5: 0.1, 6: 0.5}\nprint(f\"\\nFair die: E={expected_value(fair):.2f}, Var={variance(fair):.4f}\")\nprint(f\"Loaded die: E={expected_value(loaded):.2f}, Var={variance(loaded):.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Simulate QuickSort comparisons\ndef quicksort_comparisons(arr):\n    \"\"\"Count comparisons in randomized QuickSort.\"\"\"\n    if len(arr) <= 1:\n        return 0\n    pivot = random.choice(arr)\n    left = [x for x in arr if x < pivot]\n    middle = [x for x in arr if x == pivot]\n    right = [x for x in arr if x > pivot]\n    # Each non-pivot element is compared to pivot once\n    comparisons = len(arr) - len(middle)\n    return comparisons + quicksort_comparisons(left) + quicksort_comparisons(right)\n\n# Average over many trials\nn = 100\ntrials = 1000\ntotal_comparisons = sum(quicksort_comparisons(list(range(n))) for _ in range(trials))\navg_comparisons = total_comparisons / trials\nexpected_theory = 2 * n * math.log(n)  # Approximately 2n*ln(n)\n\nprint(f\"QuickSort on n={n}:\")\nprint(f\"  Average comparisons (simulated): {avg_comparisons:.1f}\")\nprint(f\"  Expected (2n*ln(n)): {expected_theory:.1f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
