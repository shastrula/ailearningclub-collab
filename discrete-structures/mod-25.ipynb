        [
          "python",
          "def birthday_probability(n):\n    \"\"\"P(at least two share birthday) in group of n people.\"\"\"\n    # P(all different) = 365/365 * 364/365 * ... * (365-n+1)/365\n    p_all_different = 1.0\n    for i in range(n):\n        p_all_different *= (365 - i) / 365\n    return 1 - p_all_different\n\nprint(\"Birthday Problem:\")\nfor n in [10, 20, 23, 30, 40, 50, 57, 70]:\n    p = birthday_probability(n)\n    print(f\"  n={n:2d} people: P(shared birthday) = {p:.4f}\")\n\n# The threshold is surprisingly low: ~23 people for 50% probability\n# This explains why hash collisions happen sooner than expected"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Binomial distribution: number of successes in n independent trials\ndef binomial_prob(n, k, p):\n    \"\"\"P(X = k) for binomial(n, p).\"\"\"\n    from math import comb\n    return comb(n, k) * p**k * (1-p)**(n-k)\n\n# Example: probability of exactly k heads in 10 coin flips\nn, p = 10, 0.5\nprint(f\"\\nBinomial(n={n}, p={p}):\")\nprint(f\"  E[X] = np = {n*p}\")\nprint(f\"  Var(X) = np(1-p) = {n*p*(1-p)}\")\nfor k in range(n + 1):\n    prob = binomial_prob(n, k, p)\n    bar = '#' * int(prob * 50)\n    print(f\"  P(X={k:2d}) = {prob:.4f} {bar}\")"
        ]
      ]
