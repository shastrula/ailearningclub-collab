          "python",
          "def hamiltonian_path(adj_list, start=None):\n    \"\"\"Find a Hamiltonian path using backtracking (exponential time).\"\"\"\n    vertices = list(adj_list.keys())\n    n = len(vertices)\n    \n    def backtrack(path, visited):\n        if len(path) == n:\n            return path[:]\n        current = path[-1]\n        for neighbor in adj_list[current]:\n            if neighbor not in visited:\n                path.append(neighbor)\n                visited.add(neighbor)\n                result = backtrack(path, visited)\n                if result:\n                    return result\n                path.pop()\n                visited.remove(neighbor)\n        return None\n    \n    starts = [start] if start else vertices\n    for s in starts:\n        result = backtrack([s], {s})\n        if result:\n            return result\n    return None\n\n# Graph with Hamiltonian path\ngraph = {\n    'A': ['B', 'C'],\n    'B': ['A', 'C', 'D'],\n    'C': ['A', 'B', 'D', 'E'],\n    'D': ['B', 'C', 'E'],\n    'E': ['C', 'D']\n}\n\npath = hamiltonian_path(graph)\nprint(f\"Hamiltonian path: {' -> '.join(path) if path else 'None found'}\")\n\n# Check if it's a valid Hamiltonian path\nif path:\n    all_visited = len(set(path)) == len(graph)\n    edges_valid = all(path[i+1] in graph[path[i]] for i in range(len(path)-1))\n    print(f\"Valid: all vertices visited={all_visited}, all edges exist={edges_valid}\")"
        ]
