          "python",
          "from itertools import permutations\n\ndef tsp_brute_force(distances):\n    \"\"\"\n    Solve TSP by brute force.\n    distances: dict of {(u,v): weight}\n    \"\"\"\n    cities = list(set(c for edge in distances for c in edge))\n    n = len(cities)\n    start = cities[0]\n    others = cities[1:]\n    \n    best_tour = None\n    best_cost = float('inf')\n    \n    for perm in permutations(others):\n        tour = [start] + list(perm) + [start]\n        cost = sum(distances.get((tour[i], tour[i+1]), distances.get((tour[i+1], tour[i]), float('inf')))\n                   for i in range(n))\n        if cost < best_cost:\n            best_cost = cost\n            best_tour = tour\n    \n    return best_tour, best_cost\n\n# Small TSP instance\ndistances = {\n    ('A','B'): 10, ('A','C'): 15, ('A','D'): 20,\n    ('B','A'): 10, ('B','C'): 35, ('B','D'): 25,\n    ('C','A'): 15, ('C','B'): 35, ('C','D'): 30,\n    ('D','A'): 20, ('D','B'): 25, ('D','C'): 30\n}\n\ntour, cost = tsp_brute_force(distances)\nprint(f\"TSP optimal tour: {' -> '.join(tour)}\")\nprint(f\"Total cost: {cost}\")"
        ]
      ]
