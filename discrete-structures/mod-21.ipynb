        [
          "python",
          "def euler_analysis(adj_list):\n    \"\"\"Determine if a graph has an Euler path or circuit.\"\"\"\n    # Check connectivity first\n    from collections import deque\n    start = next(iter(adj_list))\n    visited = {start}\n    queue = deque([start])\n    while queue:\n        v = queue.popleft()\n        for u in adj_list[v]:\n            if u not in visited:\n                visited.add(u)\n                queue.append(u)\n    \n    if len(visited) != len(adj_list):\n        return \"Not connected - no Euler path\"\n    \n    # Count vertices with odd degree\n    odd_vertices = [v for v in adj_list if len(adj_list[v]) % 2 == 1]\n    \n    if len(odd_vertices) == 0:\n        return \"Euler CIRCUIT exists (all degrees even)\"\n    elif len(odd_vertices) == 2:\n        return f\"Euler PATH exists (odd degree at {odd_vertices})\"\n    else:\n        return f\"No Euler path ({len(odd_vertices)} odd-degree vertices)\"\n\n# Konigsberg Bridge graph (no Euler path)\nkonigsberg = {\n    'A': ['B', 'B', 'C', 'C', 'D'],\n    'B': ['A', 'A', 'C', 'D'],\n    'C': ['A', 'A', 'B', 'D'],\n    'D': ['A', 'B', 'C']\n}\nprint(f\"Konigsberg: {euler_analysis(konigsberg)}\")\n\n# Graph with Euler circuit\neuler_circuit_graph = {\n    'A': ['B', 'D'],\n    'B': ['A', 'C'],\n    'C': ['B', 'D'],\n    'D': ['C', 'A']\n}\nprint(f\"Square: {euler_analysis(euler_circuit_graph)}\")\n\n# Graph with Euler path (not circuit)\neuler_path_graph = {\n    'A': ['B', 'C'],\n    'B': ['A', 'C', 'D'],\n    'C': ['A', 'B', 'D'],\n    'D': ['B', 'C']\n}\nprint(f\"With 2 odd: {euler_analysis(euler_path_graph)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
