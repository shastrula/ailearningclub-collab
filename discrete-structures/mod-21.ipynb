        [
          "python",
          "def euler_directed_analysis(adj_list):\n    \"\"\"Analyze Euler path/circuit existence in directed graph.\"\"\"\n    in_deg = defaultdict(int)\n    out_deg = defaultdict(int)\n    \n    for v in adj_list:\n        out_deg[v] = len(adj_list[v])\n        for u in adj_list[v]:\n            in_deg[u] += 1\n    \n    start_candidates = []  # out - in = 1\n    end_candidates = []    # in - out = 1\n    balanced = 0\n    \n    all_vertices = set(adj_list.keys()) | set(in_deg.keys())\n    for v in all_vertices:\n        diff = out_deg.get(v, 0) - in_deg.get(v, 0)\n        if diff == 0:\n            balanced += 1\n        elif diff == 1:\n            start_candidates.append(v)\n        elif diff == -1:\n            end_candidates.append(v)\n        else:\n            return \"No Euler path\"\n    \n    if len(start_candidates) == 0 and len(end_candidates) == 0:\n        return \"Euler CIRCUIT exists\"\n    elif len(start_candidates) == 1 and len(end_candidates) == 1:\n        return f\"Euler PATH exists: {start_candidates[0]} -> {end_candidates[0]}\"\n    return \"No Euler path\"\n\n# Directed graph with Euler circuit\ndg1 = {'A': ['B'], 'B': ['C'], 'C': ['A']}\nprint(f\"Directed triangle: {euler_directed_analysis(dg1)}\")\n\n# Directed graph with Euler path\ndg2 = {'A': ['B'], 'B': ['C'], 'C': []}\nprint(f\"Directed path: {euler_directed_analysis(dg2)}\")"
        ]
      ]
    },
