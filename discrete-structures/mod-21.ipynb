        [
          "python",
          "from collections import defaultdict\n\ndef find_euler_circuit(edges, start):\n    \"\"\"\n    Find an Euler circuit using Hierholzer's algorithm.\n    edges: list of (u, v) tuples\n    \"\"\"\n    # Build adjacency list with edge indices for removal\n    adj = defaultdict(list)\n    for i, (u, v) in enumerate(edges):\n        adj[u].append((v, i))\n        adj[v].append((u, i))\n    \n    used = [False] * len(edges)\n    circuit = []\n    stack = [start]\n    \n    while stack:\n        v = stack[-1]\n        found_edge = False\n        while adj[v]:\n            u, idx = adj[v].pop()\n            if not used[idx]:\n                used[idx] = True\n                stack.append(u)\n                found_edge = True\n                break\n        if not found_edge:\n            circuit.append(stack.pop())\n    \n    return circuit\n\n# Example: Find Euler circuit in a graph where all degrees are even\nedges = [('A','B'), ('B','C'), ('C','D'), ('D','A'), ('A','C'), ('B','D')]\ncircuit = find_euler_circuit(edges, 'A')\nprint(f\"Euler circuit: {' -> '.join(circuit)}\")\nprint(f\"Edges traversed: {len(circuit) - 1} (total edges: {len(edges)})\")"
        ]
      ]
    },
    {
