        [
          "python",
          "def euler_totient(n):\n    \"\"\"Compute Euler's totient function using inclusion-exclusion.\"\"\"\n    result = n\n    p = 2\n    temp = n\n    while p * p <= temp:\n        if temp % p == 0:\n            while temp % p == 0:\n                temp //= p\n            result -= result // p\n        p += 1\n    if temp > 1:\n        result -= result // temp\n    return result\n\n# Display totient values\nprint(\"Euler's totient phi(n):\")\nfor n in range(1, 21):\n    print(f\"  phi({n:2d}) = {euler_totient(n):2d}\")\n\n# Verify: sum of phi(d) for all divisors d of n equals n\nn = 12\ndivisors = [d for d in range(1, n+1) if n % d == 0]\nphi_sum = sum(euler_totient(d) for d in divisors)\nprint(f\"\\nSum of phi(d) for divisors of {n}: {phi_sum} (should equal {n})\")"
        ]
      ]
