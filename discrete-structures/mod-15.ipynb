          "python",
          "# Inclusion-exclusion for three sets\ndef inclusion_exclusion_3(A, B, C):\n    \"\"\"Count |A union B union C| using inclusion-exclusion.\"\"\"\n    return (len(A) + len(B) + len(C) \n            - len(A & B) - len(A & C) - len(B & C) \n            + len(A & B & C))\n\nA = {i for i in range(1, 101) if i % 2 == 0}  # Multiples of 2\nB = {i for i in range(1, 101) if i % 3 == 0}  # Multiples of 3\nC = {i for i in range(1, 101) if i % 5 == 0}  # Multiples of 5\n\nie_count = inclusion_exclusion_3(A, B, C)\ndirect_count = len(A | B | C)\nprint(f\"Numbers 1-100 divisible by 2, 3, or 5:\")\nprint(f\"  Inclusion-exclusion: {ie_count}\")\nprint(f\"  Direct count: {direct_count}\")\nprint(f\"  Match: {ie_count == direct_count}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Counting derangements\ndef derangements(n):\n    \"\"\"Count derangements of n elements using inclusion-exclusion.\"\"\"\n    total = 0\n    for k in range(n + 1):\n        total += ((-1)**k * math.factorial(n)) // math.factorial(k)\n    return total\n\ndef derangements_brute(n):\n    \"\"\"Count derangements by enumeration.\"\"\"\n    from itertools import permutations\n    count = 0\n    original = list(range(n))\n    for perm in permutations(original):\n        if all(perm[i] != i for i in range(n)):\n            count += 1\n    return count\n\nprint(\"Derangements D(n):\")\nprint(f\"{'n':<4} {'D(n)':<10} {'n!':<10} {'D(n)/n!':<10}\")\nfor n in range(1, 10):\n    d = derangements(n)\n    nf = math.factorial(n)\n    ratio = d / nf\n    print(f\"{n:<4} {d:<10} {nf:<10} {ratio:<10.6f}\")\n\nprint(f\"\\nD(n)/n! approaches 1/e = {1/math.e:.6f}\")"
        ]
      ]
    },
    {
