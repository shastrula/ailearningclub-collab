      "outputs": [],
      "source": [
        [
          "python",
          "import random\n\n# Demonstrate: in 13 random people, at least 2 share a birth month\ndef birthday_month_experiment(n_people=13):\n    \"\"\"Show that with 13 people, a shared month is guaranteed.\"\"\"\n    months = [random.randint(1, 12) for _ in range(n_people)]\n    month_counts = {}\n    for m in months:\n        month_counts[m] = month_counts.get(m, 0) + 1\n    \n    max_sharing = max(month_counts.values())\n    shared_month = [m for m, c in month_counts.items() if c >= 2]\n    return max_sharing >= 2, shared_month\n\n# Run 1000 trials - should always find a collision\nall_collision = all(birthday_month_experiment()[0] for _ in range(1000))\nprint(f\"13 people always share a birth month: {all_collision}\")\n\n# Remainder example: 5 integers always have 2 with same remainder mod 4\ndef remainder_collision(numbers, mod):\n    remainders = [n % mod for n in numbers]\n    seen = {}\n    for i, r in enumerate(remainders):\n        if r in seen:\n            return True, (numbers[seen[r]], numbers[i], r)\n        seen[r] = i\n    return False, None\n\nnums = [17, 23, 8, 31, 42]\ncollision, details = remainder_collision(nums, 4)\nprint(f\"\\nNumbers: {nums}\")\nprint(f\"Collision mod 4: {collision}\")\nprint(f\"  {details[0]} and {details[1]} both have remainder {details[2]}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import math\n\ndef generalized_pigeonhole(n_objects, n_boxes):\n    \"\"\"At least this many objects must be in some box.\"\"\"\n    return math.ceil(n_objects / n_boxes)\n\n# Examples\nprint(f\"100 people, 12 months: at least {generalized_pigeonhole(100, 12)} share a month\")\nprint(f\"50 students, 7 days: at least {generalized_pigeonhole(50, 7)} born on same day of week\")\nprint(f\"1000 IPs, 256 subnets: at least {generalized_pigeonhole(1000, 256)} in one subnet\")\n\n# Application: Hash table load\ntable_size = 1000\nn_keys = 5000\nmin_collision = generalized_pigeonhole(n_keys, table_size)\nprint(f\"\\n{n_keys} keys in hash table of size {table_size}:\")\nprint(f\"  At least one bucket has >= {min_collision} keys\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Hash function collision demonstration\n# MD5 produces 128-bit output: 2^128 possible values\n# But there are infinitely many possible inputs\n# So collisions MUST exist (pigeonhole principle)\n\n# Simplified demonstration with a small hash\ndef simple_hash(s, table_size=10):\n    \"\"\"A simple hash function mapping strings to [0, table_size).\"\"\"\n    return sum(ord(c) for c in s) % table_size\n\n# With 11 strings and 10 hash values, collision guaranteed\nstrings = [\"apple\", \"banana\", \"cherry\", \"date\", \"elderberry\",\n           \"fig\", \"grape\", \"honeydew\", \"kiwi\", \"lemon\", \"mango\"]\n\nhash_values = {}\nfor s in strings:\n    h = simple_hash(s)\n    if h not in hash_values:\n        hash_values[h] = []\n    hash_values[h].append(s)\n\nprint(\"Hash collisions (table_size=10, 11 strings):\")\nfor h, items in hash_values.items():\n    if len(items) > 1:\n        print(f\"  Hash {h}: {items}\")"
        ]
      ]
    },
    {
