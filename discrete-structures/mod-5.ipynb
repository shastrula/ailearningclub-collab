      "source": [
        "# Discrete Structures - mod-5\n\n",
        "**Course:** discrete-structures\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Validating rules of inference using truth tables\nfrom itertools import product\n\ndef validate_inference(premises, conclusion, n_vars):\n    \"\"\"\n    Check if an inference rule is valid:\n    whenever ALL premises are true, the conclusion must be true.\n    \"\"\"\n    for values in product([True, False], repeat=n_vars):\n        all_premises_true = all(p(*values) for p in premises)\n        if all_premises_true and not conclusion(*values):\n            return False, values  # Found counterexample\n    return True, None\n\n# Validate Modus Ponens: p->q, p |- q\npremise1 = lambda p, q: (not p) or q   # p -> q\npremise2 = lambda p, q: p              # p\nconclusion = lambda p, q: q            # q\n\nvalid, _ = validate_inference([premise1, premise2], conclusion, 2)\nprint(f\"Modus Ponens is valid: {valid}\")  # True\n\n# Validate Hypothetical Syllogism: p->q, q->r |- p->r\nprem1 = lambda p, q, r: (not p) or q   # p -> q\nprem2 = lambda p, q, r: (not q) or r   # q -> r\nconc = lambda p, q, r: (not p) or r    # p -> r\n\nvalid, _ = validate_inference([prem1, prem2], conc, 3)\nprint(f\"Hypothetical Syllogism is valid: {valid}\")  # True"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Demonstrate that affirming the consequent is invalid\nprem1 = lambda p, q: (not p) or q   # p -> q\nprem2 = lambda p, q: q              # q\nconc = lambda p, q: p               # p (claimed conclusion)\n\nvalid, counter = validate_inference([prem1, prem2], conc, 2)\nprint(f\"Affirming consequent valid: {valid}, counterexample: {counter}\")\n# False, counterexample: (False, True) \u2014 q is true but p is false"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Computational verification of proof by cases\ndef verify_n_squared_plus_n_even(limit):\n    \"\"\"Verify n^2 + n is even for all n in range.\"\"\"\n    for n in range(-limit, limit + 1):\n        value = n**2 + n\n        if value % 2 != 0:\n            return False, n\n    return True, None\n\nresult, counter = verify_n_squared_plus_n_even(10000)\nprint(f\"n^2 + n is always even (tested -10000 to 10000): {result}\")\n\n# We can also prove it algebraically: n^2 + n = n(n+1)\n# n and n+1 are consecutive integers, so one must be even\n# Therefore their product is always even\nprint(\"Algebraic reason: n(n+1) is product of consecutive integers\")"
        ]
      ]
    }
