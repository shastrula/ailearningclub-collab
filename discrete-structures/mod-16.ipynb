      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Simulating divide-and-conquer recurrences\ndef simulate_dc(a, b, f, n):\n    \"\"\"Simulate T(n) = a*T(n/b) + f(n), T(1) = 1.\"\"\"\n    if n <= 1:\n        return 1\n    return a * simulate_dc(a, b, f, n // b) + f(n)\n\n# Merge sort: T(n) = 2T(n/2) + n\nprint(\"Merge sort T(n) = 2T(n/2) + n:\")\nfor k in range(1, 11):\n    n = 2**k\n    t = simulate_dc(2, 2, lambda x: x, n)\n    print(f\"  T({n:4d}) = {t:6d}, n*log2(n) = {n*k:6d}\")"
        ]
      ]
    }
