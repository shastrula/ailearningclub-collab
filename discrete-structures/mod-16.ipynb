    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Computing recurrence relations iteratively\ndef compute_recurrence(relation, initial, n):\n    \"\"\"\n    Compute terms of a recurrence relation.\n    relation: function(sequence, n) -> next term\n    initial: list of initial values\n    n: compute up to index n\n    \"\"\"\n    seq = list(initial)\n    for i in range(len(initial), n + 1):\n        seq.append(relation(seq, i))\n    return seq\n\n# Fibonacci\nfib = compute_recurrence(\n    lambda s, i: s[i-1] + s[i-2],\n    [0, 1],\n    15\n)\nprint(f\"Fibonacci: {fib}\")\n\n# Tower of Hanoi: T(n) = 2*T(n-1) + 1, T(0) = 0\nhanoi = compute_recurrence(\n    lambda s, i: 2 * s[i-1] + 1,\n    [0],\n    10\n)\nprint(f\"Hanoi moves: {hanoi}\")\n# Note: T(n) = 2^n - 1"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Tower of Hanoi - recursive implementation with counting\ndef hanoi_solve(n, source='A', target='C', auxiliary='B'):\n    \"\"\"Solve Tower of Hanoi and return number of moves.\"\"\"\n    if n == 0:\n        return 0\n    moves = 0\n    moves += hanoi_solve(n - 1, source, auxiliary, target)\n    moves += 1  # Move the nth disk\n    moves += hanoi_solve(n - 1, auxiliary, target, source)\n    return moves\n\n# Verify against formula T(n) = 2^n - 1\nfor n in range(1, 11):\n    recursive = hanoi_solve(n)\n    formula = 2**n - 1\n    print(f\"T({n:2d}) = {recursive:4d} = 2^{n} - 1 = {formula:4d}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Bit strings without consecutive 1s\ndef count_no_consecutive_ones(n):\n    \"\"\"Count n-bit strings with no consecutive 1s.\"\"\"\n    if n == 1:\n        return 2  # \"0\", \"1\"\n    if n == 2:\n        return 3  # \"00\", \"01\", \"10\"\n    a, b = 2, 3\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b\n\n# Verify by brute force for small n\ndef brute_force_no_consec(n):\n    count = 0\n    for i in range(2**n):\n        bits = f\"{i:0{n}b}\"\n        if '11' not in bits:\n            count += 1\n    return count\n\nprint(\"Bit strings with no consecutive 1s:\")\nfor n in range(1, 12):\n    formula = count_no_consecutive_ones(n)\n    brute = brute_force_no_consec(n) if n <= 15 else \"...\"\n    print(f\"  n={n:2d}: {formula:5d} (verified: {brute})\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Climbing stairs\ndef climb_stairs(n):\n    \"\"\"Number of ways to climb n stairs (1 or 2 steps at a time).\"\"\"\n    if n <= 2:\n        return n\n    a, b = 1, 2\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b\n\nfor n in range(1, 11):\n    print(f\"  Stairs={n}: {climb_stairs(n)} ways\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# General linear recurrence solver (iterative)\ndef solve_linear_recurrence(coefficients, initial, extra_fn, n):\n    \"\"\"\n    Solve a_n = c1*a_{n-1} + c2*a_{n-2} + ... + f(n)\n    coefficients: [c1, c2, ..., ck]\n    initial: [a_0, a_1, ..., a_{k-1}]\n    extra_fn: function f(n) for non-homogeneous part (or lambda n: 0)\n    n: compute up to index n\n    \"\"\"\n    k = len(coefficients)\n    seq = list(initial)\n    for i in range(k, n + 1):\n        val = sum(coefficients[j] * seq[i - 1 - j] for j in range(k))\n        val += extra_fn(i)\n        seq.append(val)\n    return seq\n\n# Fibonacci: a_n = a_{n-1} + a_{n-2}\nfib = solve_linear_recurrence([1, 1], [0, 1], lambda n: 0, 15)\nprint(f\"Fibonacci: {fib}\")\n\n# Hanoi: a_n = 2*a_{n-1} + 1\nhanoi = solve_linear_recurrence([2], [0], lambda n: 1, 10)\nprint(f\"Hanoi: {hanoi}\")\n\n# a_n = 3*a_{n-1} - 2*a_{n-2}, a_0=1, a_1=3\ncustom = solve_linear_recurrence([3, -2], [1, 3], lambda n: 0, 10)\nprint(f\"Custom: {custom}\")\n# Solution is a_n = 2^{n+1} - 1\nverify = [2**(n+1) - 1 for n in range(11)]\nprint(f\"Verify: {verify}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
