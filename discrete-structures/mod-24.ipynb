          "python",
          "# Diffie-Hellman Key Exchange (simplified)\n# Public parameters\np = 23      # Prime modulus\ng = 5       # Generator\n\n# Alice's secret\na = 6       # Alice's private key\nA = pow(g, a, p)  # Alice's public value\n\n# Bob's secret\nb = 15      # Bob's private key\nB = pow(g, b, p)  # Bob's public value\n\n# Shared secret computation\nalice_secret = pow(B, a, p)  # Alice computes B^a mod p\nbob_secret = pow(A, b, p)    # Bob computes A^b mod p\n\nprint(\"Diffie-Hellman Key Exchange:\")\nprint(f\"  Public: p={p}, g={g}\")\nprint(f\"  Alice: private={a}, public A={A}\")\nprint(f\"  Bob: private={b}, public B={B}\")\nprint(f\"  Alice's shared secret: {alice_secret}\")\nprint(f\"  Bob's shared secret: {bob_secret}\")\nprint(f\"  Match: {alice_secret == bob_secret}\")\n# Both compute g^(ab) mod p without either knowing the other's private key"
        ]
      ]
