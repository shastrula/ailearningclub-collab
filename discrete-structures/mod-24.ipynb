      "source": [
        [
          "python",
          "# Modular arithmetic in Python\n# Python's % operator handles modular arithmetic\n\nprint(\"Modular arithmetic examples:\")\nprint(f\"  17 mod 5 = {17 % 5}\")        # 2\nprint(f\"  -3 mod 7 = {-3 % 7}\")        # 4 (Python gives non-negative result)\nprint(f\"  100 mod 10 = {100 % 10}\")     # 0\n\n# Properties\nm = 13\na, b, c, d = 7, 20, 5, 18\n# 7 = 20 (mod 13) since both have remainder 7\n# 5 = 18 (mod 13) since both have remainder 5\nprint(f\"\\n  {a} = {b} (mod {m}): {a % m == b % m}\")\nprint(f\"  {c} = {d} (mod {m}): {c % m == d % m}\")\nprint(f\"  ({a}+{c}) mod {m} = {(a+c) % m}\")\nprint(f\"  ({b}+{d}) mod {m} = {(b+d) % m}\")\nprint(f\"  ({a}*{c}) mod {m} = {(a*c) % m}\")\nprint(f\"  ({b}*{d}) mod {m} = {(b*d) % m}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def gcd(a, b):\n    \"\"\"Euclidean algorithm for GCD.\"\"\"\n    while b != 0:\n        a, b = b, a % b\n    return a\n\ndef extended_gcd(a, b):\n    \"\"\"\n    Extended Euclidean Algorithm.\n    Returns (gcd, x, y) such that a*x + b*y = gcd(a,b)\n    \"\"\"\n    if a == 0:\n        return b, 0, 1\n    g, x, y = extended_gcd(b % a, a)\n    return g, y - (b // a) * x, x\n\n# Examples\nprint(f\"gcd(252, 105) = {gcd(252, 105)}\")  # 21\nprint(f\"gcd(17, 13) = {gcd(17, 13)}\")      # 1 (coprime)\n\n# Extended GCD: find x, y such that 17x + 13y = gcd(17,13) = 1\ng, x, y = extended_gcd(17, 13)\nprint(f\"\\nExtended GCD: 17*({x}) + 13*({y}) = {17*x + 13*y}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def mod_inverse(a, m):\n    \"\"\"Find modular inverse of a mod m using extended GCD.\"\"\"\n    g, x, _ = extended_gcd(a % m, m)\n    if g != 1:\n        return None  # Inverse doesn't exist\n    return x % m\n\n# Examples\nprint(\"Modular inverses:\")\nm = 26  # Used in affine ciphers\nfor a in range(1, 26):\n    inv = mod_inverse(a, m)\n    if inv is not None:\n        print(f\"  {a:2d}^(-1) mod {m} = {inv:2d}  (verify: {a}*{inv} mod {m} = {(a*inv) % m})\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def mod_pow(base, exp, mod):\n    \"\"\"Fast modular exponentiation: base^exp mod mod.\"\"\"\n    result = 1\n    base = base % mod\n    while exp > 0:\n        if exp % 2 == 1:\n            result = (result * base) % mod\n        exp = exp >> 1\n        base = (base * base) % mod\n    return result\n\n# Python has built-in: pow(base, exp, mod)\nprint(\"Fast modular exponentiation:\")\nprint(f\"  2^100 mod 13 = {mod_pow(2, 100, 13)}\")\nprint(f\"  Built-in: pow(2, 100, 13) = {pow(2, 100, 13)}\")\nprint(f\"  7^256 mod 11 = {pow(7, 256, 11)}\")\n\n# This would be impossible without modular arithmetic:\n# 2^100 has 31 digits, but we only need the remainder"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Verify Fermat's Little Theorem\ndef verify_fermat(p):\n    \"\"\"Verify a^(p-1) = 1 (mod p) for all a not divisible by p.\"\"\"\n    for a in range(1, p):\n        result = pow(a, p - 1, p)\n        if result != 1:\n            return False, a\n    return True, None\n\n# Test for several primes\nprimes = [5, 7, 11, 13, 17, 23, 97]\nfor p in primes:\n    valid, _ = verify_fermat(p)\n    print(f\"  Fermat's theorem holds for p={p}: {valid}\")\n\n# Using Fermat's for modular inverse\np = 17\na = 5\ninverse_fermat = pow(a, p - 2, p)\ninverse_ext_gcd = mod_inverse(a, p)\nprint(f\"\\n  Inverse of {a} mod {p}:\")\nprint(f\"    Fermat's method: {inverse_fermat}\")\nprint(f\"    Extended GCD: {inverse_ext_gcd}\")\nprint(f\"    Verify: {a} * {inverse_fermat} mod {p} = {(a * inverse_fermat) % p}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import random\n\ndef is_prime(n):\n    \"\"\"Simple primality test.\"\"\"\n    if n < 2:\n        return False\n    if n < 4:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef generate_rsa_keys(p, q):\n    \"\"\"Generate RSA key pair from primes p and q.\"\"\"\n    n = p * q\n    phi_n = (p - 1) * (q - 1)\n    \n    # Choose e (coprime with phi_n)\n    e = 65537\n    if gcd(e, phi_n) != 1:\n        e = 3\n        while gcd(e, phi_n) != 1:\n            e += 2\n    \n    # Compute d (modular inverse of e)\n    d = mod_inverse(e, phi_n)\n    \n    return (n, e), (n, d)\n\ndef rsa_encrypt(message, public_key):\n    \"\"\"Encrypt a number using RSA.\"\"\"\n    n, e = public_key\n    return pow(message, e, n)\n\ndef rsa_decrypt(ciphertext, private_key):\n    \"\"\"Decrypt using RSA.\"\"\"\n    n, d = private_key\n    return pow(ciphertext, d, n)\n\n# Demo with small primes (real RSA uses 1024+ bit primes)\np, q = 61, 53\npublic_key, private_key = generate_rsa_keys(p, q)\nn, e = public_key\n_, d = private_key\n\nprint(f\"RSA Key Generation:\")\nprint(f\"  p = {p}, q = {q}\")\nprint(f\"  n = p*q = {n}\")\nprint(f\"  phi(n) = {(p-1)*(q-1)}\")\nprint(f\"  Public key (n, e) = ({n}, {e})\")\nprint(f\"  Private key (n, d) = ({n}, {d})\")\n\n# Encrypt and decrypt\nmessage = 42\nciphertext = rsa_encrypt(message, public_key)\ndecrypted = rsa_decrypt(ciphertext, private_key)\n\nprint(f\"\\n  Original message: {message}\")\nprint(f\"  Encrypted: {ciphertext}\")\nprint(f\"  Decrypted: {decrypted}\")\nprint(f\"  Success: {message == decrypted}\")\n\n# Encrypt a word (letter by letter)\nprint(\"\\nEncrypting 'HELLO':\")\nfor char in \"HELLO\":\n    m = ord(char)\n    c = rsa_encrypt(m, public_key)\n    d_char = chr(rsa_decrypt(c, private_key))\n    print(f\"  '{char}' (={m}) -> {c} -> '{d_char}'\")"
        ]
      ]
    },
