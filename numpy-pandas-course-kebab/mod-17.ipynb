      "source": [
        "# Numpy Pandas Course Kebab - mod-17\n\n",
        "**Course:** numpy-pandas-course-kebab\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import seaborn as sns\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\n\n# Load example data\ntips = sns.load_dataset('tips')\n\n# Create figure with subplots\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\n# histplot with KDE (axes-level)\nsns.histplot(data=tips, x='total_bill', kde=True, ax=axes[0])\naxes[0].set_title('Distribution of Total Bill')\n\n# histplot with bin control\nsns.histplot(data=tips, x='total_bill', bins=30, stat='density', ax=axes[1])\naxes[1].set_title('Density Histogram')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Multi-variate histogram\nfig, ax = plt.subplots(figsize=(10, 5))\nsns.histplot(\n    data=tips,\n    x='total_bill',\n    hue='sex',\n    kde=True,\n    stat='density',\n    ax=ax\n)\nax.set_title('Bill Distribution by Sex')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Scatter plot with style and size encoding\nfig, ax = plt.subplots(figsize=(10, 6))\nsns.scatterplot(\n    data=tips,\n    x='total_bill',\n    y='tip',\n    hue='sex',\n    style='time',\n    size='party_size',\n    sizes=(50, 200),\n    ax=ax\n)\nax.set_title('Tips vs Bill Amount')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Figure-level relational plot with faceting\ng = sns.relplot(\n    data=tips,\n    x='total_bill',\n    y='tip',\n    hue='sex',\n    col='time',\n    row='day',\n    height=4,\n    aspect=1\n)\ng.set_axis_labels('Total Bill ($)', 'Tip ($)')"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Box plot with swarm overlay\nfig, ax = plt.subplots(figsize=(10, 5))\nsns.boxplot(data=tips, x='day', y='total_bill', hue='sex', ax=ax)\nsns.swarmplot(data=tips, x='day', y='total_bill', hue='sex', \n              dodge=True, color='black', alpha=0.3, ax=ax)\nax.set_title('Bill Distribution by Day and Sex')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Figure-level categorical plot\ng = sns.catplot(\n    data=tips,\n    x='day',\n    y='total_bill',\n    hue='sex',\n    col='time',\n    kind='violin',\n    height=5\n)\ng.set_axis_labels('Day', 'Total Bill ($)')"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Available styles: darkgrid, whitegrid, dark, white, ticks\nsns.set_style('whitegrid')\nsns.set_context('talk')  # Options: paper, notebook, talk, poster\n\n# Create plot\nfig, ax = plt.subplots(figsize=(10, 5))\nsns.scatterplot(data=tips, x='total_bill', y='tip', hue='sex', ax=ax)\nax.set_title('Tips vs Bill (talk context)')\n\n# Temporarily use different style\nwith sns.axes_style('dark'):\n    fig2, ax2 = plt.subplots()\n    sns.scatterplot(data=tips, x='total_bill', y='tip', ax=ax2)\n\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Sequential palette for ordered data\niris = sns.load_dataset('iris')\ng = sns.relplot(\n    data=iris,\n    x='sepal_length',\n    y='petal_length',\n    hue='sepal_width',\n    palette='viridis',  # Sequential\n    height=5\n)\n\n# Categorical palette for unordered data\nfig, ax = plt.subplots(figsize=(10, 5))\nsns.barplot(\n    data=tips,\n    x='day',\n    y='total_bill',\n    palette='Set2',  # Categorical\n    ax=ax\n)\n\n# Diverging palette for data with meaningful center\nfig, ax = plt.subplots(figsize=(10, 5))\nsns.barplot(\n    data=tips,\n    x='day',\n    y='total_bill',\n    palette='coolwarm',  # Diverging\n    ax=ax\n)\n\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Complete workflow: load, style, plot\nsns.set_style('whitegrid')\nsns.set_context('notebook')\n\n# Multi-panel analysis\nfig = plt.figure(figsize=(14, 8))\ngs = fig.add_gridspec(2, 2, hspace=0.3, wspace=0.3)\n\n# Distribution\nax1 = fig.add_subplot(gs[0, 0])\nsns.histplot(data=tips, x='total_bill', kde=True, ax=ax1)\n\n# Relationship\nax2 = fig.add_subplot(gs[0, 1])\nsns.scatterplot(data=tips, x='total_bill', y='tip', hue='sex', ax=ax2)\n\n# Category comparison\nax3 = fig.add_subplot(gs[1, 0])\nsns.boxplot(data=tips, x='day', y='total_bill', ax=ax3)\n\n# Count plot\nax4 = fig.add_subplot(gs[1, 1])\nsns.countplot(data=tips, x='day', hue='sex', ax=ax4)\n\nplt.show()"
        ]
      ]
    }
  ],
