          "python",
          "import matplotlib.pyplot as plt\nimport numpy as np\n\n# View current rcParams\nprint(\"Figure size:\", plt.rcParams['figure.figsize'])\nprint(\"Font size:\", plt.rcParams['font.size'])\nprint(\"Grid state:\", plt.rcParams['axes.grid'])\n\n# Modify rcParams for consistent styling\nplt.rcParams['figure.figsize'] = (10, 6)\nplt.rcParams['font.size'] = 11\nplt.rcParams['font.family'] = 'sans-serif'\nplt.rcParams['axes.titlesize'] = 14\nplt.rcParams['axes.labelsize'] = 12\nplt.rcParams['xtick.labelsize'] = 10\nplt.rcParams['ytick.labelsize'] = 10\nplt.rcParams['legend.fontsize'] = 10\nplt.rcParams['axes.grid'] = True\nplt.rcParams['grid.alpha'] = 0.3\nplt.rcParams['axes.linewidth'] = 1.5\nplt.rcParams['xtick.major.size'] = 6\nplt.rcParams['ytick.major.size'] = 6\n\n# Line and color defaults\nplt.rcParams['lines.linewidth'] = 2\nplt.rcParams['lines.markersize'] = 6\nplt.rcParams['axes.prop_cycle'] = plt.cycler('color', \n    ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728', '#9467bd'])\n\n# Now all plots use these settings\nfig, ax = plt.subplots()\nx = np.linspace(0, 10, 100)\nax.plot(x, np.sin(x), label='sin(x)')\nax.plot(x, np.cos(x), label='cos(x)')\nax.set_title('Default Styling Applied')\nax.legend()\nplt.show()\n\n# Reset to defaults\nplt.rcdefaults()\n\n# Use style context temporarily\nwith plt.rc_context({'lines.linewidth': 3, 'font.size': 12}):\n    fig, ax = plt.subplots()\n    ax.plot([1, 2, 3], [1, 2, 3])\n    ax.set_title('Temporary rcParams')\n    plt.show()"
        ]
      ]
