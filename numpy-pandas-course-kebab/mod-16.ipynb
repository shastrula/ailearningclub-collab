      "source": [
        [
          "python",
          "# Create sample data with interesting features\nx = np.linspace(0, 10, 200)\ny = np.sin(x) * np.exp(-x/10)\n\nfig, axes = plt.subplots(2, 2, figsize=(12, 10))\n\n# Basic annotation with arrow\nax = axes[0, 0]\nax.plot(x, y, linewidth=2)\nmax_idx = np.argmax(y)\nax.annotate('Local Maximum', xy=(x[max_idx], y[max_idx]),\n           xytext=(x[max_idx]+1.5, y[max_idx]+0.2),\n           arrowprops=dict(arrowstyle='->', lw=2, color='red'),\n           fontsize=11, color='red', fontweight='bold')\nax.set_title('Simple Annotation')\nax.grid(True, alpha=0.3)\n\n# Multiple annotations with varied styles\nax = axes[0, 1]\nax.plot(x, y, linewidth=2)\nfor i, xi in enumerate(np.linspace(1, 9, 3)):\n    yi = np.sin(xi) * np.exp(-xi/10)\n    ax.plot(xi, yi, 'ro', markersize=8)\n    ax.annotate(f'Point {i+1}', xy=(xi, yi),\n               xytext=(10, 10), textcoords='offset points',\n               bbox=dict(boxstyle='round,pad=0.5', fc='yellow', alpha=0.7),\n               arrowprops=dict(arrowstyle='->', connectionstyle='arc3,rad=0'))\nax.set_title('Multiple Annotations')\nax.grid(True, alpha=0.3)\n\n# Connecting annotations\nax = axes[1, 0]\nax.plot(x, y, linewidth=2, color='blue')\nstart = (3, np.sin(3) * np.exp(-3/10))\nend = (7, np.sin(7) * np.exp(-7/10))\n\nax.plot(*start, 'go', markersize=8)\nax.plot(*end, 'ro', markersize=8)\n\nax.annotate('', xy=end, xytext=start,\n           arrowprops=dict(arrowstyle='<->', lw=2, color='green'))\nax.text(5, (start[1]+end[1])/2 + 0.1, 'Distance', fontsize=10, ha='center',\n       bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.8))\nax.set_title('Connected Annotations')\nax.grid(True, alpha=0.3)\n\n# Text with mathematical notation\nax = axes[1, 1]\nax.plot(x, y, linewidth=2)\nax.text(0.5, 0.95, r'$y = \\sin(x) \\cdot e^{-x/10}$', \n       transform=ax.transAxes, fontsize=14, verticalalignment='top',\n       bbox=dict(boxstyle='round', facecolor='lightblue', alpha=0.8))\nax.text(0.5, 0.05, r'$\\mu = \\sigma = 1$', \n       transform=ax.transAxes, fontsize=12,\n       bbox=dict(boxstyle='round', facecolor='lightcoral', alpha=0.8))\nax.set_title('Mathematical Notation')\nax.grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.show()"
        ]
