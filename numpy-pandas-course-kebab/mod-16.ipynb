          "python",
          "from mpl_toolkits.mplot3d import Axes3D\n\n# 3D surface plot\nfig = plt.figure(figsize=(12, 5))\n\n# First subplot: Surface\nax1 = fig.add_subplot(121, projection='3d')\n\nx = np.linspace(-5, 5, 50)\ny = np.linspace(-5, 5, 50)\nX, Y = np.meshgrid(x, y)\nZ = np.sin(np.sqrt(X**2 + Y**2))\n\nsurf = ax1.plot_surface(X, Y, Z, cmap='viridis', alpha=0.8, edgecolor='none')\nax1.set_xlabel('X')\nax1.set_ylabel('Y')\nax1.set_zlabel('Z')\nax1.set_title('3D Surface')\nfig.colorbar(surf, ax=ax1, pad=0.1)\n\n# Second subplot: Scatter 3D\nax2 = fig.add_subplot(122, projection='3d')\n\nnp.random.seed(42)\nn = 100\nxs = np.random.randn(n)\nys = np.random.randn(n)\nzs = np.random.randn(n)\ncolors = np.random.rand(n)\n\nscatter = ax2.scatter(xs, ys, zs, c=colors, cmap='plasma', s=50, alpha=0.6)\nax2.set_xlabel('X')\nax2.set_ylabel('Y')\nax2.set_zlabel('Z')\nax2.set_title('3D Scatter')\nfig.colorbar(scatter, ax=ax2, pad=0.1)\n\nplt.tight_layout()\nplt.show()\n\n# Wireframe plot\nfig = plt.figure(figsize=(10, 8))\nax = fig.add_subplot(111, projection='3d')\n\nx = np.linspace(-5, 5, 30)\ny = np.linspace(-5, 5, 30)\nX, Y = np.meshgrid(x, y)\nZ = np.exp(-(X**2 + Y**2)/10) * np.cos(X) * np.sin(Y)\n\nax.plot_wireframe(X, Y, Z, color='blue', alpha=0.6)\nax.plot_surface(X, Y, Z, cmap='coolwarm', alpha=0.3)\nax.set_xlabel('X')\nax.set_ylabel('Y')\nax.set_zlabel('Z')\nax.set_title('Wireframe with Surface')\n\n# Rotate view\nax.view_init(elev=20, azim=45)\n\nplt.show()\n\n# 3D bar chart\nfig = plt.figure(figsize=(10, 7))\nax = fig.add_subplot(111, projection='3d')\n\nxpos = np.arange(5)\nypos = np.arange(4)\nzpos = np.zeros((5, 4))\n\ndx = np.ones((5, 4)) * 0.8\ndy = np.ones((5, 4)) * 0.8\ndz = np.random.randint(1, 10, (5, 4))\n\ncolors = plt.cm.viridis(np.linspace(0, 1, 20))\nax.bar3d(xpos.repeat(4), np.tile(ypos, 5), zpos.ravel(), \n         dx.ravel(), dy.ravel(), dz.ravel(), color=colors, zsort='average')\n\nax.set_xlabel('X')\nax.set_ylabel('Y')\nax.set_zlabel('Height')\nax.set_title('3D Bar Chart')\n\nplt.show()"
