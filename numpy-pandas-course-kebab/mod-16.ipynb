          "python",
          "# Accessibility-focused visualization\nnp.random.seed(42)\ndata_accessibility = pd.DataFrame({\n    'category': np.repeat(['A', 'B', 'C', 'D'], 25),\n    'value1': np.random.normal(100, 15, 100),\n    'value2': np.random.normal(110, 20, 100)\n})\n\nfig, axes = plt.subplots(1, 3, figsize=(15, 4))\n\n# Standard color (problematic for colorblind)\ncolors_standard = ['red', 'green', 'blue', 'yellow']\nax = axes[0]\nfor i, cat in enumerate(['A', 'B', 'C', 'D']):\n    data = data_accessibility[data_accessibility['category'] == cat]\n    ax.scatter(data['value1'], data['value2'], s=50, alpha=0.6,\n              color=colors_standard[i], label=cat)\nax.set_title('Standard Colors\\n(Problematic for Colorblind)')\nax.legend()\nax.grid(True, alpha=0.3)\n\n# Colorblind-friendly colors\ncolors_cb = ['#1b9e77', '#d95f02', '#7570b3', '#e7298a']\nax = axes[1]\nfor i, cat in enumerate(['A', 'B', 'C', 'D']):\n    data = data_accessibility[data_accessibility['category'] == cat]\n    ax.scatter(data['value1'], data['value2'], s=50, alpha=0.6,\n              color=colors_cb[i], label=cat)\nax.set_title('Colorblind-Friendly\\n(Okabe-Ito Palette)')\nax.legend()\nax.grid(True, alpha=0.3)\n\n# Multiple encodings (color + shape)\nax = axes[2]\nmarkers = ['o', 's', '^', 'D']\nfor i, cat in enumerate(['A', 'B', 'C', 'D']):\n    data = data_accessibility[data_accessibility['category'] == cat]\n    ax.scatter(data['value1'], data['value2'], s=80, alpha=0.6,\n              marker=markers[i], edgecolors='black', linewidth=0.5,\n              color=colors_cb[i], label=cat)\nax.set_title('Multiple Encodings\\n(Color + Shape)')\nax.legend()\nax.grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.show()"
        ]
