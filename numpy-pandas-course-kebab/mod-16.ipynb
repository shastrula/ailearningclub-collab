          "python",
          "# Advanced composition using complex GridSpec\nfrom matplotlib.gridspec import GridSpec\n\nfig = plt.figure(figsize=(14, 10))\ngs = GridSpec(3, 3, figure=fig, hspace=0.35, wspace=0.3)\n\nnp.random.seed(42)\nx = np.linspace(0, 10, 100)\ny1 = np.sin(x)\ny2 = np.cos(x)\ny3 = np.exp(-x/5)\n\n# Large main plot (top-left, spans 2x2)\nax_main = fig.add_subplot(gs[0:2, 0:2])\nax_main.plot(x, y1, linewidth=2.5, label='sin(x)', marker='o', markersize=2, markevery=5)\nax_main.plot(x, y2, linewidth=2.5, label='cos(x)', marker='s', markersize=2, markevery=5)\nax_main.fill_between(x, y1, y2, alpha=0.2)\nax_main.set_title('Main Analysis: Trigonometric Comparison', fontsize=13, fontweight='bold')\nax_main.legend(loc='upper right', fontsize=10)\nax_main.grid(True, alpha=0.3)\nax_main.set_ylabel('Amplitude', fontsize=11)\n\n# Top-right: histogram of y1\nax_hist1 = fig.add_subplot(gs[0, 2])\nax_hist1.hist(y1, bins=15, color='blue', alpha=0.7, edgecolor='black')\nax_hist1.set_title('sin(x) Dist.', fontsize=10)\nax_hist1.set_ylabel('Frequency', fontsize=9)\n\n# Middle-right: histogram of y2\nax_hist2 = fig.add_subplot(gs[1, 2])\nax_hist2.hist(y2, bins=15, color='orange', alpha=0.7, edgecolor='black')\nax_hist2.set_title('cos(x) Dist.', fontsize=10)\nax_hist2.set_ylabel('Frequency', fontsize=9)\n\n# Bottom-left: decaying exponential\nax_exp = fig.add_subplot(gs[2, 0])\nax_exp.plot(x, y3, linewidth=2.5, color='red', marker='^', markersize=3, markevery=5)\nax_exp.fill_between(x, 0, y3, alpha=0.3, color='red')\nax_exp.set_title('Exponential Decay', fontsize=10)\nax_exp.set_xlabel('x', fontsize=9)\nax_exp.set_ylabel('Value', fontsize=9)\nax_exp.grid(True, alpha=0.3)\n\n# Bottom-middle: correlation\nax_corr = fig.add_subplot(gs[2, 1])\nscatter = ax_corr.scatter(y1, y2, s=40, alpha=0.6, c=x, cmap='viridis')\nax_corr.set_title('Correlation: sin vs cos', fontsize=10)\nax_corr.set_xlabel('sin(x)', fontsize=9)\nax_corr.set_ylabel('cos(x)', fontsize=9)\ncbar = fig.colorbar(scatter, ax=ax_corr)\ncbar.set_label('x', fontsize=8)\n\n# Bottom-right: statistics text\nax_stats = fig.add_subplot(gs[2, 2])\nax_stats.axis('off')\nstats_text = f'''Statistical Summary\nsin(x): \u03bc={y1.mean():.3f}, \u03c3={y1.std():.3f}\ncos(x): \u03bc={y2.mean():.3f}, \u03c3={y2.std():.3f}\ncorr(sin,cos): {np.corrcoef(y1, y2)[0,1]:.3f}\n\nNotes:\n\u2022 Trigonometric functions\n\u2022 Inverse relationship\n\u2022 Periodic patterns'''\nax_stats.text(0.05, 0.95, stats_text, transform=ax_stats.transAxes,\n             fontsize=9, verticalalignment='top', family='monospace',\n             bbox=dict(boxstyle='round', facecolor='lightyellow', alpha=0.9))\n\nfig.suptitle('Comprehensive Analysis Dashboard', fontsize=15, fontweight='bold', y=0.98)\n\nplt.show()"
