          "python",
          "from matplotlib.animation import FuncAnimation\n\n# Simple line animation\nfig, ax = plt.subplots(figsize=(10, 6))\n\nx = np.linspace(0, 10, 200)\nline, = ax.plot([], [], lw=2, color='blue')\ntime_text = ax.text(0.05, 0.95, '', transform=ax.transAxes, fontsize=12,\n                   bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.8))\n\nax.set_xlim(0, 10)\nax.set_ylim(-2, 2)\nax.set_xlabel('X')\nax.set_ylabel('Y')\nax.set_title('Animated Wave')\nax.grid(True, alpha=0.3)\n\ndef init():\n    line.set_data([], [])\n    return line,\n\ndef animate(frame):\n    y = np.sin(x - frame/10)\n    line.set_data(x, y)\n    time_text.set_text(f'Frame: {frame}')\n    return line, time_text\n\nanim = FuncAnimation(fig, animate, init_func=init, frames=100, \n                    interval=50, blit=True, repeat=True)\n\nplt.show()\n\n# Scatter animation (moving points)\nfig, ax = plt.subplots(figsize=(10, 6))\n\nax.set_xlim(-1, 11)\nax.set_ylim(-1, 11)\nax.set_xlabel('X')\nax.set_ylabel('Y')\nax.set_title('Moving Particles')\nax.grid(True, alpha=0.3)\n\nn_particles = 20\nnp.random.seed(42)\n\nscatter = ax.scatter([], [], s=100, c=[], cmap='viridis', alpha=0.6)\n\ndef init_scatter():\n    scatter.set_offsets(np.empty((0, 2)))\n    scatter.set_array(np.empty(0))\n    return scatter,\n\ndef animate_scatter(frame):\n    t = frame / 10.0\n    angles = np.linspace(0, 2*np.pi, n_particles)\n    radii = 4 + 2*np.sin(t + angles)\n    \n    x = 5 + radii * np.cos(angles)\n    y = 5 + radii * np.sin(angles)\n    \n    scatter.set_offsets(np.c_[x, y])\n    scatter.set_array(angles)\n    \n    return scatter,\n\nanim = FuncAnimation(fig, animate_scatter, init_func=init_scatter,\n                    frames=100, interval=50, blit=True, repeat=True)\n\nplt.show()"
        ]
