        [
          "python",
          "# Create data with small-scale detail\nx = np.linspace(0, 10, 1000)\ny = np.sin(x) + 0.1 * np.random.randn(1000)\n\nfig, ax = plt.subplots(figsize=(10, 6))\n\n# Main plot\nax.plot(x, y, linewidth=1, alpha=0.7, label='Data')\nax.set_title('Dataset with Inset Zoom', fontsize=14, fontweight='bold')\nax.set_xlabel('X')\nax.set_ylabel('Y')\n\n# Add inset\nfrom mpl_toolkits.axes_grid1.inset_locator import inset_axes, mark_inset\n\n# Create inset axes (smaller subplot)\naxins = inset_axes(ax, width='30%', height='30%', loc='upper right',\n                   borderpad=1.5)\n\n# Plot zoomed region in inset\nzoom_x_min, zoom_x_max = 2, 4\nzoom_y_min, zoom_y_max = -1.5, 1.5\nmask = (x >= zoom_x_min) & (x <= zoom_x_max)\n\naxins.plot(x[mask], y[mask], linewidth=2, color='red')\naxins.set_xlim(zoom_x_min, zoom_x_max)\naxins.set_ylim(zoom_y_min, zoom_y_max)\naxins.grid(True, alpha=0.3)\naxins.set_title('Zoom', fontsize=10)\n\n# Draw rectangle on main plot showing inset region\nmark_inset(ax, axins, loc1=2, loc2=4, fc='none', ec='red', linewidth=2)\n\nplt.show()\n\n# Multiple insets\nfig, ax = plt.subplots(figsize=(11, 7))\n\nx = np.linspace(0, 10, 500)\ny = np.cumsum(np.random.normal(0, 1, 500))\n\nax.plot(x, y, linewidth=2, color='blue')\nax.set_title('Stock Price with Details', fontsize=14, fontweight='bold')\nax.set_xlabel('Trading Days')\nax.set_ylabel('Price ($)')\nax.grid(True, alpha=0.3)\n\n# First inset - zoomed region 1\nax1 = inset_axes(ax, width='25%', height='25%', loc='upper left', borderpad=1)\nmask1 = (x >= 1) & (x <= 3)\nax1.plot(x[mask1], y[mask1], linewidth=2, color='orange')\nax1.set_title('Day 1-3', fontsize=9)\nax1.grid(True, alpha=0.3)\nmark_inset(ax, ax1, loc1=2, loc2=4, fc='none', ec='orange')\n\n# Second inset - zoomed region 2\nax2 = inset_axes(ax, width='25%', height='25%', loc='lower right', borderpad=1)\nmask2 = (x >= 7) & (x <= 9)\nax2.plot(x[mask2], y[mask2], linewidth=2, color='green')\nax2.set_title('Day 7-9', fontsize=9)\nax2.grid(True, alpha=0.3)\nmark_inset(ax, ax2, loc1=1, loc2=3, fc='none', ec='green')\n\nplt.show()"
