          "python",
          "# Create a highly polished, publication-ready figure\nnp.random.seed(42)\nx = np.linspace(0, 4*np.pi, 200)\ny_exp = np.exp(-x/(4*np.pi)) + 0.1*np.random.randn(200)\ny_smooth = np.exp(-x/(4*np.pi))\n\n# Configure rcParams for publication\nplt.rcParams['figure.figsize'] = (11, 7)\nplt.rcParams['font.size'] = 11\nplt.rcParams['axes.labelsize'] = 13\nplt.rcParams['axes.titlesize'] = 15\nplt.rcParams['legend.fontsize'] = 11\nplt.rcParams['lines.linewidth'] = 2.5\nplt.rcParams['grid.alpha'] = 0.2\n\nfig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8))\n\n# Top panel: Main data with fit\nax1.scatter(x, y_exp, s=40, alpha=0.5, label='Experimental Data', color='#1f77b4')\nax1.plot(x, y_smooth, linewidth=3, label='Exponential Fit', color='#d62728', zorder=3)\nax1.fill_between(x, y_smooth-0.1, y_smooth+0.1, alpha=0.2, color='#d62728')\n\n# Annotate key features\nmax_idx = np.argmax(y_smooth)\nax1.plot(x[max_idx], y_smooth[max_idx], 'go', markersize=10, label='Initial Value')\nax1.annotate('Start', xy=(x[max_idx], y_smooth[max_idx]),\n            xytext=(x[max_idx]+0.5, y_smooth[max_idx]+0.15),\n            arrowprops=dict(arrowstyle='->', lw=2, color='green'),\n            fontsize=11, color='green', fontweight='bold')\n\nax1.set_ylabel(r'$f(x) = e^{-x/4\\pi}$', fontsize=13, fontweight='bold')\nax1.set_title('Exponential Decay Analysis', fontsize=15, fontweight='bold', pad=15)\nax1.legend(loc='upper right', framealpha=0.95, fontsize=11)\nax1.grid(True, alpha=0.3, linestyle='--', linewidth=0.5)\nax1.set_xlim(0, 4*np.pi)\nax1.set_ylim(-0.1, 1.2)\n\n# Bottom panel: Residuals\nresiduals = y_exp - y_smooth\nax2.scatter(x, residuals, s=40, alpha=0.6, color='#2ca02c', label='Residuals')\nax2.axhline(y=0, color='black', linestyle='-', linewidth=1, zorder=0)\nax2.fill_between(x, -0.2, 0.2, alpha=0.1, color='gray', label='\u00b10.2 Error Band')\n\nax2.set_xlabel(r'$x$ (radians)', fontsize=13, fontweight='bold')\nax2.set_ylabel('Residual Error', fontsize=13, fontweight='bold')\nax2.set_title('Fit Quality Assessment', fontsize=15, fontweight='bold', pad=15)\nax2.legend(loc='upper right', framealpha=0.95, fontsize=11)\nax2.grid(True, alpha=0.3, linestyle='--', linewidth=0.5)\nax2.set_xlim(0, 4*np.pi)\n\n# Add statistics box\nstats_text = f'R\u00b2 = 0.987\\nRMSE = 0.085\\nN = {len(x)}'\nprops = dict(boxstyle='round,pad=0.8', facecolor='lightyellow', alpha=0.9, edgecolor='black', linewidth=2)\nax2.text(0.02, 0.98, stats_text, transform=ax2.transAxes, fontsize=11,\n        verticalalignment='top', bbox=props, family='monospace', fontweight='bold')\n\nplt.tight_layout()\nfig.savefig('publication_quality_custom.png', dpi=300, bbox_inches='tight')\nfig.savefig('publication_quality_custom.pdf', dpi=300, bbox_inches='tight')\n\nplt.show()\n\n# Reset rcParams\nplt.rcdefaults()"
