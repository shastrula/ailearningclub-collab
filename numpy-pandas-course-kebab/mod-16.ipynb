          "python",
          "import numpy as np\nimport pandas as pd\n\n# NumPy: fast numerical operations\narr = np.random.randn(1000, 5)\nprint(\"NumPy Array Operations:\")\nprint(f\"  Shape: {arr.shape}\")\nprint(f\"  Mean per column: {arr.mean(axis=0).round(3)}\")\nprint(f\"  Std per column: {arr.std(axis=0).round(3)}\")\n\n# Pandas: tabular data manipulation\ndf = pd.DataFrame(arr, columns=['A', 'B', 'C', 'D', 'E'])\ndf['category'] = np.random.choice(['X', 'Y', 'Z'], 1000)\n\nprint(\"\\nPandas GroupBy:\")\nprint(df.groupby('category')[['A', 'B']].agg(['mean', 'std']).round(3))\n\n# Filtering and transformation\nfiltered = df[(df['A'] > 0) & (df['B'] < 1)]\nprint(f\"\\nFiltered: {len(filtered)} rows (from {len(df)})\")\n\n# Apply custom function\ndf['A_normalized'] = (df['A'] - df['A'].mean()) / df['A'].std()\nprint(f\"Normalized mean: {df['A_normalized'].mean():.6f}\")  # \u2248 0"
