      "source": [
        [
          "python",
          "import pandas as pd\nimport numpy as np\n\n# Load data with type problems\ndf = pd.read_csv('data.csv')\n\n# Check inferred types\nprint(df.dtypes)\nprint(df.info())\n\n# Explicit type specification\ndf_typed = pd.read_csv('data.csv', dtype={\n    'age': 'int32',\n    'salary': 'float32',\n    'hire_date': 'datetime64',\n    'department': 'category',\n    'is_active': 'bool'\n})\n\n# Type conversion with error handling\ndf['purchase_amount'] = pd.to_numeric(\n    df['purchase_amount'],\n    errors='coerce'  # Invalid values \u2192 NaN\n)\n\n# Convert to category for memory efficiency and ordered operations\ndf['priority'] = pd.Categorical(\n    df['priority'],\n    categories=['low', 'medium', 'high'],\n    ordered=True\n)\n\n# Validate type conversion\nprint(df.dtypes)\nprint(df['purchase_amount'].isna().sum(), 'conversion errors')"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Diagnose missingness\nprint(df.isnull().sum())  # Missing count per column\nprint(df.isnull().sum() / len(df) * 100)  # Percentage\nprint(df.isnull())  # Boolean mask\n\n# Missing patterns\nmissing_mask = df.isnull()\nprint(missing_mask.sum(axis=1))  # Missing per row\n\n# Visualize missing patterns\nimport matplotlib.pyplot as plt\nplt.figure(figsize=(10, 6))\nplt.imshow(df.isnull(), cmap='RdYlGn_r', aspect='auto')\nplt.colorbar(label='Missing (Yellow=Yes)')\nplt.xlabel('Columns')\nplt.ylabel('Rows')\nplt.title('Missing Data Pattern')\nplt.show()\n\n# Drop rows with any missing values\ndf_dropped = df.dropna()\n\n# Drop rows where specific columns are missing\ndf_dropped = df.dropna(subset=['critical_column'])\n\n# Drop columns where >50% of data is missing\ndf_dropped = df.loc[:, df.isnull().sum() / len(df) < 0.5]\n\n# Forward fill (propagate last valid value)\ndf_filled = df.fillna(method='ffill')\n\n# Backward fill\ndf_filled = df.fillna(method='bfill')\n\n# Fill with specific value\ndf_filled = df.fillna(0)\n\n# Fill with mean/median/mode (numeric columns)\nfor col in df.select_dtypes(include=[np.number]).columns:\n    df[col] = df[col].fillna(df[col].median())\n\n# Fill with mode (categorical)\ndf['category'] = df['category'].fillna(df['category'].mode()[0])\n\n# Interpolation (useful for time series)\ndf['value'] = df['value'].interpolate(method='linear')"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Statistical outlier detection: IQR method\nQ1 = df['age'].quantile(0.25)\nQ3 = df['age'].quantile(0.75)\nIQR = Q3 - Q1\n\n# Points beyond 1.5*IQR are typically considered outliers\nlower_bound = Q1 - 1.5 * IQR\nupper_bound = Q3 + 1.5 * IQR\n\noutliers_mask = (df['age'] < lower_bound) | (df['age'] > upper_bound)\nprint(f\"Outliers found: {outliers_mask.sum()}\")\nprint(df[outliers_mask])\n\n# Z-score method\nfrom scipy import stats\nz_scores = np.abs(stats.zscore(df['salary'].dropna()))\noutliers_z = z_scores > 3\n\n# Handle outliers: remove, cap, or flag\ndf_no_outliers = df[~outliers_mask]  # Remove\ndf_capped = df.copy()\ndf_capped.loc[outliers_mask, 'age'] = upper_bound  # Cap to boundary\ndf['age_outlier_flag'] = outliers_mask.astype(int)  # Flag for modeling\n\n# Robust statistics (resistant to outliers)\nprint(f\"Mean: {df['age'].mean()}\")  # Sensitive to outliers\nprint(f\"Median: {df['age'].median()}\")  # Robust\nprint(f\"Mean of trimmed data: {stats.trim_mean(df['age'], 0.1)}\")  # Remove 10% from each end"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# String standardization\ndf['name'] = df['name'].str.strip()  # Remove leading/trailing whitespace\ndf['name'] = df['name'].str.lower()  # Lowercase\ndf['name'] = df['name'].str.title()  # Title case\ndf['name'] = df['name'].str.replace(',', '')  # Remove characters\n\n# Fix common patterns\ndf['email'] = df['email'].str.lower()\ndf['phone'] = df['phone'].str.replace('-', '').str.replace(' ', '')\n\n# Validation with regex\nvalid_email = df['email'].str.match(r'^[\\w\\.-]+@[\\w\\.-]+\\.\\w+$')\nprint(f\"Invalid emails: {(~valid_email).sum()}\")\n\n# Fuzzy string matching (find similar strings)\nfrom difflib import SequenceMatcher\n\ndef string_similarity(a, b):\n    return SequenceMatcher(None, a, b).ratio()\n\n# Example: merge similar company names\ncompanies = df['company'].unique()\nprint(companies)\n\n# Handle variations\ncompany_mapping = {\n    'microsoft': 'Microsoft Corporation',\n    'ms': 'Microsoft Corporation',\n    'msft': 'Microsoft Corporation'\n}\n\ndf['company'] = df['company'].str.lower().map(\n    lambda x: company_mapping.get(x, x)\n)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Detect exact duplicates (all columns identical)\nduplicates = df.duplicated()\nprint(f\"Duplicate rows: {duplicates.sum()}\")\nprint(df[duplicates])\n\n# Duplicates based on specific columns\nduplicates_subset = df.duplicated(subset=['email', 'phone'], keep=False)\nprint(f\"Duplicate emails/phones: {duplicates_subset.sum()}\")\n\n# Keep options: 'first', 'last', False (mark all)\ndf_dedup = df.drop_duplicates(subset=['email'], keep='first')\n\n# Fuzzy deduplication (find near-duplicates)\n# Using phonetic encoding\nfrom jellyfish import metaphone\n\ndf['name_phonetic'] = df['name'].apply(lambda x: metaphone(str(x)))\n\n# Find potential duplicates using fuzzy matching\nfrom fuzzywuzzy import fuzz\n\ndef find_fuzzy_duplicates(df, column, threshold=90):\n    duplicates = []\n    for i, row1 in df.iterrows():\n        for j in range(i + 1, len(df)):\n            ratio = fuzz.ratio(str(row1[column]), str(df.iloc[j][column]))\n            if ratio >= threshold:\n                duplicates.append((i, j, ratio))\n    return duplicates\n\npotential_dupes = find_fuzzy_duplicates(df, 'company_name', threshold=85)\nfor idx1, idx2, score in potential_dupes[:5]:\n    print(f\"{df.iloc[idx1]['company_name']} \u2194 {df.iloc[idx2]['company_name']}: {score}%\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Comprehensive quality report\ndef data_quality_report(df):\n    report = {\n        'total_rows': len(df),\n        'total_columns': len(df.columns),\n        'memory_usage_mb': df.memory_usage(deep=True).sum() / 1024**2,\n        'columns_with_nulls': df.isnull().sum().sum(),\n        'null_percentage': (df.isnull().sum().sum() / (len(df) * len(df.columns))) * 100,\n        'duplicate_rows': df.duplicated().sum(),\n        'duplicate_percentage': (df.duplicated().sum() / len(df)) * 100,\n        'columns_by_type': df.dtypes.value_counts().to_dict()\n    }\n    return report\n\nquality = data_quality_report(df)\nfor key, value in quality.items():\n    print(f\"{key}: {value}\")\n\n# Validation rules\ndef validate_data(df):\n    errors = []\n    \n    # Type checks\n    if df['age'].dtype != 'int64':\n        errors.append(\"age should be int64\")\n    \n    # Range checks\n    if (df['age'] < 0).any() or (df['age'] > 150).any():\n        errors.append(\"age out of reasonable range\")\n    \n    # Required fields\n    if df['email'].isnull().any():\n        errors.append(\"email contains nulls\")\n    \n    # Format checks\n    if not df['phone'].str.match(r'^\\d{10}$').all():\n        errors.append(\"phone format incorrect\")\n    \n    # Referential integrity (if joining tables)\n    # if not df['department_id'].isin(departments['id']).all():\n    #     errors.append(\"invalid department_id\")\n    \n    return errors\n\nvalidation_errors = validate_data(df)\nfor error in validation_errors:\n    print(f\"\u26a0\ufe0f  {error}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# End-to-end cleaning workflow\ndef clean_data(filepath):\n    # Load\n    df = pd.read_csv(filepath, dtype={'age': 'int32', 'salary': 'float32'})\n    \n    # Remove complete duplicates\n    df = df.drop_duplicates()\n    \n    # Handle missing values\n    df = df.dropna(subset=['email'])  # Critical columns\n    df['middle_name'] = df['middle_name'].fillna('')  # Optional fields\n    \n    # Type conversion with validation\n    df['salary'] = pd.to_numeric(df['salary'], errors='coerce')\n    df['hire_date'] = pd.to_datetime(df['hire_date'], errors='coerce')\n    \n    # Remove outliers (age)\n    Q1, Q3 = df['age'].quantile([0.25, 0.75])\n    df = df[(df['age'] >= Q1 - 1.5*(Q3-Q1)) & (df['age'] <= Q3 + 1.5*(Q3-Q1))]\n    \n    # Clean strings\n    df['name'] = df['name'].str.strip().str.title()\n    df['email'] = df['email'].str.lower().str.strip()\n    \n    # Validate\n    errors = validate_data(df)\n    if errors:\n        print(\"Validation warnings:\")\n        for error in errors:\n            print(f\"  - {error}\")\n    \n    return df\n\ndf_clean = clean_data('raw_data.csv')\nprint(f\"Cleaned data: {len(df_clean)} rows, {len(df_clean.columns)} columns\")"
        ]
      ]
    }
