      "source": [
        "# Numpy Pandas Course Kebab - mod-10\n\n",
        "**Course:** numpy-pandas-course-kebab\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import pandas as pd\nimport numpy as np\n\n# Sample sales data\nsales = pd.DataFrame({\n    'date': pd.date_range('2024-01-01', periods=12),\n    'region': ['North', 'South', 'North', 'East', 'South', 'West'] * 2,\n    'amount': [100, 150, 200, 120, 180, 160, 140, 190, 210, 130, 170, 155]\n})\n\n# Simple groupby - one column\nby_region = sales.groupby('region')['amount'].sum()\nprint(\"Total sales by region:\\n\", by_region)\n\n# Multiple column groupby\nsales['product'] = ['A', 'B', 'A', 'C', 'B', 'A'] * 2\nby_region_product = sales.groupby(['region', 'product'])['amount'].sum()\nprint(\"\\nSales by region and product:\\n\", by_region_product)\n\n# Access group information\ngroup_sizes = sales.groupby('region').size()\nprint(\"\\nGroup sizes:\\n\", group_sizes)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Single aggregation\nrevenue_stats = sales.groupby('region')['amount'].agg('sum')\nprint(\"Sum by region:\\n\", revenue_stats)\n\n# Multiple aggregations on one column\nmultiple_stats = sales.groupby('region')['amount'].agg(['sum', 'mean', 'count', 'std'])\nprint(\"\\nMultiple stats:\\n\", multiple_stats)\n\n# Different aggregations for different columns\nagg_dict = {\n    'amount': ['sum', 'mean', 'count'],\n    'date': 'max'\n}\n\ncomprehensive = sales.groupby('region').agg(agg_dict)\nprint(\"\\nComprehensive aggregation:\\n\", comprehensive)\n\n# Named aggregation for clearer output\nresult = sales.groupby('region').agg(\n    total_sales=('amount', 'sum'),\n    avg_sale=('amount', 'mean'),\n    num_transactions=('amount', 'count'),\n    latest_date=('date', 'max')\n)\nprint(\"\\nNamed aggregation:\\n\", result)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Add group mean to each row\nsales['group_mean'] = sales.groupby('region')['amount'].transform('mean')\nprint(\"Original data with group means:\\n\", sales[['region', 'amount', 'group_mean']])\n\n# Calculate deviation from group mean\nsales['deviation'] = sales['amount'] - sales['group_mean']\nprint(\"\\nWith deviation:\\n\", sales[['region', 'amount', 'group_mean', 'deviation']])\n\n# Normalize values within groups (0-1 scaling)\nsales['normalized'] = sales.groupby('region')['amount'].transform(\n    lambda x: (x - x.min()) / (x.max() - x.min())\n)\nprint(\"\\nNormalized values:\\n\", sales[['region', 'amount', 'normalized']])\n\n# Rank within groups\nsales['rank'] = sales.groupby('region')['amount'].transform('rank')\nprint(\"\\nRanked within groups:\\n\", sales[['region', 'amount', 'rank']])"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Keep only regions with total sales > 500\nfiltered = sales.groupby('region').filter(lambda x: x['amount'].sum() > 500)\nprint(\"Regions with sales > 500:\\n\", filtered)\n\n# Keep only groups with more than 2 observations\nsize_filtered = sales.groupby('region').filter(lambda x: x.shape[0] > 2)\nprint(\"\\nRegions with > 2 records:\\n\", size_filtered)\n\n# Keep transactions above group average\nabove_avg = sales.groupby('region').filter(lambda x: (x['amount'] > x['amount'].mean()).any())\nprint(\"\\nRows where amount > region average:\\n\", above_avg)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Multi-level grouping creates hierarchical index\nmonthly_sales = sales.copy()\nmonthly_sales['month'] = monthly_sales['date'].dt.month\nmonthly_sales['year'] = monthly_sales['date'].dt.year\n\n# Group by multiple levels\nhierarchy = monthly_sales.groupby(['year', 'month', 'region']).agg(\n    total=('amount', 'sum'),\n    count=('amount', 'count'),\n    average=('amount', 'mean')\n)\nprint(\"Hierarchical aggregation:\\n\", hierarchy)\n\n# Access specific levels\nprint(\"\\nYear-level summary:\\n\", hierarchy.groupby(level=0).sum())\n\n# Unstack to convert index to columns\npivoted = hierarchy.unstack(level='region', fill_value=0)\nprint(\"\\nUnstacked by region:\\n\", pivoted)\n\n# Reset index for flat DataFrame\nflat = hierarchy.reset_index()\nprint(\"\\nFlattened:\\n\", flat.head())"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Basic pivot table\npivot = sales.pivot_table(\n    values='amount',\n    index='region',\n    columns='product',\n    aggfunc='sum',\n    fill_value=0\n)\nprint(\"Sales by region and product:\\n\", pivot)\n\n# Multiple value columns\npivot_multi = sales.pivot_table(\n    values=['amount'],\n    index='region',\n    columns='product',\n    aggfunc=['sum', 'mean'],\n    fill_value=0\n)\nprint(\"\\nMultiple aggregations:\\n\", pivot_multi)\n\n# Margins (totals)\nwith_margins = sales.pivot_table(\n    values='amount',\n    index='region',\n    columns='product',\n    aggfunc='sum',\n    margins=True,\n    fill_value=0\n)\nprint(\"\\nWith margins:\\n\", with_margins)\n\n# Multiple index and column levels\nmulti_pivot = sales.pivot_table(\n    values='amount',\n    index=['region', 'product'],\n    columns='date',\n    aggfunc='sum',\n    fill_value=0\n)\nprint(\"\\nMulti-level index:\\n\", multi_pivot.iloc[:5, :5])"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Simple custom function\ndef range_stat(x):\n    return x.max() - x.min()\n\ndef coefficient_of_variation(x):\n    \"\"\"Ratio of standard deviation to mean\"\"\"\n    return x.std() / x.mean() if x.mean() != 0 else 0\n\ncustom_agg = sales.groupby('region')['amount'].agg([\n    ('sum', 'sum'),\n    ('mean', 'mean'),\n    ('range', range_stat),\n    ('cv', coefficient_of_variation),\n])\nprint(\"Custom aggregations:\\n\", custom_agg)\n\n# Multiple custom functions per column\ncomplex_agg = sales.groupby('region').agg({\n    'amount': [\n        'sum',\n        ('median_val', 'median'),\n        ('range', lambda x: x.max() - x.min()),\n        ('iqr', lambda x: x.quantile(0.75) - x.quantile(0.25))\n    ]\n})\nprint(\"\\nComplex aggregations:\\n\", complex_agg)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Advanced: Custom aggregation with full group access\ndata = pd.DataFrame({\n    'group': ['A', 'A', 'A', 'B', 'B', 'B'],\n    'value1': [1, 2, 3, 4, 5, 6],\n    'value2': [10, 20, 30, 40, 50, 60]\n})\n\ndef custom_summary(group_df):\n    \"\"\"Calculate summary for group using multiple columns\"\"\"\n    return pd.Series({\n        'count': len(group_df),\n        'val1_mean': group_df['value1'].mean(),\n        'ratio': group_df['value2'].sum() / group_df['value1'].sum(),\n        'variance': group_df['value1'].var()\n    })\n\nresult = data.groupby('group').apply(custom_summary)\nprint(\"Custom aggregation:\\n\", result)\n\n# Rolling within groups\nts_data = pd.DataFrame({\n    'date': pd.date_range('2024-01-01', periods=12),\n    'category': ['A']*6 + ['B']*6,\n    'sales': [100, 120, 150, 130, 140, 160, 200, 210, 190, 220, 210, 200]\n})\n\nts_data['rolling_mean'] = ts_data.groupby('category')['sales'].transform(\n    lambda x: x.rolling(window=3, min_periods=1).mean()\n)\nprint(\"\\nRolling within groups:\\n\", ts_data)\n\n# Conditional aggregation\ndef summarize_if_enough_data(group_df):\n    \"\"\"Only aggregate if group has 3+ records\"\"\"\n    if len(group_df) >= 3:\n        return group_df['value1'].agg(['sum', 'mean'])\n    else:\n        return pd.Series({'sum': np.nan, 'mean': np.nan})\n\nconditional = data.groupby('group').apply(summarize_if_enough_data)\nprint(\"\\nConditional aggregation:\\n\", conditional)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Simulate customer transaction history\nnp.random.seed(42)\ncustomers = pd.DataFrame({\n    'customer_id': np.repeat(range(1, 101), 10),\n    'purchase_date': pd.date_range('2023-01-01', periods=1000, freq='D'),\n    'amount': np.random.uniform(10, 500, 1000),\n    'category': np.random.choice(['Electronics', 'Clothing', 'Home'], 1000)\n})\n\n# Calculate customer-level metrics\ncustomer_metrics = customers.groupby('customer_id').agg({\n    'amount': ['sum', 'mean', 'count', 'std'],\n    'purchase_date': ['min', 'max'],\n    'category': 'nunique'\n}).reset_index()\n\n# Flatten column names\ncustomer_metrics.columns = ['customer_id', 'total_spent', 'avg_purchase', \n                            'num_purchases', 'purchase_volatility',\n                            'first_purchase', 'last_purchase', 'categories']\n\n# Calculate RFM metrics\ncustomer_metrics['days_since_purchase'] = (\n    pd.Timestamp.now() - customer_metrics['last_purchase']\n).dt.days\n\n# Segment customers\ncustomer_metrics['segment'] = pd.cut(customer_metrics['total_spent'], \n    bins=3, labels=['Bronze', 'Silver', 'Gold'])\n\nprint(\"Customer segmentation summary:\")\nprint(customer_metrics.groupby('segment').agg({\n    'total_spent': ['count', 'mean'],\n    'num_purchases': 'mean',\n    'days_since_purchase': 'mean'\n}).round(2))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Optimization and error handling\n\n# Categorical optimization\nlarge_df = pd.DataFrame({\n    'group': np.random.choice(['A', 'B', 'C', 'D', 'E'], 1000000),\n    'value': np.random.randn(1000000)\n})\n\n# Convert to categorical\nlarge_df['group_cat'] = large_df['group'].astype('category')\n\n# Groupby on categorical is faster\nresult = large_df.groupby('group_cat')['value'].agg(['sum', 'mean', 'count'])\nprint(\"Categorical groupby result:\\n\", result)\n\n# Error handling in groupby\ndef safe_agg(group):\n    try:\n        if len(group) < 2:\n            return pd.Series({'mean': np.nan, 'std': np.nan})\n        return pd.Series({\n            'mean': group['value'].mean(),\n            'std': group['value'].std()\n        })\n    except Exception as e:\n        print(f\"Error processing group: {e}\")\n        return pd.Series({'mean': np.nan, 'std': np.nan})\n\nresult = large_df.groupby('group').apply(safe_agg)\nprint(\"\\nSafe aggregation:\\n\", result)"
        ]
      ]
    }
