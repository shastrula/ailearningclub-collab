        [
          "python",
          "import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.ensemble import RandomForestRegressor\nfrom sklearn.metrics import mean_squared_error, r2_score\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Project setup: Define objectives before analysis\nPROJECT_CONFIG = {\n    'name': 'Housing Price Prediction',\n    'objectives': [\n        'Understand factors influencing house prices',\n        'Build predictive model for price estimation',\n        'Identify high-value neighborhoods',\n        'Quantify renovation impact on prices'\n    ],\n    'dataset': 'housing.csv',\n    'target': 'price',\n    'random_state': 42\n}\n\nprint(f\"Project: {PROJECT_CONFIG['name']}\")\nprint(f\"Objectives:\\n\" + \"\\n\".join(f\"  - {obj}\" for obj in PROJECT_CONFIG['objectives']))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Load data\ndf_raw = pd.read_csv(PROJECT_CONFIG['dataset'])\n\n# Version tracking: always preserve raw data\ndf = df_raw.copy()\n\n# Initial assessment\ndef initial_assessment(df, target_col):\n    \"\"\"Comprehensive data overview\"\"\"\n    print(f\"Dataset: {df.shape[0]} rows \u00d7 {df.shape[1]} columns\")\n    print(f\"\\nColumn Summary:\")\n    \n    for col in df.columns:\n        dtype = df[col].dtype\n        missing = df[col].isnull().sum()\n        missing_pct = missing / len(df) * 100\n        \n        if dtype in [np.number]:\n            stats = f\"Range: {df[col].min():.0f}-{df[col].max():.0f}, Mean: {df[col].mean():.0f}\"\n        else:\n            stats = f\"Unique: {df[col].nunique()}\"\n        \n        print(f\"  {col:20} | {str(dtype):10} | Missing: {missing_pct:5.1f}% | {stats}\")\n    \n    print(f\"\\nTarget Distribution ({target_col}):\")\n    print(df[target_col].describe())\n\ninitial_assessment(df, PROJECT_CONFIG['target'])\n\n# Data quality baseline\nquality_baseline = {\n    'rows': len(df),\n    'columns': len(df.columns),\n    'missing_cells': df.isnull().sum().sum(),\n    'duplicates': df.duplicated().sum()\n}\nprint(f\"\\nData Quality Baseline:\")\nfor metric, value in quality_baseline.items():\n    print(f\"  {metric}: {value}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Distribution analysis\nfig, axes = plt.subplots(2, 2, figsize=(14, 8))\n\n# Target distribution\naxes[0, 0].hist(df['price'], bins=50, edgecolor='black')\naxes[0, 0].set_title('Price Distribution')\naxes[0, 0].set_ylabel('Frequency')\n\n# Log-transformed target (if right-skewed)\naxes[0, 1].hist(np.log1p(df['price']), bins=50, edgecolor='black')\naxes[0, 1].set_title('Log Price Distribution')\naxes[0, 1].set_ylabel('Frequency')\n\n# Feature distributions (sample)\nnumeric_cols = df.select_dtypes(include=[np.number]).columns[:2]\nfor idx, col in enumerate(numeric_cols):\n    axes[1, idx].hist(df[col], bins=30, edgecolor='black')\n    axes[1, idx].set_title(f'{col} Distribution')\n\nplt.tight_layout()\nplt.show()\n\n# Relationship analysis\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n# Scatter: feature vs target\nsns.scatterplot(data=df, x='sqft', y='price', alpha=0.5, ax=axes[0])\naxes[0].set_title('Price vs Size')\n\n# Box plot: categorical vs target\nif 'neighborhood' in df.columns:\n    sns.boxplot(data=df, x='neighborhood', y='price', ax=axes[1])\n    axes[1].set_title('Price by Neighborhood')\n\nplt.tight_layout()\nplt.show()\n\n# Correlation analysis\nnumeric_df = df.select_dtypes(include=[np.number])\ncorrelations = numeric_df.corr()[PROJECT_CONFIG['target']].sort_values(ascending=False)\nprint(\"\\nTop Correlations with Price:\")\nprint(correlations.head(10))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Implement cleaning strategy\ndef clean_dataset(df, config):\n    \"\"\"Cleaning pipeline with validation\"\"\"\n    df_clean = df.copy()\n    \n    # Step 1: Remove obvious errors/duplicates\n    duplicates_removed = df_clean.duplicated().sum()\n    df_clean = df_clean.drop_duplicates()\n    \n    # Step 2: Handle missing values\n    numeric_cols = df_clean.select_dtypes(include=[np.number]).columns\n    for col in numeric_cols:\n        if df_clean[col].isnull().any():\n            # Use median for numeric (resistant to outliers)\n            fill_value = df_clean[col].median()\n            df_clean[col] = df_clean[col].fillna(fill_value)\n    \n    # Step 3: Outlier detection (IQR method)\n    Q1 = df_clean['price'].quantile(0.25)\n    Q3 = df_clean['price'].quantile(0.75)\n    IQR = Q3 - Q1\n    outliers = ((df_clean['price'] < Q1 - 1.5*IQR) | \n                (df_clean['price'] > Q3 + 1.5*IQR)).sum()\n    \n    # Step 4: Validate key columns\n    assert df_clean[config['target']].isnull().sum() == 0, \"Target has nulls\"\n    assert (df_clean[config['target']] > 0).all(), \"Target has non-positive values\"\n    \n    print(f\"Cleaning Summary:\")\n    print(f\"  Duplicates removed: {duplicates_removed}\")\n    print(f\"  Outliers detected: {outliers}\")\n    print(f\"  Final shape: {df_clean.shape}\")\n    \n    return df_clean\n\ndf = clean_dataset(df, PROJECT_CONFIG)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def engineer_features(df):\n    \"\"\"Domain-informed feature creation\"\"\"\n    df_feat = df.copy()\n    \n    # Price per unit metrics\n    if 'sqft' in df_feat.columns:\n        df_feat['price_per_sqft'] = df_feat['price'] / (df_feat['sqft'] + 1)\n    \n    # Age features\n    if 'year_built' in df_feat.columns:\n        df_feat['age'] = 2024 - df_feat['year_built']\n        df_feat['age_squared'] = df_feat['age'] ** 2\n    \n    # Room ratios\n    if 'bedrooms' in df_feat.columns and 'bathrooms' in df_feat.columns:\n        df_feat['rooms_per_bath'] = df_feat['bedrooms'] / (df_feat['bathrooms'] + 1)\n    \n    # Encode categorical variables\n    categorical_cols = df_feat.select_dtypes(include=['object']).columns\n    for col in categorical_cols:\n        if df_feat[col].nunique() < 20:  # Only for reasonable categories\n            df_feat = pd.get_dummies(df_feat, columns=[col], drop_first=True)\n    \n    print(f\"Features engineered: {len(df_feat.columns)} (original: {len(df.columns)})\")\n    return df_feat\n\ndf = engineer_features(df)\n\n# Feature analysis\nprint(f\"\\nFeature types:\")\nprint(df.dtypes.value_counts())"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Prepare modeling data\nX = df.drop(PROJECT_CONFIG['target'], axis=1)\ny = df[PROJECT_CONFIG['target']]\n\n# Split\nX_train, X_test, y_train, y_test = train_test_split(\n    X, y, test_size=0.2, random_state=PROJECT_CONFIG['random_state']\n)\n\n# Scale\nscaler = StandardScaler()\nX_train_scaled = scaler.fit_transform(X_train)\nX_test_scaled = scaler.transform(X_test)\n\n# Train model\nmodel = RandomForestRegressor(\n    n_estimators=100,\n    max_depth=15,\n    min_samples_split=5,\n    random_state=PROJECT_CONFIG['random_state']\n)\n\nmodel.fit(X_train_scaled, y_train)\n\n# Evaluate\ny_pred_train = model.predict(X_train_scaled)\ny_pred_test = model.predict(X_test_scaled)\n\ntrain_rmse = np.sqrt(mean_squared_error(y_train, y_pred_train))\ntest_rmse = np.sqrt(mean_squared_error(y_test, y_pred_test))\ntrain_r2 = r2_score(y_train, y_pred_train)\ntest_r2 = r2_score(y_test, y_pred_test)\n\nprint(f\"Model Performance:\")\nprint(f\"  Train RMSE: ${train_rmse:,.0f}\")\nprint(f\"  Test RMSE:  ${test_rmse:,.0f}\")\nprint(f\"  Train R\u00b2: {train_r2:.4f}\")\nprint(f\"  Test R\u00b2:  {test_r2:.4f}\")\n\n# Feature importance\nfeature_importance = pd.DataFrame({\n    'feature': X.columns,\n    'importance': model.feature_importances_\n}).sort_values('importance', ascending=False)\n\nprint(f\"\\nTop 10 Important Features:\")\nprint(feature_importance.head(10))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Generate insights\ninsights_report = f\"\"\"\nPROJECT SUMMARY: {PROJECT_CONFIG['name']}\n{'='*60}\n\nOBJECTIVES:\n{chr(10).join(f'  \u2713 {obj}' for obj in PROJECT_CONFIG['objectives'])}\n\nDATA QUALITY:\n  - Dataset: {len(df)} properties analyzed\n  - Features: {len(X.columns)} variables\n  - Missing data: Minimal after cleaning\n\nKEY FINDINGS:\n  1. Most important factors: {', '.join(feature_importance['feature'].head(3).tolist())}\n  2. Model explains {test_r2:.1%} of price variance\n  3. Average prediction error: ${test_rmse:,.0f}\n\nMODEL PERFORMANCE:\n  - Test R\u00b2 Score: {test_r2:.4f} (explains {test_r2:.1%} of variance)\n  - Test RMSE: ${test_rmse:,.0f}\n  - Overfitting check: Train-Test R\u00b2 gap = {train_r2 - test_r2:.4f}\n\nBUSINESS RECOMMENDATIONS:\n  1. Use model for price estimation in target market\n  2. Focus property improvements on top features\n  3. Monitor model performance over time\n\nNEXT STEPS:\n  - Collect more data for model validation\n  - Implement real-time prediction system\n  - Monitor feature importance changes\n\"\"\"\n\nprint(insights_report)\n\n# Save report\nwith open('analysis_report.txt', 'w') as f:\n    f.write(insights_report)\n\n# Visualization summary\nfig, axes = plt.subplots(2, 2, figsize=(14, 10))\n\n# Feature importance\naxes[0, 0].barh(feature_importance['feature'].head(10), \n                feature_importance['importance'].head(10))\naxes[0, 0].set_title('Top 10 Feature Importance')\n\n# Predictions vs actual\naxes[0, 1].scatter(y_test, y_pred_test, alpha=0.5)\naxes[0, 1].plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], 'r--')\naxes[0, 1].set_xlabel('Actual Price')\naxes[0, 1].set_ylabel('Predicted Price')\naxes[0, 1].set_title('Model Predictions')\n\n# Residuals\nresiduals = y_test - y_pred_test\naxes[1, 0].hist(residuals, bins=30, edgecolor='black')\naxes[1, 0].set_xlabel('Residuals ($)')\naxes[1, 0].set_title('Prediction Errors')\n\n# Residuals vs predicted\naxes[1, 1].scatter(y_pred_test, residuals, alpha=0.5)\naxes[1, 1].axhline(y=0, color='r', linestyle='--')\naxes[1, 1].set_xlabel('Predicted Price')\naxes[1, 1].set_ylabel('Residuals')\naxes[1, 1].set_title('Residual Analysis')\n\nplt.tight_layout()\nplt.savefig('analysis_results.png', dpi=300)\nplt.show()"
