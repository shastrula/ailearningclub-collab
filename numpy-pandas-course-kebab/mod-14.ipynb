        [
          "python",
          "import plotly.express as px\nimport plotly.graph_objects as go\n\n# Create sample data\nnp.random.seed(42)\nsales_data = pd.DataFrame({\n    'Date': pd.date_range('2024-01-01', periods=100),\n    'Product_A': np.cumsum(np.random.normal(100, 30, 100)) + 1000,\n    'Product_B': np.cumsum(np.random.normal(80, 25, 100)) + 1500,\n    'Product_C': np.cumsum(np.random.normal(120, 35, 100)) + 800\n})\n\n# Interactive line plot\nfig = px.line(sales_data, x='Date', \n              y=['Product_A', 'Product_B', 'Product_C'],\n              title='Sales by Product',\n              labels={'value': 'Sales ($)', 'Date': 'Date'},\n              hover_data=True)\nfig.update_layout(hovermode='x unified')\nfig.show()\n\n# Interactive scatter\nscatter_data = pd.DataFrame({\n    'Revenue': np.random.uniform(1000, 10000, 50),\n    'Expenses': np.random.uniform(500, 8000, 50),\n    'Company': [f'Company_{i}' for i in range(50)],\n    'Industry': np.random.choice(['Tech', 'Retail', 'Finance'], 50)\n})\n\nfig = px.scatter(scatter_data, x='Expenses', y='Revenue', \n                 color='Industry', size='Revenue',\n                 hover_name='Company',\n                 title='Profitability Analysis',\n                 labels={'Revenue': 'Revenue ($)', 'Expenses': 'Expenses ($)'})\nfig.show()\n\n# Interactive box plot\nbox_data = pd.DataFrame({\n    'Value': np.concatenate([np.random.normal(100, 10, 100),\n                              np.random.normal(120, 15, 100),\n                              np.random.normal(110, 12, 100)]),\n    'Group': ['Group_A']*100 + ['Group_B']*100 + ['Group_C']*100\n})\n\nfig = px.box(box_data, x='Group', y='Value', title='Distribution by Group')\nfig.show()"
        ]
      ]
