        [
          "python",
          "import seaborn as sns\n\n# Create correlated data\nn = 200\nx = np.random.normal(0, 1, n)\ndata_corr = pd.DataFrame({\n    'var1': x,\n    'var2': x + np.random.normal(0, 0.3, n),\n    'var3': -x + np.random.normal(0, 0.3, n),\n    'var4': np.random.normal(0, 1, n),\n    'var5': 2*x + np.random.normal(0, 0.5, n)\n})\n\n# Correlation matrix heatmap\ncorr_matrix = data_corr.corr()\n\nfig, ax = plt.subplots(figsize=(8, 6))\nsns.heatmap(corr_matrix, annot=True, fmt='.2f', cmap='coolwarm', center=0,\n            square=True, linewidths=0.5, ax=ax, vmin=-1, vmax=1,\n            cbar_kws={'label': 'Correlation'})\nax.set_title('Correlation Matrix Heatmap')\nplt.tight_layout()\nplt.show()\n\n# Contingency table heatmap\n# Create sample categorical data\nsample_data = pd.DataFrame({\n    'Product': np.random.choice(['A', 'B', 'C'], 500),\n    'Region': np.random.choice(['North', 'South', 'East', 'West'], 500)\n})\n\ncontingency = pd.crosstab(sample_data['Product'], sample_data['Region'])\n\nfig, ax = plt.subplots(figsize=(8, 5))\nsns.heatmap(contingency, annot=True, fmt='d', cmap='YlOrRd', ax=ax,\n            cbar_kws={'label': 'Count'})\nax.set_title('Product Sales by Region')\nplt.tight_layout()\nplt.show()\n\n# Time-based heatmap (e.g., hourly patterns)\nhours = np.tile(range(24), 7)\ndays = np.repeat(['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'], 24)\ntraffic = pd.DataFrame({\n    'hour': hours,\n    'day': days,\n    'page_views': np.random.poisson(100 + 50*np.sin(np.array(hours)*np.pi/12), 168)\n})\n\npivot_traffic = traffic.pivot(index='day', columns='hour', values='page_views')\n\nfig, ax = plt.subplots(figsize=(14, 5))\nsns.heatmap(pivot_traffic, cmap='YlGnBu', ax=ax, cbar_kws={'label': 'Page Views'})\nax.set_title('Website Traffic: Daily Pattern (Hour x Day)')\nplt.tight_layout()\nplt.show()"
        ]
      ]
