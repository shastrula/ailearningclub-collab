        [
          "python",
          "import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom matplotlib.gridspec import GridSpec\n\n# Sample data\nnp.random.seed(42)\ndates = pd.date_range('2024-01-01', periods=100)\ndf = pd.DataFrame({\n    'temperature': np.cumsum(np.random.normal(0, 2, 100)) + 70,\n    'humidity': np.random.normal(60, 10, 100).clip(20, 100),\n    'pressure': np.random.normal(1013, 5, 100),\n    'rainfall': np.random.exponential(0.5, 100)\n}, index=dates)\n\n# 2x2 subplot grid\nfig, axes = plt.subplots(2, 2, figsize=(12, 8))\n\naxes[0, 0].plot(df.index, df['temperature'], color='red', linewidth=2)\naxes[0, 0].set_title('Temperature Over Time')\naxes[0, 0].set_ylabel('\u00b0F')\n\naxes[0, 1].hist(df['humidity'], bins=20, color='blue', alpha=0.7, edgecolor='black')\naxes[0, 1].set_title('Humidity Distribution')\naxes[0, 1].set_xlabel('Humidity %')\n\naxes[1, 0].plot(df.index, df['pressure'], color='green', linewidth=1.5)\naxes[1, 0].set_title('Pressure Trend')\naxes[1, 0].set_ylabel('mb')\n\naxes[1, 1].plot(df.index, df['rainfall'], color='purple', linestyle='--')\naxes[1, 1].set_title('Rainfall Events')\naxes[1, 1].set_ylabel('Inches')\n\nplt.tight_layout()\nplt.show()\n\n# 1x3 comparison layout\nfig, axes = plt.subplots(1, 3, figsize=(15, 4))\n\nfor i, col in enumerate(['temperature', 'humidity', 'pressure']):\n    axes[i].plot(df.index, df[col], linewidth=2)\n    axes[i].set_title(f'{col.capitalize()} Trend')\n    axes[i].grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.show()\n\n# Custom GridSpec for unequal sizes\nfig = plt.figure(figsize=(12, 6))\ngs = GridSpec(2, 3, figure=fig)\n\n# Larger plot on left\nax_main = fig.add_subplot(gs[:, 0])\nax_main.plot(df.index, df['temperature'], linewidth=2)\nax_main.set_title('Main: Temperature')\n\n# Smaller plots on right\nax1 = fig.add_subplot(gs[0, 1:])\nax1.plot(df.index, df['humidity'])\nax1.set_title('Humidity')\n\nax2 = fig.add_subplot(gs[1, 1:])\nax2.plot(df.index, df['pressure'])\nax2.set_title('Pressure')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
