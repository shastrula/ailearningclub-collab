        [
          "python",
          "# Create dataset with multiple variables\niris_sample = pd.DataFrame({\n    'Sepal_Length': np.random.normal(5.8, 0.8, 100),\n    'Sepal_Width': np.random.normal(3.0, 0.4, 100),\n    'Petal_Length': np.random.normal(3.8, 1.7, 100),\n    'Petal_Width': np.random.normal(1.2, 0.8, 100),\n    'Species': np.random.choice(['setosa', 'versicolor', 'virginica'], 100)\n})\n\n# Simple pairplot\n# Note: seaborn's pairplot is easier, but using matplotlib manually:\nnumeric_cols = [col for col in iris_sample.columns if col != 'Species']\nn_vars = len(numeric_cols)\n\nfig, axes = plt.subplots(n_vars, n_vars, figsize=(12, 12))\n\nfor i in range(n_vars):\n    for j in range(n_vars):\n        ax = axes[i, j]\n        \n        if i == j:\n            # Diagonal: histogram\n            ax.hist(iris_sample[numeric_cols[i]], bins=15, alpha=0.7, color='blue')\n        else:\n            # Off-diagonal: scatter\n            for species in iris_sample['Species'].unique():\n                subset = iris_sample[iris_sample['Species'] == species]\n                ax.scatter(subset[numeric_cols[j]], subset[numeric_cols[i]], \n                          alpha=0.6, label=species, s=30)\n        \n        if i == n_vars - 1:\n            ax.set_xlabel(numeric_cols[j], fontsize=9)\n        if j == 0:\n            ax.set_ylabel(numeric_cols[i], fontsize=9)\n\nfig.suptitle('Pair Plot: Multivariate Relationships', fontsize=14, fontweight='bold')\nplt.tight_layout()\nplt.show()\n\n# Using seaborn (simpler)\nsns.pairplot(iris_sample, hue='Species', diag_kind='hist', plot_kws={'alpha': 0.6})\nplt.show()"
        ]
      ]
