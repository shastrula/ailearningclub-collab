          "python",
          "# Simple geographic visualization\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Sample: city locations and population\ncities = pd.DataFrame({\n    'city': ['New York', 'Los Angeles', 'Chicago', 'Houston', 'Phoenix'],\n    'latitude': [40.7128, 34.0522, 41.8781, 29.7604, 33.4484],\n    'longitude': [-74.0060, -118.2437, -87.6298, -95.3698, -112.0742],\n    'population': [8000000, 3900000, 2700000, 2300000, 1600000]\n})\n\nfig, ax = plt.subplots(figsize=(12, 7))\n\n# Size by population, color by population\nscatter = ax.scatter(cities['longitude'], cities['latitude'],\n                    s=cities['population']/5000,  # Scale for visibility\n                    c=cities['population'],\n                    cmap='YlOrRd',\n                    alpha=0.6,\n                    edgecolors='black',\n                    linewidth=2)\n\n# Add city labels\nfor idx, row in cities.iterrows():\n    ax.annotate(row['city'], \n               xy=(row['longitude'], row['latitude']),\n               xytext=(5, 5),\n               textcoords='offset points',\n               fontsize=10,\n               fontweight='bold')\n\nax.set_xlabel('Longitude', fontsize=12)\nax.set_ylabel('Latitude', fontsize=12)\nax.set_title('US Major Cities by Population', fontsize=14, fontweight='bold')\nax.grid(True, alpha=0.3)\n\ncbar = fig.colorbar(scatter, ax=ax)\ncbar.set_label('Population', fontsize=11)\n\nplt.tight_layout()\nplt.show()\n\n# Network-style visualization\nfig, ax = plt.subplots(figsize=(10, 8))\n\n# Create adjacency relationships (which cities are \"connected\")\nconnections = [(0, 1), (0, 2), (1, 3), (2, 3), (3, 4), (0, 4)]\n\nfor i, j in connections:\n    ax.plot([cities.iloc[i]['longitude'], cities.iloc[j]['longitude']],\n           [cities.iloc[i]['latitude'], cities.iloc[j]['latitude']],\n           'k-', alpha=0.3, linewidth=2)\n\nax.scatter(cities['longitude'], cities['latitude'],\n          s=500, c=cities['population'], cmap='viridis',\n          edgecolors='black', linewidth=2, zorder=3)\n\nfor idx, row in cities.iterrows():\n    ax.annotate(row['city'][:3], \n               xy=(row['longitude'], row['latitude']),\n               ha='center', va='center',\n               fontsize=9, fontweight='bold', color='white')\n\nax.set_title('City Network Connections', fontsize=14, fontweight='bold')\nax.grid(True, alpha=0.2)\nplt.tight_layout()\nplt.show()"
        ]
