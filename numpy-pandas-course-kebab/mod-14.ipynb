        [
          "python",
          "# Data with different ranges\nfig, ax1 = plt.subplots(figsize=(10, 6))\n\n# First axis (left)\ncolor1 = 'tab:red'\nax1.set_xlabel('Date')\nax1.set_ylabel('Temperature (\u00b0F)', color=color1)\nax1.plot(df.index, df['temperature'], color=color1, linewidth=2, label='Temperature')\nax1.tick_params(axis='y', labelcolor=color1)\n\n# Second axis (right) - shares x-axis\nax2 = ax1.twinx()\ncolor2 = 'tab:blue'\nax2.set_ylabel('Humidity (%)', color=color2)\nax2.plot(df.index, df['humidity'], color=color2, linewidth=2, linestyle='--', label='Humidity')\nax2.tick_params(axis='y', labelcolor=color2)\n\nfig.suptitle('Temperature and Humidity (Different Scales)', fontsize=14, fontweight='bold')\nfig.tight_layout()\nplt.show()\n\n# Triple axis plot\nfig, ax1 = plt.subplots(figsize=(12, 6))\n\nax1.plot(df.index, df['temperature'], color='red', linewidth=2, label='Temp')\nax1.set_ylabel('Temperature (\u00b0F)', color='red')\n\nax2 = ax1.twinx()\nax2.plot(df.index, df['humidity'], color='blue', linewidth=2, label='Humidity')\nax2.set_ylabel('Humidity (%)', color='blue')\n\nax3 = ax1.twinx()\nax3.spines['right'].set_position(('outward', 60))\nax3.plot(df.index, df['pressure'], color='green', linewidth=2, linestyle='--', label='Pressure')\nax3.set_ylabel('Pressure (mb)', color='green')\n\nfig.suptitle('Three Variables with Different Scales')\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
