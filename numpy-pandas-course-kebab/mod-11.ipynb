        [
          "python",
          "# Simulate daily stock data\nnp.random.seed(42)\ndates = pd.date_range('2023-01-01', periods=252, freq='B')  # Business days only\nreturns = np.random.normal(0.0005, 0.02, 252)\nprices = 100 * np.exp(np.cumsum(returns))\n\nstock_data = pd.DataFrame({\n    'price': prices,\n    'volume': np.random.randint(1000000, 5000000, 252)\n}, index=dates)\n\n# Add technical indicators\nstock_data['ma_20'] = stock_data['price'].rolling(20).mean()\nstock_data['ma_50'] = stock_data['price'].rolling(50).mean()\nstock_data['volatility'] = stock_data['price'].pct_change().rolling(20).std()\nstock_data['returns'] = stock_data['price'].pct_change()\n\nprint(\"Stock data with indicators:\\n\", stock_data.tail())\n\n# Resample to weekly\nweekly = stock_data.resample('W').agg({\n    'price': 'last',\n    'volume': 'sum',\n    'returns': lambda x: (1 + x).prod() - 1\n})\nprint(\"\\nWeekly data:\\n\", weekly.tail())\n\n# Identify periods with high volatility\nhigh_vol = stock_data[stock_data['volatility'] > stock_data['volatility'].quantile(0.75)]\nprint(f\"\\nHigh volatility days: {len(high_vol)} out of {len(stock_data)}\")\n\n# Calculate metrics\nannual_return = (1 + stock_data['returns'].mean()) ** 252 - 1\nannual_volatility = stock_data['returns'].std() * np.sqrt(252)\nsharpe_ratio = annual_return / annual_volatility\n\nprint(f\"\\nAnnual return: {annual_return:.2%}\")\nprint(f\"Annual volatility: {annual_volatility:.2%}\")\nprint(f\"Sharpe ratio: {sharpe_ratio:.2f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
