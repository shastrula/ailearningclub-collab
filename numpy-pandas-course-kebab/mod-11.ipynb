          "python",
          "import pandas as pd\nimport numpy as np\n\n# Create DatetimeIndex from dates\ndates = pd.date_range('2024-01-01', periods=365, freq='D')\nprint(\"Date range:\\n\", dates[:5])\n\n# Create time series with DatetimeIndex\nnp.random.seed(42)\nprices = pd.Series(\n    np.random.randn(365).cumsum() + 100,\n    index=dates\n)\nprint(\"\\nTime series head:\\n\", prices.head())\n\n# Convert existing column to DatetimeIndex\ndf = pd.DataFrame({\n    'date': ['2024-01-01', '2024-01-02', '2024-01-03'],\n    'value': [10, 15, 12]\n})\ndf['date'] = pd.to_datetime(df['date'])\ndf = df.set_index('date')\nprint(\"\\nConverted to DatetimeIndex:\\n\", df)\n\n# Time-based slicing\njanuary = prices['2024-01']\nprint(f\"\\nJanuary has {len(january)} observations\")\n\n# Slice by date range\nperiod = prices['2024-01-15':'2024-01-25']\nprint(\"\\nSpecific period:\\n\", period)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Create daily data\ndaily_sales = pd.Series(\n    np.random.randint(100, 500, 60),\n    index=pd.date_range('2024-01-01', periods=60, freq='D')\n)\n\n# Upsample to every 6 hours (data becomes sparse)\nupsampled = daily_sales.resample('6H').mean()\nprint(\"Upsampled to 6-hour intervals:\\n\", upsampled.head())\n\n# Downsample to weekly\nweekly = daily_sales.resample('W').sum()\nprint(\"\\nWeekly totals:\\n\", weekly)\n\n# Monthly aggregation with different functions\nmonthly_stats = daily_sales.resample('M').agg(['sum', 'mean', 'count', 'std'])\nprint(\"\\nMonthly statistics:\\n\", monthly_stats)\n\n# Business day resampling\nbusiness_only = daily_sales.resample('B').sum()  # 'B' = business day\nprint(f\"\\nBusiness days only: {len(business_only)} vs {len(weekly)} weeks\")\n\n# Fill missing values when upsampling\nupsampled_filled = daily_sales.resample('6H').ffill()  # forward fill\nprint(\"\\nUpsampled with forward fill:\\n\", upsampled_filled.head(10))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Create volatile data\nvolatile = pd.Series(\n    np.random.normal(0, 1, 100).cumsum(),\n    index=pd.date_range('2024-01-01', periods=100)\n)\n\n# 7-day rolling mean (smoothing)\nrolling_mean = volatile.rolling(window=7).mean()\nprint(\"Rolling mean (7-day):\\n\", rolling_mean.head(10))\n\n# 14-day rolling standard deviation\nrolling_std = volatile.rolling(window=14).std()\nprint(\"\\nRolling std (14-day):\\n\", rolling_std.head(15))\n\n# Bollinger Bands (mean \u00b1 2 std)\nma = volatile.rolling(window=20).mean()\nstd = volatile.rolling(window=20).std()\nupper = ma + 2 * std\nlower = ma - 2 * std\n\nbollinger = pd.DataFrame({\n    'value': volatile,\n    'ma': ma,\n    'upper': upper,\n    'lower': lower\n})\nprint(\"\\nBollinger Bands:\\n\", bollinger.tail())\n\n# Center the window (asymmetric rolling)\ncentered = volatile.rolling(window=7, center=True).mean()\nprint(\"\\nCentered rolling mean:\\n\", centered[5:12])\n\n# Expanding window (growing window size)\nexpanding_mean = volatile.expanding().mean()\nprint(f\"\\nExpanding mean length: {len(expanding_mean)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Shift forward (look ahead)\nprices = pd.Series([100, 102, 101, 105, 103], \n                     index=pd.date_range('2024-01-01', periods=5, freq='D'))\n\nshifted_forward = prices.shift(-1)  # Negative shift\nprint(\"Original prices:\\n\", prices)\nprint(\"\\nShifted forward (next day):\\n\", shifted_forward)\n\n# Compute returns\ndaily_returns = prices.pct_change() * 100  # percentage change\nprint(\"\\nDaily returns (%):\\n\", daily_returns)\n\n# Difference (absolute change)\nprice_change = prices.diff()\nprint(\"\\nPrice changes:\\n\", price_change)\n\n# Multi-period shift\nlag_1 = prices.shift(1)\nlag_2 = prices.shift(2)\n\nfeatures = pd.DataFrame({\n    'price': prices,\n    'prev_1_day': lag_1,\n    'prev_2_days': lag_2,\n    'return': daily_returns\n})\nprint(\"\\nLagged features:\\n\", features)\n\n# Multiple differences for stationarity\ndiff_1 = prices.diff()\ndiff_2 = diff_1.diff()\nprint(\"\\nFirst difference:\\n\", diff_1)\nprint(\"\\nSecond difference:\\n\", diff_2)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
