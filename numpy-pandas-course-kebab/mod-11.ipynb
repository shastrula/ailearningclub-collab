      "outputs": [],
      "source": [
        [
          "python",
          "# Forecasting demonstration\nfrom statsmodels.tsa.holtwinters import ExponentialSmoothing\nfrom sklearn.ensemble import IsolationForest\n\n# Fit exponential smoothing model\nnp.random.seed(42)\ndates = pd.date_range('2023-01-01', periods=100, freq='D')\ndata_trend = np.arange(100) * 0.5 + 100\ndata_seasonality = 5 * np.sin(np.arange(100) * 2 * np.pi / 30)\nts_complete = data_trend + data_seasonality + np.random.normal(0, 1, 100)\n\nts_series = pd.Series(ts_complete, index=dates)\n\n# Exponential smoothing\nmodel = ExponentialSmoothing(ts_series, trend='add', seasonal_periods=30)\nfitted = model.fit()\n\n# Forecast next 30 days\nforecast = fitted.get_forecast(steps=30)\nprint(\"Forecast next 30 days:\\n\", forecast.predicted_mean)\n\n# Calculate forecast error on training data\nmae = np.mean(np.abs(ts_series - fitted.fittedvalues))\nprint(f\"\\nTraining MAE: {mae:.3f}\")\n\n# Anomaly detection\niso_forest = IsolationForest(contamination=0.05)\nanomalies = iso_forest.fit_predict(ts_complete.reshape(-1, 1)) == -1\n\nprint(f\"\\nDetected {anomalies.sum()} anomalies out of {len(ts_complete)}\")\nprint(\"Anomaly indices:\", np.where(anomalies)[0][:5])"
        ]
      ]
    }
