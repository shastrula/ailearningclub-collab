      "source": [
        [
          "python",
          "# Create timezone-aware index\nutc_index = pd.date_range('2024-01-01', periods=5, freq='D', tz='UTC')\nprint(\"UTC times:\\n\", utc_index)\n\n# Convert to different timezone\nest = utc_index.tz_convert('US/Eastern')\nprint(\"\\nUS/Eastern times:\\n\", est)\n\n# Localize naive datetime to timezone\nnaive = pd.date_range('2024-01-01', periods=3, freq='D')\nlocalized = naive.tz_localize('UTC').tz_convert('Asia/Tokyo')\nprint(\"\\nLocalized to UTC then converted to Tokyo:\\n\", localized)\n\n# Period vs Timestamp\n# Timestamp: specific moment in time\ntimestamps = pd.period_range('2024-01', periods=6, freq='M')\nprint(\"\\nPeriod index (months):\\n\", timestamps)\n\n# Convert period to timestamp\nperiod_ts = timestamps.to_timestamp()\nprint(\"\\nConverted to timestamps:\\n\", period_ts)\n\n# Create PeriodIndex directly\nperiod_index = pd.PeriodIndex(['2024Q1', '2024Q2', '2024Q3'], freq='Q')\nprint(\"\\nQuarterly periods:\\n\", period_index)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Create comprehensive time series features\nnp.random.seed(42)\ndates = pd.date_range('2023-01-01', periods=365, freq='D')\nbase_trend = np.arange(365) / 100\nseasonality = 20 * np.sin(np.arange(365) * 2 * np.pi / 365)\nnoise = np.random.normal(0, 5, 365)\nsales = 100 + base_trend + seasonality + noise\n\nts_df = pd.DataFrame({\n    'date': dates,\n    'sales': sales\n})\nts_df.set_index('date', inplace=True)\n\n# Lag features\nts_df['lag_1'] = ts_df['sales'].shift(1)\nts_df['lag_7'] = ts_df['sales'].shift(7)\nts_df['lag_30'] = ts_df['sales'].shift(30)\n\n# Differencing for stationarity\nts_df['diff_1'] = ts_df['sales'].diff()\nts_df['diff_365'] = ts_df['sales'].diff(365)\n\n# Calendar features\nts_df['day_of_week'] = ts_df.index.dayofweek\nts_df['day_of_month'] = ts_df.index.day\nts_df['month'] = ts_df.index.month\nts_df['quarter'] = ts_df.index.quarter\nts_df['week_of_year'] = ts_df.index.isocalendar().week\n\n# Rolling statistics (different windows)\nts_df['ma_7'] = ts_df['sales'].rolling(7).mean()\nts_df['ma_30'] = ts_df['sales'].rolling(30).mean()\nts_df['volatility_7'] = ts_df['sales'].rolling(7).std()\n\nprint(\"Feature-rich time series:\\n\", ts_df.head(10))\nprint(\"\\nCorrelation with lag features:\")\nprint(ts_df[['sales', 'lag_1', 'lag_7', 'lag_30']].corr())\n\n# Seasonal decomposition\nfrom statsmodels.tsa.seasonal import seasonal_decompose\ndecomposition = seasonal_decompose(ts_df['sales'], model='additive', period=365)\nprint(\"\\nDecomposition components shape:\")\nprint(f\"Trend: {decomposition.trend.shape}\")\nprint(f\"Seasonal: {decomposition.seasonal.shape}\")\nprint(f\"Residual: {decomposition.resid.shape}\")"
        ]
      ]
    },
