        [
          "python",
          "# Create data with missing values\ndata_missing = pd.DataFrame({\n    'col_a': [1, 2, np.nan, 4, 5, np.nan, 7, 8, 9, 10],\n    'col_b': [10, np.nan, np.nan, 40, 50, 60, np.nan, 80, 90, 100],\n    'col_c': [100, 200, 300, 400, 500, 600, 700, 800, 900, 1000]\n})\n\n# Missing count and percentage\nmissing_count = data_missing.isnull().sum()\nmissing_percent = (data_missing.isnull().sum() / len(data_missing)) * 100\n\nmissing_info = pd.DataFrame({\n    'Count': missing_count,\n    'Percent': missing_percent\n})\nprint(\"Missing data analysis:\\n\", missing_info)\n\n# Rows with any missing\nrows_any_missing = data_missing.isnull().any(axis=1).sum()\nprint(f\"\\nRows with any missing: {rows_any_missing}\")\n\n# Complete cases\ncomplete_rows = data_missing.dropna()\nprint(f\"Complete rows: {len(complete_rows)}\")\n\n# Missing pattern visualization\nmissing_pattern = data_missing.isnull().astype(int)\nprint(\"\\nMissing pattern (1=missing, 0=present):\\n\", missing_pattern)"
        ]
      ]
    },
    {
