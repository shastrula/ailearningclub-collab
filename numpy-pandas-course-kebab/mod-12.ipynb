      "source": [
        "# Numpy Pandas Course Kebab - mod-12\n\n",
        "**Course:** numpy-pandas-course-kebab\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import pandas as pd\nimport numpy as np\n\n# Load sample data\nnp.random.seed(42)\ndata = pd.DataFrame({\n    'age': np.random.randint(18, 75, 100),\n    'income': np.random.normal(60000, 15000, 100),\n    'credit_score': np.random.randint(300, 850, 100),\n    'tenure_months': np.random.exponential(24, 100)\n})\n\n# Basic describe\nsummary = data.describe()\nprint(\"Statistical summary:\\n\", summary)\n\n# Include all percentiles\ndetailed = data.describe(percentiles=[0.1, 0.25, 0.5, 0.75, 0.9, 0.95, 0.99])\nprint(\"\\nDetailed percentiles:\\n\", detailed)\n\n# Include object columns\nmixed_data = data.copy()\nmixed_data['category'] = np.random.choice(['A', 'B', 'C'], 100)\nmixed_summary = mixed_data.describe(include='all')\nprint(\"\\nIncluding categorical:\\n\", mixed_summary)\n\n# Transpose for readability\ntransposed = summary.T\nprint(\"\\nTransposed (better for many columns):\\n\", transposed)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Categorical column\ncategories = pd.Series(\n    np.random.choice(['Active', 'Inactive', 'Pending', 'Active', 'Cancelled'], 1000)\n)\n\n# Basic value counts\nfreq = categories.value_counts()\nprint(\"Value counts:\\n\", freq)\n\n# Sorted by index instead of frequency\nsorted_freq = categories.value_counts().sort_index()\nprint(\"\\nSorted by index:\\n\", sorted_freq)\n\n# Include NaN values\ndata_with_nan = pd.Series(['A', 'B', 'A', np.nan, 'B', 'A', np.nan])\nfreq_with_nan = data_with_nan.value_counts(dropna=False)\nprint(\"\\nIncluding NaN:\\n\", freq_with_nan)\n\n# Normalize to proportions\nproportions = categories.value_counts(normalize=True)\nprint(\"\\nProportions:\\n\", proportions)\n\n# Top N categories\ntop_3 = categories.value_counts().head(3)\nprint(\"\\nTop 3 categories:\\n\", top_3)\n\n# Find rare values\nstatus = pd.Series(np.random.choice(['OK', 'WARNING', 'ERROR', 'CRITICAL'], 500, p=[0.8, 0.1, 0.05, 0.05]))\nrare = status.value_counts().tail(2)\nprint(\"\\nRare values:\\n\", rare)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Create correlated data\nnp.random.seed(42)\nn = 100\nx = np.random.normal(0, 1, n)\ndf = pd.DataFrame({\n    'var1': x,\n    'var2': x + np.random.normal(0, 0.3, n),  # Highly correlated with var1\n    'var3': -x + np.random.normal(0, 0.3, n),  # Negatively correlated\n    'var4': np.random.normal(0, 1, n)  # Independent\n})\n\n# Correlation matrix (Pearson by default)\ncorr = df.corr()\nprint(\"Pearson correlation:\\n\", corr)\n\n# Other correlation methods\nspearman_corr = df.corr(method='spearman')\nprint(\"\\nSpearman correlation:\\n\", spearman_corr)\n\n# Single column correlation\ncorr_with_var1 = df.corr()['var1'].sort_values(ascending=False)\nprint(\"\\nCorrelation with var1:\\n\", corr_with_var1)\n\n# Find highly correlated pairs\ndef find_high_corr(corr_matrix, threshold=0.7):\n    \"\"\"Find pairs with correlation > threshold\"\"\"\n    for i in range(len(corr_matrix.columns)):\n        for j in range(i+1, len(corr_matrix.columns)):\n            if abs(corr_matrix.iloc[i, j]) > threshold:\n                col_i = corr_matrix.columns[i]\n                col_j = corr_matrix.columns[j]\n                corr_val = corr_matrix.iloc[i, j]\n                print(f\"{col_i} \u2194 {col_j}: {corr_val:.3f}\")\n\nfind_high_corr(corr)\n\n# Kendall correlation for ordinal data\ndata_ordinal = pd.DataFrame({\n    'rank': [1, 2, 3, 4, 5],\n    'score': [85, 90, 88, 92, 95]\n})\nkendall = data_ordinal.corr(method='kendall')\nprint(\"\\nKendall correlation for ranks:\\n\", kendall)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Different distributions\nnormal_dist = np.random.normal(100, 15, 1000)\nskewed_dist = np.random.gamma(2, 2, 1000)  # Right-skewed\nbimodal = np.concatenate([np.random.normal(50, 10, 500), \n                          np.random.normal(150, 10, 500)])\n\ndistributions = pd.DataFrame({\n    'normal': normal_dist,\n    'skewed': skewed_dist,\n    'bimodal': bimodal\n})\n\n# Statistical measures of distribution shape\nprint(\"Distribution statistics:\")\nprint(distributions.describe())\n\n# Skewness (asymmetry)\nskewness = distributions.skew()\nprint(\"\\nSkewness:\\n\", skewness)\n\n# Kurtosis (tailedness)\nkurtosis = distributions.kurtosis()\nprint(\"\\nKurtosis:\\n\", kurtosis)\n\n# Mode (most frequent value) - requires binning\ndef get_mode_class(series, bins=10):\n    \"\"\"Get the bin with most values\"\"\"\n    binned = pd.cut(series, bins=bins)\n    return binned.value_counts().idxmax()\n\nmode_normal = get_mode_class(distributions['normal'])\nprint(f\"\\nMode class (normal): {mode_normal}\")\n\n# Quantile analysis\nquantiles = [0.01, 0.05, 0.25, 0.5, 0.75, 0.95, 0.99]\nquant_values = distributions['normal'].quantile(quantiles)\nprint(\"\\nQuantiles:\\n\", quant_values)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Create data with outliers\nnormal_data = np.random.normal(100, 10, 95)\noutliers = np.array([150, 155, 160, 165, 170])\ndata_with_outliers = np.concatenate([normal_data, outliers])\nseries = pd.Series(data_with_outliers)\n\n# IQR method (Interquartile Range)\nQ1 = series.quantile(0.25)\nQ3 = series.quantile(0.75)\nIQR = Q3 - Q1\nlower_bound = Q1 - 1.5 * IQR\nupper_bound = Q3 + 1.5 * IQR\n\noutliers_iqr = series[(series < lower_bound) | (series > upper_bound)]\nprint(f\"IQR method: {len(outliers_iqr)} outliers\")\nprint(f\"Bounds: [{lower_bound:.1f}, {upper_bound:.1f}]\")\n\n# Z-score method\nz_scores = np.abs((series - series.mean()) / series.std())\noutliers_zscore = series[z_scores > 3]\nprint(f\"\\nZ-score method (>3\u03c3): {len(outliers_zscore)} outliers\")\n\n# Modified Z-score using median absolute deviation\nmedian = series.median()\nmad = np.median(np.abs(series - median))\nmodified_z = 0.6745 * (series - median) / mad\noutliers_mad = series[np.abs(modified_z) > 3.5]\nprint(f\"\\nMAD method: {len(outliers_mad)} outliers\")\n\n# Percentage-based method\nlower_1 = series.quantile(0.01)\nupper_99 = series.quantile(0.99)\noutliers_percentile = series[(series < lower_1) | (series > upper_99)]\nprint(f\"\\n1st/99th percentile: {len(outliers_percentile)} outliers\")\nprint(f\"Bounds: [{lower_1:.1f}, {upper_99:.1f}]\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Comprehensive data quality assessment\nnp.random.seed(42)\nquality_data = pd.DataFrame({\n    'id': range(1, 101),\n    'age': np.random.randint(18, 80, 100),\n    'income': np.random.normal(60000, 20000, 100),\n    'email': ['user' + str(i) + '@example.com' for i in range(100)]\n})\n\n# Introduce quality issues\nquality_data.loc[5, 'age'] = 250  # Outlier\nquality_data.loc[10, 'age'] = np.nan  # Missing\nquality_data.loc[15:17, 'id'] = 1  # Duplicates\nquality_data.loc[20, 'income'] = -100000  # Invalid\n\nprint(\"Data Quality Report:\")\nprint(f\"Shape: {quality_data.shape}\")\nprint(f\"\\nMissing values:\\n{quality_data.isnull().sum()}\")\nprint(f\"\\nDuplicate rows: {quality_data.duplicated().sum()}\")\nprint(f\"\\nData types:\\n{quality_data.dtypes}\")\n\n# Validate ranges\nprint(f\"\\nAge range: {quality_data['age'].min()} to {quality_data['age'].max()}\")\nprint(f\"Income range: {quality_data['income'].min():.0f} to {quality_data['income'].max():.0f}\")\n\n# Identify invalid records\ninvalid_age = quality_data[(quality_data['age'] < 0) | (quality_data['age'] > 150)]\ninvalid_income = quality_data[quality_data['income'] < 0]\n\nprint(f\"\\nInvalid age records: {len(invalid_age)}\")\nprint(f\"Invalid income records: {len(invalid_income)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from scipy import stats\n\n# Statistical testing\ngroup_a = np.random.normal(100, 15, 100)\ngroup_b = np.random.normal(105, 15, 100)\n\n# T-test for group difference\nt_stat, p_value = stats.ttest_ind(group_a, group_b)\nprint(f\"T-test: t={t_stat:.3f}, p={p_value:.4f}\")\n\n# Effect size (Cohen's d)\ncohens_d = (group_a.mean() - group_b.mean()) / np.sqrt(((len(group_a)-1)*group_a.std()**2 + (len(group_b)-1)*group_b.std()**2) / (len(group_a) + len(group_b) - 2))\nprint(f\"Cohen's d: {cohens_d:.3f}\")\n\n# Normality test\nstat, p = stats.shapiro(group_a)\nprint(f\"\\nShapiro-Wilk test: stat={stat:.3f}, p={p:.4f}\")\n\n# Correlation significance\ncorr_coef, corr_p = stats.pearsonr(group_a, group_b)\nprint(f\"Correlation: r={corr_coef:.3f}, p={corr_p:.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
