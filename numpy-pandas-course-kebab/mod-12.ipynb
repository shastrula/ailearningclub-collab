          "python",
          "# Create realistic dataset\nnp.random.seed(42)\nn = 500\ndf = pd.DataFrame({\n    'age': np.random.normal(45, 15, n).clip(18, 80),\n    'income': np.random.exponential(50000, n) + 20000,\n    'credit_score': np.random.normal(700, 100, n).clip(300, 850),\n    'employment': np.random.choice(['Full-time', 'Part-time', 'Self-employed', 'Unemployed'], n),\n    'risk_level': np.random.choice(['Low', 'Medium', 'High'], n, p=[0.6, 0.3, 0.1])\n})\n\n# Add some missing values\ndf.loc[np.random.choice(df.index, 20), 'income'] = np.nan\ndf.loc[np.random.choice(df.index, 10), 'credit_score'] = np.nan\n\nprint(\"Dataset Overview:\")\nprint(df.describe())\n\nprint(\"\\n\\nCategorical Variables:\")\nfor col in ['employment', 'risk_level']:\n    print(f\"\\n{col}:\")\n    print(df[col].value_counts())\n\nprint(\"\\n\\nMissing Data:\")\nprint(df.isnull().sum())\n\nprint(\"\\n\\nCorrelation (numeric only):\")\nprint(df.corr(numeric_only=True).round(3))\n\nprint(\"\\n\\nOutliers (income - IQR method):\")\nQ1 = df['income'].quantile(0.25)\nQ3 = df['income'].quantile(0.75)\nIQR = Q3 - Q1\noutliers = df[(df['income'] < Q1 - 1.5*IQR) | (df['income'] > Q3 + 1.5*IQR)]\nprint(f\"Found {len(outliers)} outliers in income\")"
