      "outputs": [],
      "source": [
        [
          "python",
          "df = pd.DataFrame({\n    'date': pd.date_range('2024-01-01', periods=10),\n    'product': ['A', 'B'] * 5,\n    'sales': np.random.randint(100, 1000, 10),\n    'region': ['North', 'South', 'East', 'West'] * 3\n})\n\n# Chaining conditions\nresult = df[(df['product'] == 'A') & \n            (df['sales'] > 500) & \n            (df['region'].isin(['North', 'South']))]\nprint(result)\n\n# Using assign with filtering\nresult = (df\n    .query('product == \"A\"')\n    .query('sales > 500')\n    .query('region in [\"North\", \"South\"]')\n)\n\n# Combining query and loc\nresult = df.query('product == \"A\"').loc[lambda x: x['sales'] > 500]\n\n# Using .loc with multiple conditions\nresult = df.loc[\n    (df['product'] == 'A') & \n    (df['sales'] > 500) & \n    (df['region'].isin(['North', 'South']))\n]\n\n# Cleaner: use query for readability when possible\nresult = df.query('product == \"A\" and sales > 500 and region in [\"North\", \"South\"]')"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
