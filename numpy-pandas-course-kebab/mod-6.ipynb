      "outputs": [],
      "source": [
        [
          "python",
          "import pandas as pd\nimport numpy as np\n\n# Create sample DataFrame\ndf = pd.DataFrame({\n    'name': ['Alice', 'Bob', 'Charlie', 'David', 'Eve'],\n    'age': [25, 30, 35, 28, 32],\n    'salary': [50000, 60000, 75000, 55000, 65000],\n    'department': ['Sales', 'IT', 'HR', 'Sales', 'IT']\n}, index=['emp001', 'emp002', 'emp003', 'emp004', 'emp005'])\n\n# Label-based selection with loc\nprint(df.loc['emp001'])           # Single row\nprint(df.loc['emp001', 'name'])   # Specific cell\nprint(df.loc['emp001':'emp003'])  # Row slice (inclusive on both ends!)\n\n# Position-based selection with iloc\nprint(df.iloc[0])                 # First row\nprint(df.iloc[0, 0])              # First row, first column\nprint(df.iloc[0:3])               # First 3 rows (end exclusive)\nprint(df.iloc[[0, 2, 4]])         # Rows 0, 2, 4\n\n# Boolean indexing with loc\nmask = df['age'] > 30\nprint(df.loc[mask])               # Rows where age > 30\n\n# Combining loc and boolean\nprint(df.loc[mask, 'name'])       # Names of employees older than 30\n\n# Multiple conditions\nprint(df.loc[(df['age'] > 28) & (df['salary'] > 55000)])\n\n# Setting values with loc\ndf.loc['emp001', 'salary'] = 52000\ndf.loc[mask, 'department'] = 'Senior ' + df.loc[mask, 'department']\n\n# Using loc with column selection\nprint(df.loc[:, ['name', 'age']])  # All rows, specific columns"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Single condition\ndf = pd.DataFrame({\n    'product': ['A', 'B', 'A', 'C', 'B', 'A'],\n    'sales': [100, 200, 150, 300, 250, 180],\n    'region': ['North', 'South', 'North', 'East', 'South', 'West']\n})\n\nmask1 = df['sales'] > 150\nprint(df[mask1])\n\n# Multiple conditions with &, |, ~\nmask2 = (df['sales'] > 100) & (df['region'] == 'North')\nprint(df[mask2])\n\nmask3 = (df['product'] == 'A') | (df['sales'] > 250)\nprint(df[mask3])\n\nmask4 = ~(df['region'] == 'South')  # NOT operator\nprint(df[mask4])\n\n# String matching\nmask_string = df['product'].str.contains('A')\nprint(df[mask_string])\n\n# isin() for multiple values\nmask_isin = df['region'].isin(['North', 'South'])\nprint(df[mask_isin])\n\n# between() for range\nmask_between = df['sales'].between(150, 250)\nprint(df[mask_between])"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "df = pd.DataFrame({\n    'name': ['Alice', 'Bob', 'Charlie', 'David'],\n    'age': [25, 30, 35, 28],\n    'salary': [50000, 60000, 75000, 55000]\n})\n\n# Simple query\nresult = df.query('age > 28')\nprint(result)\n\n# Multiple conditions\nresult = df.query('age > 28 and salary > 60000')\nprint(result)\n\n# Using column names directly\nresult = df.query('salary > 55000 or age < 30')\nprint(result)\n\n# Negation\nresult = df.query('not (age < 30)')\nprint(result)\n\n# Using variables with @\nmin_salary = 60000\nresult = df.query('salary >= @min_salary')\nprint(result)\n\n# Complex expressions\nresult = df.query('(age > 25) and (salary > @min_salary or age > 32)')\nprint(result)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "df = pd.DataFrame({\n    'category': ['A', 'B', 'C', 'A', 'B', 'D'],\n    'value': [10, 20, 30, 15, 25, 35]\n})\n\n# isin() for multiple values\nprint(df[df['category'].isin(['A', 'C'])])\n# category  value\n# 0       A     10\n# 2       C     30\n# 3       A     15\n\n# between() for range (inclusive)\nprint(df[df['value'].between(15, 30)])\n# category  value\n# 1       B     20\n# 2       C     30\n# 3       A     15\n# 4       B     25\n\n# NOT isin()\nprint(df[~df['category'].isin(['B', 'D'])])\n\n# between() with exclude options\nprint(df[df['value'].between(15, 30, inclusive='left')])  # [15, 30)\nprint(df[df['value'].between(15, 30, inclusive='right')]) # (15, 30]\nprint(df[df['value'].between(15, 30, inclusive='neither')]) # (15, 30)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
