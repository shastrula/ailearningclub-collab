        [
          "python",
          "df = pd.DataFrame({\n    'A': [1, 2, 3, 4],\n    'B': [10, 20, 30, 40]\n})\n\n# This may trigger SettingWithCopyWarning\ndf_filtered = df[df['A'] > 2]  # This creates a view\ndf_filtered['C'] = 100         # Modifying the view warns!\n\n# Solution 1: Use .copy()\ndf_filtered = df[df['A'] > 2].copy()\ndf_filtered['C'] = 100         # No warning\n\n# Solution 2: Use .loc for in-place modification\ndf.loc[df['A'] > 2, 'C'] = 100\n\n# Solution 3: Avoid chaining assignments\ndf_temp = df[df['A'] > 2].copy()\ndf_temp['C'] = 100\n\n# Common pattern that causes warning\nfiltered = df[df['B'] > 15]    # Creates a view\nfiltered.loc[0, 'B'] = 999     # Warning!\n\n# Correct pattern\nfiltered = df[df['B'] > 15].copy()\nfiltered.loc[0, 'B'] = 999     # No warning\n\n# Using .at for single cell\ndf.at[0, 'B'] = 999            # No warning, direct access\n\n# Using .iat for position-based\ndf.iat[0, 1] = 999             # No warning, direct access"
        ]
      ]
