          "python",
          "import pandas as pd\nimport numpy as np\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\n\n# Load data\ndf = pd.read_csv('customer_churn.csv')\n\n# Explore structure\nprint(df.head())\nprint(df.dtypes)\nprint(df.isnull().sum())\n\n# Separate features and target\nX = df.drop('churn', axis=1)  # Features\ny = df['churn']  # Target (what we predict)\n\nprint(f\"Features shape: {X.shape}\")\nprint(f\"Target shape: {y.shape}\")\nprint(f\"Target distribution:\\n{y.value_counts()}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Basic train-test split\nX_train, X_test, y_train, y_test = train_test_split(\n    X, y,\n    test_size=0.2,        # 20% test, 80% train\n    random_state=42,      # Reproducibility\n    stratify=y            # Maintain class distribution\n)\n\nprint(f\"Training set: {X_train.shape}\")\nprint(f\"Test set: {X_test.shape}\")\nprint(f\"Train target distribution:\\n{y_train.value_counts(normalize=True)}\")\nprint(f\"Test target distribution:\\n{y_test.value_counts(normalize=True)}\")\n\n# For time series: don't randomize. Use temporal split.\nsplit_point = int(len(df) * 0.8)\nX_train_ts = X.iloc[:split_point]\nX_test_ts = X.iloc[split_point:]\ny_train_ts = y.iloc[:split_point]\ny_test_ts = y.iloc[split_point:]\n\n# K-fold cross-validation: more robust than single split\nfrom sklearn.model_selection import cross_val_score, StratifiedKFold\n\nkfold = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\nfrom sklearn.linear_model import LogisticRegression\n\nmodel = LogisticRegression(max_iter=1000)\ncv_scores = cross_val_score(model, X_train, y_train, cv=kfold, scoring='accuracy')\nprint(f\"CV Scores: {cv_scores}\")\nprint(f\"Mean CV Score: {cv_scores.mean():.4f} (+/- {cv_scores.std():.4f})\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.pipeline import Pipeline\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\nfrom sklearn.compose import ColumnTransformer\n\n# Identify column types\nnumeric_cols = X_train.select_dtypes(include=[np.number]).columns.tolist()\ncategorical_cols = X_train.select_dtypes(include=['object']).columns.tolist()\n\nprint(f\"Numeric: {numeric_cols}\")\nprint(f\"Categorical: {categorical_cols}\")\n\n# Define preprocessing for each type\nnumeric_transformer = Pipeline(steps=[\n    ('scaler', StandardScaler())\n])\n\ncategorical_transformer = Pipeline(steps=[\n    ('onehot', OneHotEncoder(drop='first', sparse_output=False))\n])\n\n# Combine transformers\npreprocessor = ColumnTransformer(\n    transformers=[\n        ('num', numeric_transformer, numeric_cols),\n        ('cat', categorical_transformer, categorical_cols)\n    ]\n)\n\n# Full pipeline: preprocessing + model\nfull_pipeline = Pipeline(steps=[\n    ('preprocessor', preprocessor),\n    ('classifier', RandomForestClassifier(n_estimators=100, random_state=42))\n])\n\n# Train and evaluate\nfull_pipeline.fit(X_train, y_train)\ny_pred = full_pipeline.predict(X_test)\n\nprint(f\"Accuracy: {accuracy_score(y_test, y_pred):.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Problem: test set has categories not in training set\ntrain_data = pd.DataFrame({\n    'color': ['red', 'blue', 'red', 'green'],\n    'value': [1, 2, 3, 4]\n})\ntest_data = pd.DataFrame({\n    'color': ['red', 'yellow', 'blue'],  # 'yellow' not in train\n    'value': [5, 6, 7]\n})\n\n# Solution: OneHotEncoder with handle_unknown parameter\nfrom sklearn.preprocessing import OneHotEncoder\n\nencoder = OneHotEncoder(handle_unknown='ignore', sparse_output=False)\ntrain_encoded = encoder.fit_transform(train_data[['color']])\ntest_encoded = encoder.transform(test_data[['color']])\n\nprint(f\"Train encoded shape: {train_encoded.shape}\")\nprint(f\"Test encoded shape: {test_encoded.shape}\")  # Same features as train\n\n# Problem: feature order changes between train and test\n# Solution: always use consistent ordering\n\ndef prepare_features(df, column_order=None):\n    \"\"\"Prepare features with consistent ordering\"\"\"\n    if column_order is None:\n        column_order = df.columns.tolist()\n    return df[column_order]\n\ntrain_features = prepare_features(train_data)\ntest_features = prepare_features(test_data, column_order=train_data.columns.tolist())\n\n# Problem: different number of rows requires broadcasting\n# Solution: ensure row-wise operations, never add rows accidentally\n\nX_augmented = X.copy()\nX_augmented['new_feature'] = some_computed_value  # Same length as X"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.linear_model import LogisticRegression\nfrom sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier\nfrom sklearn.svm import SVC\nfrom sklearn.metrics import confusion_matrix, classification_report, roc_auc_score, roc_curve\n\n# Prepare data\nX_train_scaled = StandardScaler().fit_transform(X_train)\nX_test_scaled = StandardScaler().fit_transform(X_test)\n\n# Train multiple models\nmodels = {\n    'Logistic Regression': LogisticRegression(max_iter=1000),\n    'Random Forest': RandomForestClassifier(n_estimators=100, random_state=42),\n    'Gradient Boosting': GradientBoostingClassifier(random_state=42),\n    'SVM': SVC(probability=True)\n}\n\nresults = {}\nfor name, model in models.items():\n    # Train\n    model.fit(X_train_scaled, y_train)\n    \n    # Predict\n    y_pred = model.predict(X_test_scaled)\n    y_pred_proba = model.predict_proba(X_test_scaled)[:, 1]\n    \n    # Evaluate\n    results[name] = {\n        'accuracy': accuracy_score(y_test, y_pred),\n        'precision': precision_score(y_test, y_pred),\n        'recall': recall_score(y_test, y_pred),\n        'f1': f1_score(y_test, y_pred),\n        'roc_auc': roc_auc_score(y_test, y_pred_proba)\n    }\n\n# Compare models\nresults_df = pd.DataFrame(results).T\nprint(results_df)\n\n# Detailed analysis of best model\nbest_model_name = results_df['f1'].idxmax()\nbest_model = models[best_model_name]\n\ny_pred_best = best_model.predict(X_test_scaled)\nprint(f\"\\nConfusion Matrix ({best_model_name}):\")\nprint(confusion_matrix(y_test, y_pred_best))\nprint(f\"\\nClassification Report:\")\nprint(classification_report(y_test, y_pred_best))"
        ]
      ]
    },
    {
