        [
          "python",
          "# Create a sample plot\nfig, ax = plt.subplots(figsize=(10, 6))\nx = np.linspace(0, 10, 100)\nax.plot(x, np.sin(x), linewidth=2, label='sin(x)', color='blue')\nax.plot(x, np.cos(x), linewidth=2, label='cos(x)', color='red')\nax.set_title('Trigonometric Functions', fontsize=14)\nax.set_xlabel('X')\nax.set_ylabel('Y')\nax.legend()\nax.grid(True, alpha=0.3)\n\n# Save in different formats\nfig.savefig('plot.png', dpi=300, bbox_inches='tight')  # PNG (raster)\nfig.savefig('plot.pdf', dpi=300, bbox_inches='tight')  # PDF (vector)\nfig.savefig('plot.svg', dpi=300, bbox_inches='tight')  # SVG (vector)\nfig.savefig('plot.jpg', dpi=300, bbox_inches='tight', quality=95)  # JPEG\n\n# High-quality for print\nfig.savefig('plot_hires.png', dpi=600, bbox_inches='tight')\n\n# Transparent background\nfig.savefig('plot_transparent.png', dpi=300, bbox_inches='tight', transparent=True)\n\n# Custom figure properties\nfig.set_facecolor('white')\nfig.set_edgecolor('black')\nfig.patch.set_facecolor('white')\n\nprint(\"Figures saved successfully\")"
        ]
      ]
    },
    {
