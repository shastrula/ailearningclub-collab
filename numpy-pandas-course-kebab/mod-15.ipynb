          "python",
          "# Contour plot examples\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n# Sample data: function over 2D domain\nx = np.linspace(-5, 5, 100)\ny = np.linspace(-5, 5, 100)\nX, Y = np.meshgrid(x, y)\nZ = np.sin(np.sqrt(X**2 + Y**2))\n\n# Regular contour\ncontour = axes[0].contour(X, Y, Z, levels=10, colors='black', alpha=0.3, linewidths=0.5)\naxes[0].clabel(contour, inline=True, fontsize=8)\ncontourf = axes[0].contourf(X, Y, Z, levels=15, cmap='viridis', alpha=0.8)\naxes[0].set_title('Filled Contour Plot')\naxes[0].set_xlabel('X')\naxes[0].set_ylabel('Y')\nfig.colorbar(contourf, ax=axes[0], label='Value')\n\n# Contour with specific levels\nlevels = [-1, -0.5, 0, 0.5, 1]\ncontourf2 = axes[1].contourf(X, Y, Z, levels=levels, cmap='coolwarm', extend='both')\ncontour2 = axes[1].contour(X, Y, Z, levels=levels, colors='black', linewidths=1)\naxes[1].clabel(contour2, inline=True, fontsize=10, fmt='%.1f')\naxes[1].set_title('Custom Levels Contour')\naxes[1].set_xlabel('X')\naxes[1].set_ylabel('Y')\nfig.colorbar(contourf2, ax=axes[1], label='Value')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
