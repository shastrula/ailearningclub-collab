        [
          "python",
          "# Available styles\nprint(\"Available styles:\", plt.style.available)\n\n# Apply different styles\nstyles_to_demo = ['default', 'seaborn-v0_8-darkgrid', 'ggplot', 'bmh', 'dark_background']\n\nfor style in styles_to_demo:\n    plt.style.use(style)\n    \n    fig, ax = plt.subplots(figsize=(8, 5))\n    x = np.linspace(0, 10, 100)\n    ax.plot(x, np.sin(x), linewidth=2, label='sin(x)')\n    ax.plot(x, np.cos(x), linewidth=2, label='cos(x)')\n    ax.set_title(f'Style: {style}', fontsize=12)\n    ax.legend()\n    ax.set_xlabel('X')\n    ax.set_ylabel('Y')\n    \n    plt.tight_layout()\n    plt.show()\n\n# Reset to default\nplt.style.use('default')\n\n# Custom style context\nwith plt.style.context('seaborn-v0_8-darkgrid'):\n    fig, ax = plt.subplots()\n    ax.plot([1, 2, 3, 4], [1, 4, 2, 3], marker='o', linewidth=2)\n    ax.set_title('Temporary Style')\n    plt.show()\n\n# Style parameters\nplt.rcParams['figure.figsize'] = (10, 6)\nplt.rcParams['font.size'] = 11\nplt.rcParams['axes.labelsize'] = 12\nplt.rcParams['axes.titlesize'] = 14\nplt.rcParams['grid.alpha'] = 0.3"
        ]
      ]
