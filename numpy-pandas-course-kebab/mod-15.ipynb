        [
          "python",
          "import matplotlib.pyplot as plt\nimport numpy as np\n\n# Create figure and axes explicitly\nfig, ax = plt.subplots()\n\n# Plot on the axes\nax.plot([1, 2, 3, 4], [1, 4, 2, 3])\nax.set_title('Simple Plot')\nax.set_xlabel('X Label')\nax.set_ylabel('Y Label')\n\nplt.show()\n\n# Multiple subplots share a figure\nfig, axes = plt.subplots(2, 2, figsize=(10, 8))\n\n# Each axes in the array\naxes[0, 0].plot([1, 2, 3], [1, 2, 3])\naxes[0, 0].set_title('Plot 1')\n\naxes[0, 1].scatter([1, 2, 3], [3, 2, 1])\naxes[0, 1].set_title('Plot 2')\n\naxes[1, 0].bar([1, 2, 3], [2, 1, 3])\naxes[1, 0].set_title('Plot 3')\n\naxes[1, 1].hist([1, 1, 2, 2, 2, 3, 3, 3, 3], bins=3)\naxes[1, 1].set_title('Plot 4')\n\nfig.suptitle('Four Subplots', fontsize=14, fontweight='bold')\nfig.tight_layout()  # Prevent overlap\n\nplt.show()\n\n# Access figure properties\nprint(f\"Figure size: {fig.get_size_inches()}\")\nprint(f\"Figure DPI: {fig.dpi}\")\nprint(f\"Number of axes: {len(axes.flatten())}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Sample data\nnp.random.seed(42)\nx = np.linspace(0, 10, 50)\ny1 = 2*x + np.random.normal(0, 2, 50)\ny2 = np.sin(x) * 10 + 50\ncategories = ['A', 'B', 'C', 'D']\nvalues = [23, 17, 35, 29]\n\nfig, axes = plt.subplots(2, 3, figsize=(14, 8))\n\n# Line plot\naxes[0, 0].plot(x, y1, marker='o', linestyle='-', linewidth=2, markersize=4)\naxes[0, 0].set_title('Line Plot')\naxes[0, 0].grid(True, alpha=0.3)\n\n# Scatter plot\naxes[0, 1].scatter(x, y1, s=50, alpha=0.6, color='red')\naxes[0, 1].set_title('Scatter Plot')\n\n# Bar chart\naxes[0, 2].bar(categories, values, color=['blue', 'green', 'orange', 'red'], alpha=0.7)\naxes[0, 2].set_title('Bar Chart')\naxes[0, 2].set_ylabel('Values')\n\n# Histogram\naxes[1, 0].hist(y1, bins=15, color='purple', alpha=0.7, edgecolor='black')\naxes[1, 0].set_title('Histogram')\naxes[1, 0].set_xlabel('Value')\n\n# Filled area\naxes[1, 1].fill_between(x, y2-5, y2+5, alpha=0.3, color='green')\naxes[1, 1].plot(x, y2, color='green', linewidth=2)\naxes[1, 1].set_title('Area Plot')\n\n# Multiple lines\naxes[1, 2].plot(x, y1, label='Dataset 1', linewidth=2)\naxes[1, 2].plot(x, y2, label='Dataset 2', linewidth=2)\naxes[1, 2].legend()\naxes[1, 2].set_title('Multiple Lines')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "fig, axes = plt.subplots(1, 3, figsize=(14, 4))\n\n# Color options\nx = np.linspace(0, 10, 100)\ncolors = ['red', '#FF5733', 'C0', (0.2, 0.4, 0.6)]  # Named, hex, tab, RGB tuple\nfor i, color in enumerate(colors):\n    axes[0].plot(x, np.sin(x + i), color=color, linewidth=2, label=f'Series {i+1}')\naxes[0].set_title('Color Variations')\naxes[0].legend()\naxes[0].grid(True, alpha=0.3)\n\n# Marker styles\nmarkers = ['o', 's', '^', 'v', '*', 'D', 'p', 'H']\nx_markers = np.linspace(0, 7, len(markers))\nfor i, marker in enumerate(markers):\n    axes[1].plot(i, i, marker=marker, markersize=10, label=marker)\naxes[1].set_title('Marker Styles')\naxes[1].set_xlim(-0.5, len(markers) - 0.5)\naxes[1].set_ylim(-0.5, len(markers) - 0.5)\naxes[1].legend(ncol=2, fontsize=9)\n\n# Line styles\nx = np.linspace(0, 10, 100)\nstyles = ['-', '--', '-.', ':', (0, (3, 1, 1, 1))]  # Named, custom dashes\nlabels = ['-', '--', '-.', ':', 'Custom']\nfor style, label in zip(styles, labels):\n    axes[2].plot(x, np.sin(x + np.random.random()), linestyle=style, \n                 linewidth=2, label=label)\naxes[2].set_title('Line Styles')\naxes[2].legend()\naxes[2].grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.show()\n\n# Advanced color mapping\nfig, ax = plt.subplots()\ny = np.random.randn(100)\nx = np.arange(100)\nscatter = ax.scatter(x, y, c=y, cmap='viridis', s=50, alpha=0.6)\nax.set_title('Color Mapping by Value')\ncbar = fig.colorbar(scatter, ax=ax)\ncbar.set_label('Y Value')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
