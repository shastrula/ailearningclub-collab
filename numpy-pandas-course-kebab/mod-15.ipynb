      "source": [
        [
          "python",
          "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n\n# Comprehensive labeling\nx = np.linspace(0, 10, 100)\ny = np.sin(x)\n\naxes[0].plot(x, y, linewidth=2, color='blue')\naxes[0].set_title('Sine Wave Analysis', fontsize=14, fontweight='bold')\naxes[0].set_xlabel('Time (seconds)', fontsize=12)\naxes[0].set_ylabel('Amplitude', fontsize=12)\naxes[0].grid(True, alpha=0.3, linestyle='--')\n\n# Add annotations\nmax_idx = np.argmax(y)\naxes[0].annotate('Maximum', xy=(x[max_idx], y[max_idx]),\n                xytext=(x[max_idx]+1, y[max_idx]+0.3),\n                arrowprops=dict(arrowstyle='->', color='red'),\n                fontsize=10, color='red')\n\nmin_idx = np.argmin(y)\naxes[0].annotate('Minimum', xy=(x[min_idx], y[min_idx]),\n                xytext=(x[min_idx]+1, y[min_idx]-0.3),\n                arrowprops=dict(arrowstyle='->', color='red'),\n                fontsize=10, color='red')\n\n# Legend example\naxes[1].plot(x, np.sin(x), linewidth=2, label='sin(x)', marker='o', \n             markersize=3, markevery=10)\naxes[1].plot(x, np.cos(x), linewidth=2, label='cos(x)', marker='s', \n             markersize=3, markevery=10)\naxes[1].legend(loc='upper right', fontsize=11, framealpha=0.9)\naxes[1].set_title('Trigonometric Functions', fontsize=14, fontweight='bold')\naxes[1].set_xlabel('Angle (radians)', fontsize=12)\naxes[1].set_ylabel('Value', fontsize=12)\naxes[1].grid(True, alpha=0.3)\n\n# Add text box\ntextstr = 'Period: 2\u03c0\\nAmplitude: 1'\nprops = dict(boxstyle='round', facecolor='wheat', alpha=0.8)\naxes[1].text(0.05, 0.95, textstr, transform=axes[1].transAxes,\n            fontsize=10, verticalalignment='top', bbox=props)\n\nplt.tight_layout()\nplt.show()\n\n# Shaded regions\nfig, ax = plt.subplots()\nx = np.linspace(0, 10, 1000)\ny = np.exp(-x/5) * np.cos(2*x)\n\nax.plot(x, y, linewidth=2, color='blue')\nax.axvspan(2, 5, alpha=0.2, color='yellow', label='Region of Interest')\nax.axhline(y=0, color='black', linestyle='-', linewidth=0.5, alpha=0.5)\nax.set_title('Plot with Shaded Region')\nax.legend()\nax.grid(True, alpha=0.3)\n\nplt.show()"
        ]
      ]
