        [
          "python",
          "# Logarithmic scale demonstration\nfig, axes = plt.subplots(1, 2, figsize=(12, 5))\n\nx = np.linspace(0.1, 100, 100)\ny = np.exp(x/20)\n\n# Linear scale (exponential curve)\naxes[0].plot(x, y, linewidth=2)\naxes[0].set_title('Linear Scale (Exponential Growth Hides Pattern)')\naxes[0].set_xlabel('X')\naxes[0].set_ylabel('Y')\naxes[0].grid(True, alpha=0.3)\n\n# Logarithmic scale (reveals linearity)\naxes[1].semilogy(x, y, linewidth=2)\naxes[1].set_title('Log Scale (Exponential Becomes Linear)')\naxes[1].set_xlabel('X')\naxes[1].set_ylabel('Y (log)')\naxes[1].grid(True, alpha=0.3, which='both')\n\nplt.tight_layout()\nplt.show()\n\n# Polar plot\nfig, ax = plt.subplots(subplot_kw=dict(projection='polar'), figsize=(8, 8))\n\ntheta = np.linspace(0, 2*np.pi, 100)\nr = 1 + 0.5*np.sin(5*theta)\n\nax.plot(theta, r, linewidth=2, label='Pattern')\nax.fill(theta, r, alpha=0.3)\nax.set_title('Polar Plot: 5-Petaled Pattern', pad=20)\nax.legend(loc='upper right')\n\nplt.show()\n\n# Stackplot\nx = np.linspace(0, 10, 100)\ny1 = np.sin(x) + 2\ny2 = np.cos(x) + 2\ny3 = np.sin(2*x) + 2\n\nfig, ax = plt.subplots(figsize=(10, 6))\nax.stackplot(x, y1, y2, y3, labels=['Component 1', 'Component 2', 'Component 3'],\n            colors=['#1f77b4', '#ff7f0e', '#2ca02c'], alpha=0.8)\nax.set_title('Stacked Area Plot: Composition Over Time')\nax.set_xlabel('Time')\nax.set_ylabel('Value')\nax.legend(loc='upper left')\nax.grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
