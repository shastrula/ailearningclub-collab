        [
          "python",
          "import pandas as pd\nimport numpy as np\nimport time\n\n# 1. Data type optimization\n# Problem: default dtypes waste memory\ndf_inefficient = pd.DataFrame({\n    'id': np.random.randint(0, 1000000, 1000000),\n    'value': np.random.random(1000000),\n    'category': np.random.choice(['A', 'B', 'C'], 1000000),\n    'flag': np.random.choice([True, False], 1000000)\n})\n\nprint(f\"Default dtypes memory: {df_inefficient.memory_usage(deep=True).sum() / 1024**2:.2f} MB\")\n\n# Solution: use appropriate dtypes\ndf_efficient = pd.DataFrame({\n    'id': pd.array(np.random.randint(0, 1000000, 1000000), dtype='int32'),  # int32 vs int64\n    'value': np.random.random(1000000).astype('float32'),  # float32 vs float64\n    'category': pd.Categorical(np.random.choice(['A', 'B', 'C'], 1000000)),  # category vs object\n    'flag': np.random.choice([True, False], 1000000).astype('bool')\n})\n\nprint(f\"Optimized dtypes memory: {df_efficient.memory_usage(deep=True).sum() / 1024**2:.2f} MB\")\nprint(f\"Memory savings: {(1 - df_efficient.memory_usage(deep=True).sum() / df_inefficient.memory_usage(deep=True).sum()) * 100:.1f}%\")\n\n# 2. Chunked reading for massive files\ndef read_large_csv_chunked(filepath, chunksize=10000):\n    \"\"\"Process large CSV in chunks\"\"\"\n    chunks = []\n    for chunk in pd.read_csv(filepath, chunksize=chunksize):\n        # Process each chunk\n        chunk = chunk[chunk['value'] > 0]  # Example filter\n        chunks.append(chunk)\n    return pd.concat(chunks, ignore_index=True)\n\n# 3. Vectorized operations (much faster than loops)\n# Inefficient: Python loop\ndef slow_operation(df):\n    results = []\n    for idx, row in df.iterrows():\n        results.append(row['a'] * row['b'] + row['c'])\n    return results\n\n# Efficient: vectorized\ndef fast_operation(df):\n    return df['a'] * df['b'] + df['c']\n\ndf_test = pd.DataFrame({\n    'a': np.random.random(100000),\n    'b': np.random.random(100000),\n    'c': np.random.random(100000)\n})\n\nstart = time.time()\nslow_result = slow_operation(df_test)\nslow_time = time.time() - start\n\nstart = time.time()\nfast_result = fast_operation(df_test)\nfast_time = time.time() - start\n\nprint(f\"\\nVectorization speedup: {slow_time / fast_time:.1f}x faster\")\n\n# 4. Query optimization\n# Instead of multiple filters in memory\nfiltered = df[(df['age'] > 30) & (df['salary'] > 50000) & (df['department'] == 'Sales')]\n\n# Use query() for better readability and sometimes better performance\nfiltered_query = df.query('age > 30 and salary > 50000 and department == \"Sales\"')"
        ]
      ]
