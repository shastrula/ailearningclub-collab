          "python",
          "# 1. PyArrow backend: better memory efficiency\ndf = pd.read_csv('data.csv', dtype_backend='pyarrow')\nprint(f\"Using PyArrow: {df.dtypes}\")\n\n# 2. String dtype (more reliable than object)\ndf['name'] = df['name'].astype('string')  # vs 'object'\ndf['description'] = df['description'].astype('string')\n\n# 3. Nullable integer types\ndf['count'] = df['count'].astype('Int64')  # vs 'int64' (allows NaN)\n\n# 4. Nullable boolean\ndf['is_active'] = df['is_active'].astype('boolean')  # vs bool\n\n# 5. Copy-on-write (CoW) mode: prevents accidental modifications\npd.options.mode.copy_on_write = True\n\ndf = pd.read_csv('data.csv')\nsubset = df[df['age'] > 30]\nsubset['salary'] = subset['salary'] * 1.1  # No SettingWithCopyWarning\n\n# 6. New aggregation methods\nresult = df.groupby('department').agg(\n    salary_mean=('salary', 'mean'),\n    salary_std=('salary', 'std'),\n    count=('salary', 'count'),\n    highest_earner=('salary', 'max')\n)\n\n# 7. Improved categorical handling\ndf['category'] = pd.Categorical(df['category'], ordered=True)\ndf['category'] = df['category'].cat.reorder_categories(['low', 'medium', 'high'])"
