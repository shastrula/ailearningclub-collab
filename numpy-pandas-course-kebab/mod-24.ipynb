        [
          "python",
          "# Inefficient: multiple intermediate variables\ndata = pd.read_csv('data.csv')\ndata = data.dropna()\ndata = data[data['age'] > 18]\ndata = data.groupby('department')['salary'].mean()\ndata = data.sort_values(ascending=False)\n\n# Elegant: method chaining\nresult = (pd.read_csv('data.csv')\n    .dropna()\n    .query('age > 18')\n    .groupby('department')['salary']\n    .mean()\n    .sort_values(ascending=False)\n)\n\n# Chaining with custom functions\ndef remove_outliers(df, col, threshold=1.5):\n    \"\"\"Remove outliers using IQR method\"\"\"\n    Q1 = df[col].quantile(0.25)\n    Q3 = df[col].quantile(0.75)\n    IQR = Q3 - Q1\n    return df[(df[col] >= Q1 - threshold*IQR) & (df[col] <= Q3 + threshold*IQR)]\n\ndef scale_column(df, col):\n    \"\"\"Min-max scaling\"\"\"\n    return df.assign(**{col: (df[col] - df[col].min()) / (df[col].max() - df[col].min())})\n\n# Chain with custom functions\nclean_data = (pd.read_csv('data.csv')\n    .pipe(remove_outliers, 'salary')\n    .pipe(scale_column, 'salary')\n    .groupby('department')\n    .agg({\n        'salary': ['mean', 'std', 'count'],\n        'age': 'mean'\n    })\n    .sort_values(('salary', 'mean'), ascending=False)\n)\n\nprint(clean_data)"
        ]
      ]
    },
