          "python",
          "import logging\nfrom pathlib import Path\n\n# Setup logging\nlogging.basicConfig(\n    level=logging.INFO,\n    format='%(asctime)s - %(levelname)s - %(message)s'\n)\nlogger = logging.getLogger(__name__)\n\ndef professional_pipeline(config_path):\n    \"\"\"Production-ready data analysis pipeline\"\"\"\n    \n    try:\n        # 1. Load configuration\n        import json\n        with open(config_path) as f:\n            config = json.load(f)\n        \n        logger.info(\"Configuration loaded\")\n        \n        # 2. Read data with type optimization\n        df = pd.read_csv(\n            config['data']['input_path'],\n            dtype={\n                'id': 'int32',\n                'amount': 'float32',\n                'category': 'category'\n            }\n        )\n        logger.info(f\"Data loaded: {df.shape[0]} rows\")\n        \n        # 3. Validate input\n        assert df['amount'].isnull().sum() == 0, \"Missing amounts\"\n        assert (df['amount'] > 0).all(), \"Non-positive amounts\"\n        logger.info(\"Data validation passed\")\n        \n        # 4. Process with method chaining\n        result = (df\n            .dropna()\n            .query('amount > 0')\n            .groupby('category')['amount']\n            .agg(['sum', 'mean', 'count'])\n            .sort_values('sum', ascending=False)\n        )\n        \n        # 5. Save results\n        output_path = config['data']['output_path']\n        Path(output_path).mkdir(exist_ok=True)\n        result.to_csv(f\"{output_path}/summary.csv\")\n        logger.info(f\"Results saved to {output_path}\")\n        \n        return result\n        \n    except Exception as e:\n        logger.error(f\"Pipeline failed: {e}\", exc_info=True)\n        raise\n\n# Usage\n# if __name__ == '__main__':\n#     result = professional_pipeline('config.json')"
        ]
