          "python",
          "# 1. Variable naming\n# Good: descriptive names\ncustomer_transactions = pd.read_csv('customers.csv')\ntotal_revenue = transactions.groupby('customer_id')['amount'].sum()\n\n# Avoid: cryptic abbreviations\nct = pd.read_csv('customers.csv')\ntr = transactions.groupby('cid')['amt'].sum()\n\n# 2. Column naming\n# Good: lowercase with underscores\ndf.columns = df.columns.str.lower().str.replace(' ', '_')\n\n# 3. Function structure\ndef process_customer_data(filepath, min_age=18, output_path=None):\n    \"\"\"\n    Process customer data with cleaning and enrichment.\n    \n    Parameters\n    ----------\n    filepath : str\n        Path to input CSV file\n    min_age : int, default 18\n        Minimum age filter\n    output_path : str, optional\n        Path to save processed data\n    \n    Returns\n    -------\n    pd.DataFrame\n        Processed customer data\n    \"\"\"\n    df = pd.read_csv(filepath)\n    df = df[df['age'] >= min_age].copy()\n    \n    if output_path:\n        df.to_csv(output_path, index=False)\n    \n    return df\n\n# 4. Line length and readability\n# Long lines are hard to read\nresult = df[((df['salary'] > 50000) & (df['department'] == 'Sales')) | ((df['salary'] > 75000) & (df['department'] == 'Marketing'))].groupby('year')['amount'].sum()\n\n# Better: break into logical chunks\nhigh_earners = (\n    (df['salary'] > 50000) & (df['department'] == 'Sales') |\n    (df['salary'] > 75000) & (df['department'] == 'Marketing')\n)\nresult = df[high_earners].groupby('year')['amount'].sum()\n\n# 5. Consistent indexing\n# Good: explicit and clear\nfor idx in range(len(df)):\n    value = df.iloc[idx]['column']\n\n# Also good: use itertuples (faster)\nfor row in df.itertuples():\n    value = row.column\n\n# Avoid: iterrows (slowest)\nfor idx, row in df.iterrows():\n    value = row['column']"
