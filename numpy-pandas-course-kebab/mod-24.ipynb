          "python",
          "# PITFALL 1: SettingWithCopyWarning\n# Modifying a view instead of a copy\ndf = pd.read_csv('data.csv')\nsubset = df[df['age'] > 30]  # This is a view\nsubset['salary'] = subset['salary'] * 1.1  # Warning!\n\n# Solution: explicit copy\nsubset = df[df['age'] > 30].copy()\nsubset['salary'] = subset['salary'] * 1.1  # No warning\n\n# PITFALL 2: Modifying during iteration\nfor idx, row in df.iterrows():\n    df.loc[idx, 'new_col'] = row['old_col'] * 2  # Very slow\n\n# Solution: vectorize\ndf['new_col'] = df['old_col'] * 2  # Fast\n\n# PITFALL 3: Using inplace=True excessively\ndf.dropna(inplace=True)\ndf.sort_values('col', inplace=True)\n\n# Better: method chaining (more functional)\ndf = df.dropna().sort_values('col')\n\n# PITFALL 4: Losing column information on operations\nresult = df.groupby('department')['salary'].sum()  # Returns Series\nresult.columns  # AttributeError: Series has no columns\n\n# Solution: Preserve DataFrame structure when needed\nresult = df.groupby('department', as_index=False)['salary'].sum()  # Returns DataFrame\n\n# PITFALL 5: Index issues after operations\ndf_sorted = df.sort_values('value')  # Index no longer aligned with position\ndf_sorted.iloc[0]  # Gets row with original index, not first position\n\n# Solution: reset index if position matters\ndf_sorted = df.sort_values('value').reset_index(drop=True)\n\n# PITFALL 6: Implicit type conversions\ndf['id'] = df['id'].astype(str)\ndf['id'] = df['id'].str.upper()  # Now working with strings\ndf['id'].sum()  # Concatenates strings, not what you want\n\n# Solution: be explicit about types\ndf['id'] = df['id'].astype('int64')  # Keep numeric if needed"
