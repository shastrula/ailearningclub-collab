      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Numpy Pandas Course Kebab - mod-18\n\n",
        "**Course:** numpy-pandas-course-kebab\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import seaborn as sns\nimport matplotlib.pyplot as plt\nimport pandas as pd\nimport numpy as np\n\ntips = sns.load_dataset('tips')\n\n# Basic violin plot\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\nsns.violinplot(data=tips, x='day', y='total_bill', ax=axes[0])\naxes[0].set_title('Violin Plot: Bill by Day')\n\n# Violin plot with hue\nsns.violinplot(data=tips, x='day', y='total_bill', hue='sex', \n               split=False, ax=axes[1])\naxes[1].set_title('Violin Plot: Bill by Day and Sex')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Advanced violin plot with inner customization\nfig, ax = plt.subplots(figsize=(10, 6))\n\nsns.violinplot(\n    data=tips,\n    x='day',\n    y='total_bill',\n    hue='sex',\n    inner='quartile',  # Options: box, point, stick, None\n    palette='husl',\n    ax=ax\n)\n\nax.set_title('Bill Distribution by Day (Quartile Display)')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Swarm plot: points avoid overlap\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\nsns.swarmplot(data=tips, x='day', y='total_bill', ax=axes[0])\naxes[0].set_title('Swarm Plot (No Overlap)')\n\n# Strip plot: transparency shows density\nsns.stripplot(data=tips, x='day', y='total_bill', \n              alpha=0.6, size=8, ax=axes[1])\naxes[1].set_title('Strip Plot (Transparent)')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Combine violin and swarm for complete picture\nfig, ax = plt.subplots(figsize=(10, 6))\n\nsns.violinplot(data=tips, x='day', y='total_bill', \n               inner=None, palette='muted', ax=ax)\nsns.swarmplot(data=tips, x='day', y='total_bill', \n              color='black', alpha=0.5, size=5, ax=ax)\n\nax.set_title('Distribution + Individual Points')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Linear regression plot\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n# Basic regplot (axes-level)\nsns.regplot(data=tips, x='total_bill', y='tip', ax=axes[0])\naxes[0].set_title('Linear Regression')\n\n# lmplot with hue grouping (figure-level)\ng = sns.lmplot(data=tips, x='total_bill', y='tip', hue='sex',\n               height=5, aspect=1.2)\ng.set_axis_labels('Total Bill ($)', 'Tip ($)')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Polynomial regression and lowess smoothing\nfig, axes = plt.subplots(2, 2, figsize=(12, 10))\n\n# Linear (order=1, default)\nsns.regplot(data=tips, x='total_bill', y='tip', order=1, ax=axes[0, 0])\naxes[0, 0].set_title('Linear (order=1)')\n\n# Quadratic (order=2)\nsns.regplot(data=tips, x='total_bill', y='tip', order=2, ax=axes[0, 1])\naxes[0, 1].set_title('Quadratic (order=2)')\n\n# LOWESS (robust, non-parametric)\nsns.regplot(data=tips, x='total_bill', y='tip', \n            lowess=True, scatter_kws={'alpha': 0.5}, ax=axes[1, 0])\naxes[1, 0].set_title('LOWESS Smoothing')\n\n# Without confidence interval\nsns.regplot(data=tips, x='total_bill', y='tip', ci=None, ax=axes[1, 1])\naxes[1, 1].set_title('No Confidence Interval')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Correlation heatmap\nfig, ax = plt.subplots(figsize=(8, 6))\n\niris = sns.load_dataset('iris')\ncorr_matrix = iris.corr(numeric_only=True)\n\nsns.heatmap(\n    corr_matrix,\n    annot=True,  # Show values\n    fmt='.2f',   # Format: 2 decimal places\n    cmap='coolwarm',\n    center=0,    # Center colormap at 0\n    square=True,\n    linewidths=0.5,\n    cbar_kws={'label': 'Correlation'},\n    ax=ax\n)\n\nax.set_title('Iris Dataset Correlations')\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Heatmap with pivot table data\nfig, ax = plt.subplots(figsize=(10, 6))\n\n# Create pivot table: rows=day, cols=sex, values=mean(total_bill)\npivot_data = tips.pivot_table(\n    values='total_bill',\n    index='day',\n    columns='sex',\n    aggfunc='mean'\n)\n\nsns.heatmap(\n    pivot_data,\n    annot=True,\n    fmt='.1f',\n    cmap='YlGnBu',\n    cbar_kws={'label': 'Average Bill'},\n    ax=ax\n)\n\nax.set_title('Average Bill by Day and Sex')\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Joint plot with scatter + histograms\ng = sns.jointplot(\n    data=tips,\n    x='total_bill',\n    y='tip',\n    height=6,\n    kind='scatter',  # Options: scatter, kde, hist, hex, reg\n    marginal_kws={'bins': 20}\n)\n\ng.set_axis_labels('Total Bill ($)', 'Tip ($)')\ng.fig.suptitle('Joint Distribution', y=1.00)\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Hexbin joint plot for large datasets\nnp.random.seed(42)\nlarge_data = pd.DataFrame({\n    'x': np.random.normal(0, 1, 5000),\n    'y': np.random.normal(0, 1, 5000)\n})\n\ng = sns.jointplot(\n    data=large_data,\n    x='x',\n    y='y',\n    kind='hex',\n    height=6,\n    cmap='YlOrRd'\n)\n\ng.plot_marginals(sns.histplot, kde=True, bins=30)\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Pair plot with default scatter\ng = sns.pairplot(iris, height=2.5, aspect=1)\ng.fig.suptitle('Iris Dataset Pairwise Relationships', y=1.00)\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Pair plot with hue and custom plot types\ng = sns.pairplot(\n    iris,\n    hue='species',\n    height=2.5,\n    aspect=1,\n    palette='husl',\n    plot_kws={'alpha': 0.6, 's': 80},\n    diag_kind='kde'  # Options: hist, kde\n)\n\ng.fig.suptitle('Iris by Species', y=1.00)\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Focused pair plot with selected variables\nselected_vars = ['sepal_length', 'petal_length', 'petal_width', 'species']\ng = sns.pairplot(\n    iris[selected_vars],\n    hue='species',\n    height=2,\n    palette='Set2'\n)\n\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Complete statistical visualization\nfig = plt.figure(figsize=(16, 10))\ngs = fig.add_gridspec(3, 3, hspace=0.4, wspace=0.4)\n\n# Distribution\nax1 = fig.add_subplot(gs[0, 0])\nsns.histplot(data=tips, x='total_bill', kde=True, ax=ax1)\n\n# Violin plot\nax2 = fig.add_subplot(gs[0, 1])\nsns.violinplot(data=tips, x='day', y='total_bill', ax=ax2)\n\n# Regression\nax3 = fig.add_subplot(gs[0, 2])\nsns.regplot(data=tips, x='total_bill', y='tip', ax=ax3)\n\n# Correlation heatmap\nax4 = fig.add_subplot(gs[1, :2])\ncorr = tips[['total_bill', 'tip', 'size']].corr()\nsns.heatmap(corr, annot=True, fmt='.2f', cmap='coolwarm', ax=ax4, square=True)\n\n# Swarm plot\nax5 = fig.add_subplot(gs[1, 2])\nsns.swarmplot(data=tips, x='sex', y='tip', ax=ax5)\n\n# Box plot\nax6 = fig.add_subplot(gs[2, 0])\nsns.boxplot(data=tips, x='day', y='total_bill', ax=ax6)\n\n# Count plot\nax7 = fig.add_subplot(gs[2, 1])\nsns.countplot(data=tips, x='day', hue='sex', ax=ax7)\n\n# Strip plot\nax8 = fig.add_subplot(gs[2, 2])\nsns.stripplot(data=tips, x='time', y='total_bill', hue='sex', alpha=0.6, ax=ax8)\n\nplt.show()"
        ]
      ]
    }
  ],
