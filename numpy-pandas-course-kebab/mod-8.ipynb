      "source": [
        [
          "python",
          "import pandas as pd\nimport numpy as np\n\n# Create DataFrame with missing values\ndf = pd.DataFrame({\n    'name': ['Alice', 'Bob', np.nan, 'David', 'Eve'],\n    'age': [25, 30, 35, np.nan, 32],\n    'salary': [50000, np.nan, 75000, 55000, np.nan]\n})\n\nprint(df)\n#     name   age   salary\n# 0  Alice  25.0  50000.0\n# 1    Bob  30.0      NaN\n# 2    NaN  35.0  75000.0\n# 3  David   NaN  55000.0\n# 4    Eve  32.0      NaN\n\n# Detecting missing values\nprint(df.isnull())       # Boolean mask of NaN locations\nprint(df.isna())         # Alias for isnull()\nprint(df.notnull())      # Opposite of isnull()\n\n# Count missing values\nprint(df.isnull().sum())\n# name       1\n# age        1\n# salary     2\n\nprint(df.isnull().sum().sum())  # Total missing values: 4\n\n# Percentage missing\nprint(df.isnull().sum() / len(df) * 100)\n# name      20.0\n# age       20.0\n# salary    40.0\n\n# Identifying completely empty rows/columns\nprint(df.isnull().all())  # Columns that are all NaN\nprint(df.isnull().all(axis=1))  # Rows that are all NaN\n\n# Finding rows with any missing values\nprint(df[df.isnull().any(axis=1)])"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "df = pd.DataFrame({\n    'A': [1, 2, np.nan, 4],\n    'B': [5, np.nan, 7, 8],\n    'C': [9, 10, 11, 12]\n})\n\n# Remove rows with any missing values\ndf_dropped = df.dropna()\nprint(df_dropped)\n#      A    B   C\n# 0  1.0  5.0   9\n# 3  4.0  8.0  12\n\n# Remove rows where all values are missing\ndf_dropped = df.dropna(how='all')\nprint(df_dropped)  # Same as original since no row is all NaN\n\n# Remove columns with any missing values\ndf_dropped = df.dropna(axis=1)\nprint(df_dropped)\n#     C\n# 0   9\n# 1  10\n# 2  11\n# 3  12\n\n# Remove rows with missing values in specific columns\ndf_dropped = df.dropna(subset=['A'])\nprint(df_dropped)\n#      A    B   C\n# 0  1.0  5.0   9\n# 1  2.0  NaN  10\n# 3  4.0  8.0  12\n\n# Drop rows with at least N non-null values\ndf_dropped = df.dropna(thresh=2)  # Keep rows with at least 2 non-null values\nprint(df_dropped)\n\n# In-place modification\ndf.dropna(inplace=True)  # Modifies original DataFrame"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "df = pd.DataFrame({\n    'A': [1, 2, np.nan, 4, 5],\n    'B': [5, np.nan, 7, 8, np.nan],\n    'C': ['a', np.nan, 'c', 'd', 'e']\n})\n\n# Fill with constant value\ndf_filled = df.fillna(0)\nprint(df_filled)\n\n# Forward fill (propagate last valid value)\ndf_ffill = df.fillna(method='ffill')  # Deprecated, use df.ffill()\ndf_ffill = df.ffill()\nprint(df_ffill)\n#      A    B  C\n# 0  1.0  5.0  a\n# 1  2.0  5.0  a\n# 2  NaN  5.0  c\n# 3  4.0  8.0  d\n# 4  5.0  8.0  e\n\n# Backward fill (propagate next valid value)\ndf_bfill = df.bfill()\nprint(df_bfill)\n\n# Fill with different values per column\ndf_filled = df.fillna({'A': 0, 'B': -1, 'C': 'unknown'})\nprint(df_filled)\n\n# Fill with column mean (common for numeric data)\ndf_numeric = df[['A', 'B']]\ndf_mean = df_numeric.fillna(df_numeric.mean())\nprint(df_mean)\n\n# Fill with median\ndf_median = df_numeric.fillna(df_numeric.median())\nprint(df_median)\n\n# Limit number of fills\ndf_limited = df.fillna(0, limit=1)  # Fill only first NaN in each column\nprint(df_limited)\n\n# Fill with interpolation (especially useful for time series)\ndf_interp = df[['A', 'B']].interpolate()\nprint(df_interp)\n\n# In-place filling\ndf.fillna(0, inplace=True)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Time series example\ndates = pd.date_range('2024-01-01', periods=10)\nts = pd.Series([10, 20, np.nan, 40, np.nan, 60, 70, np.nan, 90, 100], index=dates)\n\nprint(ts)\n# 2024-01-01     10.0\n# 2024-01-02     20.0\n# 2024-01-03      NaN\n# 2024-01-04     40.0\n# 2024-01-05      NaN\n# 2024-01-06     60.0\n# 2024-01-07     70.0\n# 2024-01-08      NaN\n# 2024-01-09     90.0\n# 2024-01-10    100.0\n\n# Linear interpolation\nts_linear = ts.interpolate(method='linear')\nprint(ts_linear)\n# 2024-01-01     10.0\n# 2024-01-02     20.0\n# 2024-01-03     30.0  (interpolated)\n# 2024-01-04     40.0\n# 2024-01-05     50.0  (interpolated)\n# 2024-01-06     60.0\n# 2024-01-07     70.0\n# 2024-01-08     80.0  (interpolated)\n# 2024-01-09     90.0\n# 2024-01-10    100.0\n\n# Polynomial interpolation\nts_poly = ts.interpolate(method='polynomial', order=2)\nprint(ts_poly)\n\n# Spline interpolation\nts_spline = ts.interpolate(method='spline', order=1)\nprint(ts_spline)\n\n# Forward fill (for categorical/label data)\ncategorical_ts = pd.Series(['A', 'A', np.nan, 'B', np.nan, 'B'], \n                           index=pd.date_range('2024-01-01', periods=6))\ncategorical_filled = categorical_ts.fillna(method='ffill')\nprint(categorical_filled)\n\n# Limit interpolation\nts_limited = ts.interpolate(limit=1)  # Interpolate only 1 consecutive NaN\nprint(ts_limited)"
        ]
      ]
    },
    {
