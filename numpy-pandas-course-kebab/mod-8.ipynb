        [
          "python",
          "# Original data with missing values\ndf = pd.DataFrame({\n    'score': [85, 90, np.nan, 78, np.nan, 92, 88, 95, np.nan, 80]\n})\n\n# Statistics with missing values\nprint(\"Original statistics:\")\nprint(f\"Mean: {df['score'].mean()}\")  # {df['score'].mean():.2f}\nprint(f\"Std: {df['score'].std()}\")\nprint(f\"Count: {df['score'].count()}\")\n\n# Mean imputation\ndf_mean = df.copy()\ndf_mean['score'].fillna(df_mean['score'].mean(), inplace=True)\nprint(\"\\nMean imputation:\")\nprint(f\"Mean: {df_mean['score'].mean():.2f}\")\nprint(f\"Std: {df_mean['score'].std():.2f}\")  # Reduced variance!\nprint(f\"Count: {df_mean['score'].count()}\")\n\n# Median imputation\ndf_median = df.copy()\ndf_median['score'].fillna(df_median['score'].median(), inplace=True)\nprint(\"\\nMedian imputation:\")\nprint(f\"Mean: {df_median['score'].mean():.2f}\")\nprint(f\"Median: {df_median['score'].median():.2f}\")\n\n# Forward fill\ndf_ffill = df.copy()\ndf_ffill['score'].fillna(method='ffill', inplace=True)\nprint(\"\\nForward fill:\")\nprint(f\"Mean: {df_ffill['score'].mean():.2f}\")\nprint(f\"Count: {df_ffill['score'].count()}\")\n\n# Deletion (complete case analysis)\ndf_deleted = df.dropna()\nprint(\"\\nComplete case analysis (dropna):\")\nprint(f\"Mean: {df_deleted['score'].mean():.2f}\")\nprint(f\"Std: {df_deleted['score'].std():.2f}\")\nprint(f\"Count: {df_deleted['score'].count()}\")\n\n# Impact summary: Choose strategy based on data mechanism\nprint(\"\\nImputation impact on analysis:\")\nprint(\"- Mean/median: Reduces variance, may bias correlations\")\nprint(\"- Forward/backward fill: Good for time series\")\nprint(\"- Deletion: Valid if data is MCAR, loses information\")\nprint(\"- Multiple imputation: Best for inference, more complex\")"
        ]
      ]
    }
