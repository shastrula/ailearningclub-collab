        [
          "python",
          "# Creating categorical data\ncolors = pd.Categorical(['red', 'blue', 'red', 'green', 'blue', 'red'])\nprint(colors)\n# ['red', 'blue', 'red', 'green', 'blue', 'red']\n# Categories (3, object): ['blue', 'green', 'red']\n\n# Categorical in DataFrame\ndf = pd.DataFrame({\n    'product': pd.Categorical(['A', 'B', 'A', 'C', 'B']),\n    'region': pd.Categorical(['North', 'South', 'North', 'East', 'South'])\n})\n\nprint(df['product'].cat.categories)      # ['A', 'B', 'C']\nprint(df['product'].cat.codes)           # [0 1 0 2 1] (internal integer codes)\n\n# Ordered categories\neducation = pd.Categorical(\n    ['high school', 'bachelor', 'master', 'high school'],\n    categories=['high school', 'bachelor', 'master', 'phd'],\n    ordered=True\n)\nprint(education)\n\n# Operations on categorical\nprint(df['product'].value_counts())\n# A    2\n# B    2\n# C    1\n\n# Adding new categories\ndf['product'] = df['product'].cat.add_categories(['D'])\nprint(df['product'].cat.categories)  # ['A', 'B', 'C', 'D']\n\n# Removing unused categories\ndf_subset = df[df['product'] != 'C']\ndf_subset['product'] = df_subset['product'].cat.remove_unused_categories()"
        ]
      ]
