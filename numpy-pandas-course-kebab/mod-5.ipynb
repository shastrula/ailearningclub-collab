        [
          "python",
          "import pandas as pd\nimport numpy as np\n\n# Creating DatetimeIndex\ndates = pd.date_range('2024-01-01', periods=10, freq='D')\nprint(dates)\n# DatetimeIndex(['2024-01-01', '2024-01-02', ..., '2024-01-10'], dtype='datetime64[ns]', freq='D')\n\n# Creating time series\nts = pd.Series(np.random.randn(10), index=dates)\nprint(ts)\n\n# Accessing date components\nprint(dates.year)       # [2024 2024 2024 ...]\nprint(dates.month)      # [1 1 1 ...]\nprint(dates.day)        # [1 2 3 ...]\nprint(dates.dayofweek)  # [0 1 2 ...] (Monday=0, Sunday=6)\nprint(dates.quarter)    # [1 1 1 ...]\n\n# Creating DatetimeIndex with different frequencies\nhourly = pd.date_range('2024-01-01', periods=24, freq='H')\nmonthly = pd.date_range('2024-01-01', periods=12, freq='M')\nquarterly = pd.date_range('2024-01-01', periods=4, freq='Q')\n\n# Resampling time series\nts_hourly = pd.Series(np.random.randn(24), index=hourly)\ndaily_sum = ts_hourly.resample('D').sum()      # Sum by day\ndaily_mean = ts_hourly.resample('D').mean()    # Mean by day\ndaily_ohlc = ts_hourly.resample('D').ohlc()    # Open, high, low, close\n\n# Shifting and rolling\nts = pd.Series([10, 20, 30, 40, 50], index=pd.date_range('2024-01-01', periods=5))\nprint(ts.shift(1))      # Shift forward by 1 (for lag features)\n# 2024-01-01    NaN\n# 2024-01-02   10.0\n# 2024-01-03   20.0\n\nrolling_mean = ts.rolling(window=2).mean()  # 2-period moving average\nprint(rolling_mean)\n# 2024-01-01     NaN\n# 2024-01-02    15.0\n# 2024-01-03    25.0\n# 2024-01-04    35.0\n# 2024-01-05    45.0\n\n# Accessing by date\nprint(ts['2024-01-01':'2024-01-03'])  # Slice by date range\nprint(ts['2024-01-02'])               # Access single date"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Creating MultiIndex from product and region\narrays = [\n    ['A', 'A', 'B', 'B'],\n    ['North', 'South', 'North', 'South']\n]\nindex = pd.MultiIndex.from_arrays(arrays, names=['product', 'region'])\ndf = pd.DataFrame({'sales': [100, 150, 200, 250]}, index=index)\nprint(df)\n#                    sales\n# product region\n# A       North    100\n#         South    150\n# B       North    200\n#         South    250\n\n# Accessing MultiIndex data\nprint(df.loc['A'])           # All rows where product='A'\n# region\n# North    100\n# South    150\n\nprint(df.loc[('A', 'North')])  # Specific row\n\n# Converting columns to MultiIndex\ndf_multi = pd.DataFrame(\n    np.random.randn(4, 6),\n    columns=pd.MultiIndex.from_product([['X', 'Y', 'Z'], [1, 2]])\n)\nprint(df_multi)\n#           X           Y           Z\n#           1    2      1    2      1    2\n\n# Stacking and unstacking\nstacked = df.stack()        # Convert column index to row index\nunstacked = stacked.unstack()\n\n# Level names\nprint(df.index.names)  # ['product', 'region']\nprint(df.index.levels)  # Unique values for each level\n\n# Swapping levels\nswapped = df.swaplevel()\nprint(swapped)\n#                    sales\n# region product\n# North  A        100\n# South  A        150"
        ]
      ]
    },
