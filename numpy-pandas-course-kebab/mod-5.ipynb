          "python",
          "# Creating sparse Series\nsparse_series = pd.Series(pd.arrays.SparseArray([0, 0, 1, 0, 2, 0, 0, 3, 0]))\nprint(sparse_series)\n# 0    0\n# 1    0\n# 2    1\n# 3    0\n# 4    2\n# 5    0\n# 6    0\n# 7    3\n# 8    0\n\n# Sparse DataFrame\ndata = {\n    'A': pd.arrays.SparseArray([1, 0, 0, 2]),\n    'B': pd.arrays.SparseArray([0, 3, 0, 0]),\n    'C': pd.arrays.SparseArray([0, 0, 4, 0])\n}\ndf_sparse = pd.DataFrame(data)\nprint(df_sparse)\n\n# Memory usage comparison\ndense = pd.DataFrame(np.random.choice([0, 1], size=(1000, 100), p=[0.9, 0.1]))\nsparse = dense.astype(pd.SparseDtype(int, 0))\nprint(dense.memory_usage(deep=True).sum() / 1024)     # KB\nprint(sparse.memory_usage(deep=True).sum() / 1024)    # Much smaller\n\n# Accessing sparse values\nprint(df_sparse['A'].sparse.density)  # Fraction of non-zero values\nprint(df_sparse['A'].sparse.npoints)  # Number of non-zero points"
        ]
      ]
