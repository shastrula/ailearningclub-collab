          "python",
          "import pandas as pd\nimport numpy as np\n\n# Creating Series from list\ns1 = pd.Series([10, 20, 30, 40])\nprint(s1)\n# 0    10\n# 1    20\n# 2    30\n# 3    40\n\n# Series with custom index\ns2 = pd.Series([10, 20, 30, 40], index=['a', 'b', 'c', 'd'])\nprint(s2)\n# a    10\n# b    20\n# c    30\n# d    40\n\n# Series from dictionary\ndata = {'apple': 5, 'banana': 3, 'cherry': 8}\ns3 = pd.Series(data)\nprint(s3)\n# apple     5\n# banana    3\n# cherry    8\n\n# Series attributes\nprint(s2.index)       # Index(['a', 'b', 'c', 'd'], dtype='object')\nprint(s2.values)      # [10 20 30 40]\nprint(s2.dtype)       # int64\nprint(s2.shape)       # (4,)\n\n# Accessing elements\nprint(s2['b'])        # 20 (label-based)\nprint(s2[1])          # 20 (position-based)\n\n# Series operations\nprint(s2 * 2)         # Vectorized multiplication\nprint(s2.sum())       # 100\nprint(s2.mean())      # 25.0"
        ]
      ]
    },
