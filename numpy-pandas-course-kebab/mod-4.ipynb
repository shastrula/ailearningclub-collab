        [
          "python",
          "# Creating DataFrame from dictionary\ndata = {\n    'name': ['Alice', 'Bob', 'Charlie', 'David'],\n    'age': [25, 30, 35, 28],\n    'salary': [50000, 60000, 75000, 55000],\n    'department': ['Sales', 'IT', 'HR', 'Sales']\n}\ndf = pd.DataFrame(data)\nprint(df)\n#       name  age  salary department\n# 0    Alice   25   50000      Sales\n# 1      Bob   30   60000        IT\n# 2  Charlie   35   75000        HR\n# 3    David   28   55000      Sales\n\n# DataFrame attributes\nprint(df.shape)          # (4, 4) - 4 rows, 4 columns\nprint(df.columns)        # Index(['name', 'age', 'salary', 'department'], ...)\nprint(df.index)          # RangeIndex(start=0, stop=4, step=1)\nprint(df.dtypes)         # Data type of each column\nprint(df.info())         # Summary of DataFrame\n\n# Accessing columns\nprint(df['name'])        # Series\nprint(df[['name', 'age']])  # Multiple columns (DataFrame)\n\n# Accessing rows\nprint(df.loc[0])         # First row by label\nprint(df.iloc[0])        # First row by position\nprint(df.loc[0:2])       # Rows 0, 1, 2 (inclusive)\n\n# Basic statistics\nprint(df.describe())     # Summary statistics for numeric columns"
