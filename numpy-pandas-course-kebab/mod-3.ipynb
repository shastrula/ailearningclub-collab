          "python",
          "# Seed for reproducibility\nnp.random.seed(42)\n\n# Uniform distribution [0, 1)\nrandom_uniform = np.random.rand(5)\nprint(random_uniform)\n\n# Normal (Gaussian) distribution\nrandom_normal = np.random.randn(5)\nprint(random_normal)\n\n# Integers in a range\nrandom_int = np.random.randint(1, 100, size=10)\nprint(random_int)\n\n# Poisson distribution (count of events)\npoisson = np.random.poisson(lam=3, size=5)\nprint(poisson)\n\n# Exponential distribution\nexponential = np.random.exponential(scale=2, size=5)\nprint(exponential)\n\n# Shuffling arrays\narr = np.arange(10)\nnp.random.shuffle(arr)  # In-place\nprint(arr)\n\n# Random choice (with and without replacement)\ndata = np.array([10, 20, 30, 40, 50])\nsamples = np.random.choice(data, size=10, replace=True)\nprint(samples)\n\n# Permutations\nindices = np.random.permutation(5)\nprint(indices)  # Random order [0, 1, 2, 3, 4]\n\n# Multiple distributions\nsize = (3, 3)\nchi_square = np.random.chisquare(df=2, size=size)\nbeta = np.random.beta(a=2, b=5, size=5)"
