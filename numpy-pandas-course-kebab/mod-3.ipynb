          "python",
          "# Matrix operations\nA = np.array([[1, 2], [3, 4]])\nB = np.array([[5, 6], [7, 8]])\n\n# Determinant\ndet_A = np.linalg.det(A)\nprint(det_A)  # -2.0\n\n# Matrix inverse\nA_inv = np.linalg.inv(A)\nprint(A_inv)  # [[-2.   1. ] [ 1.5 -0.5]]\n\n# Matrix rank\nrank = np.linalg.matrix_rank(A)\nprint(rank)  # 2\n\n# Trace (sum of diagonal)\ntrace = np.trace(A)\nprint(trace)  # 5\n\n# Eigenvalues and eigenvectors\neigenvalues, eigenvectors = np.linalg.eig(A)\nprint(eigenvalues)      # [-0.37... 5.37...]\nprint(eigenvectors)     # [[-0.82... -0.41...] [ 0.57...  0.90...]]\n\n# Singular Value Decomposition (SVD)\nU, S, Vt = np.linalg.svd(A)\nprint(U.shape)          # (2, 2)\nprint(S)                # [5.46... 0.36...]\nprint(Vt.shape)         # (2, 2)\n\n# Solve linear system Ax = b\nb = np.array([1, 2])\nx = np.linalg.solve(A, b)\nprint(x)                # Solution to Ax = b\n\n# Least squares (overdetermined system)\nA_tall = np.array([[1, 2], [3, 4], [5, 6]])\nb_tall = np.array([1, 2, 3])\nx_ls, residuals, rank, s = np.linalg.lstsq(A_tall, b_tall, rcond=None)\nprint(x_ls)             # Least squares solution\n\n# Matrix norm\nnorm = np.linalg.norm(A)\nprint(norm)             # Frobenius norm"
