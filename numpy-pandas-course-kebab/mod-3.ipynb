      "source": [
        [
          "python",
          "# Simple custom ufunc using frompyfunc\ndef my_func(x):\n    return x ** 2 + 2 * x + 1\n\nufunc = np.frompyfunc(my_func, 1, 1)  # 1 input, 1 output\narr = np.array([0, 1, 2, 3, 4])\nresult = ufunc(arr)\nprint(result)  # [1 4 9 16 25]\n\n# More efficient: use vectorize for conditional logic\ndef classify_score(score):\n    if score >= 90:\n        return 'A'\n    elif score >= 80:\n        return 'B'\n    else:\n        return 'C'\n\nvectorized_classify = np.vectorize(classify_score, otypes=[object])\nscores = np.array([95, 85, 75, 88, 92])\ngrades = vectorized_classify(scores)\nprint(grades)  # ['A' 'B' 'C' 'B' 'A']\n\n# For performance-critical code, use ufunc method: reduce\n# Custom reduction (sum of squares)\narr = np.array([1, 2, 3, 4])\nsum_of_squares = np.sum(arr ** 2)\nprint(sum_of_squares)  # 30"
        ]
      ]
    },
