        [
          "python",
          "# Create data with different distributions\nnormal = np.random.normal(100, 15, 1000)\nskewed = np.random.exponential(50, 1000)\n\ndist_df = pd.DataFrame({\n    'normal': normal,\n    'skewed': skewed\n})\n\n# Basic histogram\ndist_df['normal'].plot(kind='hist', bins=30, alpha=0.7, edgecolor='black')\nplt.title('Normal Distribution')\nplt.xlabel('Value')\nplt.ylabel('Frequency')\nplt.show()\n\n# Overlapping histograms\nfig, ax = plt.subplots()\ndist_df['normal'].plot(kind='hist', bins=30, alpha=0.5, label='Normal', ax=ax)\ndist_df['skewed'].plot(kind='hist', bins=30, alpha=0.5, label='Skewed', ax=ax)\nax.legend()\nax.set_title('Distribution Comparison')\nplt.show()\n\n# Histogram with density\ndist_df['normal'].plot(kind='hist', bins=40, density=True, alpha=0.7, label='Histogram')\ndist_df['normal'].plot(kind='kde', label='Density', secondary_y=False, ax=plt.gca())\nplt.title('Distribution with Density Curve')\nplt.xlabel('Value')\nplt.legend()\nplt.show()\n\n# Cumulative distribution\ndist_df['normal'].plot(kind='hist', bins=40, cumulative=True, density=True)\nplt.title('Cumulative Distribution')\nplt.ylabel('Cumulative Probability')\nplt.show()"
        ]
      ]
    },
