          "python",
          "# Seaborn for statistical visualization\nimport seaborn as sns\n\n# Generate sample data\nnp.random.seed(42)\nplot_data = pd.DataFrame({\n    'A': np.random.normal(100, 15, 200),\n    'B': np.random.normal(110, 20, 200),\n    'C': np.random.normal(95, 12, 200),\n    'group': np.random.choice(['X', 'Y', 'Z'], 200)\n})\n\n# Statistical bar plot with confidence intervals\nfig, ax = plt.subplots(figsize=(10, 5))\nsns.barplot(data=plot_data, x='group', y='A', ax=ax, palette='Set2', errorbar='sd')\nax.set_title('Mean with Standard Deviation')\nplt.show()\n\n# Violin plot showing distribution by group\nfig, ax = plt.subplots(figsize=(10, 5))\nsns.violinplot(data=plot_data, x='group', y='A', ax=ax, palette='Set2')\nax.set_title('Distribution by Group (Violin Plot)')\nplt.show()\n\n# Heatmap example\ncorr = plot_data[['A', 'B', 'C']].corr()\nfig, ax = plt.subplots(figsize=(6, 5))\nsns.heatmap(corr, annot=True, fmt='.2f', cmap='coolwarm', center=0, ax=ax, vmin=-1, vmax=1)\nax.set_title('Correlation Heatmap')\nplt.show()"
        ]
      ]
