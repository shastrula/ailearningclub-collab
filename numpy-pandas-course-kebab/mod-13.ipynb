          "python",
          "# Customization options\ndf['revenue'].plot(\n    kind='line',\n    color='#2E86AB',\n    linewidth=2.5,\n    linestyle='-',\n    marker='o',\n    markersize=4,\n    alpha=0.8,\n    label='Revenue'\n)\n\nplt.title('Revenue Trend', fontsize=14, fontweight='bold')\nplt.xlabel('Date', fontsize=12)\nplt.ylabel('Amount ($)', fontsize=12)\nplt.grid(True, alpha=0.3, linestyle='--')\nplt.legend(loc='best', fontsize=11)\nplt.tight_layout()\nplt.show()\n\n# Style presets\nplt.style.use('seaborn-v0_8-darkgrid')\ndf[['revenue', 'expenses']].plot()\nplt.title('Financial Data (Seaborn Style)')\nplt.show()\n\n# Reset to default\nplt.style.use('default')\n\n# Custom figure size and DPI\nfig, ax = plt.subplots(figsize=(12, 6), dpi=100)\ndf.plot(ax=ax)\nax.set_title('Wide Financial Plot')\nplt.tight_layout()\nplt.show()\n\n# Saving figures\nfig.savefig('revenue_plot.png', dpi=300, bbox_inches='tight')\nfig.savefig('revenue_plot.pdf', dpi=300, bbox_inches='tight')"
