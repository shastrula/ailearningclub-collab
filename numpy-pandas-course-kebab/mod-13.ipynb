        [
          "python",
          "# Practical example: comprehensive visualization\nnp.random.seed(42)\nmulti_data = pd.DataFrame({\n    'date': pd.date_range('2024-01-01', periods=100),\n    'sales': np.cumsum(np.random.normal(100, 50, 100)) + 5000,\n    'category': np.random.choice(['A', 'B', 'C'], 100),\n    'region': np.random.choice(['North', 'South', 'East'], 100)\n})\n\n# Line plot of cumulative sales\nfig, axes = plt.subplots(2, 2, figsize=(12, 8))\n\n# Time series\naxes[0, 0].plot(multi_data['date'], multi_data['sales'], color='blue', linewidth=2)\naxes[0, 0].set_title('Sales Over Time')\naxes[0, 0].set_ylabel('Sales ($)')\naxes[0, 0].grid(True, alpha=0.3)\n\n# Distribution histogram\naxes[0, 1].hist(multi_data['sales'], bins=20, color='green', alpha=0.7, edgecolor='black')\naxes[0, 1].set_title('Sales Distribution')\naxes[0, 1].set_xlabel('Sales ($)')\n\n# Category breakdown\nmulti_data['category'].value_counts().plot(kind='bar', ax=axes[1, 0], color='orange')\naxes[1, 0].set_title('Sales by Category')\naxes[1, 0].set_ylabel('Count')\n\n# Box plot by region\nmulti_data.boxplot(column='sales', by='region', ax=axes[1, 1])\naxes[1, 1].set_title('Sales by Region')\naxes[1, 1].set_ylabel('Sales ($)')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
