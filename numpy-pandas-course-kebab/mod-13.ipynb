        [
          "python",
          "# Area plot\nsales_data = pd.DataFrame({\n    'Product_A': [1000, 1200, 1100, 1400, 1350],\n    'Product_B': [800, 900, 950, 1100, 1200],\n    'Product_C': [600, 650, 700, 800, 900]\n}, index=['Q1', 'Q2', 'Q3', 'Q4', 'Q5'])\n\nsales_data.plot(kind='area', alpha=0.7)\nplt.title('Sales by Product')\nplt.ylabel('Sales ($)')\nplt.tight_layout()\nplt.show()\n\n# Stacked area\nsales_data.plot(kind='area', stacked=True, alpha=0.7)\nplt.title('Total Sales Composition')\nplt.ylabel('Sales ($)')\nplt.show()\n\n# Pie chart\ntotal_sales = sales_data.sum()\ntotal_sales.plot(kind='pie', autopct='%1.1f%%')\nplt.title('Total Sales Share')\nplt.ylabel('')\nplt.show()\n\n# Donut chart (pie with white circle)\nfig, ax = plt.subplots()\ntotal_sales.plot(kind='pie', autopct='%1.1f%%', ax=ax)\ncentre_circle = plt.Circle((0, 0), 0.70, fc='white')\nax.add_artist(centre_circle)\nplt.title('Sales Distribution (Donut)')\nplt.ylabel('')\nplt.show()"
        ]
