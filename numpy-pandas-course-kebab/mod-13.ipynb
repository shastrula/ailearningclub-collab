          "python",
          "# Advanced customization example\nnp.random.seed(42)\nmonthly_data = pd.DataFrame({\n    'month': pd.date_range('2024-01-01', periods=12, freq='M'),\n    'Product_A': np.cumsum(np.random.normal(1000, 200, 12)) + 5000,\n    'Product_B': np.cumsum(np.random.normal(800, 150, 12)) + 4000,\n    'Product_C': np.cumsum(np.random.normal(1200, 250, 12)) + 6000\n})\n\nfig, ax = plt.subplots(figsize=(12, 7))\n\n# Custom color palette\ncolors = ['#1f77b4', '#ff7f0e', '#2ca02c']\nx = range(len(monthly_data))\n\nfor i, col in enumerate(['Product_A', 'Product_B', 'Product_C']):\n    ax.plot(x, monthly_data[col], \n           color=colors[i], \n           linewidth=3, \n           marker='o', \n           markersize=8,\n           label=col,\n           alpha=0.8)\n\n# Enhanced formatting\nax.set_title('Annual Sales Forecast by Product', fontsize=16, fontweight='bold', pad=20)\nax.set_xlabel('Month', fontsize=12, fontweight='bold')\nax.set_ylabel('Cumulative Sales ($)', fontsize=12, fontweight='bold')\n\n# Set x-axis labels to month names\nmonth_names = monthly_data['month'].dt.strftime('%b')\nax.set_xticks(x)\nax.set_xticklabels(month_names, rotation=45)\n\n# Format y-axis as currency\nax.yaxis.set_major_formatter(plt.FuncFormatter(lambda x, p: f'${x/1000:.0f}K'))\n\n# Grid and legend\nax.grid(True, alpha=0.3, linestyle='--', linewidth=0.7)\nax.legend(loc='upper left', fontsize=11, framealpha=0.95, edgecolor='black')\n\n# Add shaded region for Q4\nax.axvspan(9, 11.5, alpha=0.1, color='gold', label='Q4')\n\nplt.tight_layout()\nplt.show()\n\n# Faceted comparison plots\nfig, axes = plt.subplots(1, 3, figsize=(15, 4), sharey=True)\n\nfor idx, col in enumerate(['Product_A', 'Product_B', 'Product_C']):\n    axes[idx].bar(x, monthly_data[col], color=colors[idx], alpha=0.7, edgecolor='black')\n    axes[idx].set_title(col, fontsize=12, fontweight='bold')\n    axes[idx].set_xlabel('Month')\n    axes[idx].set_xticks(x)\n    axes[idx].set_xticklabels(month_names, rotation=45)\n    axes[idx].grid(True, alpha=0.3, axis='y')\n\naxes[0].set_ylabel('Sales ($)', fontsize=12, fontweight='bold')\nplt.tight_layout()\nplt.show()"
        ]
