          "python",
          "import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Create sample data\nnp.random.seed(42)\ndates = pd.date_range('2024-01-01', periods=100)\ndf = pd.DataFrame({\n    'revenue': np.random.normal(5000, 1000, 100),\n    'expenses': np.random.normal(3000, 800, 100),\n    'profit': np.random.normal(2000, 600, 100)\n}, index=dates)\n\n# Line plot (default)\nax = df.plot()\nax.set_title('Financial Metrics Over Time')\nax.set_ylabel('Amount ($)')\nplt.tight_layout()\nplt.show()\n\n# Single series\ndf['revenue'].plot(label='Revenue', color='green')\nplt.legend()\nplt.title('Revenue Trend')\nplt.show()\n\n# Different plot types\ndf[['revenue', 'expenses']].plot(kind='line', style=['-', '--'])\nplt.title('Revenue vs Expenses')\nplt.show()\n\n# Bar plot\nmonthly = df.resample('M').sum()\nmonthly[['revenue', 'expenses']].plot(kind='bar')\nplt.title('Monthly Totals')\nplt.xticks(rotation=45)\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
