        [
          "python",
          "# Create correlated data\nn = 100\nx = np.random.normal(100, 15, n)\ny = 2 * x + np.random.normal(0, 30, n)\n\nscatter_df = pd.DataFrame({\n    'x': x,\n    'y': y,\n    'category': np.random.choice(['A', 'B', 'C'], n)\n})\n\n# Basic scatter plot\nscatter_df.plot(kind='scatter', x='x', y='y', alpha=0.6)\nplt.title('Relationship between X and Y')\nplt.show()\n\n# Scatter with categories (color by group)\nfor cat in ['A', 'B', 'C']:\n    subset = scatter_df[scatter_df['category'] == cat]\n    plt.scatter(subset['x'], subset['y'], label=cat, alpha=0.6, s=50)\nplt.legend()\nplt.title('Scatter by Category')\nplt.show()\n\n# Box plot for single variable\nscatter_df['y'].plot(kind='box')\nplt.title('Distribution of Y')\nplt.show()\n\n# Box plot grouped by category\nscatter_df.boxplot(column='y', by='category')\nplt.suptitle('')  # Remove automatic title\nplt.title('Y Distribution by Category')\nplt.show()\n\n# Multiple variables box plot\ndf_box = pd.DataFrame({\n    'Group_A': np.random.normal(100, 10, 100),\n    'Group_B': np.random.normal(110, 15, 100),\n    'Group_C': np.random.normal(95, 12, 100)\n})\n\ndf_box.plot(kind='box')\nplt.title('Group Distributions')\nplt.ylabel('Value')\nplt.show()"
