        [
          "python",
          "import pandas as pd\nimport numpy as np\n\ndf = pd.DataFrame({\n    'name': ['Alice', 'Bob', 'Charlie'],\n    'age': [25, 30, 35],\n    'salary': [50000, 60000, 75000]\n})\n\n# Apply to each element in a column (element-wise)\ndf['age_squared'] = df['age'].apply(lambda x: x ** 2)\nprint(df['age_squared'])  # [625, 900, 1225]\n\n# Apply with custom function\ndef categorize_age(age):\n    if age < 30:\n        return 'Young'\n    elif age < 35:\n        return 'Middle'\n    else:\n        return 'Senior'\n\ndf['age_category'] = df['age'].apply(categorize_age)\nprint(df)\n\n# Apply to entire rows (axis=1)\ndef calculate_bonus(row):\n    if row['age'] > 30:\n        return row['salary'] * 0.1\n    else:\n        return row['salary'] * 0.05\n\ndf['bonus'] = df.apply(calculate_bonus, axis=1)\nprint(df)\n\n# Apply to columns (axis=0)\ndf_numeric = df[['age', 'salary']]\ndf_normalized = df_numeric.apply(lambda x: (x - x.mean()) / x.std())\nprint(df_normalized)\n\n# map() for value replacement\nsalary_mapping = {50000: 'Low', 60000: 'Medium', 75000: 'High'}\ndf['salary_level'] = df['salary'].map(salary_mapping)\nprint(df)\n\n# map() with function\ndf['name_upper'] = df['name'].map(str.upper)\nprint(df)"
