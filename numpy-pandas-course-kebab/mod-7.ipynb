          "# Element-wise operations with applymap (newer: map)\ndf = pd.DataFrame({\n    'A': [1, 2, 3],\n    'B': [4, 5, 6]\n})\n\n# Using map() (newer versions)\nresult = df.map(lambda x: x ** 2)\nprint(result)\n# A   B\n# 0   1  16\n# 1   4  25\n# 2   9  36\n\n# Format numbers\ndf_formatted = df.map('{:.2f}'.format)\nprint(df_formatted)\n\n# Conditional formatting preparation\ndf_display = df.map(lambda x: 'High' if x > 3 else 'Low')\nprint(df_display)\n\n# Rounding to different decimals for display\ndf_float = pd.DataFrame({\n    'A': [1.123, 2.456, 3.789],\n    'B': [4.111, 5.222, 6.333]\n})\ndf_rounded = df_float.map(lambda x: round(x, 1))\nprint(df_rounded)"
