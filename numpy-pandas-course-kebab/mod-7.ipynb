          "python",
          "# String operations\nnames = pd.Series(['alice', 'bob', 'charlie', 'david'])\n\n# Case conversion\nprint(names.str.upper())        # ['ALICE', 'BOB', 'CHARLIE', 'DAVID']\nprint(names.str.lower())        # Already lowercase\nprint(names.str.title())        # ['Alice', 'Bob', 'Charlie', 'David']\nprint(names.str.capitalize())   # ['Alice', 'Bob', 'Charlie', 'David']\n\n# String properties\nprint(names.str.len())          # [5, 3, 7, 5]\nprint(names.str.startswith('a'))  # [True, False, False, False]\nprint(names.str.endswith('e'))    # [True, False, True, False]\n\n# String slicing\nprint(names.str[0])             # ['a', 'b', 'c', 'd']\nprint(names.str[0:3])           # ['ali', 'bob', 'cha', 'dav']\n\n# String replacement\ntext = pd.Series(['hello world', 'hi there', 'hey buddy'])\nprint(text.str.replace('hello', 'goodbye'))\n# ['goodbye world', 'hi there', 'hey buddy']\n\n# String splitting\naddresses = pd.Series(['New York, NY', 'Los Angeles, CA', 'Chicago, IL'])\nsplit = addresses.str.split(', ', expand=True)\nprint(split)\n# 0                1\n# 0        New York NY\n# 1  Los Angeles  CA\n# 2        Chicago  IL\n\n# String contains (regex)\nemails = pd.Series(['alice@example.com', 'bob@test.org', 'invalid.email'])\nprint(emails.str.contains('@'))  # [True, True, False]\n\n# String extraction\ndf = pd.DataFrame({'data': ['ID: 123', 'ID: 456', 'ID: 789']})\ndf['id'] = df['data'].str.extract(r'(\\d+)')\nprint(df)"
