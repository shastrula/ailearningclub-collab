          "python",
          "df = pd.DataFrame({\n    'A': [1, 2, 3, 4, 5],\n    'B': [10, 20, 30, 40, 50]\n})\n\n# pipe() for custom operations\ndef normalize(data):\n    return (data - data.mean()) / data.std()\n\nresult = df.pipe(normalize)\nprint(result)\n\n# Chaining with pipe\nresult = (df\n    .pipe(normalize)\n    .pipe(lambda x: x * 100)\n)\n\n# assign() creates new columns without modifying original\ndf_new = df.assign(\n    C=df['A'] + df['B'],\n    D=df['A'] * 2\n)\nprint(df_new)  # Original df unchanged\n\n# assign() with lambda\ndf_new = df.assign(\n    ratio=lambda x: x['B'] / x['A'],\n    doubled=lambda x: x['A'] * 2\n)\nprint(df_new)\n\n# Method chaining with assign and query\nresult = (df\n    .assign(\n        sum_col=df['A'] + df['B'],\n        product_col=df['A'] * df['B']\n    )\n    .query('sum_col > 30')\n    .assign(normalized=lambda x: (x['sum_col'] - x['sum_col'].mean()) / x['sum_col'].std())\n)\nprint(result)\n\n# pipe() with custom function\ndef filter_and_transform(data):\n    return data[data['A'] > 2].assign(squared=lambda x: x['A'] ** 2)\n\nresult = df.pipe(filter_and_transform)\nprint(result)"
