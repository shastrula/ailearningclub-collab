          "python",
          "# Create datetime Series\ndates = pd.Series(pd.date_range('2024-01-01', periods=5))\n\n# Extract date components\nprint(dates.dt.year)        # [2024, 2024, 2024, 2024, 2024]\nprint(dates.dt.month)       # [1, 1, 1, 1, 1]\nprint(dates.dt.day)         # [1, 2, 3, 4, 5]\nprint(dates.dt.dayofweek)   # [0, 1, 2, 3, 4] (Monday=0)\nprint(dates.dt.day_name())  # ['Monday', 'Tuesday', ...]\nprint(dates.dt.quarter)     # [1, 1, 1, 1, 1]\nprint(dates.dt.week)        # [1, 1, 1, 1, 1]\n\n# Date arithmetic\ndf = pd.DataFrame({'date': pd.date_range('2024-01-01', periods=5)})\ndf['next_day'] = df['date'] + pd.Timedelta(days=1)\ndf['days_since'] = (pd.Timestamp('2024-01-10') - df['date']).dt.days\nprint(df)\n\n# Date rounding\ndf['month_start'] = df['date'].dt.to_period('M').dt.start_time\ndf['quarter_end'] = df['date'].dt.to_period('Q').dt.end_time\nprint(df)\n\n# Time component extraction\ntimestamps = pd.Series(pd.date_range('2024-01-01 12:34:56', periods=5, freq='H'))\nprint(timestamps.dt.hour)       # [12, 13, 14, 15, 16]\nprint(timestamps.dt.minute)     # [34, 34, 34, 34, 34]\nprint(timestamps.dt.second)     # [56, 56, 56, 56, 56]"
