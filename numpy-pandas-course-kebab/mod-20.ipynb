      "outputs": [],
      "source": [
        [
          "python",
          "# Equal-width binning\ndf['age_bin_width'] = pd.cut(\n    df['age_from_built'],\n    bins=5,  # Create 5 equal-width bins\n    labels=['Very_New', 'New', 'Medium', 'Old', 'Very_Old']\n)\n\n# Equal-frequency binning (quantiles)\ndf['price_bin_freq'] = pd.qcut(\n    df['price'],\n    q=4,  # Create 4 bins with roughly equal records\n    labels=['Cheap', 'Moderate', 'Expensive', 'Luxury'],\n    duplicates='drop'\n)\n\n# Custom binning with business logic\nbins = [0, 1, 5, 10, 20, 100]\nlabels = ['Brand_New', 'Recent', 'Young', 'Old', 'Ancient']\ndf['age_business'] = pd.cut(df['age_from_built'], bins=bins, labels=labels)\n\n# One-hot encode the binned features\ndf_encoded = pd.get_dummies(df[['age_bin_width', 'price_bin_freq']], drop_first=True)\nprint(df_encoded.head())\n\n# Binning with explicit boundaries\ndef custom_price_bin(price):\n    if price < 200000:\n        return 'Budget'\n    elif price < 500000:\n        return 'Standard'\n    elif price < 1000000:\n        return 'Premium'\n    else:\n        return 'Luxury'\n\ndf['price_category'] = df['price'].apply(custom_price_bin)"
        ]
      ]
    },
    {
      "cell_type": "code",
