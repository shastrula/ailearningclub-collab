        [
          "python",
          "from sklearn.preprocessing import StandardScaler, MinMaxScaler, RobustScaler\n\n# Identify numeric columns to scale\nnumeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()\n\n# StandardScaler: (x - mean) / std. Best for normally distributed data.\nscaler = StandardScaler()\ndf_standard = df.copy()\ndf_standard[numeric_cols] = scaler.fit_transform(df[numeric_cols])\n\n# MinMaxScaler: (x - min) / (max - min). Scales to [0, 1] range.\nminmax_scaler = MinMaxScaler()\ndf_minmax = df.copy()\ndf_minmax[numeric_cols] = minmax_scaler.fit_transform(df[numeric_cols])\n\n# RobustScaler: uses median and IQR. Resistant to outliers.\nrobust_scaler = RobustScaler()\ndf_robust = df.copy()\ndf_robust[numeric_cols] = robust_scaler.fit_transform(df[numeric_cols])\n\nprint(df_standard[numeric_cols].describe())\nprint(df_minmax[numeric_cols].describe())"
        ]
