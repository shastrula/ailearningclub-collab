          "python",
          "import pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import StandardScaler, PolynomialFeatures\nfrom sklearn.compose import ColumnTransformer\n\n# Load example data\ndf = pd.read_csv('house_prices.csv')\n\n# Simple arithmetic features\ndf['price_per_sqft'] = df['price'] / df['sqft']  # Price normalization\ndf['rooms_per_bath'] = df['bedrooms'] / df['bathrooms']\n\n# Aggregation features\ndf['total_rooms'] = df['bedrooms'] + df['bathrooms'] + df['common_rooms']\n\n# Ratio and percentage features\ndf['bathroom_ratio'] = df['bathrooms'] / df['bedrooms']\ndf['age_from_built'] = 2024 - df['year_built']\n\n# Boolean flags (creates categorical features)\ndf['has_garage'] = (df['garage_spaces'] > 0).astype(int)\ndf['is_new_construction'] = (df['year_built'] >= 2020).astype(int)\ndf['is_luxury'] = (df['price'] > df['price'].quantile(0.75)).astype(int)\n\n# Interaction with temporal features\ndf['price_per_year'] = df['price'] / df['age_from_built'].replace(0, 1)\n\nprint(df[['price_per_sqft', 'rooms_per_bath', 'is_new_construction']].head())"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
