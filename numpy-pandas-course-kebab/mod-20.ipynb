        [
          "python",
          "def engineer_features(df, mode='train'):\n    \"\"\"Feature engineering pipeline\"\"\"\n    df = df.copy()\n    \n    # 1. Create new features\n    df['price_per_sqft'] = df['price'] / df['sqft']\n    df['age'] = 2024 - df['year_built']\n    df['total_rooms'] = df['bedrooms'] + df['bathrooms']\n    df['has_garage'] = (df['garage_spaces'] > 0).astype(int)\n    \n    # 2. Bin continuous variables\n    df['age_binned'] = pd.cut(df['age'], bins=5, labels=['Very_New', 'New', 'Medium', 'Old', 'Very_Old'])\n    \n    # 3. Encode categorical variables\n    df_encoded = pd.get_dummies(df[['neighborhood', 'style']], drop_first=True)\n    df = pd.concat([df, df_encoded], axis=1)\n    \n    # 4. Create polynomial features\n    df['sqft_squared'] = df['sqft'] ** 2\n    df['age_squared'] = df['age'] ** 2\n    \n    # 5. Create interactions\n    df['sqft_x_age'] = df['sqft'] * df['age']\n    df['bedrooms_x_bathrooms'] = df['bedrooms'] * df['bathrooms']\n    \n    # 6. Scale numeric features\n    numeric_cols = df.select_dtypes(include=[np.number]).columns\n    scaler = StandardScaler()\n    df[numeric_cols] = scaler.fit_transform(df[numeric_cols])\n    \n    # 7. Drop original non-numeric columns (no longer needed)\n    df = df.drop(['neighborhood', 'style'], axis=1)\n    \n    return df\n\ndf_engineered = engineer_features(df)\nprint(f\"Original: {len(df.columns)} columns \u2192 Engineered: {len(df_engineered.columns)} columns\")"
        ]
      ]
