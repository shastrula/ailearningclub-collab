        [
          "python",
          "# One-hot encoding: creates binary column per category\n# Use when: categories are unordered, relatively few categories\ndf_onehot = pd.get_dummies(\n    df[['neighborhood', 'style']],\n    drop_first=True  # Avoid multicollinearity: drop first category\n)\nprint(df_onehot.head())\n\n# Label encoding: assigns integer to each category\n# Use when: categories are ordinal (ranked)\nfrom sklearn.preprocessing import LabelEncoder\n\nle = LabelEncoder()\ndf['quality_encoded'] = le.fit_transform(df['quality'])\nprint(f\"Quality mapping: {dict(zip(le.classes_, le.transform(le.classes_)))}\")\n\n# Ordinal encoding: explicit ranking\nfrom sklearn.preprocessing import OrdinalEncoder\n\nordinal_enc = OrdinalEncoder(\n    categories=[['Poor', 'Fair', 'Good', 'Excellent']]\n)\ndf['condition_ordinal'] = ordinal_enc.fit_transform(df[['condition']])\n\n# Target encoding: encode based on target variable (powerful but requires care)\n# For regression: mean of target for each category\ntarget_encoding = df.groupby('neighborhood')['price'].mean()\ndf['neighborhood_target'] = df['neighborhood'].map(target_encoding)\n\n# For classification: mean of target (0/1) per category\ndf['quality_target'] = df.groupby('quality')['sold'].transform('mean')\n\n# Frequency encoding: frequency of each category\nfrequency_encoding = df['neighborhood'].value_counts() / len(df)\ndf['neighborhood_freq'] = df['neighborhood'].map(frequency_encoding)\n\nprint(df[['neighborhood_target', 'quality_target', 'neighborhood_freq']].head())"
        ]
      ]
    },
    {
      "cell_type": "code",
