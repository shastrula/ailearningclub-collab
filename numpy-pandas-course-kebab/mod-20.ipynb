        [
          "python",
          "# Manual polynomial features\ndf['sqft_squared'] = df['sqft'] ** 2\ndf['sqft_cubed'] = df['sqft'] ** 3\ndf['age_squared'] = df['age_from_built'] ** 2\n\n# Automated polynomial feature generation\nfrom sklearn.preprocessing import PolynomialFeatures\n\n# Create degree-2 polynomial features\npoly = PolynomialFeatures(degree=2, include_bias=False)\n\n# Select numeric columns for polynomial expansion\nnumeric_cols = df[['sqft', 'age_from_built', 'bedrooms']].values\npoly_features = poly.fit_transform(numeric_cols)\n\n# Convert to DataFrame\nfeature_names = poly.get_feature_names_out(['sqft', 'age', 'bedrooms'])\ndf_poly = pd.DataFrame(poly_features, columns=feature_names)\nprint(df_poly.head())\n\n# Interaction features (degree 2: only interactions, no squares)\nfrom sklearn.preprocessing import PolynomialFeatures\n\npoly_interaction = PolynomialFeatures(degree=2, include_bias=False, \n                                       interaction_only=True)\ninteraction_features = poly_interaction.fit_transform(numeric_cols)\ninteraction_names = poly_interaction.get_feature_names_out(['sqft', 'age', 'bedrooms'])\nprint(interaction_names)"
        ]
      ]
