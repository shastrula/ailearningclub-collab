        [
          "python",
          "from sklearn.feature_extraction.text import TfidfVectorizer, CountVectorizer\nimport re\n\n# Sample text data\ndf['description'] = [\n    'Beautiful house with large garden',\n    'Cozy apartment near downtown',\n    'Luxury penthouse with city views'\n]\n\n# Bag-of-words encoding (Count)\ncount_vec = CountVectorizer(max_features=10, stop_words='english')\nbow_features = count_vec.fit_transform(df['description'])\nbow_df = pd.DataFrame(bow_features.toarray(), columns=count_vec.get_feature_names_out())\nprint(bow_df)\n\n# TF-IDF encoding (Term Frequency-Inverse Document Frequency)\ntfidf_vec = TfidfVectorizer(max_features=10, stop_words='english')\ntfidf_features = tfidf_vec.fit_transform(df['description'])\ntfidf_df = pd.DataFrame(tfidf_features.toarray(), columns=tfidf_vec.get_feature_names_out())\nprint(tfidf_df)\n\n# Text-based features\ndf['description_length'] = df['description'].str.len()\ndf['word_count'] = df['description'].str.split().str.len()\ndf['has_luxury'] = df['description'].str.contains('luxury', case=False).astype(int)\ndf['has_garden'] = df['description'].str.contains('garden', case=False).astype(int)\n\n# Sentiment analysis (requires TextBlob or VADER)\nfrom textblob import TextBlob\n\ndf['sentiment'] = df['description'].apply(lambda x: TextBlob(x).sentiment.polarity)\n\nprint(df[['description_length', 'word_count', 'has_luxury', 'sentiment']].head())"
        ]
