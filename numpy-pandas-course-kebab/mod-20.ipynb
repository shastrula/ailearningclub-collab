        [
          "python",
          "# Manual interaction creation\ndf['sqft_x_age'] = df['sqft'] * df['age_from_built']\ndf['bedrooms_x_bathrooms'] = df['bedrooms'] * df['bathrooms']\ndf['price_x_quality'] = df['price'] / df['quality_encoded']\n\n# Create interactions for grouped variables\nnumeric_features = ['sqft', 'age_from_built', 'bedrooms', 'bathrooms']\nfor i in range(len(numeric_features)):\n    for j in range(i+1, len(numeric_features)):\n        feat1, feat2 = numeric_features[i], numeric_features[j]\n        df[f'{feat1}_x_{feat2}'] = df[feat1] * df[feat2]\n\n# Interaction with categorical (create per-category linear terms)\nfor category in df['neighborhood'].unique():\n    df[f'sqft_in_{category}'] = df['sqft'] * (df['neighborhood'] == category).astype(int)\n\nprint(f\"Created {len(df.columns)} columns including interactions\")"
        ]
      ]
