      "outputs": [],
      "source": [
        [
          "python",
          "\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 Control Plane \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n\u2502  API Server  \u2502  Scheduler           \u2502\n\u2502  etcd        \u2502  Controller Manager  \u2502\n\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n         \u2502\n    \u250c\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2510\n    \u2502  Node 1 \u2502     \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510     \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n    \u2502 \u250c\u2500\u2500\u2500\u2500\u2500\u2510 \u2502     \u2502  Node 2 \u2502     \u2502  Node 3 \u2502\n    \u2502 \u2502Pod A\u2502 \u2502     \u2502 \u250c\u2500\u2500\u2500\u2500\u2500\u2510 \u2502     \u2502 \u250c\u2500\u2500\u2500\u2500\u2500\u2510 \u2502\n    \u2502 \u2502Pod B\u2502 \u2502     \u2502 \u2502Pod C\u2502 \u2502     \u2502 \u2502Pod D\u2502 \u2502\n    \u2502 \u2514\u2500\u2500\u2500\u2500\u2500\u2518 \u2502     \u2502 \u2514\u2500\u2500\u2500\u2500\u2500\u2518 \u2502     \u2502 \u2502Pod E\u2502 \u2502\n    \u2502 kubelet \u2502     \u2502 kubelet \u2502     \u2502 \u2514\u2500\u2500\u2500\u2500\u2500\u2518 \u2502\n    \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518     \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518     \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# pod.yaml - A single pod (rarely used directly)\napiVersion: v1\nkind: Pod\nmetadata:\n  name: nginx\n  labels:\n    app: web\nspec:\n  containers:\n    - name: nginx\n      image: nginx:1.25-alpine\n      ports:\n        - containerPort: 80\n      resources:\n        requests:\n          memory: \"64Mi\"\n          cpu: \"100m\"\n        limits:\n          memory: \"128Mi\"\n          cpu: \"250m\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# deployment.yaml\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: api\n  labels:\n    app: api\nspec:\n  replicas: 3\n  selector:\n    matchLabels:\n      app: api\n  strategy:\n    type: RollingUpdate\n    rollingUpdate:\n      maxSurge: 1\n      maxUnavailable: 0\n  template:\n    metadata:\n      labels:\n        app: api\n    spec:\n      containers:\n        - name: api\n          image: myregistry/api:v1.5.0\n          ports:\n            - containerPort: 8000\n          env:\n            - name: DATABASE_URL\n              valueFrom:\n                secretKeyRef:\n                  name: db-credentials\n                  key: url\n          readinessProbe:\n            httpGet:\n              path: /health\n              port: 8000\n            initialDelaySeconds: 5\n            periodSeconds: 10\n          livenessProbe:\n            httpGet:\n              path: /health\n              port: 8000\n            initialDelaySeconds: 15\n            periodSeconds: 20\n          resources:\n            requests:\n              memory: \"256Mi\"\n              cpu: \"250m\"\n            limits:\n              memory: \"512Mi\"\n              cpu: \"500m\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# service.yaml\napiVersion: v1\nkind: Service\nmetadata:\n  name: api\nspec:\n  selector:\n    app: api\n  ports:\n    - port: 80\n      targetPort: 8000\n  type: ClusterIP  # Internal only (use Ingress for external)\n---\n# Ingress - External HTTP routing\napiVersion: networking.k8s.io/v1\nkind: Ingress\nmetadata:\n  name: api-ingress\n  annotations:\n    cert-manager.io/cluster-issuer: letsencrypt\nspec:\n  tls:\n    - hosts: [api.example.com]\n      secretName: api-tls\n  rules:\n    - host: api.example.com\n      http:\n        paths:\n          - path: /\n            pathType: Prefix\n            backend:\n              service:\n                name: api\n                port:\n                  number: 80"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# configmap.yaml\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: app-config\ndata:\n  LOG_LEVEL: \"info\"\n  FEATURE_FLAGS: '{\"new_ui\": true, \"beta_api\": false}'\n---\n# secret.yaml (values are base64 encoded)\napiVersion: v1\nkind: Secret\nmetadata:\n  name: db-credentials\ntype: Opaque\ndata:\n  url: cG9zdGdyZXM6Ly91c2VyOnBhc3NAZGIvYXBw  # base64"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Cluster info\nkubectl cluster-info\nkubectl get nodes\n\n# Deployments\nkubectl apply -f deployment.yaml\nkubectl get deployments\nkubectl rollout status deployment/api\nkubectl rollout undo deployment/api          # rollback!\n\n# Pods\nkubectl get pods -o wide\nkubectl describe pod <pod-name>\nkubectl logs <pod-name> -f                   # follow logs\nkubectl exec -it <pod-name> -- /bin/bash     # shell into pod\n\n# Scaling\nkubectl scale deployment/api --replicas=5\nkubectl autoscale deployment/api --min=2 --max=10 --cpu-percent=70\n\n# Debugging\nkubectl get events --sort-by=.lastTimestamp\nkubectl top pods                             # resource usage\nkubectl port-forward svc/api 8080:80         # local access"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Isolate environments\nkubectl create namespace staging\nkubectl create namespace production\n\n# Deploy to specific namespace\nkubectl apply -f deployment.yaml -n staging\n\n# Set default namespace\nkubectl config set-context --current --namespace=staging"
        ]
      ]
    }
  ],
