      "source": [
        "# Devops Platform Engineering - mod-2\n\n",
        "**Course:** devops-platform-engineering\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# File operations\nls -la                    # list with permissions\nfind . -name \"*.yaml\"     # find files\ngrep -r \"apiVersion\" .    # search content recursively\ntail -f /var/log/syslog   # follow logs in real time\n\n# Process management\nps aux | grep nginx       # find processes\nkill -9 <PID>             # force kill\nsystemctl status nginx    # service status\njournalctl -u nginx -f    # service logs\n\n# Networking\ncurl -s http://localhost:8080/health  # HTTP request\nnetstat -tlnp             # listening ports\ndig example.com           # DNS lookup\nss -tunlp                 # socket statistics"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "#!/bin/bash\nset -euo pipefail\n\n# Variables\nENV=\"${1:-staging}\"       # first arg, default \"staging\"\nTIMESTAMP=$(date +%Y%m%d_%H%M%S)\n\n# Conditionals\nif [[ \"$ENV\" == \"production\" ]]; then\n    echo \"\u26a0\ufe0f  Production deployment - are you sure?\"\n    read -p \"Type 'yes' to continue: \" confirm\n    [[ \"$confirm\" != \"yes\" ]] && exit 1\nfi\n\n# Loops\nSERVICES=(\"api\" \"worker\" \"scheduler\")\nfor svc in \"${SERVICES[@]}\"; do\n    echo \"Deploying $svc to $ENV...\"\n    kubectl rollout restart deployment/$svc -n $ENV\ndone"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Retry with exponential backoff\nretry() {\n    local max_attempts=5\n    local attempt=1\n    local delay=1\n    \n    until \"$@\"; do\n        if (( attempt >= max_attempts )); then\n            echo \"\u274c Failed after $max_attempts attempts\"\n            return 1\n        fi\n        echo \"\u23f3 Attempt $attempt failed, retrying in ${delay}s...\"\n        sleep $delay\n        attempt=$((attempt + 1))\n        delay=$((delay * 2))\n    done\n}\n\n# Usage: retry curl -f http://myservice/health"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Count HTTP status codes from nginx logs\nawk '{print $9}' /var/log/nginx/access.log | sort | uniq -c | sort -rn\n\n# Find slow requests (>1s)\nawk '$NF > 1.0 {print $7, $NF\"s\"}' /var/log/nginx/access.log\n\n# Monitor error rate\nwatch -n5 'grep -c \"ERROR\" /var/log/app.log'"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Permission format: rwxrwxrwx (owner/group/other)\nchmod 755 deploy.sh       # rwxr-xr-x (owner: full, others: read+execute)\nchmod 600 secrets.env     # rw------- (only owner can read)\nchown app:app /var/www    # change ownership\n\n# SSH key management\nssh-keygen -t ed25519 -C \"devops@company.com\"\nssh-copy-id user@server"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "#!/bin/bash\n# healthcheck.sh - Monitor services and alert on failures\n\nSERVICES=(\n    \"http://api.internal:8080/health\"\n    \"http://worker.internal:8081/health\"\n    \"http://db.internal:5432\"\n)\n\ncheck_service() {\n    local url=$1\n    local status=$(curl -s -o /dev/null -w \"%{http_code}\" --max-time 5 \"$url\" 2>/dev/null)\n    \n    if [[ \"$status\" == \"200\" ]] || [[ \"$status\" == \"000\" && \"$url\" == *\"5432\"* ]]; then\n        echo \"\u2705 $url\"\n        return 0\n    else\n        echo \"\u274c $url (HTTP $status)\"\n        return 1\n    fi\n}\n\nfailed=0\nfor svc in \"${SERVICES[@]}\"; do\n    check_service \"$svc\" || ((failed++))\ndone\n\nif (( failed > 0 )); then\n    echo \"\u26a0\ufe0f  $failed service(s) unhealthy!\"\n    exit 1\nfi\necho \"All services healthy \u2713\""
        ]
      ]
    }
