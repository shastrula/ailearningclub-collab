      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Devops Platform Engineering - mod-6\n\n",
        "**Course:** devops-platform-engineering\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# ClusterIP (internal only \u2014 default)\napiVersion: v1\nkind: Service\nmetadata:\n  name: backend\nspec:\n  type: ClusterIP\n  selector:\n    app: backend\n  ports:\n    - port: 80\n      targetPort: 8000\n---\n# NodePort (expose on every node's IP)\napiVersion: v1\nkind: Service\nmetadata:\n  name: backend-nodeport\nspec:\n  type: NodePort\n  selector:\n    app: backend\n  ports:\n    - port: 80\n      targetPort: 8000\n      nodePort: 30080   # accessible at <any-node-ip>:30080\n---\n# LoadBalancer (cloud provider creates an LB)\napiVersion: v1\nkind: Service\nmetadata:\n  name: backend-lb\n  annotations:\n    service.beta.kubernetes.io/aws-load-balancer-type: nlb\nspec:\n  type: LoadBalancer\n  selector:\n    app: backend\n  ports:\n    - port: 443\n      targetPort: 8000"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# Ingress with path-based routing\napiVersion: networking.k8s.io/v1\nkind: Ingress\nmetadata:\n  name: app-ingress\n  annotations:\n    nginx.ingress.kubernetes.io/rate-limit: \"100\"\n    cert-manager.io/cluster-issuer: letsencrypt-prod\nspec:\n  ingressClassName: nginx\n  tls:\n    - hosts: [\"app.example.com\"]\n      secretName: app-tls\n  rules:\n    - host: app.example.com\n      http:\n        paths:\n          - path: /api\n            pathType: Prefix\n            backend:\n              service:\n                name: api\n                port:\n                  number: 80\n          - path: /\n            pathType: Prefix\n            backend:\n              service:\n                name: frontend\n                port:\n                  number: 80"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# Only allow traffic from frontend to backend\napiVersion: networking.k8s.io/v1\nkind: NetworkPolicy\nmetadata:\n  name: backend-policy\nspec:\n  podSelector:\n    matchLabels:\n      app: backend\n  policyTypes:\n    - Ingress\n  ingress:\n    - from:\n        - podSelector:\n            matchLabels:\n              app: frontend\n      ports:\n        - port: 8000\n          protocol: TCP"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# Istio VirtualService \u2014 traffic splitting (canary deploy)\napiVersion: networking.istio.io/v1beta1\nkind: VirtualService\nmetadata:\n  name: api\nspec:\n  hosts:\n    - api\n  http:\n    - route:\n        - destination:\n            host: api\n            subset: stable\n          weight: 90\n        - destination:\n            host: api\n            subset: canary\n          weight: 10\n---\napiVersion: networking.istio.io/v1beta1\nkind: DestinationRule\nmetadata:\n  name: api\nspec:\n  host: api\n  subsets:\n    - name: stable\n      labels:\n        version: v1\n    - name: canary\n      labels:\n        version: v2"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Service DNS format: <service>.<namespace>.svc.cluster.local\n# From any pod:\ncurl http://backend.default.svc.cluster.local\ncurl http://postgres.database.svc.cluster.local:5432\n\n# Short form (same namespace):\ncurl http://backend"
        ]
      ]
    }
  ],
