{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Devops Platform Engineering - mod-10\n\n",
        "**Course:** devops-platform-engineering\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "terraform init      # download providers\nterraform plan      # preview changes\nterraform apply     # create/update infrastructure\nterraform destroy   # tear down everything"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "hcl",
          "# providers.tf\nterraform {\n  required_providers {\n    aws = {\n      source  = \"hashicorp/aws\"\n      version = \"~> 5.0\"\n    }\n  }\n  backend \"s3\" {\n    bucket = \"my-terraform-state\"\n    key    = \"production/terraform.tfstate\"\n    region = \"us-east-1\"\n  }\n}\n\nprovider \"aws\" {\n  region = \"us-east-1\"\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "hcl",
          "# vpc.tf\nmodule \"vpc\" {\n  source  = \"terraform-aws-modules/vpc/aws\"\n  version = \"~> 5.0\"\n\n  name = \"production\"\n  cidr = \"10.0.0.0/16\"\n\n  azs             = [\"us-east-1a\", \"us-east-1b\", \"us-east-1c\"]\n  private_subnets = [\"10.0.1.0/24\", \"10.0.2.0/24\", \"10.0.3.0/24\"]\n  public_subnets  = [\"10.0.101.0/24\", \"10.0.102.0/24\", \"10.0.103.0/24\"]\n\n  enable_nat_gateway   = true\n  single_nat_gateway   = false  # one per AZ for HA\n  enable_dns_hostnames = true\n\n  public_subnet_tags = {\n    \"kubernetes.io/role/elb\" = 1\n  }\n  private_subnet_tags = {\n    \"kubernetes.io/role/internal-elb\" = 1\n  }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "hcl",
          "# rds.tf - Database\nresource \"aws_db_instance\" \"main\" {\n  identifier     = \"production-db\"\n  engine         = \"postgres\"\n  engine_version = \"16.1\"\n  instance_class = \"db.r6g.large\"\n  \n  allocated_storage     = 100\n  max_allocated_storage = 500  # auto-scale storage\n  storage_encrypted     = true\n\n  db_name  = \"app\"\n  username = \"admin\"\n  password = var.db_password  # from secrets\n\n  multi_az               = true\n  db_subnet_group_name   = aws_db_subnet_group.main.name\n  vpc_security_group_ids = [aws_security_group.db.id]\n\n  backup_retention_period = 7\n  skip_final_snapshot     = false\n  final_snapshot_identifier = \"production-db-final\"\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "hcl",
          "# modules/microservice/main.tf\nvariable \"name\" {}\nvariable \"image\" {}\nvariable \"port\" { default = 8000 }\nvariable \"replicas\" { default = 2 }\nvariable \"cpu\" { default = \"250m\" }\nvariable \"memory\" { default = \"512Mi\" }\n\nresource \"kubernetes_deployment\" \"this\" {\n  metadata {\n    name = var.name\n    labels = { app = var.name }\n  }\n  spec {\n    replicas = var.replicas\n    selector { match_labels = { app = var.name } }\n    template {\n      metadata { labels = { app = var.name } }\n      spec {\n        container {\n          name  = var.name\n          image = var.image\n          port { container_port = var.port }\n          resources {\n            requests = { cpu = var.cpu, memory = var.memory }\n            limits   = { cpu = var.cpu, memory = var.memory }\n          }\n        }\n      }\n    }\n  }\n}\n\nresource \"kubernetes_service\" \"this\" {\n  metadata { name = var.name }\n  spec {\n    selector = { app = var.name }\n    port { port = 80; target_port = var.port }\n  }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "hcl",
          "# Usage: deploy multiple services consistently\nmodule \"api\" {\n  source   = \"./modules/microservice\"\n  name     = \"api\"\n  image    = \"myregistry/api:v1.5\"\n  replicas = 3\n  cpu      = \"500m\"\n  memory   = \"1Gi\"\n}\n\nmodule \"worker\" {\n  source   = \"./modules/microservice\"\n  name     = \"worker\"\n  image    = \"myregistry/worker:v1.5\"\n  replicas = 2\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "hcl",
          "# Remote state with locking (prevents concurrent modifications)\nterraform {\n  backend \"s3\" {\n    bucket         = \"company-terraform-state\"\n    key            = \"production/infra.tfstate\"\n    region         = \"us-east-1\"\n    dynamodb_table = \"terraform-locks\"\n    encrypt        = true\n  }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Import existing resources into Terraform\nterraform import aws_instance.web i-1234567890abcdef0\n\n# Target specific resources\nterraform apply -target=module.api\n\n# Workspace for multiple environments\nterraform workspace new staging\nterraform workspace select production"
        ]
      ]
    }
  ],
