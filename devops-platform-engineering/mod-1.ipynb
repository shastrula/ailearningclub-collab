          "yaml",
          "# A typical modern DevOps stack\nversion_control: Git (GitHub/GitLab)\nci_cd: GitHub Actions / GitLab CI / Jenkins\ncontainers: Docker\norchestration: Kubernetes (EKS/AKS/GKE)\niac: Terraform / Pulumi\nmonitoring: Prometheus + Grafana\nlogging: ELK Stack / Loki\nsecrets: Vault / AWS Secrets Manager"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "#!/bin/bash\n# deploy.sh - Simple deployment script\n\nset -euo pipefail  # Exit on error, undefined vars, pipe failures\n\nAPP_NAME=\"myapp\"\nIMAGE_TAG=$(git rev-parse --short HEAD)\n\necho \"\ud83d\udd28 Building $APP_NAME:$IMAGE_TAG...\"\ndocker build -t $APP_NAME:$IMAGE_TAG .\n\necho \"\ud83e\uddea Running tests...\"\ndocker run --rm $APP_NAME:$IMAGE_TAG pytest tests/\n\necho \"\ud83d\udce6 Pushing image...\"\ndocker tag $APP_NAME:$IMAGE_TAG registry.example.com/$APP_NAME:$IMAGE_TAG\ndocker push registry.example.com/$APP_NAME:$IMAGE_TAG\n\necho \"\ud83d\ude80 Deploying...\"\nkubectl set image deployment/$APP_NAME app=$APP_NAME:$IMAGE_TAG\n\necho \"\u2705 Deployed $APP_NAME:$IMAGE_TAG\""
        ]
      ]
    }
