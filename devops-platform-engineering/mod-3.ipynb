      "source": [
        "# Devops Platform Engineering - mod-3\n\n",
        "**Course:** devops-platform-engineering\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "dockerfile",
          "# Multi-stage build: small final image\nFROM python:3.11-slim AS builder\nWORKDIR /app\nCOPY requirements.txt .\nRUN pip install --no-cache-dir --prefix=/install -r requirements.txt\n\nFROM python:3.11-slim\nWORKDIR /app\nCOPY --from=builder /install /usr/local\nCOPY . .\n\n# Non-root user (security)\nRUN useradd -r appuser && chown -R appuser /app\nUSER appuser\n\nEXPOSE 8000\nHEALTHCHECK --interval=30s --timeout=3s \\\n    CMD curl -f http://localhost:8000/health || exit 1\n\nCMD [\"uvicorn\", \"main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8000\"]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Build\ndocker build -t myapp:v1.2 .\ndocker build -t myapp:v1.2 --no-cache .     # force rebuild\n\n# Run\ndocker run -d --name myapp -p 8080:8000 myapp:v1.2\ndocker run -it --rm myapp:v1.2 /bin/bash     # interactive shell\ndocker run -d --env-file .env myapp:v1.2     # with env vars\n\n# Inspect and debug\ndocker ps                           # running containers\ndocker logs -f myapp                # follow logs\ndocker exec -it myapp /bin/bash     # shell into running container\ndocker stats                        # resource usage\n\n# Images\ndocker images                       # list images\ndocker image prune -a               # remove unused images\ndocker tag myapp:v1.2 registry.io/myapp:v1.2\ndocker push registry.io/myapp:v1.2"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# docker-compose.yml\nversion: '3.8'\n\nservices:\n  api:\n    build: .\n    ports:\n      - \"8080:8000\"\n    environment:\n      - DATABASE_URL=postgresql://postgres:secret@db:5432/app\n      - REDIS_URL=redis://cache:6379\n    depends_on:\n      db:\n        condition: service_healthy\n    volumes:\n      - .:/app  # hot reload for development\n\n  db:\n    image: postgres:16-alpine\n    environment:\n      POSTGRES_PASSWORD: secret\n      POSTGRES_DB: app\n    volumes:\n      - pgdata:/var/lib/postgresql/data\n    healthcheck:\n      test: [\"CMD-SHELL\", \"pg_isready -U postgres\"]\n      interval: 5s\n      timeout: 3s\n      retries: 5\n\n  cache:\n    image: redis:7-alpine\n    ports:\n      - \"6379:6379\"\n\nvolumes:\n  pgdata:"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Compose commands\ndocker compose up -d            # start all services\ndocker compose logs -f api      # follow api logs\ndocker compose down -v          # stop and remove volumes\ndocker compose exec api bash    # shell into api container"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "dockerfile",
          "# Bad: 1.2GB image\nFROM python:3.11\nCOPY . .\nRUN pip install -r requirements.txt\n\n# Good: 150MB image\nFROM python:3.11-slim\nCOPY requirements.txt .\nRUN pip install --no-cache-dir -r requirements.txt\nCOPY . .\n\n# Better: 85MB with multi-stage\nFROM python:3.11-slim AS build\nRUN pip install --no-cache-dir --target=/deps -r requirements.txt\n\nFROM python:3.11-slim\nCOPY --from=build /deps /usr/local/lib/python3.11/site-packages\nCOPY app/ /app/\nCMD [\"python\", \"-m\", \"app.main\"]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Scan for vulnerabilities\ndocker scout cves myapp:v1.2\ntrivy image myapp:v1.2\n\n# Run as non-root (in Dockerfile)\nUSER 1000:1000\n\n# Read-only filesystem\ndocker run --read-only --tmpfs /tmp myapp:v1.2\n\n# Resource limits\ndocker run --memory=512m --cpus=1.0 myapp:v1.2"
        ]
      ]
    }
