      "outputs": [],
      "source": [
        [
          "python",
          "import pandas as pd\nimport numpy as np\n\n# Load a built-in dataset (no download needed)\nfrom sklearn.datasets import fetch_california_housing\n\nhousing = fetch_california_housing(as_frame=True)\ndf = housing.frame\nprint(f\"Shape: {df.shape}\")  # (20640, 9)\nprint(f\"Columns: {list(df.columns)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# First look\nprint(df.head())       # first 5 rows\nprint(df.info())       # column types, non-null counts\nprint(df.describe())   # statistics for each column\n\n# Quick questions:\nprint(f\"Rows: {len(df)}\")\nprint(f\"Columns: {df.shape[1]}\")\nprint(f\"Any nulls? {df.isnull().sum().sum()}\")\nprint(f\"Target range: ${df['MedHouseVal'].min():.0f}k - ${df['MedHouseVal'].max():.0f}k\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Select columns\nprices = df[\"MedHouseVal\"]\nsubset = df[[\"MedInc\", \"AveRooms\", \"MedHouseVal\"]]\n\n# Filter rows\nexpensive = df[df[\"MedHouseVal\"] > 4.0]\nprint(f\"Expensive homes: {len(expensive)} ({len(expensive)/len(df)*100:.1f}%)\")\n\n# Multiple conditions\nbay_area = df[(df[\"Latitude\"] > 37) & (df[\"Latitude\"] < 38) & (df[\"Longitude\"] > -123)]\nprint(f\"Bay Area homes: {len(bay_area)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Column statistics\nprint(f\"Median income: ${df['MedInc'].median():.2f} (x$10k)\")\nprint(f\"Average rooms: {df['AveRooms'].mean():.1f}\")\nprint(f\"Price std dev: ${df['MedHouseVal'].std():.2f} ($100k)\")\n\n# Correlation (how features relate to price)\ncorrelations = df.corr()[\"MedHouseVal\"].sort_values(ascending=False)\nprint(\"\\nCorrelation with house price:\")\nprint(correlations)\n# MedInc (income) has highest correlation \u2192 makes sense!"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Create age bins\ndf[\"age_group\"] = pd.cut(df[\"HouseAge\"], bins=[0, 10, 20, 30, 52], \n                         labels=[\"New\", \"Recent\", \"Established\", \"Old\"])\n\n# Average price by age group\nsummary = df.groupby(\"age_group\")[\"MedHouseVal\"].agg([\"mean\", \"count\"])\nprint(summary)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Save to CSV\ndf.to_csv(\"housing_data.csv\", index=False)\n\n# Load it back\ndf_loaded = pd.read_csv(\"housing_data.csv\")\nprint(f\"Loaded {len(df_loaded)} rows \u2713\")\n\n# Save a subset\nexpensive.to_csv(\"expensive_homes.csv\", index=False)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def data_report(df):\n    \"\"\"Generate a quick summary of any DataFrame.\"\"\"\n    print(\"=\" * 50)\n    print(f\"DATASET REPORT\")\n    print(\"=\" * 50)\n    print(f\"Shape: {df.shape[0]} rows \u00d7 {df.shape[1]} columns\")\n    print(f\"Memory: {df.memory_usage(deep=True).sum() / 1e6:.1f} MB\")\n    print(f\"\\nColumn Types:\")\n    print(f\"  Numeric: {len(df.select_dtypes(include=[np.number]).columns)}\")\n    print(f\"  Object:  {len(df.select_dtypes(include=['object']).columns)}\")\n    print(f\"\\nMissing Values: {df.isnull().sum().sum()}\")\n    print(f\"\\nNumeric Summary:\")\n    print(df.describe().round(2))\n\ndata_report(df)"
        ]
      ]
    }
