          "# Create\nscores = [85, 92, 78, 95, 88]\nfeatures = [\"age\", \"income\", \"credit_score\"]\n\n# Access\nprint(scores[0])     # 85 (first)\nprint(scores[-1])    # 88 (last)\nprint(scores[1:3])   # [92, 78] (slice)\n\n# Modify\nscores.append(91)    # add to end\nscores.sort()        # sort in place\n\n# Useful operations\nprint(len(scores))   # 6\nprint(sum(scores))   # 529\nprint(max(scores))   # 95"
