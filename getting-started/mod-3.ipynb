          "python",
          "# Transform data in one line\nnumbers = [1, 2, 3, 4, 5]\nsquared = [x**2 for x in numbers]           # [1, 4, 9, 16, 25]\nevens = [x for x in numbers if x % 2 == 0]  # [2, 4]\n\n# Real ML example: normalize features\nraw = [100, 200, 150, 300, 250]\nmin_val, max_val = min(raw), max(raw)\nnormalized = [(x - min_val) / (max_val - min_val) for x in raw]\n# [0.0, 0.5, 0.25, 1.0, 0.75]"
