  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Getting Started - mod-9\n\n",
        "**Course:** getting-started\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Configure Git (one time)\ngit config --global user.name \"Your Name\"\ngit config --global user.email \"you@example.com\"\n\n# Create a new project\nmkdir my-ml-project && cd my-ml-project\ngit init"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# 1. Make changes (edit files, write code)\n# 2. Stage changes (tell Git what to include)\ngit add model.py data_prep.py\n\n# 3. Commit (save a snapshot with a message)\ngit commit -m \"Add baseline random forest model\"\n\n# Shortcut: stage all changed files\ngit add .\ngit commit -m \"Update preprocessing pipeline\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Check status (what's changed?)\ngit status\n\n# See what you changed\ngit diff\n\n# View history\ngit log --oneline\n\n# Undo changes to a file (before staging)\ngit checkout -- model.py\n\n# Undo last commit (keep changes)\ngit reset --soft HEAD~1"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# .gitignore \u2014 files Git should NOT track\n# Data files (too large for Git)\ndata/\n*.csv\n*.parquet\n*.h5\n\n# Model files\nmodels/\n*.pkl\n*.pt\n*.onnx\n\n# Environment\n.venv/\n__pycache__/\n*.pyc\n\n# Jupyter checkpoints\n.ipynb_checkpoints/\n\n# OS files\n.DS_Store\nThumbs.db\n\n# Secrets\n.env\ncredentials.json"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# 1. Create a repo on github.com (don't add README)\n# 2. Connect your local repo:\ngit remote add origin https://github.com/yourusername/my-ml-project.git\n\n# 3. Push\ngit push -u origin main\n\n# Future pushes:\ngit push"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Tag model versions\ngit tag -a v1.0 -m \"Baseline model: R\u00b2=0.85\"\ngit tag -a v1.1 -m \"Feature engineering: R\u00b2=0.91\"\n\n# Branch for experiments\ngit checkout -b experiment/xgboost\n# ... try things ...\ngit checkout main  # back to main if it didn't work\n\n# Track experiment configs (not data/models)\n# Good: commit hyperparameters, metrics, code\n# Bad: commit 500MB model file or 2GB dataset"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "my-ml-project/\n\u251c\u2500\u2500 .gitignore\n\u251c\u2500\u2500 README.md\n\u251c\u2500\u2500 requirements.txt      # pip freeze > requirements.txt\n\u251c\u2500\u2500 data/                  # .gitignored (use DVC or S3 for large data)\n\u2502   \u2514\u2500\u2500 README.md         # describe where to get the data\n\u251c\u2500\u2500 notebooks/\n\u2502   \u251c\u2500\u2500 01_exploration.ipynb\n\u2502   \u2514\u2500\u2500 02_modeling.ipynb\n\u251c\u2500\u2500 src/\n\u2502   \u251c\u2500\u2500 data_prep.py\n\u2502   \u251c\u2500\u2500 train.py\n\u2502   \u2514\u2500\u2500 evaluate.py\n\u2514\u2500\u2500 models/               # .gitignored\n    \u2514\u2500\u2500 README.md         # describe how to train"
        ]
      ]
    }
  ],
