      "source": [
        "# Getting Started - mod-5\n\n",
        "**Course:** getting-started\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\nfrom sklearn.datasets import fetch_california_housing\n\n# Load data\ndf = fetch_california_housing(as_frame=True).frame"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Does income correlate with house price?\nplt.figure(figsize=(8, 5))\nplt.scatter(df[\"MedInc\"], df[\"MedHouseVal\"], alpha=0.1, s=5)\nplt.xlabel(\"Median Income ($10k)\")\nplt.ylabel(\"Median House Value ($100k)\")\nplt.title(\"Income vs House Price\")\nplt.grid(alpha=0.3)\nplt.tight_layout()\nplt.show()\n# Clear positive correlation!"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# How are house prices distributed?\nplt.figure(figsize=(8, 4))\nplt.hist(df[\"MedHouseVal\"], bins=50, edgecolor=\"black\", alpha=0.7, color=\"steelblue\")\nplt.axvline(df[\"MedHouseVal\"].median(), color=\"red\", linestyle=\"--\", label=f\"Median: ${df['MedHouseVal'].median():.2f}\")\nplt.xlabel(\"Median House Value ($100k)\")\nplt.ylabel(\"Count\")\nplt.title(\"Distribution of House Prices\")\nplt.legend()\nplt.tight_layout()\nplt.show()\n# Notice: capped at $5.0 (data limit)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Simulated training progress\nepochs = range(1, 21)\ntrain_loss = [1.0 * 0.85**i + np.random.normal(0, 0.02) for i in epochs]\nval_loss = [1.1 * 0.87**i + np.random.normal(0, 0.03) for i in epochs]\n\nplt.figure(figsize=(8, 4))\nplt.plot(epochs, train_loss, 'b-', label='Training Loss', linewidth=2)\nplt.plot(epochs, val_loss, 'r--', label='Validation Loss', linewidth=2)\nplt.xlabel(\"Epoch\")\nplt.ylabel(\"Loss\")\nplt.title(\"Model Training Progress\")\nplt.legend()\nplt.grid(alpha=0.3)\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "fig, axes = plt.subplots(2, 2, figsize=(10, 8))\n\n# Top-left: scatter\naxes[0,0].scatter(df[\"MedInc\"], df[\"MedHouseVal\"], alpha=0.1, s=3)\naxes[0,0].set_title(\"Income vs Price\")\n\n# Top-right: histogram\naxes[0,1].hist(df[\"HouseAge\"], bins=30, color=\"green\", alpha=0.7)\naxes[0,1].set_title(\"House Age Distribution\")\n\n# Bottom-left: correlation\naxes[1,0].scatter(df[\"AveRooms\"], df[\"MedHouseVal\"], alpha=0.1, s=3)\naxes[1,0].set_title(\"Rooms vs Price\")\naxes[1,0].set_xlim(0, 15)\n\n# Bottom-right: geographic\naxes[1,1].scatter(df[\"Longitude\"], df[\"Latitude\"], c=df[\"MedHouseVal\"], \n                  cmap=\"RdYlGn\", alpha=0.1, s=3)\naxes[1,1].set_title(\"Price by Location\")\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Feature importance (we'll compute this for real in module 6)\nfeatures = [\"MedInc\", \"AveOccup\", \"Latitude\", \"Longitude\", \"HouseAge\"]\nimportance = [0.52, 0.15, 0.12, 0.11, 0.06]\n\nplt.figure(figsize=(8, 4))\nplt.barh(features, importance, color=\"teal\")\nplt.xlabel(\"Importance Score\")\nplt.title(\"Which Features Matter Most?\")\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Save for reports or presentations\nfig, ax = plt.subplots(figsize=(8, 5))\nax.scatter(df[\"MedInc\"], df[\"MedHouseVal\"], alpha=0.1, s=5)\nax.set_xlabel(\"Median Income\")\nax.set_ylabel(\"House Value\")\nax.set_title(\"California Housing\")\n\nplt.savefig(\"housing_scatter.png\", dpi=150, bbox_inches=\"tight\")\nprint(\"Saved housing_scatter.png \u2713\")"
        ]
      ]
    }
