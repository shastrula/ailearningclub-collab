      "source": [
        [
          "python",
          "p_pool = (n\u2081 + n\u2082) / (N\u2081 + N\u2082)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "z = (p\u2081 - p\u2082) / sqrt(p_pool * (1 - p_pool) * (1/N\u2081 + 1/N\u2082))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy import stats\n\n# A/B test data\ncontrol_conversions, control_total = 450, 5000\ntreatment_conversions, treatment_total = 520, 5000\n\n# Calculate proportions\np1 = control_conversions / control_total\np2 = treatment_conversions / treatment_total\n\n# Pooled proportion under null hypothesis\np_pool = (control_conversions + treatment_conversions) / (control_total + treatment_total)\n\n# Standard error\nse = np.sqrt(p_pool * (1 - p_pool) * (1/control_total + 1/treatment_total))\n\n# Z-statistic\nz_stat = (p2 - p1) / se\n\n# Two-tailed p-value\np_value = 2 * (1 - stats.norm.cdf(abs(z_stat)))\n\nprint(f\"Control conversion rate: {p1:.4f}\")\nprint(f\"Treatment conversion rate: {p2:.4f}\")\nprint(f\"Z-statistic: {z_stat:.4f}\")\nprint(f\"P-value: {p_value:.4f}\")\nprint(f\"Significant at \u03b1=0.05: {p_value < 0.05}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from statsmodels.stats.proportion import proportions_ztest\n\n# Counts and totals\ncount = np.array([treatment_conversions, control_conversions])\nnobs = np.array([treatment_total, control_total])\n\nz_stat, p_value = proportions_ztest(count, nobs)\nprint(f\"Z-statistic: {z_stat:.4f}, P-value: {p_value:.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "t = (\u03bc\u2081 - \u03bc\u2082) / sqrt(s\u2081\u00b2/n\u2081 + s\u2082\u00b2/n\u2082)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.stats import ttest_ind\n\n# Sample data: revenue per user\ncontrol_revenue = np.array([12.5, 15.3, 11.2, 14.8, 13.1, 16.2, 12.9, 14.5])\ntreatment_revenue = np.array([15.8, 17.2, 16.1, 18.3, 19.1, 17.5, 16.8, 18.9])\n\n# Perform independent t-test (Welch's by default in scipy)\nt_stat, p_value = ttest_ind(treatment_revenue, control_revenue)\n\nprint(f\"Control mean: ${control_revenue.mean():.2f} (SD: {control_revenue.std():.2f})\")\nprint(f\"Treatment mean: ${treatment_revenue.mean():.2f} (SD: {treatment_revenue.std():.2f})\")\nprint(f\"Mean difference: ${treatment_revenue.mean() - control_revenue.mean():.2f}\")\nprint(f\"T-statistic: {t_stat:.4f}\")\nprint(f\"P-value: {p_value:.4f}\")\nprint(f\"Significant: {p_value < 0.05}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "CI = (p\u2081 - p\u2082) \u00b1 z\u2080.\u2080\u2082\u2085 * sqrt(p\u2081(1-p\u2081)/n\u2081 + p\u2082(1-p\u2082)/n\u2082)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "CI = (\u03bc\u2081 - \u03bc\u2082) \u00b1 t\u2080.\u2080\u2082\u2085 * sqrt(s\u2081\u00b2/n\u2081 + s\u2082\u00b2/n\u2082)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from scipy import stats\nimport numpy as np\n\n# Proportion CI example\ncontrol_conv, control_n = 450, 5000\ntreatment_conv, treatment_n = 520, 5000\n\np1 = control_conv / control_n\np2 = treatment_conv / treatment_n\ndiff = p2 - p1\n\nse = np.sqrt(p1*(1-p1)/control_n + p2*(1-p2)/treatment_n)\nz_crit = 1.96\n\nci_lower = diff - z_crit * se\nci_upper = diff + z_crit * se\n\nprint(f\"Treatment lift: {diff:.4f} ({diff*100:.2f}%)\")\nprint(f\"95% CI: [{ci_lower:.4f}, {ci_upper:.4f}]\")\nprint(f\"Includes zero: {ci_lower <= 0 <= ci_upper}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
