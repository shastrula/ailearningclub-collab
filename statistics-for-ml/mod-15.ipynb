        [
          "python",
          "h = 2 * arcsin(sqrt(p\u2082)) - 2 * arcsin(sqrt(p\u2081))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "d = (\u03bc\u2081 - \u03bc\u2082) / sqrt((s\u2081\u00b2 + s\u2082\u00b2)/2)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom math import asin, sqrt\n\n# Cohen's h for proportions\np1, p2 = 0.09, 0.104  # 9% vs 10.4%\ncohens_h = 2 * (asin(sqrt(p2)) - asin(sqrt(p1)))\n\nprint(f\"Cohen's h: {cohens_h:.4f}\")\nprint(f\"Effect size: {'Small' if abs(cohens_h) < 0.2 else 'Medium' if abs(cohens_h) < 0.5 else 'Large'}\")\n\n# Cohen's d for means\ncontrol_mean, control_std = 14.1, 1.9\ntreatment_mean, treatment_std = 17.3, 1.8\n\npooled_std = sqrt((control_std**2 + treatment_std**2) / 2)\ncohens_d = (treatment_mean - control_mean) / pooled_std\n\nprint(f\"Cohen's d: {cohens_d:.4f}\")\nprint(f\"Effect size: {'Small' if abs(cohens_d) < 0.2 else 'Medium' if abs(cohens_d) < 0.5 else 'Large'}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from statsmodels.stats.power import proportions_ztest\nfrom scipy.stats import norm\n\n# Power analysis for proportions\neffect_size = 0.02  # 2% absolute lift\nalpha = 0.05\npower = 0.80  # Standard choice\nbaseline = 0.10  # 10% baseline\n\n# Compute required sample size\nfrom statsmodels.stats.proportion import proportions_ztest\n# For quick MDE calculation:\nz_alpha = norm.ppf(1 - alpha/2)  # 1.96 for two-tailed\nz_beta = norm.ppf(power)  # 0.84 for 80% power\n\np1 = baseline\np2 = baseline + effect_size\npooled_p = (p1 + p2) / 2\n\nn_required = ((z_alpha + z_beta)**2 * 2 * pooled_p * (1 - pooled_p)) / effect_size**2\n\nprint(f\"Baseline: {baseline*100}%\")\nprint(f\"Target: {(baseline + effect_size)*100}%\")\nprint(f\"Sample size per group needed: {n_required:.0f}\")\nprint(f\"With n=5000 per group: Can detect ~{effect_size*100:.2f}% or larger effects\")"
        ]
      ]
