          "python",
          "import numpy as np\nfrom scipy.stats import norm\n\n# Gumbel copula (\u03b8 >= 1)\ntheta = 2  # Upper tail strength\n\n# Generate via Clayton approximation (simplified)\nnp.random.seed(42)\nn = 1000\nu = np.random.uniform(0, 1, n)\nv = np.random.uniform(0, 1, n)\n\n# Gumbel CDF inverse (simplified for illustration)\n# C(u1, u2; \u03b8) = exp(-((-log u1)^\u03b8 + (-log u2)^\u03b8)^(1/\u03b8))\n\nlog_u = np.log(u)\nlog_v = np.log(v)\n\nu1 = u\nu2 = np.exp(-((-log_u)**theta + (-log_v)**theta)**(1/theta))\n\n# Transform\nx = norm.ppf(np.clip(u1, 1e-6, 1-1e-6))\ny = norm.ppf(np.clip(u2, 1e-6, 1-1e-6))\n\n# Plot\nfig, axes = plt.subplots(1, 2, figsize=(10, 4))\n\naxes[0].scatter(u1, u2, alpha=0.5, s=10)\naxes[0].set_xlabel('U1')\naxes[0].set_ylabel('U2')\naxes[0].set_title(f'Gumbel Copula (\u03b8={theta}) - Upper tail cluster')\naxes[0].set_xlim([0, 1])\naxes[0].set_ylim([0, 1])\n\naxes[1].scatter(x, y, alpha=0.5, s=10)\naxes[1].set_xlabel('X ~ Normal(0,1)')\naxes[1].set_ylabel('Y ~ Normal(0,1)')\naxes[1].set_title('Gumbel structure')\n\nplt.tight_layout()\nplt.show()\n\n# Upper tail concentration\nupper_tail_concentration = np.mean((u1 > 0.9) & (u2 > 0.9))\nprint(f\"Gumbel copula \u03b8={theta}\")\nprint(f\"Joint probability both > 0.9: {upper_tail_concentration:.4f}\")\nprint(f\"Independence expectation: {0.1 * 0.1:.4f}\")\nprint(f\"Gumbel shows upper tail dependence\")"
        ]
      ]
