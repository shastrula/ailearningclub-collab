          "python",
          "import numpy as np\nfrom scipy.stats import norm, mvn\nimport matplotlib.pyplot as plt\n\n# Gaussian copula\n# 1. Generate correlated standard normals\nnp.random.seed(42)\nrho = 0.6  # Correlation\ncov = [[1, rho], [rho, 1]]\nu_normal = mvn.rvs(mean=[0, 0], cov=cov, size=1000)\n\n# 2. Transform to uniform (via standard normal CDF)\nu1 = norm.cdf(u_normal[:, 0])\nu2 = norm.cdf(u_normal[:, 1])\n\n# 3. Apply inverse CDFs to get any marginals\n# Example: X ~ Exponential(1), Y ~ Normal(0,1)\nx = -np.log(1 - u1)  # Inverse exponential CDF\ny = norm.ppf(u2)     # Inverse normal CDF\n\n# Plot\nfig, axes = plt.subplots(1, 2, figsize=(10, 4))\n\n# Copula (uniform space)\naxes[0].scatter(u1, u2, alpha=0.5, s=10)\naxes[0].set_xlabel('U1')\naxes[0].set_ylabel('U2')\naxes[0].set_title(f'Gaussian Copula (\u03c1={rho})')\naxes[0].set_xlim([0, 1])\naxes[0].set_ylim([0, 1])\n\n# Transformed marginals\naxes[1].scatter(x, y, alpha=0.5, s=10)\naxes[1].set_xlabel('X ~ Exponential(1)')\naxes[1].set_ylabel('Y ~ Normal(0,1)')\naxes[1].set_title('Same dependence, different margins')\n\nplt.tight_layout()\nplt.show()\n\n# Empirical correlation\nempirical_corr = np.corrcoef(x, y)[0, 1]\nprint(f\"Gaussian copula \u03c1: {rho}\")\nprint(f\"Empirical correlation: {empirical_corr:.4f}\")"
        ]
      ]
    },
