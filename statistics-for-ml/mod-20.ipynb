          "python",
          "import numpy as np\n\n# Compare tail dependence across copulas\nprint(\"Tail Dependence Indices:\")\nprint(\"\\nGaussian Copula (\u03c1=0.6):\")\nprint(\"  Lower tail: \u03bbL = 0 (no tail dependence)\")\nprint(\"  Upper tail: \u03bbU = 0 (no tail dependence)\")\n\nprint(\"\\nClayton Copula (\u03b8=2):\")\nprint(\"  Lower tail: \u03bbL = 2^(-1/\u03b8) = 2^(-0.5) \u2248 0.71 (strong)\")\nprint(\"  Upper tail: \u03bbU = 0 (no upper tail dependence)\")\n\nprint(\"\\nGumbel Copula (\u03b8=2):\")\nprint(\"  Lower tail: \u03bbL = 0 (no lower tail dependence)\")\nprint(\"  Upper tail: \u03bbU = 2 - 2^(1/\u03b8) = 2 - 2^0.5 \u2248 0.59 (strong)\")\n\n# Financial implication\nprint(\"\\n--- Financial Risk Implication ---\")\nprint(\"Gaussian: Diversification helps in normal times AND crises\")\nprint(\"Clayton: Diversification fails in downturns (assets crash together)\")\nprint(\"Gumbel: Diversification fails in rallies (assets boom together)\")"
        ]
      ]
