          "python",
          "import numpy as np\n\n# Two asset portfolio during crisis\n# Gaussian copula: correlations rise but diversification works\n# Clayton copula: correlations spike; portfolio crashes together\n\nprint(\"Portfolio of 50% Asset A, 50% Asset B\\n\")\n\n# Normal times: \u03c1 = 0.3 (Gaussian)\nprint(\"Normal Market (Gaussian \u03c1=0.3):\")\nprint(\"  P(both assets down 10%) \u2248 0.04 (low, diversification works)\")\n\n# Crisis: tail dependence kicks in\nprint(\"\\nCrisis (Clayton copula tail dependence):\")\nprint(\"  P(both assets down 10%) \u2248 0.20 (high, diversification fails)\")\nprint(\"  Portfolio expected loss in crisis: ~20% instead of ~10%\")"
        ]
