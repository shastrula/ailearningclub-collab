          "python",
          "import numpy as np\nfrom scipy.stats import spearmanr, pearsonr\nimport matplotlib.pyplot as plt\n\n# Generate non-linear data\nnp.random.seed(42)\nx = np.linspace(-3, 3, 100)\ny = x**2 + np.random.normal(0, 1, 100)  # Quadratic relationship\n\n# Compute correlations\npearson_corr, pearson_p = pearsonr(x, y)\nspearman_corr, spearman_p = spearmanr(x, y)\n\nprint(f\"Pearson \u03c1: {pearson_corr:.4f} (p-value: {pearson_p:.4e})\")\nprint(f\"Spearman \u03c1s: {spearman_corr:.4f} (p-value: {spearman_p:.4e})\")\nprint(f\"Spearman detects monotone relationship; Pearson misses perfect parabola\")\n\n# Plot\nplt.scatter(x, y, alpha=0.6)\nplt.xlabel('x')\nplt.ylabel('y = x\u00b2 + noise')\nplt.title(f'Pearson \u03c1={pearson_corr:.2f}, Spearman \u03c1s={spearman_corr:.2f}')\nplt.grid()\nplt.show()"
        ]
      ]
    },
