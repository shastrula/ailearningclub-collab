          "python",
          "import numpy as np\nfrom scipy.stats import norm, gamma\nimport matplotlib.pyplot as plt\n\n# Clayton copula\n# Uses inverse transform: C(u1, u2; \u03b8) parametrized by \u03b8 > -1\n# For \u03b8 > 0: strong positive lower tail dependence\n\ntheta = 2  # Strength of tail dependence\n\n# Generate Clayton copula samples\nnp.random.seed(42)\nn = 1000\nu = np.random.uniform(0, 1, n)\nv = np.random.uniform(0, 1, n)\n\n# Clayton CDF inverse: u1 = u, u2 = (u1^(-\u03b8) * (v^(-\u03b8/(1+\u03b8)) - 1) + 1)^(-1/\u03b8)\nu1 = u\nu2 = (u1**(-theta) * (v**(-theta/(1+theta)) - 1) + 1)**(-1/theta)\n\n# Transform to standard normals\nx = norm.ppf(u1)\ny = norm.ppf(u2)\n\n# Plot\nfig, axes = plt.subplots(1, 2, figsize=(10, 4))\n\n# Copula space\naxes[0].scatter(u1, u2, alpha=0.5, s=10)\naxes[0].set_xlabel('U1')\naxes[0].set_ylabel('U2')\naxes[0].set_title(f'Clayton Copula (\u03b8={theta}) - Lower tail cluster')\naxes[0].set_xlim([0, 1])\naxes[0].set_ylim([0, 1])\n\n# Transformed space\naxes[1].scatter(x, y, alpha=0.5, s=10)\naxes[1].set_xlabel('X ~ Normal(0,1)')\naxes[1].set_ylabel('Y ~ Normal(0,1)')\naxes[1].set_title('Same Clayton structure, normal margins')\n\nplt.tight_layout()\nplt.show()\n\n# Note: strong concentration in lower-left corner\nlower_tail_concentration = np.mean((u1 < 0.1) & (u2 < 0.1))\nprint(f\"Clayton copula \u03b8={theta}\")\nprint(f\"Joint probability both < 0.1: {lower_tail_concentration:.4f}\")\nprint(f\"Independence expectation: {0.1 * 0.1:.4f}\")\nprint(f\"Clayton shows lower tail dependence\")"
        ]
      ]
    },
