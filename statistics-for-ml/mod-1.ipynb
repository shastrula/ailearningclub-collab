      "source": [
        [
          "python",
          "import numpy as np\n\n# Bayes theorem implementation\nprior_spam = 0.1\nlikelihood_word_given_spam = 0.8\nlikelihood_word_given_ham = 0.05\n\n# Prior prob of ham\nprior_ham = 0.9\n\n# Marginal likelihood of seeing the word\np_word = (likelihood_word_given_spam * prior_spam + \n          likelihood_word_given_ham * prior_ham)\n\n# Posterior probability\nposterior_spam = (likelihood_word_given_spam * prior_spam) / p_word\nprint(f\"P(spam | 'FREE') = {posterior_spam:.3f}\")\nprint(f\"P(ham | 'FREE') = {1 - posterior_spam:.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import math\nfrom scipy.special import comb, perm\n\n# Permutations: arrange 3 from 5\np_5_3 = perm(5, 3, exact=True)\nprint(f\"Permutations P(5,3) = {p_5_3}\")\n\n# Combinations: choose 3 from 5\nc_5_3 = comb(5, 3, exact=True)\nprint(f\"Combinations C(5,3) = {c_5_3}\")\n\n# Binomial coefficient\nfrom math import factorial\nmanual = factorial(5) / (factorial(3) * factorial(2))\nprint(f\"Manual calculation: {manual}\")\n\n# Probability example: drawing cards\n# P(all 5 cards are hearts from standard deck)\ntotal_5card_hands = comb(52, 5, exact=True)\nhearts_only_hands = comb(13, 5, exact=True)\nprob = hearts_only_hands / total_5card_hands\nprint(f\"P(all hearts) = {prob:.6f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Given information\np_factory_a = 0.6\np_factory_b = 0.4\np_defect_given_a = 0.02\np_defect_given_b = 0.05\n\n# Apply Bayes theorem\n# P(A|D) = P(D|A) * P(A) / P(D)\n\n# Step 1: Calculate P(D) using law of total probability\np_defect = (p_defect_given_a * p_factory_a + \n            p_defect_given_b * p_factory_b)\n\n# Step 2: Calculate posterior\np_factory_a_given_defect = (p_defect_given_a * p_factory_a) / p_defect\n\nprint(f\"P(Factory A | Defect) = {p_factory_a_given_defect:.4f}\")\nprint(f\"P(Factory B | Defect) = {1 - p_factory_a_given_defect:.4f}\")\n\n# Intuition: Even though Factory A produces more chips,\n# Factory B produces higher defect rate, so defect is more likely from B"
        ]
      ]
    }
