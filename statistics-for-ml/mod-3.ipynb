          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.stats import norm\n\n# CLT demonstration: distributions of different shapes\nnp.random.seed(42)\n\n# Underlying distributions: uniform (not normal), exponential (skewed)\nuniform_data = np.random.uniform(0, 10, size=100000)\nexponential_data = np.random.exponential(scale=2, size=100000)\nlaplace_data = np.random.laplace(loc=2, scale=1, size=100000)\n\n# Compute sample means for multiple trials\nn_per_sample = 30\nn_trials = 10000\n\nuniform_means = [uniform_data[np.random.choice(len(uniform_data), n_per_sample)].mean() \n                 for _ in range(n_trials)]\nexponential_means = [exponential_data[np.random.choice(len(exponential_data), n_per_sample)].mean() \n                     for _ in range(n_trials)]\nlaplace_means = [laplace_data[np.random.choice(len(laplace_data), n_per_sample)].mean() \n                 for _ in range(n_trials)]\n\n# Plot: original distributions vs distribution of means\nfig, axes = plt.subplots(3, 2, figsize=(12, 10))\n\n# Uniform\naxes[0, 0].hist(uniform_data, bins=50, density=True, alpha=0.7)\naxes[0, 0].set_title('Uniform Distribution (Original)')\naxes[0, 1].hist(uniform_means, bins=50, density=True, alpha=0.7)\naxes[0, 1].plot(np.linspace(3, 7, 100), \n                norm.pdf(np.linspace(3, 7, 100), 5, np.std(uniform_means)), \n                'r-', linewidth=2)\naxes[0, 1].set_title('Distribution of Sample Means (n=30)')\n\n# Exponential\naxes[1, 0].hist(exponential_data, bins=50, density=True, alpha=0.7)\naxes[1, 0].set_title('Exponential Distribution (Original)')\naxes[1, 1].hist(exponential_means, bins=50, density=True, alpha=0.7)\naxes[1, 1].plot(np.linspace(1.5, 2.5, 100), \n                norm.pdf(np.linspace(1.5, 2.5, 100), np.mean(exponential_means), np.std(exponential_means)), \n                'r-', linewidth=2)\naxes[1, 1].set_title('Distribution of Sample Means (n=30)')\n\n# Laplace\naxes[2, 0].hist(laplace_data, bins=50, density=True, alpha=0.7)\naxes[2, 0].set_title('Laplace Distribution (Original)')\naxes[2, 1].hist(laplace_means, bins=50, density=True, alpha=0.7)\naxes[2, 1].plot(np.linspace(1.5, 2.5, 100), \n                norm.pdf(np.linspace(1.5, 2.5, 100), np.mean(laplace_means), np.std(laplace_means)), \n                'r-', linewidth=2)\naxes[2, 1].set_title('Distribution of Sample Means (n=30)')\n\nprint(\"Distributions look completely different, yet sample means are all approximately normal!\")\nprint(f\"Uniform means: mean={np.mean(uniform_means):.3f}, std={np.std(uniform_means):.3f}\")\nprint(f\"Exponential means: mean={np.mean(exponential_means):.3f}, std={np.std(exponential_means):.3f}\")\nprint(f\"Laplace means: mean={np.mean(laplace_means):.3f}, std={np.std(laplace_means):.3f}\")"
