        [
          "python",
          "import numpy as np\nfrom scipy.stats import norm, multivariate_normal\n\n# Portfolio variance with correlation\nvar_a = 0.05**2  # variance of A\nvar_b = 0.08**2  # variance of B\ncorr = 0.3       # correlation\ncov = corr * 0.05 * 0.08\n\n# Portfolio: 60% A, 40% B\nw_a, w_b = 0.6, 0.4\nportfolio_var = (w_a**2 * var_a + \n                 w_b**2 * var_b + \n                 2 * w_a * w_b * cov)\nportfolio_std = np.sqrt(portfolio_var)\n\nprint(f\"Uncorrelated portfolio std: {np.sqrt(w_a**2*var_a + w_b**2*var_b):.4f}\")\nprint(f\"Correlated (\u03c1=0.3) portfolio std: {portfolio_std:.4f}\")\nprint(f\"Diversification benefit from correlation reduction\")\n\n# Correlation simulation\nn_samples = 1000\nmean = [100, 100]\ncov_matrix = [[15**2, 0.5*15*15],\n              [0.5*15*15, 15**2]]\ndata = multivariate_normal.rvs(mean=mean, cov=cov_matrix, size=n_samples)\n\nactual_corr = np.corrcoef(data[:, 0], data[:, 1])[0, 1]\nprint(f\"Sample correlation: {actual_corr:.3f} (target: 0.5)\")"
        ]
      ]
