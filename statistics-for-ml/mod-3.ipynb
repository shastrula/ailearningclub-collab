          "python",
          "import numpy as np\nfrom scipy.stats import norm, binom\n\n# Example 1: Discrete - Expected value of die roll\noutcomes = [1, 2, 3, 4, 5, 6]\nprobabilities = [1/6] * 6\nexpected_die = sum(x * p for x, p in zip(outcomes, probabilities))\nprint(f\"E[die] = {expected_die:.2f}\")\n\n# Example 2: Continuous - Normal distribution\ndist = norm(loc=100, scale=15)\nsamples = dist.rvs(size=100000)\nprint(f\"E[X] from samples: {samples.mean():.2f}\")\nprint(f\"E[X] theoretical: {dist.mean():.2f}\")\n\n# Example 3: Linearity of expectation\n# Investment returns: 60% Stock A (mean 8%), 40% Stock B (mean 12%)\nreturn_a = 0.08\nreturn_b = 0.12\nportfolio_return = 0.6 * return_a + 0.4 * return_b\nprint(f\"Portfolio expected return: {portfolio_return:.4f}\")\n\n# Example 4: Binomial expectation\n# n=100 coin flips, p=0.6\nn, p = 100, 0.6\ndist = binom(n, p)\nprint(f\"Expected heads (Binomial): {dist.mean():.1f}\")\nprint(f\"Formula np = {n * p}\")"
