          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Demonstrate LLN: sample mean converges to true mean\ntrue_mean = 5\n\n# Different distribution samples\ncoin_flips = np.random.binomial(1, 0.5, size=10000)  # Fair coin\ndie_rolls = np.random.randint(1, 7, size=10000)      # Die (mean = 3.5)\n\n# Compute running averages\nn_values = np.arange(1, len(coin_flips) + 1)\nrunning_mean_coin = np.cumsum(coin_flips) / n_values\nrunning_mean_die = np.cumsum(die_rolls) / n_values\n\n# Plot convergence\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 4))\n\nax1.plot(running_mean_coin, alpha=0.7)\nax1.axhline(0.5, color='r', linestyle='--', label='True mean')\nax1.set_xlabel('Number of samples')\nax1.set_ylabel('Running mean')\nax1.set_title('Coin Flips: Running Mean Convergence')\nax1.set_ylim([0, 1])\nax1.legend()\n\nax2.plot(running_mean_die, alpha=0.7)\nax2.axhline(3.5, color='r', linestyle='--', label='True mean')\nax2.set_xlabel('Number of samples')\nax2.set_ylabel('Running mean')\nax2.set_title('Die Rolls: Running Mean Convergence')\nax2.set_ylim([2.5, 4.5])\nax2.legend()\n\nprint(f\"Laplace means: mean={np.mean(laplace_means):.3f}, std={np.std(laplace_means):.3f}\")"
        ]
      ]
