          "python",
          "import numpy as np\n\ndef entropy(counts):\n    \"\"\"Compute entropy from class counts\"\"\"\n    probs = counts / np.sum(counts)\n    return -np.sum(probs[probs > 0] * np.log2(probs[probs > 0]))\n\n# Dataset: 14 samples total\n# Parent: 9 class A, 5 class B\n# Split option: [left: 8A, 1B] vs [right: 1A, 4B]\n\nparent_counts = np.array([9, 5])\nleft_counts = np.array([8, 1])\nright_counts = np.array([1, 4])\n\nh_parent = entropy(parent_counts)\nh_left = entropy(left_counts)\nh_right = entropy(right_counts)\n\n# Weighted average of children\nn_left = np.sum(left_counts)\nn_right = np.sum(right_counts)\nn_total = np.sum(parent_counts)\n\nh_children = (n_left / n_total) * h_left + (n_right / n_total) * h_right\n\n# Information gain\nig = h_parent - h_children\n\nprint(f\"Parent entropy: {h_parent:.4f}\")\nprint(f\"Left child entropy: {h_left:.4f}\")\nprint(f\"Right child entropy: {h_right:.4f}\")\nprint(f\"Weighted child entropy: {h_children:.4f}\")\nprint(f\"Information gain: {ig:.4f}\")\nprint(f\"\\nThis split reduces uncertainty by {ig:.4f} bits\")"
        ]
      ]
