        [
          "python",
          "import numpy as np\n\n# Example: Weather forecast accuracy\n# X = actual weather {sunny, rainy}\n# Y = forecast {sunny, rainy}\n\n# Joint probabilities\nprob_joint = {\n    ('sunny', 'forecast_sunny'): 0.40,\n    ('sunny', 'forecast_rainy'): 0.10,\n    ('rainy', 'forecast_sunny'): 0.05,\n    ('rainy', 'forecast_rainy'): 0.45\n}\n\ndef entropy(probs):\n    return -np.sum([p * np.log2(p + 1e-10) for p in probs if p > 0])\n\n# Marginal probabilities\np_x_sunny = 0.40 + 0.10  # 0.50\np_x_rainy = 0.05 + 0.45  # 0.50\np_y_sunny = 0.40 + 0.05  # 0.45\np_y_rainy = 0.10 + 0.45  # 0.55\n\n# H(X) - unconditional entropy\nh_x = entropy([p_x_sunny, p_x_rainy])\n\n# H(X|Y=sunny) - entropy of weather given forecast is sunny\n# P(sunny|forecast_sunny) = 0.40/0.45 \u2248 0.889\n# P(rainy|forecast_sunny) = 0.05/0.45 \u2248 0.111\nh_x_given_y_sunny = entropy([0.40/0.45, 0.05/0.45])\n\n# H(X|Y=rainy)\nh_x_given_y_rainy = entropy([0.10/0.55, 0.45/0.55])\n\n# H(X|Y) - conditional entropy\nh_x_given_y = p_y_sunny * h_x_given_y_sunny + p_y_rainy * h_x_given_y_rainy\n\nprint(f\"H(X) unconditional: {h_x:.4f} bits\")\nprint(f\"H(X|Y=sunny): {h_x_given_y_sunny:.4f} bits\")\nprint(f\"H(X|Y=rainy): {h_x_given_y_rainy:.4f} bits\")\nprint(f\"H(X|Y) conditional average: {h_x_given_y:.4f} bits\")\nprint(f\"\\nForecast reduces uncertainty by {h_x - h_x_given_y:.4f} bits\")"
        ]
      ]
    },
    {
