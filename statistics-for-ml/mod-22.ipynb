          "python",
          "import numpy as np\nfrom sklearn.metrics import mutual_info_score\nfrom sklearn.preprocessing import KBinsDiscretizer\n\n# Continuous data\nnp.random.seed(42)\nn = 1000\nx = np.random.normal(0, 1, n)\ny = 2*x + np.random.normal(0, 0.5, n)  # Strong correlation\n\n# Discretize for MI computation\ndiscretizer = KBinsDiscretizer(n_bins=10, encode='ordinal', strategy='quantile')\nx_binned = discretizer.fit_transform(x.reshape(-1, 1)).flatten().astype(int)\ny_binned = discretizer.fit_transform(y.reshape(-1, 1)).flatten().astype(int)\n\n# Compute MI (via sklearn's entropy-based approach)\nfrom scipy.stats import entropy as scipy_entropy\n\n# Marginal entropies\nhist_x = np.bincount(x_binned)\nhist_y = np.bincount(y_binned)\nh_x = scipy_entropy(hist_x / np.sum(hist_x))\nh_y = scipy_entropy(hist_y / np.sum(hist_y))\n\n# Joint entropy\njoint_hist = np.histogram2d(x_binned, y_binned, bins=10)[0].flatten()\nh_joint = scipy_entropy(joint_hist / np.sum(joint_hist))\n\n# MI\nmi = h_x + h_y - h_joint\n\nprint(f\"H(X): {h_x:.4f}\")\nprint(f\"H(Y): {h_y:.4f}\")\nprint(f\"H(X,Y): {h_joint:.4f}\")\nprint(f\"I(X;Y): {mi:.4f}\")\nprint(f\"\\nStrong dependence indicated by high MI\")"
        ]
