          "python",
          "import numpy as np\nfrom sklearn.tree import DecisionTreeClassifier\nfrom sklearn.datasets import load_iris\nimport matplotlib.pyplot as plt\n\n# Train tree\nX, y = load_iris(return_X_y=True)\ntree = DecisionTreeClassifier(max_depth=3, random_state=42)\ntree.fit(X, y)\n\n# Extract feature importance (based on information gain)\nfeature_names = ['Sepal length', 'Sepal width', 'Petal length', 'Petal width']\nimportances = tree.feature_importances_\n\nprint(\"Information Gain (Feature Importance):\\n\")\nfor name, importance in sorted(zip(feature_names, importances), key=lambda x: -x[1]):\n    print(f\"{name:20} IG = {importance:.4f}\")\n\n# Plot\nplt.barh(feature_names, importances)\nplt.xlabel('Information Gain')\nplt.title('Feature Importance in Decision Tree (Iris Dataset)')\nplt.tight_layout()\nplt.show()"
        ]
