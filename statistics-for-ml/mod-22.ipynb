          "python",
          "import numpy as np\nfrom sklearn.metrics import mutual_info_score, normalized_mutual_info_score\n\n# Ground truth labels\ny_true = np.array([0, 0, 0, 1, 1, 1, 2, 2, 2])\n\n# Two clustering results\ny_pred_good = np.array([0, 0, 1, 1, 1, 2, 2, 2, 2])  # 7/9 correct\ny_pred_bad = np.array([0, 1, 2, 0, 1, 2, 0, 1, 2])   # random\n\nmi_good = mutual_info_score(y_true, y_pred_good)\nmi_bad = mutual_info_score(y_true, y_pred_bad)\n\n# Normalized MI (0 to 1)\nnmi_good = normalized_mutual_info_score(y_true, y_pred_good)\nnmi_bad = normalized_mutual_info_score(y_true, y_pred_bad)\n\nprint(f\"Good clustering: MI = {mi_good:.4f}, NMI = {nmi_good:.4f}\")\nprint(f\"Bad clustering: MI = {mi_bad:.4f}, NMI = {nmi_bad:.4f}\")\nprint(f\"\\nHigher MI/NMI indicates better agreement with ground truth\")"
