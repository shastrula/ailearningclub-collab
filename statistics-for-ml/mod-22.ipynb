        [
          "python",
          "import numpy as np\nfrom sklearn.datasets import load_breast_cancer\nfrom sklearn.feature_selection import mutual_info_classif\nimport matplotlib.pyplot as plt\n\n# Load cancer dataset\nX, y = load_breast_cancer(return_X_y=True)\n\n# Compute MI scores\nmi_scores = mutual_info_classif(X, y, random_state=42)\n\n# Sort features\nsorted_idx = np.argsort(mi_scores)[::-1]\ntop_k = 10\n\nprint(\"Top 10 features by mutual information with target:\\n\")\nfor i in range(top_k):\n    idx = sorted_idx[i]\n    print(f\"Feature {idx:2d}: I = {mi_scores[idx]:.4f}\")\n\n# Plot\nplt.figure(figsize=(10, 6))\nplt.barh(range(top_k), mi_scores[sorted_idx[:top_k]])\nplt.xlabel('Mutual Information (nats)')\nplt.ylabel('Feature')\nplt.title('Top 10 Features by Mutual Information with Target')\nplt.tight_layout()\nplt.show()\n\nprint(\"\\nInterpretation: Higher MI = feature carries more discriminative information\")"
        ]
      ]
    },
