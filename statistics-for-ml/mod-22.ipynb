      "source": [
        [
          "python",
          "import numpy as np\n\n# Using previous weather example\nprob_joint_values = [0.40, 0.10, 0.05, 0.45]\n\ndef entropy(probs):\n    return -np.sum([p * np.log2(p + 1e-10) for p in probs if p > 0])\n\nh_joint = entropy(prob_joint_values)\n\n# Marginals\nh_x = entropy([0.50, 0.50])\nh_y = entropy([0.45, 0.55])\n\n# If independent, H(X,Y) would equal H(X) + H(Y)\nh_independent = h_x + h_y\n\nprint(f\"H(X,Y) joint: {h_joint:.4f} bits\")\nprint(f\"H(X) + H(Y): {h_independent:.4f} bits\")\nprint(f\"Reduction due to dependence: {h_independent - h_joint:.4f} bits\")\nprint(f\"\\nThis reduction equals mutual information I(X;Y)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Verify chain rule\nh_x = 1.0  # hypothetical\nh_y_given_x = 0.6\nh_chain = h_x + h_y_given_x\n\n# Also equals H(Y) + H(X|Y)\nh_y = 0.8\nh_x_given_y = 0.8  # This should satisfy our constraint\nh_chain_alt = h_y + h_x_given_y\n\nprint(\"Chain Rule: H(X,Y) = H(X) + H(Y|X) = H(Y) + H(X|Y)\")\nprint(f\"\\nH(X) + H(Y|X) = {h_x} + {h_y_given_x} = {h_chain:.3f}\")\nprint(f\"H(Y) + H(X|Y) = {h_y} + {h_x_given_y} = {h_chain_alt:.3f}\")\nprint(f\"Both equal H(X,Y) = {h_joint:.3f}\")"
        ]
      ]
    },
