      "source": [
        [
          "python",
          "FWER = P(at least one false positive among m tests)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "FWER \u2264 m \u00d7 \u03b1_per_test"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy import stats\n\n# Simulate 100 tests under null hypothesis (no effect)\nnp.random.seed(42)\nn_tests = 100\nsample_size = 30\n\n# Generate null data\np_values = []\nfor i in range(n_tests):\n    # Draw two random samples, compute t-test\n    x = np.random.normal(0, 1, sample_size)\n    y = np.random.normal(0, 1, sample_size)\n    t_stat, p_val = stats.ttest_ind(x, y)\n    p_values.append(p_val)\n\np_values = np.array(p_values)\nalpha = 0.05\n\n# Without correction: many false positives\nuncorrected_significant = np.sum(p_values < alpha)\nprint(f\"Uncorrected: {uncorrected_significant} significant at \u03b1=0.05\")\n\n# With Bonferroni correction\nbonferroni_alpha = alpha / n_tests\nbonferroni_significant = np.sum(p_values < bonferroni_alpha)\nprint(f\"Bonferroni: {bonferroni_significant} significant at \u03b1={bonferroni_alpha:.6f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "FDR = E[V / R]  where V = false positives, R = total rejections"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def benjamini_hochberg(p_values, q=0.05):\n    \"\"\"\n    Benjamini-Hochberg FDR control procedure.\n    \n    Args:\n        p_values: array of p-values\n        q: FDR level (default 0.05)\n    \n    Returns:\n        rejected: boolean array, True for rejected hypotheses\n        threshold: critical p-value threshold\n    \"\"\"\n    m = len(p_values)\n    \n    # Sort p-values, keep track of original indices\n    sorted_indices = np.argsort(p_values)\n    sorted_p = p_values[sorted_indices]\n    \n    # Find largest i where p_i <= (i/m) * q\n    threshold_idx = -1\n    for i in range(m - 1, -1, -1):\n        if sorted_p[i] <= ((i + 1) / m) * q:\n            threshold_idx = i\n            break\n    \n    if threshold_idx == -1:\n        # No rejections\n        return np.zeros(m, dtype=bool), 0.0\n    \n    threshold = sorted_p[threshold_idx]\n    rejected = np.zeros(m, dtype=bool)\n    rejected[sorted_indices[:threshold_idx + 1]] = True\n    \n    return rejected, threshold\n\n# Test on simulated data\nnp.random.seed(42)\nn_tests = 1000\np_values = np.random.uniform(0, 1, n_tests)\n\n# Add signal: some tests have genuinely small p-values\np_values[:50] = np.random.uniform(0, 0.001, 50)\n\nrejected_bh, threshold_bh = benjamini_hochberg(p_values, q=0.05)\nprint(f\"Benjamini-Hochberg rejected: {np.sum(rejected_bh)} hypotheses\")\nprint(f\"Threshold: p \u2264 {threshold_bh:.6f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import pandas as pd\n\n# Simulate GWAS results: 1 million SNPs\nnp.random.seed(42)\nn_snps = 1_000_000\n\n# Most SNPs have no effect (uniform p-values)\np_values_gwas = np.random.uniform(0, 1, n_snps)\n\n# Add signal: 50 SNPs truly associated\np_values_gwas[:50] = np.random.uniform(0, 1e-8, 50)\n\n# Traditional genome-wide significance: p < 5e-8\n# This is a FWER control at ~0.05 level, accounting for ~1M tests\ngwas_threshold = 5e-8\ngwas_significant = np.sum(p_values_gwas < gwas_threshold)\n\n# Benjamini-Hochberg approach\nrejected_bh, bh_threshold = benjamini_hochberg(p_values_gwas, q=0.05)\nbh_significant = np.sum(rejected_bh)\n\nprint(f\"Genome-wide threshold (p < {gwas_threshold}): {gwas_significant} SNPs\")\nprint(f\"Benjamini-Hochberg (FDR q=0.05): {bh_significant} SNPs\")\n\n# Comparison\nprint(f\"\\nBH threshold: p \u2264 {bh_threshold:.2e}\")\nprint(f\"Traditional GWAS is much more conservative than BH\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Comparison of methods on 100 tests, 10 truly different\nnp.random.seed(42)\nn_tests = 100\ntrue_effects = 10\n\n# Generate p-values\np_values = np.random.uniform(0.01, 1, n_tests)\np_values[:true_effects] = np.random.uniform(0, 0.001, true_effects)\n\nalpha = 0.05\n\n# Method 1: Uncorrected\nuncorrected = np.sum(p_values < alpha)\n\n# Method 2: Bonferroni\nbonferroni_threshold = alpha / n_tests\nbonferroni = np.sum(p_values < bonferroni_threshold)\n\n# Method 3: Benjamini-Hochberg\nbh_rejected, bh_threshold = benjamini_hochberg(p_values, q=0.05)\nbh = np.sum(bh_rejected)\n\nprint(f\"True effects: {true_effects}\")\nprint(f\"Uncorrected (\u03b1=0.05): {uncorrected} discoveries\")\nprint(f\"Bonferroni (\u03b1={bonferroni_threshold:.6f}): {bonferroni} discoveries\")\nprint(f\"Benjamini-Hochberg (q=0.05): {bh} discoveries\")"
        ]
      ]
    }
