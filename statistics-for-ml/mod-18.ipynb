        [
          "python",
          "import numpy as np\nfrom statsmodels.graphics.tsaplots import plot_acf, plot_pacf\nimport matplotlib.pyplot as plt\n\n# Generate AR(1) process: yt = 0.7*yt-1 + \u03b5t\nnp.random.seed(42)\nn = 200\nepsilon = np.random.normal(0, 1, n)\ny = np.zeros(n)\ny[0] = epsilon[0]\nfor t in range(1, n):\n    y[t] = 0.7 * y[t-1] + epsilon[t]\n\n# Plot ACF and PACF\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\nplot_acf(y, lags=20, ax=axes[0])\naxes[0].set_title(\"ACF: Exponential decay (AR signature)\")\n\nplot_pacf(y, lags=20, ax=axes[1], method='ywm')\naxes[1].set_title(\"PACF: Spike at lag 1 only (AR(1))\")\n\nplt.tight_layout()\nplt.show()\n\nprint(\"AR(1) signature: ACF decays, PACF cuts off at lag 1\")"
        ]
      ]
    },
