      "source": [
        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\nfrom statsmodels.tsa.stattools import adfuller\n\n# Generate stationary vs non-stationary series\nnp.random.seed(42)\nt = np.arange(100)\n\n# Stationary: random walk around mean\nstationary = np.random.normal(100, 5, 100)\n\n# Non-stationary: random walk (cumulative sum)\nnon_stationary = np.cumsum(np.random.normal(0, 1, 100)) + 100\n\n# Augmented Dickey-Fuller test\ndef test_stationarity(series, name):\n    adf_result = adfuller(series, autolag='AIC')\n    print(f\"\\n{name}:\")\n    print(f\"ADF Test Statistic: {adf_result[0]:.4f}\")\n    print(f\"P-value: {adf_result[1]:.4f}\")\n    print(f\"Critical Values: {adf_result[4]}\")\n    print(f\"Stationary (p < 0.05): {adf_result[1] < 0.05}\")\n\ntest_stationarity(stationary, \"Stationary Series\")\ntest_stationarity(non_stationary, \"Non-Stationary Series\")\n\n# Plot\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\naxes[0].plot(t, stationary)\naxes[0].set_title(\"Stationary: Mean=100, variance stable\")\naxes[1].plot(t, non_stationary)\naxes[1].set_title(\"Non-Stationary: Random walk with drift\")\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
