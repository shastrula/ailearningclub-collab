      "source": [
        [
          "python",
          "import numpy as np\nfrom statsmodels.tsa.stattools import adfuller\n\n# Non-stationary series\nseries = np.cumsum(np.random.normal(0, 1, 100)) + 100\n\n# First difference\ndifferenced = np.diff(series)\n\n# Test both\nprint(\"Original series:\")\nadf = adfuller(series, autolag='AIC')\nprint(f\"  ADF p-value: {adf[1]:.4f} (non-stationary if p > 0.05)\")\n\nprint(\"\\nFirst differenced:\")\nadf_diff = adfuller(differenced, autolag='AIC')\nprint(f\"  ADF p-value: {adf_diff[1]:.4f}\")\nprint(f\"  Now stationary: {adf_diff[1] < 0.05}\")"
        ]
      ]
    },
