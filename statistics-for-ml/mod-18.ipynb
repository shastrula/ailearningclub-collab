          "python",
          "import itertools\nimport warnings\nfrom statsmodels.tsa.arima.model import ARIMA\n\nwarnings.filterwarnings('ignore')\n\n# Sample data\ny = np.cumsum(np.random.normal(0, 1, 100)) + 100\n\n# Grid search\np_range = range(0, 3)\nd_range = range(0, 2)\nq_range = range(0, 3)\n\nbest_aic = np.inf\nbest_order = None\n\nfor order in itertools.product(p_range, d_range, q_range):\n    try:\n        model = ARIMA(y, order=order)\n        fitted = model.fit()\n        if fitted.aic < best_aic:\n            best_aic = fitted.aic\n            best_order = order\n    except:\n        continue\n\nprint(f\"Best ARIMA order: {best_order}\")\nprint(f\"Best AIC: {best_aic:.2f}\")"
