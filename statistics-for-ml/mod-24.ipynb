          "python",
          "import numpy as np\n\nprint(\"Sources of Uncertainty in Hierarchical Models:\")\nprint(\"\\n1. Within-group variability (\u03c3\u00b2)\")\nprint(\"   \u2192 Measurement error, individual variation\")\n\nprint(\"\\n2. Between-group variability (\u03c4\u00b2)\")\nprint(\"   \u2192 Systematic differences across groups\")\n\nprint(\"\\n3. Uncertainty in hyperparameters (\u03bc, \u03c4)\")\nprint(\"   \u2192 Reflects uncertainty about group distribution\")\n\nprint(\"\\nTotal posterior for group j:\")\nprint(\"  p(\u03b1_j | data) reflects all three sources\")\nprint(\"  \u2192 More uncertainty when:\")\nprint(\"    \u2022 Within-group noise is high\")\nprint(\"    \u2022 Between-group variation is high\")\nprint(\"    \u2022 Few observations in group j\")"
        ]
