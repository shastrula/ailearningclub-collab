          "python",
          "import numpy as np\nfrom scipy.stats import norm, halfnorm\n\n# Hierarchical linear regression example\n# Separate regression lines for each group, with shared priors\n\nnp.random.seed(42)\nn_groups = 15\nn_per_group = 20\n\n# Generate data\ngroup_intercepts = np.random.normal(100, 15, n_groups)\ngroup_slopes = np.random.normal(2, 0.5, n_groups)\n\ndata = []\nfor j in range(n_groups):\n    x = np.random.normal(0, 1, n_per_group)\n    y = group_intercepts[j] + group_slopes[j] * x + np.random.normal(0, 5, n_per_group)\n    for i in range(n_per_group):\n        data.append({'group': j, 'x': x[i], 'y': y[i]})\n\n# Fit simple (non-hierarchical) regression for comparison\nfrom sklearn.linear_model import LinearRegression\n\nX = np.array([d['x'] for d in data]).reshape(-1, 1)\ny = np.array([d['y'] for d in data])\n\nsimple_model = LinearRegression()\nsimple_model.fit(X, y)\n\nprint(\"Simple regression (no hierarchy):\")\nprint(f\"  Intercept: {simple_model.intercept_:.2f}\")\nprint(f\"  Slope: {simple_model.coef_[0]:.2f}\")\nprint(f\"  Ignores group structure; pooled estimates\")\n\nprint(\"\\nHierarchical model structure:\")\nprint(f\"  Level 1: y_ij ~ N(\u03b1_j + \u03b2_j*x_ij, \u03c3\u00b2)\")\nprint(f\"  Level 2: \u03b1_j ~ N(\u03bc_\u03b1, \u03c4\u00b2_\u03b1)\")\nprint(f\"           \u03b2_j ~ N(\u03bc_\u03b2, \u03c4\u00b2_\u03b2)\")\nprint(f\"  Priors: informative on group distributions\")\nprint(f\"  \u2192 Borrows strength across {n_groups} groups\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
