        [
          "python",
          "# Conceptual PyMC3 hierarchical model (pseudocode)\nprint(\"PyMC3 Hierarchical Model Example:\")\nprint(\"\"\"\nimport pymc3 as pm\nimport pandas as pd\n\n# Data structure\ndata = pd.DataFrame({\n    'school': school_ids,\n    'score': observations\n})\n\nwith pm.Model() as hierarchical_model:\n    # Hyperpriors (group-level)\n    \u03bc_\u03bc = pm.Normal('\u03bc_\u03bc', mu=100, sd=50)\n    \u03c3_\u03bc = pm.HalfNormal('\u03c3_\u03bc', sd=20)\n    \n    # Group-level parameters\n    \u03bc_school = pm.Normal('\u03bc_school', mu=\u03bc_\u03bc, sd=\u03c3_\u03bc, shape=n_schools)\n    \u03c3 = pm.HalfNormal('\u03c3', sd=10)\n    \n    # Data likelihood\n    y_obs = pm.Normal('y_obs', mu=\u03bc_school[school], sd=\u03c3, observed=observations)\n    \n    # Inference\n    trace = pm.sample(2000, tune=1000, return_inferencedata=True)\n\n# Results\nprint(trace.posterior['\u03bc_\u03bc'].mean())  # Posterior mean\nprint(trace.posterior['\u03bc_school'].mean())  # Per-school estimates\n\"\"\")"
        ]
      ]
