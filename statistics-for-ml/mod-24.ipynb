          "python",
          "import numpy as np\n\n# Example: Longitudinal study\n# Fixed effects: model = y ~ treatment + patient (separate intercept per patient)\n# Random effects: model = y ~ treatment + (1|patient) (patient effect ~ N(0, \u03c3\u00b2))\n\nprint(\"Fixed Effects vs Random Effects:\")\nprint(\"\\nFixed effects (no pooling):\")\nprint(\"  y_ij = \u03bc + treatment_j + \u03b1_i + \u03b5_ij\")\nprint(\"  \u2192 Estimate \u03b1_i for each patient i\")\nprint(\"  \u2192 Need many patients with many measurements each\")\nprint(\"  \u2192 Can't generalize to new patients\")\n\nprint(\"\\nRandom effects (partial pooling):\")\nprint(\"  y_ij = \u03bc + treatment_j + \u03b1_i + \u03b5_ij\")\nprint(\"  \u03b1_i ~ N(0, \u03c3\u00b2_\u03b1)\")\nprint(\"  \u2192 Estimate \u03c3\u00b2_\u03b1 (population variance)\")\nprint(\"  \u2192 Efficient: works with few measurements per patient\")\nprint(\"  \u2192 Generalizes to new patients via N(0, \u03c3\u00b2_\u03b1) prior\")\n\nprint(\"\\nWhen to use each:\")\nprint(\"Fixed effects: few groups, large within-group n, focus on specific groups\")\nprint(\"Random effects: many groups, sparse data, want population inference\")"
        ]
      ]
    },
