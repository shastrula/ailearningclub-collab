          "python",
          "import numpy as np\nimport pandas as pd\n\n# Example: Basketball shooting percentages\n# Data: shots from various players on various teams\n\nnp.random.seed(42)\nn_players = 50\nn_teams = 10\n\n# True underlying parameters\nteam_effects = np.random.normal(0.45, 0.05, n_teams)  # Team shooting ability\nplayer_effects = np.random.normal(0, 0.03, n_players)  # Player deviations\n\n# Generate shot data\nshots = []\nfor _ in range(1000):\n    player = np.random.randint(0, n_players)\n    team = player % n_teams  # Players associated with teams\n    \n    # True shooting probability\n    true_prob = np.clip(team_effects[team] + player_effects[player], 0, 1)\n    made = np.random.binomial(1, true_prob)\n    \n    shots.append({'player': player, 'team': team, 'made': made})\n\nshots_df = pd.DataFrame(shots)\n\n# Naive: estimate per-player shooting percentage\nnaive_estimates = shots_df.groupby('player')['made'].agg(['sum', 'count'])\nnaive_estimates['pct'] = naive_estimates['sum'] / naive_estimates['count']\n\n# Hierarchical: shrink toward team average\nhierarchical_estimates = []\nfor player in range(n_players):\n    player_data = shots_df[shots_df['player'] == player]\n    team = player_data['team'].iloc[0]\n    team_data = shots_df[shots_df['team'] == team]\n    \n    player_made = player_data['made'].sum()\n    player_n = len(player_data)\n    team_pct = team_data['made'].mean()\n    \n    # Shrinkage\n    shrinkage_weight = player_n / (player_n + 30)  # Tuning parameter\n    hierarchical_pct = shrinkage_weight * (player_made / player_n) + (1 - shrinkage_weight) * team_pct\n    \n    hierarchical_estimates.append(hierarchical_pct)\n\nhierarchical_estimates = np.array(hierarchical_estimates)\n\n# Compare variance (real improvement)\nprint(\"Player Shooting Percentage Estimates:\")\nprint(f\"Naive (no pooling): std = {naive_estimates['pct'].std():.4f}\")\nprint(f\"Hierarchical (partial pooling): std = {np.std(hierarchical_estimates):.4f}\")\nprint(f\"\\nHierarchical shrinks extreme values toward team average\")\nprint(f\"Reduces noise for players with few shots\")"
        ]
      ]
    },
