          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Example: School mean test scores\n# True underlying scores have both school effect and shared distribution\n\nnp.random.seed(42)\nn_schools = 20\nschool_true_mean = np.random.normal(100, 15, n_schools)\n\n# Sample sizes vary (some schools have few students)\nsample_sizes = np.random.poisson(30, n_schools) + 5\n\n# Observed data (with measurement noise)\nobservations = []\nschool_ids = []\nfor school in range(n_schools):\n    n = sample_sizes[school]\n    scores = np.random.normal(school_true_mean[school], 10, n)\n    observations.extend(scores)\n    school_ids.extend([school] * n)\n\nobservations = np.array(observations)\nschool_ids = np.array(school_ids)\n\n# Three approaches\nno_pooling_estimates = np.array([observations[school_ids == s].mean() for s in range(n_schools)])\ncomplete_pooling_estimate = observations.mean()\npartial_pooling_estimates = np.zeros(n_schools)\n\n# Partial pooling (manual EB approximation)\nglobal_mean = observations.mean()\nglobal_sd = observations.std()\n\nfor school in range(n_schools):\n    school_obs = observations[school_ids == school]\n    n = len(school_obs)\n    school_mean = school_obs.mean()\n    school_se = school_obs.std() / np.sqrt(n)\n    \n    # Shrinkage: weighted average of school and global\n    # More shrinkage for smaller n\n    weight = n / (n + 10)  # Tuning parameter\n    partial_pooling_estimates[school] = weight * school_mean + (1 - weight) * global_mean\n\n# Plot\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n# Estimate comparison\nschools_plot = range(n_schools)\naxes[0].scatter(schools_plot, school_true_mean, label='True', s=100, alpha=0.6, marker='x')\naxes[0].scatter(schools_plot, no_pooling_estimates, label='No pooling', alpha=0.6, marker='o')\naxes[0].scatter(schools_plot, [complete_pooling_estimate]*n_schools, label='Complete pooling', alpha=0.6, marker='s')\naxes[0].scatter(schools_plot, partial_pooling_estimates, label='Partial pooling', alpha=0.6, marker='^')\naxes[0].set_xlabel('School')\naxes[0].set_ylabel('Mean score')\naxes[0].set_title('Pooling strategies')\naxes[0].legend()\n\n# Error vs sample size\nerrors_no = np.abs(no_pooling_estimates - school_true_mean)\nerrors_partial = np.abs(partial_pooling_estimates - school_true_mean)\n\naxes[1].scatter(sample_sizes, errors_no, label='No pooling', alpha=0.6, s=100)\naxes[1].scatter(sample_sizes, errors_partial, label='Partial pooling', alpha=0.6, s=100)\naxes[1].set_xlabel('Sample size per school')\naxes[1].set_ylabel('Absolute error')\naxes[1].set_title('Partial pooling helps small groups')\naxes[1].legend()\n\nplt.tight_layout()\nplt.show()\n\n# Compare MSE\nmse_no = np.mean(errors_no**2)\nmse_partial = np.mean(errors_partial**2)\n\nprint(f\"No pooling MSE: {mse_no:.2f}\")\nprint(f\"Partial pooling MSE: {mse_partial:.2f}\")\nprint(f\"Partial pooling reduction: {(1 - mse_partial/mse_no)*100:.1f}%\")"
        ]
      ]
