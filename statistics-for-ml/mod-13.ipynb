        [
          "python",
          "# Example: Product feature A/B test\n# Primary metric: click-through rate (higher is better)\n# Guardrails: page load time (lower is better), bounce rate (lower is better)\n\ndef evaluate_guardrails(control_metrics, treatment_metrics, guardrail_thresholds):\n    \"\"\"\n    Check if treatment passes guardrail metrics.\n    \n    Args:\n        control_metrics: dict of baseline metric values\n        treatment_metrics: dict of treatment metric values\n        guardrail_thresholds: dict defining acceptable changes\n        \n    Returns:\n        passed: bool, did treatment pass all guardrails?\n    \"\"\"\n    passed = True\n    results = {}\n    \n    for metric, threshold in guardrail_thresholds.items():\n        control_val = control_metrics[metric]\n        treatment_val = treatment_metrics[metric]\n        \n        # Check if regression exceeds threshold\n        pct_change = (treatment_val - control_val) / control_val\n        \n        results[metric] = {\n            'control': control_val,\n            'treatment': treatment_val,\n            'pct_change': pct_change,\n            'threshold': threshold,\n            'passed': abs(pct_change) <= abs(threshold)\n        }\n        \n        if not results[metric]['passed']:\n            passed = False\n    \n    return passed, results\n\n# Example metrics\ncontrol = {\n    'ctr': 0.050,           # 5.0% baseline CTR\n    'page_load_ms': 500,    # 500ms baseline load time\n    'bounce_rate': 0.30,    # 30% baseline bounce rate\n}\n\ntreatment = {\n    'ctr': 0.055,           # 10% improvement\n    'page_load_ms': 525,    # 5% regression\n    'bounce_rate': 0.28,    # 7% improvement\n}\n\n# Define acceptable guardrail thresholds\nguardrails = {\n    'page_load_ms': 0.10,      # Allow up to 10% slowdown\n    'bounce_rate': -0.05,      # Don't increase bounce rate >5%\n}\n\npassed, results = evaluate_guardrails(control, treatment, guardrails)\n\nprint(\"Guardrail Metrics Report:\\n\")\nfor metric, result in results.items():\n    status = \"\u2713 PASS\" if result['passed'] else \"\u2717 FAIL\"\n    print(f\"{metric}: {status}\")\n    print(f\"  Control: {result['control']:.3f}\")\n    print(f\"  Treatment: {result['treatment']:.3f}\")\n    print(f\"  Change: {result['pct_change']*100:+.1f}% (threshold: {result['threshold']*100:+.1f}%)\\n\")\n\nprint(f\"Overall: {'\u2713 PASSED guardrails' if passed else '\u2717 FAILED guardrails'}\")"
        ]
      ]
    }
