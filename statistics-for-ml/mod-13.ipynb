          "python",
          "Population \u2192 Randomize \u2192 Control (A) \u2192 Measure Y_control\n                      \u2198 Treatment (B) \u2192 Measure Y_treatment\n\nResult: Is Y_treatment > Y_control?"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "H\u2080: \u03bc_control = \u03bc_treatment  (null: no effect)\nH\u2081: \u03bc_control \u2260 \u03bc_treatment  (alternative: effect exists)\n\nt-statistic = (\u0233_treatment - \u0233_control) / SE"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy import stats\nimport matplotlib.pyplot as plt\n\n# Simulate A/B test\nnp.random.seed(42)\n\n# Control: baseline conversion rate 10%\ncontrol_rate = 0.10\ncontrol_sample_size = 5000\ncontrol_conversions = np.random.binomial(1, control_rate, control_sample_size)\n\n# Treatment: 12% (20% relative improvement)\ntreatment_rate = 0.12\ntreatment_sample_size = 5000\ntreatment_conversions = np.random.binomial(1, treatment_rate, treatment_sample_size)\n\n# Calculate means and standard errors\ncontrol_mean = control_conversions.mean()\ntreatment_mean = treatment_conversions.mean()\n\ncontrol_se = np.sqrt(control_mean * (1 - control_mean) / control_sample_size)\ntreatment_se = np.sqrt(treatment_mean * (1 - treatment_mean) / treatment_sample_size)\n\n# Two-sample t-test\nt_stat, p_value = stats.ttest_ind(treatment_conversions, control_conversions)\n\n# Effect size and confidence interval\neffect = treatment_mean - control_mean\nse_diff = np.sqrt(control_se**2 + treatment_se**2)\nci_lower = effect - 1.96 * se_diff\nci_upper = effect + 1.96 * se_diff\n\nprint(\"A/B Test Results:\")\nprint(f\"Control conversion rate: {control_mean:.4f}\")\nprint(f\"Treatment conversion rate: {treatment_mean:.4f}\")\nprint(f\"Difference: {effect:.4f} ({effect/control_mean*100:.1f}% relative)\")\nprint(f\"95% CI: [{ci_lower:.4f}, {ci_upper:.4f}]\")\nprint(f\"t-statistic: {t_stat:.3f}\")\nprint(f\"p-value: {p_value:.4f}\")\n\nif p_value < 0.05:\n    print(\"\u2713 Result is statistically significant at \u03b1=0.05\")\nelse:\n    print(\"\u2717 Result is NOT significant at \u03b1=0.05\")\n\n# Visualization\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\n# Distribution comparison\naxes[0].hist(control_conversions, bins=2, alpha=0.6, label='Control', density=True)\naxes[0].hist(treatment_conversions, bins=2, alpha=0.6, label='Treatment', density=True)\naxes[0].set_xlabel('Conversion (0=No, 1=Yes)')\naxes[0].set_ylabel('Density')\naxes[0].legend()\naxes[0].set_title('Control vs Treatment Distributions')\n\n# Effect plot with CI\naxes[1].errorbar([0], [effect], yerr=[[effect - ci_lower], [ci_upper - effect]], \n                 fmt='o', markersize=8, capsize=10, capthick=2)\naxes[1].axhline(0, color='r', linestyle='--', alpha=0.5, label='No effect')\naxes[1].set_ylabel('Effect Size')\naxes[1].set_xticks([0])\naxes[1].set_xticklabels(['Treatment'])\naxes[1].set_title(f'Effect Estimate with 95% CI\\np-value: {p_value:.4f}')\naxes[1].grid(alpha=0.3)\naxes[1].legend()\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
