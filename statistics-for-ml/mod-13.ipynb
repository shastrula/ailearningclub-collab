          "python",
          "n = 2 \u00d7 (z_\u03b1/2 + z_\u03b2)\u00b2 \u00d7 \u03c3\u00b2 / \u03b4\u00b2\n\nwhere:\n- z_\u03b1/2: critical value for significance level (e.g., 1.96 for \u03b1=0.05)\n- z_\u03b2: critical value for power (e.g., 0.84 for 80% power)\n- \u03c3\u00b2: population variance (estimated from pilot)\n- \u03b4: minimum detectable effect (your goal)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from scipy.stats import norm\n\ndef sample_size_for_proportions(control_rate, effect_size_pct, alpha=0.05, power=0.8):\n    \"\"\"\n    Calculate sample size needed per group for comparing proportions.\n    \n    Args:\n        control_rate: baseline conversion rate (0-1)\n        effect_size_pct: desired relative improvement (e.g., 0.20 for 20%)\n        alpha: significance level\n        power: statistical power (1 - beta)\n    \n    Returns:\n        n_per_group: sample size needed for each group\n    \"\"\"\n    treatment_rate = control_rate * (1 + effect_size_pct)\n    \n    # Standard error for proportions\n    p_bar = (control_rate + treatment_rate) / 2\n    se_pooled = np.sqrt(2 * p_bar * (1 - p_bar))\n    \n    # Critical values\n    z_alpha = norm.ppf(1 - alpha/2)\n    z_beta = norm.ppf(power)\n    \n    # Sample size\n    n = (z_alpha + z_beta)**2 * se_pooled**2 / (treatment_rate - control_rate)**2\n    \n    return int(np.ceil(n))\n\n# Examples\nscenarios = [\n    {\"baseline\": 0.05, \"improvement\": 0.25, \"label\": \"5% baseline, 25% lift\"},\n    {\"baseline\": 0.10, \"improvement\": 0.20, \"label\": \"10% baseline, 20% lift\"},\n    {\"baseline\": 0.10, \"improvement\": 0.10, \"label\": \"10% baseline, 10% lift\"},\n    {\"baseline\": 0.50, \"improvement\": 0.05, \"label\": \"50% baseline, 5% lift\"},\n]\n\nprint(\"Sample Size Requirements (per group, \u03b1=0.05, 80% power):\\n\")\nfor scenario in scenarios:\n    n = sample_size_for_proportions(scenario[\"baseline\"], scenario[\"improvement\"])\n    print(f\"{scenario['label']}: {n:,} users per group\")\n\n# Sensitivity to parameters\nbaselines = np.linspace(0.01, 0.5, 20)\nlifts = [0.05, 0.10, 0.20]\n\nplt.figure(figsize=(10, 6))\nfor lift in lifts:\n    ns = [sample_size_for_proportions(b, lift) for b in baselines]\n    plt.plot(baselines * 100, ns, marker='o', label=f'{lift*100:.0f}% lift')\n\nplt.xlabel('Baseline Conversion Rate (%)')\nplt.ylabel('Sample Size per Group')\nplt.title('A/B Test Sample Size Requirements')\nplt.legend()\nplt.grid(alpha=0.3)\nplt.yscale('log')\nplt.show()"
        ]
      ]
    },
