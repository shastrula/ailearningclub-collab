        [
          "python",
          "# Randomization strategies\n\n# Strategy 1: Simple randomization (coin flip)\ndef simple_randomize(n_users, treatment_prob=0.5):\n    \"\"\"Randomly assign users to control/treatment.\"\"\"\n    assignments = np.random.binomial(1, treatment_prob, n_users)\n    return assignments\n\n# Strategy 2: Stratified randomization (balance covariates)\ndef stratified_randomize(users_age, treatment_prob=0.5):\n    \"\"\"\n    Randomize within age strata to ensure age balance.\n    \"\"\"\n    assignments = np.zeros(len(users_age), dtype=int)\n    \n    # Stratify by age groups\n    age_groups = [(18, 30), (30, 45), (45, 60), (60, 100)]\n    \n    for low, high in age_groups:\n        mask = (users_age >= low) & (users_age < high)\n        n_stratum = mask.sum()\n        \n        # Randomize within this stratum\n        stratum_assignment = np.random.binomial(1, treatment_prob, n_stratum)\n        assignments[mask] = stratum_assignment\n    \n    return assignments\n\n# Example\nnp.random.seed(42)\nn_users = 10000\nuser_ages = np.random.normal(40, 15, n_users).astype(int)\nuser_ages = np.clip(user_ages, 18, 80)\n\nsimple_assign = simple_randomize(n_users)\nstratified_assign = stratified_randomize(user_ages)\n\n# Check balance\nprint(\"Randomization Balance Check:\\n\")\nprint(\"Control/Treatment ratio:\")\nprint(f\"Simple: {simple_assign.mean():.3f} treatment\")\nprint(f\"Stratified: {stratified_assign.mean():.3f} treatment\")\n\nprint(\"\\nAge distribution by assignment:\")\nfor age_low in [20, 30, 40, 50, 60]:\n    age_high = age_low + 10\n    mask = (user_ages >= age_low) & (user_ages < age_high)\n    simple_treatment_pct = simple_assign[mask].mean()\n    stratified_treatment_pct = stratified_assign[mask].mean()\n    print(f\"  Age {age_low}-{age_high}: Simple={simple_treatment_pct:.2f}, Stratified={stratified_treatment_pct:.2f}\")"
        ]
      ]
    },
    {
