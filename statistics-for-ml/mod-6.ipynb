          "python",
          "import numpy as np\nfrom scipy.stats import kruskal, f_oneway\n\n# Example: User satisfaction across 4 app versions\nnp.random.seed(42)\n\nv1 = np.array([3, 4, 2, 4, 3, 2, 3, 4, 5, 2])\nv2 = np.array([4, 5, 4, 3, 5, 4, 4, 5, 4, 3])\nv3 = np.array([5, 5, 4, 5, 4, 5, 5, 4, 5, 4])\nv4 = np.array([2, 3, 2, 1, 2, 3, 2, 2, 1, 3])\n\n# Both tests\nf_stat, f_pval = f_oneway(v1, v2, v3, v4)\nh_stat, h_pval = kruskal(v1, v2, v3, v4)\n\nprint(\"=== Comparing 4 App Versions ===\")\nprint(f\"Version 1: mean={v1.mean():.2f}, median={np.median(v1):.1f}\")\nprint(f\"Version 2: mean={v2.mean():.2f}, median={np.median(v2):.1f}\")\nprint(f\"Version 3: mean={v3.mean():.2f}, median={np.median(v3):.1f}\")\nprint(f\"Version 4: mean={v4.mean():.2f}, median={np.median(v4):.1f}\")\n\nprint(f\"\\nOne-way ANOVA: F={f_stat:.3f}, p={f_pval:.4f}\")\nprint(f\"Kruskal-Wallis: H={h_stat:.3f}, p={h_pval:.4f}\")\nprint(f\"Decision: {'Versions differ significantly' if h_pval < 0.05 else 'No significant difference'}\")"
        ]
      ]
