          "python",
          "import numpy as np\nfrom scipy.stats import chi2_contingency\nimport pandas as pd\n\n# Example: Product preference by customer type\n# Question: Does product preference depend on customer type?\n\n# Contingency table\ndata = np.array([[100, 50],    # Premium customers: 100 prefer A, 50 prefer B\n                 [150, 200]])   # Regular customers: 150 prefer A, 200 prefer B\n\nchi2, p_value, dof, expected = chi2_contingency(data)\n\nprint(\"=== Chi-square Test ===\")\nprint(\"Contingency Table:\")\nprint(f\"          Product A  Product B\")\nprint(f\"Premium      {data[0,0]}         {data[0,1]}\")\nprint(f\"Regular      {data[1,0]}         {data[1,1]}\")\nprint(f\"\\n\u03c7\u00b2 statistic: {chi2:.3f}\")\nprint(f\"p-value: {p_value:.4f}\")\nprint(f\"Degrees of freedom: {dof}\")\nprint(f\"Decision: {'Variables are associated' if p_value < 0.05 else 'No association detected'}\")\n\nprint(f\"\\nExpected frequencies:\")\nprint(expected)"
        ]
