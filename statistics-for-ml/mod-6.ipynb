          "python",
          "import numpy as np\nfrom scipy.stats import ttest_ind, levene\nimport matplotlib.pyplot as plt\n\n# Example: Does exercise improve cognitive performance?\n# Two groups: exercise program (treatment) and control\n\nnp.random.seed(42)\ncontrol = np.random.normal(loc=75, scale=12, size=50)\nexercise = np.random.normal(loc=82, scale=11, size=55)\n\n# Check assumptions\nprint(\"=== Assumption Checks ===\")\n\n# Normality (visual + Shapiro)\nfrom scipy.stats import shapiro\n_, p_norm_control = shapiro(control)\n_, p_norm_exercise = shapiro(exercise)\nprint(f\"Shapiro-Wilk p-value (control): {p_norm_control:.3f}\")\nprint(f\"Shapiro-Wilk p-value (exercise): {p_norm_exercise:.3f}\")\nprint(f\"Normality assumption: {'OK' if p_norm_control > 0.05 and p_norm_exercise > 0.05 else 'Violated'}\")\n\n# Equal variance\nstat, p_levene = levene(control, exercise)\nprint(f\"Levene's test p-value: {p_levene:.3f}\")\nprint(f\"Equal variance assumption: {'OK' if p_levene > 0.05 else 'Violated - use Welch'}\")\n\n# t-test\nt_stat, p_value = ttest_ind(control, exercise, equal_var=True)\nprint(f\"\\n=== Independent t-test ===\")\nprint(f\"Control: mean={control.mean():.2f}, SD={control.std():.2f}, n={len(control)}\")\nprint(f\"Exercise: mean={exercise.mean():.2f}, SD={exercise.std():.2f}, n={len(exercise)}\")\nprint(f\"t-statistic: {t_stat:.3f}\")\nprint(f\"p-value: {p_value:.4f}\")\nprint(f\"Decision: {'Significant difference' if p_value < 0.05 else 'No significant difference'}\")\n\n# Welch's t-test (doesn't assume equal variance)\nt_stat_welch, p_welch = ttest_ind(control, exercise, equal_var=False)\nprint(f\"Welch's t-test (unequal var): t={t_stat_welch:.3f}, p={p_welch:.4f}\")\n\n# Effect size (Cohen's d)\ncohens_d = (exercise.mean() - control.mean()) / np.sqrt(((len(control)-1)*control.std()**2 + \n                                                           (len(exercise)-1)*exercise.std()**2) / \n                                                          (len(control) + len(exercise) - 2))\nprint(f\"Cohen's d: {cohens_d:.3f} ({'small' if abs(cohens_d) < 0.5 else 'medium' if abs(cohens_d) < 0.8 else 'large'})\")\n\n# Visualize\nplt.figure(figsize=(10, 5))\nplt.subplot(1, 2, 1)\nplt.hist(control, bins=15, alpha=0.6, label='Control', edgecolor='black')\nplt.hist(exercise, bins=15, alpha=0.6, label='Exercise', edgecolor='black')\nplt.xlabel('Cognitive Score')\nplt.ylabel('Frequency')\nplt.title('Distribution of Scores by Group')\nplt.legend()\n\nplt.subplot(1, 2, 2)\nplt.boxplot([control, exercise], labels=['Control', 'Exercise'])\nplt.ylabel('Cognitive Score')\nplt.title('Comparison of Group Means')\nplt.grid(axis='y', alpha=0.3)\nplt.tight_layout()\nplt.show()"
        ]
