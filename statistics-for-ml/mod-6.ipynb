          "python",
          "import numpy as np\nfrom scipy.stats import mannwhitneyu, ttest_ind\nimport matplotlib.pyplot as plt\n\n# Example with non-normal data: website load times (right-skewed)\nnp.random.seed(42)\n\n# Control: mostly fast, few slow (right-skewed)\ncontrol = np.concatenate([np.random.exponential(scale=0.5, size=40),\n                          np.random.exponential(scale=3, size=10)])\n\n# Treatment (optimization): improved distribution\ntreatment = np.concatenate([np.random.exponential(scale=0.3, size=45),\n                            np.random.exponential(scale=1.5, size=5)])\n\nprint(\"=== Non-normal Data Example ===\")\nprint(f\"Control: mean={control.mean():.3f}, median={np.median(control):.3f}\")\nprint(f\"Treatment: mean={treatment.mean():.3f}, median={np.median(treatment):.3f}\")\n\n# Both tests\nt_stat, t_pval = ttest_ind(control, treatment)\nu_stat, u_pval = mannwhitneyu(control, treatment, alternative='two-sided')\n\nprint(f\"\\nt-test: t={t_stat:.3f}, p={t_pval:.4f}\")\nprint(f\"Mann-Whitney: U={u_stat:.1f}, p={u_pval:.4f}\")\n\nprint(f\"\\nBoth tests agree: {'Yes' if (t_pval < 0.05) == (u_pval < 0.05) else 'No'}\")\nprint(\"With non-normal data, Mann-Whitney is more reliable\")\n\n# Visualize\nplt.figure(figsize=(12, 4))\n\nplt.subplot(1, 2, 1)\nplt.hist(control, bins=20, alpha=0.6, label='Control', edgecolor='black')\nplt.hist(treatment, bins=20, alpha=0.6, label='Treatment', edgecolor='black')\nplt.xlabel('Load Time (seconds)')\nplt.ylabel('Frequency')\nplt.title('Non-normal Distribution: Load Times')\nplt.legend()\n\nplt.subplot(1, 2, 2)\nplt.boxplot([control, treatment], labels=['Control', 'Treatment'])\nplt.ylabel('Load Time (seconds)')\nplt.title('Load Time Comparison')\nplt.grid(axis='y', alpha=0.3)\nplt.tight_layout()\nplt.show()"
        ]
      ]
