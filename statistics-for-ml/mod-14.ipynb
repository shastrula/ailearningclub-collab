        [
          "python",
          "Type I error (\u03b1): Conclude effect exists when it doesn't (false positive)\nType II error (\u03b2): Conclude no effect when it does (false negative)\nPower = 1 - \u03b2: Correctly detect effect when it exists"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy import stats\nimport matplotlib.pyplot as plt\n\ndef compute_power(n_per_group, baseline_rate, effect_size, alpha=0.05):\n    \"\"\"\n    Compute statistical power for proportions test.\n    \n    Args:\n        n_per_group: sample size per group\n        baseline_rate: control conversion rate\n        effect_size: relative improvement (e.g., 0.20 for 20%)\n        alpha: significance level\n    \n    Returns:\n        power: probability of detecting effect\n    \"\"\"\n    treatment_rate = baseline_rate * (1 + effect_size)\n    \n    # Null distribution: under H0, both groups have baseline_rate\n    se_null = np.sqrt(2 * baseline_rate * (1 - baseline_rate) / n_per_group)\n    \n    # Critical value for two-sided test\n    z_critical = stats.norm.ppf(1 - alpha / 2)\n    \n    # Under alternative hypothesis (true effect exists)\n    diff = treatment_rate - baseline_rate\n    se_alt = np.sqrt(baseline_rate * (1 - baseline_rate) / n_per_group + \n                     treatment_rate * (1 - treatment_rate) / n_per_group)\n    \n    # Probability of exceeding critical value under alternative\n    power = 1 - stats.norm.cdf((z_critical * se_null - diff) / se_alt)\n    \n    return power\n\n# Power curves for different effect sizes\nsample_sizes = np.arange(100, 10000, 100)\nbaseline = 0.10\neffect_sizes = [0.05, 0.10, 0.20, 0.30]\n\nplt.figure(figsize=(10, 6))\nfor effect in effect_sizes:\n    powers = [compute_power(n, baseline, effect) for n in sample_sizes]\n    plt.plot(sample_sizes, powers, label=f'{effect*100:.0f}% effect', linewidth=2)\n\nplt.axhline(0.80, color='r', linestyle='--', alpha=0.5, label='80% power threshold')\nplt.axhline(0.90, color='orange', linestyle='--', alpha=0.5, label='90% power threshold')\nplt.xlabel('Sample Size per Group')\nplt.ylabel('Statistical Power')\nplt.title('Power Curves: Smaller Effects Require Larger Samples')\nplt.legend()\nplt.grid(alpha=0.3)\nplt.ylim([0, 1])\nplt.show()\n\n# Find required sample size for specific power level\ndef find_sample_size_for_power(target_power, baseline_rate, effect_size, alpha=0.05):\n    \"\"\"Binary search for sample size achieving target power.\"\"\"\n    low, high = 10, 100000\n    \n    while high - low > 1:\n        mid = (low + high) // 2\n        power = compute_power(mid, baseline_rate, effect_size, alpha)\n        \n        if power < target_power:\n            low = mid\n        else:\n            high = mid\n    \n    return high\n\nprint(\"Sample Sizes for 80% Power (\u03b1=0.05, baseline=10%):\\n\")\nfor effect in [0.05, 0.10, 0.15, 0.20]:\n    n = find_sample_size_for_power(0.80, baseline, effect)\n    print(f\"{effect*100:3.0f}% effect: {n:6,} per group\")\n\nprint(\"\\nSample Sizes for 90% Power (\u03b1=0.05, baseline=10%):\\n\")\nfor effect in [0.05, 0.10, 0.15, 0.20]:\n    n = find_sample_size_for_power(0.90, baseline, effect)\n    print(f\"{effect*100:3.0f}% effect: {n:6,} per group\")"
        ]
      ]
    },
