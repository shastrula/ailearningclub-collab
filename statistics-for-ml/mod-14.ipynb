          "python",
          "# Simulate metric trajectory: novelty effect, then stabilization\n\nnp.random.seed(42)\nn_days = 60\ndaily_users = 1000\n\n# Control: stable metric\ncontrol_baseline = 0.10\ncontrol_metric = np.random.normal(control_baseline, 0.02, n_days)\n\n# Treatment: temporary novelty boost that wears off\nnovelty_boost = np.exp(-np.arange(n_days) / 10)  # Exponential decay\ntreatment_baseline = 0.10\ntreatment_effect_steady = 0.015  # True 1.5% improvement\ntreatment_metric = treatment_baseline + treatment_effect_steady\ntreatment_metric += novelty_boost * 0.05  # Extra 5% boost initially\ntreatment_metric += np.random.normal(0, 0.02, n_days)\n\n# Cumulative effect estimates by duration\ndurations = [7, 14, 21, 30, 45, 60]\neffects = []\n\nfor duration in durations:\n    control_mean = control_metric[:duration].mean()\n    treatment_mean = treatment_metric[:duration].mean()\n    effect = treatment_mean - control_mean\n    effects.append(effect)\n\n# Visualize\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n# Time series\ndays = np.arange(n_days)\naxes[0].plot(days, control_metric, label='Control', linewidth=2)\naxes[0].plot(days, treatment_metric, label='Treatment (with novelty)', linewidth=2)\naxes[0].axhline(treatment_baseline + treatment_effect_steady, color='orange', \n                linestyle='--', alpha=0.5, label='True steady-state effect')\naxes[0].set_xlabel('Days')\naxes[0].set_ylabel('Metric Value')\naxes[0].legend()\naxes[0].set_title('Novelty Effects: Treatment Effect Decreases Over Time')\naxes[0].grid(alpha=0.3)\n\n# Effect vs duration\naxes[1].plot(durations, effects, marker='o', linewidth=2, markersize=8)\naxes[1].axhline(treatment_effect_steady, color='orange', linestyle='--', \n                alpha=0.5, label='True effect')\naxes[1].set_xlabel('Experiment Duration (days)')\naxes[1].set_ylabel('Estimated Effect')\naxes[1].set_title('Bias from Novelty Effects')\naxes[1].legend()\naxes[1].grid(alpha=0.3)\n\nplt.tight_layout()\nplt.show()\n\nprint(\"Estimated Effects by Duration:\")\nfor duration, effect in zip(durations, effects):\n    pct_inflated = (effect - treatment_effect_steady) / treatment_effect_steady * 100\n    print(f\"{duration:2d} days: {effect:.4f} ({pct_inflated:+6.1f}% vs. true)\")"
        ]
      ]
