          "python",
          "def compute_mde(n_per_group, baseline_rate, power=0.80, alpha=0.05):\n    \"\"\"\n    Compute minimum detectable effect given sample size.\n    \"\"\"\n    z_alpha = stats.norm.ppf(1 - alpha / 2)\n    z_beta = stats.norm.ppf(power)\n    \n    # Solve for effect size\n    # |effect| \u2248 (z_alpha + z_beta) \u00d7 sqrt(p(1-p) / n)\n    se_baseline = np.sqrt(baseline_rate * (1 - baseline_rate) / n_per_group)\n    min_diff = (z_alpha + z_beta) * se_baseline * np.sqrt(2)\n    \n    mde_pct = min_diff / baseline_rate * 100\n    \n    return mde_pct\n\n# MDE for different sample sizes\nsample_sizes = [100, 500, 1000, 5000, 10000]\nbaseline = 0.10\n\nprint(\"Minimum Detectable Effect (MDE) at 80% power, 10% baseline:\\n\")\nfor n in sample_sizes:\n    mde = compute_mde(n, baseline)\n    print(f\"n = {n:5,}: MDE = {mde:5.1f}%\")\n\nprint(\"\\nInsight: 10\u00d7 sample size \u2192 ~3\u00d7 smaller MDE\")\nprint(\"Sample size has diminishing returns (sqrt relationship)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Example: A/B test with revenue metric, stratified by user segment\n\nnp.random.seed(42)\nn_per_group = 1000\n\n# Data: users have base revenue level + treatment effect\nsegments = ['free', 'basic', 'premium']\nsegment_sizes = {'free': 0.60, 'basic': 0.30, 'premium': 0.10}\nsegment_revenue = {'free': 5, 'basic': 20, 'premium': 50}\n\n# Simulate test results\ndef simulate_stratified_test(n_per_group, treatment_effect=0.10):\n    \"\"\"Simulate A/B test with stratification.\"\"\"\n    control_revenue = []\n    treatment_revenue = []\n    strata = []\n    \n    for segment in segments:\n        n_segment = int(n_per_group * segment_sizes[segment])\n        base_revenue = segment_revenue[segment]\n        \n        # Control group\n        control = base_revenue + np.random.normal(0, base_revenue * 0.3, n_segment)\n        control = np.maximum(control, 0)  # Non-negative\n        \n        # Treatment group (with effect)\n        treatment = base_revenue * (1 + treatment_effect) + np.random.normal(0, base_revenue * 0.3, n_segment)\n        treatment = np.maximum(treatment, 0)\n        \n        control_revenue.extend(control)\n        treatment_revenue.extend(treatment)\n        strata.extend([segment] * n_segment)\n    \n    return np.array(control_revenue), np.array(treatment_revenue), strata\n\ncontrol_rev, treatment_rev, strata_labels = simulate_stratified_test(n_per_group, treatment_effect=0.10)\nstrata_arr = np.array(strata_labels)\n\n# Simple analysis (pooled)\nsimple_effect = treatment_rev.mean() - control_rev.mean()\nsimple_se = np.sqrt(treatment_rev.var()/len(treatment_rev) + control_rev.var()/len(control_rev))\nsimple_tstat = simple_effect / simple_se\n\nprint(\"Simple (Pooled) Analysis:\")\nprint(f\"  Effect: ${simple_effect:.2f}\")\nprint(f\"  SE: ${simple_se:.2f}\")\nprint(f\"  t-stat: {simple_tstat:.3f}\\n\")\n\n# ANCOVA: regression controlling for segment\nfrom sklearn.linear_model import LinearRegression\n\n# Create segment dummies\nsegment_map = {s: i for i, s in enumerate(segments)}\nsegment_dummies = np.array([segment_map[s] for s in strata_labels]).reshape(-1, 1)\ntreatment_indicator = np.concatenate([np.zeros(n_per_group), np.ones(n_per_group)])\nsegment_dummies_full = np.concatenate([segment_dummies, segment_dummies])\n\nX = np.column_stack([treatment_indicator, segment_dummies_full])\ny = np.concatenate([control_rev, treatment_rev])\n\nmodel = LinearRegression()\nmodel.fit(X, y)\n\nancova_effect = model.coef_[0]  # Treatment coefficient\nancova_se = np.sqrt(np.sum((y - model.predict(X))**2) / (len(y) - X.shape[1]) * \n                    np.linalg.inv(X.T @ X)[0, 0])\n\nprint(\"ANCOVA (Controlling for Segment):\")\nprint(f\"  Effect: ${ancova_effect:.2f}\")\nprint(f\"  SE: ${ancova_se:.2f}\")\nprint(f\"  Variance reduction: {(1 - (ancova_se/simple_se)**2)*100:.1f}%\\n\")\n\n# Stratified analysis\nprint(\"Stratified Analysis (Effect by Segment):\")\nfor segment in segments:\n    mask = strata_arr == segment\n    eff = treatment_rev[mask].mean() - control_rev[mask].mean()\n    n = mask.sum() // 2\n    se = np.sqrt(treatment_rev[mask].var()/n + control_rev[mask].var()/n)\n    print(f\"  {segment:8s}: ${eff:6.2f} (n={n}, SE=${se:.2f})\")"
        ]
