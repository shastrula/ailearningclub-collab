          "python",
          "# Simulate A/B test with network spillover\n\ndef simulate_network_effect(n_users=1000, n_days=30, network_density=0.01):\n    \"\"\"\n    Simulate sharing behavior with network effects.\n    \n    When user is treated, they share more.\n    Untreated friends of treated users see boosted content.\n    \"\"\"\n    np.random.seed(42)\n    \n    # Create friendship network (sparse)\n    friend_matrix = np.random.random((n_users, n_users)) < network_density\n    np.fill_diagonal(friend_matrix, False)\n    \n    # Random treatment assignment\n    treated = np.random.random(n_users) < 0.5\n    \n    # Sharing metric: treatment increases baseline sharing\n    baseline_share = 0.1\n    treatment_effect = 0.05\n    \n    # Direct effect: treated users share more\n    direct_shares = treated * treatment_effect\n    \n    # Indirect effect: friends of treated share more\n    # (they see more content from treated friends)\n    spillover_effect = 0.02  # 2% boost from friends' treatment\n    indirect_shares = (friend_matrix @ treated) > 0  # Has \u22651 treated friend\n    indirect_shares = indirect_shares.astype(float) * spillover_effect * (~treated)\n    \n    # Total effect\n    shares = baseline_share + direct_shares + indirect_shares\n    shares += np.random.normal(0, 0.02, n_users)\n    \n    return shares, treated, direct_shares, indirect_shares\n\nshares, treated, direct, indirect = simulate_network_effect()\n\n# Simple intention-to-treat: treat all treated vs all control\ncontrol_mean = shares[~treated].mean()\ntreatment_mean = shares[treated].mean()\nsimple_effect = treatment_mean - control_mean\n\n# Decompose effect\ndirect_only = direct[treated].mean()\n\nprint(\"Network Interference Effects:\")\nprint(f\"Observed treatment effect (ITT): {simple_effect:.4f}\")\nprint(f\"Direct effect (treatment group): {direct_only:.4f}\")\nprint(f\"Spillover into control: {indirect.sum() / (~treated).sum():.4f} (per control user)\")\nprint(f\"\\nIssue: Treatment effect is inflated due to spillover\")\nprint(f\"Solution: Cluster randomization (randomize clusters, not individuals)\")"
        ]
      ]
    }
