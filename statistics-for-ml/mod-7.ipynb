          "python",
          "import numpy as np\nfrom scipy import stats\nimport matplotlib.pyplot as plt\n\n# Example: Estimate average customer satisfaction (scale 1-10)\ndata = np.array([7, 8, 6, 9, 7, 8, 5, 9, 8, 7, 8, 6, 9, 7, 8,\n                 8, 7, 9, 6, 8, 7, 8, 9, 7, 8])\n\nmean = data.mean()\nsem = stats.sem(data)  # Standard error of mean\nci_95 = stats.t.interval(0.95, len(data)-1, loc=mean, scale=sem)\n\nprint(\"=== Confidence Interval Example ===\")\nprint(f\"Sample size: {len(data)}\")\nprint(f\"Sample mean: {mean:.2f}\")\nprint(f\"Standard deviation: {data.std():.2f}\")\nprint(f\"Standard error: {sem:.3f}\")\nprint(f\"95% CI: [{ci_95[0]:.2f}, {ci_95[1]:.2f}]\")\n\nprint(f\"\\nInterpretation: We're 95% confident the true mean\")\nprint(f\"satisfaction is between {ci_95[0]:.2f} and {ci_95[1]:.2f}\")\n\n# Test vs CI: is true mean = 7?\nnull_value = 7\ncontains_null = ci_95[0] <= null_value <= ci_95[1]\nprint(f\"\\nDoes CI contain null value (7.0)? {contains_null}\")\n\n# Hypothesis test\nt_stat = (mean - null_value) / sem\np_value = 2 * stats.t.sf(abs(t_stat), len(data) - 1)\nprint(f\"Hypothesis test p-value: {p_value:.4f}\")\nprint(f\"Decision: {'Fail to reject' if p_value > 0.05 else 'Reject'} H\u2080\")\nprint(f\"Both methods agree: {(not contains_null) == (p_value < 0.05)}\")\n\n# Visualize multiple CI samples\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))\n\n# Single CI highlighted\nax1.errorbar(1, mean, yerr=np.array([[mean - ci_95[0]], [ci_95[1] - mean]]),\n             fmt='o', markersize=8, capsize=10, capthick=2, linewidth=2, label='95% CI')\nax1.axhline(7, color='r', linestyle='--', linewidth=2, label='Null value (7.0)')\nax1.set_xlim([0.5, 1.5])\nax1.set_ylim([5, 10])\nax1.set_ylabel('Satisfaction Score')\nax1.set_title('Confidence Interval Example')\nax1.set_xticks([])\nax1.legend()\nax1.grid(axis='y', alpha=0.3)\n\n# Bootstrap CI (alternative approach)\nn_boot = 10000\nboot_means = []\nfor _ in range(n_boot):\n    boot_sample = np.random.choice(data, size=len(data), replace=True)\n    boot_means.append(boot_sample.mean())\n\nboot_means = np.array(boot_means)\nboot_ci = np.percentile(boot_means, [2.5, 97.5])\n\nax2.hist(boot_means, bins=30, edgecolor='black', alpha=0.7)\nax2.axvline(boot_ci[0], color='r', linestyle='--', linewidth=2, label=f'Bootstrap CI: [{boot_ci[0]:.2f}, {boot_ci[1]:.2f}]')\nax2.axvline(boot_ci[1], color='r', linestyle='--', linewidth=2)\nax2.axvline(mean, color='g', linestyle='-', linewidth=2, label=f'Sample mean: {mean:.2f}')\nax2.set_xlabel('Sample Mean')\nax2.set_ylabel('Frequency')\nax2.set_title('Bootstrap Distribution of Mean')\nax2.legend()\n\nplt.tight_layout()\nprint(f\"\\nBootstrap 95% CI: [{boot_ci[0]:.2f}, {boot_ci[1]:.2f}]\")\nprint(f\"Parametric CI: [{ci_95[0]:.2f}, {ci_95[1]:.2f}]\")"
