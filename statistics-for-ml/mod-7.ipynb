          "python",
          "import numpy as np\nfrom scipy.stats import ttest_ind\n\n# Scenario: Small effect with large sample (statistically significant, practically meaningless)\n# vs large effect with small sample (not statistically significant, practically meaningful)\n\nnp.random.seed(42)\n\n# Scenario 1: Huge sample, tiny effect\nn_huge = 10000\ngroup1_huge = np.random.normal(100, 15, n_huge)\ngroup2_huge = np.random.normal(100.5, 15, n_huge)  # Only 0.5 point difference!\n\nt1, p1 = ttest_ind(group1_huge, group2_huge)\ncohens_d1 = (group2_huge.mean() - group1_huge.mean()) / 15\n\nprint(\"=== Scenario 1: Large n, Small Effect ===\")\nprint(f\"Group 1: mean={group1_huge.mean():.2f}\")\nprint(f\"Group 2: mean={group2_huge.mean():.2f}\")\nprint(f\"Difference: {group2_huge.mean() - group1_huge.mean():.2f}\")\nprint(f\"Cohen's d: {cohens_d1:.4f} (negligible)\")\nprint(f\"t-statistic: {t1:.3f}\")\nprint(f\"p-value: {p1:.6f} (highly significant!)\")\nprint(\"Conclusion: Statistically significant but practically meaningless\")\n\n# Scenario 2: Small sample, large effect\nn_small = 20\ngroup1_small = np.random.normal(100, 15, n_small)\ngroup2_small = np.random.normal(115, 15, n_small)  # 15 point difference\n\nt2, p2 = ttest_ind(group1_small, group2_small)\ncohens_d2 = (group2_small.mean() - group1_small.mean()) / 15\n\nprint(\"\\n=== Scenario 2: Small n, Large Effect ===\")\nprint(f\"Group 1: mean={group1_small.mean():.2f}\")\nprint(f\"Group 2: mean={group2_small.mean():.2f}\")\nprint(f\"Difference: {group2_small.mean() - group1_small.mean():.2f}\")\nprint(f\"Cohen's d: {cohens_d2:.4f} (large)\")\nprint(f\"t-statistic: {t2:.3f}\")\nprint(f\"p-value: {p2:.4f} (not quite significant at 0.05)\")\nprint(\"Conclusion: Not statistically significant but practically meaningful\")\nprint(\"\\nLessons:\")\nprint(\"1. Large samples make tiny effects 'significant'\")\nprint(\"2. Small samples can hide real effects\")\nprint(\"3. Always report effect size alongside p-values\")"
        ]
