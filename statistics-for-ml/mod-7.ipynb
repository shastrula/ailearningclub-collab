          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.stats import spearmanr\n\n# Example: Bootstrap CI for correlation coefficient\nnp.random.seed(42)\nn = 30\n\n# Generate correlated data\nx = np.random.normal(0, 1, n)\ny = x + np.random.normal(0, 0.5, n)\n\n# Observed correlation\nobs_corr = np.corrcoef(x, y)[0, 1]\n\n# Bootstrap CIs for different correlations\nn_boot = 10000\nboot_corr = []\n\nfor _ in range(n_boot):\n    idx = np.random.choice(n, size=n, replace=True)\n    x_boot = x[idx]\n    y_boot = y[idx]\n    boot_corr.append(np.corrcoef(x_boot, y_boot)[0, 1])\n\nboot_corr = np.array(boot_corr)\nci_lower = np.percentile(boot_corr, 2.5)\nci_upper = np.percentile(boot_corr, 97.5)\n\nprint(\"=== Bootstrap CI for Correlation ===\")\nprint(f\"Observed correlation: {obs_corr:.3f}\")\nprint(f\"Bootstrap 95% CI: [{ci_lower:.3f}, {ci_upper:.3f}]\")\nprint(f\"CI width: {ci_upper - ci_lower:.3f}\")\n\n# Visualize\nplt.figure(figsize=(10, 5))\nplt.hist(boot_corr, bins=40, edgecolor='black', alpha=0.7)\nplt.axvline(obs_corr, color='g', linestyle='-', linewidth=2, label=f'Observed: {obs_corr:.3f}')\nplt.axvline(ci_lower, color='r', linestyle='--', linewidth=2, label=f'CI: [{ci_lower:.3f}, {ci_upper:.3f}]')\nplt.axvline(ci_upper, color='r', linestyle='--', linewidth=2)\nplt.xlabel('Bootstrap Correlation Coefficient')\nplt.ylabel('Frequency')\nplt.title('Bootstrap Distribution for Correlation')\nplt.legend()"
