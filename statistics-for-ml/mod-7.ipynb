          "python",
          "import numpy as np\nfrom scipy.stats import norm, ttest_ind\nimport matplotlib.pyplot as plt\n\n# Simulate p-hacking: test 100 hypotheses on random data (all nulls true)\nnp.random.seed(42)\nn_tests = 100\nn_samples = 50\n\np_values = []\nfor i in range(n_tests):\n    group1 = np.random.normal(0, 1, size=n_samples)\n    group2 = np.random.normal(0, 1, size=n_samples)\n    _, p = ttest_ind(group1, group2)\n    p_values.append(p)\n\np_values = np.array(p_values)\n\n# Multiple testing corrections\nalpha = 0.05\nbonferroni_thresh = alpha / n_tests\nholm_thresh = alpha / np.arange(1, n_tests + 1)\n\n# Count rejections\nuncorrected_rejections = np.sum(p_values < alpha)\nbonferroni_rejections = np.sum(p_values < bonferroni_thresh)\n\nprint(\"=== Multiple Testing Problem ===\")\nprint(f\"Number of tests: {n_tests}\")\nprint(f\"All null hypotheses TRUE (no real effects)\")\nprint(f\"Significance level: \u03b1 = {alpha}\")\nprint(f\"\\nUncorrected: {uncorrected_rejections} false positives (expected ~{n_tests * alpha:.1f})\")\nprint(f\"Bonferroni: {bonferroni_rejections} false positives\")\nprint(f\"Bonferroni threshold: p < {bonferroni_thresh:.6f}\")\n\n# Visualization\nplt.figure(figsize=(10, 5))\nplt.subplot(1, 2, 1)\nplt.hist(p_values, bins=30, edgecolor='black', alpha=0.7)\nplt.axvline(alpha, color='r', linestyle='--', linewidth=2, label=f'\u03b1 = {alpha}')\nplt.axvline(bonferroni_thresh, color='g', linestyle='--', linewidth=2, label=f'Bonferroni = {bonferroni_thresh:.6f}')\nplt.xlabel('P-value')\nplt.ylabel('Frequency')\nplt.title('P-value Distribution Under Multiple Testing')\nplt.legend()\n\nplt.subplot(1, 2, 2)\nplt.scatter(range(len(p_values)), np.sort(p_values), alpha=0.6)\nplt.axhline(alpha, color='r', linestyle='--', label='Uncorrected \u03b1')\nplt.axhline(bonferroni_thresh, color='g', linestyle='--', label='Bonferroni \u03b1')\nplt.xlabel('Test Index (sorted)')\nplt.ylabel('P-value')\nplt.title('Sorted P-values vs Thresholds')\nplt.legend()\nplt.tight_layout()\nprint(\"\\nVisualization shows the multiple testing problem clearly\")"
