          "python",
          "from scipy.stats import norm\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Normal distribution, \u03bc=100, \u03c3=15 (like IQ scores)\nmu, sigma = 100, 15\ndist = norm(mu, sigma)\n\n# Probability of score below 85\nprob_below_85 = dist.cdf(85)\nprint(f\"P(X < 85) = {prob_below_85:.4f}\")\n\n# 95% confidence interval\nci_lower = dist.ppf(0.025)  # 2.5th percentile\nci_upper = dist.ppf(0.975)  # 97.5th percentile\nprint(f\"95% CI: [{ci_lower:.1f}, {ci_upper:.1f}]\")\n\n# Generate samples\nsamples = np.random.normal(mu, sigma, 10000)\nprint(f\"Sample mean: {samples.mean():.1f}\")\nprint(f\"Sample std: {samples.std():.1f}\")\n\n# Visualization\nx = np.linspace(mu - 4*sigma, mu + 4*sigma, 100)\nplt.plot(x, dist.pdf(x), label='PDF')\nplt.fill_between(x, dist.pdf(x), alpha=0.3)\nplt.xlabel('Score')\nplt.ylabel('Density')\nplt.title('Normal Distribution (\u03bc=100, \u03c3=15)')\nplt.legend()"
        ]
