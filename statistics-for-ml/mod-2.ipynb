          "python",
          "from scipy.stats import bernoulli\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Create Bernoulli distribution with p=0.15\np = 0.15\ndist = bernoulli(p)\n\n# Generate samples\nsamples = dist.rvs(size=1000)\nprint(f\"Proportion of 1s: {samples.mean():.3f}\")\nprint(f\"Expected value: {dist.mean():.3f}\")\nprint(f\"Variance: {dist.var():.3f}\")\n\n# PMF\nx = [0, 1]\npmf = [dist.pmf(k) for k in x]\nplt.bar(x, pmf)\nplt.xlabel('Outcome')\nplt.ylabel('Probability')\nplt.title('Bernoulli Distribution (p=0.15)')\nplt.xticks([0, 1])"
        ]
      ]
