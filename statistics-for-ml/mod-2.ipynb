        [
          "python",
          "from scipy.stats import poisson\nimport numpy as np\n\nlambda_param = 3\ndist = poisson(lambda_param)\n\n# P(exactly 5 emails)\nprob_5 = dist.pmf(5)\nprint(f\"P(X=5 | \u03bb=3) = {prob_5:.4f}\")\n\n# P(at least 1)\nprob_at_least_1 = 1 - dist.pmf(0)\nprint(f\"P(X >= 1) = {prob_at_least_1:.4f}\")\n\n# Generate month (30 days) of data\ndaily_emails = dist.rvs(size=30)\nprint(f\"A={int(daily_emails.sum())} emails\")\nprint(f\"Average per day: {daily_emails.mean():.2f}\")"
        ]
      ]
