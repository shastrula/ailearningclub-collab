          "python",
          "from scipy.stats import poisson, binom, norm\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Scenario 1: Poisson (tickets arrive randomly, \u03bb=5)\npoisson_dist = poisson(mu=5)\ntickets_poisson = poisson_dist.rvs(size=1000)\n\n# Scenario 2: Binomial (100 customers, each 5% chance to submit, p=0.05)\nbinom_dist = binom(n=100, p=0.05)\ntickets_binom = binom_dist.rvs(size=1000)\n\n# Scenario 3: Normal approximation (mean=5, std=sqrt(5))\nnorm_dist = norm(loc=5, scale=np.sqrt(5))\ntickets_norm = norm_dist.rvs(size=1000)\n\n# Compare distributions\nfig, axes = plt.subplots(1, 3, figsize=(15, 4))\n\nfor ax, data, title in zip(axes, \n                           [tickets_poisson, tickets_binom, tickets_norm],\n                           ['Poisson', 'Binomial', 'Normal']):\n    ax.hist(data, bins=20, density=True, alpha=0.7)\n    ax.set_title(f'{title}\\nmean={data.mean():.2f}, std={data.std():.2f}')\n    ax.set_xlabel('Tickets per hour')\n    ax.set_ylabel('Frequency')\n\nprint(\"Poisson - mean:\", tickets_poisson.mean(), \"std:\", tickets_poisson.std())\nprint(\"Binomial - mean:\", tickets_binom.mean(), \"std:\", tickets_binom.std())\nprint(\"Normal - mean:\", tickets_norm.mean(), \"std:\", tickets_norm.std())"
        ]
      ]
    }
