        [
          "python",
          "from scipy.stats import binom\nimport numpy as np\n\n# Binomial: 100 coin flips, p=0.5\nn, p = 100, 0.5\ndist = binom(n, p)\n\n# Probability of exactly 55 heads\nprob_55 = dist.pmf(55)\nprint(f\"P(X=55 | n=100, p=0.5) = {prob_55:.4f}\")\n\n# Cumulative: P(X <= 45)\nprob_leq_45 = dist.cdf(45)\nprint(f\"P(X <= 45) = {prob_leq_45:.4f}\")\n\n# Generate samples\nsamples = dist.rvs(size=10000)\nprint(f\"Sample mean: {samples.mean():.2f} (expected: {dist.mean():.2f})\")\nprint(f\"Sample variance: {samples.var():.2f} (expected: {dist.var():.2f})\")"
        ]
      ]
