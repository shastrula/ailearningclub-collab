          "python",
          "import numpy as np\nfrom scipy.stats import multivariate_normal\nimport matplotlib.pyplot as plt\n\n# Joint distribution: bivariate normal\nmean = [100, 50]\ncov = [[15**2, 150],\n       [150, 10**2]]\n\ndist = multivariate_normal(mean=mean, cov=cov)\n\n# Generate samples\nsamples = dist.rvs(size=5000)\n\n# Marginal distributions\nx_samples = samples[:, 0]\ny_samples = samples[:, 1]\n\nprint(f\"X: mean={x_samples.mean():.1f}, std={x_samples.std():.1f}\")\nprint(f\"Y: mean={y_samples.mean():.1f}, std={y_samples.std():.1f}\")\n\n# Visualize\nfig, axes = plt.subplots(1, 3, figsize=(15, 4))\n\n# Joint scatter\naxes[0].scatter(x_samples, y_samples, alpha=0.5, s=10)\naxes[0].set_xlabel('X')\naxes[0].set_ylabel('Y')\naxes[0].set_title('Joint Distribution')\n\n# Marginal X\naxes[1].hist(x_samples, bins=30, density=True, alpha=0.7)\naxes[1].set_xlabel('X')\naxes[1].set_title('Marginal Distribution of X')\n\n# Marginal Y\naxes[2].hist(y_samples, bins=30, density=True, alpha=0.7)\naxes[2].set_xlabel('Y')\naxes[2].set_title('Marginal Distribution of Y')"
