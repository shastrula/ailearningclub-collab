          "python",
          "import numpy as np\nfrom scipy.stats import norm, uniform\nimport matplotlib.pyplot as plt\n\n# Simple copula example: Clayton copula\n# Generates correlated data with specified structure\n\n# Clayton copula parameter (theta > 0 for positive dependence)\ntheta = 2\n\n# Generate copula samples (uniform [0,1] on margins)\nn_samples = 1000\nu = np.random.uniform(0, 1, size=n_samples)\nv_base = np.random.uniform(0, 1, size=n_samples)\n\n# Clayton copula transformation\n# v = u^(-theta) * (v_base^(-theta/(1+theta)) - 1)^(-1/theta)\nv = (u**(-theta) * (v_base**(-theta/(1+theta)) - 1))**(-1/theta)\n\n# Now (u, v) follow Clayton copula distribution\n# Transform to any marginals we want\n\n# Marginal 1: Normal(100, 15)\nx = norm.ppf(u, loc=100, scale=15)\n\n# Marginal 2: Exponential(2)\ny = -2 * np.log(v)  # Exponential quantile\n\n# Plot\nfig, axes = plt.subplots(1, 3, figsize=(15, 4))\n\n# Copula (uniform margins)\naxes[0].scatter(u, v, alpha=0.5, s=10)\naxes[0].set_xlabel('U')\naxes[0].set_ylabel('V')\naxes[0].set_title('Clayton Copula (\u03b8=2)')\naxes[0].set_xlim([0, 1])\naxes[0].set_ylim([0, 1])\n\n# With Normal and Exponential marginals\naxes[1].scatter(x, y, alpha=0.5, s=10)\naxes[1].set_xlabel('X ~ Normal(100, 15)')\naxes[1].set_ylabel('Y ~ Exponential(2)')\naxes[1].set_title('Clayton Copula with Different Marginals')\n\n# Check correlation\naxes[2].text(0.1, 0.9, f'Correlation: {np.corrcoef(x, y)[0, 1]:.3f}', \n             transform=axes[2].transAxes, fontsize=12)\naxes[2].text(0.1, 0.7, f'Clayton \u03b8={theta} creates\\nstrong positive dependence', \n             transform=axes[2].transAxes, fontsize=11)\naxes[2].axis('off')\n\nprint(f\"Correlation between x and y: {np.corrcoef(x, y)[0, 1]:.3f}\")\nprint(\"Same dependence structure (Clayton copula) applied to different marginals\")"
