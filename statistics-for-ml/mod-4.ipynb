          "python",
          "import numpy as np\nfrom scipy.stats import multivariate_normal\nimport matplotlib.pyplot as plt\n\n# Sales data: marketing spend (X) and sales revenue (Y)\nmean = [1000, 10000]  # avg spend $1000, avg sales $10k\n# Covariance: positive correlation\ncov = [[100**2, 0.8*100*1000],\n       [0.8*100*1000, 1000**2]]\n\ndist = multivariate_normal(mean=mean, cov=cov)\nsamples = dist.rvs(size=1000)\n\nspend = samples[:, 0]\nrevenue = samples[:, 1]\n\n# Law of Iterated Expectations verification\n# Overall mean revenue\noverall_mean = revenue.mean()\n\n# Conditional means for spend buckets\nspend_low = spend < 900\nspend_high = spend >= 900\n\ncond_mean_low = revenue[spend_low].mean()\ncond_mean_high = revenue[spend_high].mean()\n\n# Average of conditional means\navg_cond_means = (spend_low.sum() / len(spend)) * cond_mean_low + \\\n                 (spend_high.sum() / len(spend)) * cond_mean_high\n\nprint(f\"Overall mean revenue: ${overall_mean:.0f}\")\nprint(f\"Average of conditional means: ${avg_cond_means:.0f}\")\nprint(f\"Law of Iterated Expectations verified: {np.isclose(overall_mean, avg_cond_means)}\")\n\n# Conditional means more informative\nprint(f\"\\nConditional forecasting:\")\nprint(f\"If spend < $900, expect revenue: ${cond_mean_low:.0f}\")\nprint(f\"If spend >= $900, expect revenue: ${cond_mean_high:.0f}\")"
        ]
      ]
