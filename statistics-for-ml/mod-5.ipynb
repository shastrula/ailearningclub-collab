          "import numpy as np\nfrom scipy.stats import ttest_1samp, ttest_ind\nimport matplotlib.pyplot as plt\n\n# Scenario: 30 students took exam before tutoring, then after\n# Question: Did tutoring improve scores?\n\n# Data\nbefore = np.array([68, 72, 71, 65, 69, 74, 73, 70, 67, 72,\n                   71, 69, 68, 75, 70, 66, 73, 71, 69, 70,\n                   68, 72, 74, 67, 71, 69, 72, 70, 68, 73])\n\nafter = np.array([72, 76, 74, 68, 73, 78, 77, 74, 71, 76,\n                  75, 73, 72, 79, 74, 70, 77, 75, 73, 74,\n                  72, 76, 78, 71, 75, 73, 76, 74, 72, 77])\n\n# Differences\ndiff = after - before\n\n# Descriptive statistics\nprint(\"=== Descriptive Statistics ===\")\nprint(f\"Before: mean={before.mean():.2f}, std={before.std():.2f}\")\nprint(f\"After: mean={after.mean():.2f}, std={after.std():.2f}\")\nprint(f\"Difference: mean={diff.mean():.2f}, std={diff.std():.2f}\")\n\n# Hypothesis test: paired t-test\n# H\u2080: \u03bc_diff = 0 (no change)\n# H\u2081: \u03bc_diff > 0 (improvement)\n\nt_stat, pval_two_sided = ttest_1samp(diff, 0)\npval_one_sided = pval_two_sided / 2  # Right-sided test\n\nprint(\"\\n=== Hypothesis Test ===\")\nprint(f\"H\u2080: Tutoring has no effect (\u03bc_diff = 0)\")\nprint(f\"H\u2081: Tutoring improves scores (\u03bc_diff > 0)\")\nprint(f\"t-statistic: {t_stat:.3f}\")\nprint(f\"p-value (one-sided): {pval_one_sided:.4f}\")\nprint(f\"Significance level: \u03b1 = 0.05\")\n\nif pval_one_sided < 0.05:\n    print(f\"\\nDecision: REJECT H\u2080\")\n    print(f\"Conclusion: Tutoring significantly improves exam scores (p={pval_one_sided:.4f})\")\nelse:\n    print(f\"\\nDecision: FAIL TO REJECT H\u2080\")\n    print(f\"Conclusion: Insufficient evidence that tutoring improves scores (p={pval_one_sided:.4f})\")\n\n# Visualize\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\n# Box plot\naxes[0].boxplot([before, after], labels=['Before', 'After'])\naxes[0].set_ylabel('Exam Score')\naxes[0].set_title('Tutoring Effect on Exam Scores')\naxes[0].grid(axis='y', alpha=0.3)\n\n# Distribution of differences\naxes[1].hist(diff, bins=15, edgecolor='black', alpha=0.7)\naxes[1].axvline(0, color='r', linestyle='--', linewidth=2, label='Null value (0)')\naxes[1].axvline(diff.mean(), color='g', linestyle='-', linewidth=2, label=f'Observed mean ({diff.mean():.2f})')\naxes[1].set_xlabel('Score Difference (After - Before)')\naxes[1].set_ylabel('Frequency')\naxes[1].set_title('Distribution of Score Differences')\naxes[1].legend()\n\nprint(\"\\n=== Effect Size ===\")\ncohens_d = diff.mean() / diff.std()\nprint(f\"Cohen's d: {cohens_d:.3f}\")\nif abs(cohens_d) < 0.2:\n    magnitude = \"negligible\"\nelif abs(cohens_d) < 0.5:\n    magnitude = \"small\"\nelif abs(cohens_d) < 0.8:\n    magnitude = \"medium\"\nelse:\n    magnitude = \"large\"\nprint(f\"Effect size: {magnitude}\")"
