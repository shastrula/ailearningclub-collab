          "python",
          "import numpy as np\nfrom scipy import stats\nfrom scipy.stats import ttest_ind, norm\n\n# Power calculation: comparing two means\n# H\u2080: \u03bc\u2081 = \u03bc\u2082\n# H\u2081: \u03bc\u2081 \u2260 \u03bc\u2082\n\n# Scenario: Testing if new model improves accuracy\n# Baseline accuracy: 70%, new model: 75% (effect size = 5%)\n# Standard deviation: 15%\n\nmean_baseline = 70\nmean_new = 75\nstd_dev = 15\nalpha = 0.05\n\n# Calculate effect size (Cohen's d)\ncohens_d = (mean_new - mean_baseline) / std_dev\nprint(f\"Cohen's d (effect size): {cohens_d:.3f}\")\n\n# For two-sided test with different sample sizes\nsample_sizes = [20, 50, 100, 200, 500]\npowers = []\n\nfor n in sample_sizes:\n    # Standard error\n    se = std_dev / np.sqrt(n)\n    \n    # Critical value for two-sided test\n    z_crit = norm.ppf(1 - alpha/2)\n    \n    # Non-centrality parameter\n    ncp = (mean_new - mean_baseline) / se\n    \n    # Power: P(reject | H\u2081 true)\n    # Using non-central normal distribution\n    power = 1 - norm.cdf(z_crit, loc=ncp) + norm.cdf(-z_crit, loc=ncp)\n    powers.append(power)\n    \n    print(f\"n={n:3d}: power={power:.3f}\")\n\n# Simulation: verify power by simulation\ndef simulate_power(n, mean1, mean2, std, alpha=0.05, n_sims=10000):\n    rejections = 0\n    for _ in range(n_sims):\n        sample1 = np.random.normal(mean1, std, size=n)\n        sample2 = np.random.normal(mean2, std, size=n)\n        _, pval = ttest_ind(sample1, sample2)\n        if pval < alpha:\n            rejections += 1\n    return rejections / n_sims\n\nprint(\"\\nPower by simulation (n=100):\")\nsim_power = simulate_power(100, mean_baseline, mean_new, std_dev)\nprint(f\"Simulated power: {sim_power:.3f}\")"
        ]
      ]
    },
