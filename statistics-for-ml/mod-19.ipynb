          "python",
          "import numpy as np\nfrom scipy import stats\nimport matplotlib.pyplot as plt\n\n# CLT: sample mean of non-normal distribution \u2192 normal\nnp.random.seed(42)\n\n# Exponential samples (highly skewed, non-normal)\nn_samples = 10000\nn_per_batch = 50\nbatch_means = []\n\nfor _ in range(n_samples):\n    batch = np.random.exponential(scale=2, size=n_per_batch)\n    batch_means.append(batch.mean())\n\nbatch_means = np.array(batch_means)\n\n# Plot histogram vs normal distribution\nplt.figure(figsize=(10, 5))\nplt.hist(batch_means, bins=50, density=True, alpha=0.7, edgecolor='black', label='Batch means')\n\n# Overlay theoretical normal\nmu, sigma = 2, 2 / np.sqrt(n_per_batch)\nx = np.linspace(batch_means.min(), batch_means.max(), 100)\nplt.plot(x, stats.norm.pdf(x, mu, sigma), 'r-', linewidth=2, label=f'N({mu:.2f}, {sigma:.3f}\u00b2)')\n\nplt.xlabel('Sample mean')\nplt.ylabel('Density')\nplt.title('CLT: Exponential samples, n=50 per batch')\nplt.legend()\nplt.grid()\nplt.show()\n\n# Shapiro-Wilk test: are batch means approximately normal?\nstat, p_value = stats.shapiro(batch_means)\nprint(f\"Shapiro-Wilk test p-value: {p_value:.4f}\")\nprint(f\"Batch means approximately normal: {p_value > 0.05}\")"
        ]
