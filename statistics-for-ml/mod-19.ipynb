          "python",
          "import numpy as np\nfrom scipy import stats\n\n# X ~ N(0, 1), Y ~ N(0, 1), independent\n# X + Y ~ N(0, 2)\n\n# Verify using characteristic functions\ndef char_normal(t, mu, sigma):\n    return np.exp(1j * mu * t - 0.5 * sigma**2 * t**2)\n\n# Char func of X + Y = \u03c6X(t) \u00d7 \u03c6Y(t)\nt = 2.0\nphi_X = char_normal(t, 0, 1)\nphi_Y = char_normal(t, 0, 1)\nphi_sum_theory = phi_X * phi_Y\n\n# This should equal \u03c6(X+Y)(t) where X+Y ~ N(0, 2)\nphi_sum_actual = char_normal(t, 0, np.sqrt(2))\n\nprint(f\"\u03c6X(t) \u00d7 \u03c6Y(t) = {phi_sum_theory}\")\nprint(f\"\u03c6(X+Y)(t) for N(0,2) = {phi_sum_actual}\")\nprint(f\"Equal: {np.isclose(phi_sum_theory, phi_sum_actual)}\")"
        ]
      ]
