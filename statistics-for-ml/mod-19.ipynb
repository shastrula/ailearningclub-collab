          "python",
          "import numpy as np\nfrom scipy import stats\nimport matplotlib.pyplot as plt\n\n# Generate maxima from exponential samples\nnp.random.seed(42)\nn_samples = 10000\nn_block = 100  # Block size\nmaxima = []\n\nfor _ in range(n_samples):\n    block = np.random.exponential(scale=1, size=n_block)\n    maxima.append(np.max(block))\n\nmaxima = np.array(maxima)\n\n# Fit Gumbel distribution (type 1 extreme value)\nparams = stats.gumbel_r.fit(maxima)\nloc, scale = params\n\n# Plot histogram vs Gumbel fit\nplt.figure(figsize=(10, 5))\nplt.hist(maxima, bins=50, density=True, alpha=0.7, edgecolor='black', label='Observed maxima')\n\nx = np.linspace(maxima.min(), maxima.max(), 100)\nplt.plot(x, stats.gumbel_r.pdf(x, loc, scale), 'r-', linewidth=2, label=f'Gumbel fit')\n\nplt.xlabel('Value')\nplt.ylabel('Density')\nplt.title('Extreme Value Distribution: Maxima of exponential samples')\nplt.legend()\nplt.grid()\nplt.show()\n\nprint(f\"Gumbel fit: location={loc:.3f}, scale={scale:.3f}\")\nprint(f\"99th percentile of maxima: {np.percentile(maxima, 99):.3f}\")\nprint(f\"Theoretical 99th percentile: {stats.gumbel_r.ppf(0.99, loc, scale):.3f}\")"
        ]
