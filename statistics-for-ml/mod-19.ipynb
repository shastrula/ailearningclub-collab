          "python",
          "import numpy as np\n\n# Demonstrate SLLN: sample mean \u2192 true mean with probability 1\nnp.random.seed(42)\nn_trials = 1000\nn_max = 10000\n\n# Single realization\ncumsum = 0\nrunning_mean = []\n\nfor i in range(n_max):\n    X = np.random.exponential(scale=5)\n    cumsum += X\n    running_mean.append(cumsum / (i + 1))\n\nrunning_mean = np.array(running_mean)\n\n# Check convergence\ntolerance = 0.1\nconverged_at = np.where(np.abs(running_mean - 5) < tolerance)[0]\nif len(converged_at) > 0:\n    first_convergence = converged_at[0]\n    print(f\"Path converges to true mean within {tolerance} at n \u2248 {first_convergence}\")\nelse:\n    print(\"Path hasn't converged within given tolerance\")\n\n# Multiple paths\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\n# Single path\naxes[0].plot(running_mean[:1000], alpha=0.7)\naxes[0].axhline(5, color='r', linestyle='--')\naxes[0].set_xlabel('n')\naxes[0].set_ylabel('Sample mean')\naxes[0].set_title('SLLN: Single realization')\n\n# Multiple paths\nfor _ in range(20):\n    cumsum = 0\n    path = []\n    for i in range(1000):\n        X = np.random.exponential(scale=5)\n        cumsum += X\n        path.append(cumsum / (i + 1))\n    axes[1].plot(path, alpha=0.3)\n\naxes[1].axhline(5, color='r', linestyle='--', label='True mean')\naxes[1].set_xlabel('n')\naxes[1].set_ylabel('Sample mean')\naxes[1].set_title('SLLN: Multiple realizations')\naxes[1].legend()\nplt.tight_layout()\nplt.show()"
