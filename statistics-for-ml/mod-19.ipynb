          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Demonstrate: sample mean converges to true mean\nnp.random.seed(42)\ntrue_mean = 5\nsample_sizes = np.arange(10, 10000, 100)\nsample_means = []\nstd_errors = []\n\nfor n in sample_sizes:\n    samples = np.random.exponential(scale=true_mean, size=n)\n    sample_means.append(samples.mean())\n    std_errors.append(samples.std() / np.sqrt(n))\n\nsample_means = np.array(sample_means)\nstd_errors = np.array(std_errors)\n\nplt.figure(figsize=(10, 5))\nplt.plot(sample_sizes, sample_means, 'b-', label='Sample mean')\nplt.axhline(true_mean, color='r', linestyle='--', label='True mean')\nplt.fill_between(sample_sizes, sample_means - 2*std_errors, sample_means + 2*std_errors, alpha=0.2)\nplt.xlabel('Sample size')\nplt.ylabel('Mean')\nplt.title('Convergence in Probability (WLLN)')\nplt.legend()\nplt.grid()\nplt.show()\n\nprint(f\"Sample mean at n=10: {sample_means[0]:.3f}\")\nprint(f\"Sample mean at n=5000: {sample_means[-1]:.3f}\")\nprint(f\"True mean: {true_mean:.3f}\")"
        ]
