          "python",
          "import numpy as np\nfrom scipy import stats\n\n# Example: Borel \u03c3-algebra on [0,1]\n# All \"reasonable\" sets (intervals, countable unions) are measurable\n\n# Probability measure: uniform distribution on [0,1]\nX = stats.uniform(0, 1)\n\n# Probability of interval [0.2, 0.7]\nprob_interval = X.cdf(0.7) - X.cdf(0.2)\nprint(f\"P([0.2, 0.7]) = {prob_interval:.2f}\")\n\n# Countable union of intervals\nprob_union = (X.cdf(0.3) - X.cdf(0.1)) + (X.cdf(0.7) - X.cdf(0.5))\nprint(f\"P([0.1,0.3] \u222a [0.5,0.7]) = {prob_union:.2f}\")\n\n# Single point has measure zero\nprob_point = X.pdf(0.5)  # Density at one point\nprint(f\"P(X = 0.5) = 0 (single point, continuous distribution)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy import stats\nimport matplotlib.pyplot as plt\n\n# Define a normal distribution\nmu, sigma = 0, 1\nnormal_dist = stats.norm(mu, sigma)\n\n# Characteristic function for N(\u03bc, \u03c3\u00b2)\n# \u03c6(t) = exp(i\u03bct - \u03c3\u00b2t\u00b2/2)\n\ndef char_func_normal(t, mu, sigma):\n    \"\"\"Characteristic function of normal distribution\"\"\"\n    return np.exp(1j * mu * t - 0.5 * sigma**2 * t**2)\n\n# Evaluate at various t\nt_values = np.linspace(-5, 5, 100)\nchar_values = char_func_normal(t_values, mu, sigma)\n\n# Plot real and imaginary parts\nplt.figure(figsize=(10, 4))\nplt.subplot(1, 2, 1)\nplt.plot(t_values, np.real(char_values), label='Re(\u03c6(t))')\nplt.xlabel('t')\nplt.ylabel('Re(\u03c6(t))')\nplt.title('Real Part of Characteristic Function')\nplt.grid()\n\nplt.subplot(1, 2, 2)\nplt.plot(t_values, np.abs(char_values), label='|\u03c6(t)|')\nplt.xlabel('t')\nplt.ylabel('|\u03c6(t)|')\nplt.title('Magnitude of Characteristic Function')\nplt.grid()\nplt.tight_layout()\nplt.show()\n\n# Recover moments from derivatives\n# E[X] = \u03c6'(0) / i\n# E[X\u00b2] = \u03c6''(0) / i\u00b2\n\n# Numerically approximate derivative\nh = 1e-6\nfirst_moment = np.imag(char_func_normal(h, mu, sigma) - char_func_normal(-h, mu, sigma)) / (2 * h)\nprint(f\"E[X] from characteristic function: {first_moment:.4f} (true: {mu})\")"
        ]
      ]
