        [
          "python",
          "import numpy as np\n\ndef jackknife_median(data):\n    \"\"\"Estimate standard error of median using jackknife\"\"\"\n    n = len(data)\n    jackknife_stats = []\n    \n    for i in range(n):\n        # Leave out observation i\n        leave_one_out = np.delete(data, i)\n        jackknife_stats.append(np.median(leave_one_out))\n    \n    jackknife_stats = np.array(jackknife_stats)\n    \n    # Standard error\n    se = np.sqrt((n-1) * np.mean((jackknife_stats - jackknife_stats.mean())**2))\n    \n    # Bias estimate\n    observed_stat = np.median(data)\n    bias = (n - 1) * (jackknife_stats.mean() - observed_stat)\n    \n    return se, bias, jackknife_stats\n\n# Example\ndata = np.array([12.5, 15.3, 8.1, 22.4, 11.2, 16.8, 9.3, 18.5, 14.2, 13.7, 19.1, 10.5])\n\nse, bias, jk_stats = jackknife_median(data)\n\nprint(f\"Observed median: {np.median(data):.2f}\")\nprint(f\"Jackknife SE: {se:.2f}\")\nprint(f\"Bias estimate: {bias:.2f}\")\nprint(f\"Jackknife CI (95%): [{np.median(data) - 1.96*se:.2f}, {np.median(data) + 1.96*se:.2f}]\")"
        ]
      ]
