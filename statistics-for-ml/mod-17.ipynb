        [
          "python",
          "import numpy as np\nfrom scipy.stats import ttest_ind\n\n# A/B test data\nnp.random.seed(42)\ncontrol = np.array([45, 52, 48, 51, 49, 53, 47, 50, 46, 51])\ntreatment = np.array([55, 58, 56, 59, 57, 61, 54, 60, 58, 62])\n\nobserved_diff = treatment.mean() - control.mean()\n\n# Permutation test\npooled_data = np.concatenate([control, treatment])\nn_control = len(control)\nn_treatment = len(treatment)\nn_permutations = 10000\n\npermuted_diffs = []\n\nfor _ in range(n_permutations):\n    # Shuffle and split\n    shuffled = np.random.permutation(pooled_data)\n    perm_control = shuffled[:n_control]\n    perm_treatment = shuffled[n_control:]\n    permuted_diffs.append(perm_treatment.mean() - perm_control.mean())\n\npermuted_diffs = np.array(permuted_diffs)\n\n# Two-tailed p-value\np_value = np.mean(np.abs(permuted_diffs) >= np.abs(observed_diff))\n\nprint(f\"Control mean: {control.mean():.2f}\")\nprint(f\"Treatment mean: {treatment.mean():.2f}\")\nprint(f\"Observed difference: {observed_diff:.2f}\")\nprint(f\"Permutation test p-value: {p_value:.4f}\")\n\n# Compare with t-test\nt_stat, t_pvalue = ttest_ind(treatment, control)\nprint(f\"T-test p-value (parametric): {t_pvalue:.4f}\")\nprint(f\"Similar results? {abs(p_value - t_pvalue) < 0.05}\")"
        ]
      ]
    },
