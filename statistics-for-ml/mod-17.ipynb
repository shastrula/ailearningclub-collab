        [
          "python",
          "import numpy as np\n\n# A/B test: revenue per user\nnp.random.seed(42)\ncontrol_revenue = np.array([12.5, 15.3, 11.2, 14.8, 13.1, 16.2, 12.9, 14.5, 11.8, 15.1])\ntreatment_revenue = np.array([15.8, 17.2, 16.1, 18.3, 19.1, 17.5, 16.8, 18.9, 17.2, 19.5])\n\nobserved_diff = treatment_revenue.mean() - control_revenue.mean()\n\n# Bootstrap\nn_bootstrap = 5000\nbootstrap_diffs = []\n\nfor _ in range(n_bootstrap):\n    control_boot = np.random.choice(control_revenue, size=len(control_revenue), replace=True)\n    treatment_boot = np.random.choice(treatment_revenue, size=len(treatment_revenue), replace=True)\n    bootstrap_diffs.append(treatment_boot.mean() - control_boot.mean())\n\nbootstrap_diffs = np.array(bootstrap_diffs)\n\n# CI and p-value\nci_lower = np.percentile(bootstrap_diffs, 2.5)\nci_upper = np.percentile(bootstrap_diffs, 97.5)\np_value = np.mean(bootstrap_diffs <= 0)  # Probability of zero or negative difference\n\nprint(f\"Observed difference: ${observed_diff:.2f}\")\nprint(f\"95% Bootstrap CI: [${ci_lower:.2f}, ${ci_upper:.2f}]\")\nprint(f\"P-value (two-tailed): {2 * min(p_value, 1-p_value):.4f}\")"
        ]
      ]
    },
    {
