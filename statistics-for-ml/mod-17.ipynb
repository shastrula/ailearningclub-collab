      "source": [
        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Original data: website session duration (minutes)\nnp.random.seed(42)\nobserved_data = np.array([12.5, 15.3, 8.1, 22.4, 11.2, 16.8, 9.3, 18.5, 14.2, 13.7, 19.1, 10.5])\n\n# Calculate observed median (statistic with no standard formula)\nobserved_median = np.median(observed_data)\n\n# Bootstrap: resample with replacement\nn_bootstrap = 10000\nbootstrap_medians = []\n\nfor _ in range(n_bootstrap):\n    # Resample with replacement\n    bootstrap_sample = np.random.choice(observed_data, size=len(observed_data), replace=True)\n    bootstrap_medians.append(np.median(bootstrap_sample))\n\nbootstrap_medians = np.array(bootstrap_medians)\n\n# 95% confidence interval\nci_lower = np.percentile(bootstrap_medians, 2.5)\nci_upper = np.percentile(bootstrap_medians, 97.5)\n\nprint(f\"Observed median: {observed_median:.2f} minutes\")\nprint(f\"95% Bootstrap CI: [{ci_lower:.2f}, {ci_upper:.2f}]\")\nprint(f\"Standard error: {bootstrap_medians.std():.2f}\")\nprint(f\"Median of bootstrap distribution: {bootstrap_medians.mean():.2f}\")\n\n# Visualization\nplt.hist(bootstrap_medians, bins=50, alpha=0.7, edgecolor='black')\nplt.axvline(observed_median, color='red', linestyle='--', label='Observed')\nplt.axvline(ci_lower, color='green', linestyle='--', label='CI')\nplt.axvline(ci_upper, color='green', linestyle='--')\nplt.legend()\nplt.title('Bootstrap Distribution of Median')\nplt.show()"
        ]
      ]
    },
    {
