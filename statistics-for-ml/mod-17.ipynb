          "python",
          "import numpy as np\nfrom scipy import stats\n\n# Generate sample data\nnp.random.seed(42)\ndata = np.random.normal(loc=100, scale=15, size=200)\n\n# Descriptive statistics\nprint(\"Descriptive Statistics:\")\nprint(f\"  Mean: {np.mean(data):.2f}\")\nprint(f\"  Median: {np.median(data):.2f}\")\nprint(f\"  Std Dev: {np.std(data):.2f}\")\nprint(f\"  Skewness: {stats.skew(data):.3f}\")\nprint(f\"  Kurtosis: {stats.kurtosis(data):.3f}\")\n\n# Hypothesis testing\nsample_a = np.random.normal(100, 15, 50)\nsample_b = np.random.normal(105, 15, 50)\n\nt_stat, p_value = stats.ttest_ind(sample_a, sample_b)\nprint(f\"\\nT-test: t={t_stat:.3f}, p={p_value:.4f}\")\nprint(f\"Significant difference: {'Yes' if p_value < 0.05 else 'No'}\")\n\n# Confidence interval\nci = stats.t.interval(0.95, len(data)-1, loc=np.mean(data), scale=stats.sem(data))\nprint(f\"\\n95% CI: ({ci[0]:.2f}, {ci[1]:.2f})\")"
        ]
      ]
    }
