          "python",
          "import numpy as np\n\n# Fundamentals: economic data, approval ratings, party incumbency\nprint(\"Election Forecasting: Fundamentals + Polls\")\n\nprint(\"\\n1. Fundamentals Model:\")\nprint(\"   - GDP growth, unemployment \u2192 predicts 2-4 point swing\")\nprint(\"   - Approval rating \u2192 predicts 1-2 point swing\")\nprint(\"   - Historical baseline by party\")\n\nprint(\"\\n2. Polls Model:\")\nprint(\"   - Aggregated from all polls\")\nprint(\"   - SE shrinks as election approaches\")\n\nprint(\"\\n3. Combined Forecast:\")\nfundamentals_prediction = 50 + 2  # Base 50%, +2 point advantage\npolls_estimate = 48.5\npolls_se = 1.5\nfundamentals_weight = 0.3\npolls_weight = 0.7\n\ncombined = fundamentals_weight * fundamentals_prediction + polls_weight * polls_estimate\ncombined_se = np.sqrt((fundamentals_weight * 1)**2 + (polls_weight * polls_se)**2)\n\nprint(f\"   Fundamentals (weight {fundamentals_weight}): {fundamentals_prediction:.1f}%\")\nprint(f\"   Polls (weight {polls_weight}): {polls_estimate:.1f}% \u00b1 {polls_se:.1f}%\")\nprint(f\"   Combined forecast: {combined:.1f}% \u00b1 {combined_se:.2f}%\")\n\nprint(f\"\\n4. Uncertainty Sources:\")\nprint(f\"   - Sampling error (shrinks as election nears)\")\nprint(f\"   - Systematic bias (polls miss certain voters)\")\nprint(f\"   - Turnout uncertainty (which eligible voters show up?)\")\nprint(f\"   - Model uncertainty (is fundamentals model correct?)\")"
        ]
      ]
