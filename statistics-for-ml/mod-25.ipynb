          "python",
          "import numpy as np\nfrom scipy.stats import linregress\n\n# Technique 1: Covariate adjustment\n# If baseline metric correlates with outcome, can reduce SE\n\nnp.random.seed(42)\nn = 10000\ntreatment = np.random.binomial(1, 0.5, n)\nbaseline = np.random.normal(100, 20, n)\noutcome = baseline + 2*treatment + np.random.normal(0, 10, n)\n\n# Unadjusted\neffect_unadjusted = outcome[treatment==1].mean() - outcome[treatment==0].mean()\nse_unadjusted = np.sqrt(outcome.var() * (2/n))\n\n# Adjusted (ANCOVA)\nslope_baseline, intercept, _, _, se_reg = linregress(baseline, outcome)\nresidual = outcome - (slope_baseline * baseline + intercept)\neffect_adjusted = residual[treatment==1].mean() - residual[treatment==0].mean()\nse_adjusted = np.sqrt(residual.var() * (2/n))\n\nprint(\"Variance Reduction via Covariate Adjustment:\")\nprint(f\"Unadjusted effect: {effect_unadjusted:.2f}, SE: {se_unadjusted:.3f}\")\nprint(f\"Adjusted effect: {effect_adjusted:.2f}, SE: {se_adjusted:.3f}\")\nprint(f\"SE reduction: {(1 - se_adjusted/se_unadjusted)*100:.1f}%\")\nprint(f\"\\nRequired sample size reduced by ~{(se_unadjusted/se_adjusted)**2:.1f}x\")\n\n# Technique 2: Stratification\nprint(f\"\\nStratification (by region, device type, etc.):\")\nprint(f\"  Separate analysis within strata\")\nprint(f\"  Combine via weighted average\")\nprint(f\"  \u2192 Accounts for imbalance if it exists\")\nprint(f\"  \u2192 Further variance reduction if strata effect is large\")"
