          "python",
          "import numpy as np\nfrom scipy.stats import norm\n\n# Power analysis\nalpha = 0.05  # Type I error\npower = 0.80  # Type II error = 20%\neffect_size = 0.3  # Cohen's d\none_sided = True\n\n# Sample size for mean comparison\nz_alpha = norm.ppf(1 - alpha / (2 if not one_sided else 1))\nz_beta = norm.ppf(power)\n\nn_per_arm = ((z_alpha + z_beta)**2 / (effect_size**2)) * 2\n\nprint(\"Clinical Trial Sample Size Calculation:\")\nprint(f\"Effect size (Cohen's d): {effect_size}\")\nprint(f\"Power (1 - Type II error): {power}\")\nprint(f\"Type I error rate: {alpha}\")\nprint(f\"Sample size per arm: {n_per_arm:.0f}\")\nprint(f\"Total trial: {2 * n_per_arm:.0f} patients\")\n\n# Real example: statin trial\nprint(\"\\nReal-world example (LDL-C lowering):\")\nprint(\"Effect size in previous trials: d \u2248 0.5\")\nprint(\"FDA accepts: \u03b1=0.05, power=0.90\")\nprint(\"Required n \u2248 400 per arm \u2192 800 total patients\")\nprint(\"Multi-year recruitment, ~$500M cost\")"
        ]
      ]
    },
    {
