        [
          "python",
          "import numpy as np\nfrom sklearn.decomposition import NMF\n\n# Simplified matrix factorization\n# Goal: factor user-show matrix Y \u2248 U \u00d7 V^T\n# where U: user factors (latent preferences)\n#       V: show factors (latent features)\n\nnp.random.seed(42)\n\n# Generate synthetic rating matrix (sparse)\nn_users, n_shows = 100, 500\nY_dense = np.random.rand(n_users, n_shows)\n\n# Make sparse\nY_sparse = Y_dense.copy()\nY_sparse[np.random.rand(n_users, n_shows) > 0.05] = 0  # 95% sparse\n\n# Apply NMF\nn_factors = 20\nmodel = NMF(n_components=n_factors, init='random', random_state=42, max_iter=100)\nU = model.fit_transform(Y_sparse)\nV = model.components_\n\n# Reconstruct ratings\nY_reconstructed = U @ V\n\nprint(f\"User-show matrix: {Y_sparse.shape}\")\nprint(f\"Latent factors: {n_factors}\")\nprint(f\"Parameters before: {n_users * n_shows}\")\nprint(f\"Parameters after: {n_users * n_factors + n_factors * n_shows}\")\nprint(f\"Compression: {(n_users * n_shows) / (n_users * n_factors + n_factors * n_shows):.1f}x\")\n\nprint(f\"\\nBenefits:\")\nprint(f\"  - Implicit regularization (low rank)\")\nprint(f\"  - Extrapolates to unseen (user, show) pairs\")\nprint(f\"  - Scales to millions of users/shows\")"
        ]
      ]
    },
