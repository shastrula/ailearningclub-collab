          "python",
          "import numpy as np\n\n# Multiple comparisons correction\nn_tests = 1000\nalpha_per_test = 0.05\n\n# Bonferroni: divide \u03b1 by n_tests\nbonferroni_threshold = alpha_per_test / n_tests\n\n# Benjamini-Hochberg: control FDR at 5%\nfdr_target = 0.05\n\nprint(f\"Multiple Testing: {n_tests} concurrent A/B tests\")\nprint(f\"\\nBonferroni correction:\")\nprint(f\"  Per-test \u03b1: {bonferroni_threshold:.6f}\")\nprint(f\"  Effective threshold: p < {bonferroni_threshold:.2e}\")\nprint(f\"  Issue: very conservative, low power\")\n\nprint(f\"\\nBenjamini-Hochberg (FDR control):\")\nprint(f\"  FDR target: {fdr_target*100}%\")\nprint(f\"  Expected false discoveries: \u2264 {int(n_tests * fdr_target)}\")\nprint(f\"  Less conservative, reasonable power\")\n\n# Meta-analysis: combining tests across experiments\nprint(f\"\\nMeta-Analysis Approach:\")\nprint(f\"  Collect effect sizes from past 100 similar tests\")\nprint(f\"  Estimate typical effect size distribution\")\nprint(f\"  Use prior to regularize current test\")\nprint(f\"  \u2192 Reduces variance in estimates\")"
        ]
      ]
