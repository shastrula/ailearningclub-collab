          "python",
          "import numpy as np\nfrom scipy.stats import binom\n\n# Safety monitoring example\n# Event rate in placebo: 5% (expected)\n# Acceptable rate in active treatment: \u2264 10%\n# Stop if posterior probability P(rate > 15%) > 95%\n\n# Observed in active arm: 10 events out of 100 patients\nevents = 10\nn = 100\n\n# Prior: Beta(2, 38) centered at 5%\nprior_alpha, prior_beta = 2, 38\n\n# Posterior: Beta(2+10, 38+90)\npost_alpha = prior_alpha + events\npost_beta = prior_beta + (n - events)\n\n# P(rate > 0.15) using posterior\n# = P(Beta(12, 128) > 0.15)\nfrom scipy.stats import beta\nposterior_prob_high = 1 - beta.cdf(0.15, post_alpha, post_beta)\n\nprint(\"Safety Monitoring (Bayesian):\")\nprint(f\"Observed: {events}/{n} events in active arm ({events/n*100:.1f}%)\")\nprint(f\"Prior on rate: Beta(2, 38), median={2/(2+38):.1%}\")\nprint(f\"Posterior: Beta({post_alpha}, {post_beta})\")\nprint(f\"P(rate > 15%) = {posterior_prob_high:.3f}\")\nprint(f\"Stop for safety if > 0.95: {posterior_prob_high > 0.95}\")"
        ]
      ]
