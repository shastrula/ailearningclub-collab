          "python",
          "import numpy as np\nfrom scipy.stats import norm\n\n# O'Brien-Fleming spending function for \u03b1=0.05, 2 interim looks\nalpha_total = 0.05\nlook_2_fraction = 0.5  # Look when 50% done\nlook_1_threshold = norm.ppf(1 - (alpha_total/2) * (1 / look_2_fraction)**(-2))\nlook_2_threshold = norm.ppf(1 - (alpha_total/2) * (2 / look_2_fraction)**(-2))\n\nprint(\"Sequential Trial Design (O'Brien-Fleming):\")\nprint(f\"Interim analysis 1 (n=200 per arm): z > {look_1_threshold:.3f} to stop\")\nprint(f\"Interim analysis 2 (n=400 per arm): z > {look_2_threshold:.3f} to stop\")\nprint(f\"Final analysis (n=400 per arm): z > {norm.ppf(1 - alpha_total/2):.3f} to reject\")\n\nprint(f\"\\nOutcomes:\")\nprint(f\"  If huge effect at interim 1: can stop early, spare 400 patients\")\nprint(f\"  If no effect at interim 2: can stop for futility\")\nprint(f\"  Preserves overall Type I error rate (\u03b1=0.05)\")"
        ]
      ]
    },
