          "python",
          "import numpy as np\nfrom scipy.stats import pearsonr\n\n# User-rating matrix (sparse)\n# Users: 1000, Shows: 10000, ~1% observed\n\nnp.random.seed(42)\nn_users = 1000\nn_shows = 10000\nsparsity = 0.01  # 1% observed\n\n# Generate sparse ratings\nratings_dict = {}\nfor _ in range(int(n_users * n_shows * sparsity)):\n    user = np.random.randint(0, n_users)\n    show = np.random.randint(0, n_shows)\n    rating = np.random.randint(1, 6)\n    ratings_dict[(user, show)] = rating\n\n# Find similar users (only on shows both watched)\ndef user_similarity(user1, user2, ratings_dict):\n    # Find shows both users rated\n    shows_user1 = {show for (u, show) in ratings_dict if u == user1}\n    shows_user2 = {show for (u, show) in ratings_dict if u == user2}\n    common_shows = shows_user1 & shows_user2\n    \n    if len(common_shows) < 5:  # Too few overlaps\n        return None, 0\n    \n    ratings1 = [ratings_dict[(user1, show)] for show in common_shows]\n    ratings2 = [ratings_dict[(user2, show)] for show in common_shows]\n    \n    corr, p_value = pearsonr(ratings1, ratings2)\n    return corr, p_value\n\n# Find similar users to user 0\nsimilarities = []\nfor other_user in range(1, 20):\n    corr, p_val = user_similarity(0, other_user, ratings_dict)\n    if corr is not None:\n        similarities.append((other_user, corr, p_val))\n\nsimilarities.sort(key=lambda x: -x[1])\n\nprint(\"User 0 most similar users (collaborative filtering):\")\nfor user, corr, p_val in similarities[:5]:\n    print(f\"  User {user}: \u03c1 = {corr:.3f} (p = {p_val:.4f})\")\n\nprint(f\"\\nStatistical issues:\")\nprint(f\"  - Sparse overlap \u2192 unreliable correlations\")\nprint(f\"  - Multiple comparisons \u2192 inflated significance\")\nprint(f\"  - Selection bias (recommend only if p < 0.05?)\")"
        ]
      ]
    },
    {
