          "python",
          "import numpy as np\nfrom scipy.stats import norm\n\n# Poll results (% supporting candidate A)\npolls = [\n    {'org': 'Gallup', 'estimate': 47, 'se': 2, 'n': 1000, 'date': 'Oct 1'},\n    {'org': 'Rasmussen', 'estimate': 49, 'se': 2.5, 'n': 800, 'date': 'Oct 2'},\n    {'org': 'ABC', 'estimate': 46, 'se': 1.8, 'n': 1200, 'date': 'Oct 1'},\n    {'org': 'CBS', 'estimate': 48, 'se': 2.2, 'n': 900, 'date': 'Oct 3'},\n]\n\n# Simple average\nsimple_avg = np.mean([p['estimate'] for p in polls])\n\n# Weighted average (by precision)\nweights = np.array([1/p['se']**2 for p in polls])\nweights = weights / weights.sum()\nweighted_avg = np.sum([p['estimate'] * w for p, w in zip(polls, weights)])\nweighted_se = 1 / np.sqrt(np.sum([1/p['se']**2 for p in polls]))\n\nprint(\"Poll Aggregation:\")\nfor p in polls:\n    print(f\"  {p['org']:12} {p['estimate']:.1f}% \u00b1 {p['se']:.1f}%\")\n\nprint(f\"\\nSimple average: {simple_avg:.1f}%\")\nprint(f\"Weighted average: {weighted_avg:.1f}% \u00b1 {weighted_se:.2f}%\")\n\nprint(f\"\\nWeighted: less sensitive to outliers, accounts for sample size\")\n\n# 95% CI\nci_lower = weighted_avg - 1.96 * weighted_se\nci_upper = weighted_avg + 1.96 * weighted_se\nprint(f\"95% CI: [{ci_lower:.1f}%, {ci_upper:.1f}%]\")"
        ]
      ]
