          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.special import digamma, gammaln\nfrom scipy.optimize import minimize\n\n# Example: Bayesian Poisson regression\n# y ~ Poisson(\u03bb), \u03bb = exp(X * \u03b2)\n# Prior: \u03b2 ~ Normal(0, \u03c3\u00b2)\n\nnp.random.seed(42)\n\n# Synthetic data\nn_samples = 100\nx = np.random.normal(0, 1, (n_samples, 1))\ntrue_beta = np.array([0.5])\ny = np.random.poisson(np.exp(x @ true_beta))\n\n# Variational inference: approximate posterior q(\u03b2) = Normal(\u03bc, \u03c3\u00b2)\n# Initialize parameters\nmu = np.array([0.0])\nsigma = np.array([1.0])\nprior_sigma = 1.0\n\ndef elbo(params):\n    \"\"\"Compute negative ELBO (for minimization)\"\"\"\n    mu, log_sigma = params[0], params[1]\n    sigma = np.exp(log_sigma)\n    \n    # E_q[log p(y|\u03b2)]\n    exp_beta = np.exp(mu + 0.5 * sigma**2)  # E[exp(\u03b2)]\n    loglik = np.sum(y * mu - exp_beta * x.squeeze())  # Approximate\n    \n    # KL divergence\n    kl = 0.5 * ((mu**2 + sigma**2) / prior_sigma**2 - 1 - 2*log_sigma)\n    \n    return -(loglik - kl)\n\n# Optimize\nresult = minimize(elbo, [mu[0], np.log(sigma[0])], method='BFGS')\nmu_opt, sigma_opt = result.x[0], np.exp(result.x[1])\n\nprint(f\"True \u03b2: {true_beta[0]:.4f}\")\nprint(f\"VI Mean: {mu_opt:.4f}\")\nprint(f\"VI Std: {sigma_opt:.4f}\")\nprint(f\"Uncertainty quantified through posterior variance\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
