          "python",
          "import numpy as np\n\n# Conceptual example\nprint(\"Posterior Predictive Uncertainty:\")\nprint(\"\\nStandard NN: \u0177 = f_w*(x) [single point estimate]\")\nprint(\"  \u2192 No uncertainty quantification\")\n\nprint(\"\\nBayesian NN: p(y|x,data) = \u222b p(y|x,w) p(w|data) dw\")\nprint(\"  \u2192 Mean prediction: E[y|x]\")\nprint(\"  \u2192 Uncertainty: Var[y|x]\")\n\nprint(\"\\nDecomposes into:\")\nprint(\"  Aleatoric uncertainty: E_w[Var_y[p(y|x,w)]]\")\nprint(\"    \u2192 Inherent noise in data\")\nprint(\"  Epistemic uncertainty: Var_w[E_y[p(y|x,w)]]\")\nprint(\"    \u2192 Model parameter uncertainty\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
