          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Conceptual example: amortized posterior inference\n# Instead of: \u2200 dataset D, solve: min_q D_KL(q || p(\u03b8|D))\n# Learn: q(\u03b8|D) = neural_network(D)\n\nprint(\"Amortized Inference:\")\nprint(\"\\n--- Standard VI ---\")\nprint(\"For each new data point:\")\nprint(\"  1. Initialize q_\u03b8\")\nprint(\"  2. Optimize q_\u03b8 via gradient descent (10-1000 iterations)\")\nprint(\"  3. Get posterior estimate\")\n\nprint(\"\\n--- Amortized VI ---\")\nprint(\"Train once:\")\nprint(\"  1. Train encoder network: q_\u03b8 = encoder(data)\")\nprint(\"  2. On new data: single forward pass \u2192 immediate posterior\")\n\nprint(\"\\nSpeedup: ~100x faster inference, shared learned representations\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\nfrom tensorflow import keras\nfrom tensorflow.keras import layers\nimport tensorflow_probability as tfp\n\n# Example: Bayesian regression with weight uncertainty\n# Using Monte Carlo dropout as a practical approximation\n\nnp.random.seed(42)\nx = np.linspace(-3, 3, 100)\ny_true = np.sin(x) + np.random.normal(0, 0.3, 100)\n\n# Build model with dropout for uncertainty\nmodel = keras.Sequential([\n    layers.Dense(32, activation='relu', input_shape=(1,)),\n    layers.Dropout(0.2),\n    layers.Dense(32, activation='relu'),\n    layers.Dropout(0.2),\n    layers.Dense(1)\n])\n\nmodel.compile(optimizer='adam', loss='mse')\nmodel.fit(x.reshape(-1, 1), y_true, epochs=100, verbose=0)\n\n# Predictive uncertainty via MC dropout\n# Forward pass multiple times with dropout active\nn_forward_passes = 100\npredictions = []\n\n# Custom model to keep dropout active at test time\nmodel_predict = keras.Model(\n    inputs=model.input,\n    outputs=model.output\n)\n\nx_test = np.linspace(-3.5, 3.5, 50)\n\nfor _ in range(n_forward_passes):\n    # Manual forward passes with dropout\n    layer_outputs = [x_test.reshape(-1, 1)]\n    for layer in model.layers:\n        if isinstance(layer, layers.Dropout):\n            layer_outputs.append(layer(layer_outputs[-1], training=True))\n        else:\n            layer_outputs.append(layer(layer_outputs[-1]))\n    predictions.append(layer_outputs[-1].numpy().squeeze())\n\npredictions = np.array(predictions)\nmean_pred = predictions.mean(axis=0)\nstd_pred = predictions.std(axis=0)\n\n# Plot\nplt.figure(figsize=(10, 6))\nplt.scatter(x, y_true, alpha=0.5, label='Observed data')\nplt.plot(x_test, mean_pred, 'b-', linewidth=2, label='Mean prediction')\nplt.fill_between(x_test, mean_pred - 2*std_pred, mean_pred + 2*std_pred, alpha=0.2, label='\u00b12 SD (95% CI)')\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title('Bayesian NN: Predictions with Uncertainty')\nplt.legend()\nplt.tight_layout()\nplt.show()\n\nprint(f\"Mean prediction uncertainty: {std_pred.mean():.4f}\")\nprint(f\"Higher uncertainty where data sparse (edges of range)\")"
        ]
      ]
    },
