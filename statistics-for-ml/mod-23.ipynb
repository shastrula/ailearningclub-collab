        [
          "python",
          "import numpy as np\n\n# Example: calibration of 95% predictive intervals\nnp.random.seed(42)\n\n# Generate predictions and true values\nn_test = 1000\npredictions_mean = np.random.normal(0, 1, n_test)\npredictions_std = np.abs(np.random.normal(0.3, 0.1, n_test))  # Heteroscedastic\ny_true = predictions_mean + predictions_std * np.random.normal(0, 1, n_test)\n\n# 95% CI: mean \u00b1 1.96*std\nlower_ci = predictions_mean - 1.96 * predictions_std\nupper_ci = predictions_mean + 1.96 * predictions_std\n\n# Coverage: what fraction of true values fall in CI?\ncoverage = np.mean((y_true >= lower_ci) & (y_true <= upper_ci))\n\nprint(f\"Predicted CI coverage: {coverage:.4f}\")\nprint(f\"Expected coverage (95%): 0.95\")\nprint(f\"Calibrated: {abs(coverage - 0.95) < 0.02}\")\n\n# Plot\nimport matplotlib.pyplot as plt\nsorted_idx = np.argsort(predictions_mean)\nindices = np.arange(100)  # Plot first 100 for clarity\n\nplt.figure(figsize=(12, 6))\nplt.errorbar(indices, predictions_mean[sorted_idx[:100]], \n             yerr=1.96*predictions_std[sorted_idx[:100]], fmt='none', alpha=0.5, label='95% PI')\nplt.scatter(indices, y_true[sorted_idx[:100]], alpha=0.6, s=20, label='True values')\nplt.xlabel('Sample')\nplt.ylabel('Value')\nplt.title(f'Predictive Interval Calibration (Coverage={coverage:.3f})')\nplt.legend()\nplt.tight_layout()\nplt.show()"
        ]
      ]
