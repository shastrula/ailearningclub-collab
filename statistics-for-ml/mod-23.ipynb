      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Example decomposition\ndata_loglik = -150.5  # Expected log likelihood\nkl_div = 0.5          # KL divergence\n\nelbo_value = data_loglik - kl_div\n\nprint(\"ELBO Decomposition:\")\nprint(f\"Data log-likelihood (fit): {data_loglik:.2f}\")\nprint(f\"KL divergence (regularization): {kl_div:.2f}\")\nprint(f\"ELBO (objective): {elbo_value:.2f}\")\nprint(f\"\\nHigher ELBO = better balance between fit and prior\")\n\n# Compare two models\nprint(\"\\nModel 1 (weak prior): loglik=-150, KL=0.1 \u2192 ELBO={:.1f}\".format(-150-0.1))\nprint(\"Model 2 (strong prior): loglik=-155, KL=0.01 \u2192 ELBO={:.1f}\".format(-155-0.01))\nprint(\"Model 1 preferred (higher ELBO)\")"
        ]
      ]
    },
