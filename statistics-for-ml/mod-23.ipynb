          "python",
          "# Conceptual PyMC3 example (not runnable here without full setup)\nprint(\"PyMC3 Bayesian Model Example:\")\nprint(\"\"\"\nimport pymc3 as pm\n\nwith pm.Model() as model:\n    # Priors\n    mu = pm.Normal('mu', mu=0, sd=10)\n    sigma = pm.HalfNormal('sigma', sd=1)\n    \n    # Likelihood\n    y_obs = pm.Normal('y_obs', mu=mu, sd=sigma, observed=data)\n    \n    # Inference\n    trace = pm.sample(2000, tune=1000)\n    \n# trace contains posterior samples for parameters\n# Uncertainty automatically quantified\n\"\"\")\n\nprint(\"\\nTensorFlow Probability Example:\")\nprint(\"\"\"\nimport tensorflow_probability as tfp\ntfd = tfp.distributions\n\n# Define model\ndef model(data):\n    \u03bc = tfd.Normal(0, 10)\n    \u03c3 = tfd.HalfNormal(1)\n    y = tfd.Normal(\u03bc, \u03c3)\n    return y\n\n# Posterior inference via variational approximation\n# or HMC sampling\n\"\"\")"
