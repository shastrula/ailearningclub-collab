          "python",
          "Prior: \u03bb ~ Gamma(\u03b1, \u03b2)\nData: n observations with sum s = \u03a3y_i\nPosterior: \u03bb | D ~ Gamma(\u03b1 + s, \u03b2 + n)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from scipy.stats import gamma, poisson\n\n# Example: Website daily visitors follow Poisson distribution\n# Prior on rate \u03bb: Gamma(10, 0.1) - expect ~100 visitors/day\nprior_alpha = 10\nprior_beta = 0.1\nprior_mean = prior_alpha / prior_beta\n\n# Observed data: 30 days of visitor counts\nnp.random.seed(42)\ntrue_lambda = 95\nvisitor_counts = np.random.poisson(true_lambda, 30)\ntotal_visitors = visitor_counts.sum()\n\n# Posterior update\nposterior_alpha = prior_alpha + total_visitors\nposterior_beta = prior_beta + len(visitor_counts)\n\nposterior_mean = posterior_alpha / posterior_beta\n\nprint(f\"Prior mean \u03bb: {prior_mean:.1f} visitors/day\")\nprint(f\"Observed mean: {visitor_counts.mean():.1f} visitors/day\")\nprint(f\"Posterior mean \u03bb: {posterior_mean:.1f} visitors/day\")\n\n# Predictive distribution for tomorrow\n# P(Y_new) = \u222b P(Y_new | \u03bb) p(\u03bb | D) d\u03bb\n# For Gamma-Poisson, this is Negative Binomial\nfrom scipy.stats import nbinom\n\n# Negative Binomial parameters from Gamma posterior\nr = posterior_alpha\np = posterior_beta / (1 + posterior_beta)\n\n# Probability of seeing ~100 visitors tomorrow\nprob_100 = nbinom.pmf(100, r, p)\nprint(f\"\\nP(visitors \u2248 100 tomorrow | data) \u2248 {prob_100:.4f}\")\n\n# Plot predictive distribution\ny_range = np.arange(60, 130)\nplt.figure(figsize=(10, 6))\nplt.bar(y_range, [nbinom.pmf(y, r, p) for y in y_range], alpha=0.7)\nplt.xlabel('Visitors Tomorrow')\nplt.ylabel('Probability')\nplt.title('Posterior Predictive: Website Traffic Tomorrow')\nplt.grid(alpha=0.3)\nplt.show()"
        ]
      ]
    },
