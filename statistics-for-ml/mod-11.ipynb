        [
          "python",
          "# Example: choosing prior for proportion of defective items in manufacturing\nimport matplotlib.pyplot as plt\nfrom scipy.stats import beta\n\n# Scenario: historically defect rate is 2%, but new process may differ\n# Data: 50 items inspected, 3 defects found\n\ndata_defects = 3\ndata_total = 50\n\nfig, axes = plt.subplots(1, 3, figsize=(15, 4))\n\n# Prior 1: Highly informative (strong belief in 2%)\nprior1_a, prior1_b = 100, 4900  # E[p] = 100/5000 = 0.02\nposterior1_a = prior1_a + data_defects\nposterior1_b = prior1_b + (data_total - data_defects)\n\nx = np.linspace(0, 0.1, 1000)\naxes[0].plot(x, beta.pdf(x, prior1_a, prior1_b), label='Prior', linewidth=2)\naxes[0].plot(x, beta.pdf(x, posterior1_a, posterior1_b), label='Posterior', linewidth=2)\naxes[0].set_title('Informative Prior (\u03b1=100, \u03b2=4900)')\naxes[0].set_ylabel('Density')\naxes[0].set_xlabel('Defect Rate')\naxes[0].legend()\n\n# Prior 2: Weakly informative\nprior2_a, prior2_b = 1, 1  # Uniform\nposterior2_a = prior2_a + data_defects\nposterior2_b = prior2_b + (data_total - data_defects)\n\naxes[1].plot(x, beta.pdf(x, prior2_a, prior2_b), label='Prior', linewidth=2)\naxes[1].plot(x, beta.pdf(x, posterior2_a, posterior2_b), label='Posterior', linewidth=2)\naxes[1].set_title('Weakly Informative Prior (\u03b1=1, \u03b2=1)')\naxes[1].set_xlabel('Defect Rate')\naxes[1].legend()\n\n# Posterior comparison\naxes[2].plot(x, beta.pdf(x, posterior1_a, posterior1_b), label='Informative', linewidth=2)\naxes[2].plot(x, beta.pdf(x, posterior2_a, posterior2_b), label='Weakly Informative', linewidth=2)\naxes[2].set_title('Posteriors: Strong Prior vs Data')\naxes[2].set_xlabel('Defect Rate')\naxes[2].set_ylabel('Density')\naxes[2].legend()\n\nplt.tight_layout()\nplt.show()\n\nprint(f\"Posterior mean with informative prior: {posterior1_a/(posterior1_a+posterior1_b):.4f}\")\nprint(f\"Posterior mean with weakly informative prior: {posterior2_a/(posterior2_a+posterior2_b):.4f}\")\nprint(f\"Data alone (MLE): {data_defects/data_total:.4f}\")"
        ]
      ]
    },
