          "python",
          "Prior: \u03b8 ~ Beta(\u03b1, \u03b2)\nData: k successes in n trials\nPosterior: \u03b8 | D ~ Beta(\u03b1 + k, \u03b2 + n - k)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.stats import beta\nimport matplotlib.pyplot as plt\n\n# Example: Estimating click-through rate (CTR) for an ad\n# Prior belief: weak, centered at 5% (typical for ads)\nprior_alpha = 5\nprior_beta = 95  # 95/(5+95) = 0.95, expecting ~95% no-clicks\n\n# Campaign data: 42 clicks from 1000 impressions\nclicks = 42\nimpressions = 1000\nno_clicks = impressions - clicks\n\n# Analytical update\nposterior_alpha = prior_alpha + clicks\nposterior_beta = prior_beta + no_clicks\n\n# Visualize\nx = np.linspace(0, 0.1, 1000)\n\nfig, axes = plt.subplots(1, 3, figsize=(15, 4))\n\n# Prior\naxes[0].fill_between(x, beta.pdf(x, prior_alpha, prior_beta), alpha=0.6)\naxes[0].set_title(f'Prior: Beta({prior_alpha}, {prior_beta})')\naxes[0].set_ylabel('Density')\naxes[0].set_xlabel('CTR')\n\n# Posterior\naxes[1].fill_between(x, beta.pdf(x, posterior_alpha, posterior_beta), alpha=0.6, color='orange')\naxes[1].set_title(f'Posterior: Beta({posterior_alpha}, {posterior_beta})')\naxes[1].set_xlabel('CTR')\n\n# Comparison\naxes[2].plot(x, beta.pdf(x, prior_alpha, prior_beta), label='Prior', linewidth=2)\naxes[2].plot(x, beta.pdf(x, posterior_alpha, posterior_beta), label='Posterior', linewidth=2)\naxes[2].set_title('Prior vs Posterior')\naxes[2].set_xlabel('CTR')\naxes[2].set_ylabel('Density')\naxes[2].legend()\n\nplt.tight_layout()\nplt.show()\n\n# Point estimates and credible intervals\nprior_mean = prior_alpha / (prior_alpha + prior_beta)\nposterior_mean = posterior_alpha / (posterior_alpha + posterior_beta)\n\nposterior_cred_lower = beta.ppf(0.025, posterior_alpha, posterior_beta)\nposterior_cred_upper = beta.ppf(0.975, posterior_alpha, posterior_beta)\n\nprint(f\"Prior mean CTR: {prior_mean:.4f}\")\nprint(f\"Observed CTR: {clicks/impressions:.4f}\")\nprint(f\"Posterior mean CTR: {posterior_mean:.4f}\")\nprint(f\"95% Credible Interval: [{posterior_cred_lower:.4f}, {posterior_cred_upper:.4f}]\")\nprint(f\"Posterior is shrinkage estimate: pulls toward prior but dominated by data\")"
        ]
      ]
    },
