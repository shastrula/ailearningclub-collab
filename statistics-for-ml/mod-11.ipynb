          "python",
          "# Sensitivity analysis on prior hyperparameters\nimport pandas as pd\n\n# Scenario: A/B test, variant has 25 conversions from 100 trials\nconversions = 25\ntrials = 100\n\n# Try different priors\npriors = [\n    (\"Uniform\", 1, 1),\n    (\"Weak Beta\", 5, 5),\n    (\"Informative\", 10, 40),  # Believe ~20% baseline\n    (\"Strong Informative\", 50, 200),  # Strong belief\n]\n\nresults = []\nfor name, alpha, beta_param in priors:\n    post_alpha = alpha + conversions\n    post_beta = beta_param + (trials - conversions)\n    post_mean = post_alpha / (post_alpha + post_beta)\n    post_lower = beta.ppf(0.025, post_alpha, post_beta)\n    post_upper = beta.ppf(0.975, post_alpha, post_beta)\n    \n    results.append({\n        'Prior': name,\n        'Posterior Mean': f\"{post_mean:.4f}\",\n        'CI Lower': f\"{post_lower:.4f}\",\n        'CI Upper': f\"{post_upper:.4f}\",\n        'CI Width': f\"{post_upper - post_lower:.4f}\"\n    })\n\ndf = pd.DataFrame(results)\nprint(df.to_string(index=False))\nprint(f\"\\nConclusion: Results are robust to reasonable prior choices\")\nprint(f\"Only extreme priors (Strong Informative) dominate the data\")"
        ]
      ]
    }
