          "python",
          "Prior: \u03bc ~ N(m\u2080, \u03c3\u2080\u00b2)\nData: n observations with sample mean \u0233, known variance \u03c3\u00b2\nPosterior: \u03bc | D ~ N(m\u2081, \u03c3\u2081\u00b2)\n\nwhere:\n\u03c3\u2081\u00b2 = 1 / (1/\u03c3\u2080\u00b2 + n/\u03c3\u00b2)\nm\u2081 = \u03c3\u2081\u00b2 \u00d7 (m\u2080/\u03c3\u2080\u00b2 + n\u0233/\u03c3\u00b2)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from scipy.stats import norm\n\n# Example: Estimating average customer lifetime value\n# Prior: LTV ~ N(500, 100\u00b2) - expect mean around $500, uncertain\nprior_mean = 500\nprior_std = 100\n\n# Historical data: sample of 25 customers\nnp.random.seed(42)\nsample_ltv = np.random.normal(550, 120, 25)\n\n# Known data variance (from long historical records)\ndata_std = 120\ndata_variance = data_std ** 2\n\n# Compute posterior\nsample_mean = sample_ltv.mean()\nn = len(sample_ltv)\n\n# Prior precision: 1/\u03c3\u2080\u00b2\nprior_precision = 1 / (prior_std ** 2)\n\n# Data precision: n/\u03c3\u00b2\ndata_precision = n / data_variance\n\n# Posterior precision: sum of precisions\nposterior_precision = prior_precision + data_precision\nposterior_std = 1 / np.sqrt(posterior_precision)\n\n# Posterior mean: weighted by precision\nposterior_mean = (prior_mean * prior_precision + \n                 sample_mean * data_precision) / posterior_precision\n\nprint(f\"Prior: \u03bc ~ N({prior_mean}, {prior_std}\u00b2)\")\nprint(f\"Sample mean: {sample_mean:.1f}\")\nprint(f\"Posterior: \u03bc ~ N({posterior_mean:.1f}, {posterior_std:.1f}\u00b2)\")\nprint(f\"\\nPosterior pulls toward data but respects prior\")\nprint(f\"Weight on prior: {prior_precision / posterior_precision:.3f}\")\nprint(f\"Weight on data: {data_precision / posterior_precision:.3f}\")\n\n# Visualization\nx = np.linspace(300, 700, 1000)\nplt.figure(figsize=(10, 6))\nplt.plot(x, norm.pdf(x, prior_mean, prior_std), label='Prior', linewidth=2)\nplt.plot(x, norm.pdf(x, posterior_mean, posterior_std), label='Posterior', linewidth=2)\nplt.axvline(sample_mean, color='red', linestyle='--', label='Sample Mean')\nplt.xlabel('Customer LTV ($)')\nplt.ylabel('Density')\nplt.legend()\nplt.title('Normal-Normal Conjugacy: LTV Estimation')\nplt.grid(alpha=0.3)\nplt.show()"
        ]
      ]
    },
