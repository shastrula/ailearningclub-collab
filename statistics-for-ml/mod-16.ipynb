          "python",
          "import pandas as pd\nimport numpy as np\nfrom scipy import stats\n\n# Simulate: Treatment group has more engaged users at baseline\nnp.random.seed(42)\nn = 5000\n\ncontrol_data = {\n    'group': 'Control',\n    'baseline_engagement': np.random.normal(50, 15, n),\n    'metric': np.random.normal(100, 20, n)\n}\n\ntreatment_data = {\n    'group': 'Treatment',\n    'baseline_engagement': np.random.normal(55, 15, n),  # Already more engaged!\n    'metric': np.random.normal(102, 20, n)\n}\n\ncontrol_df = pd.DataFrame(control_data)\ntreatment_df = pd.DataFrame(treatment_data)\ndf = pd.concat([control_df, treatment_df], ignore_index=True)\n\n# Check for imbalance\nprint(\"Baseline engagement (selection bias indicator):\")\nprint(f\"Control mean: {control_df['baseline_engagement'].mean():.2f}\")\nprint(f\"Treatment mean: {treatment_df['baseline_engagement'].mean():.2f}\")\nt_stat, p_val = stats.ttest_ind(treatment_df['baseline_engagement'], control_df['baseline_engagement'])\nprint(f\"T-test p-value: {p_val:.4f} (imbalanced if < 0.05)\")\n\n# ANCOVA adjustment for baseline\nfrom scipy.stats import linregress\ndf['treatment'] = (df['group'] == 'Treatment').astype(int)\n\n# Unadjusted effect\nunadjusted_effect = df[df['treatment']==1]['metric'].mean() - df[df['treatment']==0]['metric'].mean()\n\n# Adjusted effect (controlling for baseline)\nslope_baseline, intercept, r, p, se = linregress(df['baseline_engagement'], df['metric'])\ndf['residual'] = df['metric'] - (slope_baseline * df['baseline_engagement'] + intercept)\nadjusted_effect = df[df['treatment']==1]['residual'].mean() - df[df['treatment']==0]['residual'].mean()\n\nprint(f\"\\nUnadjusted effect: {unadjusted_effect:.2f}\")\nprint(f\"Adjusted effect (controlling for baseline): {adjusted_effect:.2f}\")"
        ]
      ]
    },
