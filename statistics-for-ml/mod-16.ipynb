          "python",
          "import numpy as np\nfrom scipy import stats\n\n# Expected 50-50 split\ncontrol_count = 4850  # Slight imbalance\ntreatment_count = 5150\ntotal = control_count + treatment_count\n\n# Chi-square test for SRM\nexpected = [total/2, total/2]\nobserved = [control_count, treatment_count]\n\nchi2_stat = sum((obs - exp)**2 / exp for obs, exp in zip(observed, expected))\np_value = 1 - stats.chi2.cdf(chi2_stat, df=1)\n\nprint(f\"Control: {control_count} ({control_count/total*100:.2f}%)\")\nprint(f\"Treatment: {treatment_count} ({treatment_count/total*100:.2f}%)\")\nprint(f\"Chi-square: {chi2_stat:.4f}, p-value: {p_value:.4f}\")\nprint(f\"SRM detected (p < 0.01): {p_value < 0.01}\")\n\n# Rule of thumb\nsrm_percent = abs(control_count - treatment_count) / total * 100\nprint(f\"Imbalance: {srm_percent:.2f}%\")\nprint(f\"Investigate if > 0.5% imbalance\" if srm_percent > 0.5 else \"Acceptable balance\")"
        ]
      ]
