        [
          "python",
          "import numpy as np\nfrom scipy import stats\n\n# O'Brien-Fleming spending function for \u03b1=0.05, 2 peeks\nalpha = 0.05\nn_peeks = 2\nz_critical = []\n\nfor i in range(1, n_peeks + 1):\n    # O'Brien-Fleming adjustment\n    z_adj = stats.norm.ppf(1 - (alpha/2) * (i / n_peeks)**(-2))\n    z_critical.append(z_adj)\n    print(f\"Peek {i}: z_critical = {z_adj:.4f} (p-value threshold = {2*(1-stats.norm.cdf(z_adj)):.4f})\")\n\n# After first peek: need stricter threshold\n# After second peek: slightly relaxed threshold\n\n# Simulate data\nnp.random.seed(42)\nn = 1000\ncontrol = np.random.binomial(1, 0.10, n)\ntreatment = np.random.binomial(1, 0.105, n)\n\n# Mid-experiment check (peek 1)\nn1 = 500\nz_stat_1 = (treatment[:n1].mean() - control[:n1].mean()) / np.sqrt(control[:n1].mean()*(1-control[:n1].mean())/n1 + treatment[:n1].mean()*(1-treatment[:n1].mean())/n1)\n\nprint(f\"\\nPeek 1 (n=500): z = {z_stat_1:.4f}, exceeds {z_critical[0]:.4f}? {abs(z_stat_1) > z_critical[0]}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
