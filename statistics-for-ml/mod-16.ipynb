      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy import stats\n\n# Simulate 20 A/B tests where no true effect exists\nnp.random.seed(42)\nn_tests = 20\nalpha = 0.05\np_values = []\n\nfor i in range(n_tests):\n    control = np.random.normal(100, 15, 500)\n    treatment = np.random.normal(100, 15, 500)  # No real effect\n    t_stat, p_value = stats.ttest_ind(treatment, control)\n    p_values.append(p_value)\n\n# Naive: count p < 0.05\nfalse_positives_naive = sum(p < alpha for p in p_values)\nprint(f\"Tests with p < 0.05: {false_positives_naive} out of {n_tests}\")\nprint(f\"Expected by chance: ~{n_tests * alpha:.1f}\")\n\n# Correction 1: Bonferroni (most conservative)\nbonferroni_threshold = alpha / n_tests\nfalse_positives_bonf = sum(p < bonferroni_threshold for p in p_values)\nprint(f\"\\nBonferroni corrected (\u03b1={bonferroni_threshold:.6f}): {false_positives_bonf} false positives\")\n\n# Correction 2: Benjamini-Hochberg (FDR control, less conservative)\nsorted_p = sorted(p_values)\nfdr_threshold = None\nfor i, p in enumerate(sorted_p, 1):\n    if p <= (i / n_tests) * 0.05:\n        fdr_threshold = p\n\nif fdr_threshold:\n    false_positives_fdr = sum(p <= fdr_threshold for p in p_values)\n    print(f\"Benjamini-Hochberg (FDR): {false_positives_fdr} discoveries\")\nelse:\n    print(f\"Benjamini-Hochberg (FDR): No significant results\")"
        ]
      ]
    },
    {
