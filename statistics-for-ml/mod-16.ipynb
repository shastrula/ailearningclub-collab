          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Simulate novelty effect: strong initial lift, decay over time\nnp.random.seed(42)\nweeks = 10\ncontrol_metric = 100 + np.random.normal(0, 5, weeks)\ntreatment_metric = 110 + 5 * np.exp(-0.4 * np.arange(weeks)) + np.random.normal(0, 5, weeks)\n\n# Calculate cumulative average\ncontrol_cumulative = np.cumsum(control_metric) / (np.arange(weeks) + 1)\ntreatment_cumulative = np.cumsum(treatment_metric) / (np.arange(weeks) + 1)\n\nprint(\"Novelty effect detection:\")\nprint(\"Week | Control | Treatment | Lift %\")\nfor i in range(weeks):\n    lift = ((treatment_cumulative[i] - control_cumulative[i]) / control_cumulative[i]) * 100\n    print(f\"{i+1:4} | {control_cumulative[i]:7.2f} | {treatment_cumulative[i]:9.2f} | {lift:6.2f}%\")\n\n# Test if effect is stable in later weeks\nearly_effect = treatment_metric[:3].mean() - control_metric[:3].mean()\nlate_effect = treatment_metric[-3:].mean() - control_metric[-3:].mean()\nprint(f\"\\nEarly weeks effect: {early_effect:.2f}\")\nprint(f\"Late weeks effect: {late_effect:.2f}\")\nprint(f\"Novelty decay indicator: {early_effect > late_effect}\")"
        ]
      ]
