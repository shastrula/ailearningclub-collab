          "python",
          "import pandas as pd\n\n# Simpson's Paradox: Treatment appears worse overall, but better in each site\ndata = {\n    'Site': ['A', 'A', 'B', 'B'],\n    'Group': ['Control', 'Treatment', 'Control', 'Treatment'],\n    'Success': [56, 101, 31, 3],\n    'Total': [80, 120, 70, 10]\n}\n\ndf = pd.DataFrame(data)\ndf['Rate'] = df['Success'] / df['Total']\n\nprint(\"By Site:\")\nprint(df)\n\n# Overall rates (Simpson's Paradox!)\noverall_control = df[df['Group']=='Control']['Success'].sum() / df[df['Group']=='Control']['Total'].sum()\noverall_treatment = df[df['Group']=='Treatment']['Success'].sum() / df[df['Group']=='Treatment']['Total'].sum()\n\nprint(f\"\\nOverall Control Rate: {overall_control:.4f}\")\nprint(f\"Overall Treatment Rate: {overall_treatment:.4f}\")\nprint(f\"Treatment looks worse! But within each site, treatment is better.\")\n\nprint(\"\\nWithin-site comparison:\")\nfor site in ['A', 'B']:\n    control_rate = df[(df['Site']==site) & (df['Group']=='Control')]['Rate'].values[0]\n    treatment_rate = df[(df['Site']==site) & (df['Group']=='Treatment')]['Rate'].values[0]\n    print(f\"Site {site}: Treatment {treatment_rate:.4f} > Control {control_rate:.4f}\")"
        ]
      ]
    },
