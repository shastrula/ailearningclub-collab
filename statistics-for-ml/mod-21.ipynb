          "python",
          "import numpy as np\n\ndef entropy(p):\n    return -np.sum(p[p > 0] * np.log(p[p > 0]))\n\ndef kl_divergence(p, q):\n    \"\"\"Compute KL(P || Q)\"\"\"\n    return np.sum(p * (np.log(p + 1e-10) - np.log(q + 1e-10)))\n\ndef cross_entropy(p, q):\n    return -np.sum(p * np.log(q + 1e-10))\n\n# Example\np = np.array([0.7, 0.2, 0.1])\nq = np.array([0.6, 0.3, 0.1])\n\nh_p = entropy(p)\nkl = kl_divergence(p, q)\nh_pq = cross_entropy(p, q)\n\nprint(f\"H(P): {h_p:.4f}\")\nprint(f\"D_KL(P||Q): {kl:.4f}\")\nprint(f\"H(P,Q): {h_pq:.4f}\")\nprint(f\"Verify: H(P) + D_KL(P||Q) = {h_p + kl:.4f}\")\nprint(f\"Cross-entropy (direct): {h_pq:.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Two distributions\nx = np.linspace(-5, 5, 1000)\n\n# True distribution: bimodal\np_true = 0.5 * np.exp(-(x + 2)**2 / 0.5) + 0.5 * np.exp(-(x - 2)**2 / 0.5)\np_true = p_true / np.sum(p_true)\n\n# Approximation 1: covers both modes with low precision\nq1 = np.exp(-x**2 / 4)\nq1 = q1 / np.sum(q1)\n\n# Approximation 2: matches one mode perfectly\nq2 = np.exp(-(x + 2)**2 / 0.5)\nq2 = q2 / np.sum(q2)\n\n# Compute KL divergences (approximate via sampling)\ndx = x[1] - x[0]\nkl_1 = np.sum(p_true * (np.log(p_true + 1e-10) - np.log(q1 + 1e-10))) * dx\nkl_2 = np.sum(p_true * (np.log(p_true + 1e-10) - np.log(q2 + 1e-10))) * dx\n\nkl_reverse_1 = np.sum(q1 * (np.log(q1 + 1e-10) - np.log(p_true + 1e-10))) * dx\nkl_reverse_2 = np.sum(q2 * (np.log(q2 + 1e-10) - np.log(p_true + 1e-10))) * dx\n\nplt.figure(figsize=(12, 5))\n\nplt.subplot(1, 2, 1)\nplt.fill_between(x, p_true, alpha=0.3, label='True P')\nplt.plot(x, q1, linewidth=2, label='Q1 (covers both modes)')\nplt.legend()\nplt.title(f'Forward KL(P||Q1)={kl_1:.3f}\\nReverse KL(Q1||P)={kl_reverse_1:.3f}')\n\nplt.subplot(1, 2, 2)\nplt.fill_between(x, p_true, alpha=0.3, label='True P')\nplt.plot(x, q2, linewidth=2, label='Q2 (single mode match)')\nplt.legend()\nplt.title(f'Forward KL(P||Q2)={kl_2:.3f}\\nReverse KL(Q2||P)={kl_reverse_2:.3f}')\n\nplt.tight_layout()\nplt.show()\n\nprint(\"KL asymmetry in variational inference:\")\nprint(f\"Q1 (broad, covers both modes):\")\nprint(f\"  Forward KL(P||Q1) = {kl_1:.4f} - penalizes missing mass\")\nprint(f\"  Reverse KL(Q1||P) = {kl_reverse_1:.4f} - penalizes covered regions\")\nprint(f\"\\nQ2 (narrow, single mode):\")\nprint(f\"  Forward KL(P||Q2) = {kl_2:.4f}\")\nprint(f\"  Reverse KL(Q2||P) = {kl_reverse_2:.4f} - explodes (puts mass on zero prob region)\")"
        ]
      ]
