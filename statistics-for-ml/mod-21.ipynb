        [
          "python",
          "import numpy as np\n\n# True distribution (ground truth)\np = np.array([0.7, 0.2, 0.1])  # Class probabilities\n\n# Two candidate models\nq1 = np.array([0.6, 0.3, 0.1])  # Model 1: close to true\nq2 = np.array([0.33, 0.33, 0.34])  # Model 2: uniform (wrong)\n\ndef cross_entropy(p, q):\n    \"\"\"Compute cross-entropy H(P, Q)\"\"\"\n    return -np.sum(p * np.log2(q + 1e-10))\n\nh_true = cross_entropy(p, p)  # Entropy of true distribution\nh_model1 = cross_entropy(p, q1)\nh_model2 = cross_entropy(p, q2)\n\nprint(\"Cross-Entropy (bits):\")\nprint(f\"True dist H(P,P): {h_true:.4f}\")\nprint(f\"Model 1 H(P,Q1):  {h_model1:.4f} (better; close to true)\")\nprint(f\"Model 2 H(P,Q2):  {h_model2:.4f} (worse; far from true)\")\n\n# In practice: cross-entropy loss = -\u03a3 p(xi) log(\u0177i)\n# Lower cross-entropy = better model fit"
        ]
      ]
    },
