      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Dataset: 10 samples, 6 class A, 4 class B\n# H(original) = -0.6*log2(0.6) - 0.4*log2(0.4) \u2248 0.971 bits\n\ndef entropy(label_counts):\n    total = np.sum(label_counts)\n    probs = label_counts / total\n    return -np.sum(probs[probs > 0] * np.log2(probs[probs > 0]))\n\n# Original dataset\noriginal_entropy = entropy(np.array([6, 4]))\n\n# Split 1: separates into [5A, 0B] and [1A, 4B]\nleft_entropy = entropy(np.array([5, 0]))\nright_entropy = entropy(np.array([1, 4]))\nig_split1 = original_entropy - (5/10 * left_entropy + 5/10 * right_entropy)\n\n# Split 2: separates into [3A, 2B] and [3A, 2B] (balanced)\nleft_entropy_2 = entropy(np.array([3, 2]))\nright_entropy_2 = entropy(np.array([3, 2]))\nig_split2 = original_entropy - (5/10 * left_entropy_2 + 5/10 * right_entropy_2)\n\nprint(f\"Original entropy: {original_entropy:.3f} bits\")\nprint(f\"\\nSplit 1 (pure left): Information Gain = {ig_split1:.3f}\")\nprint(f\"Split 2 (balanced): Information Gain = {ig_split2:.3f}\")\nprint(f\"\\nBetter split: Split 1 (higher IG = purer children)\")"
        ]
      ]
    }
