        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\ndef entropy(probabilities):\n    \"\"\"Compute Shannon entropy\"\"\"\n    return -np.sum(probabilities[probabilities > 0] * np.log2(probabilities[probabilities > 0]))\n\n# Examples\nscenarios = {\n    'Certain (always heads)': [1.0, 0.0],\n    'Fair coin': [0.5, 0.5],\n    'Biased (80% heads)': [0.8, 0.2],\n    'Uniform 4-sided die': [0.25, 0.25, 0.25, 0.25]\n}\n\nprint(\"Shannon Entropy Examples (in bits):\\n\")\nfor name, probs in scenarios.items():\n    h = entropy(np.array(probs))\n    print(f\"{name:25} H(X) = {h:.3f} bits\")\n\n# Plot entropy of coin flip as p varies\np_values = np.linspace(0, 1, 100)\nentropies = [-p * np.log2(p + 1e-10) - (1-p) * np.log2(1-p + 1e-10) for p in p_values]\n\nplt.figure(figsize=(8, 5))\nplt.plot(p_values, entropies, linewidth=2)\nplt.xlabel('P(Heads)')\nplt.ylabel('H(X) in bits')\nplt.title('Shannon Entropy of Fair Coin (varies with bias)')\nplt.grid()\nplt.axvline(0.5, color='r', linestyle='--', alpha=0.5, label='Maximum at p=0.5')\nplt.legend()\nplt.show()"
        ]
      ]
    },
    {
