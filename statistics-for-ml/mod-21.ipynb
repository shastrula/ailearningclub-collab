          "python",
          "import numpy as np\nfrom sklearn.datasets import load_iris\nfrom sklearn.feature_selection import mutual_info_classif\n\n# Load data\nX, y = load_iris(return_X_y=True)\n\n# Compute mutual information between each feature and target\nmi_scores = mutual_info_classif(X, y, random_state=42)\nfeature_names = ['Sepal length', 'Sepal width', 'Petal length', 'Petal width']\n\nprint(\"Mutual Information with target class:\\n\")\nfor name, score in sorted(zip(feature_names, mi_scores), key=lambda x: -x[1]):\n    print(f\"{name:20} I(X; Y) = {score:.4f}\")\n\nprint(\"\\nInterpretation: Petal length/width carry more information about iris species\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
