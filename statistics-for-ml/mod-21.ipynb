          "python",
          "import numpy as np\n\n# For a 6-sided die:\n# Uniform: H = log2(6) \u2248 2.585 bits (maximum)\n# Loaded die: H < 2.585\n\n# Uniform\nuniform_entropy = np.log2(6)\n\n# Loaded: 50% on 1, 10% on each of 2-6\nloaded_probs = np.array([0.5] + [0.1]*5)\nloaded_entropy = -np.sum(loaded_probs * np.log2(loaded_probs + 1e-10))\n\nprint(f\"Uniform distribution: H = {uniform_entropy:.3f} bits\")\nprint(f\"Loaded distribution: H = {loaded_entropy:.3f} bits\")\nprint(f\"Loaded die has lower entropy (less uncertainty)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
