          "python",
          "Prior\u2080 \u2192 observe data\u2081 \u2192 Posterior\u2081 \u2192 becomes Prior\u2081 \u2192 observe data\u2082 \u2192 Posterior\u2082 \u2192 ..."
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from scipy.stats import beta\n\n# Sequential belief updating about a coin's fairness\n# Prior: coin is fair (Beta(10, 10))\nalpha, beta_param = 10, 10\n\nobservations = [1, 1, 0, 1, 1, 1, 0, 1]  # 1=heads, 0=tails\nprobabilities = []\n\nprint(\"Sequential Belief Updating\")\nprint(f\"Prior: Beta({alpha}, {beta_param})\")\nprint()\n\nfor i, obs in enumerate(observations):\n    # Update: add observation to counts\n    if obs == 1:\n        alpha += 1\n    else:\n        beta_param += 1\n    \n    # Posterior mean (best estimate of p)\n    p_heads = alpha / (alpha + beta_param)\n    probabilities.append(p_heads)\n    \n    print(f\"After flip {i+1} ({'H' if obs == 1 else 'T'}): Beta({alpha}, {beta_param}), E[p]={p_heads:.3f}\")\n\n# Plot convergence\nplt.figure(figsize=(10, 6))\nflips = range(1, len(observations) + 1)\nplt.plot(flips, probabilities, marker='o', linewidth=2, markersize=6)\nplt.axhline(0.625, color='r', linestyle='--', label='True p (observed 5/8)')\nplt.xlabel('Number of Flips Observed')\nplt.ylabel('Posterior Mean P(Heads)')\nplt.title('Belief Convergence Through Sequential Updates')\nplt.grid(alpha=0.3)\nplt.legend()\nplt.ylim([0.4, 0.8])\nplt.show()\n\nprint(f\"\\nBelief converges toward observed frequency as evidence accumulates\")"
        ]
      ]
