      "source": [
        [
          "python",
          "import pandas as pd\nfrom sklearn.naive_bayes import MultinomialNB\nfrom sklearn.feature_extraction.text import CountVectorizer\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import confusion_matrix, classification_report\n\n# Simulate email dataset\nnp.random.seed(42)\nspam_words = ['win', 'free', 'click', 'limited', 'offer', 'buy', 'money']\nham_words = ['meeting', 'project', 'thanks', 'team', 'update', 'regarding']\n\n# Generate emails\ndef generate_emails(n_spam, n_ham):\n    spam_emails = [' '.join(np.random.choice(spam_words, 5)) for _ in range(n_spam)]\n    ham_emails = [' '.join(np.random.choice(ham_words, 5)) for _ in range(n_ham)]\n    \n    texts = spam_emails + ham_emails\n    labels = [1] * n_spam + [0] * n_ham\n    \n    return texts, labels\n\ntexts, labels = generate_emails(100, 100)\n\n# Feature extraction\nvectorizer = CountVectorizer(lowercase=True)\nX = vectorizer.fit_transform(texts)\n\n# Train Naive Bayes\nnb = MultinomialNB()\nnb.fit(X, labels)\n\n# Predictions with probabilities\ntest_email = \"Limited time offer to win free money\"\nX_test = vectorizer.transform([test_email])\n\npred = nb.predict(X_test)[0]\nprobs = nb.predict_proba(X_test)[0]\n\nprint(f\"Email: '{test_email}'\")\nprint(f\"P(Spam | Email) = {probs[1]:.3f}\")\nprint(f\"P(Ham | Email) = {probs[0]:.3f}\")\nprint(f\"Classification: {'SPAM' if pred == 1 else 'HAM'}\")\n\n# How Naive Bayes works internally:\n# P(Spam | words) \u221d P(words | Spam) \u00d7 P(Spam)\n# P(words | Spam) = \u220f P(word_i | Spam)  [independence assumption]\nprint(f\"\\nFeature importance (log probabilities):\")\nfor word, idx in list(vectorizer.vocabulary_.items())[:5]:\n    spam_prob = np.exp(nb.feature_log_prob_[1, idx])\n    ham_prob = np.exp(nb.feature_log_prob_[0, idx])\n    print(f\"  {word}: P(word|Spam)={spam_prob:.3f}, P(word|Ham)={ham_prob:.3f}\")"
        ]
      ]
    },
