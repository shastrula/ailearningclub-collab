      "source": [
        [
          "python",
          "P(Disease | Positive) = P(Positive | Disease) \u00d7 P(Disease) / P(Positive)\n\nP(Positive) = P(Positive|Disease) \u00d7 P(Disease) + P(Positive|\u00acDisease) \u00d7 P(\u00acDisease)\n            = 0.95 \u00d7 0.01 + 0.10 \u00d7 0.99\n            = 0.0095 + 0.099 = 0.1085\n\nP(Disease | Positive) = (0.95 \u00d7 0.01) / 0.1085 \u2248 0.087 \u2248 8.7%"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\ndef bayes_disease_test(prevalence, sensitivity, specificity):\n    \"\"\"\n    Compute P(Disease | Positive test) using Bayes' theorem.\n    \"\"\"\n    # Marginal probability of positive test\n    p_positive = (sensitivity * prevalence + \n                  (1 - specificity) * (1 - prevalence))\n    \n    # Posterior: probability of disease given positive test\n    p_disease_given_positive = (sensitivity * prevalence) / p_positive\n    \n    return p_disease_given_positive\n\n# Scenario 1: Rare disease (prevalence 1%)\np1 = bayes_disease_test(0.01, 0.95, 0.90)\nprint(f\"Rare disease (1% prevalence): P(Disease | +) = {p1:.1%}\")\n\n# Scenario 2: Common disease (prevalence 30%)\np2 = bayes_disease_test(0.30, 0.95, 0.90)\nprint(f\"Common disease (30% prevalence): P(Disease | +) = {p2:.1%}\")\n\n# Sensitivity analysis\nprevalences = np.linspace(0.001, 0.5, 100)\nposteriors = [bayes_disease_test(p, 0.95, 0.90) for p in prevalences]\n\nplt.figure(figsize=(10, 6))\nplt.plot(prevalences * 100, np.array(posteriors) * 100, linewidth=2)\nplt.xlabel('Prior Prevalence (%)')\nplt.ylabel('P(Disease | Positive Test) (%)')\nplt.title(\"Bayes' Theorem: How Base Rate Affects Diagnosis\")\nplt.grid(alpha=0.3)\nplt.axhline(95, color='r', linestyle='--', label='Test Sensitivity (95%)')\nplt.legend()\nplt.show()\n\n# Key insight: posterior strongly depends on base rate"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
