    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Simplified search ranking with Bayesian combination of signals\ndef compute_relevance_score(query, doc, \n                            term_overlap_prob=0.8,\n                            authority_prob=0.6,\n                            click_history_prob=0.7,\n                            prior_relevant=0.1):\n    \"\"\"\n    Approximate P(Relevant | query, doc) by combining signals.\n    Using simplified independence assumption.\n    \"\"\"\n    # Likelihood: if relevant, what's probability of observing these signals?\n    p_signals_given_relevant = term_overlap_prob * authority_prob * click_history_prob\n    \n    # If not relevant, signals are less likely\n    p_signals_given_not_relevant = 0.1 * 0.3 * 0.2\n    \n    # Bayes' theorem\n    p_relevant = (p_signals_given_relevant * prior_relevant) / (\n        p_signals_given_relevant * prior_relevant + \n        p_signals_given_not_relevant * (1 - prior_relevant)\n    )\n    \n    return p_relevant\n\n# Example documents\ndocs = [\n    {\"query_match\": 0.9, \"authority\": 0.9, \"clicks\": 0.8},\n    {\"query_match\": 0.7, \"authority\": 0.3, \"clicks\": 0.2},\n    {\"query_match\": 0.5, \"authority\": 0.8, \"clicks\": 0.9},\n]\n\nscores = []\nfor i, doc in enumerate(docs):\n    score = compute_relevance_score(None, None,\n                                   term_overlap_prob=doc[\"query_match\"],\n                                   authority_prob=doc[\"authority\"],\n                                   click_history_prob=doc[\"clicks\"])\n    scores.append(score)\n    print(f\"Document {i+1}: P(Relevant) = {score:.3f}\")\n\n# Rank by posterior relevance\nranking = sorted(range(len(scores)), key=lambda i: scores[i], reverse=True)\nprint(f\"\\nRanking: {[i+1 for i in ranking]}\")"
        ]
      ]
