        [
          "python",
          "For \u03b8 = (\u03b8\u2081, \u03b8\u2082, ...):\n1. \u03b8\u2081^(t) ~ p(\u03b8\u2081 | \u03b8\u2082^(t-1), \u03b8\u2083^(t-1), ..., data)\n2. \u03b8\u2082^(t) ~ p(\u03b8\u2082 | \u03b8\u2081^(t), \u03b8\u2083^(t-1), ..., data)\n3. ... [cycle through all parameters]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Example: Linear regression with Gibbs sampling\nnp.random.seed(42)\n\n# Generate synthetic data: y = 2x + 1 + noise\nx = np.random.uniform(0, 5, 50)\ntrue_slope = 2\ntrue_intercept = 1\ny = true_intercept + true_slope * x + np.random.normal(0, 0.5, 50)\n\n# Model: y = \u03b1 + \u03b2*x + \u03b5, \u03b5 ~ N(0, \u03c3\u00b2)\n# Gibbs sampling for (\u03b1, \u03b2, \u03c3\u00b2)\n\ndef gibbs_linear_regression(x, y, n_iter=1000):\n    \"\"\"\n    Gibbs sampling for simple linear regression.\n    \"\"\"\n    n = len(x)\n    samples_alpha = []\n    samples_beta = []\n    samples_sigma = []\n    \n    # Initialize\n    alpha = 0\n    beta = 0\n    sigma = 1\n    \n    # Design matrix\n    X = np.column_stack([np.ones(n), x])\n    \n    for _ in range(n_iter):\n        # Residuals\n        residuals = y - (alpha + beta * x)\n        \n        # Gibbs step 1: sample (\u03b1, \u03b2) | \u03c3, data\n        # Normal regression posterior\n        XtX = X.T @ X\n        Xty = X.T @ y\n        \n        # Prior: weak (\u03b1, \u03b2) ~ N(0, 100\u00b2)\n        prior_precision = np.eye(2) / 10000\n        \n        # Posterior precision and mean\n        post_precision = XtX / sigma**2 + prior_precision\n        post_cov = np.linalg.inv(post_precision)\n        post_mean = post_cov @ (Xty / sigma**2)\n        \n        # Sample regression coefficients\n        coefs = np.random.multivariate_normal(post_mean, post_cov)\n        alpha, beta = coefs\n        \n        # Gibbs step 2: sample \u03c3\u00b2 | \u03b1, \u03b2, data\n        # Inverse Gamma posterior\n        shape = 1 + n/2  # Prior: IG(1, 1)\n        scale = 1 + np.sum(residuals**2) / 2\n        \n        sigma = 1 / np.sqrt(np.random.gamma(shape, 1/scale))\n        \n        samples_alpha.append(alpha)\n        samples_beta.append(beta)\n        samples_sigma.append(sigma)\n    \n    return np.array(samples_alpha), np.array(samples_beta), np.array(samples_sigma)\n\nalpha_samples, beta_samples, sigma_samples = gibbs_linear_regression(x, y, n_iter=1000)\n\n# Burn-in: discard first 100 samples\nalpha_post = alpha_samples[100:]\nbeta_post = beta_samples[100:]\n\nprint(f\"Gibbs Sampling Results (Linear Regression):\")\nprint(f\"\u03b1 posterior mean: {alpha_post.mean():.3f} (true: {true_intercept})\")\nprint(f\"\u03b2 posterior mean: {beta_post.mean():.3f} (true: {true_slope})\")\nprint(f\"\u03c3 posterior mean: {sigma_samples[100:].mean():.3f}\")\n\nplt.figure(figsize=(12, 4))\nplt.subplot(1, 3, 1)\nplt.hist(alpha_post, bins=30, density=True, alpha=0.7)\nplt.xlabel('\u03b1')\nplt.axvline(true_intercept, color='r', linestyle='--', label='True')\nplt.legend()\n\nplt.subplot(1, 3, 2)\nplt.hist(beta_post, bins=30, density=True, alpha=0.7)\nplt.xlabel('\u03b2')\nplt.axvline(true_slope, color='r', linestyle='--', label='True')\nplt.legend()\n\nplt.subplot(1, 3, 3)\nplt.scatter(alpha_post, beta_post, alpha=0.3, s=10)\nplt.xlabel('\u03b1')\nplt.ylabel('\u03b2')\nplt.title('Posterior correlation')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
