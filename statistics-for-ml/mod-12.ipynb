          "python",
          "# Multiple chains for convergence diagnostics\ndef run_multiple_chains(data, n_chains=4, n_iter=5000):\n    \"\"\"Run MCMC from different starting points.\"\"\"\n    all_samples = []\n    \n    for chain_id in range(n_chains):\n        # Random starting point\n        np.random.seed(chain_id)\n        samples, _ = metropolis_hastings(data, n_iter=n_iter)\n        all_samples.append(samples)\n    \n    return np.array(all_samples)\n\nchains = run_multiple_chains(data, n_chains=4)\n\n# Gelman-Rubin statistic (simplified)\ndef gelman_rubin(chains):\n    \"\"\"Compute R\u0302 from multiple chains.\"\"\"\n    n_chains, n_iter = chains.shape\n    \n    # Discard burn-in\n    chains = chains[:, 1000:]\n    n_iter = chains.shape[1]\n    \n    # Between-chain variance\n    chain_means = chains.mean(axis=1)\n    B = n_iter * chain_means.var()\n    \n    # Within-chain variance\n    W = chains.var(axis=1).mean()\n    \n    # Potential scale reduction factor\n    var_hat = (n_iter - 1) / n_iter * W + B / n_iter\n    R_hat = np.sqrt(var_hat / W)\n    \n    return R_hat\n\nr_hat = gelman_rubin(chains)\nprint(f\"Gelman-Rubin R\u0302: {r_hat:.3f} (< 1.05 indicates convergence \u2713)\")\n\n# Visualize chains\nplt.figure(figsize=(10, 6))\nfor i in range(4):\n    plt.plot(chains[i], alpha=0.5, label=f'Chain {i+1}')\nplt.xlabel('Iteration')\nplt.ylabel('\u03bc')\nplt.title('Multiple MCMC Chains: Check for Convergence')\nplt.axvline(1000, color='r', linestyle='--', alpha=0.5, label='Burn-in end')\nplt.legend()\nplt.grid(alpha=0.3)\nplt.show()"
        ]
