          "python",
          "1. Start at \u03b8\u2080\n2. For t = 1, 2, ..., N:\n   a. Propose \u03b8* ~ q(\u03b8*|\u03b8_t)  [proposal distribution]\n   b. Compute acceptance ratio:\n      \u03b1 = p(\u03b8*|D) / p(\u03b8_t|D) \u00d7 q(\u03b8_t|\u03b8*) / q(\u03b8*|\u03b8_t)\n   c. Accept \u03b8_{t+1} = \u03b8* with probability min(1, \u03b1)\n      Otherwise set \u03b8_{t+1} = \u03b8_t"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.stats import norm, uniform\n\n# Example: Estimate mean of data from Normal distribution\nnp.random.seed(42)\n\n# True data: generated from N(5, 1)\ndata = np.random.normal(5, 1, 100)\n\n# Posterior is proportional to:\n# p(\u03bc|data) \u221d p(data|\u03bc) \u00d7 p(\u03bc)\n# = \u220f N(y_i | \u03bc, 1) \u00d7 N(\u03bc | 0, 10)\n\ndef log_posterior(mu, data, prior_mean=0, prior_std=10, likelihood_std=1):\n    \"\"\"Log of posterior (up to constant)\"\"\"\n    # Log likelihood\n    log_like = -0.5 * np.sum((data - mu)**2 / likelihood_std**2)\n    \n    # Log prior\n    log_prior = -0.5 * (mu - prior_mean)**2 / prior_std**2\n    \n    return log_like + log_prior\n\n# Metropolis-Hastings\ndef metropolis_hastings(data, n_iter=5000, proposal_std=0.5):\n    \"\"\"\n    MCMC sampling from posterior over mean.\n    \"\"\"\n    samples = np.zeros(n_iter)\n    samples[0] = 0  # Start at prior mean\n    \n    n_accepted = 0\n    \n    for t in range(1, n_iter):\n        # Propose new value (symmetric random walk)\n        mu_current = samples[t-1]\n        mu_proposed = mu_current + np.random.normal(0, proposal_std)\n        \n        # Acceptance ratio (symmetric proposal cancels out)\n        log_alpha = (log_posterior(mu_proposed, data) - \n                     log_posterior(mu_current, data))\n        \n        # Accept/reject\n        if np.log(np.random.uniform()) < log_alpha:\n            samples[t] = mu_proposed\n            n_accepted += 1\n        else:\n            samples[t] = mu_current\n    \n    acceptance_rate = n_accepted / n_iter\n    return samples, acceptance_rate\n\nsamples_mh, acc_rate = metropolis_hastings(data, n_iter=5000)\n\nprint(f\"Metropolis-Hastings Results:\")\nprint(f\"Acceptance rate: {acc_rate:.1%} (target: 20-50%)\")\nprint(f\"Sample mean: {samples_mh[1000:].mean():.3f}\")  # Discard burn-in\nprint(f\"True mean: {data.mean():.3f}\")\nprint(f\"95% Credible Interval: [{np.percentile(samples_mh[1000:], 2.5):.3f}, {np.percentile(samples_mh[1000:], 97.5):.3f}]\")\n\n# Trace plot\nfig, axes = plt.subplots(2, 2, figsize=(12, 8))\n\n# Trace\naxes[0, 0].plot(samples_mh[:500], alpha=0.7)\naxes[0, 0].set_title('Trace (first 500 iterations)')\naxes[0, 0].set_ylabel('\u03bc')\naxes[0, 0].axhline(data.mean(), color='r', linestyle='--', label='True mean')\naxes[0, 0].legend()\n\n# Trace after burn-in\naxes[0, 1].plot(samples_mh[1000:2000], alpha=0.7)\naxes[0, 1].set_title('Trace (after burn-in)')\naxes[0, 1].set_ylabel('\u03bc')\n\n# Histogram\naxes[1, 0].hist(samples_mh[1000:], bins=50, density=True, alpha=0.7)\naxes[1, 0].set_xlabel('\u03bc')\naxes[1, 0].set_ylabel('Density')\naxes[1, 0].set_title('Posterior Distribution')\n\n# ACF (autocorrelation)\nacf = np.correlate(samples_mh[1000:] - samples_mh[1000:].mean(), \n                    samples_mh[1000:] - samples_mh[1000:].mean(), \n                    mode='full')\nacf = acf[len(acf)//2:] / acf[len(acf)//2]\naxes[1, 1].plot(acf[:100])\naxes[1, 1].set_xlabel('Lag')\naxes[1, 1].set_ylabel('Autocorrelation')\naxes[1, 1].set_title('ACF: Samples are correlated')\naxes[1, 1].grid(alpha=0.3)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
