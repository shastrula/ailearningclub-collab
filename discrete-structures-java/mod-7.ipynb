          "java",
          "import java.util.*;\n\npublic class SubsetRelations {\n\n    // A is subset of B if every element of A is also in B\n    public static <T> boolean isSubset(Set<T> a, Set<T> b) {\n        return b.containsAll(a);\n    }\n\n    // A is proper subset of B if A is subset of B and A != B\n    public static <T> boolean isProperSubset(Set<T> a, Set<T> b) {\n        return isSubset(a, b) && !a.equals(b);\n    }\n\n    // A is superset of B if B is subset of A\n    public static <T> boolean isSuperset(Set<T> a, Set<T> b) {\n        return isSubset(b, a);\n    }\n\n    // Two sets are disjoint if their intersection is empty\n    public static <T> boolean areDisjoint(Set<T> a, Set<T> b) {\n        return Collections.disjoint(a, b);\n    }\n\n    public static void main(String[] args) {\n        Set<Integer> A = new HashSet<>(Arrays.asList(1, 2, 3));\n        Set<Integer> B = new HashSet<>(Arrays.asList(1, 2, 3, 4, 5));\n        Set<Integer> C = new HashSet<>(Arrays.asList(6, 7, 8));\n        Set<Integer> D = new HashSet<>(Arrays.asList(1, 2, 3));\n\n        System.out.println(\"A = \" + A);\n        System.out.println(\"B = \" + B);\n        System.out.println(\"C = \" + C);\n        System.out.println(\"D = \" + D);\n\n        System.out.println(\"\\nA subset of B: \" + isSubset(A, B));         // true\n        System.out.println(\"A proper subset of B: \" + isProperSubset(A, B)); // true\n        System.out.println(\"A subset of D: \" + isSubset(A, D));           // true\n        System.out.println(\"A proper subset of D: \" + isProperSubset(A, D)); // false (equal)\n        System.out.println(\"B superset of A: \" + isSuperset(B, A));       // true\n        System.out.println(\"A and C disjoint: \" + areDisjoint(A, C));     // true\n        System.out.println(\"A and B disjoint: \" + areDisjoint(A, B));     // false\n    }\n}"
        ]
      ]
