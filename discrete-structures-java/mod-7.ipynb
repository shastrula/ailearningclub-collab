          "java",
          "import java.util.*;\n\npublic class SetBasics {\n\n    public static void main(String[] args) {\n        // Creating sets - duplicates are automatically removed\n        Set<Integer> A = new HashSet<>(Arrays.asList(1, 2, 3, 4, 5));\n        Set<Integer> B = new HashSet<>(Arrays.asList(3, 4, 5, 6, 7));\n\n        // Set equality - order does not matter\n        Set<Integer> C = new HashSet<>(Arrays.asList(5, 3, 1, 4, 2));\n        System.out.println(\"A = \" + A);\n        System.out.println(\"C = \" + C);\n        System.out.println(\"A equals C: \" + A.equals(C)); // true\n\n        // Membership testing (element-of operator)\n        System.out.println(\"\\n3 is element of A: \" + A.contains(3));   // true\n        System.out.println(\"8 is element of A: \" + A.contains(8)); // false\n\n        // Cardinality (size of the set)\n        System.out.println(\"\\n|A| = \" + A.size()); // 5\n        System.out.println(\"|B| = \" + B.size()); // 5\n\n        // Empty set\n        Set<Integer> empty = Collections.emptySet();\n        System.out.println(\"Empty set: \" + empty);\n        System.out.println(\"|empty| = \" + empty.size()); // 0\n\n        // Set with no duplicates enforced\n        Set<String> words = new HashSet<>();\n        words.add(\"hello\");\n        words.add(\"world\");\n        words.add(\"hello\"); // duplicate, not added\n        System.out.println(\"\\nWords: \" + words);\n        System.out.println(\"|words| = \" + words.size()); // 2\n    }\n}"
        ]
      ]
