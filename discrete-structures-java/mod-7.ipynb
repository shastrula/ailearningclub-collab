          "java",
          "import java.util.*;\nimport java.util.stream.*;\n\npublic class CartesianProduct {\n\n    public record Pair<A, B>(A first, B second) {\n        @Override\n        public String toString() {\n            return \"(\" + first + \", \" + second + \")\";\n        }\n    }\n\n    public static <A, B> Set<Pair<A, B>> cartesianProduct(Set<A> setA, Set<B> setB) {\n        return setA.stream()\n            .flatMap(a -> setB.stream().map(b -> new Pair<>(a, b)))\n            .collect(Collectors.toSet());\n    }\n\n    public static void main(String[] args) {\n        Set<Integer> A = new LinkedHashSet<>(Arrays.asList(1, 2, 3));\n        Set<String> B = new LinkedHashSet<>(Arrays.asList(\"a\", \"b\"));\n\n        Set<Pair<Integer, String>> product = cartesianProduct(A, B);\n\n        System.out.println(\"A = \" + A);\n        System.out.println(\"B = \" + B);\n        System.out.println(\"|A x B| = \" + product.size()); // 6\n        System.out.println(\"A x B = \" + product);\n\n        // |A x B| = |A| * |B|\n        System.out.println(\"\\n|A| * |B| = \" + (A.size() * B.size()));\n        System.out.println(\"Equals |A x B|: \" + (product.size() == A.size() * B.size()));\n    }\n}"
        ]
