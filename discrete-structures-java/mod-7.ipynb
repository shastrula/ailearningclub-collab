          "java",
          "import java.util.*;\nimport java.util.stream.*;\n\npublic class SetBuilder {\n\n    public static void main(String[] args) {\n        // Universal set of integers 1 to 100\n        Set<Integer> U = IntStream.rangeClosed(1, 100)\n            .boxed()\n            .collect(Collectors.toSet());\n\n        // {x in U | x is even}\n        Set<Integer> evens = U.stream()\n            .filter(x -> x % 2 == 0)\n            .collect(Collectors.toSet());\n        System.out.println(\"Evens (first 10): \" +\n            evens.stream().sorted().limit(10).toList());\n\n        // {x in U | x is prime}\n        Set<Integer> primes = U.stream()\n            .filter(SetBuilder::isPrime)\n            .collect(Collectors.toSet());\n        System.out.println(\"Primes: \" + new TreeSet<>(primes));\n\n        // {x^2 | x in {1..10}}\n        Set<Integer> squares = IntStream.rangeClosed(1, 10)\n            .map(x -> x * x)\n            .boxed()\n            .collect(Collectors.toSet());\n        System.out.println(\"Squares: \" + new TreeSet<>(squares));\n\n        // {x in U | x is prime AND x > 50}\n        Set<Integer> largePrimes = U.stream()\n            .filter(x -> isPrime(x) && x > 50)\n            .collect(Collectors.toSet());\n        System.out.println(\"Primes > 50: \" + new TreeSet<>(largePrimes));\n\n        // Intersection using set builder: {x | x in evens AND x in primes}\n        Set<Integer> evenPrimes = evens.stream()\n            .filter(primes::contains)\n            .collect(Collectors.toSet());\n        System.out.println(\"Even primes: \" + evenPrimes);\n    }\n\n    private static boolean isPrime(int n) {\n        if (n < 2) return false;\n        for (int i = 2; i <= Math.sqrt(n); i++) {\n            if (n % i == 0) return false;\n        }\n        return true;\n    }\n}"
        ]
      ]
