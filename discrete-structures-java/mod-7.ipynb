          "java",
          "import java.util.*;\n\npublic class SetImplementations {\n\n    public static void main(String[] args) {\n        // HashSet - O(1) average for add, remove, contains. Unordered.\n        Set<String> hashSet = new HashSet<>();\n        hashSet.addAll(Arrays.asList(\"banana\", \"apple\", \"cherry\", \"date\"));\n        System.out.println(\"HashSet (unordered): \" + hashSet);\n\n        // TreeSet - O(log n) for operations. Sorted order.\n        Set<String> treeSet = new TreeSet<>(hashSet);\n        System.out.println(\"TreeSet (sorted): \" + treeSet);\n\n        // LinkedHashSet - O(1) operations. Maintains insertion order.\n        Set<String> linkedSet = new LinkedHashSet<>();\n        linkedSet.addAll(Arrays.asList(\"banana\", \"apple\", \"cherry\", \"date\"));\n        System.out.println(\"LinkedHashSet (insertion order): \" + linkedSet);\n\n        // EnumSet - very efficient for enum types\n        Set<java.time.DayOfWeek> weekdays = EnumSet.range(\n            java.time.DayOfWeek.MONDAY, java.time.DayOfWeek.FRIDAY);\n        System.out.println(\"EnumSet weekdays: \" + weekdays);\n\n        // Immutable sets (Java 9+)\n        Set<Integer> immutable = Set.of(1, 2, 3, 4, 5);\n        System.out.println(\"Immutable set: \" + immutable);\n    }\n}"
        ]
      ]
