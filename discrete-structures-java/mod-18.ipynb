          "import java.util.*;\nimport java.util.stream.*;\n\npublic class DegreeSequence {\n\n    // Check if a sequence is a valid degree sequence (Erdos-Gallai theorem)\n    public static boolean isGraphical(int[] sequence) {\n        int[] d = sequence.clone();\n        Arrays.sort(d);\n        // Reverse to get non-increasing\n        for (int i = 0; i < d.length / 2; i++) {\n            int temp = d[i]; d[i] = d[d.length-1-i]; d[d.length-1-i] = temp;\n        }\n\n        int n = d.length;\n        int sum = Arrays.stream(d).sum();\n\n        // Sum must be even (handshaking lemma)\n        if (sum % 2 != 0) return false;\n\n        // Erdos-Gallai: for each k, sum_{i=1}^k d_i <= k(k-1) + sum_{i=k+1}^n min(d_i, k)\n        for (int k = 1; k <= n; k++) {\n            int leftSum = 0;\n            for (int i = 0; i < k; i++) leftSum += d[i];\n\n            int rightSide = k * (k - 1);\n            for (int i = k; i < n; i++) {\n                rightSide += Math.min(d[i], k);\n            }\n            if (leftSum > rightSide) return false;\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        int[][] sequences = {\n            {3, 3, 3, 3},        // K_4: valid\n            {2, 2, 2, 2, 2},     // C_5: valid\n            {4, 3, 2, 2, 1},     // valid\n            {3, 3, 3, 1},        // sum is odd: invalid\n            {5, 1, 1, 1, 1, 1},  // valid (star graph)\n            {4, 4, 3, 2, 1}      // invalid\n        };\n\n        System.out.println(\"Degree Sequence Validity:\");\n        for (int[] seq : sequences) {\n            System.out.printf(\"  %s: %s%n\", Arrays.toString(seq),\n                isGraphical(seq) ? \"VALID\" : \"INVALID\");\n        }\n    }\n}"
