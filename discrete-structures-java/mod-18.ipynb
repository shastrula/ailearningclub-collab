          "java",
          "import java.util.*;\nimport java.util.stream.*;\n\npublic class GraphBasics {\n\n    // Undirected graph using adjacency list\n    static class UndirectedGraph {\n        private final int numVertices;\n        private final Map<Integer, Set<Integer>> adjacency;\n\n        public UndirectedGraph(int numVertices) {\n            this.numVertices = numVertices;\n            this.adjacency = new HashMap<>();\n            for (int i = 0; i < numVertices; i++) {\n                adjacency.put(i, new HashSet<>());\n            }\n        }\n\n        public void addEdge(int u, int v) {\n            adjacency.get(u).add(v);\n            adjacency.get(v).add(u);\n        }\n\n        public Set<Integer> neighbors(int v) {\n            return Collections.unmodifiableSet(adjacency.get(v));\n        }\n\n        public int degree(int v) {\n            return adjacency.get(v).size();\n        }\n\n        public int numEdges() {\n            return adjacency.values().stream().mapToInt(Set::size).sum() / 2;\n        }\n\n        public int numVertices() { return numVertices; }\n    }\n\n    // Directed graph\n    static class DirectedGraph {\n        private final int numVertices;\n        private final Map<Integer, Set<Integer>> outgoing;\n        private final Map<Integer, Set<Integer>> incoming;\n\n        public DirectedGraph(int numVertices) {\n            this.numVertices = numVertices;\n            outgoing = new HashMap<>();\n            incoming = new HashMap<>();\n            for (int i = 0; i < numVertices; i++) {\n                outgoing.put(i, new HashSet<>());\n                incoming.put(i, new HashSet<>());\n            }\n        }\n\n        public void addEdge(int from, int to) {\n            outgoing.get(from).add(to);\n            incoming.get(to).add(from);\n        }\n\n        public int outDegree(int v) { return outgoing.get(v).size(); }\n        public int inDegree(int v) { return incoming.get(v).size(); }\n    }\n\n    public static void main(String[] args) {\n        UndirectedGraph g = new UndirectedGraph(5);\n        g.addEdge(0, 1);\n        g.addEdge(0, 2);\n        g.addEdge(1, 2);\n        g.addEdge(1, 3);\n        g.addEdge(3, 4);\n\n        System.out.println(\"Undirected Graph:\");\n        System.out.println(\"  Vertices: \" + g.numVertices());\n        System.out.println(\"  Edges: \" + g.numEdges());\n        for (int v = 0; v < g.numVertices(); v++) {\n            System.out.printf(\"  Vertex %d: degree=%d, neighbors=%s%n\",\n                v, g.degree(v), g.neighbors(v));\n        }\n\n        // Handshaking lemma: sum of degrees = 2 * |E|\n        int degreeSum = IntStream.range(0, g.numVertices()).map(g::degree).sum();\n        System.out.println(\"\\n  Sum of degrees: \" + degreeSum);\n        System.out.println(\"  2 * |E|: \" + (2 * g.numEdges()));\n        System.out.println(\"  Handshaking lemma verified: \" + (degreeSum == 2 * g.numEdges()));\n    }\n}"
        ]
