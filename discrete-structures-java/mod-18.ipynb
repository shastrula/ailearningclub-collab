          "java",
          "import java.util.*;\n\npublic class SpecialGraphs {\n\n    static class Graph {\n        int n;\n        Map<Integer, Set<Integer>> adj = new HashMap<>();\n\n        Graph(int n) {\n            this.n = n;\n            for (int i = 0; i < n; i++) adj.put(i, new HashSet<>());\n        }\n        void addEdge(int u, int v) { adj.get(u).add(v); adj.get(v).add(u); }\n        int degree(int v) { return adj.get(v).size(); }\n        int edges() { return adj.values().stream().mapToInt(Set::size).sum() / 2; }\n    }\n\n    // Complete graph K_n: every pair of vertices is connected\n    public static Graph completeGraph(int n) {\n        Graph g = new Graph(n);\n        for (int i = 0; i < n; i++)\n            for (int j = i + 1; j < n; j++)\n                g.addEdge(i, j);\n        return g;\n    }\n\n    // Cycle graph C_n: vertices form a single cycle\n    public static Graph cycleGraph(int n) {\n        Graph g = new Graph(n);\n        for (int i = 0; i < n; i++)\n            g.addEdge(i, (i + 1) % n);\n        return g;\n    }\n\n    // Complete bipartite graph K_{m,n}\n    public static Graph completeBipartite(int m, int n) {\n        Graph g = new Graph(m + n);\n        for (int i = 0; i < m; i++)\n            for (int j = m; j < m + n; j++)\n                g.addEdge(i, j);\n        return g;\n    }\n\n    // Path graph P_n\n    public static Graph pathGraph(int n) {\n        Graph g = new Graph(n);\n        for (int i = 0; i < n - 1; i++)\n            g.addEdge(i, i + 1);\n        return g;\n    }\n\n    public static void main(String[] args) {\n        // K_5: complete graph on 5 vertices\n        Graph k5 = completeGraph(5);\n        System.out.println(\"K_5: vertices=\" + k5.n + \", edges=\" + k5.edges());\n        System.out.println(\"  Each vertex degree: \" + k5.degree(0));\n        System.out.println(\"  Formula: C(5,2) = \" + (5*4/2));\n\n        // C_6: cycle on 6 vertices\n        Graph c6 = cycleGraph(6);\n        System.out.println(\"\\nC_6: vertices=\" + c6.n + \", edges=\" + c6.edges());\n        System.out.println(\"  Each vertex degree: \" + c6.degree(0));\n\n        // K_{3,4}: complete bipartite\n        Graph k34 = completeBipartite(3, 4);\n        System.out.println(\"\\nK_{3,4}: vertices=\" + k34.n + \", edges=\" + k34.edges());\n        System.out.println(\"  Formula: 3*4 = 12 edges\");\n\n        // General formulas\n        System.out.println(\"\\nFormulas for special graphs:\");\n        System.out.println(\"  K_n: edges = n(n-1)/2\");\n        System.out.println(\"  C_n: edges = n\");\n        System.out.println(\"  K_{m,n}: edges = m*n\");\n        System.out.println(\"  P_n: edges = n-1\");\n    }\n}"
        ]
