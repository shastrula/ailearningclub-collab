          "java",
          "import java.util.*;\n\npublic class GraphProperties {\n\n    static class Graph {\n        int n;\n        Map<Integer, Set<Integer>> adj = new HashMap<>();\n        Graph(int n) {\n            this.n = n;\n            for (int i = 0; i < n; i++) adj.put(i, new HashSet<>());\n        }\n        void addEdge(int u, int v) { adj.get(u).add(v); adj.get(v).add(u); }\n        int degree(int v) { return adj.get(v).size(); }\n    }\n\n    // Check if graph is connected (all vertices reachable from any vertex)\n    public static boolean isConnected(Graph g) {\n        if (g.n == 0) return true;\n        Set<Integer> visited = new HashSet<>();\n        Queue<Integer> queue = new LinkedList<>();\n        queue.add(0);\n        visited.add(0);\n        while (!queue.isEmpty()) {\n            int v = queue.poll();\n            for (int neighbor : g.adj.get(v)) {\n                if (visited.add(neighbor)) {\n                    queue.add(neighbor);\n                }\n            }\n        }\n        return visited.size() == g.n;\n    }\n\n    // Check if graph is bipartite (2-colorable)\n    public static boolean isBipartite(Graph g) {\n        int[] color = new int[g.n];\n        Arrays.fill(color, -1);\n\n        for (int start = 0; start < g.n; start++) {\n            if (color[start] != -1) continue;\n            Queue<Integer> queue = new LinkedList<>();\n            queue.add(start);\n            color[start] = 0;\n            while (!queue.isEmpty()) {\n                int v = queue.poll();\n                for (int neighbor : g.adj.get(v)) {\n                    if (color[neighbor] == -1) {\n                        color[neighbor] = 1 - color[v];\n                        queue.add(neighbor);\n                    } else if (color[neighbor] == color[v]) {\n                        return false;\n                    }\n                }\n            }\n        }\n        return true;\n    }\n\n    // Check if graph is regular (all vertices have same degree)\n    public static boolean isRegular(Graph g) {\n        if (g.n == 0) return true;\n        int d = g.degree(0);\n        for (int v = 1; v < g.n; v++) {\n            if (g.degree(v) != d) return false;\n        }\n        return true;\n    }\n\n    // Count connected components\n    public static int numComponents(Graph g) {\n        boolean[] visited = new boolean[g.n];\n        int components = 0;\n        for (int v = 0; v < g.n; v++) {\n            if (!visited[v]) {\n                components++;\n                bfs(g, v, visited);\n            }\n        }\n        return components;\n    }\n\n    private static void bfs(Graph g, int start, boolean[] visited) {\n        Queue<Integer> queue = new LinkedList<>();\n        queue.add(start);\n        visited[start] = true;\n        while (!queue.isEmpty()) {\n            int v = queue.poll();\n            for (int neighbor : g.adj.get(v)) {\n                if (!visited[neighbor]) {\n                    visited[neighbor] = true;\n                    queue.add(neighbor);\n                }\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Graph g = new Graph(6);\n        g.addEdge(0, 1); g.addEdge(0, 2);\n        g.addEdge(1, 3); g.addEdge(2, 3);\n        g.addEdge(4, 5); // disconnected component\n\n        System.out.println(\"Graph properties:\");\n        System.out.println(\"  Connected: \" + isConnected(g));\n        System.out.println(\"  Components: \" + numComponents(g));\n        System.out.println(\"  Bipartite: \" + isBipartite(g));\n        System.out.println(\"  Regular: \" + isRegular(g));\n\n        // K_4 is connected, regular, non-bipartite (has odd cycles)\n        Graph k4 = new Graph(4);\n        for (int i = 0; i < 4; i++)\n            for (int j = i+1; j < 4; j++) k4.addEdge(i, j);\n        System.out.println(\"\\nK_4:\");\n        System.out.println(\"  Connected: \" + isConnected(k4));\n        System.out.println(\"  Bipartite: \" + isBipartite(k4));\n        System.out.println(\"  Regular: \" + isRegular(k4));\n\n        // C_4 is bipartite and regular\n        Graph c4 = new Graph(4);\n        c4.addEdge(0,1); c4.addEdge(1,2); c4.addEdge(2,3); c4.addEdge(3,0);\n        System.out.println(\"\\nC_4:\");\n        System.out.println(\"  Bipartite: \" + isBipartite(c4));\n        System.out.println(\"  Regular: \" + isRegular(c4));\n    }\n}"
