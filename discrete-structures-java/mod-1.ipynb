          "java",
          "import java.util.*;\nimport java.util.stream.*;\n\npublic class DiscreteIntro {\n    public static void main(String[] args) {\n        // Sets in Java directly model mathematical sets\n        Set<Integer> primes = new HashSet<>(Arrays.asList(2, 3, 5, 7, 11, 13));\n        Set<Integer> odds = new HashSet<>(Arrays.asList(1, 3, 5, 7, 9, 11, 13));\n\n        // Set intersection - a fundamental discrete math operation\n        Set<Integer> oddPrimes = new HashSet<>(primes);\n        oddPrimes.retainAll(odds);\n        System.out.println(\"Odd primes: \" + oddPrimes);\n\n        // Predicate logic with Java predicates\n        boolean allPrimesPositive = primes.stream().allMatch(p -> p > 0);\n        boolean existsEvenPrime = primes.stream().anyMatch(p -> p % 2 == 0);\n\n        System.out.println(\"All primes positive: \" + allPrimesPositive);\n        System.out.println(\"Exists even prime: \" + existsEvenPrime);\n    }\n}"
        ]
      ]
    },
    {
