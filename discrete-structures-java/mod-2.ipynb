          "java",
          "public class Biconditional {\n    public static boolean iff(boolean p, boolean q) {\n        return p == q;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"T <-> T = \" + iff(true, true));   // true\n        System.out.println(\"T <-> F = \" + iff(true, false));  // false\n        System.out.println(\"F <-> T = \" + iff(false, true));  // false\n        System.out.println(\"F <-> F = \" + iff(false, false)); // true\n    }\n}"
        ]
