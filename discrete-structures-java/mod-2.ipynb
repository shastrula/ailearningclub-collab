          "java",
          "public class Precedence {\n    public static void main(String[] args) {\n        boolean p = true, q = false, r = true;\n\n        // Without parentheses: NOT p AND q OR r means ((NOT p) AND q) OR r\n        boolean expr1 = (!p && q) || r;\n        System.out.println(\"((NOT p) AND q) OR r = \" + expr1);\n\n        // Parentheses change meaning\n        boolean expr2 = !(p && q) || r;\n        boolean expr3 = !(p && (q || r));\n\n        System.out.println(\"NOT(p AND q) OR r = \" + expr2);\n        System.out.println(\"NOT(p AND (q OR r)) = \" + expr3);\n    }\n}"
        ]
      ]
