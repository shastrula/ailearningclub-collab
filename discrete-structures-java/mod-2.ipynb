          "java",
          "public class Implication {\n    // p -> q is false ONLY when p is true and q is false\n    public static boolean implies(boolean p, boolean q) {\n        return !p || q;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"T -> T = \" + implies(true, true));   // true\n        System.out.println(\"T -> F = \" + implies(true, false));  // false\n        System.out.println(\"F -> T = \" + implies(false, true));  // true (vacuous)\n        System.out.println(\"F -> F = \" + implies(false, false)); // true (vacuous)\n\n        // Real example: \"If it rains, the ground is wet\"\n        boolean raining = true;\n        boolean groundWet = true;\n        System.out.println(\"Rain -> Wet ground: \" + implies(raining, groundWet));\n    }\n}"
        ]
      ]
    },
