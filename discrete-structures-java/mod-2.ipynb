          "java",
          "import java.util.*;\n\npublic class LogicEngine {\n\n    @FunctionalInterface\n    interface Proposition {\n        boolean evaluate();\n    }\n\n    public static boolean not(boolean p) { return !p; }\n    public static boolean and(boolean p, boolean q) { return p && q; }\n    public static boolean or(boolean p, boolean q) { return p || q; }\n    public static boolean implies(boolean p, boolean q) { return !p || q; }\n    public static boolean iff(boolean p, boolean q) { return p == q; }\n    public static boolean xor(boolean p, boolean q) { return p ^ q; }\n    public static boolean nand(boolean p, boolean q) { return !(p && q); }\n    public static boolean nor(boolean p, boolean q) { return !(p || q); }\n\n    public static void main(String[] args) {\n        boolean p = true, q = false, r = true;\n\n        // Compound proposition: (p AND NOT q) -> r\n        boolean result = implies(and(p, not(q)), r);\n        System.out.println(\"(p AND NOT q) -> r = \" + result);\n\n        // De Morgan's Laws demonstration\n        System.out.println(\"\\nDe Morgan's Laws:\");\n        System.out.println(\"NOT(p AND q) = \" + not(and(p, q)));\n        System.out.println(\"NOT p OR NOT q = \" + or(not(p), not(q)));\n        System.out.println(\"Equal: \" + (not(and(p, q)) == or(not(p), not(q))));\n\n        System.out.println(\"NOT(p OR q) = \" + not(or(p, q)));\n        System.out.println(\"NOT p AND NOT q = \" + and(not(p), not(q)));\n        System.out.println(\"Equal: \" + (not(or(p, q)) == and(not(p), not(q))));\n    }\n}"
        ]
      ]
