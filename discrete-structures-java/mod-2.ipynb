          "java",
          "public class Disjunction {\n    public static boolean or(boolean p, boolean q) {\n        return p || q;\n    }\n\n    // Exclusive or: true when exactly one is true\n    public static boolean xor(boolean p, boolean q) {\n        return p ^ q;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"T OR F = \" + or(true, false));   // true\n        System.out.println(\"F OR F = \" + or(false, false));  // false\n\n        System.out.println(\"T XOR T = \" + xor(true, true));   // false\n        System.out.println(\"T XOR F = \" + xor(true, false));  // true\n    }\n}"
        ]
      ]
    },
