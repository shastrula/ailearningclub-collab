          "java",
          "public class Conjunction {\n    public static boolean and(boolean p, boolean q) {\n        return p && q;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"T AND T = \" + and(true, true));   // true\n        System.out.println(\"T AND F = \" + and(true, false));  // false\n        System.out.println(\"F AND T = \" + and(false, true));  // false\n        System.out.println(\"F AND F = \" + and(false, false)); // false\n    }\n}"
        ]
      ]
