          "java",
          "public class Propositions {\n    public static void main(String[] args) {\n        // Simple propositions\n        boolean p = true;   // \"The sun is a star\"\n        boolean q = false;  // \"Water is dry\"\n\n        // Propositions from expressions\n        int x = 7;\n        boolean r = isPrime(x);          // \"7 is prime\" -> true\n        boolean s = (2 + 2 == 5);        // \"2 + 2 = 5\" -> false\n        boolean t = \"Java\".length() > 3; // \"Java has more than 3 chars\" -> true\n\n        System.out.println(\"r (7 is prime): \" + r);\n        System.out.println(\"s (2+2=5): \" + s);\n        System.out.println(\"t (Java length > 3): \" + t);\n    }\n\n    private static boolean isPrime(int n) {\n        if (n < 2) return false;\n        for (int i = 2; i <= Math.sqrt(n); i++) {\n            if (n % i == 0) return false;\n        }\n        return true;\n    }\n}"
        ]
      ]
    },
