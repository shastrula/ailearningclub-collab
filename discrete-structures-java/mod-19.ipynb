          "java",
          "import java.util.*;\n\npublic class CycleDetection {\n\n    // Detect cycle in undirected graph using DFS\n    public static boolean hasCycleUndirected(List<List<Integer>> adj, int n) {\n        boolean[] visited = new boolean[n];\n        for (int i = 0; i < n; i++) {\n            if (!visited[i]) {\n                if (dfsCycleUndirected(adj, i, -1, visited)) return true;\n            }\n        }\n        return false;\n    }\n\n    private static boolean dfsCycleUndirected(List<List<Integer>> adj,\n            int v, int parent, boolean[] visited) {\n        visited[v] = true;\n        for (int neighbor : adj.get(v)) {\n            if (!visited[neighbor]) {\n                if (dfsCycleUndirected(adj, neighbor, v, visited)) return true;\n            } else if (neighbor != parent) {\n                return true; // back edge found\n            }\n        }\n        return false;\n    }\n\n    // Detect cycle in directed graph using colors (WHITE, GRAY, BLACK)\n    public static boolean hasCycleDirected(List<List<Integer>> adj, int n) {\n        int[] color = new int[n]; // 0=white, 1=gray, 2=black\n        for (int i = 0; i < n; i++) {\n            if (color[i] == 0) {\n                if (dfsCycleDirected(adj, i, color)) return true;\n            }\n        }\n        return false;\n    }\n\n    private static boolean dfsCycleDirected(List<List<Integer>> adj, int v, int[] color) {\n        color[v] = 1; // gray (in progress)\n        for (int neighbor : adj.get(v)) {\n            if (color[neighbor] == 1) return true; // back edge to gray node\n            if (color[neighbor] == 0 && dfsCycleDirected(adj, neighbor, color)) return true;\n        }\n        color[v] = 2; // black (finished)\n        return false;\n    }\n\n    public static void main(String[] args) {\n        // Undirected graph with cycle\n        int n = 4;\n        List<List<Integer>> adj = new ArrayList<>();\n        for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n        adj.get(0).add(1); adj.get(1).add(0);\n        adj.get(1).add(2); adj.get(2).add(1);\n        adj.get(2).add(0); adj.get(0).add(2); // creates cycle 0-1-2-0\n        adj.get(2).add(3); adj.get(3).add(2);\n\n        System.out.println(\"Undirected graph has cycle: \" + hasCycleUndirected(adj, n));\n\n        // Tree (no cycle)\n        List<List<Integer>> tree = new ArrayList<>();\n        for (int i = 0; i < 4; i++) tree.add(new ArrayList<>());\n        tree.get(0).add(1); tree.get(1).add(0);\n        tree.get(0).add(2); tree.get(2).add(0);\n        tree.get(0).add(3); tree.get(3).add(0);\n        System.out.println(\"Tree has cycle: \" + hasCycleUndirected(tree, 4));\n\n        // Directed graph with cycle\n        List<List<Integer>> directed = new ArrayList<>();\n        for (int i = 0; i < 4; i++) directed.add(new ArrayList<>());\n        directed.get(0).add(1);\n        directed.get(1).add(2);\n        directed.get(2).add(3);\n        directed.get(3).add(1); // cycle: 1->2->3->1\n        System.out.println(\"Directed graph has cycle: \" + hasCycleDirected(directed, 4));\n    }\n}"
