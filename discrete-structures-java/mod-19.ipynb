          "java",
          "import java.util.*;\n\npublic class TraversalComparison {\n\n    static List<List<Integer>> buildGraph(int n, int[][] edges) {\n        List<List<Integer>> adj = new ArrayList<>();\n        for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n        for (int[] e : edges) { adj.get(e[0]).add(e[1]); adj.get(e[1]).add(e[0]); }\n        return adj;\n    }\n\n    public static void main(String[] args) {\n        int[][] edges = {{0,1},{0,2},{1,3},{1,4},{2,5},{2,6},{3,7},{4,7},{5,6}};\n        List<List<Integer>> adj = buildGraph(8, edges);\n\n        System.out.println(\"BFS (breadth-first, level by level):\");\n        List<Integer> bfsOrder = new ArrayList<>();\n        boolean[] visited = new boolean[8];\n        Queue<Integer> queue = new LinkedList<>();\n        queue.add(0); visited[0] = true;\n        while (!queue.isEmpty()) {\n            int v = queue.poll();\n            bfsOrder.add(v);\n            for (int nb : adj.get(v)) {\n                if (!visited[nb]) { visited[nb] = true; queue.add(nb); }\n            }\n        }\n        System.out.println(\"  Order: \" + bfsOrder);\n\n        System.out.println(\"\\nDFS (depth-first, explore deeply):\");\n        List<Integer> dfsOrder = new ArrayList<>();\n        visited = new boolean[8];\n        Deque<Integer> stack = new ArrayDeque<>();\n        stack.push(0);\n        while (!stack.isEmpty()) {\n            int v = stack.pop();\n            if (visited[v]) continue;\n            visited[v] = true;\n            dfsOrder.add(v);\n            List<Integer> nbs = adj.get(v);\n            for (int i = nbs.size()-1; i >= 0; i--) {\n                if (!visited[nbs.get(i)]) stack.push(nbs.get(i));\n            }\n        }\n        System.out.println(\"  Order: \" + dfsOrder);\n\n        System.out.println(\"\\nUse BFS when: shortest path, level-order, nearest neighbor\");\n        System.out.println(\"Use DFS when: cycle detection, topological sort, path existence\");\n    }\n}"
