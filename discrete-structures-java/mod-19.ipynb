          "java",
          "import java.util.*;\n\npublic class DepthFirstSearch {\n\n    static class Graph {\n        List<List<Integer>> adj;\n        int n;\n        Graph(int n) {\n            this.n = n;\n            adj = new ArrayList<>();\n            for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n        }\n        void addEdge(int u, int v) { adj.get(u).add(v); adj.get(v).add(u); }\n    }\n\n    // Iterative DFS with timestamps\n    public static void dfsIterative(Graph g, int source) {\n        boolean[] visited = new boolean[g.n];\n        Deque<Integer> stack = new ArrayDeque<>();\n        List<Integer> order = new ArrayList<>();\n\n        stack.push(source);\n        while (!stack.isEmpty()) {\n            int v = stack.pop();\n            if (visited[v]) continue;\n            visited[v] = true;\n            order.add(v);\n            // Push neighbors in reverse for consistent ordering\n            List<Integer> neighbors = g.adj.get(v);\n            for (int i = neighbors.size() - 1; i >= 0; i--) {\n                if (!visited[neighbors.get(i)]) {\n                    stack.push(neighbors.get(i));\n                }\n            }\n        }\n        System.out.println(\"DFS iterative from \" + source + \": \" + order);\n    }\n\n    // Recursive DFS with discovery/finish times\n    static int time = 0;\n    public static void dfsRecursive(Graph g, int source, boolean[] visited,\n            int[] discovery, int[] finish, List<Integer> order) {\n        visited[source] = true;\n        discovery[source] = ++time;\n        order.add(source);\n\n        for (int neighbor : g.adj.get(source)) {\n            if (!visited[neighbor]) {\n                dfsRecursive(g, neighbor, visited, discovery, finish, order);\n            }\n        }\n        finish[source] = ++time;\n    }\n\n    public static void main(String[] args) {\n        Graph g = new Graph(7);\n        g.addEdge(0, 1); g.addEdge(0, 2);\n        g.addEdge(1, 3); g.addEdge(1, 4);\n        g.addEdge(2, 5); g.addEdge(3, 6);\n\n        dfsIterative(g, 0);\n\n        // Recursive with timestamps\n        boolean[] visited = new boolean[g.n];\n        int[] discovery = new int[g.n];\n        int[] finish = new int[g.n];\n        List<Integer> order = new ArrayList<>();\n        time = 0;\n        dfsRecursive(g, 0, visited, discovery, finish, order);\n\n        System.out.println(\"DFS recursive from 0: \" + order);\n        System.out.println(\"Discovery times: \" + Arrays.toString(discovery));\n        System.out.println(\"Finish times: \" + Arrays.toString(finish));\n    }\n}"
