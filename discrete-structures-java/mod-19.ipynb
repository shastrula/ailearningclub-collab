          "java",
          "import java.util.*;\n\npublic class GraphRepresentations {\n\n    // Adjacency Matrix: O(1) edge lookup, O(V^2) space\n    static class AdjacencyMatrix {\n        private final boolean[][] matrix;\n        private final int n;\n\n        AdjacencyMatrix(int n) {\n            this.n = n;\n            this.matrix = new boolean[n][n];\n        }\n\n        void addEdge(int u, int v) {\n            matrix[u][v] = true;\n            matrix[v][u] = true;\n        }\n\n        boolean hasEdge(int u, int v) { return matrix[u][v]; }\n\n        List<Integer> neighbors(int v) {\n            List<Integer> result = new ArrayList<>();\n            for (int i = 0; i < n; i++) {\n                if (matrix[v][i]) result.add(i);\n            }\n            return result;\n        }\n\n        void print() {\n            System.out.print(\"  \");\n            for (int i = 0; i < n; i++) System.out.printf(\"%2d\", i);\n            System.out.println();\n            for (int i = 0; i < n; i++) {\n                System.out.printf(\"%d:\", i);\n                for (int j = 0; j < n; j++) {\n                    System.out.printf(\"%2d\", matrix[i][j] ? 1 : 0);\n                }\n                System.out.println();\n            }\n        }\n    }\n\n    // Adjacency List: O(degree) edge lookup, O(V + E) space\n    static class AdjacencyList {\n        private final List<List<Integer>> adj;\n        private final int n;\n\n        AdjacencyList(int n) {\n            this.n = n;\n            adj = new ArrayList<>();\n            for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n        }\n\n        void addEdge(int u, int v) {\n            adj.get(u).add(v);\n            adj.get(v).add(u);\n        }\n\n        List<Integer> neighbors(int v) { return adj.get(v); }\n\n        void print() {\n            for (int i = 0; i < n; i++) {\n                System.out.println(i + \" -> \" + adj.get(i));\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        int n = 5;\n        AdjacencyMatrix matrix = new AdjacencyMatrix(n);\n        AdjacencyList list = new AdjacencyList(n);\n\n        int[][] edges = {{0,1}, {0,2}, {1,2}, {1,3}, {3,4}};\n        for (int[] e : edges) {\n            matrix.addEdge(e[0], e[1]);\n            list.addEdge(e[0], e[1]);\n        }\n\n        System.out.println(\"Adjacency Matrix:\");\n        matrix.print();\n        System.out.println(\"\\nAdjacency List:\");\n        list.print();\n\n        System.out.println(\"\\nSpace comparison (V=\" + n + \", E=\" + edges.length + \"):\");\n        System.out.println(\"  Matrix: \" + (n*n) + \" cells\");\n        System.out.println(\"  List: \" + (2*edges.length) + \" entries\");\n    }\n}"
        ]
