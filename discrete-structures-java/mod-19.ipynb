          "java",
          "import java.util.*;\n\npublic class BreadthFirstSearch {\n\n    static class Graph {\n        List<List<Integer>> adj;\n        int n;\n\n        Graph(int n) {\n            this.n = n;\n            adj = new ArrayList<>();\n            for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n        }\n\n        void addEdge(int u, int v) { adj.get(u).add(v); adj.get(v).add(u); }\n    }\n\n    // BFS with distance and parent tracking\n    public static Map<String, int[]> bfs(Graph g, int source) {\n        int[] distance = new int[g.n];\n        int[] parent = new int[g.n];\n        boolean[] visited = new boolean[g.n];\n        Arrays.fill(distance, -1);\n        Arrays.fill(parent, -1);\n\n        Queue<Integer> queue = new LinkedList<>();\n        queue.offer(source);\n        visited[source] = true;\n        distance[source] = 0;\n\n        List<Integer> order = new ArrayList<>();\n\n        while (!queue.isEmpty()) {\n            int v = queue.poll();\n            order.add(v);\n            for (int neighbor : g.adj.get(v)) {\n                if (!visited[neighbor]) {\n                    visited[neighbor] = true;\n                    distance[neighbor] = distance[v] + 1;\n                    parent[neighbor] = v;\n                    queue.offer(neighbor);\n                }\n            }\n        }\n\n        System.out.println(\"BFS order from \" + source + \": \" + order);\n        return Map.of(\"distance\", distance, \"parent\", parent);\n    }\n\n    // Reconstruct shortest path\n    public static List<Integer> shortestPath(int[] parent, int target) {\n        List<Integer> path = new ArrayList<>();\n        for (int v = target; v != -1; v = parent[v]) {\n            path.add(v);\n        }\n        Collections.reverse(path);\n        return path;\n    }\n\n    public static void main(String[] args) {\n        Graph g = new Graph(7);\n        g.addEdge(0, 1); g.addEdge(0, 2);\n        g.addEdge(1, 3); g.addEdge(1, 4);\n        g.addEdge(2, 5); g.addEdge(3, 6);\n        g.addEdge(4, 6);\n\n        Map<String, int[]> result = bfs(g, 0);\n        int[] distance = result.get(\"distance\");\n        int[] parent = result.get(\"parent\");\n\n        System.out.println(\"Distances from 0: \" + Arrays.toString(distance));\n\n        // Shortest path from 0 to 6\n        List<Integer> path = shortestPath(parent, 6);\n        System.out.println(\"Shortest path 0->6: \" + path + \" (length \" + distance[6] + \")\");\n    }\n}"
