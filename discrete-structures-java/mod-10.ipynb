          "java",
          "import java.util.*;\n\npublic class TopologicalSort {\n\n    // Kahn's algorithm for topological sort\n    public static List<Integer> topologicalSort(int n, List<List<Integer>> edges) {\n        int[] inDegree = new int[n];\n        List<List<Integer>> adj = new ArrayList<>();\n        for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n\n        for (List<Integer> edge : edges) {\n            adj.get(edge.get(0)).add(edge.get(1));\n            inDegree[edge.get(1)]++;\n        }\n\n        Queue<Integer> queue = new LinkedList<>();\n        for (int i = 0; i < n; i++) {\n            if (inDegree[i] == 0) queue.offer(i);\n        }\n\n        List<Integer> result = new ArrayList<>();\n        while (!queue.isEmpty()) {\n            int node = queue.poll();\n            result.add(node);\n            for (int neighbor : adj.get(node)) {\n                inDegree[neighbor]--;\n                if (inDegree[neighbor] == 0) queue.offer(neighbor);\n            }\n        }\n\n        return result.size() == n ? result : Collections.emptyList(); // empty if cycle\n    }\n\n    public static void main(String[] args) {\n        // Course prerequisites\n        String[] courses = {\"Calc I\", \"Calc II\", \"Linear Alg\", \"Discrete\", \"Data Struct\", \"Algorithms\"};\n        // Edges: prerequisite -> course\n        List<List<Integer>> prereqs = List.of(\n            List.of(0, 1),  // Calc I -> Calc II\n            List.of(0, 2),  // Calc I -> Linear Algebra\n            List.of(3, 4),  // Discrete -> Data Structures\n            List.of(4, 5),  // Data Structures -> Algorithms\n            List.of(1, 5),  // Calc II -> Algorithms\n            List.of(2, 5)   // Linear Algebra -> Algorithms\n        );\n\n        List<Integer> order = topologicalSort(6, prereqs);\n        System.out.println(\"Valid course order:\");\n        for (int idx : order) {\n            System.out.println(\"  \" + courses[idx]);\n        }\n    }\n}"
        ]
