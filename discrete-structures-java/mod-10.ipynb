          "java",
          "import java.util.*;\n\npublic class PartialOrder {\n\n    public static <T> boolean isPartialOrder(Set<T> domain, Set<List<T>> pairs) {\n        // Reflexive\n        for (T a : domain) {\n            if (!pairs.contains(List.of(a, a))) return false;\n        }\n        // Antisymmetric\n        for (List<T> pair : pairs) {\n            T a = pair.get(0), b = pair.get(1);\n            if (!a.equals(b) && pairs.contains(List.of(b, a))) return false;\n        }\n        // Transitive\n        for (List<T> p1 : pairs) {\n            for (List<T> p2 : pairs) {\n                if (p1.get(1).equals(p2.get(0))) {\n                    if (!pairs.contains(List.of(p1.get(0), p2.get(1)))) return false;\n                }\n            }\n        }\n        return true;\n    }\n\n    // Find minimal elements (no element is strictly less)\n    public static <T> Set<T> minimalElements(Set<T> domain, Set<List<T>> pairs) {\n        Set<T> minimals = new HashSet<>(domain);\n        for (List<T> pair : pairs) {\n            T a = pair.get(0), b = pair.get(1);\n            if (!a.equals(b)) {\n                minimals.remove(b); // b has something below it\n            }\n        }\n        return minimals;\n    }\n\n    // Find maximal elements (nothing is strictly greater)\n    public static <T> Set<T> maximalElements(Set<T> domain, Set<List<T>> pairs) {\n        Set<T> maximals = new HashSet<>(domain);\n        for (List<T> pair : pairs) {\n            T a = pair.get(0), b = pair.get(1);\n            if (!a.equals(b)) {\n                maximals.remove(a); // a has something above it\n            }\n        }\n        return maximals;\n    }\n\n    public static void main(String[] args) {\n        // Divisibility on {1, 2, 3, 4, 6, 12}\n        Set<Integer> domain = Set.of(1, 2, 3, 4, 6, 12);\n        Set<List<Integer>> divides = new HashSet<>();\n        for (int a : domain) {\n            for (int b : domain) {\n                if (b % a == 0) divides.add(List.of(a, b));\n            }\n        }\n\n        System.out.println(\"Divisibility on \" + domain);\n        System.out.println(\"Is partial order: \" + isPartialOrder(domain, divides));\n        System.out.println(\"Minimal elements: \" + minimalElements(domain, divides));\n        System.out.println(\"Maximal elements: \" + maximalElements(domain, divides));\n\n        // Subset containment on P({a,b})\n        Set<String> subsets = Set.of(\"{}\", \"{a}\", \"{b}\", \"{a,b}\");\n        Set<List<String>> subset = Set.of(\n            List.of(\"{}\", \"{}\"), List.of(\"{a}\", \"{a}\"),\n            List.of(\"{b}\", \"{b}\"), List.of(\"{a,b}\", \"{a,b}\"),\n            List.of(\"{}\", \"{a}\"), List.of(\"{}\", \"{b}\"), List.of(\"{}\", \"{a,b}\"),\n            List.of(\"{a}\", \"{a,b}\"), List.of(\"{b}\", \"{a,b}\")\n        );\n        System.out.println(\"\\nSubset containment:\");\n        System.out.println(\"Is partial order: \" + isPartialOrder(subsets, subset));\n    }\n}"
