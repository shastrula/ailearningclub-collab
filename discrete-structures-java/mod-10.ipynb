          "java",
          "import java.util.*;\n\npublic class TotalOrder {\n\n    // Check if a partial order is total (every pair is comparable)\n    public static <T> boolean isTotalOrder(Set<T> domain, Set<List<T>> pairs) {\n        for (T a : domain) {\n            for (T b : domain) {\n                if (!pairs.contains(List.of(a, b)) && !pairs.contains(List.of(b, a))) {\n                    System.out.println(\"  Incomparable: \" + a + \" and \" + b);\n                    return false;\n                }\n            }\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        Set<Integer> domain = Set.of(1, 2, 3, 4, 6, 12);\n\n        // <= is a total order on integers\n        Set<List<Integer>> leq = new HashSet<>();\n        for (int a : domain) for (int b : domain) if (a <= b) leq.add(List.of(a, b));\n        System.out.println(\"<= is total order: \" + isTotalOrder(domain, leq)); // true\n\n        // Divisibility is a partial (not total) order\n        Set<List<Integer>> div = new HashSet<>();\n        for (int a : domain) for (int b : domain) if (b % a == 0) div.add(List.of(a, b));\n        System.out.println(\"Divisibility is total order: \" + isTotalOrder(domain, div)); // false\n    }\n}"
        ]
