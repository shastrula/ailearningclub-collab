          "java",
          "import java.util.*;\n\npublic class UnionFind {\n    private int[] parent;\n    private int[] rank;\n    private int numComponents;\n\n    public UnionFind(int n) {\n        parent = new int[n];\n        rank = new int[n];\n        numComponents = n;\n        for (int i = 0; i < n; i++) {\n            parent[i] = i; // each element is its own class initially\n        }\n    }\n\n    // Find the representative of element x's equivalence class\n    public int find(int x) {\n        if (parent[x] != x) {\n            parent[x] = find(parent[x]); // path compression\n        }\n        return parent[x];\n    }\n\n    // Merge the equivalence classes of x and y\n    public void union(int x, int y) {\n        int rootX = find(x);\n        int rootY = find(y);\n        if (rootX == rootY) return; // already in same class\n\n        // Union by rank\n        if (rank[rootX] < rank[rootY]) {\n            parent[rootX] = rootY;\n        } else if (rank[rootX] > rank[rootY]) {\n            parent[rootY] = rootX;\n        } else {\n            parent[rootY] = rootX;\n            rank[rootX]++;\n        }\n        numComponents--;\n    }\n\n    public boolean areEquivalent(int x, int y) {\n        return find(x) == find(y);\n    }\n\n    public int getNumComponents() {\n        return numComponents;\n    }\n\n    public Map<Integer, List<Integer>> getClasses(int n) {\n        Map<Integer, List<Integer>> classes = new HashMap<>();\n        for (int i = 0; i < n; i++) {\n            classes.computeIfAbsent(find(i), k -> new ArrayList<>()).add(i);\n        }\n        return classes;\n    }\n\n    public static void main(String[] args) {\n        UnionFind uf = new UnionFind(10);\n\n        // Create equivalence classes for mod 3\n        // Class [0]: {0, 3, 6, 9}\n        uf.union(0, 3); uf.union(0, 6); uf.union(0, 9);\n        // Class [1]: {1, 4, 7}\n        uf.union(1, 4); uf.union(1, 7);\n        // Class [2]: {2, 5, 8}\n        uf.union(2, 5); uf.union(2, 8);\n\n        System.out.println(\"Number of equivalence classes: \" + uf.getNumComponents());\n        System.out.println(\"3 ~ 9: \" + uf.areEquivalent(3, 9)); // true\n        System.out.println(\"3 ~ 4: \" + uf.areEquivalent(3, 4)); // false\n        System.out.println(\"5 ~ 8: \" + uf.areEquivalent(5, 8)); // true\n\n        System.out.println(\"\\nEquivalence classes:\");\n        Map<Integer, List<Integer>> classes = uf.getClasses(10);\n        for (List<Integer> eqClass : classes.values()) {\n            System.out.println(\"  \" + eqClass);\n        }\n    }\n}"
