          "java",
          "public class EulerFermat {\n\n    // Euler's totient: count of numbers 1..n coprime to n\n    public static int eulerTotient(int n) {\n        int result = n;\n        for (int p = 2; (long)p * p <= n; p++) {\n            if (n % p == 0) {\n                while (n % p == 0) n /= p;\n                result -= result / p;\n            }\n        }\n        if (n > 1) result -= result / n;\n        return result;\n    }\n\n    // Fermat's Little Theorem: a^(p-1) = 1 mod p (for prime p, a not divisible by p)\n    public static void demonstrateFermat(int p) {\n        System.out.println(\"Fermat's Little Theorem for p=\" + p + \":\");\n        for (int a = 1; a < p; a++) {\n            long result = modPow(a, p - 1, p);\n            System.out.printf(\"  %d^%d mod %d = %d%n\", a, p-1, p, result);\n        }\n    }\n\n    // Euler's theorem: a^phi(n) = 1 mod n (when gcd(a,n) = 1)\n    public static void demonstrateEuler(int n) {\n        int phi = eulerTotient(n);\n        System.out.println(\"\\nEuler's theorem for n=\" + n + \" (phi=\" + phi + \"):\");\n        for (int a = 1; a < n; a++) {\n            if (gcd(a, n) == 1) {\n                long result = modPow(a, phi, n);\n                System.out.printf(\"  %d^%d mod %d = %d%n\", a, phi, n, result);\n            }\n        }\n    }\n\n    static long modPow(long base, long exp, long mod) {\n        long result = 1; base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) result = result * base % mod;\n            exp >>= 1; base = base * base % mod;\n        }\n        return result;\n    }\n\n    static long gcd(long a, long b) { while (b != 0) { long t = b; b = a%b; a = t; } return a; }\n\n    public static void main(String[] args) {\n        demonstrateFermat(7);\n        demonstrateEuler(12);\n\n        System.out.println(\"\\nEuler's totient values:\");\n        for (int n = 2; n <= 20; n++) {\n            System.out.printf(\"  phi(%2d) = %d%n\", n, eulerTotient(n));\n        }\n    }\n}"
        ]
