          "java",
          "import java.math.BigInteger;\nimport java.util.*;\n\npublic class ModularArithmetic {\n\n    // Proper modulo that always returns non-negative result\n    public static int mod(int a, int n) {\n        return ((a % n) + n) % n;\n    }\n\n    // Modular addition: (a + b) mod n\n    public static int modAdd(int a, int b, int n) {\n        return mod(a + b, n);\n    }\n\n    // Modular multiplication: (a * b) mod n\n    public static long modMul(long a, long b, long n) {\n        return ((a % n) * (b % n)) % n;\n    }\n\n    // Modular exponentiation: (base^exp) mod n using fast exponentiation\n    public static long modPow(long base, long exp, long mod) {\n        long result = 1;\n        base = base % mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            exp >>= 1;\n            base = (base * base) % mod;\n        }\n        return result;\n    }\n\n    public static void main(String[] args) {\n        int n = 7;\n        System.out.println(\"Modular arithmetic mod \" + n + \":\");\n        System.out.println(\"  (15 + 8) mod 7 = \" + modAdd(15, 8, n));  // 2\n        System.out.println(\"  (15 * 8) mod 7 = \" + modMul(15, 8, n));  // 1\n        System.out.println(\"  (-3) mod 7 = \" + mod(-3, n));             // 4\n\n        // Fast modular exponentiation\n        System.out.println(\"\\nModular exponentiation:\");\n        System.out.println(\"  2^10 mod 1000 = \" + modPow(2, 10, 1000)); // 24\n        System.out.println(\"  3^13 mod 7 = \" + modPow(3, 13, 7));       // 3\n        System.out.println(\"  7^256 mod 13 = \" + modPow(7, 256, 13));\n\n        // Properties of modular arithmetic\n        System.out.println(\"\\nClock arithmetic (mod 12):\");\n        System.out.println(\"  10 + 5 = \" + mod(10 + 5, 12) + \" o'clock\");\n        System.out.println(\"  3 - 7 = \" + mod(3 - 7, 12) + \" o'clock\");\n    }\n}"
        ]
      ]
