          "java",
          "public class ExtendedEuclidean {\n\n    // Standard GCD using Euclid's algorithm\n    public static long gcd(long a, long b) {\n        while (b != 0) {\n            long temp = b;\n            b = a % b;\n            a = temp;\n        }\n        return a;\n    }\n\n    // Extended Euclidean: returns [gcd, x, y] where ax + by = gcd(a,b)\n    public static long[] extendedGcd(long a, long b) {\n        if (b == 0) return new long[]{a, 1, 0};\n        long[] result = extendedGcd(b, a % b);\n        long g = result[0], x = result[1], y = result[2];\n        return new long[]{g, y, x - (a / b) * y};\n    }\n\n    // Modular inverse: a^(-1) mod n, exists iff gcd(a, n) = 1\n    public static long modInverse(long a, long n) {\n        long[] result = extendedGcd(a, n);\n        if (result[0] != 1) {\n            throw new ArithmeticException(\"Inverse doesn't exist: gcd(\" + a + \",\" + n + \") != 1\");\n        }\n        return ((result[1] % n) + n) % n;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"GCD examples:\");\n        System.out.println(\"  gcd(48, 18) = \" + gcd(48, 18));  // 6\n        System.out.println(\"  gcd(35, 15) = \" + gcd(35, 15));  // 5\n        System.out.println(\"  gcd(17, 13) = \" + gcd(17, 13));  // 1 (coprime)\n\n        // Extended GCD\n        long[] ext = extendedGcd(35, 15);\n        System.out.printf(\"\\n  35*(%d) + 15*(%d) = %d%n\", ext[1], ext[2], ext[0]);\n\n        // Modular inverse\n        System.out.println(\"\\nModular inverses:\");\n        System.out.println(\"  3^(-1) mod 7 = \" + modInverse(3, 7));   // 5 (3*5=15=1 mod 7)\n        System.out.println(\"  5^(-1) mod 11 = \" + modInverse(5, 11)); // 9 (5*9=45=1 mod 11)\n\n        // Verify\n        System.out.println(\"  Verify: 3 * 5 mod 7 = \" + (3 * 5 % 7));\n        System.out.println(\"  Verify: 5 * 9 mod 11 = \" + (5 * 9 % 11));\n\n        // All invertible elements mod 12\n        System.out.println(\"\\nInvertible elements mod 12 (coprime to 12):\");\n        for (int a = 1; a < 12; a++) {\n            if (gcd(a, 12) == 1) {\n                System.out.printf(\"  %d^(-1) mod 12 = %d%n\", a, modInverse(a, 12));\n            }\n        }\n    }\n}"
        ]
