          "java",
          "import java.util.*;\n\npublic class RecurrenceBasics {\n\n    // Generic recurrence solver using memoization\n    public static long[] solveRecurrence(int n, long[] initial,\n            java.util.function.BiFunction<long[], Integer, Long> rule) {\n        long[] seq = new long[n + 1];\n        System.arraycopy(initial, 0, seq, 0, Math.min(initial.length, n + 1));\n\n        for (int i = initial.length; i <= n; i++) {\n            seq[i] = rule.apply(seq, i);\n        }\n        return seq;\n    }\n\n    public static void main(String[] args) {\n        // Fibonacci: F(n) = F(n-1) + F(n-2), F(0)=0, F(1)=1\n        long[] fib = solveRecurrence(20, new long[]{0, 1},\n            (seq, i) -> seq[i-1] + seq[i-2]);\n        System.out.println(\"Fibonacci: \" + Arrays.toString(fib));\n\n        // Factorial: n! = n * (n-1)!, 0! = 1\n        long[] fact = solveRecurrence(12, new long[]{1},\n            (seq, i) -> i * seq[i-1]);\n        System.out.println(\"Factorial: \" + Arrays.toString(fact));\n\n        // Tower of Hanoi: T(n) = 2*T(n-1) + 1, T(0) = 0\n        long[] hanoi = solveRecurrence(20, new long[]{0},\n            (seq, i) -> 2 * seq[i-1] + 1);\n        System.out.println(\"Hanoi: \" + Arrays.toString(hanoi));\n        // Closed form: T(n) = 2^n - 1\n        System.out.println(\"T(20) = \" + hanoi[20] + \", 2^20 - 1 = \" + ((1L << 20) - 1));\n\n        // Catalan numbers: C(n) = sum_{i=0}^{n-1} C(i)*C(n-1-i), C(0)=1\n        long[] catalan = new long[15];\n        catalan[0] = 1;\n        for (int n = 1; n < 15; n++) {\n            for (int i = 0; i < n; i++) {\n                catalan[n] += catalan[i] * catalan[n - 1 - i];\n            }\n        }\n        System.out.println(\"Catalan: \" + Arrays.toString(catalan));\n    }\n}"
        ]
