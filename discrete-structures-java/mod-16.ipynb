          "java",
          "import java.util.*;\n\npublic class LinearRecurrences {\n\n    // Solve a general linear homogeneous recurrence with constant coefficients\n    // a(n) = c[0]*a(n-1) + c[1]*a(n-2) + ... + c[k-1]*a(n-k)\n    public static long[] solveLinearHomogeneous(int n, long[] initial, long[] coefficients) {\n        int k = coefficients.length;\n        long[] seq = new long[n + 1];\n        System.arraycopy(initial, 0, seq, 0, Math.min(k, n + 1));\n\n        for (int i = k; i <= n; i++) {\n            long sum = 0;\n            for (int j = 0; j < k; j++) {\n                sum += coefficients[j] * seq[i - 1 - j];\n            }\n            seq[i] = sum;\n        }\n        return seq;\n    }\n\n    // Non-homogeneous: a(n) = c*a(n-1) + f(n)\n    public static long[] solveNonHomogeneous(int n, long initial,\n            long coefficient, java.util.function.IntToLongFunction f) {\n        long[] seq = new long[n + 1];\n        seq[0] = initial;\n        for (int i = 1; i <= n; i++) {\n            seq[i] = coefficient * seq[i - 1] + f.applyAsLong(i);\n        }\n        return seq;\n    }\n\n    public static void main(String[] args) {\n        // Fibonacci: a(n) = a(n-1) + a(n-2)\n        long[] fib = solveLinearHomogeneous(15, new long[]{0, 1}, new long[]{1, 1});\n        System.out.println(\"Fibonacci (order 2): \" + Arrays.toString(fib));\n\n        // Tribonacci: a(n) = a(n-1) + a(n-2) + a(n-3)\n        long[] trib = solveLinearHomogeneous(15, new long[]{0, 0, 1}, new long[]{1, 1, 1});\n        System.out.println(\"Tribonacci (order 3): \" + Arrays.toString(trib));\n\n        // Lucas numbers: L(n) = L(n-1) + L(n-2), L(0)=2, L(1)=1\n        long[] lucas = solveLinearHomogeneous(15, new long[]{2, 1}, new long[]{1, 1});\n        System.out.println(\"Lucas numbers: \" + Arrays.toString(lucas));\n\n        // Non-homogeneous: a(n) = 2*a(n-1) + 1, a(0) = 0 (Tower of Hanoi)\n        long[] hanoi = solveNonHomogeneous(15, 0, 2, i -> 1);\n        System.out.println(\"Hanoi (non-homog): \" + Arrays.toString(hanoi));\n\n        // a(n) = 2*a(n-1) + n, a(0) = 1\n        long[] custom = solveNonHomogeneous(10, 1, 2, i -> i);\n        System.out.println(\"a(n)=2a(n-1)+n: \" + Arrays.toString(custom));\n    }\n}"
        ]
