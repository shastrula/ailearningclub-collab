          "java",
          "import java.util.*;\n\npublic class RecursiveAnalysis {\n\n    private static int comparisons;\n\n    // Merge sort - count actual comparisons\n    public static void mergeSort(int[] arr, int lo, int hi) {\n        if (hi - lo <= 1) return;\n        int mid = (lo + hi) / 2;\n        mergeSort(arr, lo, mid);\n        mergeSort(arr, mid, hi);\n        merge(arr, lo, mid, hi);\n    }\n\n    private static void merge(int[] arr, int lo, int mid, int hi) {\n        int[] temp = Arrays.copyOfRange(arr, lo, hi);\n        int i = 0, j = mid - lo, k = lo;\n        while (i < mid - lo && j < hi - lo) {\n            comparisons++;\n            if (temp[i] <= temp[j]) arr[k++] = temp[i++];\n            else arr[k++] = temp[j++];\n        }\n        while (i < mid - lo) arr[k++] = temp[i++];\n        while (j < hi - lo) arr[k++] = temp[j++];\n    }\n\n    // Fibonacci - count actual calls\n    private static int fibCalls;\n    public static long fibRecursive(int n) {\n        fibCalls++;\n        if (n <= 1) return n;\n        return fibRecursive(n - 1) + fibRecursive(n - 2);\n    }\n\n    public static void main(String[] args) {\n        // Merge sort comparison counts match n*log(n)\n        System.out.println(\"Merge Sort comparisons vs n*log2(n):\");\n        for (int n = 8; n <= 256; n *= 2) {\n            int[] arr = new int[n];\n            Random rand = new Random(42);\n            for (int i = 0; i < n; i++) arr[i] = rand.nextInt(1000);\n            comparisons = 0;\n            mergeSort(arr, 0, n);\n            double nlogn = n * Math.log(n) / Math.log(2);\n            System.out.printf(\"  n=%3d: comparisons=%4d, n*log(n)=%.0f, ratio=%.2f%n\",\n                n, comparisons, nlogn, comparisons / nlogn);\n        }\n\n        // Fibonacci call count is exponential\n        System.out.println(\"\\nFibonacci recursive calls (exponential growth):\");\n        for (int n = 5; n <= 30; n += 5) {\n            fibCalls = 0;\n            fibRecursive(n);\n            System.out.printf(\"  fib(%2d): %,10d calls (ratio to 2^n: %.4f)%n\",\n                n, fibCalls, (double) fibCalls / Math.pow(2, n));\n        }\n    }\n}"
        ]
