          "java",
          "public class RecurrenceVerification {\n\n    // Verify closed form against recurrence computation\n    public static boolean verify(java.util.function.IntToLongFunction closedForm,\n                                  java.util.function.BiFunction<long[], Integer, Long> recurrence,\n                                  long[] initial, int testUpTo) {\n        long[] seq = new long[testUpTo + 1];\n        System.arraycopy(initial, 0, seq, 0, initial.length);\n        for (int i = initial.length; i <= testUpTo; i++) {\n            seq[i] = recurrence.apply(seq, i);\n        }\n\n        for (int i = 0; i <= testUpTo; i++) {\n            if (closedForm.applyAsLong(i) != seq[i]) {\n                System.out.println(\"Mismatch at n=\" + i + \": closed=\" +\n                    closedForm.applyAsLong(i) + \", recurrence=\" + seq[i]);\n                return false;\n            }\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        // Tower of Hanoi: T(n) = 2^n - 1\n        boolean hanoiOk = verify(\n            n -> (1L << n) - 1,\n            (seq, i) -> 2 * seq[i-1] + 1,\n            new long[]{0}, 30);\n        System.out.println(\"Hanoi T(n) = 2^n - 1: \" + hanoiOk);\n\n        // Arithmetic: a(n) = a(0) + n*d => a(n) = 3 + 5n\n        boolean arithOk = verify(\n            n -> 3 + 5L * n,\n            (seq, i) -> seq[i-1] + 5,\n            new long[]{3}, 100);\n        System.out.println(\"a(n) = 3 + 5n: \" + arithOk);\n\n        // Geometric: a(n) = a(0) * r^n => a(n) = 2 * 3^n\n        boolean geomOk = verify(\n            n -> 2L * (long)Math.pow(3, n),\n            (seq, i) -> 3 * seq[i-1],\n            new long[]{2}, 15);\n        System.out.println(\"a(n) = 2*3^n: \" + geomOk);\n    }\n}"
        ]
