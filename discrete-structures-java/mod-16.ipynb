          "java",
          "import java.util.*;\n\npublic class DivideAndConquerRecurrences {\n\n    // Compute T(n) for T(n) = a*T(n/b) + f(n)\n    public static long[] solveDnC(int n, int a, int b,\n            java.util.function.IntToLongFunction f) {\n        long[] T = new long[n + 1];\n        T[1] = f.applyAsLong(1); // base case\n\n        for (int i = 2; i <= n; i++) {\n            T[i] = a * T[i / b] + f.applyAsLong(i);\n        }\n        return T;\n    }\n\n    // Master theorem classification\n    public static String masterTheorem(int a, int b, String fComplexity) {\n        double logba = Math.log(a) / Math.log(b);\n        return String.format(\n            \"a=%d, b=%d, log_b(a)=%.2f, f(n)=%s\", a, b, logba, fComplexity);\n    }\n\n    public static void main(String[] args) {\n        int n = 64;\n\n        // Merge Sort: T(n) = 2*T(n/2) + n\n        long[] mergeSort = solveDnC(n, 2, 2, i -> i);\n        System.out.println(\"Merge Sort T(n) = 2T(n/2) + n:\");\n        System.out.println(\"  \" + masterTheorem(2, 2, \"n\"));\n        System.out.println(\"  T(64) = \" + mergeSort[64]);\n        System.out.println(\"  n*log(n) = \" + (int)(64 * Math.log(64)/Math.log(2)));\n        // Master theorem Case 2: T(n) = O(n log n)\n\n        // Binary Search: T(n) = T(n/2) + 1\n        long[] binarySearch = solveDnC(n, 1, 2, i -> 1);\n        System.out.println(\"\\nBinary Search T(n) = T(n/2) + 1:\");\n        System.out.println(\"  \" + masterTheorem(1, 2, \"1\"));\n        System.out.println(\"  T(64) = \" + binarySearch[64]);\n        System.out.println(\"  log(64) = \" + (int)(Math.log(64)/Math.log(2)));\n        // Master theorem Case 2: T(n) = O(log n)\n\n        // Strassen's: T(n) = 7*T(n/2) + n^2\n        long[] strassen = solveDnC(n, 7, 2, i -> (long)i * i);\n        System.out.println(\"\\nStrassen T(n) = 7T(n/2) + n^2:\");\n        System.out.println(\"  \" + masterTheorem(7, 2, \"n^2\"));\n        System.out.println(\"  T(64) = \" + strassen[64]);\n        // Master theorem Case 1: T(n) = O(n^log2(7)) = O(n^2.807)\n\n        // Karatsuba: T(n) = 3*T(n/2) + n\n        long[] karatsuba = solveDnC(n, 3, 2, i -> i);\n        System.out.println(\"\\nKaratsuba T(n) = 3T(n/2) + n:\");\n        System.out.println(\"  \" + masterTheorem(3, 2, \"n\"));\n        System.out.println(\"  T(64) = \" + karatsuba[64]);\n    }\n}"
        ]
