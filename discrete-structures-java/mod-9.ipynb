          "java",
          "import java.util.*;\n\npublic class TransitiveClosure {\n\n    // Warshall's algorithm for transitive closure\n    public static boolean[][] warshall(boolean[][] relation, int n) {\n        boolean[][] closure = new boolean[n][n];\n        for (int i = 0; i < n; i++) {\n            System.arraycopy(relation[i], 0, closure[i], 0, n);\n        }\n\n        for (int k = 0; k < n; k++) {\n            for (int i = 0; i < n; i++) {\n                for (int j = 0; j < n; j++) {\n                    closure[i][j] = closure[i][j] || (closure[i][k] && closure[k][j]);\n                }\n            }\n        }\n        return closure;\n    }\n\n    public static void main(String[] args) {\n        // Relation: {(1,2), (2,3), (3,4)}\n        int n = 4;\n        boolean[][] rel = new boolean[n][n];\n        rel[0][1] = true; // (1,2)\n        rel[1][2] = true; // (2,3)\n        rel[2][3] = true; // (3,4)\n\n        System.out.println(\"Original relation matrix:\");\n        printMatrix(rel, n);\n\n        boolean[][] closure = warshall(rel, n);\n        System.out.println(\"\\nTransitive closure:\");\n        printMatrix(closure, n);\n        // Should add: (1,3), (1,4), (2,4)\n    }\n\n    static void printMatrix(boolean[][] m, int n) {\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                System.out.print((m[i][j] ? \"1\" : \"0\") + \" \");\n            }\n            System.out.println();\n        }\n    }\n}"
