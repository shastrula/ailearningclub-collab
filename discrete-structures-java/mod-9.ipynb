          "java",
          "import java.util.*;\n\npublic class RelationProperties<T> {\n\n    private final Set<T> domain;\n    private final Set<List<T>> pairs;\n\n    public RelationProperties(Set<T> domain, Set<List<T>> pairs) {\n        this.domain = domain;\n        this.pairs = pairs;\n    }\n\n    public boolean isReflexive() {\n        for (T a : domain) {\n            if (!pairs.contains(List.of(a, a))) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    public boolean isIrreflexive() {\n        for (T a : domain) {\n            if (pairs.contains(List.of(a, a))) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    public boolean isSymmetric() {\n        for (List<T> pair : pairs) {\n            T a = pair.get(0), b = pair.get(1);\n            if (!pairs.contains(List.of(b, a))) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    public boolean isAntisymmetric() {\n        for (List<T> pair : pairs) {\n            T a = pair.get(0), b = pair.get(1);\n            if (!a.equals(b) && pairs.contains(List.of(b, a))) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    public boolean isTransitive() {\n        for (List<T> p1 : pairs) {\n            T a = p1.get(0), b = p1.get(1);\n            for (List<T> p2 : pairs) {\n                if (p2.get(0).equals(b)) {\n                    T c = p2.get(1);\n                    if (!pairs.contains(List.of(a, c))) {\n                        return false;\n                    }\n                }\n            }\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        Set<Integer> A = Set.of(1, 2, 3, 4);\n\n        // \"divides\" relation\n        Set<List<Integer>> dividesPairs = new HashSet<>();\n        for (int a : A) {\n            for (int b : A) {\n                if (b % a == 0) dividesPairs.add(List.of(a, b));\n            }\n        }\n        RelationProperties<Integer> divides = new RelationProperties<>(A, dividesPairs);\n        System.out.println(\"Divides relation:\");\n        System.out.println(\"  Reflexive: \" + divides.isReflexive());       // true\n        System.out.println(\"  Symmetric: \" + divides.isSymmetric());       // false\n        System.out.println(\"  Antisymmetric: \" + divides.isAntisymmetric()); // true\n        System.out.println(\"  Transitive: \" + divides.isTransitive());     // true\n\n        // \"less than\" relation\n        Set<List<Integer>> ltPairs = new HashSet<>();\n        for (int a : A) {\n            for (int b : A) {\n                if (a < b) ltPairs.add(List.of(a, b));\n            }\n        }\n        RelationProperties<Integer> lessThan = new RelationProperties<>(A, ltPairs);\n        System.out.println(\"\\nLess-than relation:\");\n        System.out.println(\"  Reflexive: \" + lessThan.isReflexive());       // false\n        System.out.println(\"  Irreflexive: \" + lessThan.isIrreflexive());   // true\n        System.out.println(\"  Symmetric: \" + lessThan.isSymmetric());       // false\n        System.out.println(\"  Antisymmetric: \" + lessThan.isAntisymmetric()); // true\n        System.out.println(\"  Transitive: \" + lessThan.isTransitive());     // true\n\n        // \"same parity\" relation\n        Set<List<Integer>> parityPairs = new HashSet<>();\n        for (int a : A) {\n            for (int b : A) {\n                if (a % 2 == b % 2) parityPairs.add(List.of(a, b));\n            }\n        }\n        RelationProperties<Integer> sameParity = new RelationProperties<>(A, parityPairs);\n        System.out.println(\"\\nSame-parity relation:\");\n        System.out.println(\"  Reflexive: \" + sameParity.isReflexive());       // true\n        System.out.println(\"  Symmetric: \" + sameParity.isSymmetric());       // true\n        System.out.println(\"  Antisymmetric: \" + sameParity.isAntisymmetric()); // false\n        System.out.println(\"  Transitive: \" + sameParity.isTransitive());     // true\n    }\n}"
