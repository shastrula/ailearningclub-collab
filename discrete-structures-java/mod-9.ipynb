          "java",
          "import java.util.*;\n\npublic class RelationMatrix {\n\n    private final boolean[][] matrix;\n    private final int size;\n    private final List<Integer> elements;\n\n    public RelationMatrix(Set<Integer> domain, Set<List<Integer>> pairs) {\n        this.elements = new ArrayList<>(new TreeSet<>(domain));\n        this.size = elements.size();\n        this.matrix = new boolean[size][size];\n\n        for (List<Integer> pair : pairs) {\n            int i = elements.indexOf(pair.get(0));\n            int j = elements.indexOf(pair.get(1));\n            if (i >= 0 && j >= 0) matrix[i][j] = true;\n        }\n    }\n\n    public void print() {\n        System.out.print(\"  \");\n        for (int e : elements) System.out.printf(\"%3d\", e);\n        System.out.println();\n        for (int i = 0; i < size; i++) {\n            System.out.printf(\"%d:\", elements.get(i));\n            for (int j = 0; j < size; j++) {\n                System.out.printf(\"%3s\", matrix[i][j] ? \"1\" : \"0\");\n            }\n            System.out.println();\n        }\n    }\n\n    public boolean isReflexive() {\n        for (int i = 0; i < size; i++) {\n            if (!matrix[i][i]) return false;\n        }\n        return true;\n    }\n\n    public boolean isSymmetric() {\n        for (int i = 0; i < size; i++) {\n            for (int j = 0; j < size; j++) {\n                if (matrix[i][j] != matrix[j][i]) return false;\n            }\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        Set<Integer> domain = Set.of(1, 2, 3, 4);\n\n        // Less-than-or-equal relation\n        Set<List<Integer>> lePairs = new HashSet<>();\n        for (int a : domain) {\n            for (int b : domain) {\n                if (a <= b) lePairs.add(List.of(a, b));\n            }\n        }\n\n        RelationMatrix leq = new RelationMatrix(domain, lePairs);\n        System.out.println(\"Less-than-or-equal matrix:\");\n        leq.print();\n        System.out.println(\"Reflexive: \" + leq.isReflexive());\n        System.out.println(\"Symmetric: \" + leq.isSymmetric());\n    }\n}"
        ]
