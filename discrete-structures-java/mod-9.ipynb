          "java",
          "import java.util.*;\nimport java.util.stream.*;\n\npublic class Relation<T> {\n\n    private final Set<T> domain;\n    private final Set<List<T>> pairs;\n\n    public Relation(Set<T> domain) {\n        this.domain = domain;\n        this.pairs = new HashSet<>();\n    }\n\n    public Relation(Set<T> domain, Set<List<T>> pairs) {\n        this.domain = domain;\n        this.pairs = new HashSet<>(pairs);\n    }\n\n    public void addPair(T a, T b) {\n        pairs.add(List.of(a, b));\n    }\n\n    public boolean isRelated(T a, T b) {\n        return pairs.contains(List.of(a, b));\n    }\n\n    public Set<List<T>> getPairs() {\n        return Collections.unmodifiableSet(pairs);\n    }\n\n    public Set<T> getDomain() {\n        return domain;\n    }\n\n    public static void main(String[] args) {\n        Set<Integer> A = Set.of(1, 2, 3, 4);\n\n        // \"divides\" relation: (a, b) means a divides b\n        Relation<Integer> divides = new Relation<>(A);\n        for (int a : A) {\n            for (int b : A) {\n                if (b % a == 0) {\n                    divides.addPair(a, b);\n                }\n            }\n        }\n\n        System.out.println(\"Divides relation on \" + A + \":\");\n        System.out.println(divides.getPairs());\n        System.out.println(\"2 divides 4: \" + divides.isRelated(2, 4)); // true\n        System.out.println(\"3 divides 4: \" + divides.isRelated(3, 4)); // false\n    }\n}"
        ]
      ]
