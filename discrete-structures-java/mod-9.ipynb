          "java",
          "import java.util.*;\n\npublic class RelationComposition {\n\n    public static <T> Set<List<T>> compose(Set<List<T>> r, Set<List<T>> s) {\n        Set<List<T>> result = new HashSet<>();\n        for (List<T> pair1 : r) {\n            T a = pair1.get(0);\n            T b = pair1.get(1);\n            for (List<T> pair2 : s) {\n                if (pair2.get(0).equals(b)) {\n                    T c = pair2.get(1);\n                    result.add(List.of(a, c));\n                }\n            }\n        }\n        return result;\n    }\n\n    // Power of a relation: R^n = R composed with itself n times\n    public static <T> Set<List<T>> power(Set<List<T>> r, int n) {\n        if (n == 1) return new HashSet<>(r);\n        Set<List<T>> result = new HashSet<>(r);\n        for (int i = 2; i <= n; i++) {\n            result = compose(result, r);\n        }\n        return result;\n    }\n\n    public static void main(String[] args) {\n        // R: \"is parent of\", S: \"is sibling of\"\n        // R;S: \"is parent of a sibling of\" = \"is uncle/aunt of\"\n        Set<List<String>> parentOf = Set.of(\n            List.of(\"Alice\", \"Bob\"),\n            List.of(\"Alice\", \"Carol\"),\n            List.of(\"Dave\", \"Eve\")\n        );\n\n        Set<List<String>> siblingOf = Set.of(\n            List.of(\"Bob\", \"Carol\"),\n            List.of(\"Carol\", \"Bob\")\n        );\n\n        Set<List<String>> composed = compose(parentOf, siblingOf);\n        System.out.println(\"Parent-of relation: \" + parentOf);\n        System.out.println(\"Sibling-of relation: \" + siblingOf);\n        System.out.println(\"Parent-of;Sibling-of: \" + composed);\n\n        // Numeric example: R on {1,2,3,4} where (a,b) means a+1=b\n        Set<List<Integer>> successor = Set.of(\n            List.of(1, 2), List.of(2, 3), List.of(3, 4)\n        );\n        System.out.println(\"\\nSuccessor R: \" + successor);\n        System.out.println(\"R^2 (two steps): \" + power(successor, 2));\n        System.out.println(\"R^3 (three steps): \" + power(successor, 3));\n    }\n}"
        ]
