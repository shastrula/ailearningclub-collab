          "java",
          "import java.util.*;\n\npublic class CircuitSimulator {\n\n    enum GateType { AND, OR, NOT, NAND, NOR, XOR, INPUT }\n\n    static class Gate {\n        String name;\n        GateType type;\n        List<Gate> inputs = new ArrayList<>();\n        int output = 0;\n\n        Gate(String name, GateType type) {\n            this.name = name;\n            this.type = type;\n        }\n\n        int evaluate() {\n            return switch (type) {\n                case INPUT -> output;\n                case NOT -> 1 - inputs.get(0).evaluate();\n                case AND -> inputs.stream().allMatch(g -> g.evaluate() == 1) ? 1 : 0;\n                case OR -> inputs.stream().anyMatch(g -> g.evaluate() == 1) ? 1 : 0;\n                case NAND -> inputs.stream().allMatch(g -> g.evaluate() == 1) ? 0 : 1;\n                case NOR -> inputs.stream().anyMatch(g -> g.evaluate() == 1) ? 0 : 1;\n                case XOR -> inputs.stream().mapToInt(Gate::evaluate).reduce(0, (a, b) -> a ^ b);\n            };\n        }\n    }\n\n    // Build a full adder circuit: Sum = A XOR B XOR Cin, Cout = AB + Cin(A XOR B)\n    public static void fullAdder() {\n        Gate A = new Gate(\"A\", GateType.INPUT);\n        Gate B = new Gate(\"B\", GateType.INPUT);\n        Gate Cin = new Gate(\"Cin\", GateType.INPUT);\n\n        Gate xor1 = new Gate(\"XOR1\", GateType.XOR);\n        xor1.inputs.addAll(List.of(A, B));\n\n        Gate sum = new Gate(\"Sum\", GateType.XOR);\n        sum.inputs.addAll(List.of(xor1, Cin));\n\n        Gate and1 = new Gate(\"AND1\", GateType.AND);\n        and1.inputs.addAll(List.of(A, B));\n\n        Gate and2 = new Gate(\"AND2\", GateType.AND);\n        and2.inputs.addAll(List.of(xor1, Cin));\n\n        Gate cout = new Gate(\"Cout\", GateType.OR);\n        cout.inputs.addAll(List.of(and1, and2));\n\n        System.out.println(\"Full Adder Truth Table:\");\n        System.out.println(\"| A | B | Cin | Sum | Cout |\");\n        System.out.println(\"-\".repeat(32));\n\n        for (int a = 0; a <= 1; a++) {\n            for (int b = 0; b <= 1; b++) {\n                for (int c = 0; c <= 1; c++) {\n                    A.output = a; B.output = b; Cin.output = c;\n                    System.out.printf(\"| %d | %d |  %d  |  %d  |  %d   |%n\",\n                        a, b, c, sum.evaluate(), cout.evaluate());\n                }\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        fullAdder();\n    }\n}"
        ]
