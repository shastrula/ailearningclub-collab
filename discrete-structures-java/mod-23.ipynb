          "java",
          "import java.util.*;\n\npublic class KarnaughMap {\n\n    // For a 2-variable function, find minimal sum-of-products\n    public static String minimizeTwoVar(int[] truthValues) {\n        // truthValues indexed as: [00, 01, 10, 11] = [A'B', A'B, AB', AB]\n        List<String> terms = new ArrayList<>();\n\n        // Check for groups of 4 (constant 1)\n        if (truthValues[0] == 1 && truthValues[1] == 1 &&\n            truthValues[2] == 1 && truthValues[3] == 1) return \"1\";\n\n        // Check for groups of 2\n        if (truthValues[0] == 1 && truthValues[1] == 1) terms.add(\"A'\");\n        if (truthValues[2] == 1 && truthValues[3] == 1) terms.add(\"A\");\n        if (truthValues[0] == 1 && truthValues[2] == 1) terms.add(\"B'\");\n        if (truthValues[1] == 1 && truthValues[3] == 1) terms.add(\"B\");\n\n        // Check for remaining singletons\n        boolean[] covered = new boolean[4];\n        for (String term : terms) {\n            switch (term) {\n                case \"A'\" -> { covered[0] = true; covered[1] = true; }\n                case \"A\" -> { covered[2] = true; covered[3] = true; }\n                case \"B'\" -> { covered[0] = true; covered[2] = true; }\n                case \"B\" -> { covered[1] = true; covered[3] = true; }\n            }\n        }\n\n        String[] minterms = {\"A'B'\", \"A'B\", \"AB'\", \"AB\"};\n        for (int i = 0; i < 4; i++) {\n            if (truthValues[i] == 1 && !covered[i]) {\n                terms.add(minterms[i]);\n            }\n        }\n\n        if (terms.isEmpty()) return \"0\";\n        return String.join(\" + \", terms);\n    }\n\n    // Generate truth table from minterm list\n    public static int[] fromMinterms(int numVars, int... minterms) {\n        int[] table = new int[1 << numVars];\n        for (int m : minterms) table[m] = 1;\n        return table;\n    }\n\n    public static void main(String[] args) {\n        // F(A,B) = A'B + AB = B (simplification via K-map)\n        int[] f1 = fromMinterms(2, 1, 3); // minterms 01 and 11\n        System.out.println(\"F = m(1,3) = \" + minimizeTwoVar(f1));\n\n        // F(A,B) = A'B' + A'B + AB = A' + AB\n        int[] f2 = fromMinterms(2, 0, 1, 3);\n        System.out.println(\"F = m(0,1,3) = \" + minimizeTwoVar(f2));\n\n        // F(A,B) = A'B' + AB' = B'\n        int[] f3 = fromMinterms(2, 0, 2);\n        System.out.println(\"F = m(0,2) = \" + minimizeTwoVar(f3));\n\n        System.out.println(\"\\nK-map concept:\");\n        System.out.println(\"  Adjacent cells differ by one variable\");\n        System.out.println(\"  Group cells with 1s into largest powers of 2\");\n        System.out.println(\"  Each group eliminates the variable that changes\");\n    }\n}"
        ]
