          "java",
          "public class UniversalGates {\n\n    static int NAND(int a, int b) { return 1 - (a & b); }\n    static int NOR(int a, int b) { return 1 - (a | b); }\n\n    public static void main(String[] args) {\n        System.out.println(\"Building all operations from NAND only:\");\n        System.out.println();\n\n        // NOT A = NAND(A, A)\n        System.out.println(\"NOT using NAND: NOT A = NAND(A, A)\");\n        for (int a = 0; a <= 1; a++) {\n            System.out.printf(\"  NOT(%d) = NAND(%d,%d) = %d%n\", a, a, a, NAND(a, a));\n        }\n\n        // AND A B = NOT(NAND(A, B)) = NAND(NAND(A,B), NAND(A,B))\n        System.out.println(\"\\nAND using NAND: AND(A,B) = NAND(NAND(A,B), NAND(A,B))\");\n        for (int a = 0; a <= 1; a++) {\n            for (int b = 0; b <= 1; b++) {\n                int nab = NAND(a, b);\n                int result = NAND(nab, nab);\n                System.out.printf(\"  AND(%d,%d) = %d%n\", a, b, result);\n            }\n        }\n\n        // OR A B = NAND(NOT A, NOT B) = NAND(NAND(A,A), NAND(B,B))\n        System.out.println(\"\\nOR using NAND: OR(A,B) = NAND(NAND(A,A), NAND(B,B))\");\n        for (int a = 0; a <= 1; a++) {\n            for (int b = 0; b <= 1; b++) {\n                int result = NAND(NAND(a, a), NAND(b, b));\n                System.out.printf(\"  OR(%d,%d) = %d%n\", a, b, result);\n            }\n        }\n\n        System.out.println(\"\\nNAND gate count for common circuits:\");\n        System.out.println(\"  NOT: 1 NAND gate\");\n        System.out.println(\"  AND: 2 NAND gates\");\n        System.out.println(\"  OR:  3 NAND gates\");\n        System.out.println(\"  XOR: 4 NAND gates\");\n        System.out.println(\"  Half Adder: 5 NAND gates\");\n    }\n}"
