          "java",
          "import java.util.*;\n\npublic class BooleanAlgebra {\n\n    // Basic Boolean operations\n    public static int AND(int a, int b) { return a & b; }\n    public static int OR(int a, int b) { return a | b; }\n    public static int NOT(int a) { return 1 - a; }\n    public static int XOR(int a, int b) { return a ^ b; }\n    public static int NAND(int a, int b) { return NOT(AND(a, b)); }\n    public static int NOR(int a, int b) { return NOT(OR(a, b)); }\n\n    // Evaluate expression and print truth table\n    @FunctionalInterface\n    interface BoolExpr {\n        int eval(int[] vars);\n    }\n\n    public static void truthTable(String name, int numVars, BoolExpr expr) {\n        String[] varNames = {\"A\", \"B\", \"C\", \"D\"};\n        System.out.print(\"| \");\n        for (int i = 0; i < numVars; i++) System.out.print(varNames[i] + \" | \");\n        System.out.println(name + \" |\");\n        System.out.println(\"-\".repeat(numVars * 4 + name.length() + 5));\n\n        for (int mask = 0; mask < (1 << numVars); mask++) {\n            int[] vars = new int[numVars];\n            System.out.print(\"| \");\n            for (int i = 0; i < numVars; i++) {\n                vars[i] = (mask >> (numVars - 1 - i)) & 1;\n                System.out.print(vars[i] + \" | \");\n            }\n            System.out.println(expr.eval(vars) + \" |\");\n        }\n        System.out.println();\n    }\n\n    public static void main(String[] args) {\n        // Half adder: Sum = A XOR B, Carry = A AND B\n        System.out.println(\"=== Half Adder ===\");\n        truthTable(\"Sum\", 2, v -> XOR(v[0], v[1]));\n        truthTable(\"Carry\", 2, v -> AND(v[0], v[1]));\n\n        // Multiplexer: Out = (NOT S AND A) OR (S AND B)\n        System.out.println(\"=== 2:1 Multiplexer (S selects A or B) ===\");\n        truthTable(\"Out\", 3, v -> OR(AND(NOT(v[0]), v[1]), AND(v[0], v[2])));\n    }\n}"
        ]
      ]
