          "java",
          "import java.util.*;\n\npublic class BooleanSimplification {\n\n    // Represent a minterm (product term) as a set of literals\n    // Positive integer = variable, negative = complement\n    static class Minterm {\n        Set<Integer> literals;\n        Set<Integer> coveredMinterms;\n\n        Minterm(Set<Integer> literals, Set<Integer> covered) {\n            this.literals = new HashSet<>(literals);\n            this.coveredMinterms = new HashSet<>(covered);\n        }\n\n        // Check if two minterms can be combined (differ in exactly one literal)\n        Optional<Minterm> combine(Minterm other) {\n            Set<Integer> diff = new HashSet<>(literals);\n            diff.removeAll(other.literals);\n            Set<Integer> diff2 = new HashSet<>(other.literals);\n            diff2.removeAll(literals);\n\n            if (diff.size() == 1 && diff2.size() == 1) {\n                int lit1 = diff.iterator().next();\n                int lit2 = diff2.iterator().next();\n                if (lit1 == -lit2) {\n                    Set<Integer> combined = new HashSet<>(literals);\n                    combined.remove(lit1);\n                    Set<Integer> covered = new HashSet<>(coveredMinterms);\n                    covered.addAll(other.coveredMinterms);\n                    return Optional.of(new Minterm(combined, covered));\n                }\n            }\n            return Optional.empty();\n        }\n\n        @Override\n        public String toString() {\n            StringBuilder sb = new StringBuilder();\n            List<Integer> sorted = new ArrayList<>(literals);\n            sorted.sort(Comparator.comparingInt(Math::abs));\n            for (int lit : sorted) {\n                if (lit > 0) sb.append((char)('A' + lit - 1));\n                else sb.append((char)('A' - lit - 1)).append(\"'\");\n            }\n            return sb.toString();\n        }\n    }\n\n    // Demonstrate algebraic simplification\n    public static void demonstrateSimplification() {\n        System.out.println(\"Boolean Algebra Simplification Laws:\");\n        System.out.println();\n        System.out.println(\"1. Idempotent: A + A = A, A * A = A\");\n        System.out.println(\"2. Complement: A + A' = 1, A * A' = 0\");\n        System.out.println(\"3. Absorption: A + AB = A, A(A + B) = A\");\n        System.out.println(\"4. De Morgan: (AB)' = A' + B', (A+B)' = A'B'\");\n        System.out.println(\"5. Consensus: AB + A'C + BC = AB + A'C\");\n        System.out.println();\n\n        // Verify consensus theorem\n        System.out.println(\"Consensus theorem verification:\");\n        System.out.println(\"| A | B | C | AB+A'C+BC | AB+A'C |\");\n        System.out.println(\"-\".repeat(42));\n        for (int a = 0; a <= 1; a++) {\n            for (int b = 0; b <= 1; b++) {\n                for (int c = 0; c <= 1; c++) {\n                    int left = (a&b) | ((1-a)&c) | (b&c);\n                    int right = (a&b) | ((1-a)&c);\n                    System.out.printf(\"| %d | %d | %d |     %d     |   %d    |%n\",\n                        a, b, c, left, right);\n                }\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        demonstrateSimplification();\n    }\n}"
