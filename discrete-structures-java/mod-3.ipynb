          "java",
          "import java.util.*;\n\npublic class ThreeVarTruthTable {\n\n    @FunctionalInterface\n    interface TriFunction {\n        boolean apply(boolean a, boolean b, boolean c);\n    }\n\n    public static void printTable(String expr, TriFunction formula) {\n        System.out.printf(\"%-6s %-6s %-6s %s%n\", \"p\", \"q\", \"r\", expr);\n        System.out.println(\"-\".repeat(35));\n\n        for (int i = 0; i < 8; i++) {\n            boolean p = ((i >> 2) & 1) == 1;\n            boolean q = ((i >> 1) & 1) == 1;\n            boolean r = (i & 1) == 1;\n            boolean result = formula.apply(p, q, r);\n            System.out.printf(\"%-6b %-6b %-6b %b%n\", p, q, r, result);\n        }\n        System.out.println();\n    }\n\n    public static void main(String[] args) {\n        // (p OR q) AND (NOT r)\n        printTable(\"(p OR q) AND (NOT r)\",\n            (p, q, r) -> (p || q) && !r);\n\n        // p -> (q AND r)\n        printTable(\"p -> (q AND r)\",\n            (p, q, r) -> !p || (q && r));\n\n        // (p AND q) -> r  vs  p -> (q -> r)  -- should be equivalent\n        printTable(\"(p AND q) -> r\",\n            (p, q, r) -> !(p && q) || r);\n\n        printTable(\"p -> (q -> r)\",\n            (p, q, r) -> !p || (!q || r));\n    }\n}"
