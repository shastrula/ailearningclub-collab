          "java",
          "import java.util.*;\n\npublic class EquivalenceLaws {\n\n    record Law(String name, String left, String right, boolean verified) {}\n\n    public static void main(String[] args) {\n        List<Law> laws = new ArrayList<>();\n\n        // Identity Laws\n        laws.add(verify(\"Identity AND\", (p, q) -> p && true, (p, q) -> p));\n        laws.add(verify(\"Identity OR\", (p, q) -> p || false, (p, q) -> p));\n\n        // Domination Laws\n        laws.add(verify(\"Domination OR\", (p, q) -> p || true, (p, q) -> true));\n        laws.add(verify(\"Domination AND\", (p, q) -> p && false, (p, q) -> false));\n\n        // Idempotent Laws\n        laws.add(verify(\"Idempotent AND\", (p, q) -> p && p, (p, q) -> p));\n        laws.add(verify(\"Idempotent OR\", (p, q) -> p || p, (p, q) -> p));\n\n        // Commutative Laws\n        laws.add(verify(\"Commutative AND\", (p, q) -> p && q, (p, q) -> q && p));\n        laws.add(verify(\"Commutative OR\", (p, q) -> p || q, (p, q) -> q || p));\n\n        System.out.println(\"Logical Equivalence Laws Verification:\");\n        System.out.println(\"=\".repeat(50));\n        for (Law law : laws) {\n            String status = law.verified ? \"VERIFIED\" : \"FAILED\";\n            System.out.printf(\"[%s] %s%n\", status, law.name);\n        }\n    }\n\n    private static Law verify(String name,\n                               java.util.function.BiFunction<Boolean, Boolean, Boolean> left,\n                               java.util.function.BiFunction<Boolean, Boolean, Boolean> right) {\n        boolean[] vals = {true, false};\n        for (boolean p : vals) {\n            for (boolean q : vals) {\n                if (!left.apply(p, q).equals(right.apply(p, q))) {\n                    return new Law(name, \"\", \"\", false);\n                }\n            }\n        }\n        return new Law(name, \"\", \"\", true);\n    }\n}"
        ]
