          "java",
          "import java.util.*;\nimport java.util.function.*;\n\npublic class PropositionClassifier {\n\n    public enum Classification {\n        TAUTOLOGY, CONTRADICTION, CONTINGENCY\n    }\n\n    public static Classification classify(int numVars, Function<boolean[], Boolean> formula) {\n        int totalRows = 1 << numVars;\n        boolean allTrue = true;\n        boolean allFalse = true;\n\n        for (int i = 0; i < totalRows; i++) {\n            boolean[] assignment = new boolean[numVars];\n            for (int j = 0; j < numVars; j++) {\n                assignment[j] = ((i >> (numVars - 1 - j)) & 1) == 1;\n            }\n            boolean result = formula.apply(assignment);\n            if (!result) allTrue = false;\n            if (result) allFalse = false;\n        }\n\n        if (allTrue) return Classification.TAUTOLOGY;\n        if (allFalse) return Classification.CONTRADICTION;\n        return Classification.CONTINGENCY;\n    }\n\n    public static void main(String[] args) {\n        // p OR NOT p (law of excluded middle) -- tautology\n        Classification c1 = classify(1, vars -> vars[0] || !vars[0]);\n        System.out.println(\"p OR NOT p: \" + c1);\n\n        // p AND NOT p -- contradiction\n        Classification c2 = classify(1, vars -> vars[0] && !vars[0]);\n        System.out.println(\"p AND NOT p: \" + c2);\n\n        // p -> q -- contingency\n        Classification c3 = classify(2, vars -> !vars[0] || vars[1]);\n        System.out.println(\"p -> q: \" + c3);\n\n        // (p -> q) AND (q -> p) -> (p <-> q) -- tautology\n        Classification c4 = classify(2, vars -> {\n            boolean p = vars[0], q = vars[1];\n            boolean premise = (!p || q) && (!q || p);\n            boolean conclusion = p == q;\n            return !premise || conclusion;\n        });\n        System.out.println(\"((p->q) AND (q->p)) -> (p<->q): \" + c4);\n    }\n}"
        ]
      ]
