          "java",
          "import java.util.function.*;\n\npublic class LogicalEquivalences {\n\n    static boolean implies(boolean p, boolean q) { return !p || q; }\n\n    // Verify two 2-variable formulas are equivalent\n    static boolean areEquivalent(BiFunction<Boolean, Boolean, Boolean> f1,\n                                  BiFunction<Boolean, Boolean, Boolean> f2) {\n        boolean[] vals = {true, false};\n        for (boolean p : vals) {\n            for (boolean q : vals) {\n                if (!f1.apply(p, q).equals(f2.apply(p, q))) {\n                    return false;\n                }\n            }\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        // De Morgan's Laws\n        System.out.println(\"=== De Morgan's Laws ===\");\n        boolean dm1 = areEquivalent(\n            (p, q) -> !(p && q),\n            (p, q) -> !p || !q\n        );\n        System.out.println(\"NOT(p AND q) == NOT p OR NOT q: \" + dm1);\n\n        boolean dm2 = areEquivalent(\n            (p, q) -> !(p || q),\n            (p, q) -> !p && !q\n        );\n        System.out.println(\"NOT(p OR q) == NOT p AND NOT q: \" + dm2);\n\n        // Implication equivalence\n        System.out.println(\"\\n=== Implication Equivalence ===\");\n        boolean imp = areEquivalent(\n            (p, q) -> implies(p, q),\n            (p, q) -> !p || q\n        );\n        System.out.println(\"p -> q == NOT p OR q: \" + imp);\n\n        // Contrapositive\n        System.out.println(\"\\n=== Contrapositive ===\");\n        boolean contra = areEquivalent(\n            (p, q) -> implies(p, q),\n            (p, q) -> implies(!q, !p)\n        );\n        System.out.println(\"p -> q == NOT q -> NOT p: \" + contra);\n\n        // Distributive Laws\n        System.out.println(\"\\n=== Distributive Laws ===\");\n        // Need 3 variables for full distributive law - test with fixed r\n        boolean r = true;\n        boolean dist = areEquivalent(\n            (p, q) -> p && (q || r),\n            (p, q) -> (p && q) || (p && r)\n        );\n        System.out.println(\"p AND (q OR r) == (p AND q) OR (p AND r): \" + dist);\n\n        // Absorption Laws\n        System.out.println(\"\\n=== Absorption Laws ===\");\n        boolean abs1 = areEquivalent(\n            (p, q) -> p || (p && q),\n            (p, q) -> p\n        );\n        System.out.println(\"p OR (p AND q) == p: \" + abs1);\n\n        boolean abs2 = areEquivalent(\n            (p, q) -> p && (p || q),\n            (p, q) -> p\n        );\n        System.out.println(\"p AND (p OR q) == p: \" + abs2);\n    }\n}"
        ]
