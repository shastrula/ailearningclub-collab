          "java",
          "import java.util.*;\nimport java.util.function.*;\n\npublic class TruthTableGenerator {\n\n    // Generate all possible truth value assignments for n variables\n    public static List<boolean[]> generateAssignments(int n) {\n        List<boolean[]> assignments = new ArrayList<>();\n        int totalRows = 1 << n; // 2^n\n\n        for (int i = 0; i < totalRows; i++) {\n            boolean[] row = new boolean[n];\n            for (int j = 0; j < n; j++) {\n                // Extract bit j from number i\n                row[j] = ((i >> (n - 1 - j)) & 1) == 1;\n            }\n            assignments.add(row);\n        }\n        return assignments;\n    }\n\n    // Print a truth table for a two-variable expression\n    public static void printTruthTable(String expr, BiFunction<Boolean, Boolean, Boolean> formula) {\n        System.out.printf(\"%-6s %-6s %s%n\", \"p\", \"q\", expr);\n        System.out.println(\"-\".repeat(25));\n\n        List<boolean[]> assignments = generateAssignments(2);\n        for (boolean[] row : assignments) {\n            boolean result = formula.apply(row[0], row[1]);\n            System.out.printf(\"%-6b %-6b %b%n\", row[0], row[1], result);\n        }\n        System.out.println();\n    }\n\n    public static void main(String[] args) {\n        // Truth table for p AND q\n        printTruthTable(\"p AND q\", (p, q) -> p && q);\n\n        // Truth table for p -> q (implication)\n        printTruthTable(\"p -> q\", (p, q) -> !p || q);\n\n        // Truth table for p <-> q (biconditional)\n        printTruthTable(\"p <-> q\", (p, q) -> p == q);\n\n        // Complex expression: (p -> q) AND (q -> p) should equal p <-> q\n        printTruthTable(\"(p->q) AND (q->p)\", (p, q) -> (!p || q) && (!q || p));\n    }\n}"
