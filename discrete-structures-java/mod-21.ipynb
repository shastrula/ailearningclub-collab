          "java",
          "import java.util.*;\n\npublic class EulerPath {\n\n    static class Graph {\n        int n;\n        List<List<int[]>> adj; // [neighbor, edge_index]\n        int edgeCount = 0;\n\n        Graph(int n) {\n            this.n = n;\n            adj = new ArrayList<>();\n            for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n        }\n\n        void addEdge(int u, int v) {\n            adj.get(u).add(new int[]{v, edgeCount});\n            adj.get(v).add(new int[]{u, edgeCount});\n            edgeCount++;\n        }\n\n        int degree(int v) { return adj.get(v).size(); }\n    }\n\n    // Check existence of Euler path/circuit\n    public static String eulerType(Graph g) {\n        if (!isConnected(g)) return \"NONE (disconnected)\";\n\n        int oddDegreeCount = 0;\n        for (int v = 0; v < g.n; v++) {\n            if (g.degree(v) % 2 != 0) oddDegreeCount++;\n        }\n\n        if (oddDegreeCount == 0) return \"EULER CIRCUIT\";\n        if (oddDegreeCount == 2) return \"EULER PATH\";\n        return \"NONE (\" + oddDegreeCount + \" odd-degree vertices)\";\n    }\n\n    // Find Euler path/circuit using Hierholzer's algorithm\n    public static List<Integer> findEulerPath(Graph g) {\n        // Find start vertex\n        int start = 0;\n        for (int v = 0; v < g.n; v++) {\n            if (g.degree(v) % 2 != 0) { start = v; break; }\n        }\n\n        boolean[] usedEdge = new boolean[g.edgeCount];\n        int[] currentIndex = new int[g.n]; // track which adjacency to try next\n        Deque<Integer> stack = new ArrayDeque<>();\n        List<Integer> path = new ArrayList<>();\n\n        stack.push(start);\n        while (!stack.isEmpty()) {\n            int v = stack.peek();\n            boolean found = false;\n            while (currentIndex[v] < g.adj.get(v).size()) {\n                int[] edge = g.adj.get(v).get(currentIndex[v]);\n                currentIndex[v]++;\n                if (!usedEdge[edge[1]]) {\n                    usedEdge[edge[1]] = true;\n                    stack.push(edge[0]);\n                    found = true;\n                    break;\n                }\n            }\n            if (!found) {\n                path.add(stack.pop());\n            }\n        }\n        Collections.reverse(path);\n        return path;\n    }\n\n    private static boolean isConnected(Graph g) {\n        boolean[] visited = new boolean[g.n];\n        int start = -1;\n        for (int v = 0; v < g.n; v++) {\n            if (g.degree(v) > 0) { start = v; break; }\n        }\n        if (start == -1) return true;\n        dfs(g, start, visited);\n        for (int v = 0; v < g.n; v++) {\n            if (g.degree(v) > 0 && !visited[v]) return false;\n        }\n        return true;\n    }\n\n    private static void dfs(Graph g, int v, boolean[] visited) {\n        visited[v] = true;\n        for (int[] edge : g.adj.get(v)) {\n            if (!visited[edge[0]]) dfs(g, edge[0], visited);\n        }\n    }\n\n    public static void main(String[] args) {\n        // Graph with Euler circuit (all even degrees)\n        Graph g1 = new Graph(4);\n        g1.addEdge(0, 1); g1.addEdge(1, 2);\n        g1.addEdge(2, 3); g1.addEdge(3, 0);\n        g1.addEdge(0, 2); g1.addEdge(1, 3);\n\n        System.out.println(\"Graph 1: \" + eulerType(g1));\n        System.out.println(\"  Degrees: 3,3,3,3 -> \" + eulerType(g1));\n        List<Integer> path1 = findEulerPath(g1);\n        System.out.println(\"  Euler path: \" + path1);\n\n        // Graph with Euler path (exactly 2 odd-degree vertices)\n        Graph g2 = new Graph(4);\n        g2.addEdge(0, 1); g2.addEdge(0, 2);\n        g2.addEdge(1, 2); g2.addEdge(2, 3);\n\n        System.out.println(\"\\nGraph 2: \" + eulerType(g2));\n        List<Integer> path2 = findEulerPath(g2);\n        System.out.println(\"  Euler path: \" + path2);\n\n        // Konigsberg bridges (no Euler path)\n        Graph konigsberg = new Graph(4);\n        konigsberg.addEdge(0, 1); konigsberg.addEdge(0, 1); // double edge workaround\n        konigsberg.addEdge(0, 2); konigsberg.addEdge(0, 2);\n        konigsberg.addEdge(0, 3);\n        konigsberg.addEdge(1, 2);\n        konigsberg.addEdge(2, 3);\n        System.out.println(\"\\nKonigsberg-like: \" + eulerType(konigsberg));\n    }\n}"
        ]
