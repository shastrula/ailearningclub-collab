          "java",
          "import java.util.*;\n\npublic class HamiltonianPath {\n\n    static class Graph {\n        int n;\n        boolean[][] adj;\n\n        Graph(int n) { this.n = n; adj = new boolean[n][n]; }\n        void addEdge(int u, int v) { adj[u][v] = true; adj[v][u] = true; }\n    }\n\n    // Find Hamiltonian path using backtracking\n    public static List<Integer> findHamiltonianPath(Graph g) {\n        boolean[] visited = new boolean[g.n];\n        List<Integer> path = new ArrayList<>();\n\n        for (int start = 0; start < g.n; start++) {\n            visited[start] = true;\n            path.add(start);\n            if (hamiltonianHelper(g, visited, path)) {\n                return path;\n            }\n            path.remove(path.size() - 1);\n            visited[start] = false;\n        }\n        return Collections.emptyList(); // no path exists\n    }\n\n    private static boolean hamiltonianHelper(Graph g, boolean[] visited, List<Integer> path) {\n        if (path.size() == g.n) return true;\n\n        int last = path.get(path.size() - 1);\n        for (int next = 0; next < g.n; next++) {\n            if (g.adj[last][next] && !visited[next]) {\n                visited[next] = true;\n                path.add(next);\n                if (hamiltonianHelper(g, visited, path)) return true;\n                path.remove(path.size() - 1);\n                visited[next] = false;\n            }\n        }\n        return false;\n    }\n\n    // Find Hamiltonian circuit\n    public static List<Integer> findHamiltonianCircuit(Graph g) {\n        boolean[] visited = new boolean[g.n];\n        List<Integer> path = new ArrayList<>();\n\n        visited[0] = true;\n        path.add(0);\n        if (circuitHelper(g, visited, path)) {\n            path.add(0); // close the circuit\n            return path;\n        }\n        return Collections.emptyList();\n    }\n\n    private static boolean circuitHelper(Graph g, boolean[] visited, List<Integer> path) {\n        if (path.size() == g.n) {\n            // Check if last vertex connects back to start\n            int last = path.get(path.size() - 1);\n            return g.adj[last][0];\n        }\n\n        int last = path.get(path.size() - 1);\n        for (int next = 1; next < g.n; next++) {\n            if (g.adj[last][next] && !visited[next]) {\n                visited[next] = true;\n                path.add(next);\n                if (circuitHelper(g, visited, path)) return true;\n                path.remove(path.size() - 1);\n                visited[next] = false;\n            }\n        }\n        return false;\n    }\n\n    public static void main(String[] args) {\n        // Complete graph K_5 (has Hamiltonian circuit)\n        Graph k5 = new Graph(5);\n        for (int i = 0; i < 5; i++)\n            for (int j = i + 1; j < 5; j++) k5.addEdge(i, j);\n\n        List<Integer> circuit = findHamiltonianCircuit(k5);\n        System.out.println(\"K_5 Hamiltonian circuit: \" + circuit);\n\n        // Petersen graph (has Hamiltonian path but no circuit)\n        Graph petersen = new Graph(10);\n        // Outer cycle\n        for (int i = 0; i < 5; i++) petersen.addEdge(i, (i+1)%5);\n        // Inner pentagram\n        for (int i = 0; i < 5; i++) petersen.addEdge(5+i, 5+(i+2)%5);\n        // Spokes\n        for (int i = 0; i < 5; i++) petersen.addEdge(i, 5+i);\n\n        List<Integer> petersenPath = findHamiltonianPath(petersen);\n        System.out.println(\"\\nPetersen graph Hamiltonian path: \" + petersenPath);\n        List<Integer> petersenCircuit = findHamiltonianCircuit(petersen);\n        System.out.println(\"Petersen graph Hamiltonian circuit: \" +\n            (petersenCircuit.isEmpty() ? \"NONE\" : petersenCircuit));\n\n        // Simple path graph (has Hamiltonian path, no circuit)\n        Graph path = new Graph(5);\n        path.addEdge(0,1); path.addEdge(1,2); path.addEdge(2,3); path.addEdge(3,4);\n        List<Integer> hp = findHamiltonianPath(path);\n        System.out.println(\"\\nPath graph P_5 Hamiltonian path: \" + hp);\n    }\n}"
