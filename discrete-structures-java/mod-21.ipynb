          "java",
          "public class EulerVsHamiltonian {\n    public static void main(String[] args) {\n        System.out.println(\"=== Euler Path/Circuit vs Hamiltonian Path/Circuit ===\");\n        System.out.println();\n        System.out.println(\"Feature         | Euler              | Hamiltonian\");\n        System.out.println(\"----------------+--------------------+--------------------\");\n        System.out.println(\"Visits          | Every EDGE once    | Every VERTEX once\");\n        System.out.println(\"Existence check | O(V) (degree check)| NP-complete\");\n        System.out.println(\"Finding path    | O(E) (Hierholzer)  | Exponential (backtrack)\");\n        System.out.println(\"Condition       | 0 or 2 odd-degree  | No simple condition\");\n        System.out.println(\"Circuit cond.   | All even degree    | Dirac/Ore sufficient\");\n        System.out.println(\"Origin          | Konigsberg 1736    | Hamilton 1857\");\n        System.out.println(\"Application     | Chinese Postman    | TSP, DNA assembly\");\n        System.out.println();\n        System.out.println(\"Key insight: Euler is EASY (P), Hamiltonian is HARD (NP-complete)\");\n    }\n}"
