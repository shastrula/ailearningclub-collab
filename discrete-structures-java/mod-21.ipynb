          "java",
          "import java.util.*;\n\npublic class HamiltonianConditions {\n\n    // Dirac's Theorem: If n >= 3 and every vertex has degree >= n/2,\n    // then the graph has a Hamiltonian circuit\n    public static boolean satisfiesDirac(int n, int[] degrees) {\n        if (n < 3) return false;\n        for (int d : degrees) {\n            if (d < n / 2.0) return false;\n        }\n        return true;\n    }\n\n    // Ore's Theorem: If n >= 3 and for every pair of non-adjacent vertices\n    // u, v: deg(u) + deg(v) >= n, then Hamiltonian circuit exists\n    public static boolean satisfiesOre(int n, int[] degrees, boolean[][] adj) {\n        if (n < 3) return false;\n        for (int u = 0; u < n; u++) {\n            for (int v = u + 1; v < n; v++) {\n                if (!adj[u][v]) { // non-adjacent pair\n                    if (degrees[u] + degrees[v] < n) return false;\n                }\n            }\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        // K_5: all degrees = 4, n=5, 4 >= 5/2 -> Dirac satisfied\n        int[] k5Degrees = {4, 4, 4, 4, 4};\n        System.out.println(\"K_5 satisfies Dirac: \" + satisfiesDirac(5, k5Degrees));\n\n        // C_5: all degrees = 2, n=5, 2 < 5/2 -> Dirac NOT satisfied\n        // (but C_5 still has a Hamiltonian circuit!)\n        int[] c5Degrees = {2, 2, 2, 2, 2};\n        System.out.println(\"C_5 satisfies Dirac: \" + satisfiesDirac(5, c5Degrees));\n        System.out.println(\"  (Dirac is sufficient, not necessary)\");\n\n        // Complete bipartite K_{3,3}: degrees all 3, n=6, 3 >= 3 -> Dirac satisfied\n        int[] k33Degrees = {3, 3, 3, 3, 3, 3};\n        System.out.println(\"K_{3,3} satisfies Dirac: \" + satisfiesDirac(6, k33Degrees));\n    }\n}"
