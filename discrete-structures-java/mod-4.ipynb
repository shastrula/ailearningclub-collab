          "java",
          "import java.util.*;\nimport java.util.function.*;\n\npublic class ExistentialQuantifier {\n\n    // There exists x in domain such that P(x)\n    public static <T> boolean exists(Collection<T> domain, Predicate<T> predicate) {\n        return domain.stream().anyMatch(predicate);\n    }\n\n    // Find a witness (the element satisfying the predicate)\n    public static <T> Optional<T> findWitness(Collection<T> domain, Predicate<T> predicate) {\n        return domain.stream().filter(predicate).findFirst();\n    }\n\n    public static void main(String[] args) {\n        List<Integer> numbers = List.of(1, 4, 9, 16, 25, 30, 36);\n\n        // There exists x in numbers such that x is a perfect square\n        boolean hasPerfectSquare = exists(numbers, x -> {\n            int sqrt = (int) Math.sqrt(x);\n            return sqrt * sqrt == x;\n        });\n        System.out.println(\"Has perfect square: \" + hasPerfectSquare); // true\n\n        // There exists an even prime\n        Set<Integer> primes = Set.of(2, 3, 5, 7, 11, 13, 17, 19);\n        boolean hasEvenPrime = exists(primes, x -> x % 2 == 0);\n        System.out.println(\"Exists even prime: \" + hasEvenPrime); // true\n\n        // Find the witness\n        Optional<Integer> evenPrime = findWitness(primes, x -> x % 2 == 0);\n        evenPrime.ifPresent(p -> System.out.println(\"Even prime witness: \" + p));\n\n        // There exists x > 100 in numbers (false)\n        boolean hasLarge = exists(numbers, x -> x > 100);\n        System.out.println(\"Exists x > 100: \" + hasLarge); // false\n    }\n}"
        ]
      ]
