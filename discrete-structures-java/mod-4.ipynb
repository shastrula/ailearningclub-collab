          "java",
          "import java.util.*;\nimport java.util.function.*;\n\npublic class QuantifierNegation {\n\n    public static <T> boolean forAll(Collection<T> domain, Predicate<T> p) {\n        return domain.stream().allMatch(p);\n    }\n\n    public static <T> boolean exists(Collection<T> domain, Predicate<T> p) {\n        return domain.stream().anyMatch(p);\n    }\n\n    public static void main(String[] args) {\n        List<Integer> numbers = List.of(2, 4, 6, 7, 8, 10);\n        Predicate<Integer> isEven = x -> x % 2 == 0;\n\n        // NOT (for all x, P(x)) == exists x such that NOT P(x)\n        boolean notForAll = !forAll(numbers, isEven);\n        boolean existsNot = exists(numbers, isEven.negate());\n        System.out.println(\"NOT(for all even): \" + notForAll);\n        System.out.println(\"Exists not even: \" + existsNot);\n        System.out.println(\"Equivalent: \" + (notForAll == existsNot)); // true\n\n        // NOT (exists x, P(x)) == for all x, NOT P(x)\n        Predicate<Integer> isNegative = x -> x < 0;\n        boolean notExists = !exists(numbers, isNegative);\n        boolean forAllNot = forAll(numbers, isNegative.negate());\n        System.out.println(\"\\nNOT(exists negative): \" + notExists);\n        System.out.println(\"For all non-negative: \" + forAllNot);\n        System.out.println(\"Equivalent: \" + (notExists == forAllNot)); // true\n    }\n}"
        ]
      ]
