          "java",
          "import java.util.*;\nimport java.util.function.*;\n\npublic class MultiVarPredicates {\n\n    @FunctionalInterface\n    interface BiPredicate<T, U> {\n        boolean test(T t, U u);\n    }\n\n    public static void main(String[] args) {\n        // Two-variable predicates\n        BiPredicate<Integer, Integer> divides = (d, n) -> n % d == 0;\n        BiPredicate<Integer, Integer> lessThan = (x, y) -> x < y;\n        BiPredicate<String, String> isSubstring = (s, t) -> t.contains(s);\n\n        System.out.println(\"3 divides 12: \" + divides.test(3, 12));  // true\n        System.out.println(\"3 divides 10: \" + divides.test(3, 10));  // false\n        System.out.println(\"5 < 8: \" + lessThan.test(5, 8));         // true\n        System.out.println(\"\\\"cat\\\" in \\\"concatenate\\\": \" + isSubstring.test(\"cat\", \"concatenate\"));\n\n        // Three-variable predicate: x + y = z\n        TriPredicate<Integer> sumEquals = (x, y, z) -> x + y == z;\n        System.out.println(\"3 + 4 = 7: \" + sumEquals.test(3, 4, 7)); // true\n    }\n\n    @FunctionalInterface\n    interface TriPredicate<T> {\n        boolean test(T a, T b, T c);\n    }\n}"
        ]
