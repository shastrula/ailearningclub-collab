          "java",
          "import java.util.*;\n\npublic class NestedQuantifiers {\n\n    // For all x, there exists y such that P(x, y)\n    public static boolean forAllExists(List<Integer> domainX, List<Integer> domainY,\n                                        java.util.function.BiPredicate<Integer, Integer> P) {\n        return domainX.stream().allMatch(x ->\n            domainY.stream().anyMatch(y -> P.test(x, y))\n        );\n    }\n\n    // There exists x such that for all y, P(x, y)\n    public static boolean existsForAll(List<Integer> domainX, List<Integer> domainY,\n                                        java.util.function.BiPredicate<Integer, Integer> P) {\n        return domainX.stream().anyMatch(x ->\n            domainY.stream().allMatch(y -> P.test(x, y))\n        );\n    }\n\n    public static void main(String[] args) {\n        List<Integer> domain = List.of(1, 2, 3, 4, 5);\n\n        // For all x, there exists y such that x + y == 6\n        boolean result1 = forAllExists(domain, domain, (x, y) -> x + y == 6);\n        System.out.println(\"For all x, exists y: x+y=6: \" + result1); // true\n\n        // There exists x such that for all y, x * y == y (identity element)\n        boolean result2 = existsForAll(domain, domain, (x, y) -> x * y == y);\n        System.out.println(\"Exists x, for all y: x*y=y: \" + result2); // true (x=1)\n\n        // For all x, there exists y such that y > x\n        boolean result3 = forAllExists(domain, domain, (x, y) -> y > x);\n        System.out.println(\"For all x, exists y > x: \" + result3); // false (x=5 has no y>5)\n\n        // Quantifier order matters!\n        // \"Exists y, for all x: x+y=6\" vs \"For all x, exists y: x+y=6\"\n        boolean result4 = existsForAll(domain, domain, (x, y) -> x + y == 6);\n        System.out.println(\"Exists y, for all x: x+y=6: \" + result4); // false\n    }\n}"
        ]
