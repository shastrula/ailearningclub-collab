          "java",
          "import java.util.*;\nimport java.util.function.*;\nimport java.util.stream.*;\n\npublic class PredicateBasics {\n\n    public static void main(String[] args) {\n        // Define predicates\n        Predicate<Integer> isEven = x -> x % 2 == 0;\n        Predicate<Integer> isPrime = PredicateBasics::checkPrime;\n        Predicate<Integer> isPositive = x -> x > 0;\n        Predicate<String> isLong = s -> s.length() > 5;\n\n        // Evaluate predicates on specific values\n        System.out.println(\"isEven(4) = \" + isEven.test(4));    // true\n        System.out.println(\"isEven(7) = \" + isEven.test(7));    // false\n        System.out.println(\"isPrime(11) = \" + isPrime.test(11)); // true\n        System.out.println(\"isLong(\\\"Hi\\\") = \" + isLong.test(\"Hi\")); // false\n\n        // Compound predicates using logical operations\n        Predicate<Integer> isEvenAndPrime = isEven.and(isPrime);\n        Predicate<Integer> isEvenOrPrime = isEven.or(isPrime);\n        Predicate<Integer> isNotEven = isEven.negate();\n\n        System.out.println(\"\\nisEvenAndPrime(2) = \" + isEvenAndPrime.test(2));  // true\n        System.out.println(\"isEvenAndPrime(4) = \" + isEvenAndPrime.test(4));    // false\n        System.out.println(\"isEvenOrPrime(9) = \" + isEvenOrPrime.test(9));      // false\n        System.out.println(\"isNotEven(7) = \" + isNotEven.test(7));              // true\n    }\n\n    private static boolean checkPrime(int n) {\n        if (n < 2) return false;\n        for (int i = 2; i <= Math.sqrt(n); i++) {\n            if (n % i == 0) return false;\n        }\n        return true;\n    }\n}"
        ]
