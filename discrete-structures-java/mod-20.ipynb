          "java",
          "import java.util.*;\n\npublic class KruskalMST {\n\n    static class Edge implements Comparable<Edge> {\n        int u, v, weight;\n        Edge(int u, int v, int weight) { this.u = u; this.v = v; this.weight = weight; }\n        @Override public int compareTo(Edge other) { return Integer.compare(weight, other.weight); }\n        @Override public String toString() { return u + \"-\" + v + \" (w=\" + weight + \")\"; }\n    }\n\n    // Union-Find for cycle detection\n    static class UnionFind {\n        int[] parent, rank;\n        UnionFind(int n) {\n            parent = new int[n]; rank = new int[n];\n            for (int i = 0; i < n; i++) parent[i] = i;\n        }\n        int find(int x) {\n            if (parent[x] != x) parent[x] = find(parent[x]);\n            return parent[x];\n        }\n        boolean union(int x, int y) {\n            int rx = find(x), ry = find(y);\n            if (rx == ry) return false;\n            if (rank[rx] < rank[ry]) parent[rx] = ry;\n            else if (rank[rx] > rank[ry]) parent[ry] = rx;\n            else { parent[ry] = rx; rank[rx]++; }\n            return true;\n        }\n    }\n\n    public static List<Edge> kruskal(int n, List<Edge> edges) {\n        Collections.sort(edges);\n        UnionFind uf = new UnionFind(n);\n        List<Edge> mst = new ArrayList<>();\n\n        for (Edge edge : edges) {\n            if (uf.union(edge.u, edge.v)) {\n                mst.add(edge);\n                if (mst.size() == n - 1) break;\n            }\n        }\n        return mst;\n    }\n\n    public static void main(String[] args) {\n        int n = 6;\n        List<Edge> edges = new ArrayList<>(List.of(\n            new Edge(0, 1, 4), new Edge(0, 2, 3),\n            new Edge(1, 2, 1), new Edge(1, 3, 2),\n            new Edge(2, 3, 4), new Edge(2, 4, 3),\n            new Edge(3, 4, 2), new Edge(3, 5, 1),\n            new Edge(4, 5, 6)\n        ));\n\n        List<Edge> mst = kruskal(n, edges);\n        int totalWeight = mst.stream().mapToInt(e -> e.weight).sum();\n\n        System.out.println(\"Kruskal's MST:\");\n        mst.forEach(e -> System.out.println(\"  \" + e));\n        System.out.println(\"Total weight: \" + totalWeight);\n        System.out.println(\"Edges in MST: \" + mst.size() + \" (should be \" + (n-1) + \")\");\n    }\n}"
        ]
