          "java",
          "import java.util.*;\n\npublic class PrimMST {\n\n    static class Edge {\n        int to, weight;\n        Edge(int to, int weight) { this.to = to; this.weight = weight; }\n    }\n\n    public static int prim(int n, List<List<Edge>> adj) {\n        boolean[] inMST = new boolean[n];\n        int[] key = new int[n]; // minimum weight edge to reach this vertex\n        int[] parent = new int[n];\n        Arrays.fill(key, Integer.MAX_VALUE);\n        Arrays.fill(parent, -1);\n\n        PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[1]));\n        key[0] = 0;\n        pq.offer(new int[]{0, 0});\n\n        int totalWeight = 0;\n        List<String> mstEdges = new ArrayList<>();\n\n        while (!pq.isEmpty()) {\n            int[] curr = pq.poll();\n            int u = curr[0];\n            if (inMST[u]) continue;\n\n            inMST[u] = true;\n            totalWeight += curr[1];\n            if (parent[u] != -1) {\n                mstEdges.add(parent[u] + \"-\" + u + \" (w=\" + curr[1] + \")\");\n            }\n\n            for (Edge edge : adj.get(u)) {\n                if (!inMST[edge.to] && edge.weight < key[edge.to]) {\n                    key[edge.to] = edge.weight;\n                    parent[edge.to] = u;\n                    pq.offer(new int[]{edge.to, edge.weight});\n                }\n            }\n        }\n\n        System.out.println(\"Prim's MST edges:\");\n        mstEdges.forEach(e -> System.out.println(\"  \" + e));\n        return totalWeight;\n    }\n\n    public static void main(String[] args) {\n        int n = 6;\n        List<List<Edge>> adj = new ArrayList<>();\n        for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n\n        int[][] edges = {{0,1,4},{0,2,3},{1,2,1},{1,3,2},{2,3,4},{2,4,3},{3,4,2},{3,5,1},{4,5,6}};\n        for (int[] e : edges) {\n            adj.get(e[0]).add(new Edge(e[1], e[2]));\n            adj.get(e[1]).add(new Edge(e[0], e[2]));\n        }\n\n        int totalWeight = prim(n, adj);\n        System.out.println(\"Total MST weight: \" + totalWeight);\n    }\n}"
