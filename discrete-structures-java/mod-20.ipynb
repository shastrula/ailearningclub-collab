          "java",
          "import java.util.*;\n\npublic class SpanningTree {\n\n    static class Edge {\n        int u, v;\n        Edge(int u, int v) { this.u = u; this.v = v; }\n        @Override public String toString() { return \"(\" + u + \",\" + v + \")\"; }\n    }\n\n    // Find spanning tree using DFS\n    public static List<Edge> dfsSpanningTree(List<List<Integer>> adj, int n) {\n        List<Edge> treeEdges = new ArrayList<>();\n        boolean[] visited = new boolean[n];\n        dfs(adj, 0, visited, treeEdges);\n        return treeEdges;\n    }\n\n    private static void dfs(List<List<Integer>> adj, int v,\n            boolean[] visited, List<Edge> treeEdges) {\n        visited[v] = true;\n        for (int neighbor : adj.get(v)) {\n            if (!visited[neighbor]) {\n                treeEdges.add(new Edge(v, neighbor));\n                dfs(adj, neighbor, visited, treeEdges);\n            }\n        }\n    }\n\n    // Find spanning tree using BFS\n    public static List<Edge> bfsSpanningTree(List<List<Integer>> adj, int n) {\n        List<Edge> treeEdges = new ArrayList<>();\n        boolean[] visited = new boolean[n];\n        Queue<Integer> queue = new LinkedList<>();\n\n        queue.offer(0);\n        visited[0] = true;\n\n        while (!queue.isEmpty()) {\n            int v = queue.poll();\n            for (int neighbor : adj.get(v)) {\n                if (!visited[neighbor]) {\n                    visited[neighbor] = true;\n                    treeEdges.add(new Edge(v, neighbor));\n                    queue.offer(neighbor);\n                }\n            }\n        }\n        return treeEdges;\n    }\n\n    public static void main(String[] args) {\n        int n = 6;\n        List<List<Integer>> adj = new ArrayList<>();\n        for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n        int[][] edges = {{0,1},{0,2},{1,2},{1,3},{2,4},{3,4},{3,5},{4,5}};\n        for (int[] e : edges) { adj.get(e[0]).add(e[1]); adj.get(e[1]).add(e[0]); }\n\n        System.out.println(\"Graph has \" + n + \" vertices and \" + edges.length + \" edges\");\n\n        List<Edge> dfsTree = dfsSpanningTree(adj, n);\n        System.out.println(\"\\nDFS Spanning Tree (\" + dfsTree.size() + \" edges):\");\n        dfsTree.forEach(e -> System.out.println(\"  \" + e));\n\n        List<Edge> bfsTree = bfsSpanningTree(adj, n);\n        System.out.println(\"\\nBFS Spanning Tree (\" + bfsTree.size() + \" edges):\");\n        bfsTree.forEach(e -> System.out.println(\"  \" + e));\n\n        System.out.println(\"\\nBoth have n-1 = \" + (n-1) + \" edges (tree property)\");\n    }\n}"
