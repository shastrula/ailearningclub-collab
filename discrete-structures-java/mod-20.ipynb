          "java",
          "import java.util.*;\n\npublic class TreeProperties {\n\n    static class Graph {\n        int n;\n        List<List<Integer>> adj;\n\n        Graph(int n) {\n            this.n = n;\n            adj = new ArrayList<>();\n            for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n        }\n\n        void addEdge(int u, int v) {\n            adj.get(u).add(v);\n            adj.get(v).add(u);\n        }\n\n        int edgeCount() {\n            return adj.stream().mapToInt(List::size).sum() / 2;\n        }\n    }\n\n    // A connected graph with n vertices is a tree iff it has n-1 edges\n    public static boolean isTree(Graph g) {\n        if (g.edgeCount() != g.n - 1) return false;\n        return isConnected(g);\n    }\n\n    public static boolean isConnected(Graph g) {\n        boolean[] visited = new boolean[g.n];\n        dfs(g, 0, visited);\n        for (boolean v : visited) if (!v) return false;\n        return true;\n    }\n\n    private static void dfs(Graph g, int v, boolean[] visited) {\n        visited[v] = true;\n        for (int neighbor : g.adj.get(v)) {\n            if (!visited[neighbor]) dfs(g, neighbor, visited);\n        }\n    }\n\n    // Find leaves (vertices of degree 1)\n    public static List<Integer> findLeaves(Graph g) {\n        List<Integer> leaves = new ArrayList<>();\n        for (int v = 0; v < g.n; v++) {\n            if (g.adj.get(v).size() == 1) leaves.add(v);\n        }\n        return leaves;\n    }\n\n    // Compute height of a rooted tree\n    public static int height(Graph g, int root) {\n        boolean[] visited = new boolean[g.n];\n        return heightDFS(g, root, visited);\n    }\n\n    private static int heightDFS(Graph g, int v, boolean[] visited) {\n        visited[v] = true;\n        int maxChildHeight = -1;\n        for (int child : g.adj.get(v)) {\n            if (!visited[child]) {\n                maxChildHeight = Math.max(maxChildHeight, heightDFS(g, child, visited));\n            }\n        }\n        return maxChildHeight + 1;\n    }\n\n    public static void main(String[] args) {\n        // Build a tree\n        Graph tree = new Graph(7);\n        tree.addEdge(0, 1); tree.addEdge(0, 2);\n        tree.addEdge(1, 3); tree.addEdge(1, 4);\n        tree.addEdge(2, 5); tree.addEdge(2, 6);\n\n        System.out.println(\"Tree properties:\");\n        System.out.println(\"  Vertices: \" + tree.n);\n        System.out.println(\"  Edges: \" + tree.edgeCount());\n        System.out.println(\"  Is tree: \" + isTree(tree));\n        System.out.println(\"  Leaves: \" + findLeaves(tree));\n        System.out.println(\"  Height (root=0): \" + height(tree, 0));\n\n        // Not a tree (has cycle)\n        Graph cyclic = new Graph(4);\n        cyclic.addEdge(0, 1); cyclic.addEdge(1, 2);\n        cyclic.addEdge(2, 3); cyclic.addEdge(3, 0);\n        System.out.println(\"\\nCycle graph:\");\n        System.out.println(\"  Is tree: \" + isTree(cyclic)); // false\n    }\n}"
        ]
