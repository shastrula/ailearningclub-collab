          "java",
          "import java.util.*;\n\npublic class CouponCollector {\n\n    // Expected number of coupons to collect all n types: n * H_n (harmonic)\n    public static double expectedCoupons(int n) {\n        double harmonic = 0;\n        for (int i = 1; i <= n; i++) {\n            harmonic += 1.0 / i;\n        }\n        return n * harmonic;\n    }\n\n    // Simulate coupon collector\n    public static double simulateCoupons(int n, int trials) {\n        Random rand = new Random(42);\n        long totalSteps = 0;\n        for (int t = 0; t < trials; t++) {\n            Set<Integer> collected = new HashSet<>();\n            int steps = 0;\n            while (collected.size() < n) {\n                collected.add(rand.nextInt(n));\n                steps++;\n            }\n            totalSteps += steps;\n        }\n        return (double) totalSteps / trials;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"Coupon Collector Problem:\");\n        System.out.println(\"  n  | E[steps] formula | E[steps] simulated\");\n        System.out.println(\"-----+------------------+-------------------\");\n        for (int n = 5; n <= 50; n += 5) {\n            double formula = expectedCoupons(n);\n            double simulated = simulateCoupons(n, 10000);\n            System.out.printf(\"  %2d | %10.2f       | %10.2f%n\", n, formula, simulated);\n        }\n\n        System.out.println(\"\\nApplication: How many random draws to see all outcomes?\");\n        System.out.println(\"  6-sided die (all faces): ~\" + String.format(\"%.1f\", expectedCoupons(6)) + \" rolls\");\n        System.out.println(\"  52 cards (unique): ~\" + String.format(\"%.1f\", expectedCoupons(52)) + \" draws with replacement\");\n    }\n}"
        ]
