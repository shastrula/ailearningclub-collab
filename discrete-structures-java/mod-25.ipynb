          "java",
          "import java.util.*;\n\npublic class ExpectedValue {\n\n    // Expected value: E[X] = sum of x * P(X = x) for all x\n    public static double expectedValue(Map<Integer, Double> distribution) {\n        return distribution.entrySet().stream()\n            .mapToDouble(e -> e.getKey() * e.getValue())\n            .sum();\n    }\n\n    // Variance: Var(X) = E[X^2] - (E[X])^2\n    public static double variance(Map<Integer, Double> distribution) {\n        double ex = expectedValue(distribution);\n        double ex2 = distribution.entrySet().stream()\n            .mapToDouble(e -> e.getKey() * e.getKey() * e.getValue())\n            .sum();\n        return ex2 - ex * ex;\n    }\n\n    public static void main(String[] args) {\n        // Fair die\n        Map<Integer, Double> fairDie = new HashMap<>();\n        for (int i = 1; i <= 6; i++) fairDie.put(i, 1.0/6);\n\n        System.out.println(\"Fair die:\");\n        System.out.println(\"  E[X] = \" + String.format(\"%.4f\", expectedValue(fairDie)));\n        System.out.println(\"  Var(X) = \" + String.format(\"%.4f\", variance(fairDie)));\n        System.out.println(\"  SD(X) = \" + String.format(\"%.4f\", Math.sqrt(variance(fairDie))));\n\n        // Sum of two dice\n        Map<Integer, Double> twoDice = new HashMap<>();\n        for (int sum = 2; sum <= 12; sum++) {\n            int ways = 0;\n            for (int d1 = 1; d1 <= 6; d1++) {\n                int d2 = sum - d1;\n                if (d2 >= 1 && d2 <= 6) ways++;\n            }\n            twoDice.put(sum, ways / 36.0);\n        }\n        System.out.println(\"\\nSum of two dice:\");\n        System.out.println(\"  E[X] = \" + String.format(\"%.4f\", expectedValue(twoDice)));\n        System.out.println(\"  Distribution:\");\n        twoDice.entrySet().stream().sorted(Map.Entry.comparingByKey())\n            .forEach(e -> System.out.printf(\"    P(sum=%2d) = %.4f%n\", e.getKey(), e.getValue()));\n\n        // Geometric distribution: expected flips to get heads\n        // E[X] = 1/p\n        double p = 0.5;\n        System.out.println(\"\\nGeometric (coin flips until heads, p=0.5):\");\n        System.out.println(\"  E[X] = 1/p = \" + (1.0/p));\n    }\n}"
        ]
