          "java",
          "public class AlgorithmExpectedValue {\n\n    // Quicksort average comparisons: E[C(n)] = 2n*H_n ~ 2n*ln(n)\n    public static double quicksortExpected(int n) {\n        double harmonic = 0;\n        for (int i = 1; i <= n; i++) harmonic += 1.0 / i;\n        return 2.0 * n * harmonic;\n    }\n\n    // Simulate average quicksort comparisons\n    static int comparisons;\n    public static void quicksort(int[] arr, int lo, int hi) {\n        if (lo >= hi) return;\n        int pivot = partition(arr, lo, hi);\n        quicksort(arr, lo, pivot - 1);\n        quicksort(arr, pivot + 1, hi);\n    }\n\n    private static int partition(int[] arr, int lo, int hi) {\n        int pivot = arr[hi];\n        int i = lo;\n        for (int j = lo; j < hi; j++) {\n            comparisons++;\n            if (arr[j] <= pivot) { int t = arr[i]; arr[i] = arr[j]; arr[j] = t; i++; }\n        }\n        int t = arr[i]; arr[i] = arr[hi]; arr[hi] = t;\n        return i;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"Quicksort expected comparisons:\");\n        Random rand = new Random();\n        for (int n : new int[]{10, 50, 100, 500, 1000}) {\n            double expected = quicksortExpected(n);\n            long totalComps = 0;\n            int trials = 100;\n            for (int t = 0; t < trials; t++) {\n                int[] arr = new int[n];\n                for (int i = 0; i < n; i++) arr[i] = rand.nextInt(10000);\n                comparisons = 0;\n                quicksort(arr, 0, n - 1);\n                totalComps += comparisons;\n            }\n            double avgComps = (double) totalComps / trials;\n            System.out.printf(\"  n=%4d: E[C]~%.0f, actual avg=%.0f, ratio=%.3f%n\",\n                n, expected, avgComps, avgComps / expected);\n        }\n    }\n}"
        ]
