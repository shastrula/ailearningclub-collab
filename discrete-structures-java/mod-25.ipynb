          "java",
          "import java.util.*;\nimport java.util.stream.*;\n\npublic class DiscreteProbability {\n\n    // Calculate probability of event from sample space (equally likely outcomes)\n    public static double probability(Set<?> sampleSpace, Set<?> event) {\n        return (double) event.size() / sampleSpace.size();\n    }\n\n    // Generate sample space for rolling two dice\n    public static Set<List<Integer>> twoDiceSampleSpace() {\n        Set<List<Integer>> space = new HashSet<>();\n        for (int d1 = 1; d1 <= 6; d1++) {\n            for (int d2 = 1; d2 <= 6; d2++) {\n                space.add(List.of(d1, d2));\n            }\n        }\n        return space;\n    }\n\n    public static void main(String[] args) {\n        Set<List<Integer>> S = twoDiceSampleSpace();\n        System.out.println(\"Two dice: |S| = \" + S.size());\n\n        // Event: sum equals 7\n        Set<List<Integer>> sumSeven = S.stream()\n            .filter(roll -> roll.get(0) + roll.get(1) == 7)\n            .collect(Collectors.toSet());\n        System.out.println(\"P(sum=7) = \" + sumSeven.size() + \"/36 = \" +\n            String.format(\"%.4f\", probability(S, sumSeven)));\n\n        // Event: both dice same (doubles)\n        Set<List<Integer>> doubles = S.stream()\n            .filter(roll -> roll.get(0).equals(roll.get(1)))\n            .collect(Collectors.toSet());\n        System.out.println(\"P(doubles) = \" + doubles.size() + \"/36 = \" +\n            String.format(\"%.4f\", probability(S, doubles)));\n\n        // Event: sum >= 10\n        Set<List<Integer>> highSum = S.stream()\n            .filter(roll -> roll.get(0) + roll.get(1) >= 10)\n            .collect(Collectors.toSet());\n        System.out.println(\"P(sum>=10) = \" + highSum.size() + \"/36 = \" +\n            String.format(\"%.4f\", probability(S, highSum)));\n\n        // Complement: P(A') = 1 - P(A)\n        System.out.println(\"P(sum<10) = 1 - \" + String.format(\"%.4f\", probability(S, highSum)) +\n            \" = \" + String.format(\"%.4f\", 1 - probability(S, highSum)));\n    }\n}"
        ]
      ]
