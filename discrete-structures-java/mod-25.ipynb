          "java",
          "import java.util.*;\n\npublic class BirthdayProblem {\n\n    // Exact probability that among n people, at least 2 share a birthday\n    public static double birthdayProbability(int n, int days) {\n        if (n > days) return 1.0;\n        double pNoMatch = 1.0;\n        for (int i = 1; i < n; i++) {\n            pNoMatch *= (double)(days - i) / days;\n        }\n        return 1.0 - pNoMatch;\n    }\n\n    // Simulate birthday problem\n    public static double birthdaySimulation(int n, int days, int trials) {\n        Random rand = new Random(42);\n        int matches = 0;\n        for (int t = 0; t < trials; t++) {\n            Set<Integer> birthdays = new HashSet<>();\n            boolean found = false;\n            for (int i = 0; i < n; i++) {\n                int birthday = rand.nextInt(days);\n                if (!birthdays.add(birthday)) { found = true; break; }\n            }\n            if (found) matches++;\n        }\n        return (double) matches / trials;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"Birthday Problem (365 days):\");\n        System.out.println(\"  n  | P(match) exact | P(match) simulated\");\n        System.out.println(\"-----+----------------+-------------------\");\n        for (int n = 5; n <= 60; n += 5) {\n            double exact = birthdayProbability(n, 365);\n            double simulated = birthdaySimulation(n, 365, 100000);\n            System.out.printf(\"  %2d | %.6f       | %.6f%n\", n, exact, simulated);\n        }\n\n        // Find threshold\n        for (int n = 1; n <= 100; n++) {\n            if (birthdayProbability(n, 365) >= 0.5) {\n                System.out.println(\"\\nFirst n with P >= 0.5: n = \" + n +\n                    \" (P = \" + String.format(\"%.4f\", birthdayProbability(n, 365)) + \")\");\n                break;\n            }\n        }\n\n        // Application: hash collision probability\n        System.out.println(\"\\nHash collision (birthday attack):\");\n        System.out.println(\"For hash with 2^k possible values, expect collision after ~2^(k/2) items\");\n        for (int bits : new int[]{16, 32, 64, 128, 256}) {\n            double collisionThreshold = Math.pow(2, bits / 2.0);\n            System.out.printf(\"  %3d-bit hash: collision likely after ~%.0e values%n\",\n                bits, collisionThreshold);\n        }\n    }\n}"
        ]
      ]
