          "java",
          "import java.util.*;\n\npublic class PlanarGraphs {\n\n    // Euler's formula: V - E + F = 2 (for connected planar graphs)\n    // Corollary: For simple planar graph with V >= 3: E <= 3V - 6\n    // For bipartite planar: E <= 2V - 4\n\n    public static boolean couldBePlanar(int V, int E) {\n        if (V < 3) return true;\n        return E <= 3 * V - 6;\n    }\n\n    public static boolean couldBePlanarBipartite(int V, int E) {\n        if (V < 3) return true;\n        return E <= 2 * V - 4;\n    }\n\n    // If graph has a K_5 or K_{3,3} minor/subdivision, it's not planar\n    // (Kuratowski's theorem - we just check the edge bound here)\n\n    public static void main(String[] args) {\n        System.out.println(\"Euler's Formula: V - E + F = 2\");\n        System.out.println();\n\n        // Verify for known planar graphs\n        System.out.println(\"Tetrahedron (K_4): V=4, E=6, F=4\");\n        System.out.println(\"  V-E+F = \" + (4 - 6 + 4) + \" (should be 2)\");\n\n        System.out.println(\"Cube: V=8, E=12, F=6\");\n        System.out.println(\"  V-E+F = \" + (8 - 12 + 6) + \" (should be 2)\");\n\n        System.out.println(\"Octahedron: V=6, E=12, F=8\");\n        System.out.println(\"  V-E+F = \" + (6 - 12 + 8) + \" (should be 2)\");\n\n        // Test planarity bound\n        System.out.println(\"\\nPlanarity test (E <= 3V - 6):\");\n        System.out.println(\"  K_4 (V=4, E=6): \" + couldBePlanar(4, 6) +\n            \" (bound: \" + (3*4-6) + \")\"); // PLANAR\n        System.out.println(\"  K_5 (V=5, E=10): \" + couldBePlanar(5, 10) +\n            \" (bound: \" + (3*5-6) + \")\"); // NOT PLANAR\n        System.out.println(\"  K_{3,3} (V=6, E=9): \" + couldBePlanar(6, 9) +\n            \" (bound: \" + (3*6-6) + \")\"); // passes edge test but still not planar!\n        System.out.println(\"  K_{3,3} bipartite test: \" + couldBePlanarBipartite(6, 9) +\n            \" (bound: \" + (2*6-4) + \")\"); // NOW correctly detected\n\n        // Number of faces given V and E (for planar)\n        System.out.println(\"\\nFaces = 2 - V + E:\");\n        int[][] planarGraphs = {{4,6}, {8,12}, {6,12}, {12,30}, {20,30}};\n        String[] names = {\"Tetrahedron\", \"Cube\", \"Octahedron\", \"Icosahedron\", \"Dodecahedron\"};\n        for (int i = 0; i < planarGraphs.length; i++) {\n            int V = planarGraphs[i][0], E = planarGraphs[i][1];\n            int F = 2 - V + E;\n            System.out.printf(\"  %s: V=%d, E=%d, F=%d%n\", names[i], V, E, F);\n        }\n    }\n}"
