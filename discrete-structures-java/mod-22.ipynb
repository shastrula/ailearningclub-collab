          "java",
          "import java.util.*;\n\npublic class OptimalColoring {\n\n    static class Graph {\n        int n;\n        List<Set<Integer>> adj;\n        Graph(int n) {\n            this.n = n;\n            adj = new ArrayList<>();\n            for (int i = 0; i < n; i++) adj.add(new HashSet<>());\n        }\n        void addEdge(int u, int v) { adj.get(u).add(v); adj.get(v).add(u); }\n    }\n\n    // Find chromatic number using backtracking\n    public static int chromaticNumber(Graph g) {\n        for (int k = 1; k <= g.n; k++) {\n            int[] color = new int[g.n];\n            Arrays.fill(color, -1);\n            if (canColor(g, color, 0, k)) {\n                return k;\n            }\n        }\n        return g.n;\n    }\n\n    private static boolean canColor(Graph g, int[] color, int vertex, int k) {\n        if (vertex == g.n) return true;\n\n        for (int c = 0; c < k; c++) {\n            if (isSafe(g, color, vertex, c)) {\n                color[vertex] = c;\n                if (canColor(g, color, vertex + 1, k)) return true;\n                color[vertex] = -1;\n            }\n        }\n        return false;\n    }\n\n    private static boolean isSafe(Graph g, int[] color, int vertex, int c) {\n        for (int neighbor : g.adj.get(vertex)) {\n            if (color[neighbor] == c) return false;\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        // K_4 (chromatic number = 4)\n        Graph k4 = new Graph(4);\n        for (int i = 0; i < 4; i++)\n            for (int j = i+1; j < 4; j++) k4.addEdge(i, j);\n        System.out.println(\"chi(K_4) = \" + chromaticNumber(k4));\n\n        // C_5 (chromatic number = 3, odd cycle)\n        Graph c5 = new Graph(5);\n        for (int i = 0; i < 5; i++) c5.addEdge(i, (i+1)%5);\n        System.out.println(\"chi(C_5) = \" + chromaticNumber(c5));\n\n        // C_6 (chromatic number = 2, even cycle)\n        Graph c6 = new Graph(6);\n        for (int i = 0; i < 6; i++) c6.addEdge(i, (i+1)%6);\n        System.out.println(\"chi(C_6) = \" + chromaticNumber(c6));\n\n        // Petersen graph (chromatic number = 3)\n        Graph petersen = new Graph(10);\n        for (int i = 0; i < 5; i++) petersen.addEdge(i, (i+1)%5);\n        for (int i = 0; i < 5; i++) petersen.addEdge(5+i, 5+(i+2)%5);\n        for (int i = 0; i < 5; i++) petersen.addEdge(i, 5+i);\n        System.out.println(\"chi(Petersen) = \" + chromaticNumber(petersen));\n\n        System.out.println(\"\\nChromatic number facts:\");\n        System.out.println(\"  chi(K_n) = n\");\n        System.out.println(\"  chi(C_n) = 2 if n even, 3 if n odd\");\n        System.out.println(\"  chi(tree) = 2 (bipartite)\");\n        System.out.println(\"  chi(planar graph) <= 4 (Four Color Theorem)\");\n    }\n}"
        ]
