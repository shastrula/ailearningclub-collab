          "java",
          "import java.util.*;\n\npublic class GraphColoring {\n\n    static class Graph {\n        int n;\n        List<Set<Integer>> adj;\n\n        Graph(int n) {\n            this.n = n;\n            adj = new ArrayList<>();\n            for (int i = 0; i < n; i++) adj.add(new HashSet<>());\n        }\n        void addEdge(int u, int v) { adj.get(u).add(v); adj.get(v).add(u); }\n    }\n\n    // Greedy coloring: assign smallest available color to each vertex\n    public static int[] greedyColoring(Graph g) {\n        int[] color = new int[g.n];\n        Arrays.fill(color, -1);\n\n        for (int v = 0; v < g.n; v++) {\n            // Find colors used by neighbors\n            Set<Integer> usedColors = new HashSet<>();\n            for (int neighbor : g.adj.get(v)) {\n                if (color[neighbor] != -1) {\n                    usedColors.add(color[neighbor]);\n                }\n            }\n            // Assign smallest available color\n            int c = 0;\n            while (usedColors.contains(c)) c++;\n            color[v] = c;\n        }\n        return color;\n    }\n\n    // Count colors used\n    public static int chromaticUpperBound(int[] coloring) {\n        return Arrays.stream(coloring).max().orElse(-1) + 1;\n    }\n\n    // Verify coloring is valid\n    public static boolean isValidColoring(Graph g, int[] color) {\n        for (int v = 0; v < g.n; v++) {\n            for (int neighbor : g.adj.get(v)) {\n                if (color[v] == color[neighbor]) return false;\n            }\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        // Petersen graph (chromatic number = 3)\n        Graph petersen = new Graph(10);\n        for (int i = 0; i < 5; i++) petersen.addEdge(i, (i+1)%5);\n        for (int i = 0; i < 5; i++) petersen.addEdge(5+i, 5+(i+2)%5);\n        for (int i = 0; i < 5; i++) petersen.addEdge(i, 5+i);\n\n        int[] coloring = greedyColoring(petersen);\n        System.out.println(\"Petersen graph coloring: \" + Arrays.toString(coloring));\n        System.out.println(\"Colors used: \" + chromaticUpperBound(coloring));\n        System.out.println(\"Valid: \" + isValidColoring(petersen, coloring));\n\n        // Cycle C_5 (odd cycle, needs 3 colors)\n        Graph c5 = new Graph(5);\n        for (int i = 0; i < 5; i++) c5.addEdge(i, (i+1)%5);\n        int[] c5Color = greedyColoring(c5);\n        System.out.println(\"\\nC_5 coloring: \" + Arrays.toString(c5Color));\n        System.out.println(\"Colors used: \" + chromaticUpperBound(c5Color));\n\n        // Bipartite graph (always 2-colorable)\n        Graph bipartite = new Graph(6);\n        bipartite.addEdge(0,3); bipartite.addEdge(0,4); bipartite.addEdge(0,5);\n        bipartite.addEdge(1,3); bipartite.addEdge(1,4);\n        bipartite.addEdge(2,4); bipartite.addEdge(2,5);\n        int[] biColor = greedyColoring(bipartite);\n        System.out.println(\"\\nBipartite coloring: \" + Arrays.toString(biColor));\n        System.out.println(\"Colors used: \" + chromaticUpperBound(biColor));\n    }\n}"
        ]
