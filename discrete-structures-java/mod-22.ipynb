          "java",
          "import java.util.*;\n\npublic class ExamScheduling {\n\n    // Model exam scheduling as graph coloring\n    // Vertices = exams, edges = conflicts (shared students)\n    // Colors = time slots\n\n    public static Map<String, Integer> scheduleExams(List<String> exams,\n            List<int[]> conflicts) {\n        int n = exams.size();\n        List<Set<Integer>> adj = new ArrayList<>();\n        for (int i = 0; i < n; i++) adj.add(new HashSet<>());\n        for (int[] conflict : conflicts) {\n            adj.get(conflict[0]).add(conflict[1]);\n            adj.get(conflict[1]).add(conflict[0]);\n        }\n\n        // Greedy coloring with degree-based ordering\n        Integer[] order = new Integer[n];\n        for (int i = 0; i < n; i++) order[i] = i;\n        Arrays.sort(order, (a, b) -> adj.get(b).size() - adj.get(a).size());\n\n        int[] color = new int[n];\n        Arrays.fill(color, -1);\n\n        for (int v : order) {\n            Set<Integer> used = new HashSet<>();\n            for (int nb : adj.get(v)) {\n                if (color[nb] != -1) used.add(color[nb]);\n            }\n            int c = 0;\n            while (used.contains(c)) c++;\n            color[v] = c;\n        }\n\n        Map<String, Integer> schedule = new LinkedHashMap<>();\n        for (int i = 0; i < n; i++) {\n            schedule.put(exams.get(i), color[i] + 1); // 1-based slots\n        }\n        return schedule;\n    }\n\n    public static void main(String[] args) {\n        List<String> exams = List.of(\"Math\", \"Physics\", \"CS\", \"English\", \"Chemistry\", \"History\");\n        // Conflicts: students share these pairs\n        List<int[]> conflicts = List.of(\n            new int[]{0, 1}, // Math-Physics\n            new int[]{0, 2}, // Math-CS\n            new int[]{1, 2}, // Physics-CS\n            new int[]{1, 4}, // Physics-Chemistry\n            new int[]{2, 3}, // CS-English\n            new int[]{3, 5}, // English-History\n            new int[]{4, 5}  // Chemistry-History\n        );\n\n        Map<String, Integer> schedule = scheduleExams(exams, conflicts);\n        int slots = schedule.values().stream().mapToInt(Integer::intValue).max().orElse(0);\n\n        System.out.println(\"Exam Schedule (\" + slots + \" time slots needed):\");\n        for (int slot = 1; slot <= slots; slot++) {\n            final int s = slot;\n            List<String> slotExams = schedule.entrySet().stream()\n                .filter(e -> e.getValue() == s)\n                .map(Map.Entry::getKey)\n                .toList();\n            System.out.println(\"  Slot \" + slot + \": \" + slotExams);\n        }\n    }\n}"
