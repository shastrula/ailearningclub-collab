          "java",
          "public class SumInduction {\n\n    // Theorem: 1 + 2 + ... + n = n(n+1)/2\n    public static void prove() {\n        System.out.println(\"Theorem: sum(1..n) = n(n+1)/2\");\n        System.out.println();\n\n        // Base case: n = 1\n        int baseSum = 1;\n        int baseFormula = 1 * 2 / 2;\n        System.out.println(\"Base case (n=1): sum = \" + baseSum +\n                          \", formula = \" + baseFormula +\n                          \", equal: \" + (baseSum == baseFormula));\n\n        // Inductive step: Assume sum(1..k) = k(k+1)/2\n        // Prove: sum(1..k+1) = (k+1)(k+2)/2\n        // Proof: sum(1..k+1) = sum(1..k) + (k+1) = k(k+1)/2 + (k+1)\n        //        = (k+1)(k/2 + 1) = (k+1)(k+2)/2\n        System.out.println(\"\\nInductive step verification:\");\n        for (int k = 1; k <= 20; k++) {\n            long sumK = (long) k * (k + 1) / 2;          // P(k) assumed true\n            long sumKPlus1 = sumK + (k + 1);              // add (k+1) to both sides\n            long formulaKPlus1 = (long)(k + 1) * (k + 2) / 2; // P(k+1) expected\n            boolean stepValid = sumKPlus1 == formulaKPlus1;\n            if (!stepValid) {\n                System.out.println(\"  FAILED at k=\" + k);\n                return;\n            }\n        }\n        System.out.println(\"  Verified for k=1..20: P(k) -> P(k+1)\");\n    }\n\n    public static void main(String[] args) {\n        prove();\n    }\n}"
        ]
