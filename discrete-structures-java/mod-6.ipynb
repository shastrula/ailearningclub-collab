          "java",
          "public class InductionRecursion {\n\n    // Recursive definition mirrors inductive proof\n    // Theorem: Fibonacci(n) < 2^n for all n >= 1\n    public static long fibonacci(int n) {\n        if (n <= 1) return n;\n        long a = 0, b = 1;\n        for (int i = 2; i <= n; i++) {\n            long temp = a + b;\n            a = b;\n            b = temp;\n        }\n        return b;\n    }\n\n    public static void proveFibBound() {\n        System.out.println(\"Theorem: fib(n) < 2^n for all n >= 1\");\n        System.out.println(\"Base cases:\");\n        System.out.println(\"  fib(1) = \" + fibonacci(1) + \" < \" + (1L << 1) + \" = 2^1: \" +\n            (fibonacci(1) < (1L << 1)));\n        System.out.println(\"  fib(2) = \" + fibonacci(2) + \" < \" + (1L << 2) + \" = 2^2: \" +\n            (fibonacci(2) < (1L << 2)));\n\n        boolean allValid = true;\n        for (int n = 1; n <= 50; n++) {\n            long fib = fibonacci(n);\n            long bound = 1L << n;\n            if (n < 63 && fib >= bound) {\n                System.out.println(\"  Failed at n=\" + n);\n                allValid = false;\n                break;\n            }\n        }\n        System.out.println(\"Verified for n=1..50: \" + allValid);\n    }\n\n    // Prove correctness of recursive power function by induction\n    // Base: power(x, 0) = 1 = x^0\n    // Step: power(x, n) = x * power(x, n-1) = x * x^(n-1) = x^n\n    public static long power(long x, int n) {\n        if (n == 0) return 1;           // base case\n        return x * power(x, n - 1);     // inductive step\n    }\n\n    public static void provePowerCorrect() {\n        System.out.println(\"\\nTheorem: power(x, n) = x^n\");\n        long x = 3;\n        for (int n = 0; n <= 10; n++) {\n            long recursive = power(x, n);\n            long expected = (long) Math.pow(x, n);\n            System.out.printf(\"  power(%d, %d) = %d, expected %d, match: %b%n\",\n                x, n, recursive, expected, recursive == expected);\n        }\n    }\n\n    public static void main(String[] args) {\n        proveFibBound();\n        provePowerCorrect();\n    }\n}"
        ]
