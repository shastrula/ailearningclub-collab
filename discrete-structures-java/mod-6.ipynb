          "java",
          "import java.util.*;\n\npublic class StructuralInduction {\n\n    // Binary tree node\n    static class TreeNode {\n        int value;\n        TreeNode left, right;\n        TreeNode(int v) { this.value = v; }\n        TreeNode(int v, TreeNode l, TreeNode r) { this.value = v; left = l; right = r; }\n    }\n\n    // Theorem: number of leaves <= (number of internal nodes) + 1\n    // Base: a single leaf has 1 leaf, 0 internal nodes. 1 <= 0 + 1. True.\n    // Step: if trees T1, T2 satisfy property, then tree(root, T1, T2) does too.\n\n    static int countLeaves(TreeNode node) {\n        if (node == null) return 0;\n        if (node.left == null && node.right == null) return 1;\n        return countLeaves(node.left) + countLeaves(node.right);\n    }\n\n    static int countInternal(TreeNode node) {\n        if (node == null) return 0;\n        if (node.left == null && node.right == null) return 0;\n        return 1 + countInternal(node.left) + countInternal(node.right);\n    }\n\n    static boolean verifyProperty(TreeNode node) {\n        int leaves = countLeaves(node);\n        int internal = countInternal(node);\n        return leaves <= internal + 1;\n    }\n\n    public static void main(String[] args) {\n        // Build various trees and verify\n        TreeNode leaf = new TreeNode(1);\n        TreeNode t1 = new TreeNode(1, new TreeNode(2), new TreeNode(3));\n        TreeNode t2 = new TreeNode(1, t1, new TreeNode(4, new TreeNode(5), new TreeNode(6)));\n\n        System.out.println(\"Leaf only - leaves=\" + countLeaves(leaf) +\n            \" internal=\" + countInternal(leaf) + \" valid=\" + verifyProperty(leaf));\n        System.out.println(\"Tree t1 - leaves=\" + countLeaves(t1) +\n            \" internal=\" + countInternal(t1) + \" valid=\" + verifyProperty(t1));\n        System.out.println(\"Tree t2 - leaves=\" + countLeaves(t2) +\n            \" internal=\" + countInternal(t2) + \" valid=\" + verifyProperty(t2));\n    }\n}"
