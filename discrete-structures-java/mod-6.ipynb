          "java",
          "public class StrongInduction {\n\n    // Theorem: Every integer n >= 2 can be written as a product of primes\n    // Proof by strong induction:\n    // Base: 2 is prime (product of one prime)\n    // Inductive: Assume all integers 2..k have prime factorizations.\n    //   If k+1 is prime, done. If composite, k+1 = a*b where 2 <= a,b <= k.\n    //   By inductive hypothesis, a and b have prime factorizations.\n    //   Therefore k+1 = (factorization of a) * (factorization of b).\n\n    public static List<Integer> primeFactorization(int n) {\n        List<Integer> factors = new java.util.ArrayList<>();\n        for (int d = 2; d * d <= n; d++) {\n            while (n % d == 0) {\n                factors.add(d);\n                n /= d;\n            }\n        }\n        if (n > 1) factors.add(n);\n        return factors;\n    }\n\n    public static boolean verifyFundamentalTheorem(int limit) {\n        for (int n = 2; n <= limit; n++) {\n            List<Integer> factors = primeFactorization(n);\n\n            // Verify all factors are prime\n            for (int f : factors) {\n                if (!isPrime(f)) return false;\n            }\n\n            // Verify product equals n\n            int product = 1;\n            for (int f : factors) product *= f;\n            if (product != n) return false;\n        }\n        return true;\n    }\n\n    private static boolean isPrime(int n) {\n        if (n < 2) return false;\n        for (int i = 2; i <= Math.sqrt(n); i++) {\n            if (n % i == 0) return false;\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"Fundamental Theorem of Arithmetic verification:\");\n        System.out.println(\"Every n>=2 has prime factorization: \" +\n            verifyFundamentalTheorem(1000));\n\n        // Show some factorizations\n        int[] examples = {12, 30, 97, 100, 360};\n        for (int n : examples) {\n            System.out.println(n + \" = \" + primeFactorization(n));\n        }\n    }\n}"
        ]
