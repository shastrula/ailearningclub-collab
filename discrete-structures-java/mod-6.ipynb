          "java",
          "public class SumOfSquares {\n\n    // Theorem: 1^2 + 2^2 + ... + n^2 = n(n+1)(2n+1)/6\n    public static long computeSum(int n) {\n        long sum = 0;\n        for (int i = 1; i <= n; i++) {\n            sum += (long) i * i;\n        }\n        return sum;\n    }\n\n    public static long formula(int n) {\n        return (long) n * (n + 1) * (2 * n + 1) / 6;\n    }\n\n    public static void prove() {\n        System.out.println(\"Theorem: 1^2 + 2^2 + ... + n^2 = n(n+1)(2n+1)/6\");\n\n        // Base case\n        assert computeSum(1) == formula(1) : \"Base case failed\";\n        System.out.println(\"Base case: \" + computeSum(1) + \" = \" + formula(1));\n\n        // Inductive step: sum(k) + (k+1)^2 should equal formula(k+1)\n        boolean allValid = true;\n        for (int k = 1; k <= 100; k++) {\n            long left = formula(k) + (long)(k + 1) * (k + 1);\n            long right = formula(k + 1);\n            if (left != right) {\n                System.out.println(\"Failed at k=\" + k);\n                allValid = false;\n                break;\n            }\n        }\n        System.out.println(\"Inductive step verified: \" + allValid);\n    }\n\n    public static void main(String[] args) {\n        prove();\n    }\n}"
