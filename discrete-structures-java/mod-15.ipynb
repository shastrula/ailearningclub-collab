          "java",
          "import java.util.*;\n\npublic class ConstrainedCounting {\n\n    // Count integers from 1 to n not divisible by any prime in the list\n    // Uses inclusion-exclusion (Euler's totient generalization)\n    public static long countNotDivisible(int n, List<Integer> primes) {\n        int k = primes.size();\n        long count = 0;\n\n        // Inclusion-exclusion over all subsets of primes\n        for (int mask = 0; mask < (1 << k); mask++) {\n            long product = 1;\n            int bits = Integer.bitCount(mask);\n            for (int i = 0; i < k; i++) {\n                if ((mask & (1 << i)) != 0) {\n                    product *= primes.get(i);\n                }\n            }\n            long multiples = n / product;\n            if (bits % 2 == 0) {\n                count += multiples;\n            } else {\n                count -= multiples;\n            }\n        }\n        return count;\n    }\n\n    // Euler's totient function: count of numbers 1..n coprime to n\n    public static int eulerTotient(int n) {\n        int result = n;\n        for (int p = 2; p * p <= n; p++) {\n            if (n % p == 0) {\n                while (n % p == 0) n /= p;\n                result -= result / p;\n            }\n        }\n        if (n > 1) result -= result / n;\n        return result;\n    }\n\n    public static void main(String[] args) {\n        // How many integers 1..100 are not divisible by 2, 3, or 5?\n        long notDiv = countNotDivisible(100, List.of(2, 3, 5));\n        System.out.println(\"Integers 1..100 not divisible by 2, 3, or 5: \" + notDiv);\n\n        // Verify by direct count\n        long direct = 0;\n        for (int i = 1; i <= 100; i++) {\n            if (i % 2 != 0 && i % 3 != 0 && i % 5 != 0) direct++;\n        }\n        System.out.println(\"Direct count: \" + direct);\n\n        // Euler's totient\n        System.out.println(\"\\nEuler's totient phi(n):\");\n        for (int n : new int[]{1, 2, 6, 8, 12, 15, 20, 30}) {\n            System.out.printf(\"  phi(%d) = %d%n\", n, eulerTotient(n));\n        }\n\n        // Surjective function count using inclusion-exclusion\n        // Number of onto functions from m elements to n elements\n        System.out.println(\"\\nSurjective functions |A|->|B|:\");\n        for (int m = 3; m <= 5; m++) {\n            for (int n = 2; n <= Math.min(m, 4); n++) {\n                long count = countSurjections(m, n);\n                System.out.printf(\"  f: %d -> %d: %d surjections%n\", m, n, count);\n            }\n        }\n    }\n\n    static long countSurjections(int m, int n) {\n        long total = 0;\n        for (int k = 0; k <= n; k++) {\n            long sign = (k % 2 == 0) ? 1 : -1;\n            long choose = combinationCount(n, k);\n            long maps = (long) Math.pow(n - k, m);\n            total += sign * choose * maps;\n        }\n        return total;\n    }\n\n    static long combinationCount(int n, int r) {\n        if (r > n) return 0;\n        r = Math.min(r, n - r);\n        long result = 1;\n        for (int i = 0; i < r; i++) result = result * (n - i) / (i + 1);\n        return result;\n    }\n}"
