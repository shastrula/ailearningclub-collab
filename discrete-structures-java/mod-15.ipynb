          "java",
          "import java.util.*;\n\npublic class Derangements {\n\n    // Count derangements using the formula:\n    // D(n) = n! * sum_{i=0}^{n} (-1)^i / i!\n    public static long countDerangements(int n) {\n        long nFactorial = factorial(n);\n        double sum = 0;\n        for (int i = 0; i <= n; i++) {\n            sum += Math.pow(-1, i) / factorial(i);\n        }\n        return Math.round(nFactorial * sum);\n    }\n\n    // Recursive formula: D(n) = (n-1) * (D(n-1) + D(n-2))\n    public static long countDerangementsRecursive(int n) {\n        if (n == 0) return 1;\n        if (n == 1) return 0;\n        long[] dp = new long[n + 1];\n        dp[0] = 1;\n        dp[1] = 0;\n        for (int i = 2; i <= n; i++) {\n            dp[i] = (i - 1) * (dp[i - 1] + dp[i - 2]);\n        }\n        return dp[n];\n    }\n\n    // Generate all derangements\n    public static List<List<Integer>> generateDerangements(int n) {\n        List<Integer> original = new ArrayList<>();\n        for (int i = 0; i < n; i++) original.add(i);\n\n        List<List<Integer>> result = new ArrayList<>();\n        permute(original, 0, result, n);\n        return result;\n    }\n\n    private static void permute(List<Integer> perm, int idx,\n            List<List<Integer>> result, int n) {\n        if (idx == n) {\n            // Check if it's a derangement\n            boolean isDerangement = true;\n            for (int i = 0; i < n; i++) {\n                if (perm.get(i) == i) { isDerangement = false; break; }\n            }\n            if (isDerangement) result.add(new ArrayList<>(perm));\n            return;\n        }\n        for (int i = idx; i < n; i++) {\n            Collections.swap(perm, idx, i);\n            permute(perm, idx + 1, result, n);\n            Collections.swap(perm, idx, i);\n        }\n    }\n\n    static long factorial(int n) {\n        long r = 1; for (int i = 2; i <= n; i++) r *= i; return r;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"Derangement counts:\");\n        for (int n = 0; n <= 10; n++) {\n            long d = countDerangementsRecursive(n);\n            double ratio = (n > 0) ? (double) d / factorial(n) : 1.0;\n            System.out.printf(\"  D(%2d) = %8d  (ratio to n!: %.6f)%n\", n, d, ratio);\n        }\n        // Ratio approaches 1/e = 0.367879...\n        System.out.println(\"  1/e = \" + (1.0 / Math.E));\n\n        // Show derangements of {0,1,2,3}\n        List<List<Integer>> derangementsOf4 = generateDerangements(4);\n        System.out.println(\"\\nDerangements of {0,1,2,3}: \" + derangementsOf4.size());\n        derangementsOf4.forEach(d -> System.out.println(\"  \" + d));\n    }\n}"
        ]
