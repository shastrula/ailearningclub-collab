          "java",
          "import java.util.*;\nimport java.util.stream.*;\n\npublic class PigeonholePrinciple {\n\n    // Demonstrate: assign items to bins, show a collision must exist\n    public static <T, B> Map<B, List<T>> assignToBins(List<T> items,\n            java.util.function.Function<T, B> binFunction) {\n        Map<B, List<T>> bins = new HashMap<>();\n        for (T item : items) {\n            B bin = binFunction.apply(item);\n            bins.computeIfAbsent(bin, k -> new ArrayList<>()).add(item);\n        }\n        return bins;\n    }\n\n    public static <T, B> void demonstratePigeonhole(List<T> items,\n            java.util.function.Function<T, B> binFunction, String description) {\n        Map<B, List<T>> bins = assignToBins(items, binFunction);\n        int maxInBin = bins.values().stream().mapToInt(List::size).max().orElse(0);\n\n        System.out.println(description);\n        System.out.println(\"  Items: \" + items.size());\n        System.out.println(\"  Bins: \" + bins.size());\n        System.out.println(\"  Max in one bin: \" + maxInBin);\n        System.out.println(\"  Pigeonhole guarantees >= \" +\n            ((items.size() - 1) / bins.size() + 1) + \" in some bin\");\n\n        // Show the fullest bin\n        bins.entrySet().stream()\n            .filter(e -> e.getValue().size() == maxInBin)\n            .findFirst()\n            .ifPresent(e -> System.out.println(\"  Fullest bin \" + e.getKey() + \": \" + e.getValue()));\n        System.out.println();\n    }\n\n    public static void main(String[] args) {\n        // 13 people must share birthday months (12 months)\n        List<String> people = List.of(\"Alice\", \"Bob\", \"Carol\", \"Dave\", \"Eve\",\n            \"Frank\", \"Grace\", \"Heidi\", \"Ivan\", \"Judy\", \"Karl\", \"Lily\", \"Mike\");\n        Random rand = new Random(42);\n        List<Integer> birthMonths = people.stream()\n            .map(p -> rand.nextInt(12) + 1).toList();\n        demonstratePigeonhole(birthMonths, m -> m, \"13 people into 12 months\");\n\n        // 27 English words must have at least 2 starting with same letter\n        List<String> words = List.of(\"apple\", \"banana\", \"cat\", \"dog\", \"elephant\",\n            \"fish\", \"grape\", \"house\", \"ice\", \"jam\", \"kite\", \"lemon\", \"moon\",\n            \"nest\", \"orange\", \"pen\", \"queen\", \"rain\", \"sun\", \"tree\",\n            \"umbrella\", \"vine\", \"water\", \"xray\", \"yard\", \"zebra\", \"avocado\");\n        demonstratePigeonhole(words, w -> w.charAt(0), \"27 words into 26 first-letter bins\");\n\n        // Among any 5 integers, at least 2 have same remainder mod 4\n        List<Integer> numbers = List.of(7, 12, 23, 34, 45);\n        demonstratePigeonhole(numbers, n -> n % 4, \"5 integers mod 4 (4 bins)\");\n    }\n}"
        ]
