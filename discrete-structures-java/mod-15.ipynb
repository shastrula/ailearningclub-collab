          "java",
          "import java.util.*;\n\npublic class GeneralizedPigeonhole {\n\n    // Ceiling of N/k\n    public static int minInSomeBin(int items, int bins) {\n        return (items - 1) / bins + 1; // equivalent to ceil(N/k)\n    }\n\n    public static void main(String[] args) {\n        // How many students needed to guarantee 4 share a birthday month?\n        // Need (4-1)*12 + 1 = 37 students\n        int months = 12;\n        int target = 4;\n        int studentsNeeded = (target - 1) * months + 1;\n        System.out.println(\"Students needed for \" + target + \" sharing a month: \" + studentsNeeded);\n\n        // Verify: with 37 students in 12 months, at least ceil(37/12) = 4 share a month\n        System.out.println(\"Minimum in some bin: \" + minInSomeBin(37, 12));\n\n        // In a deck of 52 cards, draw 5: must have at least 2 of same suit\n        System.out.println(\"\\n5 cards from 52: at least \" + minInSomeBin(5, 4) + \" of same suit\");\n\n        // Socks in a drawer: 10 pairs of different colors\n        // Pull out 11 to guarantee a matching pair\n        System.out.println(\"11 socks from 10 colors: at least \" +\n            minInSomeBin(11, 10) + \" of same color\");\n\n        // Application: hash collisions are inevitable\n        System.out.println(\"\\nHash collision inevitability:\");\n        int hashBuckets = 1000;\n        for (int items : new int[]{1001, 2000, 5000}) {\n            int minCollisions = minInSomeBin(items, hashBuckets);\n            System.out.printf(\"  %d items in %d buckets: at least %d in some bucket%n\",\n                items, hashBuckets, minCollisions);\n        }\n    }\n}"
        ]
