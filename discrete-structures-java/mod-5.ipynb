          "java",
          "import java.util.*;\n\npublic class RulesOfInference {\n\n    // Modus Ponens: p, p -> q, therefore q\n    public static Optional<Boolean> modusPonens(boolean p, boolean pImpliesQ) {\n        if (p && pImpliesQ) {\n            return Optional.of(true); // q must be true\n        }\n        return Optional.empty(); // cannot conclude\n    }\n\n    // Modus Tollens: NOT q, p -> q, therefore NOT p\n    public static Optional<Boolean> modusTollens(boolean notQ, boolean pImpliesQ) {\n        if (notQ && pImpliesQ) {\n            return Optional.of(true); // NOT p must be true\n        }\n        return Optional.empty();\n    }\n\n    // Hypothetical Syllogism: p -> q, q -> r, therefore p -> r\n    public static boolean hypotheticalSyllogism(boolean p, boolean q, boolean r) {\n        boolean pImpliesQ = !p || q;\n        boolean qImpliesR = !q || r;\n        boolean pImpliesR = !p || r;\n        // If both premises hold, conclusion must hold\n        return (!pImpliesQ || !qImpliesR) || pImpliesR;\n    }\n\n    // Disjunctive Syllogism: p OR q, NOT p, therefore q\n    public static Optional<Boolean> disjunctiveSyllogism(boolean pOrQ, boolean notP) {\n        if (pOrQ && notP) {\n            return Optional.of(true); // q must be true\n        }\n        return Optional.empty();\n    }\n\n    public static void main(String[] args) {\n        // Example: \"If it rains, the ground is wet. It rains. Therefore ground is wet.\"\n        boolean itRains = true;\n        boolean rainImpliesWet = true;\n        Optional<Boolean> groundWet = modusPonens(itRains, rainImpliesWet);\n        System.out.println(\"Ground is wet: \" + groundWet.orElse(false));\n\n        // Modus Tollens: \"If it rains, ground is wet. Ground is NOT wet. Therefore NOT raining.\"\n        boolean groundNotWet = true;\n        Optional<Boolean> notRaining = modusTollens(groundNotWet, rainImpliesWet);\n        System.out.println(\"Not raining: \" + notRaining.orElse(false));\n    }\n}"
        ]
