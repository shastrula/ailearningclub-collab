          "java",
          "public class ProofByContrapositive {\n\n    // Theorem: If n^2 is even, then n is even\n    // Contrapositive: If n is odd, then n^2 is odd\n    public static boolean proveByContrapositive(int n) {\n        // Proving the contrapositive: odd n -> odd n^2\n        if (n % 2 != 0) { // n is odd\n            int nSquared = n * n;\n            return nSquared % 2 != 0; // n^2 should be odd\n        }\n        return true; // not applicable (n is even)\n    }\n\n    // Theorem: If x + y >= 2, then x >= 1 or y >= 1\n    // Contrapositive: If x < 1 and y < 1, then x + y < 2\n    public static boolean proveContrapositive2(int x, int y) {\n        if (x < 1 && y < 1) {\n            return (x + y) < 2;\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"If n^2 is even then n is even (via contrapositive):\");\n        boolean allValid = true;\n        for (int n = -100; n <= 100; n++) {\n            if (!proveByContrapositive(n)) {\n                allValid = false;\n                break;\n            }\n        }\n        System.out.println(\"  Verified for n in [-100, 100]: \" + allValid);\n    }\n}"
