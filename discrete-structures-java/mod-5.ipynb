          "java",
          "public class DirectProof {\n\n    // Theorem: The sum of two even numbers is even\n    // Proof: Let a = 2m, b = 2n. Then a + b = 2m + 2n = 2(m+n), which is even.\n    public static boolean proveSumOfEvens(int a, int b) {\n        // Assume a and b are even (precondition)\n        assert a % 2 == 0 : \"a must be even\";\n        assert b % 2 == 0 : \"b must be even\";\n\n        int sum = a + b;\n\n        // The sum must be even (postcondition)\n        boolean result = sum % 2 == 0;\n        assert result : \"Sum of two evens must be even\";\n        return result;\n    }\n\n    // Theorem: The product of two odd numbers is odd\n    // Proof: Let a = 2m+1, b = 2n+1. Then a*b = 4mn + 2m + 2n + 1 = 2(2mn+m+n) + 1, odd.\n    public static boolean proveProductOfOdds(int a, int b) {\n        assert a % 2 != 0 : \"a must be odd\";\n        assert b % 2 != 0 : \"b must be odd\";\n\n        int product = a * b;\n        boolean result = product % 2 != 0;\n        assert result : \"Product of two odds must be odd\";\n        return result;\n    }\n\n    public static void main(String[] args) {\n        // Verify with multiple test cases\n        System.out.println(\"Sum of evens is even:\");\n        for (int i = 0; i <= 10; i += 2) {\n            for (int j = 0; j <= 10; j += 2) {\n                assert proveSumOfEvens(i, j);\n            }\n        }\n        System.out.println(\"  Verified for all even pairs 0-10\");\n\n        System.out.println(\"Product of odds is odd:\");\n        for (int i = 1; i <= 11; i += 2) {\n            for (int j = 1; j <= 11; j += 2) {\n                assert proveProductOfOdds(i, j);\n            }\n        }\n        System.out.println(\"  Verified for all odd pairs 1-11\");\n    }\n}"
        ]
