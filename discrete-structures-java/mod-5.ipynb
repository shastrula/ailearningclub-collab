          "java",
          "public class ProofByContradiction {\n\n    // Theorem: sqrt(2) is irrational\n    // Proof: Assume sqrt(2) = p/q in lowest terms. Then 2q^2 = p^2.\n    // This means p is even, so p = 2k. Then 2q^2 = 4k^2, so q^2 = 2k^2.\n    // Then q is also even. Contradiction: p/q is not in lowest terms.\n    public static boolean demonstrateIrrationality() {\n        // We show no fraction p/q can exactly equal sqrt(2)\n        // by checking that for any candidate, the equality fails\n        int limit = 1000;\n        for (int q = 1; q <= limit; q++) {\n            for (int p = 1; p <= 2 * q; p++) {\n                if (gcd(p, q) == 1) { // in lowest terms\n                    // If sqrt(2) = p/q then 2*q*q = p*p\n                    if (2 * q * q == p * p) {\n                        return false; // would disprove theorem\n                    }\n                }\n            }\n        }\n        return true; // no rational representation found\n    }\n\n    // Theorem: There are infinitely many primes\n    // Proof sketch: Assume finitely many primes p1...pn.\n    // Consider N = p1*p2*...*pn + 1. N is not divisible by any pi. Contradiction.\n    public static boolean demonstrateInfinitePrimes(int assumedCount) {\n        List<Integer> primes = new java.util.ArrayList<>();\n        primes.add(2);\n        for (int n = 3; primes.size() < assumedCount; n += 2) {\n            if (isPrime(n)) primes.add(n);\n        }\n\n        // Construct N = product of all primes + 1\n        long product = 1;\n        for (int p : primes) product *= p;\n        long N = product + 1;\n\n        // N is either prime itself or has a prime factor not in our list\n        boolean divisibleByListed = primes.stream().anyMatch(p -> N % p == 0);\n        System.out.println(\"  Assumed primes: \" + primes);\n        System.out.println(\"  N = product + 1 = \" + N);\n        System.out.println(\"  Divisible by listed prime: \" + divisibleByListed);\n        // This is always false - contradiction!\n        return !divisibleByListed;\n    }\n\n    private static boolean isPrime(int n) {\n        if (n < 2) return false;\n        for (int i = 2; i <= Math.sqrt(n); i++) {\n            if (n % i == 0) return false;\n        }\n        return true;\n    }\n\n    private static int gcd(int a, int b) {\n        while (b != 0) { int t = b; b = a % b; a = t; }\n        return a;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"sqrt(2) irrationality check: \" + demonstrateIrrationality());\n        System.out.println(\"\\nInfinite primes contradiction:\");\n        System.out.println(\"Result: \" + demonstrateInfinitePrimes(5));\n    }\n}"
        ]
