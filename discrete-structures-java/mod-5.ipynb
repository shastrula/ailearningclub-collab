          "java",
          "import java.util.*;\n\npublic class ProofVerifier {\n\n    enum Rule {\n        PREMISE, MODUS_PONENS, MODUS_TOLLENS,\n        HYPOTHETICAL_SYLLOGISM, DISJUNCTIVE_SYLLOGISM,\n        ADDITION, SIMPLIFICATION, CONJUNCTION, RESOLUTION\n    }\n\n    record ProofStep(String statement, Rule rule, int[] references) {}\n\n    private List<ProofStep> steps = new ArrayList<>();\n    private Map<String, Boolean> truthValues = new HashMap<>();\n\n    public void addPremise(String statement, boolean value) {\n        steps.add(new ProofStep(statement, Rule.PREMISE, new int[]{}));\n        truthValues.put(statement, value);\n    }\n\n    public boolean applyModusPonens(String p, String pImpliesQ, String q) {\n        Boolean pVal = truthValues.get(p);\n        Boolean implVal = truthValues.get(pImpliesQ);\n        if (pVal != null && pVal && implVal != null && implVal) {\n            truthValues.put(q, true);\n            steps.add(new ProofStep(q, Rule.MODUS_PONENS,\n                new int[]{indexOf(p), indexOf(pImpliesQ)}));\n            return true;\n        }\n        return false;\n    }\n\n    public boolean applySimplification(String pAndQ, String p) {\n        Boolean val = truthValues.get(pAndQ);\n        if (val != null && val) {\n            truthValues.put(p, true);\n            steps.add(new ProofStep(p, Rule.SIMPLIFICATION,\n                new int[]{indexOf(pAndQ)}));\n            return true;\n        }\n        return false;\n    }\n\n    private int indexOf(String statement) {\n        for (int i = 0; i < steps.size(); i++) {\n            if (steps.get(i).statement.equals(statement)) return i + 1;\n        }\n        return -1;\n    }\n\n    public void printProof() {\n        System.out.println(\"Proof:\");\n        System.out.println(\"=\".repeat(50));\n        for (int i = 0; i < steps.size(); i++) {\n            ProofStep step = steps.get(i);\n            String refs = step.references.length > 0 ?\n                \" [from \" + Arrays.toString(step.references) + \"]\" : \"\";\n            System.out.printf(\"%d. %-30s %s%s%n\",\n                i + 1, step.statement, step.rule, refs);\n        }\n    }\n\n    public static void main(String[] args) {\n        ProofVerifier proof = new ProofVerifier();\n\n        // Prove: Given \"It rains\", \"Rain -> Wet\", \"Wet -> Slippery\"\n        // Conclude: \"Slippery\"\n        proof.addPremise(\"It rains\", true);\n        proof.addPremise(\"Rain -> Wet\", true);\n        proof.addPremise(\"Wet -> Slippery\", true);\n\n        proof.applyModusPonens(\"It rains\", \"Rain -> Wet\", \"Wet\");\n        proof.applyModusPonens(\"Wet\", \"Wet -> Slippery\", \"Slippery\");\n\n        proof.printProof();\n    }\n}"
