          "java",
          "import java.math.BigInteger;\nimport java.util.function.*;\n\npublic class Products {\n\n    // Product of sequence terms\n    public static long product(IntUnaryOperator term, int from, int to) {\n        long result = 1;\n        for (int i = from; i <= to; i++) {\n            result *= term.applyAsInt(i);\n        }\n        return result;\n    }\n\n    // Factorial using BigInteger for large values\n    public static BigInteger factorial(int n) {\n        BigInteger result = BigInteger.ONE;\n        for (int i = 2; i <= n; i++) {\n            result = result.multiply(BigInteger.valueOf(i));\n        }\n        return result;\n    }\n\n    // Stirling's approximation: n! ~ sqrt(2*pi*n) * (n/e)^n\n    public static double stirling(int n) {\n        return Math.sqrt(2 * Math.PI * n) * Math.pow(n / Math.E, n);\n    }\n\n    public static void main(String[] args) {\n        // Product of 1*2*3*...*n = n!\n        System.out.println(\"5! = \" + product(i -> i, 1, 5));\n        System.out.println(\"10! = \" + product(i -> i, 1, 10));\n\n        // Large factorials\n        System.out.println(\"20! = \" + factorial(20));\n        System.out.println(\"50! = \" + factorial(50));\n\n        // Stirling's approximation accuracy\n        System.out.println(\"\\nStirling's approximation:\");\n        for (int n : new int[]{5, 10, 20, 50}) {\n            double actual = factorial(n).doubleValue();\n            double approx = stirling(n);\n            double ratio = approx / actual;\n            System.out.printf(\"  %d!: actual=%.2e, stirling=%.2e, ratio=%.6f%n\",\n                n, actual, approx, ratio);\n        }\n    }\n}"
        ]
      ]
