          "java",
          "import java.util.*;\nimport java.util.function.*;\nimport java.util.stream.*;\n\npublic class Sequences {\n\n    // Represent a sequence as a function from index to value\n    @FunctionalInterface\n    interface Sequence {\n        long term(int n);\n    }\n\n    // Generate first n terms of a sequence\n    public static List<Long> generate(Sequence seq, int from, int to) {\n        List<Long> terms = new ArrayList<>();\n        for (int i = from; i <= to; i++) {\n            terms.add(seq.term(i));\n        }\n        return terms;\n    }\n\n    public static void main(String[] args) {\n        // Arithmetic sequence: a_n = a_0 + n*d\n        Sequence arithmetic = n -> 3 + n * 5L; // a_0=3, d=5\n        System.out.println(\"Arithmetic (3, 8, 13, ...): \" + generate(arithmetic, 0, 7));\n\n        // Geometric sequence: a_n = a_0 * r^n\n        Sequence geometric = n -> (long)(2 * Math.pow(3, n)); // a_0=2, r=3\n        System.out.println(\"Geometric (2, 6, 18, ...): \" + generate(geometric, 0, 6));\n\n        // Squares: a_n = n^2\n        Sequence squares = n -> (long) n * n;\n        System.out.println(\"Squares: \" + generate(squares, 1, 10));\n\n        // Triangular numbers: T_n = n(n+1)/2\n        Sequence triangular = n -> (long) n * (n + 1) / 2;\n        System.out.println(\"Triangular: \" + generate(triangular, 1, 10));\n\n        // Fibonacci\n        System.out.println(\"Fibonacci: \" + generateFibonacci(12));\n    }\n\n    public static List<Long> generateFibonacci(int count) {\n        List<Long> fib = new ArrayList<>();\n        long a = 0, b = 1;\n        for (int i = 0; i < count; i++) {\n            fib.add(a);\n            long temp = a + b;\n            a = b;\n            b = temp;\n        }\n        return fib;\n    }\n}"
        ]
