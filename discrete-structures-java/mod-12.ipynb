          "java",
          "public class DoubleSummations {\n\n    // Double summation: sum_{i=1}^{n} sum_{j=1}^{m} f(i,j)\n    public static long doubleSum(int n, int m,\n            java.util.function.BiFunction<Integer, Integer, Long> f) {\n        long total = 0;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= m; j++) {\n                total += f.apply(i, j);\n            }\n        }\n        return total;\n    }\n\n    // Triangular double sum: sum_{i=1}^{n} sum_{j=1}^{i} f(i,j)\n    public static long triangularSum(int n,\n            java.util.function.BiFunction<Integer, Integer, Long> f) {\n        long total = 0;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= i; j++) {\n                total += f.apply(i, j);\n            }\n        }\n        return total;\n    }\n\n    public static void main(String[] args) {\n        int n = 5;\n\n        // sum_{i=1}^{5} sum_{j=1}^{5} (i + j)\n        long result1 = doubleSum(n, n, (i, j) -> (long)(i + j));\n        System.out.println(\"Double sum of (i+j), n=5: \" + result1);\n        // = sum_i (5*i + 15) = 5*15 + 5*15 = 150\n\n        // Triangular sum: sum_{i=1}^{n} sum_{j=1}^{i} 1 = n(n+1)/2\n        long result2 = triangularSum(n, (i, j) -> 1L);\n        System.out.println(\"Triangular sum of 1, n=5: \" + result2);\n        System.out.println(\"Expected n(n+1)/2 = \" + (n * (n + 1) / 2));\n\n        // This represents the number of iterations in a nested loop\n        // for(i=1..n) for(j=1..i) => O(n^2)\n        System.out.println(\"\\nLoop iteration counts (shows growth):\");\n        for (int size = 10; size <= 100; size += 10) {\n            long iterations = triangularSum(size, (i, j) -> 1L);\n            System.out.printf(\"  n=%3d: %6d iterations (n^2/2 = %6d)%n\",\n                size, iterations, size * size / 2);\n        }\n    }\n}"
        ]
      ]
