          "java",
          "public class Summations {\n\n    // Sum of first n natural numbers: 1 + 2 + ... + n = n(n+1)/2\n    public static long sumNatural(int n) {\n        return (long) n * (n + 1) / 2;\n    }\n\n    // Sum of squares: 1^2 + 2^2 + ... + n^2 = n(n+1)(2n+1)/6\n    public static long sumSquares(int n) {\n        return (long) n * (n + 1) * (2 * n + 1) / 6;\n    }\n\n    // Sum of cubes: 1^3 + 2^3 + ... + n^3 = [n(n+1)/2]^2\n    public static long sumCubes(int n) {\n        long s = sumNatural(n);\n        return s * s;\n    }\n\n    // Geometric sum: a + ar + ar^2 + ... + ar^(n-1) = a(r^n - 1)/(r - 1)\n    public static double geometricSum(double a, double r, int n) {\n        if (r == 1) return a * n;\n        return a * (Math.pow(r, n) - 1) / (r - 1);\n    }\n\n    // Sum of arithmetic series: na + d*n*(n-1)/2\n    public static long arithmeticSum(long a, long d, int n) {\n        return n * a + d * n * (n - 1) / 2;\n    }\n\n    // Verify formula against iterative computation\n    public static long iterativeSum(java.util.function.IntUnaryOperator term, int from, int to) {\n        long sum = 0;\n        for (int i = from; i <= to; i++) {\n            sum += term.applyAsInt(i);\n        }\n        return sum;\n    }\n\n    public static void main(String[] args) {\n        int n = 100;\n\n        System.out.println(\"n = \" + n);\n        System.out.println(\"Sum 1..n:\");\n        System.out.println(\"  Formula: \" + sumNatural(n));\n        System.out.println(\"  Iterative: \" + iterativeSum(i -> i, 1, n));\n\n        System.out.println(\"Sum of squares 1..n:\");\n        System.out.println(\"  Formula: \" + sumSquares(n));\n        System.out.println(\"  Iterative: \" + iterativeSum(i -> i * i, 1, n));\n\n        System.out.println(\"Sum of cubes 1..n:\");\n        System.out.println(\"  Formula: \" + sumCubes(n));\n        System.out.println(\"  Iterative: \" + iterativeSum(i -> i * i * i, 1, n));\n\n        System.out.println(\"Geometric sum (a=1, r=2, n=10):\");\n        System.out.println(\"  Formula: \" + geometricSum(1, 2, 10));\n        System.out.println(\"  Iterative: \" + iterativeSum(i -> (int)Math.pow(2, i), 0, 9));\n    }\n}"
        ]
