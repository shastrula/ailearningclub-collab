          "java",
          "import java.util.*;\n\npublic class GrowthAnalysis {\n\n    @FunctionalInterface\n    interface GrowthFunction {\n        double compute(int n);\n    }\n\n    public static void compareGrowth(Map<String, GrowthFunction> functions, int[] sizes) {\n        System.out.printf(\"%-6s\", \"n\");\n        for (String name : functions.keySet()) {\n            System.out.printf(\"%15s\", name);\n        }\n        System.out.println();\n        System.out.println(\"-\".repeat(6 + 15 * functions.size()));\n\n        for (int n : sizes) {\n            System.out.printf(\"%-6d\", n);\n            for (GrowthFunction f : functions.values()) {\n                System.out.printf(\"%15.0f\", f.compute(n));\n            }\n            System.out.println();\n        }\n    }\n\n    public static void main(String[] args) {\n        Map<String, GrowthFunction> functions = new LinkedHashMap<>();\n        functions.put(\"log n\", n -> Math.log(n) / Math.log(2));\n        functions.put(\"n\", n -> (double) n);\n        functions.put(\"n log n\", n -> n * Math.log(n) / Math.log(2));\n        functions.put(\"n^2\", n -> (double) n * n);\n        functions.put(\"2^n\", n -> Math.pow(2, n));\n\n        int[] sizes = {2, 4, 8, 16, 32, 64};\n        System.out.println(\"Growth rate comparison:\");\n        compareGrowth(functions, sizes);\n\n        // Harmonic numbers: H_n = 1 + 1/2 + 1/3 + ... + 1/n ~ ln(n)\n        System.out.println(\"\\nHarmonic numbers (approximate ln(n)):\");\n        for (int n : new int[]{10, 100, 1000, 10000}) {\n            double harmonic = 0;\n            for (int i = 1; i <= n; i++) harmonic += 1.0 / i;\n            System.out.printf(\"  H_%d = %.4f, ln(%d) = %.4f%n\",\n                n, harmonic, n, Math.log(n));\n        }\n    }\n}"
        ]
      ]
