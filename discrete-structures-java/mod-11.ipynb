          "java",
          "import java.util.*;\nimport java.util.function.*;\n\npublic class FunctionComposition {\n\n    public static void main(String[] args) {\n        Function<Integer, Integer> f = x -> x + 1;      // f(x) = x + 1\n        Function<Integer, Integer> g = x -> x * 2;      // g(x) = 2x\n        Function<Integer, Integer> h = x -> x * x;      // h(x) = x^2\n\n        // g(f(x)) = 2(x+1) = 2x+2\n        Function<Integer, Integer> gOfF = f.andThen(g);\n        // f(g(x)) = 2x + 1\n        Function<Integer, Integer> fOfG = g.andThen(f);\n\n        System.out.println(\"f(x) = x+1, g(x) = 2x\");\n        System.out.println(\"g(f(3)) = \" + gOfF.apply(3)); // 8\n        System.out.println(\"f(g(3)) = \" + fOfG.apply(3)); // 7\n        System.out.println(\"Composition is not commutative: \" +\n            !gOfF.apply(3).equals(fOfG.apply(3)));\n\n        // Composition preserves injectivity\n        // If f and g are injective, g(f(x)) is injective\n        Set<Integer> domain = Set.of(1, 2, 3, 4, 5);\n        boolean fInjective = isInjective(f, domain);\n        boolean gInjective = isInjective(g, domain);\n        boolean composedInjective = isInjective(gOfF, domain);\n        System.out.println(\"\\nf injective: \" + fInjective);\n        System.out.println(\"g injective: \" + gInjective);\n        System.out.println(\"g\u2218f injective: \" + composedInjective);\n\n        // Identity function: f\u2218f^(-1) = id\n        Function<Integer, Integer> id = Function.identity();\n        System.out.println(\"\\nIdentity(5) = \" + id.apply(5));\n    }\n\n    private static <T> boolean isInjective(Function<T, ?> f, Set<T> domain) {\n        Set<Object> outputs = new HashSet<>();\n        for (T input : domain) {\n            if (!outputs.add(f.apply(input))) return false;\n        }\n        return true;\n    }\n}"
        ]
