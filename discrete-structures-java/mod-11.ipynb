          "java",
          "import java.util.*;\nimport java.util.function.*;\nimport java.util.stream.*;\n\npublic class SurjectiveFunction {\n\n    // Check if function is surjective onto given codomain\n    public static <A, B> boolean isSurjective(Map<A, B> mapping, Set<B> codomain) {\n        Set<B> range = new HashSet<>(mapping.values());\n        return range.containsAll(codomain);\n    }\n\n    public static <A, B> boolean isSurjective(Function<A, B> f, Set<A> domain, Set<B> codomain) {\n        Set<B> range = domain.stream()\n            .map(f::apply)\n            .collect(Collectors.toSet());\n        return range.containsAll(codomain);\n    }\n\n    // Find elements in codomain not covered (witnesses of non-surjectivity)\n    public static <A, B> Set<B> uncoveredElements(Function<A, B> f, Set<A> domain, Set<B> codomain) {\n        Set<B> range = domain.stream().map(f::apply).collect(Collectors.toSet());\n        Set<B> uncovered = new HashSet<>(codomain);\n        uncovered.removeAll(range);\n        return uncovered;\n    }\n\n    public static void main(String[] args) {\n        Set<Integer> domain = Set.of(1, 2, 3, 4, 5, 6);\n        Set<Integer> codomain = Set.of(0, 1, 2);\n\n        // f(x) = x mod 3 is surjective onto {0, 1, 2}\n        Function<Integer, Integer> f = x -> x % 3;\n        System.out.println(\"f(x) = x mod 3 surjective onto {0,1,2}: \" +\n            isSurjective(f, domain, codomain));\n\n        // g(x) = x mod 3 NOT surjective onto {0, 1, 2, 3}\n        Set<Integer> biggerCodomain = Set.of(0, 1, 2, 3);\n        System.out.println(\"f(x) = x mod 3 surjective onto {0,1,2,3}: \" +\n            isSurjective(f, domain, biggerCodomain));\n        System.out.println(\"Uncovered: \" + uncoveredElements(f, domain, biggerCodomain));\n    }\n}"
        ]
      ]
