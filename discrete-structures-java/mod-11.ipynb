          "java",
          "import java.util.*;\nimport java.util.function.*;\nimport java.util.stream.*;\n\npublic class InjectiveFunction {\n\n    // Check if a finite function is injective\n    public static <A, B> boolean isInjective(Map<A, B> mapping) {\n        Set<B> seen = new HashSet<>();\n        for (B value : mapping.values()) {\n            if (!seen.add(value)) {\n                return false; // duplicate output found\n            }\n        }\n        return true;\n    }\n\n    // Check injectivity for a function over a domain\n    public static <T> boolean isInjective(Function<T, ?> f, Set<T> domain) {\n        Set<Object> outputs = new HashSet<>();\n        for (T input : domain) {\n            if (!outputs.add(f.apply(input))) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        Set<Integer> domain = Set.of(1, 2, 3, 4, 5);\n\n        // f(x) = 2x is injective (different inputs give different outputs)\n        Function<Integer, Integer> f = x -> 2 * x;\n        System.out.println(\"f(x) = 2x is injective: \" + isInjective(f, domain));\n\n        // g(x) = x mod 3 is NOT injective (1 and 4 both map to 1)\n        Function<Integer, Integer> g = x -> x % 3;\n        System.out.println(\"g(x) = x mod 3 is injective: \" + isInjective(g, domain));\n\n        // Show which elements collide\n        Map<Integer, List<Integer>> preimages = domain.stream()\n            .collect(Collectors.groupingBy(g::apply));\n        System.out.println(\"Preimages for g: \" + preimages);\n\n        // h(x) = x^2 on positive integers is injective\n        Function<Integer, Integer> h = x -> x * x;\n        System.out.println(\"h(x) = x^2 on positives is injective: \" + isInjective(h, domain));\n    }\n}"
        ]
