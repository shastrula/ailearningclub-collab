          "java",
          "import java.util.*;\nimport java.util.function.*;\nimport java.util.stream.*;\n\npublic class BijectiveFunction {\n\n    public static <A, B> boolean isBijective(Map<A, B> mapping, Set<A> domain, Set<B> codomain) {\n        // Must be a function on domain\n        if (!domain.equals(mapping.keySet())) return false;\n        // Injective: all values distinct\n        Set<B> range = new HashSet<>(mapping.values());\n        if (range.size() != mapping.size()) return false;\n        // Surjective: range covers codomain\n        return range.equals(codomain);\n    }\n\n    // Compute inverse of a bijection\n    public static <A, B> Map<B, A> inverse(Map<A, B> bijection) {\n        Map<B, A> inv = new HashMap<>();\n        for (Map.Entry<A, B> entry : bijection.entrySet()) {\n            if (inv.containsKey(entry.getValue())) {\n                throw new IllegalArgumentException(\"Not injective - cannot invert\");\n            }\n            inv.put(entry.getValue(), entry.getKey());\n        }\n        return inv;\n    }\n\n    public static void main(String[] args) {\n        // Caesar cipher: a bijection on the alphabet\n        Set<Character> alphabet = new LinkedHashSet<>();\n        for (char c = 'a'; c <= 'z'; c++) alphabet.add(c);\n\n        Map<Character, Character> caesar = new HashMap<>();\n        int shift = 3;\n        for (char c : alphabet) {\n            caesar.put(c, (char) ('a' + (c - 'a' + shift) % 26));\n        }\n\n        System.out.println(\"Caesar cipher (shift 3):\");\n        System.out.println(\"Is bijective: \" + isBijective(caesar, alphabet, alphabet));\n\n        // Compute inverse (decryption)\n        Map<Character, Character> decrypt = inverse(caesar);\n\n        String message = \"hello\";\n        String encrypted = message.chars()\n            .mapToObj(c -> String.valueOf(caesar.get((char) c)))\n            .collect(Collectors.joining());\n        String decrypted = encrypted.chars()\n            .mapToObj(c -> String.valueOf(decrypt.get((char) c)))\n            .collect(Collectors.joining());\n\n        System.out.println(\"Message: \" + message);\n        System.out.println(\"Encrypted: \" + encrypted);\n        System.out.println(\"Decrypted: \" + decrypted);\n\n        // Bijection proves |domain| = |codomain|\n        System.out.println(\"\\n|domain| = |codomain| = \" + alphabet.size());\n    }\n}"
        ]
