          "java",
          "import java.util.*;\n\npublic class CountingFunctions {\n\n    public static long factorial(int n) {\n        long result = 1;\n        for (int i = 2; i <= n; i++) result *= i;\n        return result;\n    }\n\n    public static long permutations(int n, int r) {\n        long result = 1;\n        for (int i = n; i > n - r; i--) result *= i;\n        return result;\n    }\n\n    public static void main(String[] args) {\n        int domainSize = 3;  // |A| = 3\n        int codomainSize = 4; // |B| = 4\n\n        // Total functions from A to B: |B|^|A|\n        long totalFunctions = (long) Math.pow(codomainSize, domainSize);\n        System.out.println(\"Total functions from A to B: \" +\n            codomainSize + \"^\" + domainSize + \" = \" + totalFunctions);\n\n        // Injective functions: P(|B|, |A|) = |B|! / (|B|-|A|)!\n        long injectiveFunctions = permutations(codomainSize, domainSize);\n        System.out.println(\"Injective functions: P(\" + codomainSize + \",\" +\n            domainSize + \") = \" + injectiveFunctions);\n\n        // Bijective functions (requires |A| = |B|): |A|!\n        int n = 4;\n        long bijectiveFunctions = factorial(n);\n        System.out.println(\"Bijections on set of size \" + n + \": \" +\n            n + \"! = \" + bijectiveFunctions);\n\n        // Surjective functions use inclusion-exclusion (more complex)\n        System.out.println(\"\\nFor bijections to exist, |A| must equal |B|\");\n        System.out.println(\"For injections to exist, |A| <= |B|\");\n        System.out.println(\"For surjections to exist, |A| >= |B|\");\n    }\n}"
        ]
