          "java",
          "public class MasterTheorem {\n\n    enum Case { CASE_1, CASE_2, CASE_3 }\n\n    record MasterResult(Case theCase, String complexity, double logba, double d) {}\n\n    // Apply Master Theorem: T(n) = a*T(n/b) + Theta(n^d)\n    public static MasterResult apply(int a, int b, double d) {\n        double logba = Math.log(a) / Math.log(b);\n\n        if (d < logba) {\n            // Case 1: f(n) is polynomially smaller than n^(log_b a)\n            return new MasterResult(Case.CASE_1,\n                String.format(\"O(n^%.3f)\", logba), logba, d);\n        } else if (Math.abs(d - logba) < 0.001) {\n            // Case 2: f(n) = Theta(n^(log_b a))\n            return new MasterResult(Case.CASE_2,\n                String.format(\"O(n^%.1f * log n)\", d), logba, d);\n        } else {\n            // Case 3: f(n) is polynomially larger than n^(log_b a)\n            return new MasterResult(Case.CASE_3,\n                String.format(\"O(n^%.1f)\", d), logba, d);\n        }\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"Master Theorem Applications:\");\n        System.out.println(\"=\".repeat(60));\n\n        // Binary Search: T(n) = T(n/2) + O(1) => a=1, b=2, d=0\n        MasterResult bs = apply(1, 2, 0);\n        System.out.printf(\"Binary Search: T(n) = T(n/2) + O(1)%n\");\n        System.out.printf(\"  log_%d(%d) = %.2f, d=%.0f, %s => %s%n%n\",\n            2, 1, bs.logba, bs.d, bs.theCase, bs.complexity);\n\n        // Merge Sort: T(n) = 2T(n/2) + O(n) => a=2, b=2, d=1\n        MasterResult ms = apply(2, 2, 1);\n        System.out.printf(\"Merge Sort: T(n) = 2T(n/2) + O(n)%n\");\n        System.out.printf(\"  log_%d(%d) = %.2f, d=%.0f, %s => %s%n%n\",\n            2, 2, ms.logba, ms.d, ms.theCase, ms.complexity);\n\n        // Strassen: T(n) = 7T(n/2) + O(n^2) => a=7, b=2, d=2\n        MasterResult st = apply(7, 2, 2);\n        System.out.printf(\"Strassen: T(n) = 7T(n/2) + O(n^2)%n\");\n        System.out.printf(\"  log_%d(%d) = %.2f, d=%.0f, %s => %s%n%n\",\n            2, 7, st.logba, st.d, st.theCase, st.complexity);\n\n        // Karatsuba: T(n) = 3T(n/2) + O(n) => a=3, b=2, d=1\n        MasterResult ka = apply(3, 2, 1);\n        System.out.printf(\"Karatsuba: T(n) = 3T(n/2) + O(n)%n\");\n        System.out.printf(\"  log_%d(%d) = %.2f, d=%.0f, %s => %s%n%n\",\n            2, 3, ka.logba, ka.d, ka.theCase, ka.complexity);\n\n        // Quickselect average: T(n) = T(n/2) + O(n) => a=1, b=2, d=1\n        MasterResult qs = apply(1, 2, 1);\n        System.out.printf(\"Quickselect: T(n) = T(n/2) + O(n)%n\");\n        System.out.printf(\"  log_%d(%d) = %.2f, d=%.0f, %s => %s%n\",\n            2, 1, qs.logba, qs.d, qs.theCase, qs.complexity);\n    }\n}"
        ]
