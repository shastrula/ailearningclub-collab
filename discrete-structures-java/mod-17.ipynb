          "java",
          "import java.util.*;\n\npublic class NonHomogeneousSolver {\n\n    // Solve a(n) = c*a(n-1) + d (constant non-homogeneous term)\n    // Closed form: a(n) = (a(0) - d/(1-c)) * c^n + d/(1-c) when c != 1\n    //              a(n) = a(0) + n*d when c = 1\n    public static double[] solveConstantNonHomogeneous(double a0, double c, double d) {\n        if (Math.abs(c - 1) < 1e-10) {\n            // a(n) = a0 + n*d\n            return new double[]{a0, d, 1.0}; // coefficients for a0 + d*n\n        }\n        double particular = d / (1 - c);\n        double homogCoeff = a0 - particular;\n        return new double[]{homogCoeff, c, particular};\n    }\n\n    public static void main(String[] args) {\n        // Tower of Hanoi: T(n) = 2*T(n-1) + 1, T(0) = 0\n        // c=2, d=1: T(n) = (0 - 1/(1-2)) * 2^n + 1/(1-2) = 1*2^n - 1 = 2^n - 1\n        System.out.println(\"Tower of Hanoi: T(n) = 2T(n-1) + 1\");\n        double[] hanoiParams = solveConstantNonHomogeneous(0, 2, 1);\n        System.out.printf(\"Closed form: T(n) = %.0f * %.0f^n + (%.0f)%n\",\n            hanoiParams[0], hanoiParams[1], hanoiParams[2]);\n        System.out.println(\"Simplified: T(n) = 2^n - 1\");\n\n        // Verify\n        long[] hanoi = new long[11];\n        hanoi[0] = 0;\n        for (int i = 1; i <= 10; i++) hanoi[i] = 2*hanoi[i-1] + 1;\n        System.out.print(\"Recurrence: \");\n        System.out.println(Arrays.toString(hanoi));\n        System.out.print(\"Formula:    [\");\n        for (int i = 0; i <= 10; i++) {\n            System.out.print((1L << i) - 1);\n            if (i < 10) System.out.print(\", \");\n        }\n        System.out.println(\"]\");\n\n        // Compound interest: A(n) = (1+r)*A(n-1) + P (deposit P each period)\n        double r = 0.05; // 5% interest\n        double P = 1000; // deposit per period\n        double A0 = 0;   // starting balance\n        System.out.println(\"\\nCompound interest: A(n) = 1.05*A(n-1) + 1000\");\n        double c = 1 + r;\n        double particular = P / (1 - c); // = P / (-r) = -P/r\n        double homogCoeff = A0 - particular;\n        System.out.printf(\"Closed form: A(n) = %.0f * %.2f^n + (%.0f)%n\",\n            homogCoeff, c, particular);\n        System.out.printf(\"Simplified: A(n) = %.0f * (1.05^n - 1)%n\", P / r);\n\n        // Compare\n        System.out.println(\"Year | Recurrence | Formula\");\n        double balance = A0;\n        for (int n = 1; n <= 10; n++) {\n            balance = c * balance + P;\n            double formulaResult = (P / r) * (Math.pow(c, n) - 1);\n            System.out.printf(\"  %2d | %10.2f | %10.2f%n\", n, balance, formulaResult);\n        }\n    }\n}"
        ]
