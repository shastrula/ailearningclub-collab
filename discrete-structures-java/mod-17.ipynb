          "java",
          "import java.util.*;\n\npublic class GeneratingFunctions {\n\n    // Compute sequence from generating function coefficients\n    // For geometric: 1/(1-x) has coefficients [1, 1, 1, ...]\n    // For 1/(1-x)^2: coefficients are [1, 2, 3, 4, ...] = (n+1)\n\n    // Multiply two polynomial coefficient arrays (convolution)\n    public static double[] multiply(double[] a, double[] b, int terms) {\n        double[] result = new double[terms];\n        for (int i = 0; i < Math.min(a.length, terms); i++) {\n            for (int j = 0; j < Math.min(b.length, terms); j++) {\n                if (i + j < terms) {\n                    result[i + j] += a[i] * b[j];\n                }\n            }\n        }\n        return result;\n    }\n\n    // Catalan generating function: C(x) = (1 - sqrt(1-4x)) / (2x)\n    // Coefficients give Catalan numbers\n    public static long[] catalanNumbers(int n) {\n        long[] cat = new long[n];\n        cat[0] = 1;\n        for (int i = 1; i < n; i++) {\n            for (int j = 0; j < i; j++) {\n                cat[i] += cat[j] * cat[i - 1 - j];\n            }\n        }\n        return cat;\n    }\n\n    public static void main(String[] args) {\n        // Fibonacci via generating function multiplication concept\n        // G(x) = x / (1 - x - x^2)\n        // Partial fractions give the Binet formula\n\n        System.out.println(\"Catalan numbers (from convolution recurrence):\");\n        long[] cat = catalanNumbers(12);\n        System.out.println(Arrays.toString(cat));\n\n        // Applications of Catalan numbers\n        System.out.println(\"\\nCatalan number applications:\");\n        System.out.println(\"C(n) counts:\");\n        System.out.println(\"  - Valid parenthesizations of n+1 factors\");\n        System.out.println(\"  - Binary trees with n+1 leaves\");\n        System.out.println(\"  - Paths that don't cross the diagonal\");\n        for (int i = 0; i < 8; i++) {\n            System.out.printf(\"  C(%d) = %d%n\", i, cat[i]);\n        }\n\n        // Polynomial multiplication for convolution\n        System.out.println(\"\\nPolynomial multiplication (1+x+x^2) * (1+2x):\");\n        double[] p1 = {1, 1, 1};\n        double[] p2 = {1, 2};\n        double[] product = multiply(p1, p2, 4);\n        System.out.println(\"Result: \" + Arrays.toString(product));\n        // = 1 + 3x + 3x^2 + 2x^3\n    }\n}"
