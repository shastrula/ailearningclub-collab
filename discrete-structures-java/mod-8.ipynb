          "java",
          "import java.util.*;\nimport java.util.stream.*;\n\npublic class PowerSet {\n\n    // Iterative approach using bit manipulation\n    public static <T> Set<Set<T>> powerSetIterative(Set<T> set) {\n        List<T> elements = new ArrayList<>(set);\n        int n = elements.size();\n        Set<Set<T>> powerSet = new HashSet<>();\n\n        for (int mask = 0; mask < (1 << n); mask++) {\n            Set<T> subset = new HashSet<>();\n            for (int i = 0; i < n; i++) {\n                if ((mask & (1 << i)) != 0) {\n                    subset.add(elements.get(i));\n                }\n            }\n            powerSet.add(subset);\n        }\n        return powerSet;\n    }\n\n    // Recursive approach\n    public static <T> Set<Set<T>> powerSetRecursive(Set<T> set) {\n        if (set.isEmpty()) {\n            Set<Set<T>> result = new HashSet<>();\n            result.add(new HashSet<>());\n            return result;\n        }\n\n        List<T> elements = new ArrayList<>(set);\n        T first = elements.get(0);\n        Set<T> rest = new HashSet<>(elements.subList(1, elements.size()));\n\n        Set<Set<T>> subsetsWithoutFirst = powerSetRecursive(rest);\n        Set<Set<T>> subsetsWithFirst = new HashSet<>();\n\n        for (Set<T> subset : subsetsWithoutFirst) {\n            Set<T> withFirst = new HashSet<>(subset);\n            withFirst.add(first);\n            subsetsWithFirst.add(withFirst);\n        }\n\n        Set<Set<T>> result = new HashSet<>(subsetsWithoutFirst);\n        result.addAll(subsetsWithFirst);\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Set<Integer> S = Set.of(1, 2, 3);\n        Set<Set<Integer>> ps = powerSetIterative(S);\n\n        System.out.println(\"S = \" + S);\n        System.out.println(\"|S| = \" + S.size());\n        System.out.println(\"|P(S)| = \" + ps.size()); // 2^3 = 8\n        System.out.println(\"P(S) = \");\n        ps.stream()\n            .sorted(Comparator.comparingInt(Set::size))\n            .forEach(subset -> System.out.println(\"  \" + subset));\n\n        // Verify |P(S)| = 2^|S|\n        for (int n = 0; n <= 5; n++) {\n            Set<Integer> testSet = IntStream.rangeClosed(1, n)\n                .boxed().collect(Collectors.toSet());\n            int powerSetSize = powerSetIterative(testSet).size();\n            System.out.printf(\"|P({1..%d})| = %d = 2^%d: %b%n\",\n                n, powerSetSize, n, powerSetSize == (1 << n));\n        }\n    }\n}"
        ]
