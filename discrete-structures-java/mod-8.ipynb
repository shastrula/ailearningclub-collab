          "java",
          "import java.util.*;\n\npublic class AllSetIdentities {\n\n    static Set<Integer> U = Set.of(1, 2, 3, 4);\n\n    static Set<Integer> union(Set<Integer> a, Set<Integer> b) {\n        Set<Integer> r = new HashSet<>(a); r.addAll(b); return r;\n    }\n    static Set<Integer> intersect(Set<Integer> a, Set<Integer> b) {\n        Set<Integer> r = new HashSet<>(a); r.retainAll(b); return r;\n    }\n    static Set<Integer> comp(Set<Integer> a) {\n        Set<Integer> r = new HashSet<>(U); r.removeAll(a); return r;\n    }\n\n    public static void main(String[] args) {\n        Set<Integer> A = Set.of(1, 2, 3);\n        Set<Integer> B = Set.of(2, 3, 4);\n        Set<Integer> empty = Collections.emptySet();\n\n        System.out.println(\"Identity Laws:\");\n        System.out.println(\"  A U {} = A: \" + union(A, empty).equals(A));\n        System.out.println(\"  A \u2229 U = A: \" + intersect(A, U).equals(A));\n\n        System.out.println(\"\\nDomination Laws:\");\n        System.out.println(\"  A U U = U: \" + union(A, U).equals(U));\n        System.out.println(\"  A \u2229 {} = {}: \" + intersect(A, empty).equals(empty));\n\n        System.out.println(\"\\nIdempotent Laws:\");\n        System.out.println(\"  A U A = A: \" + union(A, A).equals(A));\n        System.out.println(\"  A \u2229 A = A: \" + intersect(A, A).equals(A));\n\n        System.out.println(\"\\nComplement Laws:\");\n        System.out.println(\"  A U A' = U: \" + union(A, comp(A)).equals(U));\n        System.out.println(\"  A \u2229 A' = {}: \" + intersect(A, comp(A)).equals(empty));\n\n        System.out.println(\"\\nCommutative Laws:\");\n        System.out.println(\"  A U B = B U A: \" + union(A, B).equals(union(B, A)));\n        System.out.println(\"  A \u2229 B = B \u2229 A: \" + intersect(A, B).equals(intersect(B, A)));\n\n        System.out.println(\"\\nDouble Complement:\");\n        System.out.println(\"  (A')' = A: \" + comp(comp(A)).equals(A));\n\n        System.out.println(\"\\nInvolution:\");\n        System.out.println(\"  U' = {}: \" + comp(U).equals(empty));\n        System.out.println(\"  {}' = U: \" + comp(empty).equals(U));\n    }\n}"
