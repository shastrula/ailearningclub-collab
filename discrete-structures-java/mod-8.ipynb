          "java",
          "import java.util.*;\n\npublic class Multiset<T> {\n    private Map<T, Integer> elements = new HashMap<>();\n\n    public void add(T element) {\n        elements.merge(element, 1, Integer::sum);\n    }\n\n    public void add(T element, int count) {\n        elements.merge(element, count, Integer::sum);\n    }\n\n    public int count(T element) {\n        return elements.getOrDefault(element, 0);\n    }\n\n    public int size() {\n        return elements.values().stream().mapToInt(Integer::intValue).sum();\n    }\n\n    public Set<T> distinctElements() {\n        return elements.keySet();\n    }\n\n    // Multiset union: max of counts\n    public Multiset<T> union(Multiset<T> other) {\n        Multiset<T> result = new Multiset<>();\n        Set<T> allElements = new HashSet<>(this.distinctElements());\n        allElements.addAll(other.distinctElements());\n        for (T e : allElements) {\n            result.add(e, Math.max(this.count(e), other.count(e)));\n        }\n        return result;\n    }\n\n    // Multiset intersection: min of counts\n    public Multiset<T> intersection(Multiset<T> other) {\n        Multiset<T> result = new Multiset<>();\n        for (T e : this.distinctElements()) {\n            int minCount = Math.min(this.count(e), other.count(e));\n            if (minCount > 0) result.add(e, minCount);\n        }\n        return result;\n    }\n\n    @Override\n    public String toString() {\n        return elements.toString();\n    }\n\n    public static void main(String[] args) {\n        Multiset<String> bag1 = new Multiset<>();\n        bag1.add(\"apple\", 3);\n        bag1.add(\"banana\", 2);\n\n        Multiset<String> bag2 = new Multiset<>();\n        bag2.add(\"apple\", 1);\n        bag2.add(\"banana\", 4);\n        bag2.add(\"cherry\", 2);\n\n        System.out.println(\"Bag1: \" + bag1);\n        System.out.println(\"Bag2: \" + bag2);\n        System.out.println(\"Union: \" + bag1.union(bag2));\n        System.out.println(\"Intersection: \" + bag1.intersection(bag2));\n    }\n}"
        ]
