          "java",
          "import java.util.*;\nimport java.util.stream.*;\n\npublic class SetIdentities {\n\n    // Generate all subsets of a universe for testing\n    static List<Set<Integer>> allSubsets(Set<Integer> universe) {\n        List<Integer> elements = new ArrayList<>(universe);\n        int n = elements.size();\n        List<Set<Integer>> subsets = new ArrayList<>();\n\n        for (int mask = 0; mask < (1 << n); mask++) {\n            Set<Integer> subset = new HashSet<>();\n            for (int i = 0; i < n; i++) {\n                if ((mask & (1 << i)) != 0) {\n                    subset.add(elements.get(i));\n                }\n            }\n            subsets.add(subset);\n        }\n        return subsets;\n    }\n\n    static <T> Set<T> union(Set<T> a, Set<T> b) {\n        Set<T> r = new HashSet<>(a); r.addAll(b); return r;\n    }\n    static <T> Set<T> intersect(Set<T> a, Set<T> b) {\n        Set<T> r = new HashSet<>(a); r.retainAll(b); return r;\n    }\n    static <T> Set<T> diff(Set<T> a, Set<T> b) {\n        Set<T> r = new HashSet<>(a); r.removeAll(b); return r;\n    }\n    static Set<Integer> complement(Set<Integer> a, Set<Integer> u) {\n        return diff(u, a);\n    }\n\n    public static void main(String[] args) {\n        Set<Integer> U = Set.of(1, 2, 3, 4, 5);\n        List<Set<Integer>> allSets = allSubsets(U);\n\n        System.out.println(\"Verifying set identities over universe \" + U);\n        System.out.println(\"Testing all \" + allSets.size() + \" possible subsets\\n\");\n\n        boolean allPass = true;\n\n        // De Morgan's Laws for sets\n        for (Set<Integer> A : allSets) {\n            for (Set<Integer> B : allSets) {\n                // (A U B)' = A' \u2229 B'\n                Set<Integer> left1 = complement(union(A, B), U);\n                Set<Integer> right1 = intersect(complement(A, U), complement(B, U));\n                if (!left1.equals(right1)) { allPass = false; break; }\n\n                // (A \u2229 B)' = A' U B'\n                Set<Integer> left2 = complement(intersect(A, B), U);\n                Set<Integer> right2 = union(complement(A, U), complement(B, U));\n                if (!left2.equals(right2)) { allPass = false; break; }\n            }\n        }\n        System.out.println(\"De Morgan's Laws: \" + (allPass ? \"VERIFIED\" : \"FAILED\"));\n\n        // Distributive Laws\n        allPass = true;\n        for (Set<Integer> A : allSets) {\n            for (Set<Integer> B : allSets) {\n                for (Set<Integer> C : allSets) {\n                    // A \u2229 (B U C) = (A \u2229 B) U (A \u2229 C)\n                    Set<Integer> l = intersect(A, union(B, C));\n                    Set<Integer> r = union(intersect(A, B), intersect(A, C));\n                    if (!l.equals(r)) { allPass = false; break; }\n\n                    // A U (B \u2229 C) = (A U B) \u2229 (A U C)\n                    Set<Integer> l2 = union(A, intersect(B, C));\n                    Set<Integer> r2 = intersect(union(A, B), union(A, C));\n                    if (!l2.equals(r2)) { allPass = false; break; }\n                }\n            }\n        }\n        System.out.println(\"Distributive Laws: \" + (allPass ? \"VERIFIED\" : \"FAILED\"));\n\n        // Absorption Laws: A U (A \u2229 B) = A, A \u2229 (A U B) = A\n        allPass = true;\n        for (Set<Integer> A : allSets) {\n            for (Set<Integer> B : allSets) {\n                if (!union(A, intersect(A, B)).equals(A)) { allPass = false; break; }\n                if (!intersect(A, union(A, B)).equals(A)) { allPass = false; break; }\n            }\n        }\n        System.out.println(\"Absorption Laws: \" + (allPass ? \"VERIFIED\" : \"FAILED\"));\n    }\n}"
