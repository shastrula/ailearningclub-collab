          "java",
          "import java.util.*;\nimport java.util.stream.*;\n\npublic class PowerSetProperties {\n\n    public static <T> Set<Set<T>> powerSet(Set<T> set) {\n        List<T> elements = new ArrayList<>(set);\n        int n = elements.size();\n        Set<Set<T>> result = new HashSet<>();\n        for (int mask = 0; mask < (1 << n); mask++) {\n            Set<T> subset = new HashSet<>();\n            for (int i = 0; i < n; i++) {\n                if ((mask & (1 << i)) != 0) subset.add(elements.get(i));\n            }\n            result.add(subset);\n        }\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Set<Integer> S = Set.of(1, 2, 3);\n        Set<Set<Integer>> ps = powerSet(S);\n\n        // Property: empty set is always in power set\n        System.out.println(\"Contains empty set: \" + ps.contains(Collections.emptySet()));\n\n        // Property: S itself is always in power set\n        System.out.println(\"Contains S: \" + ps.contains(S));\n\n        // Count subsets by size (binomial coefficients)\n        System.out.println(\"\\nSubsets by size:\");\n        for (int k = 0; k <= S.size(); k++) {\n            final int size = k;\n            long count = ps.stream().filter(sub -> sub.size() == size).count();\n            System.out.printf(\"  Subsets of size %d: %d (C(%d,%d))%n\",\n                k, count, S.size(), k);\n        }\n\n        // Sum of binomial coefficients = 2^n\n        long total = ps.size();\n        System.out.println(\"\\nSum of C(3,k) for k=0..3 = \" + total + \" = 2^3\");\n\n        // Power set of power set\n        Set<Integer> small = Set.of(1, 2);\n        Set<Set<Integer>> p1 = powerSet(small);\n        System.out.println(\"\\nP({1,2}) has \" + p1.size() + \" elements\");\n        System.out.println(\"P(P({1,2})) would have \" + (1 << p1.size()) + \" elements\");\n    }\n}"
        ]
