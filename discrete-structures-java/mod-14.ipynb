          "java",
          "import java.util.*;\n\npublic class PascalTriangle {\n\n    // Generate Pascal's triangle up to row n\n    public static List<List<Long>> generate(int numRows) {\n        List<List<Long>> triangle = new ArrayList<>();\n\n        for (int n = 0; n < numRows; n++) {\n            List<Long> row = new ArrayList<>();\n            row.add(1L);\n            for (int r = 1; r < n; r++) {\n                List<Long> prevRow = triangle.get(n - 1);\n                row.add(prevRow.get(r - 1) + prevRow.get(r));\n            }\n            if (n > 0) row.add(1L);\n            triangle.add(row);\n        }\n        return triangle;\n    }\n\n    // Lookup C(n, r) from Pascal's triangle\n    public static long lookup(List<List<Long>> triangle, int n, int r) {\n        if (n >= triangle.size() || r > n) return 0;\n        return triangle.get(n).get(r);\n    }\n\n    public static void main(String[] args) {\n        List<List<Long>> triangle = generate(10);\n\n        System.out.println(\"Pascal's Triangle (rows 0-9):\");\n        for (int i = 0; i < triangle.size(); i++) {\n            String padding = \" \".repeat((10 - i) * 2);\n            System.out.print(padding);\n            for (long val : triangle.get(i)) {\n                System.out.printf(\"%4d\", val);\n            }\n            System.out.println();\n        }\n\n        // Properties of Pascal's triangle\n        System.out.println(\"\\nProperties:\");\n        System.out.println(\"C(6,2) = \" + lookup(triangle, 6, 2)); // 15\n\n        // Sum of row n = 2^n\n        for (int n = 0; n < 8; n++) {\n            long rowSum = triangle.get(n).stream().mapToLong(Long::longValue).sum();\n            System.out.printf(\"Sum of row %d: %d = 2^%d = %d%n\",\n                n, rowSum, n, 1L << n);\n        }\n\n        // Symmetry: C(n,r) = C(n, n-r)\n        System.out.println(\"\\nSymmetry: C(7,2) = C(7,5) = \" +\n            lookup(triangle, 7, 2) + \" = \" + lookup(triangle, 7, 5));\n    }\n}"
        ]
