          "java",
          "import java.util.*;\n\npublic class Combinations {\n\n    // C(n, r) = n! / (r! * (n-r)!)\n    // Computed efficiently to avoid overflow\n    public static long combinationCount(int n, int r) {\n        if (r > n) return 0;\n        if (r == 0 || r == n) return 1;\n        r = Math.min(r, n - r); // use symmetry\n        long result = 1;\n        for (int i = 0; i < r; i++) {\n            result = result * (n - i) / (i + 1);\n        }\n        return result;\n    }\n\n    // Generate all r-combinations (subsets of size r)\n    public static <T> List<List<T>> generateCombinations(List<T> elements, int r) {\n        List<List<T>> result = new ArrayList<>();\n        combineHelper(elements, r, 0, new ArrayList<>(), result);\n        return result;\n    }\n\n    private static <T> void combineHelper(List<T> elements, int r,\n            int start, List<T> current, List<List<T>> result) {\n        if (current.size() == r) {\n            result.add(new ArrayList<>(current));\n            return;\n        }\n        for (int i = start; i < elements.size(); i++) {\n            current.add(elements.get(i));\n            combineHelper(elements, r, i + 1, current, result);\n            current.remove(current.size() - 1);\n        }\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"C(5,2) = \" + combinationCount(5, 2)); // 10\n        System.out.println(\"C(10,3) = \" + combinationCount(10, 3)); // 120\n        System.out.println(\"C(52,5) = \" + combinationCount(52, 5)); // 2598960\n\n        List<String> items = List.of(\"A\", \"B\", \"C\", \"D\", \"E\");\n        List<List<String>> combos = generateCombinations(items, 3);\n        System.out.println(\"\\n3-combinations of {A,B,C,D,E}: \" + combos.size());\n        combos.forEach(c -> System.out.println(\"  \" + c));\n\n        // Verify: C(5,3) = 10\n        System.out.println(\"C(5,3) = \" + combinationCount(5, 3));\n\n        // Relationship: P(n,r) = C(n,r) * r!\n        int n = 5, r = 3;\n        long perm = permCount(n, r);\n        long comb = combinationCount(n, r);\n        long factorial = factorial(r);\n        System.out.printf(\"\\nP(%d,%d) = %d = C(%d,%d) * %d! = %d * %d = %d%n\",\n            n, r, perm, n, r, r, comb, factorial, comb * factorial);\n    }\n\n    static long permCount(int n, int r) {\n        long result = 1;\n        for (int i = n; i > n - r; i--) result *= i;\n        return result;\n    }\n\n    static long factorial(int n) {\n        long result = 1;\n        for (int i = 2; i <= n; i++) result *= i;\n        return result;\n    }\n}"
        ]
