          "import java.util.*;\n\npublic class PermutationsWithRepetition {\n\n    // Multinomial coefficient: n! / (n1! * n2! * ... * nk!)\n    public static long multinomial(int n, int... groups) {\n        long result = factorial(n);\n        for (int g : groups) {\n            result /= factorial(g);\n        }\n        return result;\n    }\n\n    // Count permutations of a string with repeated characters\n    public static long countStringPermutations(String s) {\n        Map<Character, Integer> freq = new HashMap<>();\n        for (char c : s.toCharArray()) {\n            freq.merge(c, 1, Integer::sum);\n        }\n        int n = s.length();\n        long result = factorial(n);\n        for (int count : freq.values()) {\n            result /= factorial(count);\n        }\n        return result;\n    }\n\n    static long factorial(int n) {\n        long result = 1;\n        for (int i = 2; i <= n; i++) result *= i;\n        return result;\n    }\n\n    public static void main(String[] args) {\n        // Permutations of \"MISSISSIPPI\"\n        String word = \"MISSISSIPPI\";\n        System.out.println(\"Permutations of \\\"\" + word + \"\\\": \" +\n            countStringPermutations(word));\n        // 11! / (1! * 4! * 4! * 2!) = 34650\n\n        // Arranging colored balls: 3 red, 2 blue, 1 green\n        long arrangements = multinomial(6, 3, 2, 1);\n        System.out.println(\"Arrangements of 3R, 2B, 1G: \" + arrangements);\n\n        // Distributing n distinct objects into groups\n        // 10 people into teams of 4, 3, 3\n        long teams = multinomial(10, 4, 3, 3);\n        System.out.println(\"Teams of 4,3,3 from 10: \" + teams);\n    }\n}"
        ]
