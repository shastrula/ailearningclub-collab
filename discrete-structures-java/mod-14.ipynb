          "java",
          "import java.util.*;\n\npublic class Permutations {\n\n    // P(n, r) = n! / (n-r)!\n    public static long permutationCount(int n, int r) {\n        if (r > n) return 0;\n        long result = 1;\n        for (int i = n; i > n - r; i--) {\n            result *= i;\n        }\n        return result;\n    }\n\n    // Generate all permutations of a list\n    public static <T> List<List<T>> generatePermutations(List<T> elements) {\n        List<List<T>> result = new ArrayList<>();\n        permute(elements, 0, result);\n        return result;\n    }\n\n    private static <T> void permute(List<T> elements, int start, List<List<T>> result) {\n        if (start == elements.size()) {\n            result.add(new ArrayList<>(elements));\n            return;\n        }\n        for (int i = start; i < elements.size(); i++) {\n            Collections.swap(elements, start, i);\n            permute(elements, start + 1, result);\n            Collections.swap(elements, start, i); // backtrack\n        }\n    }\n\n    // Generate r-permutations (arrangements of r items from n)\n    public static <T> List<List<T>> rPermutations(List<T> elements, int r) {\n        List<List<T>> result = new ArrayList<>();\n        rPermuteHelper(elements, r, new ArrayList<>(), new boolean[elements.size()], result);\n        return result;\n    }\n\n    private static <T> void rPermuteHelper(List<T> elements, int r,\n            List<T> current, boolean[] used, List<List<T>> result) {\n        if (current.size() == r) {\n            result.add(new ArrayList<>(current));\n            return;\n        }\n        for (int i = 0; i < elements.size(); i++) {\n            if (!used[i]) {\n                used[i] = true;\n                current.add(elements.get(i));\n                rPermuteHelper(elements, r, current, used, result);\n                current.remove(current.size() - 1);\n                used[i] = false;\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"P(5,3) = \" + permutationCount(5, 3)); // 60\n        System.out.println(\"P(10,2) = \" + permutationCount(10, 2)); // 90\n        System.out.println(\"P(4,4) = 4! = \" + permutationCount(4, 4)); // 24\n\n        List<String> items = new ArrayList<>(List.of(\"A\", \"B\", \"C\"));\n        List<List<String>> allPerms = generatePermutations(items);\n        System.out.println(\"\\nAll permutations of {A,B,C}: \" + allPerms.size());\n        allPerms.forEach(p -> System.out.println(\"  \" + p));\n\n        // 2-permutations of {A, B, C, D}\n        List<String> four = List.of(\"A\", \"B\", \"C\", \"D\");\n        List<List<String>> twoPerms = rPermutations(four, 2);\n        System.out.println(\"\\n2-permutations of {A,B,C,D}: \" + twoPerms.size());\n        twoPerms.forEach(p -> System.out.println(\"  \" + p));\n    }\n}"
        ]
