          "java",
          "import java.util.*;\n\npublic class CombinationsWithRepetition {\n\n    // Count: C(n + r - 1, r) = \"stars and bars\"\n    public static long countWithRepetition(int n, int r) {\n        return combinationCount(n + r - 1, r);\n    }\n\n    // Generate all combinations with repetition\n    public static List<List<Integer>> generateWithRepetition(int n, int r) {\n        List<List<Integer>> result = new ArrayList<>();\n        generateHelper(n, r, 0, new ArrayList<>(), result);\n        return result;\n    }\n\n    private static void generateHelper(int n, int r, int start,\n            List<Integer> current, List<List<Integer>> result) {\n        if (current.size() == r) {\n            result.add(new ArrayList<>(current));\n            return;\n        }\n        for (int i = start; i < n; i++) {\n            current.add(i);\n            generateHelper(n, r, i, current, result); // i, not i+1 (repetition allowed)\n            current.remove(current.size() - 1);\n        }\n    }\n\n    static long combinationCount(int n, int r) {\n        if (r > n) return 0;\n        r = Math.min(r, n - r);\n        long result = 1;\n        for (int i = 0; i < r; i++) result = result * (n - i) / (i + 1);\n        return result;\n    }\n\n    public static void main(String[] args) {\n        // Choosing 3 scoops from 4 flavors (repetition allowed)\n        String[] flavors = {\"Vanilla\", \"Chocolate\", \"Strawberry\", \"Mint\"};\n        int n = flavors.length, r = 3;\n\n        System.out.println(\"Choosing \" + r + \" scoops from \" + n + \" flavors:\");\n        System.out.println(\"Count: C(\" + (n+r-1) + \",\" + r + \") = \" + countWithRepetition(n, r));\n\n        List<List<Integer>> combos = generateWithRepetition(n, r);\n        System.out.println(\"All combinations:\");\n        for (List<Integer> combo : combos) {\n            List<String> named = combo.stream().map(i -> flavors[i]).toList();\n            System.out.println(\"  \" + named);\n        }\n\n        // Distributing identical objects into distinct bins\n        System.out.println(\"\\nDistributing 5 identical balls into 3 distinct bins:\");\n        System.out.println(\"Ways: C(\" + (3+5-1) + \",\" + 5 + \") = \" + countWithRepetition(3, 5));\n    }\n}"
        ]
