          "import java.util.*;\nimport java.util.stream.*;\n\npublic class RuleOfProduct {\n\n    // Cartesian product size = |A| * |B|\n    public static <A, B> List<List<Object>> cartesianProduct(List<A> setA, List<B> setB) {\n        List<List<Object>> product = new ArrayList<>();\n        for (A a : setA) {\n            for (B b : setB) {\n                product.add(List.of(a, b));\n            }\n        }\n        return product;\n    }\n\n    // N-fold Cartesian product\n    public static List<List<Object>> nFoldProduct(List<List<?>> sets) {\n        List<List<Object>> result = new ArrayList<>();\n        result.add(new ArrayList<>());\n\n        for (List<?> set : sets) {\n            List<List<Object>> newResult = new ArrayList<>();\n            for (List<Object> existing : result) {\n                for (Object element : set) {\n                    List<Object> combined = new ArrayList<>(existing);\n                    combined.add(element);\n                    newResult.add(combined);\n                }\n            }\n            result = newResult;\n        }\n        return result;\n    }\n\n    public static void main(String[] args) {\n        // Problem: Menu combinations\n        List<String> appetizers = List.of(\"Soup\", \"Salad\", \"Bread\");\n        List<String> mains = List.of(\"Steak\", \"Fish\", \"Pasta\", \"Chicken\");\n        List<String> desserts = List.of(\"Cake\", \"Ice Cream\");\n\n        long totalMeals = (long) appetizers.size() * mains.size() * desserts.size();\n        System.out.println(\"Menu combinations:\");\n        System.out.println(\"  Appetizers: \" + appetizers.size());\n        System.out.println(\"  Mains: \" + mains.size());\n        System.out.println(\"  Desserts: \" + desserts.size());\n        System.out.println(\"  Total meals: \" + totalMeals);\n\n        // Enumerate all combinations\n        List<List<?>> menuSets = List.of(appetizers, mains, desserts);\n        List<List<Object>> allMeals = nFoldProduct(menuSets);\n        System.out.println(\"  Enumerated: \" + allMeals.size());\n        System.out.println(\"  First 5: \");\n        allMeals.stream().limit(5).forEach(m -> System.out.println(\"    \" + m));\n    }\n}"
