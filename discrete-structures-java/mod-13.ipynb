          "java",
          "import java.util.*;\nimport java.util.stream.*;\n\npublic class RuleOfSum {\n\n    // Count elements in a disjoint union of sets\n    public static <T> int countDisjointUnion(List<Set<T>> disjointSets) {\n        return disjointSets.stream().mapToInt(Set::size).sum();\n    }\n\n    // Verify disjointness\n    public static <T> boolean areMutuallyDisjoint(List<Set<T>> sets) {\n        for (int i = 0; i < sets.size(); i++) {\n            for (int j = i + 1; j < sets.size(); j++) {\n                if (!Collections.disjoint(sets.get(i), sets.get(j))) {\n                    return false;\n                }\n            }\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        // Problem: How many ways to travel from A to B?\n        // Option 1: By car (3 routes)\n        // Option 2: By train (2 routes)\n        // Option 3: By plane (1 route)\n        Set<String> carRoutes = Set.of(\"Highway-1\", \"Highway-2\", \"Scenic\");\n        Set<String> trainRoutes = Set.of(\"Express\", \"Local\");\n        Set<String> planeRoutes = Set.of(\"Direct-Flight\");\n\n        List<Set<String>> allOptions = List.of(carRoutes, trainRoutes, planeRoutes);\n\n        System.out.println(\"Travel options:\");\n        System.out.println(\"  Car routes: \" + carRoutes.size());\n        System.out.println(\"  Train routes: \" + trainRoutes.size());\n        System.out.println(\"  Plane routes: \" + planeRoutes.size());\n        System.out.println(\"  Mutually exclusive: \" + areMutuallyDisjoint(allOptions));\n        System.out.println(\"  Total ways: \" + countDisjointUnion(allOptions));\n\n        // Bit strings of length 4 that start with 1 OR end with 00\n        Set<String> startWith1 = new HashSet<>();\n        Set<String> endWith00 = new HashSet<>();\n        for (int i = 0; i < 16; i++) {\n            String bits = String.format(\"%4s\", Integer.toBinaryString(i)).replace(' ', '0');\n            if (bits.startsWith(\"1\")) startWith1.add(bits);\n            if (bits.endsWith(\"00\")) endWith00.add(bits);\n        }\n        // These are NOT disjoint, so we need inclusion-exclusion\n        Set<String> union = new HashSet<>(startWith1);\n        union.addAll(endWith00);\n        Set<String> intersection = new HashSet<>(startWith1);\n        intersection.retainAll(endWith00);\n\n        System.out.println(\"\\nBit strings of length 4:\");\n        System.out.println(\"  Start with 1: \" + startWith1.size());\n        System.out.println(\"  End with 00: \" + endWith00.size());\n        System.out.println(\"  Both (overlap): \" + intersection.size());\n        System.out.println(\"  Either (inclusion-exclusion): \" + union.size());\n        System.out.println(\"  Formula: \" + startWith1.size() + \" + \" +\n            endWith00.size() + \" - \" + intersection.size() + \" = \" +\n            (startWith1.size() + endWith00.size() - intersection.size()));\n    }\n}"
        ]
      ]
