          "java",
          "import java.util.*;\nimport java.util.stream.*;\n\npublic class InclusionExclusion {\n\n    // |A union B| = |A| + |B| - |A intersect B|\n    public static <T> int unionSize(Set<T> a, Set<T> b) {\n        Set<T> intersection = new HashSet<>(a);\n        intersection.retainAll(b);\n        return a.size() + b.size() - intersection.size();\n    }\n\n    // |A union B union C| = |A|+|B|+|C| - |AB| - |AC| - |BC| + |ABC|\n    public static <T> int unionSize3(Set<T> a, Set<T> b, Set<T> c) {\n        Set<T> ab = new HashSet<>(a); ab.retainAll(b);\n        Set<T> ac = new HashSet<>(a); ac.retainAll(c);\n        Set<T> bc = new HashSet<>(b); bc.retainAll(c);\n        Set<T> abc = new HashSet<>(ab); abc.retainAll(c);\n\n        return a.size() + b.size() + c.size()\n             - ab.size() - ac.size() - bc.size()\n             + abc.size();\n    }\n\n    public static void main(String[] args) {\n        // Students in a class of 100\n        // 40 take Math, 35 take CS, 25 take Physics\n        // 15 take Math+CS, 10 take Math+Physics, 8 take CS+Physics\n        // 5 take all three\n        int total = 40 + 35 + 25 - 15 - 10 - 8 + 5;\n        System.out.println(\"Students taking at least one subject: \" + total);\n        System.out.println(\"Students taking none: \" + (100 - total));\n\n        // Concrete example with actual sets\n        Set<Integer> universe = IntStream.rangeClosed(1, 100).boxed().collect(Collectors.toSet());\n\n        // Divisible by 2, 3, or 5\n        Set<Integer> divBy2 = universe.stream().filter(n -> n % 2 == 0).collect(Collectors.toSet());\n        Set<Integer> divBy3 = universe.stream().filter(n -> n % 3 == 0).collect(Collectors.toSet());\n        Set<Integer> divBy5 = universe.stream().filter(n -> n % 5 == 0).collect(Collectors.toSet());\n\n        int result = unionSize3(divBy2, divBy3, divBy5);\n        System.out.println(\"\\nNumbers 1-100 divisible by 2, 3, or 5:\");\n        System.out.println(\"  |div2| = \" + divBy2.size());\n        System.out.println(\"  |div3| = \" + divBy3.size());\n        System.out.println(\"  |div5| = \" + divBy5.size());\n        System.out.println(\"  |div2 or div3 or div5| = \" + result);\n\n        // Verify by direct count\n        Set<Integer> directUnion = new HashSet<>(divBy2);\n        directUnion.addAll(divBy3);\n        directUnion.addAll(divBy5);\n        System.out.println(\"  Direct count: \" + directUnion.size());\n    }\n}"
        ]
