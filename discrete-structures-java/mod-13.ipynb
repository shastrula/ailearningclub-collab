          "java",
          "public class AlgorithmCounting {\n\n    public static void main(String[] args) {\n        // Number of comparisons in nested loops\n        // for(i=0; i<n; i++) for(j=i+1; j<n; j++) => n(n-1)/2\n        int n = 10;\n        int count = 0;\n        for (int i = 0; i < n; i++) {\n            for (int j = i + 1; j < n; j++) {\n                count++;\n            }\n        }\n        System.out.println(\"Pairs from \" + n + \" elements: \" + count);\n        System.out.println(\"Formula n(n-1)/2: \" + (n * (n - 1) / 2));\n\n        // Number of subsets examined by brute force\n        System.out.println(\"\\nSubset enumeration cost:\");\n        for (int size = 10; size <= 30; size += 5) {\n            long subsets = 1L << size;\n            System.out.printf(\"  n=%d: %,d subsets%n\", size, subsets);\n        }\n\n        // Binary search: maximum comparisons = floor(log2(n)) + 1\n        System.out.println(\"\\nBinary search comparisons:\");\n        for (int size : new int[]{10, 100, 1000, 1000000, 1000000000}) {\n            int maxComparisons = (int)(Math.log(size) / Math.log(2)) + 1;\n            System.out.printf(\"  n=%,d: max %d comparisons%n\", size, maxComparisons);\n        }\n    }\n}"
