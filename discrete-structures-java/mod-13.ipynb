          "java",
          "import java.util.*;\n\npublic class StringCounting {\n\n    public static void main(String[] args) {\n        // How many bit strings of length n?\n        for (int n = 1; n <= 8; n++) {\n            long count = (long) Math.pow(2, n);\n            System.out.printf(\"Bit strings of length %d: %d%n\", n, count);\n        }\n\n        // Passwords: lowercase letters (26) + digits (10) + special (5) = 41 chars\n        int lowercase = 26;\n        int uppercase = 26;\n        int digits = 10;\n        int special = 5;\n        int totalChars = lowercase + uppercase + digits + special; // 67\n\n        System.out.println(\"\\nPassword counting (alphabet size = \" + totalChars + \"):\");\n        for (int length = 4; length <= 12; length += 2) {\n            double count = Math.pow(totalChars, length);\n            System.out.printf(\"  Length %2d: %.2e passwords%n\", length, count);\n        }\n\n        // Passwords with constraints: must contain at least one digit\n        System.out.println(\"\\n8-char passwords with at least one digit:\");\n        double totalPasswords = Math.pow(totalChars, 8);\n        double noDigitPasswords = Math.pow(totalChars - digits, 8);\n        double withDigit = totalPasswords - noDigitPasswords;\n        System.out.printf(\"  Total: %.2e%n\", totalPasswords);\n        System.out.printf(\"  Without digits: %.2e%n\", noDigitPasswords);\n        System.out.printf(\"  With at least one digit: %.2e%n\", withDigit);\n\n        // License plates: 3 letters followed by 4 digits\n        long plates = (long) Math.pow(26, 3) * (long) Math.pow(10, 4);\n        System.out.println(\"\\nLicense plates (AAA-0000): \" + plates);\n    }\n}"
        ]
