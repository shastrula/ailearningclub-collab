        [
          "python",
          "class Animal:\n    \"\"\"Base class for all animals.\"\"\"\n    \n    def __init__(self, name, species):\n        self.name = name\n        self.species = species\n        self.alive = True\n    \n    def speak(self):\n        \"\"\"Generic speak method to be overridden.\"\"\"\n        return f\"{self.name} makes a sound.\"\n    \n    def die(self):\n        \"\"\"Mark the animal as not alive.\"\"\"\n        self.alive = False\n        return f\"{self.name} has passed away.\"\n\nclass Cat(Animal):\n    \"\"\"Cat class inheriting from Animal.\"\"\"\n    \n    def __init__(self, name, breed):\n        super().__init__(name, \"Feline\")  # Call parent's __init__\n        self.breed = breed\n    \n    def speak(self):\n        \"\"\"Override the speak method.\"\"\"\n        return f\"{self.name} meows: Meow!\"\n\nclass Dog(Animal):\n    \"\"\"Dog class inheriting from Animal.\"\"\"\n    \n    def __init__(self, name, breed):\n        super().__init__(name, \"Canine\")\n        self.breed = breed\n        self.trained = False\n    \n    def speak(self):\n        \"\"\"Override the speak method.\"\"\"\n        return f\"{self.name} barks: Woof!\"\n    \n    def train(self):\n        \"\"\"Train the dog.\"\"\"\n        self.trained = True\n        return f\"{self.name} has been trained!\"\n\n# Create instances\nkitty = Cat(\"Whiskers\", \"Siamese\")\npuppy = Dog(\"Rex\", \"Labrador\")\n\n# Both inherit from Animal and can use its methods\nprint(kitty.speak())  # Output: Whiskers meows: Meow!\nprint(puppy.speak())  # Output: Rex barks: Woof!\nprint(kitty.die())  # Output: Whiskers has passed away.\nprint(puppy.train())  # Output: Rex has been trained!"
        ]
      ]
    },
    {
