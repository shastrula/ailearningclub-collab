          "python",
          "from datetime import datetime, timedelta\n\nclass LibraryItem:\n    def __init__(self, title, author, item_id):\n        self.title = title\n        self.author = author\n        self.item_id = item_id\n        self.borrowed_by = None\n        self.borrow_date = None\n    \n    def borrow(self, patron_name):\n        if self.borrowed_by is None:\n            self.borrowed_by = patron_name\n            self.borrow_date = datetime.now()\n            return f\"{self.title} borrowed by {patron_name}\"\n        return f\"{self.title} is already borrowed.\"\n    \n    def return_item(self):\n        if self.borrowed_by is not None:\n            duration = (datetime.now() - self.borrow_date).days\n            self.borrowed_by = None\n            return f\"{self.title} returned after {duration} days.\"\n        return f\"{self.title} was not borrowed.\"\n    \n    def __str__(self):\n        status = f\"Borrowed by {self.borrowed_by}\" if self.borrowed_by else \"Available\"\n        return f\"{self.title} by {self.author} ({status})\"\n\nclass Book(LibraryItem):\n    def __init__(self, title, author, item_id, pages, isbn):\n        super().__init__(title, author, item_id)\n        self.pages = pages\n        self.isbn = isbn\n\nclass Magazine(LibraryItem):\n    def __init__(self, title, author, item_id, issue_number, publication_date):\n        super().__init__(title, author, item_id)\n        self.issue_number = issue_number\n        self.publication_date = publication_date\n\n# Usage\nbook = Book(\"1984\", \"George Orwell\", 1, 328, \"978-0451524935\")\nmag = Magazine(\"National Geographic\", \"Various\", 2, 5, \"2024-05\")\n\nprint(book.borrow(\"Alice\"))  # 1984 borrowed by Alice\nprint(book)  # 1984 by George Orwell (Borrowed by Alice)\nprint(book.return_item())  # 1984 returned after 0 days\nprint(mag.borrow(\"Bob\"))  # National Geographic borrowed by Bob"
        ]
      ]
    }
