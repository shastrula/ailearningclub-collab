        [
          "python",
          "class Vector:\n    def __init__(self, x, y):\n        self.x = x\n        self.y = y\n    \n    def __str__(self):\n        \"\"\"Called by str() and print().\"\"\"\n        return f\"Vector({self.x}, {self.y})\"\n    \n    def __repr__(self):\n        \"\"\"Called by repr() and in interactive mode.\"\"\"\n        return f\"Vector(x={self.x}, y={self.y})\"\n    \n    def __add__(self, other):\n        \"\"\"Define vector addition with + operator.\"\"\"\n        return Vector(self.x + other.x, self.y + other.y)\n    \n    def __sub__(self, other):\n        \"\"\"Define vector subtraction with - operator.\"\"\"\n        return Vector(self.x - other.x, self.y - other.y)\n    \n    def __mul__(self, scalar):\n        \"\"\"Define scalar multiplication.\"\"\"\n        return Vector(self.x * scalar, self.y * scalar)\n    \n    def __eq__(self, other):\n        \"\"\"Define equality comparison.\"\"\"\n        return self.x == other.x and self.y == other.y\n    \n    def __len__(self):\n        \"\"\"Define length (magnitude).\"\"\"\n        return (self.x ** 2 + self.y ** 2) ** 0.5\n\n# Use special methods\nv1 = Vector(3, 4)\nv2 = Vector(1, 2)\n\nprint(v1)  # Output: Vector(3, 4) - uses __str__\nprint(v1 + v2)  # Output: Vector(4, 6) - uses __add__\nprint(v1 - v2)  # Output: Vector(2, 2) - uses __sub__\nprint(v1 * 2)  # Output: Vector(6, 8) - uses __mul__\nprint(v1 == Vector(3, 4))  # Output: True - uses __eq__\nprint(len(v1))  # Output: 5.0 - uses __len__"
        ]
      ]
    },
