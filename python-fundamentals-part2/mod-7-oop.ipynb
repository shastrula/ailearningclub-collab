        [
          "python",
          "class Dog:\n    \"\"\"A simple Dog class.\"\"\"\n    \n    def __init__(self, name, age, breed):\n        \"\"\"Initialize a Dog instance with name, age, and breed.\"\"\"\n        self.name = name\n        self.age = age\n        self.breed = breed\n    \n    def bark(self):\n        \"\"\"Make the dog bark.\"\"\"\n        return f\"{self.name} says: Woof! Woof!\"\n    \n    def birthday(self):\n        \"\"\"Add one year to the dog's age.\"\"\"\n        self.age += 1\n        return f\"{self.name} is now {self.age} years old.\"\n    \n    def describe(self):\n        \"\"\"Return a description of the dog.\"\"\"\n        return f\"{self.name} is a {self.age}-year-old {self.breed}.\"\n\n# Create instances (objects)\ndog1 = Dog(\"Buddy\", 5, \"Golden Retriever\")\ndog2 = Dog(\"Max\", 3, \"Beagle\")\n\n# Access attributes\nprint(dog1.name)  # Output: Buddy\nprint(dog2.age)   # Output: 3\n\n# Call methods\nprint(dog1.bark())  # Output: Buddy says: Woof! Woof!\nprint(dog2.describe())  # Output: Max is a 3-year-old Beagle.\nprint(dog1.birthday())  # Output: Buddy is now 6 years old."
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "class BankAccount:\n    interest_rate = 0.02  # Class attribute (shared by all instances)\n    account_count = 0     # Track total accounts\n    \n    def __init__(self, owner, balance):\n        self.owner = owner  # Instance attribute\n        self.balance = balance  # Instance attribute\n        BankAccount.account_count += 1  # Modify class attribute\n    \n    def deposit(self, amount):\n        \"\"\"Add money to the account.\"\"\"\n        if amount > 0:\n            self.balance += amount\n            return f\"Deposited ${amount}. New balance: ${self.balance}\"\n        return \"Deposit amount must be positive.\"\n    \n    def apply_interest(self):\n        \"\"\"Apply interest to the account.\"\"\"\n        interest = self.balance * BankAccount.interest_rate\n        self.balance += interest\n        return f\"Interest of ${interest:.2f} applied. New balance: ${self.balance:.2f}\"\n    \n    @classmethod\n    def get_account_count(cls):\n        \"\"\"Return the total number of accounts created.\"\"\"\n        return cls.account_count\n    \n    @staticmethod\n    def calculate_monthly_payment(principal, annual_rate, months):\n        \"\"\"Calculate monthly payment for a loan (not tied to instances).\"\"\"\n        monthly_rate = annual_rate / 12\n        if monthly_rate == 0:\n            return principal / months\n        return principal * monthly_rate * (1 + monthly_rate) ** months / ((1 + monthly_rate) ** months - 1)\n\n# Create accounts\nacc1 = BankAccount(\"Alice\", 1000)\nacc2 = BankAccount(\"Bob\", 500)\n\nprint(acc1.deposit(200))  # Output: Deposited $200. New balance: $1200\nprint(acc1.apply_interest())  # Output: Interest of $24.00 applied...\nprint(BankAccount.get_account_count())  # Output: 2\nprint(BankAccount.calculate_monthly_payment(200000, 0.05, 360))  # ~1073.64"
        ]
      ]
    },
    {
