          "python",
          "from pathlib import Path\n\n# Creating paths (works on all platforms)\ndata_dir = Path(\"data\")\nfile_path = data_dir / \"students.csv\"  # Use / operator for joining\nprint(file_path)  # data/students.csv on Unix, data\\students.csv on Windows\n\n# Path operations\nprint(file_path.name)  # students.csv (filename)\nprint(file_path.stem)  # students (filename without extension)\nprint(file_path.suffix)  # .csv (extension)\nprint(file_path.parent)  # data (directory)\nprint(file_path.absolute())  # Full absolute path\n\n# Checking paths\nif file_path.exists():\n    print(f\"Is file: {file_path.is_file()}\")\n    print(f\"Is directory: {file_path.is_dir()}\")\n    print(f\"Size: {file_path.stat().st_size} bytes\")\n\n# Creating directories\ndata_dir.mkdir(parents=True, exist_ok=True)\n\n# Reading/writing with pathlib\nfile_path.write_text(\"Hello, World!\")\ncontent = file_path.read_text()\nprint(content)\n\n# Iterating over files\nfor csv_file in Path(\"data\").glob(\"*.csv\"):\n    print(csv_file)\n\n# Finding all Python files recursively\nfor py_file in Path(\".\").rglob(\"*.py\"):\n    print(py_file)"
        ]
