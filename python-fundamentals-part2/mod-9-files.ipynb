      "source": [
        [
          "python",
          "# File navigation\nwith open(\"data.txt\", \"r\") as file:\n    file.seek(0)  # Move to beginning of file\n    first_char = file.read(1)  # Read one character\n    position = file.tell()  # Get current position\n    file.seek(0)  # Go back to start\n    content = file.read()  # Read from current position\n\n# Checking file properties\nimport os\nfilename = \"data.txt\"\nif os.path.exists(filename):\n    print(f\"File size: {os.path.getsize(filename)} bytes\")\n    print(f\"Is file: {os.path.isfile(filename)}\")\n    print(f\"Is directory: {os.path.isdir(filename)}\")\n\n# Listing directory contents\nfor filename in os.listdir(\".\"):\n    if filename.endswith(\".txt\"):\n        print(filename)"
        ]
      ]
    },
