          "python",
          "import json\n\n# Reading JSON\nwith open(\"config.json\", \"r\") as file:\n    config = json.load(file)\n    database_url = config[\"database\"][\"url\"]\n    print(f\"Connecting to {database_url}\")\n\n# Writing JSON\ndata = {\n    \"name\": \"Project Alpha\",\n    \"version\": \"1.0.0\",\n    \"dependencies\": [\"requests\", \"numpy\", \"pandas\"],\n    \"settings\": {\n        \"debug\": True,\n        \"timeout\": 30\n    }\n}\n\nwith open(\"config.json\", \"w\") as file:\n    json.dump(data, file, indent=2)  # indent for readability\n\n# JSON strings\njson_string = '{\"name\": \"Alice\", \"age\": 30}'\nperson = json.loads(json_string)  # String to Python object\nprint(person[\"name\"])\n\njson_output = json.dumps(person, indent=2)  # Python object to string\nprint(json_output)\n\n# Pretty printing\ndata = {\"users\": [{\"id\": 1, \"name\": \"Alice\"}, {\"id\": 2, \"name\": \"Bob\"}]}\nprint(json.dumps(data, indent=4, sort_keys=True))"
        ]
