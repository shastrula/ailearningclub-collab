        [
          "python",
          "try:\n    # Some code that might raise an exception\n    pass\nexcept FileNotFoundError:  # Specific - must come first\n    print(\"File not found.\")\nexcept OSError:  # Parent of FileNotFoundError\n    print(\"Operating system error.\")\nexcept Exception:  # Very general - last resort\n    print(\"Unknown error occurred.\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def process_file(filename):\n    file = None\n    try:\n        file = open(filename, 'r')\n        content = file.read()\n        print(f\"File contains {len(content)} characters.\")\n    except FileNotFoundError:\n        print(f\"File '{filename}' not found.\")\n    except IOError as e:\n        print(f\"Error reading file: {e}\")\n    else:\n        print(\"File processed successfully!\")\n    finally:\n        if file:\n            file.close()\n        print(\"Cleanup complete.\")\n\nprocess_file(\"data.txt\")  # If file doesn't exist, all handlers run appropriately"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Without context manager (risky if error occurs)\nfile = open(\"data.txt\", \"r\")\ncontent = file.read()\nfile.close()  # May not run if error occurs above\n\n# With context manager (safe)\nwith open(\"data.txt\", \"r\") as file:\n    content = file.read()\n# File automatically closed, even if error occurred\n\n# Multiple context managers\nimport json\nwith open(\"input.json\", \"r\") as input_file, open(\"output.json\", \"w\") as output_file:\n    data = json.load(input_file)\n    data[\"processed\"] = True\n    json.dump(data, output_file)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from contextlib import contextmanager\n\nclass DatabaseConnection:\n    def __init__(self, db_name):\n        self.db_name = db_name\n        self.connected = False\n    \n    def __enter__(self):\n        print(f\"Connecting to {self.db_name}...\")\n        self.connected = True\n        return self\n    \n    def __exit__(self, exc_type, exc_value, traceback):\n        print(f\"Disconnecting from {self.db_name}...\")\n        self.connected = False\n        # Return True to suppress exceptions, False to propagate\n        return False\n    \n    def query(self, sql):\n        if not self.connected:\n            raise RuntimeError(\"Not connected to database.\")\n        return f\"Executing: {sql}\"\n\n# Using the context manager\nwith DatabaseConnection(\"mydb\") as db:\n    print(db.query(\"SELECT * FROM users\"))\n\n# Decorator-based context manager\n@contextmanager\ndef timer(name):\n    import time\n    print(f\"Starting {name}...\")\n    start = time.time()\n    try:\n        yield\n    finally:\n        elapsed = time.time() - start\n        print(f\"{name} took {elapsed:.2f} seconds.\")\n\nwith timer(\"data processing\"):\n    import time\n    time.sleep(1)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
