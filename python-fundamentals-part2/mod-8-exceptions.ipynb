          "python",
          "class DataProcessingError(Exception):\n    pass\n\ndef load_data(filename):\n    try:\n        with open(filename, 'r') as f:\n            return f.read().split('\\n')\n    except FileNotFoundError:\n        raise DataProcessingError(f\"Input file '{filename}' not found.\")\n    except IOError as e:\n        raise DataProcessingError(f\"Failed to read file: {e}\")\n\ndef validate_line(line, line_num):\n    if not line:\n        raise DataProcessingError(f\"Empty line at {line_num}\")\n    parts = line.split(',')\n    if len(parts) != 3:\n        raise DataProcessingError(\n            f\"Invalid format at line {line_num}: expected 3 fields, got {len(parts)}\"\n        )\n    return parts\n\ndef process_data(input_file, output_file):\n    try:\n        data = load_data(input_file)\n        results = []\n        for i, line in enumerate(data, 1):\n            try:\n                parts = validate_line(line, i)\n                results.append(\",\".join(parts).upper())\n            except DataProcessingError as e:\n                print(f\"Warning: {e}\")\n                continue\n        \n        with open(output_file, 'w') as f:\n            f.write(\"\\n\".join(results))\n        print(f\"Processed {len(results)} lines successfully.\")\n    except DataProcessingError as e:\n        print(f\"Fatal error: {e}\")\n        raise\n\n# Usage\ntry:\n    process_data(\"input.txt\", \"output.txt\")\nexcept DataProcessingError:\n    print(\"Processing failed. Check logs for details.\")"
        ]
      ]
    },
