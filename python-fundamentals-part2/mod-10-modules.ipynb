          "python",
          "# project_structure/\n# \u251c\u2500\u2500 main.py\n# \u251c\u2500\u2500 requirements.txt\n# \u251c\u2500\u2500 config.py\n# \u251c\u2500\u2500 src/\n# \u2502   \u251c\u2500\u2500 __init__.py\n# \u2502   \u251c\u2500\u2500 data/\n# \u2502   \u2502   \u251c\u2500\u2500 __init__.py\n# \u2502   \u2502   \u251c\u2500\u2500 loaders.py\n# \u2502   \u2502   \u2514\u2500\u2500 cleaners.py\n# \u2502   \u2514\u2500\u2500 models/\n# \u2502       \u251c\u2500\u2500 __init__.py\n# \u2502       \u251c\u2500\u2500 user.py\n# \u2502       \u2514\u2500\u2500 product.py\n# \u2514\u2500\u2500 tests/\n#     \u251c\u2500\u2500 __init__.py\n#     \u251c\u2500\u2500 test_loaders.py\n#     \u2514\u2500\u2500 test_models.py\n\n# main.py\nfrom src.data.loaders import load_users\nfrom src.data.cleaners import clean_email\nfrom src.models.user import User\n\nusers = load_users(\"data.json\")\nfor user_data in users:\n    user_data[\"email\"] = clean_email(user_data[\"email\"])\n    user = User(user_data)\n    print(user)\n\n# src/data/loaders.py\nimport json\nfrom pathlib import Path\n\ndef load_users(filepath):\n    \"\"\"Load users from JSON file.\"\"\"\n    with open(filepath, 'r') as f:\n        return json.load(f)\n\n# src/data/cleaners.py\ndef clean_email(email):\n    \"\"\"Clean and validate email.\"\"\"\n    return email.lower().strip()\n\n# src/models/user.py\nclass User:\n    def __init__(self, data):\n        self.id = data.get(\"id\")\n        self.name = data.get(\"name\")\n        self.email = data.get(\"email\")\n    \n    def __repr__(self):\n        return f\"User(id={self.id}, name={self.name}, email={self.email})\"\n\n# src/models/__init__.py\nfrom .user import User\n\n__all__ = [\"User\"]\n\n# src/data/__init__.py\nfrom .loaders import load_users\nfrom .cleaners import clean_email\n\n__all__ = [\"load_users\", \"clean_email\"]\n\n# src/__init__.py\n\"\"\"Application package.\"\"\"\n__version__ = \"1.0.0\"\n\n# requirements.txt (if external packages needed)\n# requests==2.28.0\n# python-dotenv==0.20.0"
