        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.decomposition import NMF, TruncatedSVD\n\nmovie_titles = [\n    'The Matrix', 'Inception', 'Interstellar', 'The Dark Knight',\n    'Pulp Fiction', 'Fight Club', 'Forrest Gump', 'The Shawshank Redemption',\n    'The Godfather', 'Goodfellas', 'Toy Story', 'Finding Nemo'\n]\n\nratings = np.array([\n    [5, 5, 4, 5, 2, 3, 1, 2, 2, 2, 1, 1],\n    [4, 5, 5, 4, 1, 2, 2, 1, 1, 1, 1, 2],\n    [5, 4, 4, 5, 3, 4, 2, 2, 2, 3, 1, 1],\n    [2, 1, 2, 2, 5, 4, 5, 5, 5, 4, 2, 2],\n    [1, 2, 2, 1, 4, 3, 5, 5, 5, 5, 2, 1],\n    [2, 2, 3, 1, 4, 3, 4, 4, 4, 4, 3, 2],\n    [1, 1, 1, 1, 2, 1, 3, 2, 2, 2, 5, 5],\n    [1, 2, 2, 1, 1, 1, 2, 1, 1, 1, 5, 5],\n    [2, 1, 1, 2, 2, 2, 3, 3, 2, 2, 4, 5],\n], dtype=float)\n\nresults = []\n\nfor k in [2, 3, 4, 5]:\n    # NMF\n    nmf = NMF(n_components=k, init='random', random_state=42, max_iter=500)\n    W_nmf = nmf.fit_transform(ratings)\n    pred_nmf = np.clip(W_nmf @ nmf.components_, 1, 5)\n    rmse_nmf = np.sqrt(np.mean((ratings - pred_nmf) ** 2))\n    \n    # TruncatedSVD\n    user_means = ratings.mean(axis=1)\n    ratings_c = ratings - user_means.reshape(-1, 1)\n    svd = TruncatedSVD(n_components=k, random_state=42)\n    U_svd = svd.fit_transform(ratings_c)\n    pred_svd = np.clip(U_svd @ svd.components_ + user_means.reshape(-1, 1), 1, 5)\n    rmse_svd = np.sqrt(np.mean((ratings - pred_svd) ** 2))\n    \n    results.append({'k': k, 'NMF_RMSE': rmse_nmf, 'SVD_RMSE': rmse_svd})\n\nresults_df = pd.DataFrame(results)\nprint(\"=== NMF vs TruncatedSVD: RMSE by Number of Components ===\")\nprint(results_df.to_string(index=False, float_format='%.4f'))\n\nprint(\"\\n=== Feature Comparison ===\")\ncomparison = pd.DataFrame({\n    'Aspect': ['Values', 'Interpretability', 'Speed', 'Missing values',\n               'Accuracy (dense)', 'Sparsity handling'],\n    'NMF': ['Non-negative only', 'High (additive parts)', 'Moderate',\n            'Needs imputation', 'Good', 'Moderate'],\n    'TruncatedSVD': ['Any sign', 'Lower (abstract axes)', 'Fast',\n                     'Needs imputation', 'Very good', 'Good']\n})\nprint(comparison.to_string(index=False))"
        ]
      ]
