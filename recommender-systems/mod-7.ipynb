          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.decomposition import TruncatedSVD\nfrom scipy.sparse import csr_matrix\n\nmovie_titles = [\n    'The Matrix', 'Inception', 'Interstellar', 'The Dark Knight',\n    'Pulp Fiction', 'Fight Club', 'Forrest Gump', 'The Shawshank Redemption',\n    'The Godfather', 'Goodfellas', 'Toy Story', 'Finding Nemo'\n]\n\nratings = np.array([\n    [5, 5, 4, 5, 2, 3, 1, 2, 2, 2, 1, 1],\n    [4, 5, 5, 4, 1, 2, 2, 1, 1, 1, 1, 2],\n    [5, 4, 4, 5, 3, 4, 2, 2, 2, 3, 1, 1],\n    [2, 1, 2, 2, 5, 4, 5, 5, 5, 4, 2, 2],\n    [1, 2, 2, 1, 4, 3, 5, 5, 5, 5, 2, 1],\n    [2, 2, 3, 1, 4, 3, 4, 4, 4, 4, 3, 2],\n    [1, 1, 1, 1, 2, 1, 3, 2, 2, 2, 5, 5],\n    [1, 2, 2, 1, 1, 1, 2, 1, 1, 1, 5, 5],\n    [2, 1, 1, 2, 2, 2, 3, 3, 2, 2, 4, 5],\n], dtype=float)\n\nuser_names = [f'User_{i+1}' for i in range(9)]\n\n# Mean-center for TruncatedSVD\nuser_means = ratings.mean(axis=1)\nratings_centered = ratings - user_means.reshape(-1, 1)\n\n# Apply TruncatedSVD\nsvd = TruncatedSVD(n_components=3, random_state=42)\nuser_factors = svd.fit_transform(ratings_centered)\n\n# Reconstruct\npredicted_centered = user_factors @ svd.components_\npredicted = predicted_centered + user_means.reshape(-1, 1)\npredicted = np.clip(predicted, 1, 5)\n\nrmse = np.sqrt(np.mean((ratings - predicted) ** 2))\n\nprint(\"=== TruncatedSVD Results ===\")\nprint(f\"Explained variance ratio: {svd.explained_variance_ratio_.round(4)}\")\nprint(f\"Total variance explained: {svd.explained_variance_ratio_.sum():.4f}\")\nprint(f\"Reconstruction RMSE: {rmse:.4f}\")\n\nprint(f\"\\n--- Components (item loadings) ---\")\ncomp_df = pd.DataFrame(\n    svd.components_.round(3),\n    index=[f'Factor_{i+1}' for i in range(3)],\n    columns=movie_titles\n)\nprint(comp_df.T.to_string())\n\nprint(f\"\\n--- User representations in latent space ---\")\nuser_repr_df = pd.DataFrame(\n    user_factors.round(3),\n    index=user_names,\n    columns=[f'Factor_{i+1}' for i in range(3)]\n)\nprint(user_repr_df.to_string())"
