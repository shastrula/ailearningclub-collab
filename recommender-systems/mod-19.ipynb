          "python",
          "import numpy as np\nfrom collections import defaultdict\nimport time\n\nnp.random.seed(42)\n\nclass InvertedIndexRecommender:\n    \"\"\"Use inverted index for fast candidate generation.\"\"\"\n    \n    def __init__(self):\n        # item_id \u2192 list of (user_id, rating)\n        self.item_to_users = defaultdict(list)\n        # user_id \u2192 list of (item_id, rating)\n        self.user_to_items = defaultdict(list)\n    \n    def build_index(self, ratings_matrix):\n        \"\"\"Build inverted index from rating matrix.\"\"\"\n        n_users, n_items = ratings_matrix.shape\n        for u in range(n_users):\n            for i in range(n_items):\n                if ratings_matrix[u, i] > 0:\n                    self.item_to_users[i].append((u, ratings_matrix[u, i]))\n                    self.user_to_items[u].append((i, ratings_matrix[u, i]))\n    \n    def get_candidates(self, user_idx, max_candidates=50):\n        \"\"\"Get candidate items through user's rated items' co-raters.\"\"\"\n        # Step 1: Get items user rated\n        user_items = {i for i, _ in self.user_to_items[user_idx]}\n        \n        # Step 2: Find users who rated the same items\n        co_raters = defaultdict(float)\n        for item_id, rating in self.user_to_items[user_idx]:\n            for other_user, other_rating in self.item_to_users[item_id]:\n                if other_user != user_idx:\n                    co_raters[other_user] += 1\n        \n        # Step 3: Get items from top co-raters (not already rated)\n        candidates = defaultdict(float)\n        top_co_raters = sorted(co_raters.items(), key=lambda x: x[1], reverse=True)[:20]\n        \n        for co_rater_id, overlap in top_co_raters:\n            for item_id, rating in self.user_to_items[co_rater_id]:\n                if item_id not in user_items:\n                    candidates[item_id] += rating * overlap\n        \n        # Return top candidates\n        sorted_candidates = sorted(candidates.items(), key=lambda x: x[1], reverse=True)\n        return sorted_candidates[:max_candidates]\n\n# Build index\nn_users, n_items = 1000, 200\nratings = np.zeros((n_users, n_items))\nfor i in range(n_users):\n    cluster = i % 5\n    n_rated = np.random.randint(10, 30)\n    items = np.random.choice(range(cluster*40, (cluster+1)*40), min(n_rated, 40), replace=False)\n    for j in items:\n        ratings[i, j] = np.random.randint(3, 6)\n\nindex = InvertedIndexRecommender()\nindex.build_index(ratings)\n\n# Query performance\nuser_idx = 0\nstart = time.time()\ncandidates = index.get_candidates(user_idx, max_candidates=10)\nindex_time = time.time() - start\n\nprint(\"=== Inverted Index for Fast Candidate Generation ===\")\nprint(f\"\\nDataset: {n_users} users, {n_items} items\")\nprint(f\"User_{user_idx} has rated {len(index.user_to_items[user_idx])} items\")\nprint(f\"Query time: {index_time*1000:.3f} ms\")\nprint(f\"\\nTop 10 candidate items:\")\nprint(f\"{'Item':<8} {'Score':>8}\")\nprint(\"-\" * 18)\nfor item_id, score in candidates[:10]:\n    print(f\"Item_{item_id:<4} {score:>8.1f}\")"
        ]
