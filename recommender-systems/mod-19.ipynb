          "python",
          "import numpy as np\nimport time\n\nnp.random.seed(42)\n\n# Simulate batch pre-computation vs real-time serving\n\nclass BatchRecommender:\n    \"\"\"Pre-compute recommendations offline, serve instantly.\"\"\"\n    \n    def __init__(self, n_users, n_items, n_factors=20):\n        # Simulate pre-computed user and item factors\n        self.user_factors = np.random.randn(n_users, n_factors)\n        self.item_factors = np.random.randn(n_items, n_factors)\n        \n        # Pre-compute top-k recommendations for all users\n        self.precomputed_recs = {}\n    \n    def batch_compute(self, top_k=20):\n        \"\"\"Batch compute recommendations for all users (offline).\"\"\"\n        start = time.time()\n        \n        for user_idx in range(len(self.user_factors)):\n            scores = self.user_factors[user_idx] @ self.item_factors.T\n            top_items = np.argsort(scores)[::-1][:top_k]\n            self.precomputed_recs[user_idx] = top_items\n        \n        return time.time() - start\n    \n    def serve(self, user_idx, k=5):\n        \"\"\"Serve pre-computed recommendations (real-time).\"\"\"\n        start = time.time()\n        recs = self.precomputed_recs.get(user_idx, [])[:k]\n        latency = time.time() - start\n        return recs, latency\n\nclass RealTimeRecommender:\n    \"\"\"Compute recommendations on-demand.\"\"\"\n    \n    def __init__(self, n_users, n_items, n_factors=20):\n        self.user_factors = np.random.randn(n_users, n_factors)\n        self.item_factors = np.random.randn(n_items, n_factors)\n    \n    def serve(self, user_idx, k=5):\n        \"\"\"Compute recommendations in real-time.\"\"\"\n        start = time.time()\n        scores = self.user_factors[user_idx] @ self.item_factors.T\n        top_items = np.argsort(scores)[::-1][:k]\n        latency = time.time() - start\n        return top_items, latency\n\n# Compare approaches at different scales\nprint(\"=== Batch vs Real-Time Recommendation ===\\n\")\nprint(f\"{'Scale':<30} {'Batch Prep':>12} {'Batch Serve':>13} {'Real-Time':>12}\")\nprint(\"-\" * 70)\n\nfor n_users, n_items in [(1000, 500), (10000, 5000), (50000, 10000)]:\n    batch = BatchRecommender(n_users, n_items)\n    realtime = RealTimeRecommender(n_users, n_items)\n    \n    # Batch: compute all, then serve\n    prep_time = batch.batch_compute(top_k=20)\n    _, batch_latency = batch.serve(0, k=5)\n    \n    # Real-time: compute on demand\n    _, rt_latency = realtime.serve(0, k=5)\n    \n    scale = f\"{n_users//1000}K users, {n_items//1000}K items\"\n    print(f\"{scale:<30} {prep_time*1000:>10.1f}ms {batch_latency*1000:>11.4f}ms {rt_latency*1000:>10.4f}ms\")\n\nprint(\"\\n=== Architecture Comparison ===\")\ncomparison = {\n    'Aspect': ['Serving latency', 'Freshness', 'Storage', 'Handles new items', 'Complexity'],\n    'Batch': ['<1ms (lookup)', 'Stale (hours old)', 'O(users \u00d7 k)', 'No (needs rebuild)', 'Low'],\n    'Real-Time': ['10-100ms (compute)', 'Always fresh', 'O(factors only)', 'Yes (immediate)', 'High'],\n    'Hybrid': ['<5ms (lookup + adjust)', 'Near-fresh', 'O(users \u00d7 k + rules)', 'Yes (with fallback)', 'Medium']\n}\nprint(pd.DataFrame(comparison).to_string(index=False))"
        ]
      ]
    },
