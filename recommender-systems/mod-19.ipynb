          "python",
          "import numpy as np\nimport time\n\n# Simulate different scale scenarios\nscenarios = [\n    (\"Small (1K users, 500 items)\", 1000, 500),\n    (\"Medium (10K users, 5K items)\", 10000, 5000),\n    (\"Large (100K users, 50K items)\", 100000, 50000),\n    (\"Netflix-scale (10M users, 50K items)\", 10000000, 50000),\n]\n\nprint(\"=== Scalability Analysis ===\\n\")\nprint(f\"{'Scenario':<40} {'User-sim pairs':>15} {'Item-sim pairs':>15}\")\nprint(\"-\" * 75)\n\nfor name, n_users, n_items in scenarios:\n    user_pairs = n_users * (n_users - 1) // 2\n    item_pairs = n_items * (n_items - 1) // 2\n    print(f\"{name:<40} {user_pairs:>15,} {item_pairs:>15,}\")\n\n# Time actual computation for small matrices\nprint(\"\\n=== Actual Computation Times ===\\n\")\nfrom sklearn.metrics.pairwise import cosine_similarity\n\nfor n in [100, 500, 1000, 5000]:\n    matrix = np.random.rand(n, 50)\n    start = time.time()\n    sim = cosine_similarity(matrix)\n    elapsed = time.time() - start\n    print(f\"  {n:>5} users \u00d7 50 dims: {elapsed*1000:>8.2f} ms ({sim.shape[0]}\u00d7{sim.shape[1]} similarity matrix)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "=== Scalability Analysis ===\n\nScenario                                 User-sim pairs  Item-sim pairs\n---------------------------------------------------------------------------\nSmall (1K users, 500 items)                     499,500         124,750\nMedium (10K users, 5K items)                 49,995,000      12,497,500\nLarge (100K users, 50K items)             4,999,950,000   1,249,975,000\nNetflix-scale (10M users, 50K items)  49,999,995,000,000   1,249,975,000\n\n=== Actual Computation Times ===\n\n    100 users \u00d7 50 dims:     0.12 ms (100\u00d7100 similarity matrix)\n    500 users \u00d7 50 dims:     1.45 ms (500\u00d7500 similarity matrix)\n   1000 users \u00d7 50 dims:     4.23 ms (1000\u00d71000 similarity matrix)\n   5000 users \u00d7 50 dims:    89.67 ms (5000\u00d75000 similarity matrix)"
        ]
