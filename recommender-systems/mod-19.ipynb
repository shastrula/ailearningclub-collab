          "python",
          "import numpy as np\nfrom collections import defaultdict\nimport time\n\nclass LSH:\n    \"\"\"Locality-Sensitive Hashing for approximate nearest neighbors.\"\"\"\n    \n    def __init__(self, n_dims, n_hash_tables=5, n_hash_bits=8):\n        self.n_tables = n_hash_tables\n        self.n_bits = n_hash_bits\n        \n        # Random hyperplanes for hashing\n        np.random.seed(42)\n        self.hyperplanes = [\n            np.random.randn(n_hash_bits, n_dims) for _ in range(n_hash_tables)\n        ]\n        \n        # Hash tables\n        self.tables = [defaultdict(list) for _ in range(n_hash_tables)]\n    \n    def _hash(self, vector, table_idx):\n        \"\"\"Compute hash for a vector using random hyperplanes.\"\"\"\n        projections = self.hyperplanes[table_idx] @ vector\n        bits = (projections > 0).astype(int)\n        return tuple(bits)\n    \n    def index(self, vectors, ids=None):\n        \"\"\"Index a set of vectors.\"\"\"\n        if ids is None:\n            ids = list(range(len(vectors)))\n        \n        for vec_id, vector in zip(ids, vectors):\n            for t in range(self.n_tables):\n                hash_key = self._hash(vector, t)\n                self.tables[t][hash_key].append(vec_id)\n    \n    def query(self, vector, k=5):\n        \"\"\"Find approximate nearest neighbors.\"\"\"\n        candidates = set()\n        \n        for t in range(self.n_tables):\n            hash_key = self._hash(vector, t)\n            candidates.update(self.tables[t].get(hash_key, []))\n        \n        return list(candidates)[:k * 3]  # Return candidate pool\n\n# Demo with item embeddings\nnp.random.seed(42)\nn_items = 1000\nembedding_dim = 20\n\n# Create item embeddings with cluster structure\nitem_embeddings = np.zeros((n_items, embedding_dim))\nfor i in range(n_items):\n    cluster = i % 10  # 10 clusters\n    item_embeddings[i] = np.random.randn(embedding_dim) * 0.3\n    item_embeddings[i, cluster*2:(cluster+1)*2] += 2  # Cluster signal\n\n# Build LSH index\nlsh = LSH(n_dims=embedding_dim, n_hash_tables=10, n_hash_bits=8)\nlsh.index(item_embeddings)\n\n# Query: find similar items to item 0\nquery_item = 0\nquery_vec = item_embeddings[query_item]\n\n# LSH search\nstart = time.time()\nlsh_candidates = lsh.query(query_vec, k=10)\nlsh_time = time.time() - start\n\n# Brute force search for comparison\nstart = time.time()\nall_sims = np.dot(item_embeddings, query_vec) / (\n    np.linalg.norm(item_embeddings, axis=1) * np.linalg.norm(query_vec) + 1e-8)\nbrute_top10 = np.argsort(all_sims)[::-1][1:11]\nbrute_time = time.time() - start\n\n# Compute actual similarities for LSH candidates\nif len(lsh_candidates) > 0:\n    lsh_sims = [(c, all_sims[c]) for c in lsh_candidates if c != query_item]\n    lsh_sims.sort(key=lambda x: x[1], reverse=True)\n    lsh_top10 = [c for c, _ in lsh_sims[:10]]\nelse:\n    lsh_top10 = []\n\n# Recall: how many of true top-10 did LSH find?\nrecall = len(set(lsh_top10) & set(brute_top10)) / len(brute_top10) if brute_top10.any() else 0\n\nprint(\"=== LSH Approximate Nearest Neighbors ===\")\nprint(f\"\\nDataset: {n_items} items, {embedding_dim} dimensions\")\nprint(f\"LSH config: {lsh.n_tables} tables, {lsh.n_bits} bits per hash\")\nprint(f\"\\nQuery: Find items similar to Item_0\")\nprint(f\"  LSH candidates found: {len(lsh_candidates)}\")\nprint(f\"  LSH time:   {lsh_time*1000:.3f} ms\")\nprint(f\"  Brute time: {brute_time*1000:.3f} ms\")\nprint(f\"  Recall@10:  {recall:.2%}\")\nprint(f\"\\nBrute-force top 5: {brute_top10[:5].tolist()}\")\nprint(f\"LSH top 5:         {lsh_top10[:5]}\")"
        ]
      ]
    },
