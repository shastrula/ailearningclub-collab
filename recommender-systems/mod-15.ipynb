          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# User interaction data with timestamps\nn_interactions = 200\nusers = np.random.randint(0, 8, n_interactions)\nitems = np.random.randint(0, 12, n_interactions)\nhours = np.random.randint(0, 24, n_interactions)\ndays = np.random.choice(['weekday', 'weekend'], n_interactions)\n\n# Create ratings that depend on context\nratings = np.zeros(n_interactions)\nfor idx in range(n_interactions):\n    base_rating = np.random.choice([3, 4])\n    \n    # User 0-3: prefer action during evening (18-23)\n    if users[idx] < 4 and items[idx] < 4:\n        if 18 <= hours[idx] <= 23:\n            ratings[idx] = 5\n        else:\n            ratings[idx] = 3\n    # User 4-7: prefer light content on weekends\n    elif users[idx] >= 4 and items[idx] >= 8:\n        if days[idx] == 'weekend':\n            ratings[idx] = 5\n        else:\n            ratings[idx] = 3\n    else:\n        ratings[idx] = base_rating\n\ninteractions_df = pd.DataFrame({\n    'user_id': users,\n    'item_id': items,\n    'rating': ratings,\n    'hour': hours,\n    'day_type': days\n})\n\n# Analyze temporal patterns\nprint(\"=== Temporal Context Analysis ===\\n\")\nprint(\"Average rating by time of day (User 0, Action items 0-3):\")\nuser0_action = interactions_df[(interactions_df['user_id'] == 0) & \n                                (interactions_df['item_id'] < 4)]\n\ntime_groups = pd.cut(user0_action['hour'], bins=[0, 6, 12, 18, 24], \n                     labels=['Night(0-6)', 'Morning(6-12)', 'Afternoon(12-18)', 'Evening(18-24)'])\nif len(user0_action) > 0:\n    time_stats = user0_action.groupby(time_groups, observed=True)['rating'].mean()\n    for period, avg in time_stats.items():\n        print(f\"  {period}: {avg:.2f}\")\n\nprint(\"\\nAverage rating by day type (User 5, Animation items 8-11):\")\nuser5_anim = interactions_df[(interactions_df['user_id'] == 5) & \n                              (interactions_df['item_id'] >= 8)]\nif len(user5_anim) > 0:\n    day_stats = user5_anim.groupby('day_type')['rating'].mean()\n    for day, avg in day_stats.items():\n        print(f\"  {day}: {avg:.2f}\")"
        ]
      ]
