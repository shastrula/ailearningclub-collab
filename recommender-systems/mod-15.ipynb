        [
          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Simulate user behavior that changes by time period\nitem_names = ['Action_1', 'Action_2', 'Drama_1', 'Drama_2', \n              'Comedy_1', 'Comedy_2', 'Docs_1', 'Docs_2']\n\n# User watches different genres at different times\n# Columns: items, Rows: time periods\ntime_preference_matrix = {\n    'User_0': {\n        'morning': np.array([0.2, 0.2, 0.3, 0.3, 0.8, 0.7, 0.5, 0.4]),\n        'afternoon': np.array([0.5, 0.5, 0.6, 0.5, 0.4, 0.3, 0.7, 0.6]),\n        'evening': np.array([0.9, 0.9, 0.4, 0.4, 0.3, 0.3, 0.2, 0.2]),\n    }\n}\n\n# Current context\ncurrent_time = 'evening'\nuser = 'User_0'\n\n# Context-free recommendation (average across all times)\ncontext_free = np.mean([time_preference_matrix[user][t] for t in ['morning', 'afternoon', 'evening']], axis=0)\n\n# Context-aware recommendation (use current time)\ncontext_aware = time_preference_matrix[user][current_time]\n\nprint(\"=== Time-Period Context Comparison (User_0) ===\\n\")\nprint(f\"Current context: {current_time}\\n\")\nprint(f\"{'Item':<12} {'Context-Free':>14} {'Context-Aware':>15} {'Difference':>12}\")\nprint(\"-\" * 56)\n\nfor i, item in enumerate(item_names):\n    diff = context_aware[i] - context_free[i]\n    marker = '\u2191' if diff > 0.1 else ('\u2193' if diff < -0.1 else ' ')\n    print(f\"{item:<12} {context_free[i]:>14.3f} {context_aware[i]:>15.3f} {diff:>+10.3f} {marker}\")\n\nprint(f\"\\n--- Top 3 Recommendations ---\")\nprint(f\"Context-free: {[item_names[i] for i in np.argsort(context_free)[::-1][:3]]}\")\nprint(f\"Context-aware ({current_time}): {[item_names[i] for i in np.argsort(context_aware)[::-1][:3]]}\")"
        ]
      ]
    },
