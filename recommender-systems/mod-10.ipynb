      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\n\n# Simulated user interaction log\nnp.random.seed(42)\n\ninteractions = pd.DataFrame({\n    'user_id': np.repeat(range(1, 8), 10),\n    'item_id': np.random.randint(1, 16, 70),\n    'event_type': np.random.choice(['view', 'click', 'add_cart', 'purchase', 'time_spent'], 70),\n    'value': np.random.uniform(0.1, 30, 70).round(1)\n})\n\n# Assign realistic values based on event type\nfor idx in interactions.index:\n    event = interactions.loc[idx, 'event_type']\n    if event == 'view':\n        interactions.loc[idx, 'value'] = 1\n    elif event == 'click':\n        interactions.loc[idx, 'value'] = np.random.choice([1, 2, 3])\n    elif event == 'add_cart':\n        interactions.loc[idx, 'value'] = np.random.choice([1, 2])\n    elif event == 'purchase':\n        interactions.loc[idx, 'value'] = 1\n    elif event == 'time_spent':\n        interactions.loc[idx, 'value'] = round(np.random.exponential(5), 1)\n\n# Signal strength mapping\nsignal_weights = {\n    'view': 1.0,\n    'click': 2.0,\n    'add_cart': 3.0,\n    'purchase': 5.0,\n    'time_spent': 0.5  # per minute\n}\n\nprint(\"=== Implicit Feedback Signals ===\\n\")\nprint(\"Signal Weights:\")\nfor signal, weight in signal_weights.items():\n    print(f\"  {signal:<12}: {weight}\")\n\nprint(f\"\\n--- Sample Interactions ---\")\nprint(interactions.head(15).to_string(index=False))\n\n# Aggregate into preference scores\ninteractions['weighted_score'] = interactions.apply(\n    lambda row: row['value'] * signal_weights[row['event_type']], axis=1\n)\n\nuser_item_scores = interactions.groupby(['user_id', 'item_id'])['weighted_score'].sum().reset_index()\nprint(f\"\\n--- Aggregated User-Item Scores (top 10) ---\")\nprint(user_item_scores.nlargest(10, 'weighted_score').to_string(index=False))"
        ]
      ]
    },
