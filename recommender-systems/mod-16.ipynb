          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Simulated browsing sessions\nitem_names = ['Laptop', 'Mouse', 'Keyboard', 'Monitor', 'Headphones',\n              'Phone', 'Phone Case', 'Charger', 'Tablet', 'Stylus',\n              'Camera', 'Tripod', 'SD Card', 'Lens', 'Camera Bag']\n\n# Sessions: sequences of items viewed\nsessions = [\n    [0, 1, 2, 3],      # Laptop \u2192 Mouse \u2192 Keyboard \u2192 Monitor\n    [0, 2, 1],          # Laptop \u2192 Keyboard \u2192 Mouse\n    [0, 1, 4],          # Laptop \u2192 Mouse \u2192 Headphones\n    [5, 6, 7],          # Phone \u2192 Phone Case \u2192 Charger\n    [5, 7, 6],          # Phone \u2192 Charger \u2192 Phone Case\n    [5, 6, 8],          # Phone \u2192 Phone Case \u2192 Tablet\n    [8, 9, 5],          # Tablet \u2192 Stylus \u2192 Phone\n    [10, 11, 12, 13],   # Camera \u2192 Tripod \u2192 SD Card \u2192 Lens\n    [10, 12, 14],       # Camera \u2192 SD Card \u2192 Camera Bag\n    [10, 13, 11, 14],   # Camera \u2192 Lens \u2192 Tripod \u2192 Camera Bag\n    [0, 1, 2, 4],       # Laptop \u2192 Mouse \u2192 Keyboard \u2192 Headphones\n    [5, 6, 7, 4],       # Phone \u2192 Phone Case \u2192 Charger \u2192 Headphones\n    [10, 11, 12],       # Camera \u2192 Tripod \u2192 SD Card\n    [0, 3, 4],          # Laptop \u2192 Monitor \u2192 Headphones\n    [8, 9, 7],          # Tablet \u2192 Stylus \u2192 Charger\n]\n\n# Build co-occurrence matrix (items that appear in same session)\nn_items = len(item_names)\ncooccurrence = np.zeros((n_items, n_items))\n\nfor session in sessions:\n    for i in range(len(session)):\n        for j in range(len(session)):\n            if i != j:\n                cooccurrence[session[i], session[j]] += 1\n\n# Normalize to probabilities\nrow_sums = cooccurrence.sum(axis=1, keepdims=True)\ncooccurrence_prob = np.divide(cooccurrence, row_sums, where=row_sums > 0)\n\nprint(\"=== Item Co-occurrence Matrix (Top Pairs) ===\\n\")\nprint(f\"{'Item A':<15} {'Item B':<15} {'Co-occur Count':>15}\")\nprint(\"-\" * 48)\n\n# Find top co-occurring pairs\npairs = []\nfor i in range(n_items):\n    for j in range(i+1, n_items):\n        if cooccurrence[i, j] > 0:\n            pairs.append((item_names[i], item_names[j], cooccurrence[i, j]))\n\npairs.sort(key=lambda x: x[2], reverse=True)\nfor a, b, count in pairs[:10]:\n    print(f\"{a:<15} {b:<15} {count:>15.0f}\")\n\n# Session-based recommendation\ndef recommend_from_session(current_items, cooccur_matrix, item_names_list, top_n=5):\n    \"\"\"Recommend items based on current session items.\"\"\"\n    scores = np.zeros(len(item_names_list))\n    \n    for item_idx in current_items:\n        scores += cooccur_matrix[item_idx]\n    \n    # Remove items already in session\n    for item_idx in current_items:\n        scores[item_idx] = 0\n    \n    top_indices = np.argsort(scores)[::-1][:top_n]\n    return [(item_names_list[i], scores[i]) for i in top_indices if scores[i] > 0]\n\nprint(\"\\n=== Session-Based Recommendations ===\\n\")\ntest_sessions = [\n    ([0], \"User browsing: Laptop\"),\n    ([0, 1], \"User browsing: Laptop \u2192 Mouse\"),\n    ([5, 6], \"User browsing: Phone \u2192 Phone Case\"),\n    ([10], \"User browsing: Camera\"),\n]\n\nfor session, description in test_sessions:\n    print(f\"{description}\")\n    recs = recommend_from_session(session, cooccurrence, item_names)\n    for item, score in recs[:3]:\n        print(f\"  \u2192 {item} (score: {score:.0f})\")\n    print()"
        ]
