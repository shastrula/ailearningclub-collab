          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\nitem_names = ['Laptop', 'Mouse', 'Keyboard', 'Monitor', 'Headphones',\n              'Phone', 'Phone Case', 'Charger', 'Tablet', 'Stylus',\n              'Camera', 'Tripod', 'SD Card', 'Lens', 'Camera Bag']\n\nsessions = [\n    [0, 1, 2, 3], [0, 2, 1], [0, 1, 4], [5, 6, 7], [5, 7, 6],\n    [5, 6, 8], [8, 9, 5], [10, 11, 12, 13], [10, 12, 14],\n    [10, 13, 11, 14], [0, 1, 2, 4], [5, 6, 7, 4], [10, 11, 12],\n    [0, 3, 4], [8, 9, 7],\n]\n\nn_items = len(item_names)\n\n# Build transition matrix: P(next_item | current_item)\ntransitions = np.zeros((n_items, n_items))\n\nfor session in sessions:\n    for i in range(len(session) - 1):\n        transitions[session[i], session[i+1]] += 1\n\n# Normalize rows to get probabilities\nrow_sums = transitions.sum(axis=1, keepdims=True)\ntransition_probs = np.divide(transitions, row_sums, where=row_sums > 0)\n\nprint(\"=== Transition Probabilities (Markov Chain) ===\\n\")\nprint(\"P(next | Laptop):\")\nlaptop_probs = transition_probs[0]\nfor idx in np.argsort(laptop_probs)[::-1][:5]:\n    if laptop_probs[idx] > 0:\n        print(f\"  \u2192 {item_names[idx]}: {laptop_probs[idx]:.3f}\")\n\nprint(\"\\nP(next | Camera):\")\ncamera_probs = transition_probs[10]\nfor idx in np.argsort(camera_probs)[::-1][:5]:\n    if camera_probs[idx] > 0:\n        print(f\"  \u2192 {item_names[idx]}: {camera_probs[idx]:.3f}\")\n\nprint(\"\\nP(next | Phone):\")\nphone_probs = transition_probs[5]\nfor idx in np.argsort(phone_probs)[::-1][:5]:\n    if phone_probs[idx] > 0:\n        print(f\"  \u2192 {item_names[idx]}: {phone_probs[idx]:.3f}\")\n\n# Multi-step prediction\ndef predict_next_k(current_item, transition_matrix, k=3):\n    \"\"\"Predict next k items using Markov chain.\"\"\"\n    predictions = []\n    visited = {current_item}\n    current = current_item\n    \n    for step in range(k):\n        probs = transition_matrix[current].copy()\n        probs[list(visited)] = 0  # Don't revisit\n        \n        if probs.sum() == 0:\n            break\n        \n        probs /= probs.sum()  # Re-normalize\n        next_item = np.argmax(probs)\n        predictions.append((item_names[next_item], probs[next_item]))\n        visited.add(next_item)\n        current = next_item\n    \n    return predictions\n\nprint(\"\\n=== Multi-Step Predictions ===\")\nprint(\"\\nStarting from 'Laptop', predicted sequence:\")\npreds = predict_next_k(0, transition_probs, k=4)\nseq = \"Laptop\"\nfor item, prob in preds:\n    seq += f\" \u2192 {item}({prob:.2f})\"\nprint(f\"  {seq}\")\n\nprint(\"\\nStarting from 'Camera', predicted sequence:\")\npreds = predict_next_k(10, transition_probs, k=4)\nseq = \"Camera\"\nfor item, prob in preds:\n    seq += f\" \u2192 {item}({prob:.2f})\"\nprint(f\"  {seq}\")"
        ]
