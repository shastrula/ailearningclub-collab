          "python",
          "import numpy as np\n\nitem_names = ['Laptop', 'Mouse', 'Keyboard', 'Monitor', 'Headphones',\n              'Phone', 'Phone Case', 'Charger', 'Tablet', 'Stylus',\n              'Camera', 'Tripod', 'SD Card', 'Lens', 'Camera Bag']\n\n# Co-occurrence matrix (reusing from above)\nsessions = [\n    [0, 1, 2, 3], [0, 2, 1], [0, 1, 4], [5, 6, 7], [5, 7, 6],\n    [5, 6, 8], [8, 9, 5], [10, 11, 12, 13], [10, 12, 14],\n    [10, 13, 11, 14], [0, 1, 2, 4], [5, 6, 7, 4], [10, 11, 12],\n    [0, 3, 4], [8, 9, 7],\n]\n\nn_items = len(item_names)\ncooccurrence = np.zeros((n_items, n_items))\nfor session in sessions:\n    for i in range(len(session)):\n        for j in range(len(session)):\n            if i != j:\n                cooccurrence[session[i], session[j]] += 1\n\ndef recommend_recency_weighted(session_items, cooccur_matrix, item_names_list, \n                                decay=0.7, top_n=5):\n    \"\"\"\n    Recommend based on session with recency weighting.\n    More recent items in the session contribute more.\n    \"\"\"\n    scores = np.zeros(len(item_names_list))\n    n = len(session_items)\n    \n    for position, item_idx in enumerate(session_items):\n        # Weight: more recent = higher weight\n        weight = decay ** (n - 1 - position)\n        scores += weight * cooccur_matrix[item_idx]\n    \n    # Remove items already in session\n    for item_idx in session_items:\n        scores[item_idx] = 0\n    \n    top_indices = np.argsort(scores)[::-1][:top_n]\n    return [(item_names_list[i], scores[i]) for i in top_indices if scores[i] > 0]\n\n# Compare uniform vs recency-weighted\nsession = [0, 1, 2]  # Laptop \u2192 Mouse \u2192 Keyboard\n\nprint(\"=== Recency-Weighted vs Uniform Session Scoring ===\")\nprint(f\"Session: Laptop \u2192 Mouse \u2192 Keyboard\\n\")\n\n# Uniform (all items equal weight)\nuniform_recs = []\nscores_u = np.zeros(n_items)\nfor item_idx in session:\n    scores_u += cooccurrence[item_idx]\nfor idx in session:\n    scores_u[idx] = 0\ntop_u = np.argsort(scores_u)[::-1][:5]\nuniform_recs = [(item_names[i], scores_u[i]) for i in top_u if scores_u[i] > 0]\n\n# Recency-weighted (last item = most important)\nrecency_recs = recommend_recency_weighted(session, cooccurrence, item_names)\n\nprint(f\"{'Rank':<5} {'Uniform':<25} {'Recency-Weighted':<25}\")\nprint(\"-\" * 58)\nfor i in range(min(5, len(uniform_recs), len(recency_recs))):\n    u_item = f\"{uniform_recs[i][0]} ({uniform_recs[i][1]:.1f})\" if i < len(uniform_recs) else \"\"\n    r_item = f\"{recency_recs[i][0]} ({recency_recs[i][1]:.1f})\" if i < len(recency_recs) else \"\"\n    print(f\"{i+1:<5} {u_item:<25} {r_item:<25}\")\n\nprint(\"\\nRecency weighting emphasizes items related to the LAST viewed item.\")"
