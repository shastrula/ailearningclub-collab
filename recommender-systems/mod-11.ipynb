        [
          "python",
          "import numpy as np\n\ndef jaccard_similarity(set_a, set_b):\n    \"\"\"Jaccard similarity: |intersection| / |union|.\"\"\"\n    intersection = len(set_a & set_b)\n    union = len(set_a | set_b)\n    return intersection / union if union > 0 else 0.0\n\ndef jaccard_from_ratings(ratings_a, ratings_b, threshold=3.5):\n    \"\"\"Jaccard on items rated above threshold.\"\"\"\n    liked_a = set(np.where(ratings_a >= threshold)[0])\n    liked_b = set(np.where(ratings_b >= threshold)[0])\n    return jaccard_similarity(liked_a, liked_b)\n\n# Users with binary-like preferences\nusers = {\n    'Alice': np.array([5, 4, 5, 4, 1, 1, 2, 1, 1, 2]),\n    'Bob':   np.array([5, 5, 4, 4, 2, 1, 1, 2, 1, 1]),\n    'Carol': np.array([1, 2, 1, 1, 5, 4, 5, 5, 4, 5]),\n    'Dave':  np.array([4, 5, 0, 0, 0, 0, 0, 0, 0, 0]),  # Very few ratings\n}\n\nprint(\"=== Jaccard Similarity (threshold=3.5) ===\\n\")\nprint(f\"{'User':<8} {'Liked Items':<30}\")\nprint(\"-\" * 40)\nfor name, ratings in users.items():\n    liked = set(np.where(ratings >= 3.5)[0])\n    print(f\"{name:<8} {str(liked):<30}\")\n\nprint(f\"\\n{'Pair':<20} {'Jaccard':>10} {'Cosine':>10} {'Pearson':>10}\")\nprint(\"-\" * 55)\n\npairs = [('Alice', 'Bob'), ('Alice', 'Carol'), ('Alice', 'Dave'), ('Bob', 'Carol')]\nfor name_a, name_b in pairs:\n    j = jaccard_from_ratings(users[name_a], users[name_b])\n    mask = (users[name_a] > 0) & (users[name_b] > 0)\n    if mask.sum() >= 2:\n        c = np.dot(users[name_a][mask], users[name_b][mask]) / (\n            np.linalg.norm(users[name_a][mask]) * np.linalg.norm(users[name_b][mask]))\n    else:\n        c = 0.0\n    from scipy.stats import pearsonr\n    if mask.sum() >= 3 and np.std(users[name_a][mask]) > 0 and np.std(users[name_b][mask]) > 0:\n        p, _ = pearsonr(users[name_a][mask], users[name_b][mask])\n    else:\n        p = 0.0\n    print(f\"{name_a + ' vs ' + name_b:<20} {j:>10.4f} {c:>10.4f} {p:>10.4f}\")"
        ]
      ]
    },
