        [
          "python",
          "import numpy as np\nfrom scipy.stats import pearsonr\n\ndef pearson_on_corated(ratings_a, ratings_b):\n    \"\"\"Pearson correlation on co-rated items only.\"\"\"\n    mask = (ratings_a > 0) & (ratings_b > 0)\n    if mask.sum() < 3:  # Need at least 3 for meaningful correlation\n        return 0.0\n    a = ratings_a[mask]\n    b = ratings_b[mask]\n    if np.std(a) == 0 or np.std(b) == 0:\n        return 0.0\n    corr, _ = pearsonr(a, b)\n    return corr\n\n# Users with different rating scales but same relative preferences\nusers = {\n    'Alice':    np.array([5, 4, 5, 3, 2, 1, 1, 2, 3, 4]),  # Generous rater\n    'Bob':      np.array([3, 2, 3, 1, 1, 0, 0, 1, 2, 3]),  # Strict rater, same preferences\n    'Carol':    np.array([1, 2, 1, 3, 4, 5, 5, 4, 3, 2]),  # Opposite preferences\n    'Dave':     np.array([5, 4, 5, 3, 2, 0, 1, 0, 3, 4]),  # Similar to Alice, some missing\n    'Eve':      np.array([3, 3, 3, 3, 3, 3, 3, 3, 3, 3]),  # No variance (rates everything 3)\n}\n\nprint(\"=== Pearson Correlation vs Cosine ===\\n\")\nprint(f\"{'Pair':<20} {'Pearson':>10} {'Cosine':>10} {'Interpretation':<30}\")\nprint(\"-\" * 75)\n\ndef cosine_sim(a, b):\n    mask = (a > 0) & (b > 0)\n    if mask.sum() < 2: return 0.0\n    x, y = a[mask], b[mask]\n    d = np.linalg.norm(x) * np.linalg.norm(y)\n    return np.dot(x, y) / d if d > 0 else 0.0\n\npairs_info = [\n    ('Alice', 'Bob', 'Same prefs, different scales'),\n    ('Alice', 'Carol', 'Opposite preferences'),\n    ('Alice', 'Dave', 'Very similar'),\n    ('Alice', 'Eve', 'No variance in Eve'),\n]\n\nfor name_a, name_b, desc in pairs_info:\n    p = pearson_on_corated(users[name_a], users[name_b])\n    c = cosine_sim(users[name_a], users[name_b])\n    print(f\"{name_a + ' vs ' + name_b:<20} {p:>10.4f} {c:>10.4f} {desc:<30}\")\n\nprint(\"\\nKey insight: Pearson detects that Alice and Bob have IDENTICAL\")\nprint(\"preference patterns despite Bob rating 2 points lower on average.\")"
        ]
      ]
    },
