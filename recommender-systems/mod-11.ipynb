      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\n\ndef cosine_similarity_manual(vec_a, vec_b):\n    \"\"\"Compute cosine similarity between two vectors.\"\"\"\n    dot_product = np.dot(vec_a, vec_b)\n    norm_a = np.linalg.norm(vec_a)\n    norm_b = np.linalg.norm(vec_b)\n    if norm_a == 0 or norm_b == 0:\n        return 0.0\n    return dot_product / (norm_a * norm_b)\n\ndef cosine_on_corated(ratings_a, ratings_b):\n    \"\"\"Cosine similarity only on co-rated items.\"\"\"\n    mask = (ratings_a > 0) & (ratings_b > 0)\n    if mask.sum() < 2:\n        return 0.0\n    a = ratings_a[mask]\n    b = ratings_b[mask]\n    return cosine_similarity_manual(a, b)\n\n# Example users with different patterns\nusers = {\n    'Alice':  np.array([5, 4, 5, 0, 2, 0, 1, 0, 3, 0]),\n    'Bob':    np.array([4, 5, 4, 0, 1, 0, 2, 0, 2, 0]),\n    'Carol':  np.array([2, 1, 2, 0, 5, 0, 4, 0, 5, 0]),\n    'Dave':   np.array([5, 4, 5, 0, 2, 0, 1, 0, 3, 0]),  # Same as Alice\n    'Eve':    np.array([3, 2, 3, 0, 1, 0, 1, 0, 2, 0]),  # Strict version of Alice\n}\n\nitem_names = [f'Item_{i+1}' for i in range(10)]\n\nprint(\"=== Cosine Similarity (Co-rated Only) ===\\n\")\nprint(f\"{'Pair':<20} {'Co-rated':>10} {'Cosine':>10}\")\nprint(\"-\" * 42)\n\npairs = [('Alice', 'Bob'), ('Alice', 'Carol'), ('Alice', 'Dave'), ('Alice', 'Eve')]\nfor name_a, name_b in pairs:\n    sim = cosine_on_corated(users[name_a], users[name_b])\n    co_rated = ((users[name_a] > 0) & (users[name_b] > 0)).sum()\n    print(f\"{name_a + ' vs ' + name_b:<20} {co_rated:>10} {sim:>10.4f}\")\n\nprint(\"\\nNote: Alice and Dave are identical (cosine=1.0)\")\nprint(\"Note: Alice and Eve have same preferences but different scales (cosine~0.99)\")"
        ]
      ]
    },
    {
