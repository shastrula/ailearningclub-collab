        [
          "python",
          "import numpy as np\nfrom scipy.stats import pearsonr\n\n# Full rating matrix\nratings = np.array([\n    [5, 4, 5, 0, 2, 1, 0, 3, 0, 2],\n    [4, 5, 4, 0, 1, 2, 0, 2, 0, 1],\n    [5, 4, 5, 3, 2, 0, 1, 0, 3, 2],\n    [2, 1, 2, 5, 4, 5, 4, 0, 5, 4],\n    [1, 2, 1, 4, 5, 4, 5, 0, 4, 5],\n    [3, 3, 3, 3, 3, 3, 3, 3, 3, 3],  # Neutral user\n], dtype=float)\n\ndef predict_knn(user_idx, item_idx, ratings_mat, sim_func, k=3):\n    \"\"\"k-NN prediction using specified similarity function.\"\"\"\n    if ratings_mat[user_idx, item_idx] > 0:\n        return ratings_mat[user_idx, item_idx]\n    \n    similarities = []\n    for other_idx in range(len(ratings_mat)):\n        if other_idx == user_idx:\n            continue\n        if ratings_mat[other_idx, item_idx] == 0:\n            continue\n        sim = sim_func(ratings_mat[user_idx], ratings_mat[other_idx])\n        similarities.append((other_idx, sim))\n    \n    if not similarities:\n        return 3.0\n    \n    similarities.sort(key=lambda x: abs(x[1]), reverse=True)\n    top_k = similarities[:k]\n    \n    num = sum(sim * ratings_mat[idx, item_idx] for idx, sim in top_k)\n    den = sum(abs(sim) for _, sim in top_k)\n    \n    return np.clip(num / den, 1, 5) if den > 0 else 3.0\n\ndef cosine_func(a, b):\n    mask = (a > 0) & (b > 0)\n    if mask.sum() < 2: return 0.0\n    x, y = a[mask], b[mask]\n    d = np.linalg.norm(x) * np.linalg.norm(y)\n    return np.dot(x, y) / d if d > 0 else 0.0\n\ndef pearson_func(a, b):\n    mask = (a > 0) & (b > 0)\n    if mask.sum() < 3: return 0.0\n    x, y = a[mask], b[mask]\n    if np.std(x) == 0 or np.std(y) == 0: return 0.0\n    c, _ = pearsonr(x, y)\n    return c\n\n# Predict missing values for User 1 (item indices 3, 6, 8)\nprint(\"=== Prediction Comparison by Similarity Function ===\\n\")\nprint(f\"{'Item':<8} {'Cosine':>10} {'Pearson':>10}\")\nprint(\"-\" * 30)\n\nfor item_idx in [3, 6, 8]:\n    pred_cos = predict_knn(0, item_idx, ratings, cosine_func, k=3)\n    pred_pea = predict_knn(0, item_idx, ratings, pearson_func, k=3)\n    print(f\"Item_{item_idx+1:<3} {pred_cos:>10.2f} {pred_pea:>10.2f}\")"
        ]
      ]
