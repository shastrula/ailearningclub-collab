        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.metrics.pairwise import cosine_similarity\n\nmovie_titles = [\n    'The Matrix', 'Inception', 'Interstellar', 'The Dark Knight',\n    'Pulp Fiction', 'Fight Club', 'Forrest Gump', 'The Shawshank Redemption',\n    'The Godfather', 'Goodfellas', 'Toy Story', 'Finding Nemo',\n    'The Lion King', 'Spirited Away', 'Parasite'\n]\n\nratings_data = np.array([\n    [5, 5, 4, 5, 3, 4, 0, 0, 0, 2, 0, 0, 0, 0, 3],\n    [4, 5, 5, 4, 0, 3, 0, 0, 0, 0, 0, 0, 0, 2, 0],\n    [5, 4, 5, 4, 2, 0, 0, 0, 0, 0, 1, 0, 0, 0, 3],\n    [4, 4, 0, 5, 3, 5, 0, 2, 0, 3, 0, 0, 0, 0, 0],\n    [2, 0, 3, 0, 5, 4, 5, 5, 5, 4, 0, 0, 0, 0, 4],\n    [0, 2, 0, 0, 4, 3, 4, 5, 5, 5, 0, 0, 0, 0, 5],\n    [0, 0, 2, 0, 5, 0, 5, 4, 4, 4, 2, 0, 0, 0, 4],\n    [0, 0, 0, 0, 0, 0, 3, 0, 0, 0, 5, 5, 5, 4, 0],\n    [2, 0, 0, 0, 0, 0, 4, 0, 0, 0, 4, 5, 5, 5, 0],\n    [0, 0, 0, 2, 0, 0, 3, 0, 0, 0, 5, 4, 4, 5, 0],\n], dtype=float)\n\nuser_names = [f'User_{i+1}' for i in range(10)]\n\n# Compute user similarity\nuser_sim = cosine_similarity(ratings_data)\n\ndef predict_rating(user_idx, item_idx, ratings, similarity, k=3):\n    \"\"\"Predict rating using k-nearest neighbors.\"\"\"\n    # Find users who rated this item\n    rated_mask = ratings[:, item_idx] > 0\n    rated_mask[user_idx] = False  # Exclude target user\n    \n    if not rated_mask.any():\n        return 0.0  # No neighbors rated this item\n    \n    # Get similarities to users who rated this item\n    neighbor_sims = similarity[user_idx][rated_mask]\n    neighbor_ratings = ratings[rated_mask, item_idx]\n    \n    # Select top-k neighbors\n    if len(neighbor_sims) > k:\n        top_k_idx = np.argsort(neighbor_sims)[::-1][:k]\n        neighbor_sims = neighbor_sims[top_k_idx]\n        neighbor_ratings = neighbor_ratings[top_k_idx]\n    \n    # Weighted average\n    if neighbor_sims.sum() == 0:\n        return neighbor_ratings.mean()\n    \n    predicted = np.dot(neighbor_sims, neighbor_ratings) / np.abs(neighbor_sims).sum()\n    return np.clip(predicted, 1, 5)\n\n# Predict ratings for User_1 on unrated movies\nuser_idx = 0\nprint(f\"=== Predictions for {user_names[user_idx]} (k=3) ===\")\nprint(f\"{'Movie':<28} {'Predicted':>10} {'Neighbors Used':>15}\")\nprint(\"-\" * 55)\n\nfor item_idx in range(len(movie_titles)):\n    if ratings_data[user_idx, item_idx] == 0:  # Unrated\n        pred = predict_rating(user_idx, item_idx, ratings_data, user_sim, k=3)\n        if pred > 0:\n            print(f\"{movie_titles[item_idx]:<28} {pred:>10.2f} {'3':>15}\")\n\n# Generate top-5 recommendations for User_1\nprint(f\"\\n=== Top 5 Recommendations for {user_names[user_idx]} ===\")\npredictions = []\nfor item_idx in range(len(movie_titles)):\n    if ratings_data[user_idx, item_idx] == 0:\n        pred = predict_rating(user_idx, item_idx, ratings_data, user_sim, k=3)\n        if pred > 0:\n            predictions.append((movie_titles[item_idx], pred))\n\npredictions.sort(key=lambda x: x[1], reverse=True)\nfor title, score in predictions[:5]:\n    print(f\"  {title}: {score:.2f}\")"
        ]
      ]
