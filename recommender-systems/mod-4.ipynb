        [
          "python",
          "import numpy as np\nfrom sklearn.metrics.pairwise import cosine_similarity\nfrom scipy.stats import pearsonr\n\n# Compare metrics for two users\nuser_a = np.array([5, 4, 5, 4, 3, 0, 0, 0])  # Action fan (generous rater)\nuser_b = np.array([3, 2, 3, 2, 1, 0, 0, 0])  # Action fan (strict rater)\nuser_c = np.array([0, 0, 0, 0, 0, 5, 4, 5])  # Animation fan\n\n# Only compare on co-rated items\ndef compare_metrics(u1, u2, name1, name2):\n    # Find co-rated items (both non-zero)\n    mask = (u1 > 0) & (u2 > 0)\n    \n    if mask.sum() < 2:\n        print(f\"  {name1} vs {name2}: Not enough co-rated items\")\n        return\n    \n    u1_co = u1[mask]\n    u2_co = u2[mask]\n    \n    # Cosine similarity\n    cos_sim = np.dot(u1_co, u2_co) / (np.linalg.norm(u1_co) * np.linalg.norm(u2_co))\n    \n    # Pearson correlation\n    if np.std(u1_co) > 0 and np.std(u2_co) > 0:\n        pearson, _ = pearsonr(u1_co, u2_co)\n    else:\n        pearson = 0.0\n    \n    # Mean-centered cosine\n    u1_centered = u1_co - u1_co.mean()\n    u2_centered = u2_co - u2_co.mean()\n    denom = np.linalg.norm(u1_centered) * np.linalg.norm(u2_centered)\n    adj_cos = np.dot(u1_centered, u2_centered) / denom if denom > 0 else 0\n    \n    print(f\"  {name1} vs {name2}:\")\n    print(f\"    Co-rated items: {mask.sum()}\")\n    print(f\"    Cosine:         {cos_sim:.4f}\")\n    print(f\"    Pearson:        {pearson:.4f}\")\n    print(f\"    Adjusted Cos:   {adj_cos:.4f}\")\n\nprint(\"=== Similarity Metric Comparison ===\\n\")\ncompare_metrics(user_a, user_b, \"User_A (generous)\", \"User_B (strict)\")\nprint()\ncompare_metrics(user_a, user_c, \"User_A (action)\", \"User_C (animation)\")\nprint()\nprint(\"Key insight: Pearson captures that A and B have identical\")\nprint(\"preferences despite different rating scales.\")"
        ]
      ]
