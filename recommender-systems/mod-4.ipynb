          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.metrics.pairwise import cosine_similarity\n\n# Rating matrix (same as above)\nratings_data = np.array([\n    [5, 5, 4, 5, 3, 4, 0, 0, 0, 2, 0, 0, 0, 0, 3],\n    [4, 5, 5, 4, 0, 3, 0, 0, 0, 0, 0, 0, 0, 2, 0],\n    [5, 4, 5, 4, 2, 0, 0, 0, 0, 0, 1, 0, 0, 0, 3],\n    [4, 4, 0, 5, 3, 5, 0, 2, 0, 3, 0, 0, 0, 0, 0],\n    [2, 0, 3, 0, 5, 4, 5, 5, 5, 4, 0, 0, 0, 0, 4],\n    [0, 2, 0, 0, 4, 3, 4, 5, 5, 5, 0, 0, 0, 0, 5],\n    [0, 0, 2, 0, 5, 0, 5, 4, 4, 4, 2, 0, 0, 0, 4],\n    [0, 0, 0, 0, 0, 0, 3, 0, 0, 0, 5, 5, 5, 4, 0],\n    [2, 0, 0, 0, 0, 0, 4, 0, 0, 0, 4, 5, 5, 5, 0],\n    [0, 0, 0, 2, 0, 0, 3, 0, 0, 0, 5, 4, 4, 5, 0],\n], dtype=float)\n\nuser_names = [f'User_{i+1}' for i in range(10)]\n\n# Method 1: Cosine Similarity (treats 0 as a feature value)\nuser_sim_cosine = cosine_similarity(ratings_data)\n\n# Method 2: Adjusted Cosine (mean-center each user first)\n# Only consider non-zero entries for mean computation\nratings_centered = ratings_data.copy()\nfor i in range(ratings_data.shape[0]):\n    mask = ratings_data[i] > 0\n    if mask.any():\n        user_mean = ratings_data[i][mask].mean()\n        ratings_centered[i][mask] = ratings_data[i][mask] - user_mean\n        ratings_centered[i][~mask] = 0  # Keep unrated as 0\n\nuser_sim_adjusted = cosine_similarity(ratings_centered)\n\nprint(\"=== User Similarity (Cosine) ===\")\nsim_df = pd.DataFrame(user_sim_cosine, index=user_names, columns=user_names)\nprint(sim_df.round(3).to_string())\n\nprint(\"\\n=== Top 3 Most Similar Users ===\")\nfor i in range(3):\n    sims = user_sim_cosine[i].copy()\n    sims[i] = -1  # Exclude self\n    top_3 = np.argsort(sims)[::-1][:3]\n    print(f\"{user_names[i]}: {[(user_names[j], round(sims[j], 3)) for j in top_3]}\")"
