          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics.pairwise import cosine_similarity\n\nmovies = pd.DataFrame({\n    'movie_id': range(1, 9),\n    'title': ['The Matrix', 'Inception', 'The Dark Knight', 'Fight Club',\n              'Toy Story', 'Finding Nemo', 'The Lion King', 'Spirited Away'],\n    'genres': ['action sci-fi', 'action sci-fi', 'action crime', 'drama thriller',\n               'animation comedy', 'animation comedy', 'animation drama', 'animation fantasy']\n})\n\n# User with changing preferences over time\nuser_history = pd.DataFrame({\n    'movie_id': [5, 6, 7, 1, 2, 3],\n    'rating':   [5, 5, 4, 5, 5, 5],\n    'days_ago': [365, 300, 250, 30, 20, 10]  # Recent = action fan\n})\n\ntfidf = TfidfVectorizer(stop_words='english')\ntfidf_matrix = tfidf.fit_transform(movies['genres'])\nfeature_names = tfidf.get_feature_names_out()\n\ndef build_decayed_profile(history, tfidf_mat, half_life=90):\n    \"\"\"Build profile with exponential time decay.\"\"\"\n    decay_weights = np.exp(-0.693 * history['days_ago'].values / half_life)\n    rating_weights = (history['rating'].values - 3) / 2\n    combined_weights = decay_weights * rating_weights\n    \n    movie_indices = history['movie_id'].values - 1\n    movie_vectors = tfidf_mat[movie_indices].toarray()\n    \n    weighted_vectors = movie_vectors * combined_weights.reshape(-1, 1)\n    return weighted_vectors.sum(axis=0) / np.abs(combined_weights).sum()\n\n# Compare profiles with and without decay\nprofile_no_decay = build_decayed_profile(user_history, tfidf_matrix, half_life=99999)\nprofile_with_decay = build_decayed_profile(user_history, tfidf_matrix, half_life=90)\n\nprint(\"=== Temporal Preference Decay ===\")\nprint(\"\\nWithout decay (all ratings equal weight):\")\nfor idx in np.argsort(profile_no_decay)[::-1][:5]:\n    if profile_no_decay[idx] > 0.01:\n        print(f\"  {feature_names[idx]:>12}: {profile_no_decay[idx]:.4f}\")\n\nprint(\"\\nWith decay (half-life = 90 days):\")\nfor idx in np.argsort(profile_with_decay)[::-1][:5]:\n    if profile_with_decay[idx] > 0.01:\n        print(f\"  {feature_names[idx]:>12}: {profile_with_decay[idx]:.4f}\")\n\nprint(\"\\n--- Interpretation ---\")\nprint(\"Recent activity (action/sci-fi) dominates the decayed profile\")\nprint(\"Old activity (animation) is down-weighted\")"
        ]
      ]
