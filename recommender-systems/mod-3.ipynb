          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics.pairwise import cosine_similarity\n\nmovies = pd.DataFrame({\n    'movie_id': range(1, 11),\n    'title': ['The Matrix', 'Inception', 'The Dark Knight', 'Fight Club',\n              'Toy Story', 'Finding Nemo', 'The Godfather', 'Pulp Fiction',\n              'Interstellar', 'Parasite'],\n    'genres': ['action sci-fi', 'action sci-fi', 'action crime', 'drama thriller',\n               'animation comedy', 'animation comedy', 'crime drama', 'crime thriller',\n               'sci-fi drama', 'thriller drama']\n})\n\ntfidf = TfidfVectorizer(stop_words='english')\ntfidf_matrix = tfidf.fit_transform(movies['genres'])\n\n# New user with only 1 rating vs experienced user with 5 ratings\nnew_user_ratings = pd.DataFrame({'movie_id': [1], 'rating': [5]})\nexp_user_ratings = pd.DataFrame({'movie_id': [1, 2, 3, 8, 9], 'rating': [5, 4, 5, 3, 4]})\n\ndef build_profile_with_confidence(ratings_df, tfidf_mat, n_total_movies):\n    \"\"\"Build profile with confidence score.\"\"\"\n    normalized_ratings = (ratings_df['rating'].values - 3) / 2\n    movie_indices = ratings_df['movie_id'].values - 1\n    movie_vectors = tfidf_mat[movie_indices].toarray()\n    weighted_vectors = movie_vectors * normalized_ratings.reshape(-1, 1)\n    profile = weighted_vectors.mean(axis=0)\n    \n    # Confidence based on number of ratings\n    n_ratings = len(ratings_df)\n    confidence = 1 - np.exp(-n_ratings / 5)  # Approaches 1 with more ratings\n    \n    return profile, confidence\n\nprofile_new, conf_new = build_profile_with_confidence(new_user_ratings, tfidf_matrix, 10)\nprofile_exp, conf_exp = build_profile_with_confidence(exp_user_ratings, tfidf_matrix, 10)\n\nprint(\"=== Profile Confidence ===\")\nprint(f\"New user (1 rating):   confidence = {conf_new:.4f}\")\nprint(f\"Experienced user (5 ratings): confidence = {conf_exp:.4f}\")\nprint(\"\\nStrategy: Blend with popularity-based recommendations\")\nprint(f\"  New user:        {(1-conf_new)*100:.0f}% popularity + {conf_new*100:.0f}% personalized\")\nprint(f\"  Experienced user: {(1-conf_exp)*100:.0f}% popularity + {conf_exp*100:.0f}% personalized\")"
