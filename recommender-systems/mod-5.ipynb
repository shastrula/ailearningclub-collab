        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.metrics.pairwise import cosine_similarity\n\nmovie_titles = [\n    'The Matrix', 'Inception', 'Interstellar', 'The Dark Knight',\n    'Pulp Fiction', 'Fight Club', 'Forrest Gump', 'The Shawshank Redemption',\n    'The Godfather', 'Goodfellas', 'Toy Story', 'Finding Nemo',\n    'The Lion King', 'Spirited Away', 'Parasite'\n]\n\nratings_data = np.array([\n    [5, 5, 4, 5, 3, 4, 0, 0, 0, 2, 0, 0, 0, 0, 3],\n    [4, 5, 5, 4, 0, 3, 0, 0, 0, 0, 0, 0, 0, 2, 0],\n    [5, 4, 5, 4, 2, 0, 0, 0, 0, 0, 1, 0, 0, 0, 3],\n    [4, 4, 0, 5, 3, 5, 0, 2, 0, 3, 0, 0, 0, 0, 0],\n    [2, 0, 3, 0, 5, 4, 5, 5, 5, 4, 0, 0, 0, 0, 4],\n    [0, 2, 0, 0, 4, 3, 4, 5, 5, 5, 0, 0, 0, 0, 5],\n    [0, 0, 2, 0, 5, 0, 5, 4, 4, 4, 2, 0, 0, 0, 4],\n    [0, 0, 0, 0, 0, 0, 3, 0, 0, 0, 5, 5, 5, 4, 0],\n    [2, 0, 0, 0, 0, 0, 4, 0, 0, 0, 4, 5, 5, 5, 0],\n    [0, 0, 0, 2, 0, 0, 3, 0, 0, 0, 5, 4, 4, 5, 0],\n], dtype=float)\n\n# User similarity\nuser_sim = cosine_similarity(ratings_data)\n\n# Item similarity (adjusted cosine)\nratings_centered = ratings_data.copy()\nfor i in range(ratings_data.shape[0]):\n    mask = ratings_data[i] > 0\n    if mask.any():\n        ratings_centered[i][mask] -= ratings_data[i][mask].mean()\n        ratings_centered[i][~mask] = 0\nitem_sim = cosine_similarity(ratings_centered.T)\n\ndef predict_user_based(user_idx, item_idx, ratings, sim, k=3):\n    rated_mask = ratings[:, item_idx] > 0\n    rated_mask[user_idx] = False\n    if not rated_mask.any():\n        return 0.0\n    neighbor_sims = sim[user_idx][rated_mask]\n    neighbor_ratings = ratings[rated_mask, item_idx]\n    if len(neighbor_sims) > k:\n        top_k = np.argsort(neighbor_sims)[::-1][:k]\n        neighbor_sims = neighbor_sims[top_k]\n        neighbor_ratings = neighbor_ratings[top_k]\n    if neighbor_sims.sum() == 0:\n        return neighbor_ratings.mean()\n    return np.clip(np.dot(neighbor_sims, neighbor_ratings) / neighbor_sims.sum(), 1, 5)\n\ndef predict_item_based(user_idx, item_idx, ratings, sim, k=5):\n    user_ratings = ratings[user_idx]\n    rated_mask = user_ratings > 0\n    if not rated_mask.any():\n        return 0.0\n    sims = sim[item_idx][rated_mask]\n    values = user_ratings[rated_mask]\n    if len(sims) > k:\n        top_k = np.argsort(np.abs(sims))[::-1][:k]\n        sims = sims[top_k]\n        values = values[top_k]\n    pos_mask = sims > 0\n    if not pos_mask.any():\n        return 0.0\n    return np.clip(np.dot(sims[pos_mask], values[pos_mask]) / sims[pos_mask].sum(), 1, 5)\n\n# Compare predictions for User_5 (drama fan)\nuser_idx = 4\nprint(\"=== Comparison: User-Based vs Item-Based for User_5 ===\")\nprint(f\"{'Movie':<28} {'User-Based':>12} {'Item-Based':>12}\")\nprint(\"-\" * 55)\n\nfor item_idx in range(len(movie_titles)):\n    if ratings_data[user_idx, item_idx] == 0:\n        ub_pred = predict_user_based(user_idx, item_idx, ratings_data, user_sim, k=3)\n        ib_pred = predict_item_based(user_idx, item_idx, ratings_data, item_sim, k=5)\n        if ub_pred > 0 or ib_pred > 0:\n            print(f\"{movie_titles[item_idx]:<28} {ub_pred:>12.2f} {ib_pred:>12.2f}\")"
        ]
