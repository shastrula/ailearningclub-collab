        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.metrics.pairwise import cosine_similarity\n\nmovie_titles = [\n    'The Matrix', 'Inception', 'Interstellar', 'The Dark Knight',\n    'Pulp Fiction', 'Fight Club', 'Forrest Gump', 'The Shawshank Redemption',\n    'The Godfather', 'Goodfellas', 'Toy Story', 'Finding Nemo',\n    'The Lion King', 'Spirited Away', 'Parasite'\n]\n\nratings_data = np.array([\n    [5, 5, 4, 5, 3, 4, 0, 0, 0, 2, 0, 0, 0, 0, 3],\n    [4, 5, 5, 4, 0, 3, 0, 0, 0, 0, 0, 0, 0, 2, 0],\n    [5, 4, 5, 4, 2, 0, 0, 0, 0, 0, 1, 0, 0, 0, 3],\n    [4, 4, 0, 5, 3, 5, 0, 2, 0, 3, 0, 0, 0, 0, 0],\n    [2, 0, 3, 0, 5, 4, 5, 5, 5, 4, 0, 0, 0, 0, 4],\n    [0, 2, 0, 0, 4, 3, 4, 5, 5, 5, 0, 0, 0, 0, 5],\n    [0, 0, 2, 0, 5, 0, 5, 4, 4, 4, 2, 0, 0, 0, 4],\n    [0, 0, 0, 0, 0, 0, 3, 0, 0, 0, 5, 5, 5, 4, 0],\n    [2, 0, 0, 0, 0, 0, 4, 0, 0, 0, 4, 5, 5, 5, 0],\n    [0, 0, 0, 2, 0, 0, 3, 0, 0, 0, 5, 4, 4, 5, 0],\n], dtype=float)\n\n# Compute adjusted cosine item similarity\nratings_centered = ratings_data.copy()\nfor i in range(ratings_data.shape[0]):\n    mask = ratings_data[i] > 0\n    if mask.any():\n        user_mean = ratings_data[i][mask].mean()\n        ratings_centered[i][mask] -= user_mean\n        ratings_centered[i][~mask] = 0\n\nitem_sim = cosine_similarity(ratings_centered.T)\n\ndef predict_item_based(user_idx, item_idx, ratings, item_similarity, k=5):\n    \"\"\"Predict rating using item-based CF.\"\"\"\n    # Get items the user has rated\n    user_ratings = ratings[user_idx]\n    rated_mask = user_ratings > 0\n    \n    if not rated_mask.any():\n        return 0.0\n    \n    # Get similarities between target item and rated items\n    sims = item_similarity[item_idx][rated_mask]\n    user_rated_values = user_ratings[rated_mask]\n    \n    # Select top-k most similar items\n    if len(sims) > k:\n        top_k_idx = np.argsort(np.abs(sims))[::-1][:k]\n        sims = sims[top_k_idx]\n        user_rated_values = user_rated_values[top_k_idx]\n    \n    # Only use positive similarities\n    pos_mask = sims > 0\n    if not pos_mask.any():\n        return 0.0\n    \n    sims = sims[pos_mask]\n    user_rated_values = user_rated_values[pos_mask]\n    \n    # Weighted prediction\n    predicted = np.dot(sims, user_rated_values) / sims.sum()\n    return np.clip(predicted, 1, 5)\n\n# Generate predictions for User_1\nuser_idx = 0\nprint(f\"=== Item-Based Predictions for User_1 ===\")\nprint(f\"{'Movie':<28} {'Predicted':>10}\")\nprint(\"-\" * 40)\n\npredictions = []\nfor item_idx in range(len(movie_titles)):\n    if ratings_data[user_idx, item_idx] == 0:\n        pred = predict_item_based(user_idx, item_idx, ratings_data, item_sim, k=5)\n        if pred > 0:\n            predictions.append((movie_titles[item_idx], pred))\n            print(f\"{movie_titles[item_idx]:<28} {pred:>10.2f}\")\n\nprint(f\"\\n=== Top 5 Recommendations ===\")\npredictions.sort(key=lambda x: x[1], reverse=True)\nfor title, score in predictions[:5]:\n    print(f\"  {title}: {score:.2f}\")"
        ]
