      "source": [
        "# Recommender Systems - mod-1\n\n",
        "**Course:** recommender-systems\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\n\n# Create a synthetic MovieLens-style dataset\nnp.random.seed(42)\n\n# 20 users, 15 movies\nn_users = 20\nn_movies = 15\n\nmovie_titles = [\n    'The Matrix', 'Inception', 'Interstellar', 'The Dark Knight',\n    'Pulp Fiction', 'Fight Club', 'Forrest Gump', 'The Shawshank Redemption',\n    'The Godfather', 'Goodfellas', 'Toy Story', 'Finding Nemo',\n    'The Lion King', 'Spirited Away', 'Parasite'\n]\n\n# Generate sparse ratings (not every user rates every movie)\nratings_matrix = np.zeros((n_users, n_movies))\nfor i in range(n_users):\n    # Each user rates 5-10 movies\n    n_rated = np.random.randint(5, 11)\n    rated_movies = np.random.choice(n_movies, n_rated, replace=False)\n    for movie in rated_movies:\n        ratings_matrix[i, movie] = np.random.randint(1, 6)\n\n# Create DataFrame\nratings_df = pd.DataFrame(\n    ratings_matrix,\n    columns=movie_titles,\n    index=[f'User_{i+1}' for i in range(n_users)]\n)\n\n# Popularity-based recommender\n# Calculate average rating and number of ratings for each movie\nmovie_stats = pd.DataFrame({\n    'avg_rating': ratings_df.replace(0, np.nan).mean(),\n    'num_ratings': (ratings_df > 0).sum(),\n    'popularity_score': ratings_df.replace(0, np.nan).mean() * np.log1p((ratings_df > 0).sum())\n})\n\nmovie_stats_sorted = movie_stats.sort_values('popularity_score', ascending=False)\nprint(\"=== Popularity-Based Recommendations ===\")\nprint(movie_stats_sorted.round(2))\nprint(\"\\nTop 5 Recommendations for ANY user:\")\nprint(movie_stats_sorted.head().index.tolist())"
        ]
      ]
    },
