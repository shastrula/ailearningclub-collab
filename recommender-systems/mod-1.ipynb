      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\n\n# Recreate our dataset\nnp.random.seed(42)\nn_users, n_movies = 20, 15\n\nmovie_titles = [\n    'The Matrix', 'Inception', 'Interstellar', 'The Dark Knight',\n    'Pulp Fiction', 'Fight Club', 'Forrest Gump', 'The Shawshank Redemption',\n    'The Godfather', 'Goodfellas', 'Toy Story', 'Finding Nemo',\n    'The Lion King', 'Spirited Away', 'Parasite'\n]\n\nratings_matrix = np.zeros((n_users, n_movies))\nfor i in range(n_users):\n    n_rated = np.random.randint(5, 11)\n    rated_movies = np.random.choice(n_movies, n_rated, replace=False)\n    for movie in rated_movies:\n        ratings_matrix[i, movie] = np.random.randint(1, 6)\n\nratings_df = pd.DataFrame(ratings_matrix, columns=movie_titles,\n                          index=[f'User_{i+1}' for i in range(n_users)])\n\n# Analyze matrix properties\ntotal_cells = n_users * n_movies\nfilled_cells = (ratings_matrix > 0).sum()\nsparsity = 1 - (filled_cells / total_cells)\n\nprint(\"=== Rating Matrix Properties ===\")\nprint(f\"Shape: {ratings_matrix.shape}\")\nprint(f\"Total possible ratings: {total_cells}\")\nprint(f\"Actual ratings: {filled_cells}\")\nprint(f\"Sparsity: {sparsity:.2%}\")\nprint(f\"\\nRating distribution:\")\nfor rating in range(1, 6):\n    count = (ratings_matrix == rating).sum()\n    print(f\"  {rating} stars: {count} ratings ({count/filled_cells:.1%})\")"
        ]
      ]
    },
