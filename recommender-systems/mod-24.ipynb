          "python",
          "import numpy as np\n\nnp.random.seed(42)\n\n# Evaluate hybrid vs individual components\n# Hold out test data\ntest_mask = np.zeros((n_users, n_items), dtype=bool)\nfor i in range(n_users):\n    rated = np.where(ratings[i] > 0)[0]\n    if len(rated) >= 2:\n        test_item = np.random.choice(rated)\n        test_mask[i, test_item] = True\n\ntrain_ratings = ratings.copy()\ntrain_ratings[test_mask] = 0\n\n# Retrain on training data\nhybrid_eval = HybridRecommender(content_similarity, n_factors=5)\nhybrid_eval.fit(train_ratings)\n\n# Content-based only predictions\ncb_preds = []\ncf_preds = []\nhybrid_preds = []\nactuals = []\n\nfor i in range(n_users):\n    test_items = np.where(test_mask[i])[0]\n    for j in test_items:\n        actual = ratings[i, j]\n        actuals.append(actual)\n        \n        # CB prediction\n        rated_mask = train_ratings[i] > 0\n        if rated_mask.any():\n            sims = content_similarity[j][rated_mask]\n            vals = train_ratings[i][rated_mask]\n            cb = np.clip(np.dot(sims, vals) / max(sims.sum(), 0.001), 1, 5)\n        else:\n            cb = 3.0\n        cb_preds.append(cb)\n        \n        # CF prediction\n        cf_preds.append(hybrid_eval.cf_predictions[i, j])\n        \n        # Hybrid prediction\n        hybrid_preds.append(hybrid_eval.predict(i, j))\n\nactuals = np.array(actuals)\ncb_preds = np.array(cb_preds)\ncf_preds = np.array(cf_preds)\nhybrid_preds = np.array(hybrid_preds)\n\nprint(\"=== Evaluation: Hybrid vs Components ===\\n\")\nprint(f\"Test entries: {len(actuals)}\")\nprint(f\"\\n{'Model':<25} {'RMSE':>8} {'MAE':>8}\")\nprint(\"-\" * 43)\nfor name, preds in [('Content-Based', cb_preds), ('Collaborative (NMF)', cf_preds), ('Hybrid (adaptive)', hybrid_preds)]:\n    rmse = np.sqrt(np.mean((actuals - preds) ** 2))\n    mae = np.mean(np.abs(actuals - preds))\n    print(f\"{name:<25} {rmse:>8.4f} {mae:>8.4f}\")\n\n# Breakdown by user type\nprint(f\"\\n--- RMSE by User History Length ---\")\nprint(f\"{'User Type':<20} {'CB':>8} {'CF':>8} {'Hybrid':>8} {'Best':>8}\")\nprint(\"-\" * 55)\n\nfor label, start, end in [('Cold (1-2)', 30, 35), ('Moderate (3-5)', 35, 40), ('Warm (5+)', 0, 30)]:\n    mask = np.zeros(len(actuals), dtype=bool)\n    idx = 0\n    for i in range(n_users):\n        test_items = np.where(test_mask[i])[0]\n        for j in test_items:\n            if start <= i < end:\n                mask[idx] = True\n            idx += 1\n    \n    if mask.any():\n        rmse_cb = np.sqrt(np.mean((actuals[mask] - cb_preds[mask]) ** 2))\n        rmse_cf = np.sqrt(np.mean((actuals[mask] - cf_preds[mask]) ** 2))\n        rmse_hy = np.sqrt(np.mean((actuals[mask] - hybrid_preds[mask]) ** 2))\n        best = 'CB' if rmse_cb < rmse_cf and rmse_cb < rmse_hy else ('CF' if rmse_cf < rmse_hy else 'Hybrid')\n        print(f\"{label:<20} {rmse_cb:>8.4f} {rmse_cf:>8.4f} {rmse_hy:>8.4f} {best:>8}\")"
        ]
