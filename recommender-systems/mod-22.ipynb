          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics.pairwise import cosine_similarity\n\nnp.random.seed(42)\n\n# Evaluate using leave-one-out protocol\n# For each user, hide one highly-rated movie and check if it appears in top-k\n\n# Simplified evaluation dataset\nn_users = 50\nn_movies = 30\n\n# Create user ratings based on preferences\nall_user_ratings = {}\nfor u in range(n_users):\n    cluster = u % 3  # 3 preference clusters\n    n_rated = np.random.randint(5, 12)\n    \n    if cluster == 0:  # Action fans (movies 0-9)\n        preferred = np.random.choice(range(0, 10), min(n_rated-2, 8), replace=False)\n        other = np.random.choice(range(10, 30), 2, replace=False)\n        items = np.concatenate([preferred, other])\n    elif cluster == 1:  # Drama fans (movies 5-14)\n        preferred = np.random.choice(range(5, 15), min(n_rated-2, 8), replace=False)\n        other = np.random.choice(list(range(0, 5)) + list(range(15, 30)), 2, replace=False)\n        items = np.concatenate([preferred, other])\n    else:  # Animation fans (movies 15-24)\n        preferred = np.random.choice(range(15, 25), min(n_rated-2, 8), replace=False)\n        other = np.random.choice(list(range(0, 15)) + list(range(25, 30)), 2, replace=False)\n        items = np.concatenate([preferred, other])\n    \n    ratings = {}\n    for item in items:\n        if (cluster == 0 and item < 10) or (cluster == 1 and 5 <= item < 15) or (cluster == 2 and 15 <= item < 25):\n            ratings[int(item)] = np.random.choice([4, 5])\n        else:\n            ratings[int(item)] = np.random.choice([1, 2, 3])\n    all_user_ratings[u] = ratings\n\n# Leave-one-out evaluation\nhits_at_5 = 0\nhits_at_10 = 0\ntotal_users = 0\n\n# Simplified TF-IDF (reusing genres from above)\ngenres_list = [\n    'action science-fiction thriller', 'action science-fiction thriller',\n    'science-fiction drama exploration', 'action crime thriller superhero',\n    'science-fiction thriller mystery', 'crime drama violence',\n    'drama prison redemption', 'drama comedy romance',\n    'crime drama mafia', 'drama thriller psychological',\n    'crime drama gangster', 'crime drama thriller',\n    'thriller crime western', 'drama historical',\n    'thriller drama comedy', 'animation adventure comedy family',\n    'animation adventure comedy', 'animation adventure drama',\n    'animation adventure fantasy', 'animation adventure comedy family',\n    'animation comedy family', 'animation science-fiction',\n    'animation adventure family', 'animation comedy family',\n    'animation adventure comedy', 'action science-fiction',\n    'action thriller', 'action thriller',\n    'action science-fiction', 'action science-fiction horror'\n]\n\ntfidf = TfidfVectorizer(stop_words='english')\ntfidf_matrix = tfidf.fit_transform(genres_list)\n\nfor u, ratings in all_user_ratings.items():\n    # Find a highly-rated item to hide\n    high_rated = [item for item, rating in ratings.items() if rating >= 4]\n    if len(high_rated) < 2:\n        continue\n    \n    # Hide one item\n    hidden_item = np.random.choice(high_rated)\n    train_ratings = {k: v for k, v in ratings.items() if k != hidden_item}\n    \n    # Build profile from training ratings\n    rated_indices = list(train_ratings.keys())\n    ratings_values = np.array(list(train_ratings.values()))\n    normalized = (ratings_values - 3) / 2\n    vectors = tfidf_matrix[rated_indices].toarray()\n    weighted = vectors * normalized.reshape(-1, 1)\n    profile = weighted.mean(axis=0)\n    \n    # Score all items\n    scores = cosine_similarity([profile], tfidf_matrix.toarray())[0]\n    for idx in train_ratings:\n        scores[idx] = -1\n    \n    # Check if hidden item is in top-k\n    top_5 = np.argsort(scores)[::-1][:5]\n    top_10 = np.argsort(scores)[::-1][:10]\n    \n    if hidden_item in top_5:\n        hits_at_5 += 1\n    if hidden_item in top_10:\n        hits_at_10 += 1\n    total_users += 1\n\nprint(\"=== Leave-One-Out Evaluation ===\\n\")\nprint(f\"Total users evaluated: {total_users}\")\nprint(f\"Hit Rate@5:  {hits_at_5/total_users:.4f} ({hits_at_5}/{total_users})\")\nprint(f\"Hit Rate@10: {hits_at_10/total_users:.4f} ({hits_at_10}/{total_users})\")\nprint(f\"\\nInterpretation:\")\nprint(f\"  The hidden liked movie appeared in top-5 recommendations {hits_at_5/total_users:.1%} of the time\")\nprint(f\"  The hidden liked movie appeared in top-10 recommendations {hits_at_10/total_users:.1%} of the time\")"
