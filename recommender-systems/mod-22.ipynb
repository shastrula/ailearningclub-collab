tion adventure family music mexican death', 'animation comedy family cooking paris',\n        'animation adventure comedy family monsters friendship',\n        'action science-fiction post-apocalyptic chase feminist', 'action thriller revenge martial-arts',\n        'action thriller christmas hostage', 'action science-fiction robots time-travel',\n        'action science-fiction horror space marines'\n    ],\n    'year': [1999, 2010, 2014, 2008, 2017, 1994, 1994, 1994, 1972, 1999,\n             1990, 2006, 2007, 2007, 2019, 1995, 2003, 1994, 2001, 2009,\n             2015, 2008, 2017, 2007, 2001, 2015, 2014, 1988, 1991, 1986],\n    'director': ['Wachowski', 'Nolan', 'Nolan', 'Nolan', 'Villeneuve',\n                 'Tarantino', 'Darabont', 'Zemeckis', 'Coppola', 'Fincher',\n                 'Scorsese', 'Scorsese', 'Coen', 'Anderson', 'Bong',\n                 'Lasseter', 'Stanton', 'Allers', 'Miyazaki', 'Docter',\n                 'Docter', 'Stanton', 'Molina', 'Bird', 'Docter',\n                 'Miller', 'Stahelski', 'McTiernan', 'Cameron', 'Cameron']\n})\n\n# Create combined feature text\nmovies['features'] = movies['genres'] + ' ' + movies['director'] + ' ' + movies['year'].astype(str)\n\nprint(\"=== Movie Dataset Created ===\")\nprint(f\"Total movies: {len(movies)}\")\nprint(f\"\\nSample entries:\")\nprint(movies[['title', 'genres', 'director']].head(5).to_string(index=False))\nprint(f\"\\nGenre categories present: {len(set(' '.join(movies['genres']).split()))}\")"
