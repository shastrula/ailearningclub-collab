          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics.pairwise import cosine_similarity\n\nnp.random.seed(42)\n\nmovies = pd.DataFrame({\n    'movie_id': range(30),\n    'title': [\n        'The Matrix', 'Inception', 'Interstellar', 'The Dark Knight', 'Blade Runner 2049',\n        'Pulp Fiction', 'The Shawshank Redemption', 'Forrest Gump', 'The Godfather', 'Fight Club',\n        'Goodfellas', 'The Departed', 'No Country for Old Men', 'There Will Be Blood', 'Parasite',\n        'Toy Story', 'Finding Nemo', 'The Lion King', 'Spirited Away', 'Up',\n        'Inside Out', 'WALL-E', 'Coco', 'Ratatouille', 'Monsters Inc',\n        'Mad Max Fury Road', 'John Wick', 'Die Hard', 'Terminator 2', 'Aliens'\n    ],\n    'genres': [\n        'action science-fiction thriller cyberpunk', 'action science-fiction thriller heist dreams',\n        'science-fiction drama space exploration emotional', 'action crime thriller superhero dark',\n        'science-fiction thriller mystery dystopia',\n        'crime drama dark-comedy nonlinear violence', 'drama prison hope redemption',\n        'drama comedy romance historical heartwarming', 'crime drama family power mafia',\n        'drama thriller psychological twist anarchism',\n        'crime drama biography gangster', 'crime drama thriller mystery boston',\n        'thriller crime western neo-noir suspense', 'drama historical oil ambition',\n        'thriller drama comedy class-divide korean',\n        'animation adventure comedy family toys friendship', 'animation adventure comedy family ocean',\n        'animation adventure drama family musical coming-of-age', 'animation adventure fantasy spiritual japanese',\n        'animation adventure comedy family emotional elderly',\n        'animation comedy family emotions psychological', 'animation science-fiction romance robot environmental',\n        'animation adventure family music mexican death', 'animation comedy family cooking paris',\n        'animation adventure comedy family monsters friendship',\n        'action science-fiction post-apocalyptic chase feminist', 'action thriller revenge martial-arts',\n        'action thriller christmas hostage', 'action science-fiction robots time-travel',\n        'action science-fiction horror space marines'\n    ],\n    'director': ['Wachowski', 'Nolan', 'Nolan', 'Nolan', 'Villeneuve',\n                 'Tarantino', 'Darabont', 'Zemeckis', 'Coppola', 'Fincher',\n                 'Scorsese', 'Scorsese', 'Coen', 'Anderson', 'Bong',\n                 'Lasseter', 'Stanton', 'Allers', 'Miyazaki', 'Docter',\n                 'Docter', 'Stanton', 'Molina', 'Bird', 'Docter',\n                 'Miller', 'Stahelski', 'McTiernan', 'Cameron', 'Cameron']\n})\n\nmovies['features'] = movies['genres'] + ' ' + movies['director']\ntfidf = TfidfVectorizer(stop_words='english')\ntfidf_matrix = tfidf.fit_transform(movies['features'])\n\n# User ratings\nuser_ratings = {\n    'Alice': {0: 5, 1: 5, 3: 4, 4: 4, 25: 5, 28: 4},  # Action/sci-fi fan\n    'Bob': {5: 5, 6: 5, 8: 4, 10: 4, 11: 5, 13: 3},    # Crime/drama fan\n    'Carol': {15: 5, 16: 5, 17: 4, 18: 5, 19: 4, 20: 4}, # Animation fan\n    'Dave': {0: 4, 1: 5, 6: 5, 8: 4, 15: 3, 18: 4},    # Diverse tastes\n}\n\nclass ContentBasedRecommender:\n    def __init__(self, tfidf_mat, movies_df):\n        self.tfidf_matrix = tfidf_mat\n        self.movies = movies_df\n        self.feature_names = tfidf.get_feature_names_out()\n    \n    def build_user_profile(self, ratings_dict):\n        \"\"\"Build user profile from their ratings.\"\"\"\n        rated_indices = list(ratings_dict.keys())\n        ratings_values = np.array(list(ratings_dict.values()))\n        \n        # Normalize to [-1, 1]\n        normalized = (ratings_values - 3) / 2\n        \n        # Weighted average of TF-IDF vectors\n        vectors = self.tfidf_matrix[rated_indices].toarray()\n        weighted = vectors * normalized.reshape(-1, 1)\n        profile = weighted.mean(axis=0)\n        \n        return profile\n    \n    def recommend(self, ratings_dict, top_n=5):\n        \"\"\"Generate recommendations for a user.\"\"\"\n        profile = self.build_user_profile(ratings_dict)\n        \n        # Score all items\n        scores = cosine_similarity([profile], self.tfidf_matrix.toarray())[0]\n        \n        # Exclude already rated\n        for idx in ratings_dict:\n            scores[idx] = -1\n        \n        # Top-N\n        top_indices = np.argsort(scores)[::-1][:top_n]\n        results = []\n        for idx in top_indices:\n            results.append({\n                'title': self.movies.iloc[idx]['title'],\n                'score': scores[idx],\n                'genres': self.movies.iloc[idx]['genres']\n            })\n        return pd.DataFrame(results)\n\n# Build recommender\nrecommender = ContentBasedRecommender(tfidf_matrix, movies)\n\n# Generate recommendations for each user\nprint(\"=== Content-Based Movie Recommendations ===\\n\")\nfor user_name, ratings in user_ratings.items():\n    rated_titles = [movies.iloc[idx]['title'] for idx in ratings]\n    print(f\"--- {user_name} ---\")\n    print(f\"Rated: {', '.join(rated_titles[:3])}...\")\n    \n    recs = recommender.recommend(ratings, top_n=5)\n    print(f\"\\nRecommendations:\")\n    for _, row in recs.iterrows():\n        print(f\"  {row['title']:<30} (score: {row['score']:.4f})\")\n    print()"
        ]
