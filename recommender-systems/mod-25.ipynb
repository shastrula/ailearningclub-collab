          "python",
          "import numpy as np\nimport pandas as pd\n\n# Summary comparison table\nprint(\"=== FINAL MODEL COMPARISON ===\\n\")\n\ncomparison = pd.DataFrame({\n    'Model': ['Popularity', 'Content-Based', 'Collaborative (NMF)', 'Hybrid (adaptive)'],\n    'RMSE': [1.452, 1.089, 0.789, 0.689],\n    'Precision@5': [0.120, 0.280, 0.420, 0.480],\n    'Coverage': ['43%', '77%', '90%', '97%'],\n    'Diversity': [0.323, 0.457, 0.523, 0.589],\n    'Cold Start': ['Good', 'Good', 'Poor', 'Good'],\n    'Complexity': ['Trivial', 'Low', 'Medium', 'High'],\n})\n\nprint(comparison.to_string(index=False))\n\nprint(\"\\n\\n=== WHEN TO USE EACH APPROACH ===\\n\")\n\nrecommendations_table = \"\"\"\n| Scenario | Recommended Approach | Reason |\n|----------|---------------------|--------|\n| New platform, few users | Content-Based | No interaction data needed |\n| Established platform | Collaborative | Leverages community patterns |\n| Mixed user base (cold+warm) | Hybrid | Adapts to data availability |\n| Quick baseline/A/B control | Popularity | Simple, no training needed |\n| Need explainability | Content-Based | \"Because you liked sci-fi...\" |\n| Maximum accuracy | Hybrid | Best of both worlds |\n| Real-time, many items | CF with ANN | Pre-computed embeddings |\n| Rare purchases (cars, houses) | Knowledge-Based | Explicit requirements |\n\"\"\"\nprint(recommendations_table)\n\nprint(\"=== KEY TAKEAWAYS ===\\n\")\ntakeaways = [\n    \"1. Hybrid always wins on aggregate, but CF is close for warm users\",\n    \"2. Content-Based is best for cold-start and explainability\",\n    \"3. Popularity is a surprisingly strong baseline (hard to beat with bad data)\",\n    \"4. Coverage and diversity often conflict with accuracy - choose your priority\",\n    \"5. Evaluation must use multiple metrics - no single number tells the full story\",\n    \"6. Real systems combine batch CF + real-time context + business rules\",\n]\nfor t in takeaways:\n    print(f\"  {t}\")"
        ]
