          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics.pairwise import cosine_similarity\n\n# Movie catalog with rich features\nmovies = pd.DataFrame({\n    'title': ['The Matrix', 'Inception', 'Interstellar', 'The Dark Knight',\n              'Pulp Fiction', 'Forrest Gump', 'Toy Story', 'Finding Nemo'],\n    'features': [\n        'action sci-fi cyberpunk virtual reality',\n        'action sci-fi dreams heist thriller',\n        'sci-fi space exploration drama emotional',\n        'action superhero crime thriller dark',\n        'crime drama violence nonlinear storytelling',\n        'drama comedy heartwarming historical',\n        'animation family adventure friendship',\n        'animation family ocean adventure comedy'\n    ]\n})\n\n# New user rates just ONE movie\nnew_user_rating = {'The Matrix': 5}\n\n# Build content-based profile from single rating\ntfidf = TfidfVectorizer()\ntfidf_matrix = tfidf.fit_transform(movies['features'])\n\n# Find the rated movie and compute similarities\nrated_idx = movies[movies['title'] == 'The Matrix'].index[0]\nsimilarities = cosine_similarity(tfidf_matrix[rated_idx], tfidf_matrix)[0]\n\n# Rank unrated movies by content similarity\nprint(\"=== Content-Based Warm-Up (1 rating) ===\")\nprint(f\"User rated: The Matrix = 5/5\\n\")\nprint(f\"{'Movie':<20} {'Similarity':>12} {'Predicted':>10}\")\nprint(\"-\" * 45)\n\nrecommendations = []\nfor idx, row in movies.iterrows():\n    if row['title'] != 'The Matrix':\n        # Predicted rating = user_rating * similarity\n        predicted = 5 * similarities[idx]\n        predicted = max(1, min(5, predicted * 2 + 1))  # Scale to 1-5\n        recommendations.append((row['title'], similarities[idx], predicted))\n\nrecommendations.sort(key=lambda x: x[1], reverse=True)\nfor title, sim, pred in recommendations:\n    print(f\"{title:<20} {sim:>12.4f} {pred:>10.2f}\")"
        ]
      ]
