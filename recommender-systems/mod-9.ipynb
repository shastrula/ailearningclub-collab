      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.metrics.pairwise import cosine_similarity\n\nnp.random.seed(42)\n\n# Simulate users with different amounts of history\nn_items = 15\nmovie_titles = ['Matrix', 'Inception', 'Interstellar', 'Dark Knight', 'Pulp Fiction',\n                'Fight Club', 'Forrest Gump', 'Shawshank', 'Godfather', 'Goodfellas',\n                'Toy Story', 'Nemo', 'Lion King', 'Spirited Away', 'Parasite']\n\n# Create a \"ground truth\" preference matrix (what users actually like)\ntrue_preferences = np.array([\n    [5, 5, 4, 5, 2, 3, 1, 2, 2, 2, 1, 1, 1, 1, 3],  # Action fan\n    [2, 1, 2, 2, 5, 4, 5, 5, 5, 4, 2, 2, 2, 2, 4],  # Drama fan\n    [1, 1, 1, 1, 2, 1, 3, 2, 2, 2, 5, 5, 5, 5, 2],  # Animation fan\n], dtype=float)\n\n# Simulate observation with varying sparsity\ndef simulate_observations(true_prefs, n_observed):\n    \"\"\"Simulate a user who has rated n_observed items.\"\"\"\n    observed = np.zeros_like(true_prefs)\n    indices = np.random.choice(len(true_prefs), n_observed, replace=False)\n    observed[indices] = true_prefs[indices]\n    return observed\n\n# User-based CF prediction function\ndef predict_with_history(user_obs, all_users_obs, true_prefs, item_idx):\n    \"\"\"Predict using user-based CF.\"\"\"\n    if user_obs.sum() == 0:\n        return 3.0  # Global average fallback\n    \n    # Compute similarity with other users\n    sims = []\n    for other in all_users_obs:\n        # Only on co-rated items\n        mask = (user_obs > 0) & (other > 0)\n        if mask.sum() >= 2:\n            cos = np.dot(user_obs[mask], other[mask]) / (\n                np.linalg.norm(user_obs[mask]) * np.linalg.norm(other[mask]) + 1e-8)\n            sims.append(cos)\n        else:\n            sims.append(0)\n    \n    sims = np.array(sims)\n    if sims.max() == 0:\n        return 3.0\n    \n    # Weighted average\n    weights = np.maximum(sims, 0)\n    if weights.sum() == 0:\n        return 3.0\n    return np.clip(np.dot(weights, true_prefs[:, item_idx]) / weights.sum(), 1, 5)\n\n# Test different history sizes\nprint(\"=== Cold Start Impact on Prediction Quality ===\\n\")\nprint(f\"{'History Size':>12} {'Avg RMSE':>10} {'Predictions Made':>18}\")\nprint(\"-\" * 45)\n\nfor n_history in [0, 1, 2, 3, 5, 8, 12]:\n    errors = []\n    predictions_made = 0\n    \n    for trial in range(50):  # Multiple trials for stability\n        user_idx = 0  # Test with action fan\n        user_obs = simulate_observations(true_preferences[user_idx], n_history)\n        \n        # Predict unobserved items\n        unobserved = np.where(user_obs == 0)[0]\n        for item_idx in unobserved[:5]:  # Test 5 predictions\n            pred = predict_with_history(user_obs, true_preferences, true_preferences, item_idx)\n            actual = true_preferences[user_idx, item_idx]\n            errors.append((actual - pred) ** 2)\n            predictions_made += 1\n    \n    avg_rmse = np.sqrt(np.mean(errors))\n    print(f\"{n_history:>12} {avg_rmse:>10.4f} {predictions_made:>18}\")"
        ]
      ]
    },
