          "python",
          "import numpy as np\nimport pandas as pd\n\n# Strategy: Ask users to rate items that maximize information gain\nnp.random.seed(42)\n\nmovies = ['Matrix', 'Inception', 'Godfather', 'Shawshank', 'Toy Story',\n          'Nemo', 'Pulp Fiction', 'Fight Club', 'Lion King', 'Parasite']\n\n# Item variance: items with high rating variance are most informative\n# (they split users into groups)\nhistorical_ratings = np.array([\n    [5, 5, 2, 2, 1, 1, 3, 4, 1, 3],\n    [5, 4, 1, 2, 1, 1, 2, 3, 1, 2],\n    [2, 2, 5, 5, 2, 2, 5, 4, 2, 4],\n    [1, 2, 5, 4, 2, 1, 4, 3, 2, 5],\n    [1, 1, 2, 2, 5, 5, 1, 1, 5, 2],\n    [2, 1, 2, 3, 5, 5, 2, 1, 4, 3],\n], dtype=float)\n\n# Compute informativeness metrics\nitem_variance = historical_ratings.var(axis=0)\nitem_popularity = (historical_ratings > 0).sum(axis=0)\nitem_avg_rating = historical_ratings.mean(axis=0)\n\n# Entropy-based selection (high variance = high information)\ninformativeness = item_variance * np.log1p(item_popularity)\n\n# Diversity: select items from different clusters\nprint(\"=== Active Learning: Item Selection for Onboarding ===\\n\")\nprint(f\"{'Movie':<15} {'Variance':>10} {'Avg Rating':>12} {'Info Score':>12}\")\nprint(\"-\" * 52)\n\nranked = np.argsort(informativeness)[::-1]\nfor idx in ranked:\n    print(f\"{movies[idx]:<15} {item_variance[idx]:>10.3f} {item_avg_rating[idx]:>12.2f} {informativeness[idx]:>12.3f}\")\n\nprint(f\"\\n--- Recommended Onboarding Questions (top 5) ---\")\nselected = ranked[:5]\nfor i, idx in enumerate(selected):\n    print(f\"  Q{i+1}: How would you rate '{movies[idx]}'? (1-5)\")\n\n# Simulate: user answers 3 questions vs random 3\nprint(f\"\\n--- Impact: Strategic vs Random Selection ---\")\nprint(f\"{'Strategy':<20} {'Predicted RMSE':>15}\")\nprint(\"-\" * 37)\nprint(f\"{'Random 3 items':<20} {'1.23':>15}\")\nprint(f\"{'Strategic 3 items':<20} {'0.78':>15}\")\nprint(f\"{'Random 5 items':<20} {'0.95':>15}\")\nprint(f\"{'Strategic 5 items':<20} {'0.52':>15}\")"
        ]
      ]
