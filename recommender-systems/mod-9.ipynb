          "python",
          "import numpy as np\nimport pandas as pd\n\n# New users with demographic info but no ratings\nnew_users = pd.DataFrame({\n    'user_id': ['new_1', 'new_2', 'new_3', 'new_4'],\n    'age_group': ['18-24', '25-34', '35-44', '18-24'],\n    'gender': ['M', 'F', 'M', 'F'],\n    'favorite_genre': ['action', 'drama', 'comedy', 'sci-fi']\n})\n\n# Historical preferences by demographic segment\nsegment_preferences = {\n    ('18-24', 'M'): {'action': 4.5, 'sci-fi': 4.2, 'drama': 2.8, 'comedy': 3.5, 'animation': 3.0},\n    ('18-24', 'F'): {'drama': 4.3, 'comedy': 4.0, 'sci-fi': 3.8, 'action': 3.2, 'animation': 3.5},\n    ('25-34', 'F'): {'drama': 4.5, 'comedy': 3.8, 'action': 3.0, 'sci-fi': 3.5, 'animation': 2.8},\n    ('25-34', 'M'): {'action': 4.2, 'sci-fi': 4.0, 'drama': 3.5, 'comedy': 3.2, 'animation': 2.5},\n    ('35-44', 'M'): {'drama': 4.0, 'comedy': 4.2, 'action': 3.5, 'sci-fi': 3.0, 'animation': 3.8},\n    ('35-44', 'F'): {'drama': 4.5, 'comedy': 4.0, 'animation': 3.5, 'action': 2.8, 'sci-fi': 2.5},\n}\n\n# Movies with genres\nmovies = pd.DataFrame({\n    'title': ['The Matrix', 'Inception', 'The Godfather', 'Toy Story', 'Forrest Gump'],\n    'primary_genre': ['action', 'sci-fi', 'drama', 'animation', 'comedy']\n})\n\nprint(\"=== Demographic-Based Cold Start Solution ===\\n\")\nfor _, user in new_users.iterrows():\n    segment = (user['age_group'], user['gender'])\n    prefs = segment_preferences.get(segment, {})\n    \n    print(f\"{user['user_id']} ({user['age_group']}, {user['gender']}, likes {user['favorite_genre']}):\")\n    \n    # Recommend based on segment preferences\n    movie_scores = []\n    for _, movie in movies.iterrows():\n        score = prefs.get(movie['primary_genre'], 3.0)\n        # Boost if matches stated preference\n        if movie['primary_genre'] == user['favorite_genre']:\n            score = min(score + 0.5, 5.0)\n        movie_scores.append((movie['title'], score))\n    \n    movie_scores.sort(key=lambda x: x[1], reverse=True)\n    for title, score in movie_scores[:3]:\n        print(f\"  {title:<20} (predicted: {score:.1f})\")\n    print()"
        ]
      ]
