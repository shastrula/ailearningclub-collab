        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics.pairwise import cosine_similarity\nfrom sklearn.preprocessing import normalize\n\n# Movie data with additional features\nmovies = pd.DataFrame({\n    'title': ['The Matrix', 'Inception', 'Interstellar', 'The Dark Knight',\n              'Pulp Fiction', 'Fight Club', 'Toy Story', 'Finding Nemo'],\n    'genres': ['action sci-fi', 'action sci-fi', 'sci-fi drama', 'action crime',\n               'crime drama', 'drama thriller', 'animation comedy', 'animation comedy'],\n    'director': ['Wachowski', 'Nolan', 'Nolan', 'Nolan',\n                 'Tarantino', 'Fincher', 'Lasseter', 'Stanton'],\n    'cast': ['Reeves Fishburne', 'DiCaprio Page', 'McConaughey Hathaway', 'Bale Ledger',\n             'Travolta Jackson', 'Pitt Norton', 'Hanks Allen', 'Brooks DeGeneres'],\n    'decade': ['1990s', '2010s', '2010s', '2000s', '1990s', '1990s', '1990s', '2000s']\n})\n\n# Create weighted combined features\n# Genre gets more weight (repeated)\nmovies['weighted_features'] = (\n    movies['genres'] + ' ' + movies['genres'] + ' ' +  # Double weight for genre\n    movies['director'] + ' ' +\n    movies['cast'] + ' ' +\n    movies['decade']\n)\n\n# TF-IDF on weighted features\ntfidf = TfidfVectorizer(stop_words='english')\ntfidf_matrix = tfidf.fit_transform(movies['weighted_features'])\ncosine_sim = cosine_similarity(tfidf_matrix)\n\n# Show similarity scores for The Matrix\nmatrix_idx = 0\nsimilarities = pd.DataFrame({\n    'title': movies['title'],\n    'similarity': cosine_sim[matrix_idx]\n}).sort_values('similarity', ascending=False)\n\nprint(\"=== Multi-Feature Similarity to 'The Matrix' ===\")\nprint(similarities.to_string(index=False))"
        ]
      ]
