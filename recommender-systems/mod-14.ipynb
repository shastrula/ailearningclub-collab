      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics.pairwise import cosine_similarity\nfrom sklearn.decomposition import NMF\n\n# Movie catalog\nmovies = pd.DataFrame({\n    'movie_id': range(12),\n    'title': ['The Matrix', 'Inception', 'Interstellar', 'The Dark Knight',\n              'Pulp Fiction', 'The Shawshank Redemption', 'Forrest Gump',\n              'The Godfather', 'Toy Story', 'Finding Nemo', 'The Lion King', 'Parasite'],\n    'genres': ['action sci-fi', 'action sci-fi thriller', 'sci-fi drama',\n               'action crime thriller', 'crime drama', 'drama', 'drama comedy',\n               'crime drama', 'animation comedy family', 'animation comedy family',\n               'animation drama', 'thriller drama']\n})\n\n# Rating matrix (0 = not rated)\nratings = np.array([\n    [5, 5, 4, 5, 0, 0, 0, 0, 0, 0, 0, 3],  # User 0: action fan\n    [4, 5, 5, 4, 0, 0, 0, 0, 0, 0, 0, 0],  # User 1: action fan\n    [0, 0, 3, 0, 5, 5, 5, 5, 0, 0, 0, 4],  # User 2: drama fan\n    [0, 0, 0, 0, 4, 4, 5, 5, 0, 0, 0, 5],  # User 3: drama fan\n    [0, 0, 0, 0, 0, 0, 3, 0, 5, 5, 5, 0],  # User 4: animation fan\n    [0, 0, 0, 0, 0, 0, 2, 0, 4, 5, 5, 0],  # User 5: animation fan\n    [4, 3, 0, 4, 3, 0, 0, 0, 3, 4, 0, 0],  # User 6: mixed (new-ish)\n], dtype=float)\n\n# --- Content-Based Component ---\ntfidf = TfidfVectorizer()\ntfidf_matrix = tfidf.fit_transform(movies['genres'])\ncontent_sim = cosine_similarity(tfidf_matrix)\n\ndef content_based_predict(user_idx, item_idx, ratings_mat, content_similarity):\n    \"\"\"Predict using content-based filtering.\"\"\"\n    user_ratings = ratings_mat[user_idx]\n    rated_mask = user_ratings > 0\n    if not rated_mask.any():\n        return 3.0\n    \n    sims = content_similarity[item_idx][rated_mask]\n    user_rated = user_ratings[rated_mask]\n    \n    if sims.sum() == 0:\n        return user_rated.mean()\n    \n    return np.clip(np.dot(sims, user_rated) / sims.sum(), 1, 5)\n\n# --- Collaborative Filtering Component ---\n# Fill missing with item means for NMF\nitem_means = np.array([ratings[:, j][ratings[:, j] > 0].mean() \n                       if (ratings[:, j] > 0).any() else 3.0 \n                       for j in range(ratings.shape[1])])\nratings_filled = ratings.copy()\nfor i in range(ratings.shape[0]):\n    for j in range(ratings.shape[1]):\n        if ratings_filled[i, j] == 0:\n            ratings_filled[i, j] = item_means[j]\n\nnmf = NMF(n_components=3, init='random', random_state=42, max_iter=500)\nW = nmf.fit_transform(ratings_filled)\nH = nmf.components_\ncf_predictions = np.clip(W @ H, 1, 5)\n\ndef collaborative_predict(user_idx, item_idx):\n    return cf_predictions[user_idx, item_idx]\n\n# --- Weighted Hybrid ---\ndef hybrid_predict(user_idx, item_idx, alpha=0.5):\n    \"\"\"Weighted hybrid: alpha*CF + (1-alpha)*CB.\"\"\"\n    cb_score = content_based_predict(user_idx, item_idx, ratings, content_sim)\n    cf_score = collaborative_predict(user_idx, item_idx)\n    return alpha * cf_score + (1 - alpha) * cb_score\n\n# Generate recommendations\nprint(\"=== Weighted Hybrid Recommender (\u03b1=0.5) ===\\n\")\nuser_idx = 6  # Mixed-preference user\nprint(f\"User_{user_idx} rated: \", end=\"\")\nrated = np.where(ratings[user_idx] > 0)[0]\nfor idx in rated:\n    print(f\"{movies.iloc[idx]['title']}({int(ratings[user_idx, idx])})\", end=\", \")\nprint(\"\\n\")\n\nprint(f\"{'Movie':<28} {'CB Score':>10} {'CF Score':>10} {'Hybrid':>10}\")\nprint(\"-\" * 62)\n\nunrated = np.where(ratings[user_idx] == 0)[0]\nresults = []\nfor item_idx in unrated:\n    cb = content_based_predict(user_idx, item_idx, ratings, content_sim)\n    cf = collaborative_predict(user_idx, item_idx)\n    hybrid = hybrid_predict(user_idx, item_idx, alpha=0.5)\n    results.append((movies.iloc[item_idx]['title'], cb, cf, hybrid))\n\nresults.sort(key=lambda x: x[3], reverse=True)\nfor title, cb, cf, hyb in results:\n    print(f\"{title:<28} {cb:>10.2f} {cf:>10.2f} {hyb:>10.2f}\")"
        ]
      ]
    },
