        [
          "python",
          "import numpy as np\nfrom sklearn.decomposition import NMF\nfrom sklearn.metrics.pairwise import cosine_similarity\nfrom sklearn.feature_extraction.text import TfidfVectorizer\n\nnp.random.seed(42)\n\n# Larger test with held-out data\nn_users, n_items = 20, 12\ngenres = ['action sci-fi', 'action sci-fi thriller', 'sci-fi drama',\n          'action crime', 'crime drama', 'drama', 'drama comedy',\n          'crime drama', 'animation comedy', 'animation comedy',\n          'animation drama', 'thriller drama']\n\ntfidf = TfidfVectorizer()\ntfidf_matrix = tfidf.fit_transform(genres)\ncontent_sim = cosine_similarity(tfidf_matrix)\n\n# Generate ratings with structure\nratings = np.zeros((n_users, n_items))\nfor i in range(n_users):\n    n_rated = np.random.randint(4, 9)\n    cluster = i // 5  # 4 clusters\n    items = np.random.choice(n_items, n_rated, replace=False)\n    for j in items:\n        if j // 3 == cluster:\n            ratings[i, j] = np.random.choice([4, 5])\n        else:\n            ratings[i, j] = np.random.choice([1, 2, 3])\n\n# Hold out test set\ntest_mask = np.zeros_like(ratings, dtype=bool)\nfor i in range(n_users):\n    rated = np.where(ratings[i] > 0)[0]\n    if len(rated) > 2:\n        test_items = np.random.choice(rated, 2, replace=False)\n        test_mask[i, test_items] = True\n\ntrain = ratings.copy()\ntrain[test_mask] = 0\n\n# Build models on training data\nitem_means = np.array([train[:, j][train[:, j] > 0].mean() \n                       if (train[:, j] > 0).any() else 3.0 \n                       for j in range(n_items)])\ntrain_filled = train.copy()\nfor i in range(n_users):\n    for j in range(n_items):\n        if train_filled[i, j] == 0:\n            train_filled[i, j] = item_means[j]\n\nnmf = NMF(n_components=3, random_state=42, max_iter=500)\nW = nmf.fit_transform(train_filled)\nH = nmf.components_\ncf_preds = np.clip(W @ H, 1, 5)\n\n# Evaluate each approach\ntest_pairs = np.where(test_mask)\nactual = ratings[test_mask]\n\n# Content-based predictions\ncb_preds = []\nfor u, i in zip(test_pairs[0], test_pairs[1]):\n    rated_mask = train[u] > 0\n    if rated_mask.any():\n        sims = content_sim[i][rated_mask]\n        vals = train[u][rated_mask]\n        pred = np.clip(np.dot(sims, vals) / max(sims.sum(), 0.001), 1, 5)\n    else:\n        pred = 3.0\n    cb_preds.append(pred)\ncb_preds = np.array(cb_preds)\n\n# CF predictions\ncf_test = np.array([cf_preds[u, i] for u, i in zip(test_pairs[0], test_pairs[1])])\n\n# Hybrid with different alphas\nprint(\"=== Hybrid vs Components: RMSE Comparison ===\\n\")\nprint(f\"{'Model':<25} {'RMSE':>8}\")\nprint(\"-\" * 35)\n\nrmse_cb = np.sqrt(np.mean((actual - cb_preds) ** 2))\nrmse_cf = np.sqrt(np.mean((actual - cf_test) ** 2))\nprint(f\"{'Content-Based':<25} {rmse_cb:>8.4f}\")\nprint(f\"{'Collaborative (NMF)':<25} {rmse_cf:>8.4f}\")\n\nbest_alpha = 0\nbest_rmse = float('inf')\nfor alpha in [0.0, 0.2, 0.4, 0.5, 0.6, 0.8, 1.0]:\n    hybrid_preds = alpha * cf_test + (1 - alpha) * cb_preds\n    rmse = np.sqrt(np.mean((actual - hybrid_preds) ** 2))\n    if rmse < best_rmse:\n        best_rmse = rmse\n        best_alpha = alpha\n    if alpha in [0.3, 0.5, 0.7]:\n        print(f\"{'Hybrid (\u03b1=' + str(alpha) + ')':<25} {rmse:>8.4f}\")\n\nprint(f\"{'Hybrid (best \u03b1=' + f'{best_alpha}' + ')':<25} {best_rmse:>8.4f}\")\nprint(f\"\\nBest hybrid weight: \u03b1={best_alpha} (CF weight)\")\nprint(f\"Improvement over CB: {(rmse_cb - best_rmse) / rmse_cb * 100:.1f}%\")\nprint(f\"Improvement over CF: {(rmse_cf - best_rmse) / rmse_cf * 100:.1f}%\")"
        ]
