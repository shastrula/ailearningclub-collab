          "python",
          "import numpy as np\nimport pandas as pd\nfrom scipy.sparse.linalg import svds\n\nmovie_titles = [\n    'The Matrix', 'Inception', 'Interstellar', 'The Dark Knight',\n    'Pulp Fiction', 'Fight Club', 'Forrest Gump', 'The Shawshank Redemption',\n    'The Godfather', 'Goodfellas', 'Toy Story', 'Finding Nemo'\n]\n\nratings = np.array([\n    [5, 5, 4, 5, 2, 3, 1, 2, 2, 2, 1, 1],\n    [4, 5, 5, 4, 1, 2, 2, 1, 1, 1, 1, 2],\n    [5, 4, 4, 5, 3, 4, 2, 2, 2, 3, 1, 1],\n    [2, 1, 2, 2, 5, 4, 5, 5, 5, 4, 2, 2],\n    [1, 2, 2, 1, 4, 3, 5, 5, 5, 5, 2, 1],\n    [2, 2, 3, 1, 4, 3, 4, 4, 4, 4, 3, 2],\n    [1, 1, 1, 1, 2, 1, 3, 2, 2, 2, 5, 5],\n    [1, 2, 2, 1, 1, 1, 2, 1, 1, 1, 5, 5],\n    [2, 1, 1, 2, 2, 2, 3, 3, 2, 2, 4, 5],\n], dtype=float)\n\nuser_names = [f'User_{i+1}' for i in range(9)]\nuser_means = ratings.mean(axis=1)\nratings_centered = ratings - user_means.reshape(-1, 1)\n\nk = 3\nU, sigma, Vt = svds(ratings_centered, k=k)\nidx = np.argsort(-sigma)\nsigma = sigma[idx]\nU = U[:, idx]\nVt = Vt[idx, :]\n\n# Interpret latent factors through item loadings\nprint(\"=== Latent Factor Interpretation ===\\n\")\nfor factor_idx in range(k):\n    print(f\"Factor {factor_idx + 1} (singular value: {sigma[factor_idx]:.2f}):\")\n    loadings = Vt[factor_idx]\n    sorted_idx = np.argsort(loadings)[::-1]\n    \n    print(\"  High loadings (positive association):\")\n    for i in sorted_idx[:4]:\n        print(f\"    {movie_titles[i]:<28} {loadings[i]:+.4f}\")\n    print(\"  Low loadings (negative association):\")\n    for i in sorted_idx[-3:]:\n        print(f\"    {movie_titles[i]:<28} {loadings[i]:+.4f}\")\n    print()\n\n# User positions in latent space\nprint(\"=== User Positions in Latent Space ===\")\nuser_factors = U * sigma  # Scale by singular values\nuser_factor_df = pd.DataFrame(\n    user_factors.round(3),\n    index=user_names,\n    columns=['Factor_1', 'Factor_2', 'Factor_3']\n)\nprint(user_factor_df.to_string())"
