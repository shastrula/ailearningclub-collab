        [
          "python",
          "import numpy as np\nfrom scipy.sparse.linalg import svds\n\n# Same ratings matrix\nratings = np.array([\n    [5, 5, 4, 5, 2, 3, 1, 2, 2, 2, 1, 1],\n    [4, 5, 5, 4, 1, 2, 2, 1, 1, 1, 1, 2],\n    [5, 4, 4, 5, 3, 4, 2, 2, 2, 3, 1, 1],\n    [2, 1, 2, 2, 5, 4, 5, 5, 5, 4, 2, 2],\n    [1, 2, 2, 1, 4, 3, 5, 5, 5, 5, 2, 1],\n    [2, 2, 3, 1, 4, 3, 4, 4, 4, 4, 3, 2],\n    [1, 1, 1, 1, 2, 1, 3, 2, 2, 2, 5, 5],\n    [1, 2, 2, 1, 1, 1, 2, 1, 1, 1, 5, 5],\n    [2, 1, 1, 2, 2, 2, 3, 3, 2, 2, 4, 5],\n], dtype=float)\n\nuser_means = ratings.mean(axis=1)\nratings_centered = ratings - user_means.reshape(-1, 1)\n\nprint(\"=== Effect of k (Latent Factors) on RMSE ===\")\nprint(f\"{'k':>3} {'RMSE':>8} {'Variance Explained':>20}\")\nprint(\"-\" * 35)\n\nmax_k = min(ratings.shape) - 1\nfor k in range(1, max_k + 1):\n    U, sigma, Vt = svds(ratings_centered, k=k)\n    reconstructed = U @ np.diag(sigma) @ Vt + user_means.reshape(-1, 1)\n    reconstructed = np.clip(reconstructed, 1, 5)\n    rmse = np.sqrt(np.mean((ratings - reconstructed) ** 2))\n    variance_explained = (sigma ** 2).sum() / np.sum(ratings_centered ** 2)\n    print(f\"{k:>3} {rmse:>8.4f} {variance_explained:>18.2%}\")"
        ]
      ]
