          "import numpy as np\nimport pandas as pd\nfrom scipy.sparse.linalg import svds\n\n# Create a user-item rating matrix\nnp.random.seed(42)\n\nmovie_titles = [\n    'The Matrix', 'Inception', 'Interstellar', 'The Dark Knight',\n    'Pulp Fiction', 'Fight Club', 'Forrest Gump', 'The Shawshank Redemption',\n    'The Godfather', 'Goodfellas', 'Toy Story', 'Finding Nemo'\n]\n\n# Ratings with clear latent structure\n# Factor 1: Action/Sci-fi preference\n# Factor 2: Drama preference\n# Factor 3: Animation preference\nratings = np.array([\n    [5, 5, 4, 5, 2, 3, 1, 2, 2, 2, 1, 1],  # Action lover\n    [4, 5, 5, 4, 1, 2, 2, 1, 1, 1, 1, 2],  # Action/sci-fi\n    [5, 4, 4, 5, 3, 4, 2, 2, 2, 3, 1, 1],  # Action + some drama\n    [2, 1, 2, 2, 5, 4, 5, 5, 5, 4, 2, 2],  # Drama lover\n    [1, 2, 2, 1, 4, 3, 5, 5, 5, 5, 2, 1],  # Drama lover\n    [2, 2, 3, 1, 4, 3, 4, 4, 4, 4, 3, 2],  # Drama + some variety\n    [1, 1, 1, 1, 2, 1, 3, 2, 2, 2, 5, 5],  # Animation lover\n    [1, 2, 2, 1, 1, 1, 2, 1, 1, 1, 5, 5],  # Animation lover\n    [2, 1, 1, 2, 2, 2, 3, 3, 2, 2, 4, 5],  # Animation + some drama\n], dtype=float)\n\nuser_names = [f'User_{i+1}' for i in range(9)]\n\n# Mean-center the matrix (important for SVD)\nuser_means = ratings.mean(axis=1)\nratings_centered = ratings - user_means.reshape(-1, 1)\n\n# Perform SVD with k=3 latent factors\nk = 3\nU, sigma, Vt = svds(ratings_centered, k=k)\n\n# Sort by singular values (largest first)\nidx = np.argsort(-sigma)\nsigma = sigma[idx]\nU = U[:, idx]\nVt = Vt[idx, :]\n\nprint(\"=== SVD Decomposition ===\")\nprint(f\"Original matrix shape: {ratings.shape}\")\nprint(f\"U shape (users \u00d7 factors): {U.shape}\")\nprint(f\"Sigma (singular values): {sigma.round(3)}\")\nprint(f\"Vt shape (factors \u00d7 items): {Vt.shape}\")\nprint(f\"\\nCompression ratio: {ratings.size / (U.size + sigma.size + Vt.size):.2f}x\")\n\n# Reconstruct the matrix\nsigma_diag = np.diag(sigma)\npredicted_centered = U @ sigma_diag @ Vt\npredicted = predicted_centered + user_means.reshape(-1, 1)\npredicted = np.clip(predicted, 1, 5)\n\n# Compare original vs reconstructed\nprint(\"\\n=== Reconstruction Quality ===\")\nrmse = np.sqrt(np.mean((ratings - predicted) ** 2))\nprint(f\"RMSE: {rmse:.4f}\")\nprint(f\"\\nOriginal ratings (User_1):\")\nprint(f\"  {ratings[0].astype(int).tolist()}\")\nprint(f\"Reconstructed ratings (User_1):\")\nprint(f\"  {predicted[0].round(1).tolist()}\")"
