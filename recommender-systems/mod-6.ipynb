        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom scipy.sparse.linalg import svds\n\nmovie_titles = [\n    'The Matrix', 'Inception', 'Interstellar', 'The Dark Knight',\n    'Pulp Fiction', 'Fight Club', 'Forrest Gump', 'The Shawshank Redemption',\n    'The Godfather', 'Goodfellas', 'Toy Story', 'Finding Nemo'\n]\n\n# Introduce missing values (0 means not rated)\nratings_with_missing = np.array([\n    [5, 5, 0, 5, 2, 3, 0, 0, 0, 2, 0, 0],  # User 1\n    [4, 5, 5, 0, 0, 3, 0, 0, 0, 0, 0, 0],  # User 2\n    [5, 0, 4, 4, 2, 0, 0, 0, 0, 0, 1, 0],  # User 3\n    [0, 1, 2, 0, 5, 4, 5, 5, 0, 4, 2, 0],  # User 4\n    [1, 0, 0, 1, 4, 3, 5, 5, 5, 0, 0, 1],  # User 5\n    [0, 0, 0, 0, 0, 0, 3, 0, 0, 0, 5, 5],  # User 6\n    [1, 2, 2, 0, 1, 0, 2, 0, 0, 0, 5, 5],  # User 7\n], dtype=float)\n\nuser_names = [f'User_{i+1}' for i in range(7)]\n\n# Fill missing values with user mean for SVD\nratings_filled = ratings_with_missing.copy()\nfor i in range(ratings_filled.shape[0]):\n    mask = ratings_with_missing[i] > 0\n    if mask.any():\n        user_mean = ratings_with_missing[i][mask].mean()\n        ratings_filled[i][~mask] = user_mean\n\n# Mean-center\nuser_means = ratings_filled.mean(axis=1)\nratings_centered = ratings_filled - user_means.reshape(-1, 1)\n\n# SVD\nk = 3\nU, sigma, Vt = svds(ratings_centered, k=k)\nidx = np.argsort(-sigma)\nsigma = sigma[idx]\nU = U[:, idx]\nVt = Vt[idx, :]\n\n# Predict\npredicted = U @ np.diag(sigma) @ Vt + user_means.reshape(-1, 1)\npredicted = np.clip(predicted, 1, 5)\n\n# Show predictions for missing entries\nprint(\"=== SVD Predictions for Missing Ratings ===\\n\")\nfor user_idx in range(len(user_names)):\n    unrated = np.where(ratings_with_missing[user_idx] == 0)[0]\n    if len(unrated) > 0:\n        preds = [(movie_titles[j], predicted[user_idx, j]) for j in unrated]\n        preds.sort(key=lambda x: x[1], reverse=True)\n        print(f\"{user_names[user_idx]} - Top 3 predictions:\")\n        for title, score in preds[:3]:\n            print(f\"  {title:<28} {score:.2f}\")\n        print()"
        ]
