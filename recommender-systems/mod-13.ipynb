          "python",
          "import numpy as np\n\n# Simulate learned embeddings after training\nnp.random.seed(42)\n\n# User embeddings (8-dimensional, but we show 2D projection)\nuser_embeddings = np.array([\n    [2.1, 1.8],   # User 0 - Action cluster\n    [1.9, 2.0],   # User 1 - Action cluster\n    [2.3, 1.5],   # User 2 - Action cluster\n    [-1.8, 1.9],  # User 3 - Drama cluster\n    [-2.0, 2.1],  # User 4 - Drama cluster\n    [-1.5, 1.7],  # User 5 - Drama cluster\n    [-0.2, -2.1], # User 6 - Animation cluster\n    [0.1, -1.9],  # User 7 - Animation cluster\n    [0.3, -2.3],  # User 8 - Animation cluster\n    [0.8, 0.2],   # User 9 - Mixed preferences\n])\n\nitem_embeddings = np.array([\n    [2.0, 1.5],   # Item 0 - Action\n    [1.8, 1.7],   # Item 1 - Action\n    [2.2, 1.3],   # Item 2 - Action\n    [1.9, 1.9],   # Item 3 - Action\n    [-1.9, 2.0],  # Item 4 - Drama\n    [-2.1, 1.8],  # Item 5 - Drama\n    [-1.7, 2.2],  # Item 6 - Drama\n    [-2.0, 1.6],  # Item 7 - Drama\n    [0.0, -2.0],  # Item 8 - Animation\n    [-0.2, -2.2], # Item 9 - Animation\n    [0.2, -1.8],  # Item 10 - Animation\n    [0.4, -2.0],  # Item 11 - Animation\n])\n\n# Compute distances between User 9 (mixed) and all items\nuser9_emb = user_embeddings[9]\ndistances = np.linalg.norm(item_embeddings - user9_emb, axis=1)\nsimilarities = 1 / (1 + distances)  # Convert distance to similarity\n\nprint(\"=== Embedding Space Analysis ===\\n\")\nprint(\"User clusters (2D projection):\")\nprint(f\"  Action fans (Users 0-2):    centroid = ({user_embeddings[:3].mean(0)[0]:.2f}, {user_embeddings[:3].mean(0)[1]:.2f})\")\nprint(f\"  Drama fans (Users 3-5):     centroid = ({user_embeddings[3:6].mean(0)[0]:.2f}, {user_embeddings[3:6].mean(0)[1]:.2f})\")\nprint(f\"  Animation fans (Users 6-8): centroid = ({user_embeddings[6:9].mean(0)[0]:.2f}, {user_embeddings[6:9].mean(0)[1]:.2f})\")\nprint(f\"  Mixed (User 9):             position = ({user9_emb[0]:.2f}, {user9_emb[1]:.2f})\")\n\nprint(f\"\\n--- User 9's proximity to items ---\")\nprint(f\"{'Item':<8} {'Distance':>10} {'Similarity':>12}\")\nprint(\"-\" * 32)\nranked = np.argsort(distances)\nfor idx in ranked:\n    print(f\"Item_{idx:<3} {distances[idx]:>10.3f} {similarities[idx]:>12.4f}\")"
