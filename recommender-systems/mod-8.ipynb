        [
          "python",
          "import numpy as np\n\ndef precision_at_k(recommended, relevant, k):\n    \"\"\"Precision@k: fraction of recommended items that are relevant.\"\"\"\n    recommended_k = recommended[:k]\n    hits = len(set(recommended_k) & set(relevant))\n    return hits / k\n\ndef recall_at_k(recommended, relevant, k):\n    \"\"\"Recall@k: fraction of relevant items that were recommended.\"\"\"\n    recommended_k = recommended[:k]\n    hits = len(set(recommended_k) & set(relevant))\n    return hits / len(relevant) if len(relevant) > 0 else 0.0\n\n# Example: User's recommended list and actual relevant items\nrecommended_items = ['Movie_A', 'Movie_B', 'Movie_C', 'Movie_D', 'Movie_E',\n                     'Movie_F', 'Movie_G', 'Movie_H', 'Movie_I', 'Movie_J']\nrelevant_items = ['Movie_A', 'Movie_C', 'Movie_F', 'Movie_H', 'Movie_K']\n\nprint(\"=== Precision@k and Recall@k ===\")\nprint(f\"Recommended: {recommended_items}\")\nprint(f\"Relevant:    {relevant_items}\")\nprint(f\"\\n{'k':>3} {'Precision@k':>12} {'Recall@k':>10}\")\nprint(\"-\" * 30)\nfor k in [1, 3, 5, 7, 10]:\n    p = precision_at_k(recommended_items, relevant_items, k)\n    r = recall_at_k(recommended_items, relevant_items, k)\n    print(f\"{k:>3} {p:>12.4f} {r:>10.4f}\")\n\n# Multiple users\nprint(\"\\n=== Average Precision@5 Across Users ===\")\nuser_recommendations = {\n    'User_1': (['A', 'B', 'C', 'D', 'E'], ['A', 'C', 'E', 'G']),\n    'User_2': (['X', 'Y', 'Z', 'W', 'V'], ['X', 'Z', 'Q', 'R']),\n    'User_3': (['P', 'Q', 'R', 'S', 'T'], ['A', 'B', 'C', 'D']),\n}\n\nprecisions = []\nrecalls = []\nfor user, (recs, rels) in user_recommendations.items():\n    p = precision_at_k(recs, rels, 5)\n    r = recall_at_k(recs, rels, 5)\n    precisions.append(p)\n    recalls.append(r)\n    print(f\"  {user}: P@5={p:.3f}, R@5={r:.3f}\")\n\nprint(f\"\\n  Average P@5: {np.mean(precisions):.4f}\")\nprint(f\"  Average R@5: {np.mean(recalls):.4f}\")"
        ]
      ]
    },
    {
