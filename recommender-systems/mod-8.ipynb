      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\n\n# Simulated predictions vs actual ratings\nnp.random.seed(42)\n\nactual_ratings = np.array([5, 4, 3, 5, 2, 4, 1, 3, 5, 4, 2, 3, 4, 5, 1])\npredicted_ratings = np.array([4.2, 3.8, 3.5, 4.6, 2.3, 3.5, 1.8, 2.9, 4.7, 4.1, 2.5, 3.2, 3.6, 4.8, 1.5])\n\n# RMSE - Root Mean Square Error\ndef rmse(actual, predicted):\n    return np.sqrt(np.mean((actual - predicted) ** 2))\n\n# MAE - Mean Absolute Error\ndef mae(actual, predicted):\n    return np.mean(np.abs(actual - predicted))\n\nrmse_val = rmse(actual_ratings, predicted_ratings)\nmae_val = mae(actual_ratings, predicted_ratings)\n\nprint(\"=== Rating Prediction Metrics ===\")\nprint(f\"\\nActual:    {actual_ratings.tolist()}\")\nprint(f\"Predicted: {predicted_ratings.tolist()}\")\nprint(f\"\\nRMSE: {rmse_val:.4f}\")\nprint(f\"MAE:  {mae_val:.4f}\")\n\n# Compare two models\nmodel_a_preds = np.array([4.2, 3.8, 3.5, 4.6, 2.3, 3.5, 1.8, 2.9, 4.7, 4.1, 2.5, 3.2, 3.6, 4.8, 1.5])\nmodel_b_preds = np.array([4.8, 4.2, 2.5, 4.9, 1.5, 4.2, 1.2, 3.5, 4.9, 3.8, 3.0, 2.8, 4.5, 4.5, 2.0])\n\nprint(\"\\n=== Model Comparison ===\")\nprint(f\"Model A - RMSE: {rmse(actual_ratings, model_a_preds):.4f}, MAE: {mae(actual_ratings, model_a_preds):.4f}\")\nprint(f\"Model B - RMSE: {rmse(actual_ratings, model_b_preds):.4f}, MAE: {mae(actual_ratings, model_b_preds):.4f}\")\nprint(\"\\nModel B has higher RMSE because it makes some large errors,\")\nprint(\"even though it gets some predictions exactly right.\")"
        ]
      ]
    },
