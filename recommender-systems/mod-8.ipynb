          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.metrics.pairwise import cosine_similarity\nfrom sklearn.decomposition import NMF\n\n# Full evaluation pipeline\nnp.random.seed(42)\n\n# Create dataset\nn_users, n_items = 20, 12\nmovie_titles = ['Matrix', 'Inception', 'Interstellar', 'Dark Knight',\n                'Pulp Fiction', 'Fight Club', 'Forrest Gump', 'Shawshank',\n                'Godfather', 'Goodfellas', 'Toy Story', 'Finding Nemo']\n\n# Generate ratings with structure\nratings = np.zeros((n_users, n_items))\nfor i in range(n_users):\n    n_rated = np.random.randint(5, 10)\n    items = np.random.choice(n_items, n_rated, replace=False)\n    if i < 7:  # Action fans\n        for j in items:\n            if j < 4:\n                ratings[i, j] = np.random.choice([4, 5])\n            else:\n                ratings[i, j] = np.random.choice([1, 2, 3])\n    elif i < 14:  # Drama fans\n        for j in items:\n            if 4 <= j < 10:\n                ratings[i, j] = np.random.choice([4, 5])\n            else:\n                ratings[i, j] = np.random.choice([1, 2, 3])\n    else:  # Animation fans\n        for j in items:\n            if j >= 10:\n                ratings[i, j] = np.random.choice([4, 5])\n            else:\n                ratings[i, j] = np.random.choice([1, 2, 3])\n\n# Train-test split: hold out last 2 ratings per user\ntrain = ratings.copy()\ntest_pairs = []\nfor i in range(n_users):\n    rated = np.where(ratings[i] > 0)[0]\n    if len(rated) > 2:\n        test_items = np.random.choice(rated, 2, replace=False)\n        for j in test_items:\n            test_pairs.append((i, j, ratings[i, j]))\n            train[i, j] = 0\n\ntest_pairs = np.array(test_pairs)\n\n# Model 1: Popularity baseline\nitem_means = np.zeros(n_items)\nfor j in range(n_items):\n    rated = train[:, j][train[:, j] > 0]\n    item_means[j] = rated.mean() if len(rated) > 0 else 3.0\n\npopularity_preds = item_means[test_pairs[:, 1].astype(int)]\n\n# Model 2: NMF\ntrain_filled = train.copy()\nfor i in range(n_users):\n    mask = train[i] == 0\n    train_filled[i][mask] = item_means[mask]\n\nnmf = NMF(n_components=3, init='random', random_state=42, max_iter=500)\nW = nmf.fit_transform(train_filled)\nH = nmf.components_\nnmf_all_preds = np.clip(W @ H, 1, 5)\nnmf_preds = np.array([nmf_all_preds[int(p[0]), int(p[1])] for p in test_pairs])\n\n# Model 3: User-based CF\nuser_sim = cosine_similarity(train)\ndef predict_ub(user_idx, item_idx, ratings_mat, sim_mat, k=5):\n    rated_mask = ratings_mat[:, item_idx] > 0\n    rated_mask[user_idx] = False\n    if not rated_mask.any():\n        return 3.0\n    sims = sim_mat[user_idx][rated_mask]\n    vals = ratings_mat[rated_mask, item_idx]\n    if len(sims) > k:\n        top_k = np.argsort(sims)[::-1][:k]\n        sims, vals = sims[top_k], vals[top_k]\n    return np.clip(np.dot(sims, vals) / max(sims.sum(), 0.001), 1, 5)\n\nubcf_preds = np.array([predict_ub(int(p[0]), int(p[1]), train, user_sim) for p in test_pairs])\n\n# Compute metrics\nactual = test_pairs[:, 2]\n\ndef compute_rmse(a, p): return np.sqrt(np.mean((a - p) ** 2))\ndef compute_mae(a, p): return np.mean(np.abs(a - p))\n\nprint(\"=== Evaluation Results ===\")\nprint(f\"\\n{'Model':<20} {'RMSE':>8} {'MAE':>8}\")\nprint(\"-\" * 38)\nprint(f\"{'Popularity':<20} {compute_rmse(actual, popularity_preds):>8.4f} {compute_mae(actual, popularity_preds):>8.4f}\")\nprint(f\"{'NMF (k=3)':<20} {compute_rmse(actual, nmf_preds):>8.4f} {compute_mae(actual, nmf_preds):>8.4f}\")\nprint(f\"{'User-based CF':<20} {compute_rmse(actual, ubcf_preds):>8.4f} {compute_mae(actual, ubcf_preds):>8.4f}\")"
        ]
      ]
