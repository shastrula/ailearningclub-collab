        [
          "python",
          "import numpy as np\n\ndef dcg_at_k(relevances, k):\n    \"\"\"Compute DCG@k.\"\"\"\n    relevances = np.array(relevances[:k])\n    positions = np.arange(1, len(relevances) + 1)\n    discounts = np.log2(positions + 1)\n    return np.sum(relevances / discounts)\n\ndef ndcg_at_k(recommended_relevances, k):\n    \"\"\"Compute NDCG@k.\"\"\"\n    dcg = dcg_at_k(recommended_relevances, k)\n    # Ideal DCG: sort relevances in descending order\n    ideal_relevances = sorted(recommended_relevances, reverse=True)\n    idcg = dcg_at_k(ideal_relevances, k)\n    return dcg / idcg if idcg > 0 else 0.0\n\n# Example: relevance scores for recommended items (0=irrelevant, 1-5=relevance)\n# Perfect ranking vs imperfect ranking\nperfect_ranking = [5, 4, 3, 2, 1, 0, 0, 0, 0, 0]\ngood_ranking =    [4, 5, 3, 0, 2, 1, 0, 0, 0, 0]\npoor_ranking =    [0, 0, 1, 0, 2, 3, 4, 5, 0, 0]\n\nprint(\"=== NDCG (Normalized Discounted Cumulative Gain) ===\")\nprint(f\"\\nPerfect ranking: {perfect_ranking}\")\nprint(f\"Good ranking:    {good_ranking}\")\nprint(f\"Poor ranking:    {poor_ranking}\")\n\nprint(f\"\\n{'k':>3} {'Perfect':>10} {'Good':>10} {'Poor':>10}\")\nprint(\"-\" * 35)\nfor k in [1, 3, 5, 10]:\n    ndcg_perfect = ndcg_at_k(perfect_ranking, k)\n    ndcg_good = ndcg_at_k(good_ranking, k)\n    ndcg_poor = ndcg_at_k(poor_ranking, k)\n    print(f\"{k:>3} {ndcg_perfect:>10.4f} {ndcg_good:>10.4f} {ndcg_poor:>10.4f}\")\n\nprint(\"\\n--- Interpretation ---\")\nprint(\"NDCG=1.0 means perfect ranking (best items first)\")\nprint(\"NDCG penalizes relevant items appearing lower in the list\")"
        ]
      ]
    },
