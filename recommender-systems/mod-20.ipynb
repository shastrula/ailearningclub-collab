        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom scipy import stats\n\nnp.random.seed(42)\n\n# Simulate an A/B test: Model A (current) vs Model B (new)\nn_users_per_group = 5000\nn_days = 14  # 2-week test\n\n# Model A: Current production system\n# Model B: New hybrid recommender\n\n# Simulate user engagement metrics\ndef simulate_group(n_users, base_ctr, base_watch_time, base_retention):\n    \"\"\"Simulate metrics for one group.\"\"\"\n    ctr = np.random.beta(\n        base_ctr * 100, (1 - base_ctr) * 100, n_users\n    )\n    watch_time = np.random.exponential(base_watch_time, n_users)\n    retained = np.random.binomial(1, base_retention, n_users)\n    return ctr, watch_time, retained\n\n# Group A (control): 5% CTR, 25 min watch time, 70% retention\nctr_a, watch_a, retain_a = simulate_group(n_users_per_group, 0.05, 25, 0.70)\n\n# Group B (treatment): slightly better - 5.5% CTR, 27 min, 72% retention\nctr_b, watch_b, retain_b = simulate_group(n_users_per_group, 0.055, 27, 0.72)\n\nprint(\"=== A/B Test Results (14-day experiment) ===\\n\")\nprint(f\"Users per group: {n_users_per_group}\")\nprint(f\"Test duration: {n_days} days\\n\")\n\nmetrics = {\n    'Click-Through Rate': (ctr_a, ctr_b),\n    'Watch Time (min)': (watch_a, watch_b),\n    'Retention Rate': (retain_a.astype(float), retain_b.astype(float)),\n}\n\nprint(f\"{'Metric':<25} {'Control':>10} {'Treatment':>10} {'Lift':>8} {'p-value':>10} {'Significant':>12}\")\nprint(\"-\" * 80)\n\nfor metric_name, (group_a, group_b) in metrics.items():\n    mean_a = group_a.mean()\n    mean_b = group_b.mean()\n    lift = (mean_b - mean_a) / mean_a * 100\n    \n    # Two-sample t-test\n    t_stat, p_value = stats.ttest_ind(group_a, group_b)\n    significant = 'Yes ***' if p_value < 0.001 else ('Yes **' if p_value < 0.01 else ('Yes *' if p_value < 0.05 else 'No'))\n    \n    print(f\"{metric_name:<25} {mean_a:>10.4f} {mean_b:>10.4f} {lift:>+7.1f}% {p_value:>10.4f} {significant:>12}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
