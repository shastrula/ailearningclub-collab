        [
          "python",
          "import numpy as np\nfrom scipy import stats\n\ndef required_sample_size(baseline, minimum_detectable_effect, alpha=0.05, power=0.80):\n    \"\"\"Calculate required sample size per group for A/B test.\"\"\"\n    # For proportions (like CTR, retention)\n    p1 = baseline\n    p2 = baseline * (1 + minimum_detectable_effect)\n    \n    # Pooled standard error\n    p_avg = (p1 + p2) / 2\n    \n    z_alpha = stats.norm.ppf(1 - alpha / 2)\n    z_beta = stats.norm.ppf(power)\n    \n    n = ((z_alpha * np.sqrt(2 * p_avg * (1 - p_avg)) + \n          z_beta * np.sqrt(p1 * (1 - p1) + p2 * (1 - p2))) / (p2 - p1)) ** 2\n    \n    return int(np.ceil(n))\n\nprint(\"=== Sample Size Requirements ===\\n\")\nprint(f\"{'Metric':<20} {'Baseline':>10} {'MDE':>8} {'Sample/Group':>14} {'Total Users':>12}\")\nprint(\"-\" * 68)\n\nscenarios = [\n    ('CTR', 0.05, 0.10),         # Detect 10% lift in CTR\n    ('CTR', 0.05, 0.05),         # Detect 5% lift in CTR\n    ('CTR', 0.05, 0.02),         # Detect 2% lift in CTR\n    ('Retention', 0.70, 0.03),   # Detect 3% lift in retention\n    ('Retention', 0.70, 0.01),   # Detect 1% lift in retention\n]\n\nfor metric, baseline, mde in scenarios:\n    n = required_sample_size(baseline, mde)\n    print(f\"{metric:<20} {baseline:>10.2%} {mde:>7.0%}% {n:>14,} {n*2:>12,}\")\n\nprint(\"\\nNote: Smaller effects require exponentially more users to detect!\")"
        ]
      ]
    },
