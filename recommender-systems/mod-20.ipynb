          "python",
          "import numpy as np\nfrom scipy import stats\n\nnp.random.seed(42)\n\ndef team_draft_interleaving(list_a, list_b, k=10):\n    \"\"\"\n    Team-draft interleaving: merge two ranked lists fairly.\n    Alternately pick items from A and B, respecting their order.\n    \"\"\"\n    interleaved = []\n    team_a = set()  # Items credited to model A\n    team_b = set()  # Items credited to model B\n    \n    idx_a, idx_b = 0, 0\n    \n    while len(interleaved) < k and (idx_a < len(list_a) or idx_b < len(list_b)):\n        # Alternate starting with a coin flip\n        if len(team_a) <= len(team_b) and idx_a < len(list_a):\n            item = list_a[idx_a]\n            idx_a += 1\n            if item not in interleaved:\n                interleaved.append(item)\n                team_a.add(item)\n        elif idx_b < len(list_b):\n            item = list_b[idx_b]\n            idx_b += 1\n            if item not in interleaved:\n                interleaved.append(item)\n                team_b.add(item)\n        else:\n            break\n    \n    return interleaved, team_a, team_b\n\n# Simulate interleaving experiment\nlist_a = ['Movie_1', 'Movie_3', 'Movie_5', 'Movie_7', 'Movie_9',\n           'Movie_2', 'Movie_4', 'Movie_6', 'Movie_8', 'Movie_10']\nlist_b = ['Movie_2', 'Movie_1', 'Movie_4', 'Movie_6', 'Movie_3',\n           'Movie_8', 'Movie_5', 'Movie_10', 'Movie_7', 'Movie_9']\n\ninterleaved, team_a, team_b = team_draft_interleaving(list_a, list_b, k=6)\n\nprint(\"=== Interleaving: Team-Draft Method ===\\n\")\nprint(f\"Model A ranking: {list_a[:6]}\")\nprint(f\"Model B ranking: {list_b[:6]}\")\nprint(f\"Interleaved list: {interleaved}\")\nprint(f\"Team A items: {team_a}\")\nprint(f\"Team B items: {team_b}\")\n\n# Simulate many users clicking on interleaved results\nn_experiments = 1000\nwins_a, wins_b, ties = 0, 0, 0\n\nfor _ in range(n_experiments):\n    # Model B is slightly better - users tend to click its items more\n    interleaved, ta, tb = team_draft_interleaving(list_a, list_b, k=6)\n    \n    # Simulate clicks (B items get clicked slightly more)\n    clicks_a, clicks_b = 0, 0\n    for item in interleaved:\n        if item in ta and np.random.random() < 0.15:\n            clicks_a += 1\n        elif item in tb and np.random.random() < 0.18:\n            clicks_b += 1\n    \n    if clicks_b > clicks_a:\n        wins_b += 1\n    elif clicks_a > clicks_b:\n        wins_a += 1\n    else:\n        ties += 1\n\nprint(f\"\\n--- Interleaving Results ({n_experiments} impressions) ---\")\nprint(f\"Model A wins: {wins_a} ({wins_a/n_experiments:.1%})\")\nprint(f\"Model B wins: {wins_b} ({wins_b/n_experiments:.1%})\")\nprint(f\"Ties:         {ties} ({ties/n_experiments:.1%})\")\n\n# Binomial test\nnon_ties = wins_a + wins_b\nif non_ties > 0:\n    p_value = stats.binom_test(wins_b, non_ties, 0.5)\n    print(f\"\\np-value (B > A): {p_value:.4f}\")\n    print(f\"Conclusion: {'Model B is significantly better' if p_value < 0.05 else 'No significant difference'}\")"
        ]
      ]
