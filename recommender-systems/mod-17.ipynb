          "python",
          "import numpy as np\nimport pandas as pd\n\n# Product scoring with multiple criteria and trade-offs\nproducts = pd.DataFrame({\n    'name': ['Product A', 'Product B', 'Product C', 'Product D', 'Product E'],\n    'price': [100, 200, 150, 300, 80],\n    'quality': [3, 5, 4, 5, 2],\n    'delivery_days': [5, 2, 3, 1, 7],\n    'eco_rating': [4, 3, 5, 2, 4],\n    'warranty_years': [1, 3, 2, 5, 1]\n})\n\n# Different user profiles (importance weights)\nuser_profiles = {\n    'Budget Buyer': {'price': -0.4, 'quality': 0.2, 'delivery_days': -0.1, \n                     'eco_rating': 0.1, 'warranty_years': 0.2},\n    'Quality First': {'price': -0.1, 'quality': 0.4, 'delivery_days': -0.1, \n                      'eco_rating': 0.1, 'warranty_years': 0.3},\n    'Eco Conscious': {'price': -0.2, 'quality': 0.2, 'delivery_days': -0.1, \n                      'eco_rating': 0.4, 'warranty_years': 0.1},\n}\n\ndef multi_criteria_score(products_df, weights):\n    \"\"\"Score products using weighted multi-criteria.\"\"\"\n    scores = np.zeros(len(products_df))\n    \n    for field, weight in weights.items():\n        values = products_df[field].values.astype(float)\n        # Normalize to [0, 1]\n        min_val, max_val = values.min(), values.max()\n        if max_val - min_val > 0:\n            normalized = (values - min_val) / (max_val - min_val)\n        else:\n            normalized = np.ones_like(values) * 0.5\n        \n        scores += weight * normalized\n    \n    return scores\n\nprint(\"=== Multi-Criteria Product Recommendations ===\\n\")\nprint(\"Product catalog:\")\nprint(products.to_string(index=False))\nprint()\n\nfor profile_name, weights in user_profiles.items():\n    scores = multi_criteria_score(products, weights)\n    ranked = np.argsort(scores)[::-1]\n    \n    print(f\"--- {profile_name} ---\")\n    print(f\"  Weights: {weights}\")\n    print(f\"  Ranking:\")\n    for rank, idx in enumerate(ranked[:3]):\n        print(f\"    {rank+1}. {products.iloc[idx]['name']} (score: {scores[idx]:.3f})\")\n    print()"
        ]
      ]
