          "python",
          "import numpy as np\nimport pandas as pd\n\nlaptops = pd.DataFrame({\n    'name': ['ThinkPad X1', 'MacBook Pro 14', 'Dell XPS 15', 'HP Spectre',\n             'ASUS ROG', 'Lenovo Yoga', 'Surface Laptop', 'Acer Swift',\n             'MSI Creator', 'Framework 16', 'MacBook Air', 'ThinkPad T14'],\n    'price': [1599, 1999, 1749, 1399, 1899, 1199, 1299, 899,\n              2199, 1399, 1199, 1349],\n    'ram_gb': [16, 32, 32, 16, 32, 16, 16, 8, 64, 32, 16, 16],\n    'storage_gb': [512, 512, 1000, 512, 1000, 512, 256, 512, 1000, 512, 256, 512],\n    'weight_kg': [1.12, 1.55, 1.86, 1.34, 2.30, 1.39, 1.27, 1.20, 2.10, 2.00, 1.24, 1.46],\n    'battery_hrs': [15, 17, 13, 12, 6, 14, 18, 10, 8, 10, 18, 12],\n    'screen_inches': [14, 14.2, 15.6, 13.5, 15.6, 14, 13.5, 14, 16, 16, 13.6, 14],\n})\n\ndef compute_similarity(reference, candidate, weights):\n    \"\"\"Compute weighted similarity between reference item and candidate.\"\"\"\n    similarity = 0\n    for field, weight in weights.items():\n        ref_val = reference[field]\n        cand_val = candidate[field]\n        \n        if isinstance(ref_val, bool):\n            similarity += weight * (1 if ref_val == cand_val else 0)\n        else:\n            # Normalize difference\n            max_val = laptops[field].max()\n            min_val = laptops[field].min()\n            if max_val - min_val > 0:\n                diff = abs(ref_val - cand_val) / (max_val - min_val)\n                similarity += weight * (1 - diff)\n            else:\n                similarity += weight\n    \n    return similarity / sum(weights.values())\n\ndef case_based_recommend(catalog, reference_name, critique=None, weights=None):\n    \"\"\"Find similar items to reference, optionally applying a critique.\"\"\"\n    if weights is None:\n        weights = {'price': 1, 'ram_gb': 1, 'storage_gb': 1, \n                   'weight_kg': 1, 'battery_hrs': 1, 'screen_inches': 0.5}\n    \n    reference = catalog[catalog['name'] == reference_name].iloc[0]\n    \n    # Apply critique: shift the reference point\n    if critique:\n        reference = reference.copy()\n        for field, direction in critique.items():\n            if direction == 'lower':\n                reference[field] = reference[field] * 0.7\n            elif direction == 'higher':\n                reference[field] = reference[field] * 1.3\n    \n    # Compute similarities\n    similarities = []\n    for idx, candidate in catalog.iterrows():\n        if candidate['name'] == reference_name and critique is None:\n            continue\n        sim = compute_similarity(reference, candidate, weights)\n        similarities.append((candidate['name'], sim, candidate['price'], candidate['ram_gb']))\n    \n    return sorted(similarities, key=lambda x: x[1], reverse=True)\n\n# Interaction flow\nprint(\"=== Case-Based Recommender with Critiquing ===\\n\")\nprint(\"Step 1: User starts with 'MacBook Pro 14' as reference\")\nprint(\"-\" * 50)\nrecs = case_based_recommend(laptops, 'MacBook Pro 14')\nprint(f\"{'Laptop':<20} {'Similarity':>12} {'Price':>8} {'RAM':>6}\")\nprint(\"-\" * 50)\nfor name, sim, price, ram in recs[:5]:\n    print(f\"{name:<20} {sim:>12.4f} ${price:>7} {ram:>4}GB\")\n\nprint(\"\\n\\nStep 2: User critiques 'I want something CHEAPER'\")\nprint(\"-\" * 50)\nrecs = case_based_recommend(laptops, 'MacBook Pro 14', critique={'price': 'lower'})\nprint(f\"{'Laptop':<20} {'Similarity':>12} {'Price':>8} {'RAM':>6}\")\nprint(\"-\" * 50)\nfor name, sim, price, ram in recs[:5]:\n    print(f\"{name:<20} {sim:>12.4f} ${price:>7} {ram:>4}GB\")\n\nprint(\"\\n\\nStep 3: User critiques 'lighter weight'\")\nprint(\"-\" * 50)\nrecs = case_based_recommend(laptops, 'MacBook Pro 14', \n                           critique={'price': 'lower', 'weight_kg': 'lower'})\nprint(f\"{'Laptop':<20} {'Similarity':>12} {'Price':>8} {'RAM':>6}\")\nprint(\"-\" * 50)\nfor name, sim, price, ram in recs[:5]:\n    print(f\"{name:<20} {sim:>12.4f} ${price:>7} {ram:>4}GB\")"
        ]
