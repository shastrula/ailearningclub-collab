          "python",
          "import numpy as np\nimport pandas as pd\n\n# Laptop catalog\nlaptops = pd.DataFrame({\n    'name': ['ThinkPad X1', 'MacBook Pro 14', 'Dell XPS 15', 'HP Spectre',\n             'ASUS ROG', 'Lenovo Yoga', 'Surface Laptop', 'Acer Swift',\n             'MSI Creator', 'Framework 16', 'MacBook Air', 'ThinkPad T14'],\n    'price': [1599, 1999, 1749, 1399, 1899, 1199, 1299, 899, \n              2199, 1399, 1199, 1349],\n    'ram_gb': [16, 32, 32, 16, 32, 16, 16, 8, 64, 32, 16, 16],\n    'storage_gb': [512, 512, 1000, 512, 1000, 512, 256, 512, 1000, 512, 256, 512],\n    'weight_kg': [1.12, 1.55, 1.86, 1.34, 2.30, 1.39, 1.27, 1.20, 2.10, 2.00, 1.24, 1.46],\n    'battery_hrs': [15, 17, 13, 12, 6, 14, 18, 10, 8, 10, 18, 12],\n    'gpu_dedicated': [False, True, True, False, True, False, False, False, True, True, False, False],\n    'screen_inches': [14, 14.2, 15.6, 13.5, 15.6, 14, 13.5, 14, 16, 16, 13.6, 14],\n})\n\ndef constraint_based_recommend(catalog, constraints):\n    \"\"\"Filter catalog by hard constraints and rank by soft preferences.\"\"\"\n    filtered = catalog.copy()\n    applied_constraints = []\n    \n    for field, (operator, value) in constraints.items():\n        if field.startswith('pref_'):\n            continue  # Handle preferences separately\n        \n        if operator == '<=':\n            filtered = filtered[filtered[field] <= value]\n        elif operator == '>=':\n            filtered = filtered[filtered[field] >= value]\n        elif operator == '==':\n            filtered = filtered[filtered[field] == value]\n        \n        applied_constraints.append(f\"{field} {operator} {value}\")\n    \n    return filtered, applied_constraints\n\n# User requirements\nuser_constraints = {\n    'price': ('<=', 1500),\n    'ram_gb': ('>=', 16),\n    'weight_kg': ('<=', 1.5),\n    'battery_hrs': ('>=', 12),\n}\n\nresults, applied = constraint_based_recommend(laptops, user_constraints)\n\nprint(\"=== Constraint-Based Laptop Recommender ===\\n\")\nprint(\"User requirements:\")\nfor c in applied:\n    print(f\"  \u2022 {c}\")\nprint(f\"\\nMatching laptops: {len(results)} of {len(laptops)}\")\nprint()\n\nif len(results) > 0:\n    print(results[['name', 'price', 'ram_gb', 'weight_kg', 'battery_hrs']].to_string(index=False))\nelse:\n    print(\"No laptops match all constraints!\")\n    print(\"\\nRelaxing constraints...\")\n    # Remove the most restrictive constraint\n    relaxed = user_constraints.copy()\n    del relaxed['weight_kg']\n    results, applied = constraint_based_recommend(laptops, relaxed)\n    print(f\"\\nAfter removing weight constraint: {len(results)} matches\")\n    print(results[['name', 'price', 'ram_gb', 'weight_kg', 'battery_hrs']].to_string(index=False))"
        ]
      ]
    },
