          "python",
          "import numpy as np\n\nnp.random.seed(42)\n\n# Simple bipartite graph: users connected to items they rated\nn_users, n_items = 8, 8\nratings = np.array([\n    [5, 4, 0, 0, 0, 0, 0, 0],\n    [0, 5, 4, 0, 0, 0, 0, 0],\n    [0, 0, 5, 4, 0, 0, 0, 0],\n    [0, 0, 0, 5, 4, 0, 0, 0],\n    [0, 0, 0, 0, 5, 4, 0, 0],\n    [0, 0, 0, 0, 0, 5, 4, 0],\n    [0, 0, 0, 0, 0, 0, 5, 4],\n    [4, 0, 0, 0, 0, 0, 0, 5],\n], dtype=float)\n\ndef graph_based_spreading(ratings_mat, n_hops=2, decay=0.5):\n    \"\"\"\n    Spread preferences through the user-item bipartite graph.\n    User \u2192 rated items \u2192 other users who rated same items \u2192 their items\n    \"\"\"\n    n_u, n_i = ratings_mat.shape\n    # Normalize ratings to [0, 1]\n    norm_ratings = ratings_mat / 5.0\n    \n    # Item popularity (how many users rated each item)\n    item_pop = (ratings_mat > 0).sum(axis=0)\n    \n    # Spread: for each unrated item, check if connected through rated items\n    spread_scores = np.zeros_like(ratings_mat)\n    \n    for user in range(n_u):\n        rated_items = np.where(ratings_mat[user] > 0)[0]\n        \n        for item in range(n_i):\n            if ratings_mat[user, item] > 0:\n                spread_scores[user, item] = ratings_mat[user, item]\n                continue\n            \n            # Find users who rated this item\n            users_who_rated = np.where(ratings_mat[:, item] > 0)[0]\n            \n            for other_user in users_who_rated:\n                # Check if we share any rated items (connection strength)\n                shared = np.where((ratings_mat[user] > 0) & (ratings_mat[other_user] > 0))[0]\n                if len(shared) > 0:\n                    # Connection strength * other user's rating * decay\n                    connection = norm_ratings[user, shared].mean() * norm_ratings[other_user, shared].mean()\n                    contribution = connection * ratings_mat[other_user, item] * decay\n                    spread_scores[user, item] += contribution\n    \n    return spread_scores\n\n# Apply graph spreading\nspread = graph_based_spreading(ratings, n_hops=2, decay=0.5)\n\nprint(\"=== Graph-Based Score Spreading ===\\n\")\nprint(\"Original sparse matrix (0 = unrated):\")\nprint(ratings.astype(int))\n\nprint(\"\\nAfter graph spreading (transitive scores):\")\nprint(np.round(spread, 2))\n\nprint(\"\\n--- Key Insight ---\")\nprint(\"User 0 rated items 0,1. User 1 rated items 1,2.\")\nprint(f\"Through shared item 1, User 0 gets score for item 2: {spread[0, 2]:.2f}\")\nprint(\"Chain continues: item 2 \u2192 User 2 \u2192 items 3,4 \u2192 reach further items\")"
        ]
      ]
