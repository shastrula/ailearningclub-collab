          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Create matrices with different sparsity levels\ndef create_sparse_matrix(n_users, n_items, density):\n    \"\"\"Create a rating matrix with specified density.\"\"\"\n    matrix = np.zeros((n_users, n_items))\n    n_ratings = int(n_users * n_items * density)\n    \n    for _ in range(n_ratings):\n        u = np.random.randint(0, n_users)\n        i = np.random.randint(0, n_items)\n        if matrix[u, i] == 0:\n            matrix[u, i] = np.random.randint(1, 6)\n    \n    return matrix\n\n# Different sparsity levels\nscenarios = [\n    (\"Dense (20% filled)\", 50, 30, 0.20),\n    (\"Moderate (5% filled)\", 50, 30, 0.05),\n    (\"Sparse (1% filled)\", 50, 30, 0.01),\n    (\"MovieLens-like (0.5%)\", 500, 200, 0.005),\n]\n\nprint(\"=== Sparsity Impact Analysis ===\\n\")\nprint(f\"{'Scenario':<25} {'Shape':<12} {'Ratings':>8} {'Sparsity':>10} {'Avg/User':>10}\")\nprint(\"-\" * 70)\n\nfor name, n_u, n_i, density in scenarios:\n    matrix = create_sparse_matrix(n_u, n_i, density)\n    actual_ratings = (matrix > 0).sum()\n    actual_sparsity = 1 - actual_ratings / (n_u * n_i)\n    avg_per_user = actual_ratings / n_u\n    print(f\"{name:<25} {f'{n_u}\u00d7{n_i}':<12} {actual_ratings:>8} {actual_sparsity:>9.2%} {avg_per_user:>10.1f}\")\n\n# Impact on similarity computation\nprint(\"\\n=== Co-rated Items Distribution ===\")\nmatrix_sparse = create_sparse_matrix(100, 50, 0.05)\n\nco_rated_counts = []\nfor i in range(100):\n    for j in range(i+1, 100):\n        mask = (matrix_sparse[i] > 0) & (matrix_sparse[j] > 0)\n        co_rated_counts.append(mask.sum())\n\nco_rated = np.array(co_rated_counts)\nprint(f\"\\nWith 5% density (100 users, 50 items):\")\nprint(f\"  Average co-rated items per user pair: {co_rated.mean():.2f}\")\nprint(f\"  User pairs with 0 co-rated items: {(co_rated == 0).sum()} ({(co_rated == 0).mean():.1%})\")\nprint(f\"  User pairs with >= 3 co-rated items: {(co_rated >= 3).sum()} ({(co_rated >= 3).mean():.1%})\")\nprint(f\"  User pairs with >= 5 co-rated items: {(co_rated >= 5).sum()} ({(co_rated >= 5).mean():.1%})\")\nprint(f\"\\nConsequence: Most user pairs cannot be meaningfully compared!\")"
        ]
      ]
    },
