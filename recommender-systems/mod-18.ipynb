          "python",
          "import numpy as np\nfrom sklearn.decomposition import TruncatedSVD\nfrom sklearn.metrics.pairwise import cosine_similarity\n\nnp.random.seed(42)\n\n# Larger sparse matrix\nn_users, n_items = 30, 20\n\n# Create structured sparse data\nratings = np.zeros((n_users, n_items))\n# Cluster 1: Users 0-9 like items 0-6\nfor i in range(10):\n    rated_items = np.random.choice(range(7), 3, replace=False)\n    for j in rated_items:\n        ratings[i, j] = np.random.choice([4, 5])\n    # Occasional cross-cluster\n    if np.random.random() < 0.2:\n        ratings[i, np.random.randint(7, 20)] = np.random.choice([1, 2])\n\n# Cluster 2: Users 10-19 like items 7-13\nfor i in range(10, 20):\n    rated_items = np.random.choice(range(7, 14), 3, replace=False)\n    for j in rated_items:\n        ratings[i, j] = np.random.choice([4, 5])\n    if np.random.random() < 0.2:\n        ratings[i, np.random.randint(0, 7)] = np.random.choice([1, 2])\n\n# Cluster 3: Users 20-29 like items 14-19\nfor i in range(20, 30):\n    rated_items = np.random.choice(range(14, 20), 3, replace=False)\n    for j in rated_items:\n        ratings[i, j] = np.random.choice([4, 5])\n\nsparsity = (ratings == 0).sum() / ratings.size\nprint(f\"=== SVD-based Sparsity Handling ===\")\nprint(f\"Matrix: {n_users}\u00d7{n_items}, Sparsity: {sparsity:.1%}\\n\")\n\n# Fill with small constant for SVD\nratings_filled = ratings.copy()\nratings_filled[ratings == 0] = 0.1  # Small non-zero value\n\n# Apply SVD to get dense representations\nsvd = TruncatedSVD(n_components=5, random_state=42)\nuser_factors = svd.fit_transform(ratings_filled)\n\n# Compare raw vs SVD-reduced similarities\nsim_raw = cosine_similarity(ratings)  # Sparse - many zeros\nsim_svd = cosine_similarity(user_factors)  # Dense - smooth\n\n# Check if SVD correctly identifies clusters\nprint(\"Similarity within clusters (should be high):\")\nprint(f\"  Raw - Cluster 1 avg:  {sim_raw[:10, :10][np.triu_indices(10, 1)].mean():.4f}\")\nprint(f\"  SVD - Cluster 1 avg:  {sim_svd[:10, :10][np.triu_indices(10, 1)].mean():.4f}\")\nprint(f\"  Raw - Cluster 2 avg:  {sim_raw[10:20, 10:20][np.triu_indices(10, 1)].mean():.4f}\")\nprint(f\"  SVD - Cluster 2 avg:  {sim_svd[10:20, 10:20][np.triu_indices(10, 1)].mean():.4f}\")\n\nprint(\"\\nSimilarity between clusters (should be low):\")\nprint(f\"  Raw - C1 vs C2:  {sim_raw[:10, 10:20].mean():.4f}\")\nprint(f\"  SVD - C1 vs C2:  {sim_svd[:10, 10:20].mean():.4f}\")\nprint(f\"  Raw - C1 vs C3:  {sim_raw[:10, 20:30].mean():.4f}\")\nprint(f\"  SVD - C1 vs C3:  {sim_svd[:10, 20:30].mean():.4f}\")\n\nprint(\"\\nSVD better separates clusters despite high sparsity!\")"
        ]
