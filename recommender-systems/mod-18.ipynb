          "python",
          "import numpy as np\nfrom sklearn.metrics.pairwise import cosine_similarity\n\nnp.random.seed(42)\n\n# Sparse matrix\nn_users, n_items = 10, 8\nratings = np.array([\n    [5, 4, 0, 0, 0, 0, 0, 0],\n    [4, 5, 0, 0, 0, 0, 0, 0],\n    [0, 0, 0, 5, 4, 0, 0, 0],\n    [0, 0, 0, 4, 5, 0, 0, 0],\n    [0, 0, 0, 0, 0, 5, 4, 0],\n    [0, 0, 0, 0, 0, 4, 5, 0],\n    [5, 0, 0, 0, 0, 0, 0, 4],\n    [0, 4, 0, 0, 0, 0, 4, 0],\n    [0, 0, 5, 0, 0, 4, 0, 0],\n    [0, 0, 4, 0, 5, 0, 0, 0],\n], dtype=float)\n\n# Different imputation strategies\nstrategies = {\n    'zeros': ratings.copy(),  # Treat missing as 0 (default)\n    'user_mean': ratings.copy(),\n    'item_mean': ratings.copy(),\n    'global_mean': ratings.copy(),\n}\n\n# User mean imputation\nglobal_mean = ratings[ratings > 0].mean()\nfor i in range(n_users):\n    rated = ratings[i][ratings[i] > 0]\n    user_mean = rated.mean() if len(rated) > 0 else global_mean\n    mask = ratings[i] == 0\n    strategies['user_mean'][i][mask] = user_mean\n\n# Item mean imputation\nfor j in range(n_items):\n    rated = ratings[:, j][ratings[:, j] > 0]\n    item_mean = rated.mean() if len(rated) > 0 else global_mean\n    mask = ratings[:, j] == 0\n    strategies['item_mean'][:, j][mask] = item_mean\n\n# Global mean imputation\nstrategies['global_mean'][ratings == 0] = global_mean\n\n# Compare similarity quality\nprint(\"=== Imputation Strategies Comparison ===\\n\")\nprint(f\"Global mean of rated entries: {global_mean:.2f}\")\nprint(f\"Sparsity: {(ratings == 0).sum() / ratings.size:.1%}\\n\")\n\n# Users 0 and 1 should be similar (both like items 0,1)\n# Users 0 and 4 should be different (no overlap)\nprint(f\"{'Strategy':<15} {'Sim(U0,U1)':>12} {'Sim(U0,U4)':>12} {'Correct?':>10}\")\nprint(\"-\" * 52)\n\nfor name, matrix in strategies.items():\n    sim = cosine_similarity(matrix)\n    s01 = sim[0, 1]\n    s04 = sim[0, 4]\n    correct = 'Yes' if s01 > s04 else 'No'\n    print(f\"{name:<15} {s01:>12.4f} {s04:>12.4f} {correct:>10}\")"
        ]
