        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.decomposition import TruncatedSVD\nfrom sklearn.metrics.pairwise import cosine_similarity\nimport time\n\nnp.random.seed(42)\n\n# Larger dataset to show speed difference\nn_users, n_items = 100, 50\n\n# Generate sparse ratings\nratings = np.zeros((n_users, n_items))\nfor i in range(n_users):\n    n_rated = np.random.randint(10, 25)\n    items = np.random.choice(n_items, n_rated, replace=False)\n    cluster = i // 25  # 4 clusters\n    for j in items:\n        if j // 12 == cluster:\n            ratings[i, j] = np.random.choice([4, 5])\n        else:\n            ratings[i, j] = np.random.choice([1, 2, 3])\n\n# Fill for SVD\nratings_filled = ratings.copy()\nglobal_mean = ratings[ratings > 0].mean()\nratings_filled[ratings_filled == 0] = global_mean\n\n# Reduce dimensions\nsvd = TruncatedSVD(n_components=10, random_state=42)\nusers_reduced = svd.fit_transform(ratings_filled)\n\n# Compare similarity computation\n# Full space\nstart = time.time()\nsim_full = cosine_similarity(ratings_filled)\ntime_full = time.time() - start\n\n# Reduced space\nstart = time.time()\nsim_reduced = cosine_similarity(users_reduced)\ntime_reduced = time.time() - start\n\nprint(\"=== Speed Comparison: Full vs Reduced Space ===\")\nprint(f\"\\nFull space:    {n_items} dimensions, time={time_full*1000:.2f}ms\")\nprint(f\"Reduced space: 10 dimensions, time={time_reduced*1000:.2f}ms\")\nprint(f\"Speedup: {time_full/time_reduced:.1f}x\")\n\n# Quality comparison: how well does reduced similarity approximate full?\n# Compare top-5 neighbors for each user\nagreement = 0\ntotal = 0\nfor i in range(n_users):\n    full_neighbors = np.argsort(sim_full[i])[::-1][1:6]\n    reduced_neighbors = np.argsort(sim_reduced[i])[::-1][1:6]\n    agreement += len(set(full_neighbors) & set(reduced_neighbors))\n    total += 5\n\nprint(f\"\\nNeighbor agreement (top-5): {agreement/total:.2%}\")\nprint(f\"Correlation of similarities: {np.corrcoef(sim_full.flatten(), sim_reduced.flatten())[0,1]:.4f}\")"
        ]
      ]
    },
