      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.decomposition import PCA\n\n# Create a rating matrix with clear structure\nnp.random.seed(42)\n\nn_users, n_items = 30, 15\nitem_names = [f'Item_{i+1}' for i in range(n_items)]\n\n# Three clusters of users with different preferences\nratings = np.zeros((n_users, n_items))\n\n# Cluster 1: Users 0-9 like items 0-4 (action)\nfor i in range(10):\n    for j in range(5):\n        ratings[i, j] = np.random.choice([4, 5])\n    for j in range(5, 15):\n        if np.random.random() < 0.3:\n            ratings[i, j] = np.random.choice([1, 2, 3])\n\n# Cluster 2: Users 10-19 like items 5-9 (drama)\nfor i in range(10, 20):\n    for j in range(5, 10):\n        ratings[i, j] = np.random.choice([4, 5])\n    for j in list(range(5)) + list(range(10, 15)):\n        if np.random.random() < 0.3:\n            ratings[i, j] = np.random.choice([1, 2, 3])\n\n# Cluster 3: Users 20-29 like items 10-14 (animation)\nfor i in range(20, 30):\n    for j in range(10, 15):\n        ratings[i, j] = np.random.choice([4, 5])\n    for j in range(10):\n        if np.random.random() < 0.3:\n            ratings[i, j] = np.random.choice([1, 2, 3])\n\n# Fill zeros with user mean for PCA\nratings_filled = ratings.copy()\nfor i in range(n_users):\n    mask = ratings[i] > 0\n    if mask.any():\n        ratings_filled[i][~mask] = ratings[i][mask].mean()\n\n# Apply PCA\npca = PCA(n_components=5, random_state=42)\nusers_reduced = pca.fit_transform(ratings_filled)\n\nprint(\"=== PCA on Rating Matrix ===\")\nprint(f\"Original shape: {ratings_filled.shape}\")\nprint(f\"Reduced shape:  {users_reduced.shape}\")\nprint(f\"\\nExplained variance ratio per component:\")\nfor i, var in enumerate(pca.explained_variance_ratio_):\n    bar = '#' * int(var * 50)\n    print(f\"  PC{i+1}: {var:.4f} |{bar}\")\nprint(f\"\\nTotal variance explained (5 components): {pca.explained_variance_ratio_.sum():.4f}\")\n\n# Show user clusters in 2D\nprint(f\"\\n--- User Clusters in 2D Projection ---\")\nprint(f\"{'User':<8} {'PC1':>8} {'PC2':>8} {'Cluster':<12}\")\nprint(\"-\" * 40)\nfor i in [0, 5, 10, 15, 20, 25]:\n    cluster = 'Action' if i < 10 else ('Drama' if i < 20 else 'Animation')\n    print(f\"User_{i+1:<3} {users_reduced[i, 0]:>8.3f} {users_reduced[i, 1]:>8.3f} {cluster:<12}\")"
        ]
      ]
    },
    {
