          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.decomposition import TruncatedSVD\nfrom sklearn.metrics.pairwise import cosine_similarity\n\n# Items described by many features (simulating TF-IDF on descriptions)\nnp.random.seed(42)\nn_items = 12\nn_features = 50  # High-dimensional feature space\n\nitem_names = ['Matrix', 'Inception', 'Interstellar', 'Dark Knight',\n              'Pulp Fiction', 'Shawshank', 'Forrest Gump', 'Godfather',\n              'Toy Story', 'Nemo', 'Lion King', 'Spirited Away']\n\n# Create feature vectors with structure\nitem_features = np.random.rand(n_items, n_features) * 0.1  # Background noise\n\n# Action movies share features 0-15\nfor i in range(4):\n    item_features[i, :16] += np.random.rand(16) * 0.8\n\n# Drama movies share features 16-31\nfor i in range(4, 8):\n    item_features[i, 16:32] += np.random.rand(16) * 0.8\n\n# Animation movies share features 32-47\nfor i in range(8, 12):\n    item_features[i, 32:48] += np.random.rand(16) * 0.8\n\n# Reduce item features to 3D\nsvd = TruncatedSVD(n_components=3, random_state=42)\nitems_reduced = svd.fit_transform(item_features)\n\n# Compare similarities before and after reduction\nsim_full = cosine_similarity(item_features)\nsim_reduced = cosine_similarity(items_reduced)\n\nprint(\"=== Item Similarity: Full vs Reduced ===\\n\")\nprint(\"Most similar to 'Matrix' (full 50D space):\")\nmatrix_sims_full = [(item_names[j], sim_full[0, j]) for j in range(1, n_items)]\nmatrix_sims_full.sort(key=lambda x: x[1], reverse=True)\nfor name, sim in matrix_sims_full[:5]:\n    print(f\"  {name:<15} {sim:.4f}\")\n\nprint(\"\\nMost similar to 'Matrix' (reduced 3D space):\")\nmatrix_sims_red = [(item_names[j], sim_reduced[0, j]) for j in range(1, n_items)]\nmatrix_sims_red.sort(key=lambda x: x[1], reverse=True)\nfor name, sim in matrix_sims_red[:5]:\n    print(f\"  {name:<15} {sim:.4f}\")\n\nprint(f\"\\nReduction preserved cluster structure:\")\nprint(f\"  Action items close together: {sim_reduced[0,1]:.3f} (Matrix-Inception)\")\nprint(f\"  Cross-cluster distance: {sim_reduced[0,8]:.3f} (Matrix-Toy Story)\")"
