        [
          "python",
          "import numpy as np\nfrom sklearn.decomposition import TruncatedSVD\nfrom sklearn.metrics.pairwise import cosine_similarity\n\nnp.random.seed(42)\nn_users, n_items = 50, 20\n\n# Create structured ratings\nratings = np.zeros((n_users, n_items))\nfor i in range(n_users):\n    n_rated = np.random.randint(8, 16)\n    items = np.random.choice(n_items, n_rated, replace=False)\n    cluster = i // 10\n    for j in items:\n        if j // 4 == cluster:\n            ratings[i, j] = np.random.choice([4, 5])\n        else:\n            ratings[i, j] = np.random.choice([1, 2, 3])\n\nratings_filled = ratings.copy()\nratings_filled[ratings_filled == 0] = ratings[ratings > 0].mean()\n\n# Hold out test ratings\ntest_mask = np.zeros_like(ratings, dtype=bool)\nfor i in range(n_users):\n    rated = np.where(ratings[i] > 0)[0]\n    if len(rated) > 3:\n        test_items = np.random.choice(rated, 2, replace=False)\n        test_mask[i, test_items] = True\n\n# Evaluate different dimensions\nprint(\"=== Optimal Dimensionality Selection ===\\n\")\nprint(f\"{'Dims':>6} {'Var Explained':>14} {'Neighbor RMSE':>14} {'Quality':>10}\")\nprint(\"-\" * 48)\n\nfor n_dim in [2, 3, 5, 8, 10, 15]:\n    svd = TruncatedSVD(n_components=n_dim, random_state=42)\n    reduced = svd.fit_transform(ratings_filled)\n    var_exp = svd.explained_variance_ratio_.sum()\n    \n    # Reconstruct and compute RMSE on test set\n    reconstructed = reduced @ svd.components_\n    test_errors = (ratings[test_mask] - reconstructed[test_mask]) ** 2\n    rmse = np.sqrt(test_errors.mean()) if len(test_errors) > 0 else 0\n    \n    # Quality indicator\n    quality = 'Too few' if n_dim < 3 else ('Optimal' if 3 <= n_dim <= 8 else 'Overfitting')\n    print(f\"{n_dim:>6} {var_exp:>14.4f} {rmse:>14.4f} {quality:>10}\")"
        ]
      ]
    },
