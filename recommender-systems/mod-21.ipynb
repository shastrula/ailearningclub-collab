          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Simulate recommendation quality across demographic groups\nn_users = 2000\n\n# User groups\ngroups = np.array(['Group_A'] * 1000 + ['Group_B'] * 1000)\n\n# Simulate: biased system gives better recs to Group A\n# (e.g., more data from Group A leads to better models for them)\nndcg_biased_a = np.random.beta(8, 3, 1000)  # Mean ~0.73\nndcg_biased_b = np.random.beta(5, 5, 1000)  # Mean ~0.50\n\n# Fair system: similar quality for both groups\nndcg_fair_a = np.random.beta(7, 4, 1000)    # Mean ~0.64\nndcg_fair_b = np.random.beta(6, 4, 1000)    # Mean ~0.60\n\nprint(\"=== Fairness Across User Groups ===\\n\")\nprint(f\"{'Metric':<30} {'Group A':>10} {'Group B':>10} {'Gap':>8} {'Fair?':>8}\")\nprint(\"-\" * 70)\n\nprint(f\"\\nBiased System:\")\ngap_biased = ndcg_biased_a.mean() - ndcg_biased_b.mean()\nfair_biased = 'No' if abs(gap_biased) > 0.1 else 'Yes'\nprint(f\"{'  NDCG@10':<30} {ndcg_biased_a.mean():>10.4f} {ndcg_biased_b.mean():>10.4f} {gap_biased:>+7.4f} {fair_biased:>8}\")\n\nprint(f\"\\nFair System:\")\ngap_fair = ndcg_fair_a.mean() - ndcg_fair_b.mean()\nfair_fair = 'No' if abs(gap_fair) > 0.1 else 'Yes'\nprint(f\"{'  NDCG@10':<30} {ndcg_fair_a.mean():>10.4f} {ndcg_fair_b.mean():>10.4f} {gap_fair:>+7.4f} {fair_fair:>8}\")\n\nprint(f\"\\n--- Trade-off Analysis ---\")\nprint(f\"Biased system overall NDCG: {np.concatenate([ndcg_biased_a, ndcg_biased_b]).mean():.4f}\")\nprint(f\"Fair system overall NDCG:   {np.concatenate([ndcg_fair_a, ndcg_fair_b]).mean():.4f}\")\nprint(f\"\\nThe fair system sacrifices {(np.concatenate([ndcg_biased_a, ndcg_biased_b]).mean() - np.concatenate([ndcg_fair_a, ndcg_fair_b]).mean()):.1%} overall accuracy\")\nprint(f\"to reduce the group gap from {abs(gap_biased):.4f} to {abs(gap_fair):.4f}\")"
        ]
      ]
