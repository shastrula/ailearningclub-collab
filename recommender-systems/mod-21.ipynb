        [
          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# User genre preferences (from their history)\nuser_genre_distribution = {\n    'action': 0.40,\n    'drama': 0.25,\n    'comedy': 0.20,\n    'horror': 0.10,\n    'documentary': 0.05,\n}\n\n# Uncalibrated recommender output (over-indexes on action)\nuncalibrated_recs = {\n    'action': 0.70,     # System over-recommends action\n    'drama': 0.15,      # Under-recommends drama\n    'comedy': 0.10,     # Under-recommends comedy\n    'horror': 0.05,\n    'documentary': 0.00, # Never recommends documentaries!\n}\n\ndef calibration_error(user_prefs, rec_distribution):\n    \"\"\"KL-divergence between user preferences and recommendation distribution.\"\"\"\n    kl = 0\n    for genre in user_prefs:\n        p = user_prefs[genre]\n        q = max(rec_distribution.get(genre, 0), 1e-10)  # Avoid log(0)\n        if p > 0:\n            kl += p * np.log(p / q)\n    return kl\n\ndef calibrate_recommendations(items_with_genres, scores, user_prefs, top_k=10, lambda_cal=0.5):\n    \"\"\"Re-rank recommendations to match user genre distribution.\"\"\"\n    # Greedy re-ranking with calibration\n    selected = []\n    remaining = list(range(len(items_with_genres)))\n    \n    for position in range(top_k):\n        best_idx = None\n        best_score = -float('inf')\n        \n        for idx in remaining:\n            # Relevance component\n            relevance = scores[idx]\n            \n            # Calibration component\n            temp_selected = selected + [idx]\n            genre_counts = {}\n            for sel_idx in temp_selected:\n                genre = items_with_genres[sel_idx]\n                genre_counts[genre] = genre_counts.get(genre, 0) + 1\n            \n            total = len(temp_selected)\n            rec_dist = {g: c/total for g, c in genre_counts.items()}\n            cal_error = calibration_error(user_prefs, rec_dist)\n            \n            # Combined score: relevance - lambda * calibration_error\n            combined = (1 - lambda_cal) * relevance - lambda_cal * cal_error\n            \n            if combined > best_score:\n                best_score = combined\n                best_idx = idx\n        \n        selected.append(best_idx)\n        remaining.remove(best_idx)\n    \n    return selected\n\n# Demo calibration\nitems = ['Action1', 'Action2', 'Action3', 'Action4', 'Action5',\n         'Drama1', 'Drama2', 'Comedy1', 'Comedy2', 'Horror1',\n         'Doc1', 'Action6', 'Drama3', 'Comedy3', 'Horror2']\ngenres = ['action', 'action', 'action', 'action', 'action',\n          'drama', 'drama', 'comedy', 'comedy', 'horror',\n          'documentary', 'action', 'drama', 'comedy', 'horror']\nscores = [0.95, 0.90, 0.85, 0.80, 0.75, 0.70, 0.65, 0.60, 0.55, 0.50,\n           0.45, 0.40, 0.35, 0.30, 0.25]\n\n# Uncalibrated: just take top-10 by score\nuncal_top10 = list(range(10))\nuncal_genres = [genres[i] for i in uncal_top10]\n\n# Calibrated\ncal_top10 = calibrate_recommendations(genres, scores, user_genre_distribution, top_k=10)\ncal_genres = [genres[i] for i in cal_top10]\n\nprint(\"=== Calibration: Matching User Preferences ===\\n\")\nprint(\"User genre preferences:\")\nfor genre, pref in user_genre_distribution.items():\n    print(f\"  {genre:<15} {pref:.0%}\")\n\nprint(f\"\\n{'Position':<5} {'Uncalibrated':<20} {'Calibrated':<20}\")\nprint(\"-\" * 48)\nfor i in range(10):\n    print(f\"{i+1:<5} {items[uncal_top10[i]]:<20} {items[cal_top10[i]]:<20}\")\n\n# Compare distributions\nprint(f\"\\n--- Genre Distribution in Top-10 ---\")\nprint(f\"{'Genre':<15} {'User Pref':>10} {'Uncalibrated':>13} {'Calibrated':>12}\")\nprint(\"-\" * 53)\nfor genre in user_genre_distribution:\n    user_p = user_genre_distribution[genre]\n    uncal_p = uncal_genres.count(genre) / 10\n    cal_p = cal_genres.count(genre) / 10\n    print(f\"{genre:<15} {user_p:>9.0%} {uncal_p:>12.0%} {cal_p:>11.0%}\")"
        ]
      ]
