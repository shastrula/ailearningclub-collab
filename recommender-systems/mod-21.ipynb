      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Simulate a recommender system's output\nn_items = 100\nn_users = 1000\n\n# Item popularity (power-law distribution - few popular, many niche)\nitem_popularity = np.random.pareto(1.5, n_items)\nitem_popularity = item_popularity / item_popularity.sum()\nitem_popularity.sort()\nitem_popularity = item_popularity[::-1]  # Most popular first\n\n# Standard recommender: biased toward popular items\nbiased_recommendations = np.random.choice(\n    n_items, size=(n_users, 10), \n    p=item_popularity\n)\n\n# Fair recommender: more uniform distribution\nuniform_probs = np.ones(n_items) / n_items\nfair_recommendations = np.random.choice(\n    n_items, size=(n_users, 10),\n    p=uniform_probs\n)\n\n# Measure coverage and Gini index\ndef coverage(recommendations, n_items):\n    \"\"\"Fraction of items that appear in any recommendation.\"\"\"\n    unique_items = set(recommendations.flatten())\n    return len(unique_items) / n_items\n\ndef gini_index(recommendations, n_items):\n    \"\"\"Gini index of recommendation frequency (0=equal, 1=concentrated).\"\"\"\n    item_counts = np.zeros(n_items)\n    for item in recommendations.flatten():\n        item_counts[item] += 1\n    \n    item_counts.sort()\n    n = len(item_counts)\n    cumulative = np.cumsum(item_counts)\n    gini = (n + 1 - 2 * np.sum(cumulative) / cumulative[-1]) / n\n    return gini\n\ndef long_tail_coverage(recommendations, n_items, tail_threshold=0.8):\n    \"\"\"What fraction of long-tail items (bottom 80%) get recommended?\"\"\"\n    tail_items = set(range(int(n_items * (1 - tail_threshold)), n_items))\n    recommended_items = set(recommendations.flatten())\n    tail_recommended = tail_items & recommended_items\n    return len(tail_recommended) / len(tail_items)\n\nprint(\"=== Popularity Bias Analysis ===\\n\")\nprint(f\"{'Metric':<30} {'Biased System':>15} {'Fair System':>15}\")\nprint(\"-\" * 63)\n\ncov_biased = coverage(biased_recommendations, n_items)\ncov_fair = coverage(fair_recommendations, n_items)\nprint(f\"{'Catalog coverage':<30} {cov_biased:>14.1%} {cov_fair:>14.1%}\")\n\ngini_biased = gini_index(biased_recommendations, n_items)\ngini_fair = gini_index(fair_recommendations, n_items)\nprint(f\"{'Gini index (lower=fairer)':<30} {gini_biased:>15.4f} {gini_fair:>15.4f}\")\n\ntail_biased = long_tail_coverage(biased_recommendations, n_items)\ntail_fair = long_tail_coverage(fair_recommendations, n_items)\nprint(f\"{'Long-tail coverage (80%)':<30} {tail_biased:>14.1%} {tail_fair:>14.1%}\")\n\n# Top-10 item concentration\ntop10_biased = np.sum([np.isin(biased_recommendations, range(10)).sum()])\ntop10_fair = np.sum([np.isin(fair_recommendations, range(10)).sum()])\ntotal_recs = n_users * 10\nprint(f\"{'Top-10 items share':<30} {top10_biased/total_recs:>14.1%} {top10_fair/total_recs:>14.1%}\")"
        ]
      ]
    },
