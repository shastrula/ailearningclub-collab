      "source": [
        [
          "python",
          "class MemoryAgent:\n    def __init__(self):\n        self.memory = {}\n\n    def remember(self, key, value):\n        self.memory[key] = value\n\n    def recall(self, key):\n        return self.memory.get(key, None)\n\nagent = MemoryAgent()\nagent.remember('user_preference', 'tech_articles')\nprint(agent.recall('user_preference'))  # Output: tech_articles"
        ]
      ]
    },
    {
