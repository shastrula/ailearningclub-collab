      "source": [
        [
          "python",
          "class MemoryAgent:\n    def __init__(self):\n        self.memory = {}\n\n    def store(self, key, value):\n        self.memory[key] = value\n\n    def retrieve(self, key):\n        return self.memory.get(key, None)\n\nagent = MemoryAgent()\nagent.store('user_name', 'Alice')\nprint(agent.retrieve('user_name'))  # Output: Alice"
        ]
      ]
    },
