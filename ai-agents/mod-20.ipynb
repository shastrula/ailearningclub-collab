        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def reason(task):\n    \"\"\"Simulate reasoning about a task.\"\"\"\n    # Example reasoning logic\n    if 'sort' in task:\n        return'sorting algorithm'\n    return 'default action'\n\ndef act(action):\n    \"\"\"Simulate performing an action.\"\"\"\n    # Example action logic\n    if action =='sorting algorithm':\n        return 'Performing sort'\n    return 'Performing default action'\n\ntask = 'sort numbers'\naction = reason(task)\nresult = act(action)\nprint(result)  # Output: Performing sort"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from langgraph import LangGraph\n\n# Define agents\nagent1 = LangGraph.Agent('Agent1', lambda task: 'Agent1 processed'+ task)\nagent2 = LangGraph.Agent('Agent2', lambda task: 'Agent2 processed'+ task)\n\n# Create a multi-agent system\nsystem = LangGraph.System()\nsystem.add_agent(agent1)\nsystem.add_agent(agent2)\n\n# Define task and execute\ntask = 'example task'\nresult = system.execute(task)\nprint(result)  # Output: ['Agent1 processed example task', 'Agent2 processed example task']"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def tool_call(tool, input_data):\n    \"\"\"Simulate calling an external tool.\"\"\"\n    if tool == 'database_query':\n        return 'Query result:'+ input_data\n    return 'Tool not recognized'\n\ntool = 'database_query'\ninput_data = 'user_id=123'\nresult = tool_call(tool, input_data)\nprint(result)  # Output: Query result: user_id=123"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "class Memory:\n    def __init__(self):\n        self.data = {}\n\n    def store(self, key, value):\n        self.data[key] = value\n\n    def retrieve(self, key):\n        return self.data.get(key, 'No data found')\n\nmemory = Memory()\nmemory.store('user_preferences', 'likes_tech')\npreference = memory.retrieve('user_preferences')\nprint(preference)  # Output: likes_tech"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "class Agent:\n    def __init__(self, name):\n        self.name = name\n\n    def perform_task(self, task):\n        return f'{self.name} performed {task}'\n\nagent1 = Agent('Agent1')\nagent2 = Agent('Agent2')\n\ntask = 'traffic optimization'\nresults = [agent1.perform_task(task), agent2.perform_task(task)]\nprint(results)  # Output: ['Agent1 performed traffic optimization', 'Agent2 performed traffic optimization']"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def autonomous_workflow(tasks):\n    results = []\n    for task in tasks:\n        results.append(f'Task {task} completed')\n    return results\n\ntasks = ['pick', 'place', 'assemble']\nworkflow_results = autonomous_workflow(tasks)\nprint(workflow_results)  # Output: ['Task pick completed', 'Task place completed', 'Task assemble completed']"
        ]
      ]
    }
