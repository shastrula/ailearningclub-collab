          "python",
          "def safe_claim(claim, verify_tool):\n    \"\"\"Verify claims before acting on them\"\"\"\n    verification = verify_tool(claim)\n    if verification['verified']:\n        return True\n    else:\n        print(f\"Warning: Claim '{claim}' could not be verified\")\n        return False"
        ]
      ]
