        [
          "python",
          "def run_agent_with_limits(agent, input, max_iterations=10):\n    for i in range(max_iterations):\n        result = agent.step(input)\n        if result['complete']:\n            return result['output']\n        input = result['next_input']\n    \n    # Fallback if max iterations exceeded\n    return \"Could not complete task within iteration limit\""
        ]
      ]
    }
