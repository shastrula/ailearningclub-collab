        [
          "python",
          "# Example: Agent with calculator tool\n\ndef calculator_tool(operation, a, b):\n    \"\"\"Calculator tool for arithmetic\"\"\"\n    operations = {\n        'add': a + b,\n        'subtract': a - b,\n        'multiply': a * b,\n        'divide': a / b if b != 0 else None\n    }\n    return operations.get(operation, None)\n\ndef search_tool(query):\n    \"\"\"Search tool (mock implementation)\"\"\"\n    # In production, query real search API\n    results = {\n        'weather': 'Sunny, 72\u00b0F',\n        'capital of france': 'Paris',\n        'python version': '3.11'\n    }\n    return results.get(query.lower(), 'Not found')\n\n# Agent reasoning with tools\ndef agent_think(question):\n    if 'calculate' in question.lower():\n        # Parse and execute calculation\n        result = calculator_tool('add', 5, 3)\n        return f\"The answer is {result}\"\n    elif 'what is' in question.lower():\n        # Use search tool\n        query = question.replace('what is ', '')\n        result = search_tool(query)\n        return f\"Found: {result}\"\n    return \"I don't know how to handle that question\"\n\n# Test agent\nprint(agent_think(\"Calculate 5 plus 3\"))\nprint(agent_think(\"What is the capital of France\"))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
