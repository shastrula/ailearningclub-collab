        [
          "python",
          "class SimpleAgent:\n    def __init__(self):\n        self.short_term_memory = []  # Last N messages\n    \n    def remember(self, message):\n        self.short_term_memory.append(message)\n        if len(self.short_term_memory) > 10:\n            self.short_term_memory.pop(0)  # Keep last 10\n    \n    def get_context(self):\n        return '\\n'.join(self.short_term_memory)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import sqlite3\n\nclass AgentWithMemory:\n    def __init__(self):\n        self.conn = sqlite3.connect(':memory:')\n        self.setup_db()\n    \n    def setup_db(self):\n        self.conn.execute('''\n            CREATE TABLE memories (\n                id INTEGER PRIMARY KEY,\n                category TEXT,\n                content TEXT,\n                timestamp DATETIME DEFAULT CURRENT_TIMESTAMP\n            )\n        ''')\n        self.conn.commit()\n    \n    def store_memory(self, category, content):\n        self.conn.execute(\n            'INSERT INTO memories (category, content) VALUES (?, ?)',\n            (category, content)\n        )\n        self.conn.commit()\n    \n    def recall(self, category):\n        cursor = self.conn.execute(\n            'SELECT content FROM memories WHERE category = ?',\n            (category,)\n        )\n        return [row[0] for row in cursor.fetchall()]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Simplified LLM agent framework\n\nclass LLMAgent:\n    def __init__(self, model):\n        self.model = model\n        self.conversation_history = []\n        self.tools = {\n            'search': self.search_tool,\n            'calculator': self.calculator_tool,\n            'weather': self.weather_tool\n        }\n    \n    def search_tool(self, query):\n        \"\"\"Simulated search\"\"\"\n        return f\"Search results for '{query}': [result 1, result 2, ...]\"\n    \n    def calculator_tool(self, expression):\n        \"\"\"Simulated calculator\"\"\"\n        return f\"Result of {expression} is {eval(expression)}\"\n    \n    def weather_tool(self, location):\n        \"\"\"Simulated weather API\"\"\"\n        return f\"Weather in {location}: Sunny, 72\u00b0F\"\n    \n    def format_tools_for_prompt(self):\n        \"\"\"Create tool descriptions for LLM\"\"\"\n        return \"\"\"\nAvailable tools:\n- search(query): Search the web for information\n- calculator(expression): Evaluate mathematical expressions\n- weather(location): Get current weather for location\n\nWhen you need external information, respond with: [TOOL: tool_name(parameter)]\n\"\"\"\n    \n    def process_user_input(self, user_input):\n        self.conversation_history.append(f\"User: {user_input}\")\n        \n        # Build prompt\n        prompt = f\"\"\"You are a helpful AI assistant.\n{self.format_tools_for_prompt()}\n\nConversation:\n{chr(10).join(self.conversation_history)}\n\nYour response:\"\"\"\n        \n        # Get LLM response\n        response = self.model.generate(prompt)\n        \n        # Parse for tool calls\n        if '[TOOL:' in response:\n            # Extract and execute tool\n            tool_call = response.split('[TOOL:')[1].split(']')[0]\n            # ... parse and execute tool\n            tool_result = f\"Tool result: {tool_call}\"\n            self.conversation_history.append(f\"Assistant: {response}\")\n            self.conversation_history.append(f\"Tool: {tool_result}\")\n            # Repeat reasoning\n            return self.process_user_input(\"Continue processing\")\n        else:\n            self.conversation_history.append(f\"Assistant: {response}\")\n            return response"
        ]
      ]
    },
