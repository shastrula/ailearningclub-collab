        [
          "python",
          "# Simple agent loop: observe \u2192 think \u2192 act\nclass Agent:\n    def __init__(self, name):\n        self.name = name\n        self.memory = []\n    \n    def act(self, observation):\n        self.memory.append(observation)\n        action = f\"Responding to: {observation}\"\n        return action\n\nagent = Agent(\"Assistant\")\nprint(agent.act(\"User asked about Python\"))"
        ]
      ]
    }
