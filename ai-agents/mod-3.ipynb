          "python",
          "from langgraph import Graph\n\n# Create a LangGraph instance\nworkflow = Graph()\n\n# Define nodes\nworkflow.add_node('start', lambda: 'Hello, LangGraph!')\nworkflow.add_node('end', lambda x: f'Received: {x}')\n\n# Define edges\nworkflow.add_edge('start', 'end')\n\n# Run the workflow\nresult = workflow.run()\nprint(result)"
        ]
      ]
    },
    {
