        "# Google Colab Cloud Computing For Ai - mod-1\n\n",
        "**Course:** google-colab-cloud-computing-for-ai\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport tensorflow as tf\nimport time\n\n# Check GPU availability\nprint(\"PyTorch GPU Available:\", torch.cuda.is_available())\nprint(\"TensorFlow GPU Available:\", len(tf.config.list_physical_devices('GPU')) > 0)\n\n# Benchmark: matrix multiplication on GPU vs CPU\ndef benchmark_matmul(size=5000, device=\"cpu\"):\n    if device == \"cuda\":\n        A = torch.randn(size, size).cuda()\n        B = torch.randn(size, size).cuda()\n        torch.cuda.synchronize()\n        start = time.time()\n        C = torch.matmul(A, B)\n        torch.cuda.synchronize()\n    else:\n        A = torch.randn(size, size).cpu()\n        B = torch.randn(size, size).cpu()\n        start = time.time()\n        C = torch.matmul(A, B)\n    elapsed = time.time() - start\n    return elapsed\n\n# Compare GPU vs CPU performance\nif torch.cuda.is_available():\n    gpu_time = benchmark_matmul(5000, \"cuda\")\n    cpu_time = benchmark_matmul(5000, \"cpu\")\n    print(f\"GPU time: {gpu_time:.4f}s\")\n    print(f\"CPU time: {cpu_time:.4f}s\")\n    print(f\"Speedup: {cpu_time/gpu_time:.1f}x\")\nelse:\n    print(\"GPU not available in this session\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Demonstrate Colab-specific features\nimport time\n\n# Time a code block\n%time result = sum(range(1000000))\n\n# Compare multiple runs with timeit\n%timeit sum(range(1000000))\n\n# Execute shell commands\n!python --version\n!pip show numpy | grep Version\n\n# Demonstrate autoreload\n# %load_ext autoreload\n# %autoreload 2\n\nprint(f\"Code execution result: {result}\")"
        ]
      ]
    },
