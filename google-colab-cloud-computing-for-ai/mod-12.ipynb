          "python",
          "# Google Colab tips and tricks\n\n# Check GPU availability\nimport os\ngpu_available = os.path.exists('/dev/nvidia0') if os.name != 'nt' else False\nprint(f\"GPU available: {gpu_available}\")\n\n# System info\nimport sys\nimport platform\nprint(f\"Python: {sys.version.split()[0]}\")\nprint(f\"Platform: {platform.system()} {platform.machine()}\")\n\n# Memory check\nimport psutil\nram = psutil.virtual_memory()\nprint(f\"RAM: {ram.total / 1e9:.1f} GB (Available: {ram.available / 1e9:.1f} GB)\")\n\n# Colab-specific features demo\n# !pip install transformers  # Install packages\n# from google.colab import files  # Upload/download files\n# from google.colab import drive  # Mount Google Drive\n\n# Timing code execution\nimport time\nstart = time.time()\nresult = sum(range(1_000_000))\nelapsed = time.time() - start\nprint(f\"\\nComputation: {result:,} in {elapsed*1000:.1f}ms\")"
        ]
      ]
    }
