          "python",
          "from google.colab import drive\n\n# Mount Drive\ndrive.mount('/content/drive')\n\n# Verify mount\nimport os\nfiles = os.listdir('/content/drive/My Drive')\nprint(f\"Files in My Drive: {files}\")\n\n# Access specific files\nimport pandas as pd\ndata = pd.read_csv('/content/drive/My Drive/datasets/data.csv')\nprint(f\"Data shape: {data.shape}\")\n\n# Save results back to Drive\noutput_dir = '/content/drive/My Drive/results'\nos.makedirs(output_dir, exist_ok=True)\ndata.to_csv(f'{output_dir}/processed.csv', index=False)"
