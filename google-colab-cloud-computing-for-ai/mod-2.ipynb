          "python",
          "import os\n\n# Create checkpoint directory\ncheckpoint_dir = '/content/checkpoints'\nos.makedirs(checkpoint_dir, exist_ok=True)\n\n# Save model after each epoch\ndef save_checkpoint(model, epoch):\n    path = f'{checkpoint_dir}/model_epoch_{epoch}.pt'\n    torch.save(model.state_dict(), path)\n    \n    # Also save to Drive for persistence\n    !cp {checkpoint_dir}/* '/content/drive/My Drive/checkpoints/'\n\n# Or use a simpler approach: save directly to Drive\ndef save_to_drive(data, filename):\n    import pickle\n    drive_path = f'/content/drive/My Drive/{filename}'\n    with open(drive_path, 'wb') as f:\n        pickle.dump(data, f)\n    print(f\"Saved to {drive_path}\")"
        ]
