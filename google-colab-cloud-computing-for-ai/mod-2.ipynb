          "python",
          "import json\nimport os\n\n# Load secrets from local file (not committed to version control)\nif os.path.exists('/content/secrets.json'):\n    with open('/content/secrets.json') as f:\n        secrets = json.load(f)\n    api_key = secrets['openai_key']\nelse:\n    # Fallback or error\n    print(\"Secrets file not found\")"
