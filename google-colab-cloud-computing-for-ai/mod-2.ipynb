        [
          "python",
          "# Detect and display available compute resources\nimport sys\nimport torch\nimport tensorflow as tf\n\nprint(\"=== Compute Environment ===\")\nprint(f\"Python version: {sys.version}\")\n\n# CPU info\nprint(f\"\\nCPU cores: {torch.get_num_threads()}\")\n\n# GPU info\nprint(f\"\\nGPU Available (PyTorch): {torch.cuda.is_available()}\")\nif torch.cuda.is_available():\n    print(f\"GPU Name: {torch.cuda.get_device_name(0)}\")\n    props = torch.cuda.get_device_properties(0)\n    print(f\"GPU Memory: {props.total_memory / 1e9:.1f} GB\")\n    print(f\"GPU Compute Capability: {props.major}.{props.minor}\")\n\nprint(f\"\\nGPU Available (TensorFlow): {len(tf.config.list_physical_devices('GPU')) > 0}\")\nif tf.config.list_physical_devices('GPU'):\n    for gpu in tf.config.list_physical_devices('GPU'):\n        print(f\"TensorFlow GPU: {gpu}\")\n\n# TPU info\nprint(f\"\\nTPU Available: {len(tf.config.list_physical_devices('TPU')) > 0}\")\nif tf.config.list_physical_devices('TPU'):\n    print(\"TPU is available for this session\")"
        ]
      ]
    },
