          "python",
          "# Install using pip\npip install numpy pandas matplotlib seaborn scikit-learn\n\n# Or using conda (recommended for data science)\nconda install numpy pandas matplotlib seaborn scikit-learn\n\n# Verify installation\nimport numpy as np\nimport pandas as pd\n\nprint(f\"NumPy version: {np.__version__}\")      # Example: 1.24.3\nprint(f\"Pandas version: {pd.__version__}\")    # Example: 2.0.2\n\n# Standard imports for data science\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\n\n# Check NumPy array capabilities\narr = np.array([1, 2, 3, 4, 5])\nprint(arr.dtype)                               # int64\nprint(arr.shape)                               # (5,)\nprint(type(arr))                               # numpy.ndarray"
