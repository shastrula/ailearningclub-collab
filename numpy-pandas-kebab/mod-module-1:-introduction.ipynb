          "python",
          "import numpy as np\nimport pandas as pd\n\n# Typical workflow: Load data\ndf = pd.read_csv('data.csv')\n\n# Explore structure\nprint(df.head())                    # First 5 rows\nprint(df.info())                    # Data types, non-null counts\nprint(df.shape)                     # (rows, columns)\n\n# Descriptive statistics\nprint(df.describe())                # Mean, std, min, max, quartiles\n\n# Check for missing values\nprint(df.isnull().sum())            # Count missing per column\n\n# Basic filtering\nyoung = df[df['age'] < 30]\nhigh_salary = df[df['salary'] > 50000]\n\n# Column operations (vectorized)\ndf['age_in_years'] = df['birth_year'].apply(lambda x: 2024 - x)\ndf['category'] = df['value'].apply(lambda x: 'high' if x > 100 else 'low')\n\n# Access underlying NumPy arrays\narr = df['salary'].values              # NumPy array\narr = df[['age', 'salary']].values     # 2D NumPy array"
