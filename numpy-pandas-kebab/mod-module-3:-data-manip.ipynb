          "import pandas as pd\n\n# Create hierarchical data\narrays = [\n    ['A', 'A', 'B', 'B'],\n    ['X', 'Y', 'X', 'Y']\n]\nindex = pd.MultiIndex.from_arrays(arrays, names=['group', 'subgroup'])\ndf = pd.DataFrame({'value': [10, 20, 30, 40]}, index=index)\n\nprint(df)\n#           value\n# group subgroup\n# A     X        10\n#       Y        20\n# B     X        30\n#       Y        40\n\n# Unstack: move inner index level to columns\nunstacked = df.unstack()\nprint(unstacked)\n#      value\n# subgroup   X   Y\n# group\n# A         10  20\n# B         30  40\n\n# Stack: move columns to inner index level\nstacked = unstacked.stack()\nprint(stacked)\n#           value\n# group subgroup\n# A     X        10\n#       Y        20\n# B     X        30\n#       Y        40"
