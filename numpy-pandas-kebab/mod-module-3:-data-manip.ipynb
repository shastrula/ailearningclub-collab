        [
          "python",
          "import pandas as pd\n\n# Create datetime index\ndates = pd.date_range('2023-01-01', periods=10, freq='D')  # Daily\ndates = pd.date_range('2023-01-01', periods=12, freq='MS')  # Month start\n\n# Parse string to datetime\ndf = pd.DataFrame({\n    'date': ['2023-01-15', '2023-02-20', '2023-03-10'],\n    'value': [100, 120, 115]\n})\ndf['date'] = pd.to_datetime(df['date'])\nprint(df['date'].dtype)  # datetime64[ns]\n\n# Set datetime as index\ndf_ts = df.set_index('date')\n\n# Extract date components\ndf['year'] = df['date'].dt.year\ndf['month'] = df['date'].dt.month\ndf['day'] = df['date'].dt.day\ndf['day_of_week'] = df['date'].dt.day_name()\ndf['quarter'] = df['date'].dt.quarter\n\n# Time arithmetic\ndf['days_since_start'] = (df['date'] - df['date'].min()).dt.days\n\n# Resample (group by time period)\ndf_monthly = df_ts.resample('M').sum()  # Monthly sum\ndf_weekly = df_ts.resample('W').mean()  # Weekly average\n\n# Rolling window on time series\ndf['rolling_mean_7d'] = df['value'].rolling(window='7D').mean()\n\nprint(df)"
        ]
