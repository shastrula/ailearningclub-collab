      "source": [
        [
          "python",
          "import pandas as pd\nimport numpy as np\n\n# Create sample data\ndf = pd.DataFrame({\n    'date': pd.date_range('2023-01-01', periods=20),\n    'category': np.random.choice(['A', 'B', 'C'], 20),\n    'sales': np.random.randint(100, 500, 20),\n    'quantity': np.random.randint(1, 20, 20)\n})\n\n# Method chaining: readable and efficient\nresult = (df\n    .copy()\n    .assign(month=lambda x: x['date'].dt.month)\n    .assign(revenue_per_unit=lambda x: x['sales'] / x['quantity'])\n    .query('sales > 200')\n    .groupby(['month', 'category'])\n    .agg({\n        'sales': 'sum',\n        'quantity': 'sum',\n        'revenue_per_unit': 'mean'\n    })\n    .reset_index()\n    .sort_values('sales', ascending=False)\n)\n\nprint(result)\n\n# Breaking it down (same result, less readable)\ndf_copy = df.copy()\ndf_copy['month'] = df_copy['date'].dt.month\ndf_copy['revenue_per_unit'] = df_copy['sales'] / df_copy['quantity']\ndf_filtered = df_copy[df_copy['sales'] > 200]\ngrouped = df_filtered.groupby(['month', 'category'])\nresult2 = grouped.agg({'sales': 'sum', 'quantity': 'sum', 'revenue_per_unit': 'mean'})\nresult2 = result2.reset_index()\nresult2 = result2.sort_values('sales', ascending=False)"
        ]
      ]
    },
