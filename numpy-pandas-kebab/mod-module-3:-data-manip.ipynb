        [
          "python",
          "import pandas as pd\nimport numpy as np\n\n# Sample data in wide format (multiple columns per variable)\ndf_wide = pd.DataFrame({\n    'date': ['2023-01-01', '2023-01-02', '2023-01-03'],\n    'product_A': [100, 120, 110],\n    'product_B': [150, 140, 160],\n    'product_C': [200, 210, 190]\n})\n\n# Melt: convert wide to long format\ndf_long = df_wide.melt(id_vars='date', \n                       var_name='product', \n                       value_name='sales')\nprint(df_long)\n#         date product  sales\n# 0 2023-01-01 product_A    100\n# 1 2023-01-02 product_A    120\n# 2 2023-01-03 product_A    110\n# 3 2023-01-01 product_B    150\n# ...\n\n# Pivot: convert long to wide format\ndf_pivoted = df_long.pivot(index='date', \n                           columns='product', \n                           values='sales')\n\n# Stack/Unstack\ndf = pd.DataFrame({\n    'A': [1, 2],\n    'B': [3, 4]\n}, index=['x', 'y'])\n\nstacked = df.stack()        # Columns become rows\nunstacked = stacked.unstack()  # Rows become columns\n\n# Transpose (flip axes)\nprint(df.T)"
        ]
