          "python",
          "import pandas as pd\n\ndf = pd.DataFrame({\n    'product': ['A', 'B', 'A', 'C', 'B', 'A'],\n    'region': ['North', 'South', 'East', 'North', 'West', 'South'],\n    'sales': [100, 150, 120, 200, 180, 110]\n})\n\n# Convert to categorical\ndf['product'] = df['product'].astype('category')\ndf['region'] = df['region'].astype('category')\n\n# Define ordered categories\ndf['quality'] = pd.Categorical(\n    ['low', 'high', 'medium', 'high', 'medium', 'low'],\n    categories=['low', 'medium', 'high'],\n    ordered=True\n)\n\n# Categorical operations\nprint(df['product'].cat.categories)    # Available categories\nprint(df['product'].cat.codes)         # Numeric codes (0, 1, 2...)\nprint(df['region'].value_counts())     # Counts per category\n\n# Rename categories\ndf['product'] = df['product'].cat.rename_categories(\n    {'A': 'Product_A', 'B': 'Product_B', 'C': 'Product_C'}\n)\n\n# Add/remove categories\ndf['product'] = df['product'].cat.add_categories(['D', 'E'])\ndf['product'] = df['product'].cat.remove_categories(['D', 'E'])\n\nprint(df)"
        ]
      ]
