        [
          "python",
          "import pandas as pd\n\ndf = pd.DataFrame({\n    'name': ['Alice', 'Bob', 'Charlie'],\n    'age': [25, 30, 35],\n    'salary': [50000, 60000, 75000]\n})\n\n# Using assign for clean transformations\ndf_transformed = (df\n    .assign(\n        age_group=lambda x: x['age'].apply(\n            lambda age: 'Young' if age < 30 else 'Senior'\n        ),\n        salary_category=lambda x: x['salary'].apply(\n            lambda sal: 'Low' if sal < 55000 else 'High'\n        ),\n        years_to_retirement=lambda x: 65 - x['age'],\n        bonus=lambda x: x['salary'] * 0.1\n    )\n    .drop('age', axis=1)  # Remove old column if needed\n)\n\nprint(df_transformed)\n\n# Custom aggregation function with apply\ndef summary_stats(group):\n    return pd.Series({\n        'count': len(group),\n        'mean': group['salary'].mean(),\n        'max': group['salary'].max(),\n        'min': group['salary'].min(),\n        'std': group['salary'].std()\n    })\n\nresult = df.groupby('age_group').apply(summary_stats)\nprint(result)"
        ]
      ]
