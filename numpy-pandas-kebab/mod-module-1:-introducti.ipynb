        [
          "python",
          "# Install via pip (recommended for virtual environments)\npip install numpy pandas\n\n# Or via conda (recommended for data science)\nconda install numpy pandas\n\n# Verify installation\nimport numpy as np\nimport pandas as pd\n\nprint(f\"NumPy version: {np.__version__}\")\nprint(f\"Pandas version: {pd.__version__}\")\n\n# Standard imports for data science work\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.model_selection import train_test_split"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Create arrays\narr = np.array([1, 2, 3, 4, 5])\nprint(arr)\nprint(arr.dtype)      # int64\nprint(arr.shape)      # (5,)\n\n# 2D array\narr2d = np.array([[1, 2, 3], [4, 5, 6]])\nprint(arr2d.shape)    # (2, 3)\n\n# Arrays of zeros and ones\nzeros = np.zeros((3, 3))\nones = np.ones((2, 4))\n\n# Arithmetic (vectorized, very fast)\nresult = arr * 2\nprint(result)         # [2 4 6 8 10]\n\n# Statistical operations\nprint(arr.mean())     # 3.0\nprint(arr.sum())      # 15\nprint(arr.std())      # 1.414...\n\n# Indexing\nprint(arr[2])         # 3\nprint(arr[1:4])       # [2 3 4]\n\n# Boolean indexing\nmask = arr > 3\nprint(mask)           # [False False False True True]\nprint(arr[mask])      # [4 5]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import pandas as pd\nimport numpy as np\n\n# Series (1D labeled data)\ns = pd.Series([10, 20, 30, 40], index=['a', 'b', 'c', 'd'])\nprint(s)\nprint(s['b'])         # 20\n\n# DataFrame (2D labeled data)\ndf = pd.DataFrame({\n    'name': ['Alice', 'Bob', 'Charlie'],\n    'age': [25, 30, 35],\n    'salary': [50000, 60000, 75000]\n})\nprint(df)\nprint(df.shape)       # (3, 3)\nprint(df['name'])     # Access column as Series\nprint(df.loc[0])      # Access row by label\n\n# Read CSV\ndf = pd.read_csv('data.csv')\nprint(df.head())      # First 5 rows\n\n# Basic statistics\nprint(df.describe())  # Count, mean, std, min, max, quartiles\n\n# Filtering\nprint(df[df['age'] > 28])\n\n# Grouping\nprint(df.groupby('department')['salary'].mean())\n\n# Sorting\nprint(df.sort_values('salary', ascending=False))"
        ]
      ]
    },
    {
