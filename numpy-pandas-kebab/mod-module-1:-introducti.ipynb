        [
          "python",
          "import numpy as np\nimport pandas as pd\nimport time\n\n# Performance comparison\nn = 1000000\n\n# Python list\npy_list = list(range(n))\nstart = time.time()\npy_result = [x * 2 for x in py_list]\npy_time = time.time() - start\n\n# NumPy array\nnp_arr = np.arange(n)\nstart = time.time()\nnp_result = np_arr * 2\nnp_time = time.time() - start\n\n# Pandas Series\npd_series = pd.Series(np.arange(n))\nstart = time.time()\npd_result = pd_series * 2\npd_time = time.time() - start\n\nprint(f\"Python list:  {py_time:.4f} seconds\")\nprint(f\"NumPy array:  {np_time:.4f} seconds ({py_time/np_time:.0f}x faster)\")\nprint(f\"Pandas Series: {pd_time:.4f} seconds ({py_time/pd_time:.0f}x faster)\")\n\n# Type differences\nprint(type(py_list))      # <class 'list'>\nprint(type(np_arr))       # <class 'numpy.ndarray'>\nprint(type(pd_series))    # <class 'pandas.core.series.Series'>\n\n# Homogeneity\npy_mixed = [1, 'string', 3.14, True]  # Allowed, but inefficient\nnp_mixed = np.array([1, 'string', 3.14, True])  # Converted to dtype 'object'\n# Both lose performance benefits"
        ]
      ]
