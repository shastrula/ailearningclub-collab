          "python",
          "import pandas as pd\nimport numpy as np\n\n# Workflow 1: Load, explore, filter\ndf = pd.read_csv('customers.csv')\nprint(df.info())                    # Data types, non-null counts\nprint(df.describe())                # Statistics\nprint(df[df['age'] > 30])           # Filter\n\n# Workflow 2: Transform and create new columns\ndf['age_group'] = df['age'].apply(lambda x: 'Young' if x < 30 else 'Senior')\ndf['revenue_per_visit'] = df['total_spend'] / df['visits']\n\n# Workflow 3: Group and aggregate\nsummary = df.groupby('age_group').agg({\n    'total_spend': 'sum',\n    'visits': 'mean',\n    'revenue_per_visit': 'mean'\n})\n\n# Workflow 4: Clean and handle missing data\ndf['email'].fillna('unknown@example.com', inplace=True)\ndf.dropna(subset=['phone'], inplace=True)\n\n# Workflow 5: Prepare for machine learning\nfrom sklearn.preprocessing import StandardScaler\nscaler = StandardScaler()\ndf[['age_scaled', 'spend_scaled']] = scaler.fit_transform(df[['age', 'total_spend']])"
