          "python",
          "import matplotlib.pyplot as plt\nimport numpy as np\n\n# Basic line plot\nx = np.linspace(0, 10, 100)\ny = np.sin(x)\n\nplt.figure(figsize=(10, 6))\nplt.plot(x, y, label='sin(x)', linewidth=2, color='blue')\nplt.xlabel('X axis')\nplt.ylabel('Y axis')\nplt.title('Simple Line Plot')\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.show()\n\n# Multiple plots\nfig, axes = plt.subplots(2, 2, figsize=(12, 10))\n\naxes[0, 0].plot(x, np.sin(x), 'b-', label='sin')\naxes[0, 0].set_title('Sine')\naxes[0, 0].legend()\n\naxes[0, 1].plot(x, np.cos(x), 'r-', label='cos')\naxes[0, 1].set_title('Cosine')\n\naxes[1, 0].plot(x, np.tan(x), 'g-', label='tan')\naxes[1, 0].set_ylim(-5, 5)  # Limit y-axis\naxes[1, 0].set_title('Tangent')\n\naxes[1, 1].scatter(x, np.sin(x) + np.random.normal(0, 0.1, len(x)), s=20)\naxes[1, 1].set_title('Scatter')\n\nplt.tight_layout()\nplt.show()\n\n# Common plot types\ndata = [10, 20, 15, 30, 25]\n\n# Histogram\nplt.hist(data, bins=5, edgecolor='black')\nplt.title('Histogram')\nplt.show()\n\n# Bar chart\ncategories = ['A', 'B', 'C', 'D', 'E']\nplt.bar(categories, data, color='steelblue')\nplt.title('Bar Chart')\nplt.show()\n\n# Scatter plot\nplt.scatter(x, y, s=50, alpha=0.6, c=x, cmap='viridis')\nplt.colorbar(label='X values')\nplt.show()"
