          "python",
          "import pandas as pd\nimport matplotlib.pyplot as plt\n\n# 1. Continuous vs Continuous: Scatter or line plot\ndf = pd.DataFrame({\n    'age': [20, 25, 30, 35, 40, 45, 50],\n    'salary': [30000, 35000, 50000, 60000, 70000, 80000, 90000]\n})\nplt.scatter(df['age'], df['salary'])\nplt.xlabel('Age')\nplt.ylabel('Salary')\nplt.title('Age vs Salary')\nplt.show()\n\n# 2. Time Series: Line plot\ntime_series = pd.Series(\n    [100, 105, 102, 110, 108, 115, 120],\n    index=pd.date_range('2023-01-01', periods=7)\n)\ntime_series.plot(figsize=(10, 6))\nplt.title('Stock Price Over Time')\nplt.show()\n\n# 3. Categorical Distribution: Bar chart or histogram\ncategories = ['A', 'B', 'C', 'D', 'E']\nvalues = [15, 30, 20, 35, 25]\nplt.bar(categories, values)\nplt.title('Sales by Category')\nplt.show()\n\n# 4. Multiple Distributions: Box plot or violin plot\nimport numpy as np\ndata = [np.random.normal(0, 1, 100),\n        np.random.normal(2, 1.5, 100),\n        np.random.normal(-1, 1, 100)]\nplt.boxplot(data, labels=['Group1', 'Group2', 'Group3'])\nplt.show()\n\n# 5. Composition: Pie chart or stacked bar\nsizes = [30, 25, 25, 20]\nlabels = ['Category A', 'Category B', 'Category C', 'Category D']\nplt.pie(sizes, labels=labels, autopct='%1.1f%%')\nplt.title('Market Share')\nplt.show()\n\n# 6. Correlations: Heatmap\nimport seaborn as sns\ncorr_matrix = pd.DataFrame({\n    'A': [1, 0.8, 0.3],\n    'B': [0.8, 1, 0.5],\n    'C': [0.3, 0.5, 1]\n}, index=['A', 'B', 'C'])\nsns.heatmap(corr_matrix, annot=True, cmap='coolwarm')\nplt.show()"
