          "python",
          "import matplotlib.pyplot as plt\nimport numpy as np\n\nx = np.linspace(0, 10, 100)\ny1 = np.sin(x)\ny2 = np.cos(x)\n\nfig, ax = plt.subplots(figsize=(12, 7))\n\n# Plot data\nax.plot(x, y1, label='sin(x)', linewidth=2.5, color='#1f77b4')\nax.plot(x, y2, label='cos(x)', linewidth=2.5, color='#ff7f0e')\n\n# Customize axes\nax.set_xlabel('X axis', fontsize=12, fontweight='bold')\nax.set_ylabel('Y axis', fontsize=12, fontweight='bold')\nax.set_title('Trigonometric Functions', fontsize=14, fontweight='bold', pad=20)\n\n# Grid and spine customization\nax.grid(True, alpha=0.3, linestyle='--')\nax.spines['top'].set_visible(False)\nax.spines['right'].set_visible(False)\n\n# Legend\nax.legend(loc='upper right', fontsize=11, framealpha=0.9)\n\n# Tick customization\nax.tick_params(labelsize=10)\nax.set_xlim(0, 10)\nax.set_ylim(-1.5, 1.5)\n\n# Add annotations\nax.annotate('Peak', xy=(np.pi/2, 1), xytext=(2, 1.3),\n            arrowprops=dict(arrowstyle='->', color='red'),\n            fontsize=11, color='red')\n\nplt.tight_layout()\nplt.savefig('figure.png', dpi=300, bbox_inches='tight')\nplt.show()"
        ]
      ]
