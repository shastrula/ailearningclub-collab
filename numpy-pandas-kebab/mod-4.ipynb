          "python",
          "import seaborn as sns\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Set style\nsns.set_style(\"whitegrid\")\nsns.set_palette(\"husl\")\n\n# Sample data\ntips = pd.DataFrame({\n    'total_bill': np.random.uniform(10, 50, 100),\n    'tip': np.random.uniform(1, 10, 100),\n    'sex': np.random.choice(['Male', 'Female'], 100),\n    'day': np.random.choice(['Fri', 'Sat', 'Sun'], 100)\n})\n\n# Histogram with KDE\nsns.histplot(tips['total_bill'], kde=True, bins=20)\nplt.show()\n\n# Scatter plot with regression line\nsns.regplot(x='total_bill', y='tip', data=tips, scatter_kws={'s': 50, 'alpha': 0.6})\nplt.show()\n\n# Distribution plot (KDE)\nsns.kdeplot(data=tips, x='total_bill', y='tip', fill=True)\nplt.show()\n\n# Box plot by category\nsns.boxplot(x='day', y='total_bill', data=tips, hue='sex')\nplt.show()\n\n# Violin plot (distribution + box plot)\nsns.violinplot(x='day', y='total_bill', data=tips, hue='sex')\nplt.show()\n\n# Heatmap (correlation matrix)\ncorr = tips[['total_bill', 'tip']].corr()\nsns.heatmap(corr, annot=True, cmap='coolwarm', center=0)\nplt.show()\n\n# Pair plot (scatter matrix)\nsns.pairplot(tips[['total_bill', 'tip', 'sex']], hue='sex', diag_kind='kde')\nplt.show()\n\n# Count plot (bar chart of categorical)\nsns.countplot(data=tips, x='day', hue='sex')\nplt.show()"
        ]
      ]
    },
