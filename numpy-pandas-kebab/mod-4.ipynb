        [
          "python",
          "import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Create sample data\ndf = pd.DataFrame({\n    'date': pd.date_range('2023-01-01', periods=30),\n    'product_a': np.random.randn(30).cumsum() + 100,\n    'product_b': np.random.randn(30).cumsum() + 100,\n    'product_c': np.random.randn(30).cumsum() + 100\n})\n\n# Line plot (default)\ndf.set_index('date')[['product_a', 'product_b', 'product_c']].plot(figsize=(12, 6))\nplt.title('Product Sales Over Time')\nplt.ylabel('Sales ($)')\nplt.show()\n\n# Area plot\ndf.set_index('date')[['product_a', 'product_b', 'product_c']].plot(kind='area', stacked=True)\nplt.show()\n\n# Bar plot\ndf[['product_a', 'product_b', 'product_c']].head(10).plot(kind='bar', figsize=(12, 6))\nplt.show()\n\n# Box plot (shows distribution)\ndf[['product_a', 'product_b', 'product_c']].plot(kind='box')\nplt.show()\n\n# Histogram\ndf['product_a'].plot(kind='hist', bins=20, edgecolor='black')\nplt.show()\n\n# Scatter plot\ndf.plot(x='product_a', y='product_b', kind='scatter', s=50, alpha=0.6)\nplt.show()"
        ]
      ]
