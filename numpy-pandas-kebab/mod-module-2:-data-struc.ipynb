          "python",
          "import pandas as pd\nimport numpy as np\n\n# RangeIndex (default)\ndf1 = pd.DataFrame(np.random.randn(3, 3))\nprint(df1.index)  # RangeIndex(start=0, stop=3, step=1)\n\n# String Index\ndf2 = pd.DataFrame(\n    np.random.randn(3, 3),\n    index=['row1', 'row2', 'row3']\n)\n\n# DatetimeIndex (for time series)\ndf3 = pd.DataFrame(\n    np.random.randn(5, 1),\n    index=pd.date_range('2023-01-01', periods=5),\n    columns=['value']\n)\nprint(df3.index)  # DatetimeIndex\n\n# Set a column as index\ndf = pd.DataFrame({\n    'emp_id': [1, 2, 3],\n    'name': ['Alice', 'Bob', 'Charlie'],\n    'salary': [50000, 60000, 75000]\n})\ndf_indexed = df.set_index('emp_id')\nprint(df_indexed.index)  # Index([1, 2, 3], name='emp_id')\n\n# Reset index\ndf_reset = df_indexed.reset_index()"
