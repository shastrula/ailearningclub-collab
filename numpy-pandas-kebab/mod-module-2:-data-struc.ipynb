          "python",
          "import pandas as pd\nimport numpy as np\n\n# Numeric dtypes\nint8, int16, int32, int64           # Integers (-128 to 127, etc.)\nuint8, uint16, uint32, uint64       # Unsigned integers (0 to 255, etc.)\nfloat32, float64                     # Floating point\ncomplex64, complex128                # Complex numbers\nbool_                                # Boolean\n\n# String and categorical\nobject                               # Python object (slow, use for strings)\nstring                               # Pandas native string (newer, preferred)\ncategory                             # Categorical (memory efficient)\n\n# Time-related\ndatetime64                           # Date and time\ntimedelta64                          # Duration\n\n# Create with specific dtypes\ndf = pd.DataFrame({\n    'age': pd.array([25, 30, 35], dtype='int32'),\n    'salary': pd.array([50000.0, 60000.0, 75000.0], dtype='float32'),\n    'category': pd.Categorical(['A', 'B', 'A']),\n    'hired': pd.to_datetime(['2020-01-15', '2019-03-22', '2021-06-10'])\n})\n\nprint(df.dtypes)"
        ]
