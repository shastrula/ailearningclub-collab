          "python",
          "import pandas as pd\n\n# Create from dictionary of lists\ndata = {\n    'name': ['Alice', 'Bob', 'Charlie'],\n    'age': [25, 30, 35],\n    'salary': [50000, 60000, 75000]\n}\ndf = pd.DataFrame(data)\n\n# Create from list of dictionaries\ndata2 = [\n    {'id': 1, 'product': 'A', 'price': 10},\n    {'id': 2, 'product': 'B', 'price': 15}\n]\ndf2 = pd.DataFrame(data2)\n\n# DataFrame attributes\nprint(df.shape)               # (3, 3)\nprint(df.columns)             # Index(['name', 'age', 'salary'])\nprint(df.index)               # RangeIndex(start=0, stop=3)\nprint(df.dtypes)              # Data type of each column\nprint(df.values)              # NumPy array representation\n\n# Access columns\nprint(df['name'])             # Series\nprint(df[['name', 'age']])    # DataFrame\n\n# Access rows\nprint(df.loc[1])              # Row by label\nprint(df.iloc[1])             # Row by position\nprint(df.loc[1:2])            # Rows by label range (inclusive)\nprint(df.iloc[1:3])           # Rows by position (exclusive end)\n\n# Access cells\nprint(df.loc[1, 'salary'])    # 60000\nprint(df.iloc[1, 2])          # 60000"
