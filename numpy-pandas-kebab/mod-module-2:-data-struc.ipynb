      "source": [
        [
          "python",
          "import numpy as np\n\n# Create an array and inspect its attributes\narr = np.array([[1, 2, 3], [4, 5, 6]], dtype=np.int32)\n\nprint(f\"Shape: {arr.shape}\")                 # (2, 3)\nprint(f\"Dtype: {arr.dtype}\")                 # int32\nprint(f\"Strides: {arr.strides}\")             # (12, 4) - bytes to move\nprint(f\"Itemsize: {arr.itemsize}\")           # 4 - bytes per element\nprint(f\"Nbytes: {arr.nbytes}\")               # 24 - total bytes\nprint(f\"Ndim: {arr.ndim}\")                   # 2 - number of dimensions\nprint(f\"Size: {arr.size}\")                   # 6 - total elements\nprint(f\"Flags:\\n{arr.flags}\")                # Memory layout info\n\n# Memory layout matters\narr_c = np.array([[1, 2, 3], [4, 5, 6]], order='C')  # Row-major (C)\narr_f = np.array([[1, 2, 3], [4, 5, 6]], order='F')  # Column-major (Fortran)\n\nprint(f\"C strides: {arr_c.strides}\")         # (12, 4) - move 12 bytes for row\nprint(f\"F strides: {arr_f.strides}\")         # (4, 8) - move 4 bytes for column"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import pandas as pd\n\n# Create Series from list\ns1 = pd.Series([10, 20, 30, 40])\nprint(s1)\n# 0    10\n# 1    20\n# 2    30\n# 3    40\n\n# Create with custom index\ns2 = pd.Series([10, 20, 30, 40], index=['a', 'b', 'c', 'd'])\nprint(s2)\n# a    10\n# b    20\n# c    30\n# d    40\n\n# Create from dictionary\ns3 = pd.Series({'x': 100, 'y': 200, 'z': 300})\n\n# Series attributes\nprint(s2.index)       # Index(['a', 'b', 'c', 'd'])\nprint(s2.values)      # [10 20 30 40] - NumPy array\nprint(s2.dtype)       # int64\nprint(s2.name)        # None (can be set)\n\n# Access elements\nprint(s2['b'])        # 20 - label-based\nprint(s2.iloc[1])     # 20 - position-based\nprint(s2.loc['b'])    # 20 - explicit label\n\n# Vectorized operations\nprint(s2 * 2)\nprint(s2 + 100)\nprint(s2 > 25)"
        ]
      ]
    },
    {
