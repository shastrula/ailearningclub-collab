          "python",
          "import numpy as np\nimport pandas as pd\n\n# NumPy dtypes\narr_int32 = np.array([1, 2, 3], dtype=np.int32)\narr_int64 = np.array([1, 2, 3], dtype=np.int64)\narr_float32 = np.array([1.0, 2.0, 3.0], dtype=np.float32)\narr_float64 = np.array([1.0, 2.0, 3.0], dtype=np.float64)\n\nprint(arr_int32.nbytes)     # 12 (3 elements \u00d7 4 bytes)\nprint(arr_int64.nbytes)     # 24 (3 elements \u00d7 8 bytes)\nprint(arr_float32.nbytes)   # 12\nprint(arr_float64.nbytes)   # 24\n\n# Pandas dtype optimization\ndf = pd.DataFrame({\n    'id': [1, 2, 3, 4, 5],\n    'category': ['A', 'B', 'A', 'C', 'B'],\n    'value': [10.5, 20.3, 15.7, 25.1, 30.9]\n})\n\nprint(df.memory_usage(deep=True))\n# Index      80\n# id        40\n# category  200 (object dtype - inefficient)\n# value     40\n# dtype: int64\n\n# Optimize with category dtype\ndf['category'] = df['category'].astype('category')\nprint(df.memory_usage(deep=True))\n# Index      80\n# id        40\n# category  45 (much smaller!)\n# value     40\n\n# Convert to smaller numeric types\ndf['id'] = df['id'].astype('int32')\ndf['value'] = df['value'].astype('float32')"
        ]
