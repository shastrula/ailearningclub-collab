          "python",
          "import pandas as pd\n\n# Create DataFrame with MultiIndex\narrays = [\n    ['A', 'A', 'B', 'B'],\n    ['one', 'two', 'one', 'two']\n]\ntuples = list(zip(*arrays))\nindex = pd.MultiIndex.from_tuples(tuples, names=['first', 'second'])\n\ndf = pd.DataFrame(\n    {'value': [10, 20, 30, 40]},\n    index=index\n)\nprint(df)\n#        value\n# first second\n# A     one       10\n#       two       20\n# B     one       30\n#       two       40\n\n# Access via MultiIndex\nprint(df.loc['A'])        # All rows where first='A'\nprint(df.loc['A', 'one']) # Specific row (10)\n\n# Stack/unstack to convert between levels\nstacked = df.unstack()\nprint(stacked)\n#        value\n# second   one  two\n# first\n# A         10   20\n# B         30   40"
        ]
