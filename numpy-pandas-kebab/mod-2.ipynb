        [
          "python",
          "import pandas as pd\n\n# Create a Series from a list\ns1 = pd.Series([10, 20, 30, 40])\nprint(s1)\n# 0    10\n# 1    20\n# 2    30\n# 3    40\n\n# Create a Series with custom index\ns2 = pd.Series([10, 20, 30, 40], index=['a', 'b', 'c', 'd'])\nprint(s2)\n# a    10\n# b    20\n# c    30\n# d    40\n\n# Create from a dictionary\ns3 = pd.Series({'name': 'Alice', 'age': 30, 'city': 'NYC'})\nprint(s3)\n\n# Access values\nprint(s2['b'])     # 20\nprint(s2.loc['b']) # 20 (label-based)\nprint(s2.iloc[1])  # 20 (position-based)\n\n# Operations on Series\nprint(s1 * 2)      # Vectorized operation\nprint(s1.mean())   # 25.0\nprint(s1.sum())    # 100"
        ]
      ]
    },
    {
      "cell_type": "code",
