        [
          "python",
          "import pandas as pd\n\ndf = pd.DataFrame({\n    'name': ['Alice', 'Bob', 'Charlie', 'Diana'],\n    'age': [25, 30, 35, 28],\n    'salary': [50000, 60000, 75000, 55000]\n})\n\n# Single condition\nprint(df[df['age'] > 28])\n#       name  age  salary\n# 1      Bob   30   60000\n# 2  Charlie   35   75000\n\n# Multiple conditions (use &, |, ~)\nprint(df[(df['age'] > 25) & (df['salary'] > 55000)])\n# Output: Rows where age > 25 AND salary > 55000\n\nprint(df[(df['age'] < 30) | (df['salary'] > 70000)])\n# Output: Rows where age < 30 OR salary > 70000\n\nprint(df[~(df['age'] > 30)])\n# Output: Rows where age <= 30\n\n# Filter by multiple values\nprint(df[df['name'].isin(['Alice', 'Bob'])])\n# Output: Only Alice and Bob rows"
        ]
      ]
