          "python",
          "import pandas as pd\n\ndf = pd.DataFrame({\n    'name': ['Alice', 'Bob', 'Charlie'],\n    'age': [25, 30, 35],\n    'salary': [50000, 60000, 75000]\n}, index=['emp1', 'emp2', 'emp3'])\n\n# loc: label-based selection\nprint(df.loc['emp1'])           # Row by label\nprint(df.loc['emp1', 'name'])   # Specific cell\nprint(df.loc['emp1':'emp2'])    # Rows (inclusive on both ends!)\nprint(df.loc[:, 'name':'age'])  # Columns by label range\n\n# iloc: integer position-based selection\nprint(df.iloc[0])               # First row\nprint(df.iloc[0, 0])            # First cell\nprint(df.iloc[0:2])             # First two rows (exclusive end)\nprint(df.iloc[:, [0, 2]])       # Columns 0 and 2\n\n# Column access (multiple ways)\nprint(df['name'])               # Series\nprint(df[['name', 'age']])      # DataFrame\nprint(df.name)                  # Attribute access (if valid identifier)"
        ]
      ]
