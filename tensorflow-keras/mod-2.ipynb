      "source": [
        "# Tensorflow Keras - mod-2\n\n",
        "**Course:** tensorflow-keras\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Using pip (recommended)\npip install tensorflow\n\n# Using conda\nconda install -c conda-forge tensorflow\n\n# Specific version\npip install tensorflow==2.14.0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Step 1: Verify NVIDIA drivers\nnvidia-smi\n\n# Output should show CUDA version and GPU details\n# If this fails, install drivers from nvidia.com\n\n# Step 2: Install CUDA and cuDNN\n# For TensorFlow 2.14:\n# - CUDA 12.3\n# - cuDNN 8.9.x\n\n# macOS with Metal GPU (Apple Silicon):\npip install tensorflow-macos\n\n# For Linux/Windows with NVIDIA GPU:\npip install tensorflow[and-cuda]\n\n# Or explicit installation with specific CUDA version\npip install tensorflow==2.14.0\n# Then install CUDA 12.3 and cuDNN 8.9 separately from NVIDIA"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create isolated Python environments\npython3.10 -m venv tf_env\nsource tf_env/bin/activate  # macOS/Linux\n# or: tf_env\\Scripts\\activate  # Windows\n\n# Install specific version\npip install tensorflow==2.14.0\n\n# Create requirements.txt for reproducibility\npip freeze > requirements.txt\n\n# Later, recreate environment\npip install -r requirements.txt"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Using conda for version isolation\nconda create -n tf-gpu python=3.11\nconda activate tf-gpu\nconda install -c conda-forge tensorflow cuda-version=12.3\n\n# Deactivate when switching projects\nconda deactivate"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import tensorflow as tf\n\n# List available GPUs\ngpus = tf.config.list_physical_devices('GPU')\nprint(f\"GPUs available: {len(gpus)}\")\nfor gpu in gpus:\n    print(f\"  - {gpu}\")\n\n# Check if GPU is actually used\nprint(f\"GPU available: {tf.test.is_built_with_cuda()}\")\n\n# List all devices\ndevices = tf.config.list_logical_devices()\nfor device in devices:\n    print(device)\n\n# Test GPU computation\nif gpus:\n    try:\n        # Try GPU-intensive operation\n        with tf.device('/GPU:0'):\n            a = tf.constant([[1.0, 2.0], [3.0, 4.0]])\n            b = tf.constant([[1.0, 2.0], [3.0, 4.0]])\n            c = tf.matmul(a, b)\n        print(\"GPU computation successful\")\n    except RuntimeError as e:\n        print(f\"GPU error: {e}\")\nelse:\n    print(\"No GPUs detected\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Uninstall and reinstall with compatible versions\npip uninstall tensorflow\npip install tensorflow==2.14.0\n# Then verify CUDA 12.3 and cuDNN 8.9 are properly installed"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "CUDA_PATH=C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.3"
