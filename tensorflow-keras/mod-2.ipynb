    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Force GPU usage and monitor\nwith tf.device('/GPU:0'):\n    # Large matrix multiplication to ensure GPU is utilized\n    a = tf.random.normal((10000, 10000))\n    b = tf.random.normal((10000, 10000))\n    c = tf.matmul(a, b)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Reduce batch size\nbatch_size = 16  # Instead of 64\n\n# Use mixed precision training to reduce memory\nfrom tensorflow.keras.mixed_precision import set_global_policy\nset_global_policy('mixed_float16')\n\n# Or use gradient checkpointing for large models\nfrom tensorflow.python.keras.optimizers.schedules import ExponentialDecay"
        ]
      ]
    },
    {
      "cell_type": "code",
