      "source": [
        [
          "bash",
          "# Build image\ndocker build -t my-tf-project:latest .\n\n# Run container with GPU support\ndocker run --gpus all -it -v $(pwd):/workspace my-tf-project:latest train.py\n\n# Or interactive shell\ndocker run --gpus all -it my-tf-project:latest bash"
        ]
      ]
