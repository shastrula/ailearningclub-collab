        [
          "dockerfile",
          "FROM tensorflow/tensorflow:2.14.0-gpu\n\nWORKDIR /workspace\n\n# Install additional packages\nRUN pip install numpy pandas scikit-learn matplotlib\n\nCOPY . /workspace\n\n# Set entry point\nENTRYPOINT [\"python\"]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
