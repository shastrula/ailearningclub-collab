          "python",
          "import tensorflow as tf\n\n# Create various tensors\nscalar = tf.constant(5)\nvector = tf.constant([1, 2, 3, 4])\nmatrix = tf.constant([[1, 2], [3, 4], [5, 6]])\nimage_batch = tf.random.normal(shape=(32, 28, 28, 3))  # 32 images, 28x28 pixels, RGB\n\nprint(f\"Scalar shape: {scalar.shape}, rank: {len(scalar.shape)}\")\nprint(f\"Vector shape: {vector.shape}, rank: {len(vector.shape)}\")\nprint(f\"Matrix shape: {matrix.shape}, rank: {len(matrix.shape)}\")\nprint(f\"Image batch shape: {image_batch.shape}, rank: {len(image_batch.shape)}\")\n\n# Tensor operations\nresult = tf.reduce_sum(vector)  # Sum all elements\nprint(f\"Sum of vector: {result.numpy()}\")"
        ]
      ]
