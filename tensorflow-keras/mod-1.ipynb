          "python",
          "import tensorflow as tf\n\n# Eager execution evaluates immediately\nx = tf.constant(3.0)\ny = tf.constant(4.0)\nz = x * y + x\n\nprint(z.numpy())  # Output: 13.0\n\n# You can use standard Python control flow\nfor i in range(3):\n    x = x + 1\n    print(x.numpy())\n\n# Debugging is simple\ndef my_function(x):\n    print(f\"Received x: {x}\")\n    return x * 2\n\nresult = my_function(5.0)"
