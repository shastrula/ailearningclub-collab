          "python",
          "import joblib\nimport pickle\nfrom datetime import datetime\n\n# Assume best_rf is your trained Random Forest model from the previous project\n# Also save the scaler used during training\n\nmodel_metadata = {\n    'model_type': 'RandomForestClassifier',\n    'version': '1.0',\n    'timestamp': datetime.now().isoformat(),\n    'training_auc': 0.8542,\n    'features': list(X_train.columns),\n    'scaler_type': 'StandardScaler'\n}\n\n# Save model and scaler\njoblib.dump(best_rf, 'models/churn_model_v1.pkl')\njoblib.dump(scaler, 'models/scaler_v1.pkl')\njoblib.dump(model_metadata, 'models/metadata_v1.pkl')\n\nprint(f\"Model saved: models/churn_model_v1.pkl\")\nprint(f\"Metadata: {model_metadata}\")\n\n# Load and verify\nloaded_model = joblib.load('models/churn_model_v1.pkl')\ntest_prediction = loaded_model.predict_proba(X_test[:5])\nprint(f\"Test predictions shape: {test_prediction.shape}\")"
        ]
      ]
