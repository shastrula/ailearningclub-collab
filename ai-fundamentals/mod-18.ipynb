          "html",
          "<!DOCTYPE html>\n<html>\n<head>\n    <title>Churn Prediction</title>\n    <style>\n        body { font-family: Arial; max-width: 600px; margin: 50px auto; }\n        input { padding: 8px; margin: 5px; width: 200px; }\n        button { padding: 10px 20px; background: #007bff; color: white; border: none; cursor: pointer; }\n        .result { margin-top: 20px; padding: 15px; border: 1px solid #ddd; }\n        .high-risk { background: #ffe6e6; }\n        .low-risk { background: #e6ffe6; }\n    </style>\n</head>\n<body>\n    <h1>Customer Churn Predictor</h1>\n    <form id=\"predictionForm\">\n        <input type=\"number\" id=\"contractLength\" placeholder=\"Contract length (months)\" step=\"1\" required>\n        <input type=\"number\" id=\"monthlyCharge\" placeholder=\"Monthly charge ($)\" step=\"0.01\" required>\n        <input type=\"number\" id=\"totalCharges\" placeholder=\"Total charges ($)\" step=\"0.01\" required>\n        <input type=\"number\" id=\"monthsService\" placeholder=\"Months as customer\" step=\"1\" required>\n        <label>\n            <input type=\"checkbox\" id=\"fiberInternet\"> Fiber Internet\n        </label>\n        <label>\n            <input type=\"checkbox\" id=\"oneYearContract\"> One-year contract\n        </label>\n        <button type=\"submit\">Predict Churn</button>\n    </form>\n    \n    <div id=\"result\"></div>\n    \n    <script>\n        document.getElementById('predictionForm').addEventListener('submit', async (e) => {\n            e.preventDefault();\n            \n            const payload = {\n                contract_length: parseFloat(document.getElementById('contractLength').value),\n                monthly_charge: parseFloat(document.getElementById('monthlyCharge').value),\n                total_charges: parseFloat(document.getElementById('totalCharges').value),\n                months_service: parseFloat(document.getElementById('monthsService').value),\n                internet_service_fiber: document.getElementById('fiberInternet').checked ? 1 : 0,\n                contract_type_one_year: document.getElementById('oneYearContract').checked ? 1 : 0\n            };\n            \n            try {\n                const response = await fetch('http://localhost:8000/predict', {\n                    method: 'POST',\n                    headers: { 'Content-Type': 'application/json' },\n                    body: JSON.stringify(payload)\n                });\n                \n                const result = await response.json();\n                const churnProb = (result.churn_probability * 100).toFixed(1);\n                const riskClass = result.churn_probability > 0.5 ? 'high-risk' : 'low-risk';\n                \n                document.getElementById('result').innerHTML = `\n                    <div class=\"result ${riskClass}\">\n                        <h3>Churn Probability: ${churnProb}%</h3>\n                        <p>Risk Level: ${result.confidence.toUpperCase()}</p>\n                        <p>Model Version: ${result.model_version}</p>\n                    </div>\n                `;\n            } catch (error) {\n                document.getElementById('result').innerHTML = `<div class=\"result\">Error: ${error.message}</div>`;\n            }\n        });\n    </script>\n</body>\n</html>"
        ]
