      "outputs": [],
      "source": [
        [
          "python",
          "from fastapi import FastAPI, HTTPException\nfrom pydantic import BaseModel, Field\nimport numpy as np\nimport joblib\nimport logging\n\napp = FastAPI(title=\"Churn Prediction API\", version=\"1.0\")\nlogger = logging.getLogger(__name__)\n\n# Load model and scaler at startup\nmodel = joblib.load('models/churn_model_v1.pkl')\nscaler = joblib.load('models/scaler_v1.pkl')\nmetadata = joblib.load('models/metadata_v1.pkl')\n\n# Define request schema\nclass CustomerInput(BaseModel):\n    contract_length: float = Field(..., description=\"Contract length in months\")\n    monthly_charge: float = Field(..., description=\"Monthly charge in dollars\")\n    total_charges: float = Field(..., description=\"Total charges paid\")\n    months_service: float = Field(..., description=\"Months as a customer\")\n    internet_service_fiber: int = Field(..., description=\"1 if Fiber, 0 otherwise\")\n    contract_type_one_year: int = Field(..., description=\"1 if one-year contract\")\n    \n    class Config:\n        schema_extra = {\n            \"example\": {\n                \"contract_length\": 24,\n                \"monthly_charge\": 65.5,\n                \"total_charges\": 1500.0,\n                \"months_service\": 24,\n                \"internet_service_fiber\": 0,\n                \"contract_type_one_year\": 1\n            }\n        }\n\n# Define response schema\nclass PredictionOutput(BaseModel):\n    churn_probability: float\n    churn_prediction: int\n    model_version: str\n    confidence: str\n\n@app.get(\"/health\")\nasync def health_check():\n    \"\"\"Health check endpoint.\"\"\"\n    return {\"status\": \"healthy\", \"model_version\": metadata['version']}\n\n@app.post(\"/predict\", response_model=PredictionOutput)\nasync def predict_churn(customer: CustomerInput):\n    \"\"\"Predict churn probability for a customer.\"\"\"\n    try:\n        # Convert input to numpy array\n        features = np.array([[\n            customer.contract_length,\n            customer.monthly_charge,\n            customer.total_charges,\n            customer.months_service,\n            customer.internet_service_fiber,\n            customer.contract_type_one_year\n        ]])\n        \n        # Scale features\n        features_scaled = scaler.transform(features)\n        \n        # Make prediction\n        churn_prob = model.predict_proba(features_scaled)[0][1]\n        churn_pred = model.predict(features_scaled)[0]\n        \n        # Confidence interpretation\n        confidence = \"high\" if churn_prob > 0.7 else (\"medium\" if churn_prob > 0.4 else \"low\")\n        \n        return PredictionOutput(\n            churn_probability=float(churn_prob),\n            churn_prediction=int(churn_pred),\n            model_version=metadata['version'],\n            confidence=confidence\n        )\n    except Exception as e:\n        logger.error(f\"Prediction error: {str(e)}\")\n        raise HTTPException(status_code=500, detail=\"Prediction failed\")\n\n@app.post(\"/batch-predict\")\nasync def batch_predict(customers: list[CustomerInput]):\n    \"\"\"Predict churn for multiple customers.\"\"\"\n    predictions = []\n    for customer in customers:\n        pred = await predict_churn(customer)\n        predictions.append(pred)\n    return predictions\n\nif __name__ == \"__main__\":\n    import uvicorn\n    uvicorn.run(app, host=\"0.0.0.0\", port=8000)"
        ]
      ]
