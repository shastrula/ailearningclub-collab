          "python",
          "import requests\nimport json\nfrom fastapi.testclient import TestClient\n\n# Create test client\nclient = TestClient(app)\n\ndef test_health_check():\n    \"\"\"Test health endpoint.\"\"\"\n    response = client.get(\"/health\")\n    assert response.status_code == 200\n    assert response.json()[\"status\"] == \"healthy\"\n    print(\"\u2713 Health check passed\")\n\ndef test_single_prediction():\n    \"\"\"Test single prediction endpoint.\"\"\"\n    payload = {\n        \"contract_length\": 24,\n        \"monthly_charge\": 65.5,\n        \"total_charges\": 1500.0,\n        \"months_service\": 24,\n        \"internet_service_fiber\": 0,\n        \"contract_type_one_year\": 1\n    }\n    response = client.post(\"/predict\", json=payload)\n    assert response.status_code == 200\n    result = response.json()\n    assert 0 <= result[\"churn_probability\"] <= 1\n    assert result[\"churn_prediction\"] in [0, 1]\n    print(f\"\u2713 Single prediction: churn_prob={result['churn_probability']:.3f}\")\n\ndef test_batch_prediction():\n    \"\"\"Test batch prediction endpoint.\"\"\"\n    customers = [\n        {\n            \"contract_length\": 24, \"monthly_charge\": 65.5, \"total_charges\": 1500.0,\n            \"months_service\": 24, \"internet_service_fiber\": 0, \"contract_type_one_year\": 1\n        },\n        {\n            \"contract_length\": 1, \"monthly_charge\": 45.0, \"total_charges\": 45.0,\n            \"months_service\": 1, \"internet_service_fiber\": 1, \"contract_type_one_year\": 0\n        }\n    ]\n    response = client.post(\"/batch-predict\", json=customers)\n    assert response.status_code == 200\n    results = response.json()\n    assert len(results) == 2\n    print(f\"\u2713 Batch prediction: {len(results)} customers processed\")\n\ndef test_invalid_input():\n    \"\"\"Test error handling with invalid input.\"\"\"\n    payload = {\"contract_length\": \"invalid\"}  # Invalid type\n    response = client.post(\"/predict\", json=payload)\n    assert response.status_code == 422  # Validation error\n    print(\"\u2713 Invalid input properly rejected\")\n\n# Run tests\ntest_health_check()\ntest_single_prediction()\ntest_batch_prediction()\ntest_invalid_input()\nprint(\"\\nAll tests passed!\")"
        ]
      ]
    },
