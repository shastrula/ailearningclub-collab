        [
          "python",
          "output = activation(\u03a3(weight_i * input_i) + bias)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Define activation functions\ndef relu(x):\n    return np.maximum(0, x)\n\ndef sigmoid(x):\n    return 1 / (1 + np.exp(-np.clip(x, -500, 500)))\n\ndef tanh_func(x):\n    return np.tanh(x)\n\ndef leaky_relu(x, alpha=0.01):\n    return np.where(x > 0, x, alpha * x)\n\ndef softmax(x):\n    x = x - np.max(x, axis=1, keepdims=True)  # Numerical stability\n    return np.exp(x) / np.sum(np.exp(x), axis=1, keepdims=True)\n\n# Plot activation functions and derivatives\nx = np.linspace(-10, 10, 1000)\n\nfig, axes = plt.subplots(2, 2, figsize=(12, 10))\n\n# ReLU\naxes[0, 0].plot(x, relu(x), 'b-', linewidth=2)\naxes[0, 0].axhline(0, c='k', linestyle='-', alpha=0.3)\naxes[0, 0].axvline(0, c='k', linestyle='-', alpha=0.3)\naxes[0, 0].set_title('ReLU: max(0, x)', fontsize=12, fontweight='bold')\naxes[0, 0].grid(alpha=0.3)\n\n# Sigmoid\naxes[0, 1].plot(x, sigmoid(x), 'g-', linewidth=2)\naxes[0, 1].axhline(0.5, c='k', linestyle='--', alpha=0.3)\naxes[0, 1].axvline(0, c='k', linestyle='-', alpha=0.3)\naxes[0, 1].set_title('Sigmoid: 1/(1+e^(-x))', fontsize=12, fontweight='bold')\naxes[0, 1].set_ylim([-0.1, 1.1])\naxes[0, 1].grid(alpha=0.3)\n\n# Tanh\naxes[1, 0].plot(x, tanh_func(x), 'r-', linewidth=2)\naxes[1, 0].axhline(0, c='k', linestyle='-', alpha=0.3)\naxes[1, 0].axvline(0, c='k', linestyle='-', alpha=0.3)\naxes[1, 0].set_title('Tanh: (e^x - e^(-x))/(e^x + e^(-x))', fontsize=12, fontweight='bold')\naxes[1, 0].set_ylim([-1.1, 1.1])\naxes[1, 0].grid(alpha=0.3)\n\n# Leaky ReLU\naxes[1, 1].plot(x, leaky_relu(x), 'purple', linewidth=2)\naxes[1, 1].axhline(0, c='k', linestyle='-', alpha=0.3)\naxes[1, 1].axvline(0, c='k', linestyle='-', alpha=0.3)\naxes[1, 1].set_title('Leaky ReLU: x if x>0 else 0.01x', fontsize=12, fontweight='bold')\naxes[1, 1].grid(alpha=0.3)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
