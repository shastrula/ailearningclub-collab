          "python",
          "import json\n\nclass AdaptiveLearningSystem:\n    \"\"\"Personalized learning recommendation engine.\"\"\"\n    \n    def __init__(self):\n        self.student_profiles = {}\n        self.concept_prerequisites = {\n            'Linear Algebra': [],\n            'Calculus': ['Algebra'],\n            'Machine Learning': ['Linear Algebra', 'Calculus', 'Probability'],\n            'Neural Networks': ['Linear Algebra', 'Calculus', 'Probability'],\n            'Deep Learning': ['Neural Networks', 'Machine Learning']\n        }\n    \n    def update_student_mastery(self, student_id: str, concept: str, quiz_score: float, time_spent_sec: int) -> float:\n        \"\"\"Update estimated mastery level using Bayesian updating.\"\"\"\n        if student_id not in self.student_profiles:\n            self.student_profiles[student_id] = {}\n        \n        # Prior mastery from history\n        prior_mastery = self.student_profiles[student_id].get(concept, 0.1)\n        \n        # Likelihood: how consistent is quiz score with mastery?\n        # If mastery is 0.8, expect ~80% quiz score\n        likelihood = quiz_score if quiz_score > 0.6 else 0.5\n        \n        # Bayesian update\n        posterior = (likelihood * prior_mastery) / (likelihood * prior_mastery + (1 - likelihood) * (1 - prior_mastery))\n        \n        # Time penalty: too fast = guessing, too slow = struggling\n        optimal_time = 300  # 5 minutes expected\n        if time_spent_sec < optimal_time * 0.5:\n            posterior *= 0.7  # Penalize rushed answers\n        elif time_spent_sec > optimal_time * 3:\n            posterior *= 0.8  # Penalize excessive struggle\n        \n        self.student_profiles[student_id][concept] = posterior\n        return posterior\n    \n    def recommend_next_content(self, student_id: str) -> str:\n        \"\"\"Recommend which concept to study next.\"\"\"\n        profile = self.student_profiles.get(student_id, {})\n        mastery_threshold = 0.75\n        \n        for concept, prerequisites in self.concept_prerequisites.items():\n            # Check if all prerequisites are mastered\n            prereq_mastered = all(\n                profile.get(prereq, 0) >= mastery_threshold \n                for prereq in prerequisites\n            )\n            \n            # Check if concept not yet mastered\n            not_yet_mastered = profile.get(concept, 0) < mastery_threshold\n            \n            if prereq_mastered and not_yet_mastered:\n                return concept\n        \n        return \"You've completed all concepts! Advanced topics available.\"\n    \n    def predict_completion_risk(self, student_id: str) -> dict:\n        \"\"\"Identify students at risk of dropping out.\"\"\"\n        profile = self.student_profiles.get(student_id, {})\n        \n        # Simple risk model: low mastery + few concepts completed\n        avg_mastery = np.mean(list(profile.values())) if profile else 0\n        concepts_completed = sum(1 for m in profile.values() if m >= 0.75)\n        \n        # Risk score: 0-1, where 1 is highest risk\n        risk_score = max(0, 1 - (avg_mastery * 0.5 + concepts_completed * 0.05))\n        \n        risk_level = 'LOW' if risk_score < 0.3 else ('MEDIUM' if risk_score < 0.6 else 'HIGH')\n        \n        intervention = {\n            'HIGH': 'Schedule mentor call, recommend easier prerequisite review',\n            'MEDIUM': 'Encourage peer study groups, provide optional tutoring',\n            'LOW': 'Continue normal path, consider acceleration'\n        }\n        \n        return {\n            'risk_score': risk_score,\n            'risk_level': risk_level,\n            'estimated_completion_probability': 1 - risk_score,\n            'recommended_intervention': intervention[risk_level]\n        }\n\n# Demonstrate\nadaptive_system = AdaptiveLearningSystem()\n\n# Simulate student progress\nstudent_id = \"STU_12345\"\ninteractions = [\n    (\"Algebra\", 0.92, 180),\n    (\"Calculus\", 0.88, 240),\n    (\"Linear Algebra\", 0.85, 210),\n    (\"Probability\", 0.72, 320),\n    (\"Machine Learning\", 0.65, 450)  # Struggling\n]\n\nprint(\"Adaptive Learning System Simulation\")\nprint(\"=\" * 50)\n\nfor concept, score, time in interactions:\n    mastery = adaptive_system.update_student_mastery(student_id, concept, score, time)\n    print(f\"\\n{concept}:\")\n    print(f\"  Quiz score: {score:.0%}, Time: {time}s\")\n    print(f\"  Mastery level: {mastery:.0%}\")\n\n# Recommendation\nnext_topic = adaptive_system.recommend_next_content(student_id)\nprint(f\"\\nRecommended next topic: {next_topic}\")\n\n# Risk analysis\nrisk = adaptive_system.predict_completion_risk(student_id)\nprint(f\"\\nCompletion Risk:\")\nprint(f\"  Risk level: {risk['risk_level']}\")\nprint(f\"  Completion probability: {risk['estimated_completion_probability']:.0%}\")\nprint(f\"  Intervention: {risk['recommended_intervention']}\")"
        ]
