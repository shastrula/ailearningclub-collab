          "python",
          "import pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import precision_recall_curve\nimport warnings\nwarnings.filterwarnings('ignore')\n\nclass PredictiveMaintenanceSystem:\n    \"\"\"Production ML system for equipment failure prediction.\"\"\"\n    \n    def __init__(self, alert_threshold: float = 0.8):\n        self.alert_threshold = alert_threshold\n        self.model = None\n        self.scaler = StandardScaler()\n        self.maintenance_history = []\n    \n    def extract_time_series_features(self, sensor_data: pd.DataFrame, window_hours: int = 24) -> pd.DataFrame:\n        \"\"\"Extract statistical features from sensor streams.\"\"\"\n        features = pd.DataFrame()\n        \n        for sensor_col in ['vibration_hz', 'temperature_c', 'pressure_psi', 'power_kw']:\n            # Time-domain features\n            features[f'{sensor_col}_mean'] = sensor_data[sensor_col].rolling(window_hours).mean()\n            features[f'{sensor_col}_std'] = sensor_data[sensor_col].rolling(window_hours).std()\n            features[f'{sensor_col}_max'] = sensor_data[sensor_col].rolling(window_hours).max()\n            features[f'{sensor_col}_trend'] = sensor_data[sensor_col].diff(periods=window_hours//2)\n        \n        # Health score: composite metric\n        features['health_score'] = (\n            (1 - features['vibration_hz_std'] / features['vibration_hz_std'].max()) * 0.3 +\n            (1 - (features['temperature_c_mean'] - 20) / 60) * 0.3 +\n            (1 - features['power_kw_std'] / features['power_kw_std'].max()) * 0.2 +\n            (1 - abs(features['vibration_hz_trend']) / abs(features['vibration_hz_trend']).max()) * 0.2\n        )\n        \n        return features.dropna()\n    \n    def train_failure_predictor(self, historical_data: pd.DataFrame, failure_labels: np.ndarray):\n        \"\"\"Train model on historical sensor + failure labels.\"\"\"\n        X = self.scaler.fit_transform(historical_data)\n        \n        self.model = RandomForestClassifier(\n            n_estimators=200,\n            max_depth=15,\n            min_samples_split=10,\n            class_weight='balanced',  # Failures are rare\n            random_state=42,\n            n_jobs=-1\n        )\n        self.model.fit(X, failure_labels)\n        return self.model\n    \n    def predict_maintenance_urgency(self, current_sensors: pd.DataFrame) -> dict:\n        \"\"\"Predict if equipment needs maintenance in next 72 hours.\"\"\"\n        features = self.extract_time_series_features(current_sensors)\n        X = self.scaler.transform(features.iloc[-1:])\n        \n        failure_prob = self.model.predict_proba(X)[0][1]\n        \n        urgency = 'LOW'\n        if failure_prob > 0.8:\n            urgency = 'CRITICAL'\n        elif failure_prob > 0.6:\n            urgency = 'HIGH'\n        elif failure_prob > 0.4:\n            urgency = 'MEDIUM'\n        \n        recommendation = {\n            'failure_probability': failure_prob,\n            'urgency': urgency,\n            'action': 'Schedule maintenance within 72 hours' if failure_prob > 0.6 else 'Continue monitoring',\n            'estimated_downtime_hours': 4 if failure_prob > 0.6 else 0\n        }\n        \n        # Log for analysis\n        self.maintenance_history.append({\n            'timestamp': pd.Timestamp.now(),\n            'failure_probability': failure_prob,\n            'action_taken': recommendation['action']\n        })\n        \n        return recommendation\n    \n    def calculate_roi(self, daily_downtime_cost: float, avg_failure_interval_days: int) -> dict:\n        \"\"\"Calculate business value of predictive maintenance.\"\"\"\n        annual_failures_reactive = 365 / avg_failure_interval_days\n        reactive_cost = annual_failures_reactive * daily_downtime_cost * 2  # ~2 day recovery time\n        \n        predicted_maintenance_cost = 50000  # Annual maintenance + ML system\n        reactive_maintenance_cost = 30000\n        \n        pm_total_cost = predicted_maintenance_cost + (reactive_cost * 0.1)  # 90% fewer failures\n        reactive_total_cost = reactive_maintenance_cost + reactive_cost\n        \n        annual_savings = reactive_total_cost - pm_total_cost\n        roi = annual_savings / predicted_maintenance_cost\n        \n        return {\n            'annual_savings': annual_savings,\n            'roi_percent': roi * 100,\n            'payback_period_months': 12 / (roi + 1) if roi > 0 else float('inf')\n        }\n\n# Demonstrate the system\nprint(\"Predictive Maintenance System for Manufacturing\")\nprint(\"=\" * 50)\n\n# Simulate sensor data\nnp.random.seed(42)\ndates = pd.date_range('2025-01-01', periods=1000, freq='H')\nsensor_data = pd.DataFrame({\n    'timestamp': dates,\n    'vibration_hz': np.random.normal(15, 2, 1000) + np.linspace(0, 8, 1000),  # Degrading\n    'temperature_c': np.random.normal(45, 3, 1000),\n    'pressure_psi': np.random.normal(100, 5, 1000),\n    'power_kw': np.random.normal(50, 5, 1000)\n})\n\nsystem = PredictiveMaintenanceSystem()\nfeatures = system.extract_time_series_features(sensor_data)\n\n# Simulate 30 failures over 1000 hours (realistic equipment)\nfailure_labels = np.zeros(len(features))\nfailure_indices = np.random.choice(len(features), 30, replace=False)\nfailure_labels[failure_indices] = 1\n\nsystem.train_failure_predictor(features, failure_labels)\n\n# Check current equipment status\nstatus = system.predict_maintenance_urgency(sensor_data.tail(120))\nprint(f\"\\nCurrent Status: {status['urgency']}\")\nprint(f\"Failure Probability: {status['failure_probability']:.2%}\")\nprint(f\"Action: {status['action']}\")\n\n# Calculate ROI\nroi_metrics = system.calculate_roi(daily_downtime_cost=50000, avg_failure_interval_days=30)\nprint(f\"\\nROI Analysis:\")\nprint(f\"Annual Savings: ${roi_metrics['annual_savings']:,.0f}\")\nprint(f\"ROI: {roi_metrics['roi_percent']:.0f}%\")\nprint(f\"Payback Period: {roi_metrics['payback_period_months']:.1f} months\")"
        ]
