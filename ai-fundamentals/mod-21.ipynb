          "python",
          "import numpy as np\nfrom dataclasses import dataclass\n\n@dataclass\nclass CropField:\n    field_id: str\n    area_hectares: float\n    soil_type: str  # Clay, Loam, Sandy\n    crop_type: str\n    planting_date: str\n\nclass PrecisionFarmingSystem:\n    \"\"\"ML system for optimal agricultural decisions.\"\"\"\n    \n    def __init__(self):\n        self.yield_model = None\n        self.irrigation_model = None\n        self.fertilizer_recommendations = {}\n    \n    def predict_optimal_irrigation(self, soil_moisture: float, weather_forecast: dict) -> dict:\n        \"\"\"Determine water needs based on soil and forecast.\"\"\"\n        # In production: neural network predicts optimal water amount\n        base_water_mm = 2.5\n        \n        # Adjust for soil moisture deficit\n        if soil_moisture < 40:  # Below field capacity\n            water_needed = base_water_mm * 1.5\n        elif soil_moisture > 80:  # Near saturation\n            water_needed = base_water_mm * 0.2\n        else:\n            water_needed = base_water_mm\n        \n        # Adjust for rainfall forecast\n        expected_rainfall = weather_forecast.get('rainfall_mm', 0)\n        if expected_rainfall > 5:\n            water_needed *= 0.5\n        \n        return {\n            'water_mm': max(0, water_needed),\n            'irrigation_duration_hours': water_needed / 5,  # 5mm/hour sprinkler rate\n            'cost_usd': max(0, water_needed) * 0.05,  # $0.05 per mm\n            'efficiency_rating': 'Good' if 0.8 < soil_moisture < 0.9 else 'Fair'\n        }\n    \n    def recommend_fertilizer(self, soil_nutrients: dict, target_yield_tons: float, crop_type: str) -> dict:\n        \"\"\"Optimize fertilizer application.\"\"\"\n        # Typical nutrient uptake per ton of crop\n        nutrient_uptake = {\n            'maize': {'N': 20, 'P': 3, 'K': 20},\n            'wheat': {'N': 18, 'P': 2.5, 'K': 8},\n            'soybean': {'N': 15, 'P': 2, 'K': 20}  # Legume fixes own N\n        }\n        \n        uptake = nutrient_uptake.get(crop_type, nutrient_uptake['maize'])\n        target_uptake = {k: v * target_yield_tons for k, v in uptake.items()}\n        \n        # Account for soil reserves + organic matter contribution\n        recommendations = {}\n        for nutrient, target in target_uptake.items():\n            available = soil_nutrients.get(nutrient, 0)\n            deficit = max(0, target - available)\n            \n            # Fertilizer efficiency ~50-70%\n            fertilizer_needed = deficit / 0.6\n            cost = fertilizer_needed * {'N': 0.5, 'P': 1.0, 'K': 0.4}.get(nutrient, 0.5)\n            \n            recommendations[nutrient] = {\n                'kg_per_hectare': fertilizer_needed,\n                'cost_usd_per_hectare': cost,\n                'timing': 'Split: 50% at planting, 50% at V4-V6' if nutrient == 'N' else 'At planting'\n            }\n        \n        return recommendations\n    \n    def predict_yield(self, field: CropField, season_data: dict) -> dict:\n        \"\"\"Predict end-of-season yield.\"\"\"\n        # Simplified model: in production this would be a trained neural network\n        base_yield = {\n            'maize': 11,  # tons/hectare, typical US midwest\n            'wheat': 7,\n            'soybean': 3.5\n        }\n        \n        yield_baseline = base_yield.get(field.crop_type, 5)\n        \n        # Adjust for observed conditions\n        adjustment = 1.0\n        \n        if season_data['avg_temperature_c'] > 25:  # Heat stress\n            adjustment *= 0.85\n        if season_data['total_rainfall_mm'] < 300:  # Drought\n            adjustment *= 0.70\n        if season_data['avg_soil_moisture'] > 85:  # Too wet\n            adjustment *= 0.90\n        \n        predicted_yield = yield_baseline * adjustment\n        crop_revenue = predicted_yield * field.area_hectares * 250  # $/ton commodity price\n        \n        return {\n            'predicted_yield_tons_per_ha': predicted_yield,\n            'predicted_total_yield_tons': predicted_yield * field.area_hectares,\n            'projected_revenue_usd': crop_revenue,\n            'confidence_interval': '\u00b115%',  # Typical at mid-season\n            'key_risk_factor': 'Heat stress' if season_data['avg_temperature_c'] > 25 else 'Adequate'\n        }\n\n# Demonstrate\nfield = CropField(field_id=\"FIELD_001\", area_hectares=40, soil_type=\"Loam\", crop_type=\"maize\", planting_date=\"2025-04-15\")\nfarm_system = PrecisionFarmingSystem()\n\n# Current conditions\nweather = {'rainfall_mm': 2, 'temp_c': 22}\nsoil_moisture = 65  # 0-100 scale\n\nirrigation_plan = farm_system.predict_optimal_irrigation(soil_moisture, weather)\nprint(f\"Irrigation Recommendation for {field.field_id}:\")\nprint(f\"  Water needed: {irrigation_plan['water_mm']:.1f} mm\")\nprint(f\"  Duration: {irrigation_plan['irrigation_duration_hours']:.1f} hours\")\nprint(f\"  Cost: ${irrigation_plan['cost_usd']:.0f}\")\n\n# Soil test results\nsoil_nutrients = {'N': 80, 'P': 25, 'K': 150}  # ppm\nfert_rec = farm_system.recommend_fertilizer(soil_nutrients, target_yield_tons=12, crop_type='maize')\nprint(f\"\\nFertilizer Recommendations:\")\nfor nutrient, rec in fert_rec.items():\n    print(f\"  {nutrient}: {rec['kg_per_hectare']:.0f} kg/ha (${rec['cost_usd_per_hectare']:.0f}/ha)\")\n\n# Yield prediction\nseason = {'avg_temperature_c': 24, 'total_rainfall_mm': 650, 'avg_soil_moisture': 70}\nyield_pred = farm_system.predict_yield(field, season)\nprint(f\"\\nYield Projection:\")\nprint(f\"  Expected yield: {yield_pred['predicted_yield_tons_per_ha']:.1f} tons/ha\")\nprint(f\"  Field total: {yield_pred['predicted_total_yield_tons']:.0f} tons\")\nprint(f\"  Revenue: ${yield_pred['projected_revenue_usd']:,.0f}\")"
