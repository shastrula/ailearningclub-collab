          "python",
          "from openai import OpenAI\n\nclient = OpenAI(api_key=\"your-api-key\")\n\ndef query_foundation_model(prompt: str, model: str = \"gpt-4\") -> str:\n    \"\"\"Query a foundation model for text generation.\"\"\"\n    response = client.chat.completions.create(\n        model=model,\n        messages=[\n            {\"role\": \"system\", \"content\": \"You are an expert machine learning engineer.\"},\n            {\"role\": \"user\", \"content\": prompt}\n        ],\n        temperature=0.7,\n        max_tokens=500\n    )\n    return response.choices[0].message.content\n\n# Few-shot prompting: teach the model by example\nfew_shot_prompt = \"\"\"\nClassify the following customer reviews as positive or negative sentiment.\n\nExample 1: \"This product is amazing! I love it.\" \u2192 Positive\nExample 2: \"Terrible quality, waste of money.\" \u2192 Negative\nExample 3: \"It's okay, nothing special.\" \u2192 Neutral\n\nNow classify: \"Best purchase I've made all year, highly recommend!\"\n\"\"\"\n\nresult = query_foundation_model(few_shot_prompt)\nprint(f\"Classification: {result}\")\n\n# Chain-of-thought prompting: ask the model to reason step-by-step\nreasoning_prompt = \"\"\"\nSolve this step-by-step:\nA store sells apples at $2 each and oranges at $3 each. \nIf I buy 4 apples and 3 oranges, how much do I spend?\n\nThink through each step before giving the final answer.\n\"\"\"\n\nreasoning_result = query_foundation_model(reasoning_prompt)\nprint(f\"Reasoning result:\\n{reasoning_result}\")\n\n# Prompt engineering: crafting effective instructions\nsystem_prompt = \"\"\"\nYou are a helpful ML assistant. Your responses should:\n1. Be technically accurate\n2. Include practical code examples when relevant\n3. Explain complex concepts in simple terms\n4. Ask clarifying questions if ambiguous\n\"\"\"\n\ntechnical_prompt = \"\"\"\nHow would you handle class imbalance in a binary classification problem?\n\"\"\"\n\nresponse = client.chat.completions.create(\n    model=\"gpt-4\",\n    messages=[\n        {\"role\": \"system\", \"content\": system_prompt},\n        {\"role\": \"user\", \"content\": technical_prompt}\n    ],\n    temperature=0.5\n)\n\nprint(f\"Technical response:\\n{response.choices[0].message.content}\")"
        ]
      ]
    },
    {
