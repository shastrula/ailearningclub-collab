        [
          "python",
          "import base64\nfrom pathlib import Path\n\ndef encode_image_to_base64(image_path: str) -> str:\n    \"\"\"Convert image to base64 for API transmission.\"\"\"\n    with open(image_path, \"rb\") as image_file:\n        return base64.standard_b64encode(image_file.read()).decode(\"utf-8\")\n\ndef analyze_image_with_text(image_path: str, query: str) -> str:\n    \"\"\"Analyze an image using a multimodal foundation model.\"\"\"\n    base64_image = encode_image_to_base64(image_path)\n    \n    response = client.chat.completions.create(\n        model=\"gpt-4-vision\",\n        messages=[\n            {\n                \"role\": \"user\",\n                \"content\": [\n                    {\n                        \"type\": \"text\",\n                        \"text\": query\n                    },\n                    {\n                        \"type\": \"image_url\",\n                        \"image_url\": {\n                            \"url\": f\"data:image/jpeg;base64,{base64_image}\",\n                        },\n                    },\n                ],\n            }\n        ],\n    )\n    return response.choices[0].message.content\n\n# Example: Analyze a product photo\nquery = \"\"\"\nAnalyze this product image. Describe:\n1. What is the product?\n2. Estimated quality based on packaging\n3. Suggested improvements to the design\n\"\"\"\n\nanalysis = analyze_image_with_text(\"product_photo.jpg\", query)\nprint(f\"Product analysis:\\n{analysis}\")\n\n# Cross-modal search: find images matching text descriptions\ndef multimodal_search_demo():\n    \"\"\"Conceptual example of cross-modal search.\"\"\"\n    # In practice, you'd use embedding models that support multiple modalities\n    descriptions = [\n        \"A cat sleeping on a sunny window\",\n        \"Mountain landscape at sunset\",\n        \"Crowded city street with people\"\n    ]\n    \n    # Generate embeddings for text descriptions\n    # Compare against image embeddings in a vector database\n    # Return most similar images\n    print(\"Cross-modal search: match images to text descriptions\")\n    print(f\"Searching for images matching: {descriptions[0]}\")\n\nmultimodal_search_demo()"
        ]
      ]
    },
    {
