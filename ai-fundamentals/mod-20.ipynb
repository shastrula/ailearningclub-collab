          "python",
          "import brian2\nfrom brian2 import *\n\ndef spiking_neural_network_demo():\n    \"\"\"Simple spiking neural network with Brian2.\"\"\"\n    # Start fresh\n    start_scope()\n    \n    # Define neuron model (Leaky Integrate-and-Fire)\n    neuron_equations = '''\n    dv/dt = (I - v) / tau : 1\n    I : 1\n    tau : second\n    '''\n    \n    # Create neuron group\n    n_neurons = 100\n    tau = 10*ms\n    neurons = NeuronGroup(\n        n_neurons, \n        neuron_equations,\n        threshold='v > 1',\n        reset='v = 0',\n        method='linear'\n    )\n    \n    # Set neuron parameters\n    neurons.tau = tau\n    neurons.I = 0.9\n    \n    # Monitor spikes\n    spike_monitor = SpikeMonitor(neurons)\n    \n    # Run simulation\n    run(1*second)\n    \n    print(f\"Number of spikes: {spike_monitor.num_spikes}\")\n    print(f\"Spike rate: {spike_monitor.num_spikes / n_neurons / 1.0:.2f} Hz\")\n\nspiking_neural_network_demo()\n\nprint(\"\\nNeuromorphic advantages:\")\nprint(\"- Power consumption: mW vs Watts for deep learning\")\nprint(\"- Latency: microseconds vs milliseconds\")\nprint(\"- Suited for: event cameras, neuromorphic sensors, real-time control\")\nprint(\"\\nCurrent hardware: Intel Loihi, IBM TrueNorth, BrainScaleS\")"
        ]
      ]
