        [
          "python",
          "import json\nfrom typing import Any\n\nclass AIAgent:\n    \"\"\"Simple agent with tool-use capabilities.\"\"\"\n    \n    def __init__(self, model_client):\n        self.client = model_client\n        self.tools = [\n            {\n                \"name\": \"get_weather\",\n                \"description\": \"Get weather forecast for a location\",\n                \"parameters\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                        \"location\": {\"type\": \"string\"},\n                        \"days\": {\"type\": \"integer\", \"default\": 1}\n                    }\n                }\n            },\n            {\n                \"name\": \"search_flights\",\n                \"description\": \"Search for flights between two cities\",\n                \"parameters\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                        \"from_city\": {\"type\": \"string\"},\n                        \"to_city\": {\"type\": \"string\"},\n                        \"date\": {\"type\": \"string\"}\n                    }\n                }\n            }\n        ]\n    \n    def get_weather(self, location: str, days: int = 1) -> str:\n        \"\"\"Simulated weather tool.\"\"\"\n        return f\"Weather for {location}: Sunny, 72\u00b0F (next {days} days)\"\n    \n    def search_flights(self, from_city: str, to_city: str, date: str) -> str:\n        \"\"\"Simulated flight search tool.\"\"\"\n        return f\"Flights from {from_city} to {to_city} on {date}: $250-$450\"\n    \n    def run(self, user_query: str) -> str:\n        \"\"\"Execute agent loop: plan \u2192 act \u2192 reflect.\"\"\"\n        messages = [\n            {\"role\": \"user\", \"content\": user_query}\n        ]\n        \n        # Step 1: Agent reasons about which tools to use\n        print(f\"User: {user_query}\")\n        print(\"Agent reasoning...\")\n        \n        # Step 2: Call model with tool definitions\n        response = self.client.chat.completions.create(\n            model=\"gpt-4\",\n            messages=messages,\n            tools=self.tools,\n            tool_choice=\"auto\"\n        )\n        \n        # Step 3: Execute tools if requested\n        if response.choices[0].message.tool_calls:\n            for tool_call in response.choices[0].message.tool_calls:\n                tool_name = tool_call.function.name\n                tool_args = json.loads(tool_call.function.arguments)\n                \n                if tool_name == \"get_weather\":\n                    result = self.get_weather(**tool_args)\n                elif tool_name == \"search_flights\":\n                    result = self.search_flights(**tool_args)\n                \n                print(f\"  \u2192 Called {tool_name}: {result}\")\n                \n                # Add tool result to messages\n                messages.append({\n                    \"role\": \"assistant\",\n                    \"content\": response.choices[0].message.content\n                })\n                messages.append({\n                    \"role\": \"user\",\n                    \"content\": result\n                })\n        \n        # Step 4: Generate final response\n        final_response = self.client.chat.completions.create(\n            model=\"gpt-4\",\n            messages=messages\n        )\n        \n        return final_response.choices[0].message.content\n\n# Use the agent\nagent = AIAgent(client)\nresult = agent.run(\"Plan my trip to Hawaii. What's the weather, and what flights are available from NYC on Dec 20?\")\nprint(f\"Agent result:\\n{result}\")"
        ]
      ]
