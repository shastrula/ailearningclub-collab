          "python",
          "# Random Forest classifier\nrf = RandomForestClassifier(n_estimators=100, max_depth=5, random_state=42)\nrf.fit(X_train, y_train)\n\ny_pred_rf = rf.predict(X_test)\ny_proba_rf = rf.predict_proba(X_test)[:, 1]\n\n# Feature importance (averaged across trees)\nfeature_importance_rf = rf.feature_importances_\nprint(f\"\\nRandom Forest feature importance: {feature_importance_rf}\")\n\n# Out-of-bag score (internal cross-validation estimate)\noob_score = rf.oob_score_\nprint(f\"OOB Score: {oob_score:.4f}\")\n\n# Compare ensemble size\nprint(\"\\nNumber of Trees Impact:\")\nfor n_trees in [1, 10, 50, 100]:\n    rf = RandomForestClassifier(n_estimators=n_trees, max_depth=5, random_state=42)\n    rf.fit(X_train, y_train)\n    train_acc = rf.score(X_train, y_train)\n    test_acc = rf.score(X_test, y_test)\n    print(f\"  Trees={n_trees}: Train={train_acc:.4f}, Test={test_acc:.4f}\")"
