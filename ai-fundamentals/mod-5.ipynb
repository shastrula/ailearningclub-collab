        [
          "python",
          "# Decision Tree classifier\ndt = DecisionTreeClassifier(max_depth=3, random_state=42)\ndt.fit(X_train, y_train)\n\ny_pred_dt = dt.predict(X_test)\ny_proba_dt = dt.predict_proba(X_test)[:, 1]\n\n# Feature importance (how much each feature contributes)\nfeature_importance = dt.feature_importances_\nprint(f\"\\nDecision Tree feature importance: {feature_importance}\")\nprint(f\"Depth: {dt.get_depth()}\")\nprint(f\"Leaves: {dt.get_n_leaves()}\")\n\n# Compare different max_depths\nprint(\"\\nMax Depth Impact:\")\nfor depth in [1, 3, 5, 10]:\n    dt = DecisionTreeClassifier(max_depth=depth, random_state=42)\n    dt.fit(X_train, y_train)\n    train_acc = dt.score(X_train, y_train)\n    test_acc = dt.score(X_test, y_test)\n    print(f\"  Depth={depth}: Train={train_acc:.4f}, Test={test_acc:.4f}\")"
