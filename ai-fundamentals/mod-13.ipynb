          "python",
          "import numpy as np\n\nclass BanditEnvironment:\n    \"\"\"Simple multi-armed bandit for exploring exploration strategies\"\"\"\n    def __init__(self, arm_means):\n        self.arm_means = arm_means\n        self.num_arms = len(arm_means)\n    \n    def pull(self, arm):\n        # Return reward with noise\n        return np.random.normal(self.arm_means[arm], 1.0)\n\nclass ExplorationStrategies:\n    def __init__(self, num_arms):\n        self.num_arms = num_arms\n        self.q_values = np.zeros(num_arms)\n        self.action_counts = np.zeros(num_arms)\n    \n    def epsilon_greedy(self, epsilon):\n        if np.random.random() < epsilon:\n            return np.random.randint(self.num_arms)\n        return np.argmax(self.q_values)\n    \n    def softmax(self, temperature=1.0):\n        # Higher temperature = more exploration\n        probs = np.exp(self.q_values / temperature)\n        probs /= probs.sum()\n        return np.random.choice(self.num_arms, p=probs)\n    \n    def ucb(self, c=1.0):\n        # Upper Confidence Bound\n        total_pulls = self.action_counts.sum()\n        ucb_values = self.q_values + c * np.sqrt(np.log(total_pulls) / (self.action_counts + 1))\n        return np.argmax(ucb_values)\n    \n    def update(self, arm, reward):\n        self.action_counts[arm] += 1\n        self.q_values[arm] += (reward - self.q_values[arm]) / self.action_counts[arm]\n\n# Compare strategies\nnp.random.seed(42)\nenv = BanditEnvironment([0.1, 0.5, 0.3, 0.8, 0.2])\nstrategies = {\n    '\u03b5-greedy (0.1)': ('epsilon_greedy', {'epsilon': 0.1}),\n    '\u03b5-greedy (0.3)': ('epsilon_greedy', {'epsilon': 0.3}),\n    'Softmax': ('softmax', {'temperature': 0.5}),\n    'UCB': ('ucb', {'c': 1.0})\n}\n\nresults = {}\nfor name, (method, params) in strategies.items():\n    explorer = ExplorationStrategies(len(env.arm_means))\n    rewards = []\n    \n    for _ in range(1000):\n        func = getattr(explorer, method)\n        arm = func(**params)\n        reward = env.pull(arm)\n        explorer.update(arm, reward)\n        rewards.append(reward)\n    \n    results[name] = np.mean(rewards)\n\nfor name, avg_reward in results.items():\n    print(f\"{name:20} Average reward: {avg_reward:.3f}\")"
        ]
