      "outputs": [],
      "source": [
        [
          "python",
          "# Sample data\ndf = pd.DataFrame({\n    'color': ['red', 'blue', 'red', 'green', 'blue'],\n    'size': ['S', 'M', 'L', 'S', 'M'],\n    'price': [10, 20, 15, 25, 18]\n})\n\n# Method 1: Pandas get_dummies (one-hot encoding)\ndf_onehot = pd.get_dummies(df, columns=['color', 'size'], drop_first=False)\nprint(\"One-hot encoded:\")\nprint(df_onehot)\n\n# Method 2: Label Encoding (ordinal)\nle_color = LabelEncoder()\ndf['color_encoded'] = le_color.fit_transform(df['color'])\nprint(f\"\\nColor mapping: {dict(zip(le_color.classes_, le_color.transform(le_color.classes_)))}\")\n\n# Method 3: Manual mapping (when you know the order)\nsize_mapping = {'S': 0, 'M': 1, 'L': 2}\ndf['size_encoded'] = df['size'].map(size_mapping)\n\nprint(\"\\nLabel encoded:\")\nprint(df[['color_encoded', 'size_encoded']])"
