        [
          "python",
          "import pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import StandardScaler, MinMaxScaler, LabelEncoder\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.impute import SimpleImputer\n\n# Load and explore data\ndf = pd.read_csv('data.csv')\n\nprint(df.head())\nprint(df.info())  # Data types and missing values\nprint(df.describe())  # Statistical summary\nprint(df.isnull().sum())  # Missing values per column\nprint(df.dtypes)  # Column data types\n\n# Check for duplicates\nprint(f\"Duplicate rows: {df.duplicated().sum()}\")\n\n# Identify categorical vs numeric columns\nnumeric_cols = df.select_dtypes(include=[np.number]).columns\ncategorical_cols = df.select_dtypes(include=['object']).columns\n\nprint(f\"Numeric columns: {list(numeric_cols)}\")\nprint(f\"Categorical columns: {list(categorical_cols)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Create sample data with missing values\ndf = pd.DataFrame({\n    'age': [25, 30, np.nan, 45, np.nan, 35],\n    'income': [50000, np.nan, 75000, 90000, 65000, 80000],\n    'category': ['A', 'B', np.nan, 'A', 'C', 'B']\n})\n\n# Strategy 1: Drop rows with any missing values\ndf_dropped = df.dropna()\n\n# Strategy 2: Drop rows where specific column is missing\ndf_dropped_age = df.dropna(subset=['age'])\n\n# Strategy 3: Fill with mean (numeric only)\ndf['age_filled'] = df['age'].fillna(df['age'].mean())\n\n# Strategy 4: Fill with median (more robust to outliers)\ndf['income_filled'] = df['income'].fillna(df['income'].median())\n\n# Strategy 5: Fill with forward fill (for time series)\ndf['category_filled'] = df['category'].fillna(method='ffill')\n\n# Strategy 6: Fill with a constant\ndf['income_filled_const'] = df['income'].fillna(0)\n\n# Using sklearn SimpleImputer for pipelines\nimputer = SimpleImputer(strategy='mean')\ndf_imputed = pd.DataFrame(\n    imputer.fit_transform(df[['age', 'income']]),\n    columns=['age', 'income']\n)\n\nprint(\"Original missing values:\")\nprint(df.isnull().sum())\nprint(\"\\nAfter imputation:\")\nprint(df_imputed.isnull().sum())"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
