          "python",
          "import numpy as np\n\nclass AutonomousVehiclePerception:\n    \"\"\"Simplified AV perception pipeline\"\"\"\n    \n    def __init__(self):\n        self.camera_model = None\n        self.lidar_model = None\n        self.fusion_model = None\n    \n    def detect_objects_camera(self, image):\n        \"\"\"CNN-based object detection from camera image\"\"\"\n        # Simulate detection results\n        detections = {\n            'pedestrians': [],\n            'vehicles': [],\n            'cyclists': [],\n            'traffic_signs': []\n        }\n        \n        # In reality: runs YOLO/Faster R-CNN on image\n        # Returns bounding boxes, class scores, confidence\n        num_pedestrians = np.random.poisson(2)\n        for _ in range(num_pedestrians):\n            detections['pedestrians'].append({\n                'bbox': [np.random.randint(0, 640), np.random.randint(0, 480),\n                        np.random.randint(50, 150), np.random.randint(100, 300)],\n                'confidence': np.random.uniform(0.7, 0.99)\n            })\n        \n        return detections\n    \n    def detect_objects_lidar(self, point_cloud):\n        \"\"\"Point cloud-based 3D object detection\"\"\"\n        # Simulate LIDAR detections\n        detections = []\n        n_objects = np.random.poisson(5)\n        \n        for _ in range(n_objects):\n            detections.append({\n                'position': [np.random.uniform(-30, 30), \n                            np.random.uniform(0, 100), \n                            np.random.uniform(-2, 2)],\n                'size': [np.random.uniform(1, 3), \n                        np.random.uniform(1, 3), \n                        np.random.uniform(1.5, 2.5)],\n                'confidence': np.random.uniform(0.8, 0.99)\n            })\n        \n        return detections\n    \n    def fuse_detections(self, camera_detections, lidar_detections):\n        \"\"\"Combine camera and LIDAR for robust perception\"\"\"\n        # Sensor fusion improves reliability\n        # LIDAR: robust in rain/night, limited FOV\n        # Camera: wide FOV, struggles in adverse conditions\n        \n        fused = {\n            'high_confidence': [],\n            'medium_confidence': [],\n            'low_confidence': []\n        }\n        \n        # Objects detected by both sensors: high confidence\n        high_conf_count = min(len(camera_detections['vehicles']),\n                             len(lidar_detections)) * 0.8\n        fused['high_confidence'] = list(range(int(high_conf_count)))\n        \n        return fused\n    \n    def predict_trajectory(self, detected_object, motion_model):\n        \"\"\"Predict future position of detected object\"\"\"\n        # Critical for collision avoidance\n        position = detected_object['position']\n        velocity = [np.random.uniform(-5, 5), np.random.uniform(-5, 5), 0]\n        \n        # Predict 1-2 seconds ahead\n        future_positions = []\n        for t in [0.5, 1.0, 1.5, 2.0]:\n            future_pos = [position[i] + velocity[i] * t for i in range(3)]\n            future_positions.append(future_pos)\n        \n        return future_positions\n    \n    def compute_risk_level(self, detections, vehicle_position):\n        \"\"\"Assess collision risk\"\"\"\n        risks = []\n        for detection in detections.get('high_confidence', []):\n            distance = np.random.uniform(5, 50)\n            \n            if distance < 10:\n                risk = 'CRITICAL'\n            elif distance < 20:\n                risk = 'HIGH'\n            else:\n                risk = 'MEDIUM'\n            \n            risks.append({'detection': detection, 'risk': risk, 'distance': distance})\n        \n        return risks\n\n# Simulate autonomous vehicle perception\nprint(\"Autonomous Vehicle Perception System\")\nprint(\"=\" * 50)\n\nav = AutonomousVehiclePerception()\n\n# Simulated sensor inputs\nimage = np.random.randn(720, 1280, 3)  # RGB image\npoint_cloud = np.random.randn(100000, 3)  # LIDAR point cloud\n\n# Pipeline\ncamera_det = av.detect_objects_camera(image)\nlidar_det = av.detect_objects_lidar(point_cloud)\nfused = av.fuse_detections(camera_det, lidar_det)\n\nprint(f\"\\nSensor Inputs:\")\nprint(f\"  Camera: 1280\u00d7720 RGB image\")\nprint(f\"  LIDAR: 100k point cloud\")\nprint(f\"  Processing time: ~50ms (real-time requirement: <100ms)\")\n\nprint(f\"\\nDetections:\")\nprint(f\"  Camera pedestrians: {len(camera_det['pedestrians'])}\")\nprint(f\"  LIDAR objects: {len(lidar_det)}\")\nprint(f\"  Fused high-confidence: {len(fused['high_confidence'])}\")\n\n# Risk assessment\nrisks = av.compute_risk_level(lidar_det, [0, 10, 0])\nprint(f\"\\nRisk Assessment:\")\nfor i, risk in enumerate(risks[:3]):\n    print(f\"  Object {i}: {risk['risk']} (distance: {risk['distance']:.1f}m)\")\n\nprint(f\"\\nReliability Requirements:\")\nprint(f\"  Precision: >99% (minimize false positives)\")\nprint(f\"  Recall: >95% (catch actual obstacles)\")\nprint(f\"  Latency: <100ms (real-time processing)\")\nprint(f\"  Availability: 99.99% (fail-safe design)\")\nprint(f\"  Safety: SOTIF (ISO 26262) compliance\")"
        ]
