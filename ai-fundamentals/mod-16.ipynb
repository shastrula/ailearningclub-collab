          "python",
          "import numpy as np\nfrom sklearn.metrics import roc_auc_score, roc_curve, precision_recall_curve\nimport matplotlib.pyplot as plt\n\n# Simulated medical image classification results\nnp.random.seed(42)\nn_samples = 1000\n\n# Simulate model predictions and ground truth\n# Model trained on 100k images, tested on new dataset\ny_true = np.random.binomial(1, 0.15, n_samples)  # 15% disease prevalence\ny_scores = np.random.normal(0.3 * y_true + 0.1, 0.2, n_samples)\ny_scores = np.clip(y_scores, 0, 1)\n\n# Calculate metrics\nauc = roc_auc_score(y_true, y_scores)\nfpr, tpr, thresholds = roc_curve(y_true, y_scores)\n\n# Find optimal threshold (Youden's index)\nyouden_index = tpr - fpr\noptimal_idx = np.argmax(youden_index)\noptimal_threshold = thresholds[optimal_idx]\n\ny_pred = (y_scores >= optimal_threshold).astype(int)\n\n# Diagnostic metrics at optimal threshold\ntp = ((y_pred == 1) & (y_true == 1)).sum()\nfp = ((y_pred == 1) & (y_true == 0)).sum()\nfn = ((y_pred == 0) & (y_true == 1)).sum()\ntn = ((y_pred == 0) & (y_true == 0)).sum()\n\nsensitivity = tp / (tp + fn)  # Catch disease cases\nspecificity = tn / (tn + fp)  # Avoid false alarms\nppv = tp / (tp + fp)  # Clinician confidence in positive\n\nprint(\"Medical Image Diagnosis AI System\")\nprint(\"=\" * 50)\nprint(f\"Model: ResNet50 fine-tuned on ChexPert dataset\")\nprint(f\"Test Set: 1000 new X-rays\")\nprint(f\"\\nPerformance Metrics:\")\nprint(f\"  AUC-ROC:           {auc:.4f}\")\nprint(f\"  Sensitivity (TPR): {sensitivity:.4f}  (Catch disease)\")\nprint(f\"  Specificity (TNR): {specificity:.4f}  (Avoid false alarms)\")\nprint(f\"  Positive Predictive Value: {ppv:.4f}\")\nprint(f\"  Optimal Threshold: {optimal_threshold:.4f}\")\nprint(f\"\\nClinical Impact:\")\nprint(f\"  Diseases caught:   {tp}\")\nprint(f\"  Missed diseases:   {fn}\")\nprint(f\"  False alarms:      {fp}\")\nprint(f\"  Correct negatives: {tn}\")\nprint(f\"\\nKey Considerations:\")\nprint(f\"  \u2022 High sensitivity critical (avoid missing diseases)\")\nprint(f\"  \u2022 Radiologist remains decision-maker\")\nprint(f\"  \u2022 Model acts as triage/prioritization tool\")\nprint(f\"  \u2022 Requires continuous monitoring for distribution shift\")"
        ]
      ]
