          "python",
          "from sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.svm import LinearSVC\nfrom sklearn.pipeline import Pipeline\nimport numpy as np\n\n# Training data: user utterances and intents\ntraining_utterances = [\n    \"I want to return my order\",\n    \"Can I return this item\",\n    \"How do I get a refund\",\n    \"When will my order arrive\",\n    \"Track my package\",\n    \"Where is my delivery\",\n    \"How do I change my password\",\n    \"Reset my account password\",\n    \"I forgot my password\",\n    \"How much is shipping\",\n    \"What are your policies\",\n    \"Do you have a physical store\"\n]\n\ntraining_intents = [\n    \"refund_request\", \"refund_request\", \"refund_request\",\n    \"track_order\", \"track_order\", \"track_order\",\n    \"change_password\", \"change_password\", \"change_password\",\n    \"pricing_info\", \"general_inquiry\", \"general_inquiry\"\n]\n\n# Build intent classifier\nintent_classifier = Pipeline([\n    ('tfidf', TfidfVectorizer(lowercase=True, stop_words='english')),\n    ('svm', LinearSVC(random_state=42, max_iter=1000))\n])\n\nintent_classifier.fit(training_utterances, training_intents)\n\n# Sample user utterances for testing\ntest_utterances = [\n    \"I want my money back\",\n    \"Where is my package\",\n    \"I forgot my password\"\n]\n\npredictions = intent_classifier.predict(test_utterances)\nconfidences = intent_classifier.decision_function(test_utterances)\n\nprint(\"Chatbot Intent Classification System\")\nprint(\"=\" * 50)\nprint(\"\\nIntent Classification Results:\")\nfor utterance, intent, conf in zip(test_utterances, predictions, confidences):\n    print(f\"  User: '{utterance}'\")\n    print(f\"  Intent: {intent}\")\n    print(f\"  Confidence: {conf.max():.3f}\")\n\n# Entity extraction (simplified)\ndef extract_entities(utterance):\n    \"\"\"Extract order_id, product_name, etc. from utterance\"\"\"\n    entities = {}\n    \n    # In production: use NER models or regex patterns\n    if 'order' in utterance.lower():\n        # Look for order numbers (e.g., #12345)\n        import re\n        matches = re.findall(r'#?(\\d{5,})', utterance)\n        if matches:\n            entities['order_id'] = matches[0]\n    \n    return entities\n\nprint(\"\\nEntity Extraction:\")\nfor utterance in test_utterances:\n    entities = extract_entities(utterance)\n    print(f\"  '{utterance}'\")\n    if entities:\n        print(f\"    Entities: {entities}\")\n    else:\n        print(f\"    Entities: (none found)\")\n\nprint(\"\\nChatbot Response Flow:\")\nprint(\"  1. Receive user utterance\")\nprint(\"  2. Classify intent (90%+ accuracy typical)\")\nprint(\"  3. Extract entities (order_id, product_name, etc.)\")\nprint(\"  4. Route to appropriate handler\")\nprint(\"  5. Generate response based on intent & context\")\nprint(\"  6. Track conversation for context\")\n\nprint(\"\\nKey Challenges:\")\nprint(\"  \u2022 Out-of-domain queries: Users ask unexpected questions\")\nprint(\"  \u2022 Paraphrasing: Same intent expressed many ways\")\nprint(\"  \u2022 Ambiguity: 'I have a problem' - what kind?\")\nprint(\"  \u2022 Context: Multi-turn conversations needed\")\nprint(\"  \u2022 Language variations: Slang, typos, abbreviations\")"
