          "python",
          "from sklearn.ensemble import GradientBoostingClassifier\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import precision_recall_curve, f1_score\nimport numpy as np\n\n# Simulate transaction data\nnp.random.seed(42)\nn_transactions = 100000\n\n# Features: amount, merchant_category, time_of_day, customer_age, transaction_count, etc.\nfeatures = np.random.randn(n_transactions, 10)\nfeatures[:, 0] = np.abs(features[:, 0]) * 500  # Amount ($0-$2500)\n\n# Highly imbalanced: ~1% fraud\nfraud_rate = 0.01\ny = np.random.binomial(1, fraud_rate, n_transactions)\n\n# Fraud has different characteristics\nfraud_mask = y == 1\nfeatures[fraud_mask, 0] *= 2  # Larger amounts\nfeatures[fraud_mask, 1] += 1.5  # Different merchant categories\n\n# Split data\nX_train, X_test, y_train, y_test = train_test_split(\n    features, y, test_size=0.3, random_state=42, stratify=y\n)\n\n# Train with class weights to handle imbalance\nmodel = GradientBoostingClassifier(\n    n_estimators=100,\n    learning_rate=0.1,\n    max_depth=5,\n    random_state=42\n)\n\nmodel.fit(X_train, y_train, \n         sample_weight=np.where(y_train == 1, 10, 1))  # Weight fraud heavily\n\n# Predictions\ny_proba = model.predict_proba(X_test)[:, 1]\n\n# Find operating point: balance precision and recall\nprecision, recall, thresholds = precision_recall_curve(y_test, y_proba)\nf1_scores = 2 * (precision * recall) / (precision + recall + 1e-10)\nbest_threshold_idx = np.argmax(f1_scores)\nbest_threshold = thresholds[best_threshold_idx]\n\ny_pred = (y_proba >= best_threshold).astype(int)\n\n# Metrics\ntrue_positives = ((y_pred == 1) & (y_test == 1)).sum()\nfalse_positives = ((y_pred == 1) & (y_test == 0)).sum()\nfalse_negatives = ((y_pred == 0) & (y_test == 1)).sum()\n\nfraud_caught = true_positives / (true_positives + false_negatives)\nfalse_alarm_rate = false_positives / (false_positives + (y_test == 0).sum())\n\nprint(\"\\nFraud Detection System\")\nprint(\"=\" * 50)\nprint(f\"Model: Gradient Boosting with class weights\")\nprint(f\"Test Set: {len(X_test)} transactions ({(y_test == 1).sum()} fraudulent)\")\nprint(f\"\\nOperating Point (F1-optimized):\")\nprint(f\"  Threshold:       {best_threshold:.4f}\")\nprint(f\"  Fraud caught:    {fraud_caught:.2%}\")\nprint(f\"  False alarm rate:{false_alarm_rate:.2%}\")\nprint(f\"  Precision:       {precision[best_threshold_idx]:.4f}\")\nprint(f\"  Recall:          {recall[best_threshold_idx]:.4f}\")\nprint(f\"\\nBusiness Impact:\")\nprint(f\"  True positives (fraud caught):   {true_positives}\")\nprint(f\"  False positives (legit blocked): {false_positives}\")\nprint(f\"  False negatives (fraud missed):  {false_negatives}\")\nprint(f\"\\nKey Considerations:\")\nprint(f\"  \u2022 Precision-recall trade-off critical\")\nprint(f\"  \u2022 False positives harm customer experience\")\nprint(f\"  \u2022 False negatives cost money\")\nprint(f\"  \u2022 Model must adapt as fraud patterns evolve\")\nprint(f\"  \u2022 Real-time predictions required (<100ms)\")"
        ]
      ]
