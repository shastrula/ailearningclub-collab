          "python",
          "import seaborn as sns\n\n# Class distribution\nprint(f\"\\nClass balance:\")\nprint(df['will_purchase'].value_counts(normalize=True))\n\n# Correlation with target\ncorrelations = df.corr()['will_purchase'].drop('will_purchase').sort_values()\nprint(f\"\\nFeature correlations with purchase:\")\nprint(correlations)\n\n# Visualize key relationships\nfig, axes = plt.subplots(2, 2, figsize=(12, 8))\ndf.boxplot(column='days_since_last_visit', by='will_purchase', ax=axes[0,0])\ndf.boxplot(column='items_in_cart', by='will_purchase', ax=axes[0,1])\ndf.boxplot(column='email_opens_last_30d', by='will_purchase', ax=axes[1,0])\naxes[1,1].hist([df[df['will_purchase']==1]['previous_purchases'],\n                df[df['will_purchase']==0]['previous_purchases']],\n               label=['Purchased', 'Not'], bins=15)\naxes[1,1].legend()\nplt.tight_layout()\nplt.show()"
