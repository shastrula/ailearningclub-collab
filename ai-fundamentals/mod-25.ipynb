          "# Create meaningful interactions\ndf['engagement_score'] = (df['total_page_views'] * df['avg_session_duration']\n                          / (df['days_since_last_visit'] + 1))\ndf['cart_to_views_ratio'] = df['items_in_cart'] / (df['total_page_views'] + 1)\ndf['is_active_subscriber'] = (df['email_opens_last_30d'] >= 3).astype(int)\ndf['is_returning_customer'] = (df['previous_purchases'] >= 2).astype(int)"
