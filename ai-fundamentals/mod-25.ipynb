          "python",
          "import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom sklearn.model_selection import train_test_split, cross_val_score\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.metrics import classification_report, roc_auc_score\n\n# Simulate e-commerce customer data\nnp.random.seed(42)\nn = 2000\n\ndf = pd.DataFrame({\n    'days_since_last_visit': np.random.exponential(15, n),\n    'total_page_views': np.random.poisson(20, n),\n    'avg_session_duration': np.random.exponential(5, n),\n    'items_in_cart': np.random.poisson(2, n),\n    'email_opens_last_30d': np.random.poisson(3, n),\n    'previous_purchases': np.random.poisson(4, n),\n    'account_age_days': np.random.uniform(1, 730, n),\n    'is_mobile': np.random.choice([0, 1], n, p=[0.4, 0.6])\n})\n\n# Target: will purchase (influenced by features)\npurchase_prob = 1 / (1 + np.exp(-(\n    -2 + 0.1 * df['items_in_cart']\n    - 0.03 * df['days_since_last_visit']\n    + 0.05 * df['email_opens_last_30d']\n    + 0.02 * df['previous_purchases']\n)))\ndf['will_purchase'] = (np.random.uniform(0, 1, n) < purchase_prob).astype(int)\n\nprint(f\"Dataset shape: {df.shape}\")\nprint(f\"Purchase rate: {df['will_purchase'].mean():.1%}\")\nprint(df.describe())"
        ]
      ]
