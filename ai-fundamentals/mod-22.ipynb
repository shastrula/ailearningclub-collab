        [
          "python",
          "import shap\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.datasets import make_classification\n\n# Train a simple model\nX, y = make_classification(n_samples=200, n_features=10, random_state=42)\nmodel = RandomForestClassifier(n_estimators=100, random_state=42)\nmodel.fit(X, y)\n\n# Create SHAP explainer\nexplainer = shap.TreeExplainer(model)\nshap_values = explainer.shap_values(X[:10])\n\n# For a specific prediction\nsample_idx = 0\npred = model.predict([X[sample_idx]])[0]\nprint(f\"Prediction: {pred}\")\nprint(f\"Top contributing features (positive contribution):\")\nfeature_importance = sorted(\n    zip(range(X.shape[1]), shap_values[pred][sample_idx]),\n    key=lambda x: abs(x[1]),\n    reverse=True\n)\nfor feat_idx, importance in feature_importance[:3]:\n    print(f\"  Feature {feat_idx}: {importance:.4f}\")"
        ]
      ]
    },
    {
