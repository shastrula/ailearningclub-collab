      "source": [
        [
          "python",
          "from tensorflow.keras.applications import VGG16\nfrom tensorflow.keras.applications.vgg16 import preprocess_input, decode_predictions\nfrom tensorflow.keras.preprocessing.image import load_img, img_to_array\n\n# Load pre-trained VGG16\nvgg16 = VGG16(weights='imagenet', include_top=True)\nvgg16.summary()\n\n# For fine-tuning on custom dataset, build on pre-trained base\nbase_model = VGG16(weights='imagenet', include_top=False, \n                   input_shape=(224, 224, 3))\n\n# Freeze base model layers (don't retrain them)\nbase_model.trainable = False\n\n# Add custom top layers\nmodel = keras.Sequential([\n    base_model,\n    layers.Flatten(),\n    layers.Dense(256, activation='relu'),\n    layers.Dropout(0.5),\n    layers.Dense(10, activation='softmax')  # 10 custom classes\n])\n\nmodel.compile(\n    optimizer=keras.optimizers.Adam(learning_rate=1e-4),\n    loss='sparse_categorical_crossentropy',\n    metrics=['accuracy']\n)\n\n# Now train on custom dataset with only top layers learning\n# This is transfer learning - reuse features from ImageNet\n\nprint(\"Transfer Learning Model Built\")\nprint(f\"Total parameters: {model.count_params():,}\")\nprint(f\"Trainable parameters: {sum(p.numpy().size for p in model.trainable_weights):,}\")"
        ]
