      "source": [
        [
          "python",
          "import numpy as np\n\n# Create vectors\nv1 = np.array([1, 2, 3])\nv2 = np.array([4, 5, 6])\n\n# Vector addition\nv_sum = v1 + v2  # [5, 7, 9]\n\n# Dot product (similarity measure)\ndot_product = np.dot(v1, v2)  # 1*4 + 2*5 + 3*6 = 32\n\n# Vector magnitude (length)\nmagnitude = np.linalg.norm(v1)  # sqrt(1^2 + 2^2 + 3^2)\n\n# Cosine similarity (normalized dot product)\ncos_similarity = np.dot(v1, v2) / (np.linalg.norm(v1) * np.linalg.norm(v2))\n\nprint(f\"Dot product: {dot_product}\")\nprint(f\"Magnitude of v1: {magnitude}\")\nprint(f\"Cosine similarity: {cos_similarity}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Create matrices\nA = np.array([[1, 2], [3, 4], [5, 6]])  # 3x2 matrix\nB = np.array([[7, 8, 9], [10, 11, 12]])  # 2x3 matrix\n\n# Matrix multiplication (A @ B produces 3x3 result)\nC = np.dot(A, B)\n\n# Element-wise multiplication (Hadamard product)\nD = A * np.array([[1, 2], [1, 2], [1, 2]])\n\n# Matrix transpose\nA_transpose = A.T\n\n# Matrix inverse (only for square matrices)\nsquare_matrix = np.array([[1, 2], [3, 4]])\ninverse = np.linalg.inv(square_matrix)\n\n# Determinant\ndet = np.linalg.det(square_matrix)\n\n# Rank (number of linearly independent rows/columns)\nrank = np.linalg.matrix_rank(A)\n\nprint(f\"Matrix A shape: {A.shape}\")\nprint(f\"Matrix multiplication C shape: {C.shape}\")\nprint(f\"Determinant: {det}\")\nprint(f\"Rank of A: {rank}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Calculate eigenvalues and eigenvectors\nA = np.array([[4, 2], [1, 3]])\neigenvalues, eigenvectors = np.linalg.eig(A)\n\nprint(f\"Eigenvalues: {eigenvalues}\")\nprint(f\"Eigenvectors:\\n{eigenvectors}\")\n\n# Verify: A @ v = \u03bb * v\nv = eigenvectors[:, 0]\nlambda_val = eigenvalues[0]\nprint(f\"A @ v: {np.dot(A, v)}\")\nprint(f\"\u03bb * v: {lambda_val * v}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Computing derivatives numerically\ndef f(x):\n    return x**2 + 3*x + 2\n\ndef numerical_derivative(f, x, h=1e-5):\n    return (f(x + h) - f(x - h)) / (2 * h)\n\n# Derivative at x=2\nx = 2\nderivative = numerical_derivative(f, x)\nprint(f\"Derivative of f(x)=x^2+3x+2 at x={x}: {derivative}\")\n# Analytical: f'(x) = 2x + 3, so f'(2) = 7\n\n# Computing gradient of multivariate function\ndef f_multi(x):\n    return x[0]**2 + x[1]**2 + x[0]*x[1]\n\ndef numerical_gradient(f, x, h=1e-5):\n    grad = np.zeros_like(x, dtype=float)\n    for i in range(len(x)):\n        x_plus = x.copy()\n        x_minus = x.copy()\n        x_plus[i] += h\n        x_minus[i] -= h\n        grad[i] = (f(x_plus) - f(x_minus)) / (2 * h)\n    return grad\n\nx = np.array([1.0, 2.0])\ngrad = numerical_gradient(f_multi, x)\nprint(f\"Gradient at {x}: {grad}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Simple gradient descent optimization\ndef loss_function(x):\n    return (x - 3)**2  # Minimum at x=3\n\ndef loss_gradient(x):\n    return 2 * (x - 3)\n\n# Gradient descent\nx = 0.0\nlearning_rate = 0.1\niterations = 50\n\nfor i in range(iterations):\n    grad = loss_gradient(x)\n    x = x - learning_rate * grad\n    if i % 10 == 0:\n        print(f\"Iteration {i}: x={x:.4f}, loss={loss_function(x):.4f}\")\n\nprint(f\"Final x: {x:.4f} (optimal: 3.0)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Bayes' theorem example: Medical test\n# Prior: P(Disease) = 0.01 (1% of population has disease)\n# Likelihood: P(Positive|Disease) = 0.95 (test accuracy)\n# P(Positive|NoDisease) = 0.10 (false positive rate)\n\np_disease = 0.01\np_no_disease = 0.99\np_positive_given_disease = 0.95\np_positive_given_no_disease = 0.10\n\n# Total probability of positive test\np_positive = (p_positive_given_disease * p_disease + \n              p_positive_given_no_disease * p_no_disease)\n\n# Posterior: P(Disease|Positive)\np_disease_given_positive = (p_positive_given_disease * p_disease) / p_positive\n\nprint(f\"P(Disease|Positive): {p_disease_given_positive:.4f}\")\n# Even with positive test, only ~8.8% chance of disease due to low prior"
        ]
      ]
    }
