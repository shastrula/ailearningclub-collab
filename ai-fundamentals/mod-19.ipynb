        [
          "python",
          "class FeatureEngineer:\n    def __init__(self, data: pd.DataFrame):\n        self.data = data.copy()\n        self.feature_names = []\n    \n    def create_temporal_features(self) -> pd.DataFrame:\n        \"\"\"Extract time-based features.\"\"\"\n        self.data['hour'] = self.data['timestamp'].dt.hour\n        self.data['day_of_week'] = self.data['timestamp'].dt.dayofweek\n        self.data['month'] = self.data['timestamp'].dt.month\n        \n        # Cyclical encoding for hour (circular nature)\n        self.data['hour_sin'] = np.sin(2 * np.pi * self.data['hour'] / 24)\n        self.data['hour_cos'] = np.cos(2 * np.pi * self.data['hour'] / 24)\n        \n        self.feature_names.extend(['hour', 'day_of_week', 'month', 'hour_sin', 'hour_cos'])\n        return self.data\n    \n    def create_lag_features(self, lags: list = [1, 24, 168]) -> pd.DataFrame:\n        \"\"\"Create lagged features (past load values).\"\"\"\n        for lag in lags:\n            self.data[f'load_lag_{lag}h'] = self.data['load_mw'].shift(lag)\n            self.feature_names.append(f'load_lag_{lag}h')\n        \n        return self.data\n    \n    def create_rolling_features(self, windows: list = [24, 168]) -> pd.DataFrame:\n        \"\"\"Create rolling aggregate features.\"\"\"\n        for window in windows:\n            self.data[f'load_rolling_mean_{window}h'] = self.data['load_mw'].rolling(window=window).mean()\n            self.data[f'load_rolling_std_{window}h'] = self.data['load_mw'].rolling(window=window).std()\n            self.feature_names.extend([f'load_rolling_mean_{window}h', f'load_rolling_std_{window}h'])\n        \n        return self.data\n    \n    def engineer_all_features(self) -> pd.DataFrame:\n        \"\"\"Run full feature engineering pipeline.\"\"\"\n        self.create_temporal_features()\n        self.create_lag_features()\n        self.create_rolling_features()\n        \n        # Remove rows with NaN from lag/rolling operations\n        self.data.dropna(inplace=True)\n        \n        logger.info(f\"Created {len(self.feature_names)} features\")\n        return self.data\n\nengineer = FeatureEngineer(clean_data)\nfeatured_data = engineer.engineer_all_features()\nprint(f\"Features engineered: {len(engineer.feature_names)}\")\nprint(featured_data.head())"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor\nfrom sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\nimport matplotlib.pyplot as plt\n\nclass TimeSeriesModelTrainer:\n    def __init__(self, data: pd.DataFrame, feature_names: list):\n        self.data = data\n        self.feature_names = feature_names\n        self.models = {}\n        self.cv_results = []\n    \n    def time_series_split(self, test_size: int = 720):  # 30 days of hourly data\n        \"\"\"Split data respecting temporal order.\"\"\"\n        train_size = len(self.data) - test_size\n        X = self.data[self.feature_names].values\n        y = self.data['load_mw'].values\n        \n        return X[:train_size], X[train_size:], y[:train_size], y[train_size:]\n    \n    def time_series_cv(self, n_splits: int = 5):\n        \"\"\"Walk-forward cross-validation for time series.\"\"\"\n        X = self.data[self.feature_names].values\n        y = self.data['load_mw'].values\n        fold_size = len(self.data) // (n_splits + 1)\n        \n        for fold in range(n_splits):\n            train_end = fold_size * (fold + 1)\n            test_end = train_end + fold_size\n            \n            X_train, X_test = X[:train_end], X[train_end:test_end]\n            y_train, y_test = y[:train_end], y[train_end:test_end]\n            \n            yield X_train, X_test, y_train, y_test\n    \n    def train_and_evaluate(self):\n        \"\"\"Train multiple models with cross-validation.\"\"\"\n        models_config = {\n            'rf': RandomForestRegressor(n_estimators=100, max_depth=15, random_state=42),\n            'gb': GradientBoostingRegressor(n_estimators=100, learning_rate=0.1, random_state=42)\n        }\n        \n        cv_scores = {name: {'mae': [], 'rmse': [], 'r2': []} for name in models_config}\n        \n        for fold_idx, (X_train, X_test, y_train, y_test) in enumerate(self.time_series_cv(5)):\n            for name, model in models_config.items():\n                model.fit(X_train, y_train)\n                y_pred = model.predict(X_test)\n                \n                mae = mean_absolute_error(y_test, y_pred)\n                rmse = np.sqrt(mean_squared_error(y_test, y_pred))\n                r2 = r2_score(y_test, y_pred)\n                \n                cv_scores[name]['mae'].append(mae)\n                cv_scores[name]['rmse'].append(rmse)\n                cv_scores[name]['r2'].append(r2)\n        \n        # Report cross-validation results\n        for name, scores in cv_scores.items():\n            logger.info(f\"{name.upper()} CV - MAE: {np.mean(scores['mae']):.2f}, \"\n                       f\"RMSE: {np.mean(scores['rmse']):.2f}, \"\n                       f\"R\u00b2: {np.mean(scores['r2']):.4f}\")\n        \n        # Train final model on full training set\n        X_train, X_test, y_train, y_test = self.time_series_split()\n        best_model = GradientBoostingRegressor(n_estimators=100, learning_rate=0.1, random_state=42)\n        best_model.fit(X_train, y_train)\n        \n        self.models['production'] = best_model\n        return best_model, (X_test, y_test)\n\ntrainer = TimeSeriesModelTrainer(featured_data, engineer.feature_names)\nbest_model, (X_test, y_test) = trainer.train_and_evaluate()\nprint(f\"Model trained on {len(trainer.data)} total records\")"
        ]
      ]
    },
