          "python",
          "import joblib\nimport json\nfrom enum import Enum\n\nclass PipelineVersion(str, Enum):\n    v1 = \"1.0.0\"\n\nclass ProductionPipeline:\n    def __init__(self, model, feature_engineer, performance_baseline: dict):\n        self.model = model\n        self.feature_engineer = feature_engineer\n        self.performance_baseline = performance_baseline\n        self.version = PipelineVersion.v1.value\n        self.deployed_at = datetime.now().isoformat()\n    \n    def save(self, model_dir: str = \"models/\"):\n        \"\"\"Save complete pipeline.\"\"\"\n        joblib.dump(self.model, f\"{model_dir}/energy_model_{self.version}.pkl\")\n        joblib.dump(self.feature_engineer, f\"{model_dir}/feature_engineer_{self.version}.pkl\")\n        \n        metadata = {\n            'version': self.version,\n            'deployed_at': self.deployed_at,\n            'performance_baseline': self.performance_baseline,\n            'feature_names': self.feature_engineer.feature_names\n        }\n        \n        with open(f\"{model_dir}/metadata_{self.version}.json\", 'w') as f:\n            json.dump(metadata, f, indent=2)\n        \n        logger.info(f\"Pipeline saved: {model_dir}\")\n    \n    def predict_batch(self, new_data: pd.DataFrame) -> np.ndarray:\n        \"\"\"Make predictions on new data.\"\"\"\n        new_data_featured = self.feature_engineer.engineer_all_features()\n        X = new_data_featured[self.feature_engineer.feature_names].values\n        predictions = self.model.predict(X)\n        return predictions\n\n# Deploy pipeline\npipeline = ProductionPipeline(best_model, engineer, performance)\npipeline.save()\nprint(f\"Pipeline {pipeline.version} deployed successfully\")"
        ]
      ]
    },
    {
