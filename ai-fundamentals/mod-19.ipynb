        [
          "python",
          "class ModelEvaluator:\n    def __init__(self, model, X_test: np.ndarray, y_test: np.ndarray):\n        self.model = model\n        self.X_test = X_test\n        self.y_test = y_test\n        self.y_pred = model.predict(X_test)\n        self.performance_baseline = {}\n    \n    def evaluate(self) -> dict:\n        \"\"\"Compute evaluation metrics.\"\"\"\n        mae = mean_absolute_error(self.y_test, self.y_pred)\n        rmse = np.sqrt(mean_squared_error(self.y_test, self.y_pred))\n        r2 = r2_score(self.y_test, self.y_pred)\n        mape = np.mean(np.abs((self.y_test - self.y_pred) / self.y_test)) * 100\n        \n        self.performance_baseline = {\n            'mae': mae,\n            'rmse': rmse,\n            'r2': r2,\n            'mape': mape\n        }\n        \n        logger.info(f\"Test Performance - MAE: {mae:.2f} MW, RMSE: {rmse:.2f} MW, \"\n                   f\"R\u00b2: {r2:.4f}, MAPE: {mape:.2f}%\")\n        \n        return self.performance_baseline\n    \n    def detect_anomalies(self, threshold: float = 2.0) -> list:\n        \"\"\"Find predictions with high residuals.\"\"\"\n        residuals = np.abs(self.y_test - self.y_pred)\n        residual_mean = residuals.mean()\n        residual_std = residuals.std()\n        \n        anomalies = np.where(residuals > residual_mean + threshold * residual_std)[0]\n        logger.warning(f\"Detected {len(anomalies)} anomalous predictions\")\n        \n        return anomalies\n    \n    def plot_results(self):\n        \"\"\"Visualize predictions vs actuals.\"\"\"\n        plt.figure(figsize=(12, 5))\n        plt.plot(self.y_test[:200], label='Actual Load', alpha=0.7)\n        plt.plot(self.y_pred[:200], label='Predicted Load', alpha=0.7)\n        plt.xlabel('Time (hours)')\n        plt.ylabel('Load (MW)')\n        plt.legend()\n        plt.title('Energy Load Forecast vs Actual')\n        plt.show()\n\nevaluator = ModelEvaluator(best_model, X_test, y_test)\nperformance = evaluator.evaluate()\nanomalies = evaluator.detect_anomalies()"
        ]
      ]
    },
