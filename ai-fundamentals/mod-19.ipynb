        [
          "python",
          "import pandas as pd\nimport numpy as np\nfrom datetime import datetime, timedelta\nimport logging\nfrom typing import Tuple\n\nlogging.basicConfig(level=logging.INFO)\nlogger = logging.getLogger(__name__)\n\nclass DataPipeline:\n    def __init__(self, raw_data_path: str):\n        self.raw_data_path = raw_data_path\n        self.validation_log = []\n    \n    def ingest_data(self) -> pd.DataFrame:\n        \"\"\"Load data from multiple sources and combine.\"\"\"\n        # Simulate ingesting from CSV, database, and API\n        df_csv = pd.read_csv(f\"{self.raw_data_path}/grid_load.csv\")\n        \n        # Create synthetic data for weather and other sources\n        dates = pd.date_range('2023-01-01', periods=len(df_csv), freq='H')\n        df_weather = pd.DataFrame({\n            'timestamp': dates,\n            'temperature': np.random.normal(15, 8, len(df_csv)),\n            'humidity': np.random.normal(60, 15, len(df_csv))\n        })\n        \n        # Merge datasets\n        df_csv['timestamp'] = df_csv['timestamp'].astype('datetime64[ns]')\n        data = df_csv.merge(df_weather, on='timestamp', how='left')\n        \n        logger.info(f\"Ingested {len(data)} records from multiple sources\")\n        return data\n    \n    def validate_data(self, df: pd.DataFrame) -> Tuple[pd.DataFrame, dict]:\n        \"\"\"Validate data quality.\"\"\"\n        validation_report = {\n            'total_rows': len(df),\n            'missing_values': df.isnull().sum().to_dict(),\n            'duplicate_rows': df.duplicated().sum(),\n            'timestamp_range': (df['timestamp'].min(), df['timestamp'].max())\n        }\n        \n        # Check for missing critical columns\n        required_cols = ['timestamp', 'load_mw', 'temperature']\n        missing_cols = [col for col in required_cols if col not in df.columns]\n        if missing_cols:\n            logger.error(f\"Missing columns: {missing_cols}\")\n        \n        # Remove duplicates\n        df_clean = df.drop_duplicates()\n        \n        # Handle missing values\n        df_clean['temperature'].fillna(df_clean['temperature'].mean(), inplace=True)\n        df_clean['humidity'].fillna(df_clean['humidity'].mean(), inplace=True)\n        df_clean['load_mw'].fillna(method='ffill', inplace=True)\n        \n        # Detect outliers\n        load_mean = df_clean['load_mw'].mean()\n        load_std = df_clean['load_mw'].std()\n        outliers = df_clean[(df_clean['load_mw'] < load_mean - 3*load_std) | \n                            (df_clean['load_mw'] > load_mean + 3*load_std)]\n        logger.warning(f\"Found {len(outliers)} potential outliers in load data\")\n        \n        logger.info(f\"Validation complete: {validation_report}\")\n        return df_clean, validation_report\n\n# Usage\npipeline = DataPipeline('data/')\nraw_data = pipeline.ingest_data()\nclean_data, report = pipeline.validate_data(raw_data)\nprint(f\"Clean dataset: {clean_data.shape}\")"
        ]
      ]
    },
    {
