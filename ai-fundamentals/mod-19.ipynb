        [
          "python",
          "class ModelMonitor:\n    def __init__(self, performance_baseline: dict):\n        self.performance_baseline = performance_baseline\n        self.threshold_drift = 0.15  # 15% performance degradation triggers alert\n        self.monitoring_log = []\n    \n    def monitor_performance(self, y_actual: np.ndarray, y_pred: np.ndarray) -> dict:\n        \"\"\"Monitor current model performance.\"\"\"\n        current_mae = mean_absolute_error(y_actual, y_pred)\n        mae_drift = (current_mae - self.performance_baseline['mae']) / self.performance_baseline['mae']\n        \n        alert = mae_drift > self.threshold_drift\n        \n        status = {\n            'timestamp': datetime.now().isoformat(),\n            'current_mae': current_mae,\n            'baseline_mae': self.performance_baseline['mae'],\n            'mae_drift_percent': mae_drift * 100,\n            'alert': alert\n        }\n        \n        if alert:\n            logger.error(f\"Performance degradation detected: {mae_drift*100:.2f}% drift\")\n        \n        self.monitoring_log.append(status)\n        return status\n    \n    def should_retrain(self) -> bool:\n        \"\"\"Determine if model should be retrained.\"\"\"\n        if len(self.monitoring_log) < 7:  # Require 7 days of data\n            return False\n        \n        recent_drifts = [log['mae_drift_percent'] for log in self.monitoring_log[-7:]]\n        avg_drift = np.mean(recent_drifts)\n        \n        return avg_drift > self.threshold_drift * 100\n\nmonitor = ModelMonitor(performance)\n\n# Simulate production monitoring\nfor i in range(10):\n    y_pred_sim = y_test + np.random.normal(0, 10, len(y_test))  # Simulated drift\n    status = monitor.monitor_performance(y_test, y_pred_sim)\n    if monitor.should_retrain():\n        logger.warning(\"Retraining triggered by performance degradation\")\n        break\n\nprint(\"Monitoring setup complete\")"
        ]
      ]
    }
