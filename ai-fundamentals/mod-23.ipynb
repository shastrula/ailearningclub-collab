          "python",
          "import torch\nimport torch.nn as nn\nfrom torch.utils.data import DataLoader, TensorDataset\n\n# Train simple interpretable model for demonstration\ntorch.manual_seed(42)\nmodel = nn.Sequential(\n    nn.Linear(2, 8),\n    nn.ReLU(),\n    nn.Linear(8, 1),\n    nn.Sigmoid()\n)\n\n# Generate synthetic data\nX = torch.randn(200, 2)\ny = ((X[:, 0] > 0) & (X[:, 1] > 0)).float().unsqueeze(1)\n\n# Train\noptimizer = torch.optim.Adam(model.parameters(), lr=0.01)\nfor epoch in range(100):\n    logits = model(X)\n    loss = nn.BCELoss()(logits, y)\n    optimizer.zero_grad()\n    loss.backward()\n    optimizer.step()\n\n# Analyze hidden layer representations\nhidden = nn.Sequential(*list(model.children())[:-1])\nactivations = hidden(X)\n\n# Find neurons encoding quadrant membership\nneuron_activations = activations.detach().numpy()\nprint(\"Neuron Activations (sample):\")\nprint(f\"  Neuron responses for 5 samples:\")\nfor i in range(5):\n    print(f\"  Sample {i}: {neuron_activations[i][:4]}\")\n\n# Test interpretation: which neurons activate in specific quadrants\nq1_mask = (X[:, 0] > 0) & (X[:, 1] > 0)\nmean_q1 = neuron_activations[q1_mask].mean(axis=0)\nprint(f\"\\nAverage activation in Q1: {mean_q1[:4]}\")"
        ]
