          "python",
          "from enum import Enum\nfrom datetime import datetime\n\nclass AICapabilityLevel(Enum):\n    NARROW = 1\n    GENERAL_NARROW = 2\n    GENERAL_BROAD = 3\n    SUPERINTELLIGENT = 4\n\nclass AIGovernanceFramework:\n    \"\"\"\n    Framework for graduated governance based on AI capability level.\n    Inspired by biosafety and nuclear security models.\n    \"\"\"\n    \n    def __init__(self):\n        self.regulations = {\n            AICapabilityLevel.NARROW: {\n                'audit_requirement': False,\n                'government_approval': False,\n                'compute_reporting': False,\n                'safety_testing': 'optional'\n            },\n            AICapabilityLevel.GENERAL_NARROW: {\n                'audit_requirement': True,\n                'government_approval': False,\n                'compute_reporting': True,\n                'safety_testing': 'required'\n            },\n            AICapabilityLevel.GENERAL_BROAD: {\n                'audit_requirement': True,\n                'government_approval': True,\n                'compute_reporting': True,\n                'safety_testing': 'extensive'\n            },\n            AICapabilityLevel.SUPERINTELLIGENT: {\n                'audit_requirement': True,\n                'government_approval': 'mandatory_international',\n                'compute_reporting': 'real_time',\n                'safety_testing': 'exhaustive'\n            }\n        }\n    \n    def get_compliance_requirements(self, capability_level):\n        \"\"\"Return compliance requirements for capability level\"\"\"\n        return self.regulations[capability_level]\n    \n    def assess_compliance(self, system_name, capability_level, has_audit, has_testing):\n        \"\"\"Check if system meets governance requirements\"\"\"\n        requirements = self.get_compliance_requirements(capability_level)\n        \n        audit_compliant = has_audit or not requirements['audit_requirement']\n        testing_compliant = has_testing or requirements['safety_testing'] == 'optional'\n        \n        is_compliant = audit_compliant and testing_compliant\n        \n        return {\n            'system': system_name,\n            'capability_level': capability_level.name,\n            'compliant': is_compliant,\n            'timestamp': datetime.now().isoformat(),\n            'gaps': {\n                'audit': not audit_compliant,\n                'testing': not testing_compliant\n            }\n        }\n\n# Usage\ngovernance = AIGovernanceFramework()\n\n# Check compliance for system at different capability levels\nreport = governance.assess_compliance(\n    'GPT-4-variant',\n    AICapabilityLevel.GENERAL_BROAD,\n    has_audit=True,\n    has_testing=True\n)\nprint(f\"Governance Report: {report}\")"
        ]
