          "python",
          "import numpy as np\nfrom scipy.optimize import minimize\n\nclass ValueAlignmentSimulator:\n    \"\"\"Simulate alignment between AI objectives and human values\"\"\"\n    \n    def __init__(self, stated_objective, true_objective):\n        self.stated = stated_objective\n        self.true_objective = true_objective\n    \n    def ai_reward_model(self, action, alpha=0.8):\n        \"\"\"\n        Simulate AI's learned reward (imperfectly aligned).\n        alpha: alignment quality (1.0 = perfect, 0.0 = random)\n        \"\"\"\n        stated_reward = self.stated(action)\n        true_reward = self.true_objective(action)\n        \n        # Imperfect alignment: mix of stated and true rewards\n        learned_reward = alpha * stated_reward + (1 - alpha) * true_reward\n        noise = np.random.normal(0, 0.1)\n        return learned_reward + noise\n    \n    def find_optimal_action(self, alpha=0.8):\n        \"\"\"Find action maximizing AI's reward model\"\"\"\n        def neg_reward(action):\n            return -self.ai_reward_model(np.array([action]), alpha)\n        \n        result = minimize(neg_reward, x0=0.5, bounds=[(0, 1)])\n        return result.x[0]\n    \n    def evaluate_alignment(self, alpha=0.8, n_actions=100):\n        \"\"\"Compare AI's chosen action against true objective\"\"\"\n        actions = np.linspace(0, 1, n_actions)\n        \n        ai_choice = self.find_optimal_action(alpha)\n        true_optimal = actions[np.argmax([self.true_objective(a) for a in actions])]\n        \n        true_reward = self.true_objective(ai_choice)\n        \n        return {\n            'ai_choice': ai_choice,\n            'true_optimal': true_optimal,\n            'misalignment_error': abs(ai_choice - true_optimal),\n            'true_objective_value': true_reward\n        }\n\n# Example: AI trained to maximize user-reported happiness\n# but users may report happiness while ignoring long-term wellbeing\nstated_objective = lambda x: -((x - 0.3) ** 2)  # Stated: simple pleasure\ntrue_objective = lambda x: -((x - 0.7) ** 2)     # Truth: long-term wellbeing\n\nsimulator = ValueAlignmentSimulator(stated_objective, true_objective)\n\nprint(\"Alignment Quality Analysis:\")\nfor alpha in [0.5, 0.7, 0.9]:\n    result = simulator.evaluate_alignment(alpha)\n    print(f\"\\nAlignment (alpha={alpha}):\")\n    print(f\"  AI chose: {result['ai_choice']:.3f}\")\n    print(f\"  Should chose: {result['true_optimal']:.3f}\")\n    print(f\"  True objective achieved: {result['true_objective_value']:.3f}\")"
        ]
      ]
    },
