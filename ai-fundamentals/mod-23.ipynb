          "python",
          "import numpy as np\n\nclass SafetyTestHarness:\n    \"\"\"\n    Test harness to identify reward hacking and misalignment.\n    \"\"\"\n    \n    def __init__(self, true_objective, measured_objective, name=\"\"):\n        self.true_objective = true_objective\n        self.measured_objective = measured_objective\n        self.name = name\n        self.tests = []\n    \n    def run_adversarial_test(self, action_space_size=1000):\n        \"\"\"\n        Search for actions where measured objective diverges from true objective.\n        This simulates an AI finding loopholes.\n        \"\"\"\n        # Generate candidate actions\n        actions = np.random.randn(action_space_size)\n        \n        true_values = np.array([self.true_objective(a) for a in actions])\n        measured_values = np.array([self.measured_objective(a) for a in actions])\n        \n        # Find actions where AI would be rewarded (measured) but shouldn't be (true)\n        divergence = measured_values - true_values\n        max_divergence_idx = np.argmax(divergence)\n        \n        test_result = {\n            'best_adversarial_action': actions[max_divergence_idx],\n            'measured_score': measured_values[max_divergence_idx],\n            'true_score': true_values[max_divergence_idx],\n            'misalignment': divergence[max_divergence_idx],\n            'alignment_risk': 'HIGH' if divergence[max_divergence_idx] > 0.5 else 'LOW'\n        }\n        \n        self.tests.append(test_result)\n        return test_result\n    \n    def alignment_risk_report(self):\n        \"\"\"Summary of alignment risks discovered\"\"\"\n        if not self.tests:\n            return \"No tests run yet\"\n        \n        avg_misalignment = np.mean([t['misalignment'] for t in self.tests])\n        max_misalignment = max([t['misalignment'] for t in self.tests])\n        \n        return {\n            'system': self.name,\n            'avg_misalignment': avg_misalignment,\n            'max_misalignment': max_misalignment,\n            'is_aligned': max_misalignment < 0.3,\n            'recommendation': 'DEPLOY' if max_misalignment < 0.3 else 'DO NOT DEPLOY - NEEDS REDESIGN'\n        }\n\n# Example: Recommendation system maximizing engagement\n# Measured objective: engagement (clicks, time spent)\n# True objective: user wellbeing (balanced information, quality)\n\nmeasured_obj = lambda a: a ** 2  # Engagement reward (no bound)\ntrue_obj = lambda a: -((a - 0.5) ** 2)  # True wellbeing (optimal moderation)\n\nharness = SafetyTestHarness(true_obj, measured_obj, \"Recommendation System\")\nresult = harness.run_adversarial_test()\n\nprint(\"Safety Test Result:\")\nprint(f\"  Misalignment: {result['misalignment']:.3f}\")\nprint(f\"  Risk: {result['alignment_risk']}\")\n\nprint(\"\\nAlignment Risk Report:\")\nreport = harness.alignment_risk_report()\nfor key, val in report.items():\n    print(f\"  {key}: {val}\")"
        ]
      ]
