          "python",
          "# Compare different model complexities\nfig, axes = plt.subplots(1, 3, figsize=(15, 5))\n\nfor idx, depth in enumerate([2, 5, 20]):\n    model = RandomForestClassifier(max_depth=depth, n_estimators=50, random_state=42)\n    \n    train_sizes_abs, train_scores, val_scores = learning_curve(\n        model, X, y, cv=5, train_sizes=np.linspace(0.1, 1.0, 10),\n        scoring='accuracy', n_jobs=-1\n    )\n    \n    train_mean = train_scores.mean(axis=1)\n    val_mean = val_scores.mean(axis=1)\n    \n    ax = axes[idx]\n    ax.plot(train_sizes_abs, train_mean, 'o-', label='Train')\n    ax.plot(train_sizes_abs, val_mean, 's-', label='Validation')\n    ax.set_title(f'Max Depth = {depth}')\n    ax.set_xlabel('Training Set Size')\n    ax.set_ylabel('Accuracy')\n    ax.legend()\n    ax.grid()\n\n# plt.tight_layout()\n# plt.show()\n\nprint(\"Depth=2: High bias (underfitting)\")\nprint(\"Depth=5: Balanced\")\nprint(\"Depth=20: High variance (overfitting)\")"
