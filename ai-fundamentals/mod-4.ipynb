          "python",
          "from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\n\n# Example predictions\ny_actual = np.array([10, 20, 30, 40, 50])\ny_pred_good = np.array([11, 19, 31, 39, 51])\ny_pred_bad = np.array([15, 25, 25, 45, 48])\n\n# Calculate metrics\nfor label, y_pred in [(\"Good model\", y_pred_good), (\"Bad model\", y_pred_bad)]:\n    mse = mean_squared_error(y_actual, y_pred)\n    rmse = np.sqrt(mse)\n    mae = mean_absolute_error(y_actual, y_pred)\n    r2 = r2_score(y_actual, y_pred)\n    \n    print(f\"\\n{label}:\")\n    print(f\"  MSE: {mse:.4f}\")\n    print(f\"  RMSE: {rmse:.4f}\")\n    print(f\"  MAE: {mae:.4f}\")\n    print(f\"  R\u00b2: {r2:.4f}\")"
        ]
