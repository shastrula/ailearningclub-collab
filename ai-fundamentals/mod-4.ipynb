      "source": [
        [
          "python",
          "# Implement gradient descent for linear regression\nclass LinearRegressionGD:\n    def __init__(self, learning_rate=0.01, iterations=1000):\n        self.lr = learning_rate\n        self.iters = iterations\n        self.costs = []\n        self.coef = None\n        self.intercept = None\n    \n    def fit(self, X, y):\n        n_samples, n_features = X.shape\n        \n        # Initialize coefficients\n        self.coef = np.zeros(n_features)\n        self.intercept = 0\n        \n        # Gradient descent\n        for _ in range(self.iters):\n            # Predictions\n            y_pred = np.dot(X, self.coef) + self.intercept\n            \n            # Error\n            error = y_pred - y\n            \n            # Gradients\n            grad_coef = (2/n_samples) * np.dot(X.T, error)\n            grad_intercept = (2/n_samples) * np.sum(error)\n            \n            # Update coefficients\n            self.coef -= self.lr * grad_coef\n            self.intercept -= self.lr * grad_intercept\n            \n            # Track cost (MSE)\n            cost = np.mean(error**2)\n            self.costs.append(cost)\n    \n    def predict(self, X):\n        return np.dot(X, self.coef) + self.intercept\n\n# Test gradient descent\nX = np.array([1, 2, 3, 4, 5, 6]).reshape(-1, 1)\ny = 2.5 * X.ravel() + 1 + np.random.randn(6) * 0.5\n\nmodel_gd = LinearRegressionGD(learning_rate=0.01, iterations=1000)\nmodel_gd.fit(X, y)\n\ny_pred_gd = model_gd.predict(X)\nr2_gd = r2_score(y, y_pred_gd)\n\nprint(f\"Gradient Descent: Coefficient={model_gd.coef[0]:.4f}, \"\n      f\"Intercept={model_gd.intercept:.4f}, R\u00b2={r2_gd:.4f}\")\nprint(f\"Final cost: {model_gd.costs[-1]:.4f}\")"
        ]
      ]
    },
