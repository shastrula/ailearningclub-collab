          "python",
          "# For imbalanced data, adjust class weights\nfrom sklearn.utils.class_weight import compute_class_weight\n\nweights = compute_class_weight('balanced', \n                               classes=np.unique(y_train), \n                               y=y_train)\nclass_weight_dict = {0: weights[0], 1: weights[1]}\nprint(f\"Class weights: {class_weight_dict}\")\n\n# Retrain with class weights\nrf_balanced = RandomForestClassifier(n_estimators=100, max_depth=20, \n                                     class_weight=class_weight_dict, random_state=42)\nrf_balanced.fit(X_train, y_train)\n\nauc_balanced = roc_auc_score(y_test, rf_balanced.predict_proba(X_test)[:, 1])\nprint(f\"AUC with class weights: {auc_balanced:.4f}\")"
