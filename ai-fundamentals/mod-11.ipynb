          "python",
          "# Time series forecasting\nfrom sklearn.preprocessing import MinMaxScaler\n\n# Generate synthetic time series\nnp.random.seed(42)\nt = np.arange(0, 100, 0.1)\nseries = np.sin(t) + 0.1 * np.random.randn(len(t))\n\n# Normalize\nscaler = MinMaxScaler(feature_range=(0, 1))\nseries_scaled = scaler.fit_transform(series.reshape(-1, 1))\n\n# Create sequences\nlookback = 20\nX_ts = []\ny_ts = []\n\nfor i in range(lookback, len(series_scaled)):\n    X_ts.append(series_scaled[i-lookback:i, 0])\n    y_ts.append(series_scaled[i, 0])\n\nX_ts = np.array(X_ts).reshape(-1, lookback, 1)\ny_ts = np.array(y_ts)\n\n# Split train/test\nsplit = int(0.8 * len(X_ts))\nX_train, X_test = X_ts[:split], X_ts[split:]\ny_train, y_test = y_ts[:split], y_ts[split:]\n\n# Build LSTM for forecasting\nmodel = keras.Sequential([\n    layers.LSTM(32, return_sequences=True, input_shape=(lookback, 1)),\n    layers.LSTM(16, return_sequences=False),\n    layers.Dense(1)\n])\n\nmodel.compile(optimizer='adam', loss='mse')\nmodel.fit(X_train, y_train, epochs=20, batch_size=16, verbose=0)\n\n# Predict\ntrain_pred = model.predict(X_train, verbose=0)\ntest_pred = model.predict(X_test, verbose=0)\n\n# Inverse transform to original scale\ntrain_pred_orig = scaler.inverse_transform(train_pred)\ntest_pred_orig = scaler.inverse_transform(test_pred)\n\n# Plot\nplt.figure(figsize=(14, 6))\nplt.plot(series, label='Original Series', alpha=0.7)\nplt.plot(range(lookback, lookback+len(train_pred)), train_pred_orig, \n         label='Train Prediction', alpha=0.7)\nplt.plot(range(lookback+len(train_pred), len(series)), test_pred_orig, \n         label='Test Prediction', alpha=0.7)\nplt.xlabel('Time')\nplt.ylabel('Value')\nplt.title('Time Series Forecasting with LSTM')\nplt.legend()\nplt.grid(alpha=0.3)\nplt.show()\n\n# Calculate MSE\nfrom sklearn.metrics import mean_squared_error\nmse = mean_squared_error(y_test, test_pred)\nprint(f\"Test MSE: {mse:.6f}\")"
