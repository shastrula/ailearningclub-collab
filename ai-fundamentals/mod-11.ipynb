        [
          "python",
          "import tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers\nimport numpy as np\n\n# Sample text for character-level language model\ntext = \"\"\"To be, or not to be, that is the question:\nWhether 'tis nobler in the mind to suffer\nThe slings and arrows of outrageous fortune,\nOr to take arms against a sea of troubles\"\"\"\n\n# Convert text to integers\nunique_chars = sorted(set(text))\nchar_to_idx = {c: i for i, c in enumerate(unique_chars)}\nidx_to_char = {i: c for i, c in enumerate(unique_chars)}\nencoded_text = [char_to_idx[c] for c in text]\n\n# Create sequences\nseq_length = 50\nsequences = []\ntargets = []\n\nfor i in range(len(encoded_text) - seq_length):\n    sequences.append(encoded_text[i:i+seq_length])\n    targets.append(encoded_text[i+seq_length])\n\nX = np.array(sequences)\ny = np.array(targets)\n\n# Build character-level RNN\nmodel = keras.Sequential([\n    layers.Embedding(len(unique_chars), 64, input_length=seq_length),\n    layers.LSTM(128, return_sequences=False),  # Single LSTM layer\n    layers.Dense(len(unique_chars), activation='softmax')\n])\n\nmodel.compile(\n    optimizer='adam',\n    loss='sparse_categorical_crossentropy',\n    metrics=['accuracy']\n)\n\n# Train (limited data for demo)\nhistory = model.fit(X, y, epochs=50, batch_size=16, verbose=0)\n\n# Generate text\ndef generate_text(seed_sequence, length=100):\n    current = seed_sequence\n    generated = seed_sequence.copy()\n    \n    for _ in range(length):\n        # Predict next character\n        prediction = model.predict(current.reshape(1, -1), verbose=0)\n        next_idx = np.argmax(prediction)\n        generated.append(next_idx)\n        \n        # Update current (shift sequence, add new char)\n        current = np.array(generated[-seq_length:])\n    \n    return ''.join(idx_to_char[i] for i in generated)\n\n# Generate\nseed = encoded_text[:seq_length]\ngenerated_text = generate_text(seed)\nprint(\"Generated text:\")\nprint(generated_text)"
        ]
      ]
