          "python",
          "from sklearn.feature_extraction.text import CountVectorizer\nimport numpy as np\n\ndocuments = [\n    \"Machine learning is fascinating\",\n    \"Deep learning powers artificial intelligence\",\n    \"Natural language processing is amazing\",\n    \"Machine learning and deep learning are related\"\n]\n\n# Create BoW vectorizer\nvectorizer = CountVectorizer(lowercase=True, stop_words='english')\nbow_matrix = vectorizer.fit_transform(documents)\n\n# Get vocabulary and feature names\nvocab = vectorizer.get_feature_names_out()\nprint(\"Vocabulary:\", vocab)\nprint(\"\\nBoW Matrix:\")\nprint(bow_matrix.toarray())\n\n# Examine a specific document's representation\nprint(\"\\nDocument 0 - Bag of Words representation:\")\ndoc_bow = bow_matrix[0].toarray()[0]\nfor word, count in zip(vocab, doc_bow):\n    if count > 0:\n        print(f\"  {word}: {count}\")"
        ]
