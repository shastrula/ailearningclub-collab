          "python",
          "from gensim.models import Word2Vec\nimport numpy as np\n\n# Sample corpus\ncorpus = [\n    ['machine', 'learning', 'algorithm'],\n    ['deep', 'learning', 'neural', 'network'],\n    ['natural', 'language', 'processing'],\n    ['machine', 'learning', 'prediction'],\n    ['neural', 'network', 'training'],\n    ['text', 'analysis', 'nlp']\n]\n\n# Train Word2Vec model\nmodel = Word2Vec(sentences=corpus, vector_size=100, window=3, min_count=1, epochs=100)\n\n# Get word vector\nvector = model.wv['machine']\nprint(\"Vector for 'machine' (first 10 dims):\", vector[:10])\nprint(\"Vector size:\", len(vector))\n\n# Find similar words\nprint(\"\\nWords similar to 'learning':\")\nfor word, similarity in model.wv.most_similar('learning', topn=3):\n    print(f\"  {word}: {similarity:.4f}\")\n\n# Word analogy: king - man + woman = queen\nprint(\"\\nWord analogy results:\")\ntry:\n    result = model.wv.most_similar(positive=['learning', 'network'], negative=['training'], topn=1)\n    print(f\"  learning + network - training \u2248 {result[0][0]}\")\nexcept:\n    print(\"  Insufficient data for this analogy\")"
        ]
      ]
