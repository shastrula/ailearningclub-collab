          "python",
          "from sklearn.feature_extraction.text import TfidfVectorizer\n\ndocuments = [\n    \"Machine learning is a subset of artificial intelligence\",\n    \"Deep learning uses neural networks\",\n    \"Natural language processing analyzes text\",\n    \"Machine learning enables predictive analytics\",\n    \"Artificial intelligence is transforming industries\"\n]\n\n# Create TF-IDF vectorizer\ntfidf = TfidfVectorizer(lowercase=True, stop_words='english', max_features=15)\ntfidf_matrix = tfidf.fit_transform(documents)\n\n# Get feature names\nfeatures = tfidf.get_feature_names_out()\nprint(\"Features:\", features)\n\n# Examine TF-IDF scores for documents\nprint(\"\\nTF-IDF Scores for Document 0:\")\ndoc_tfidf = tfidf_matrix[0].toarray()[0]\nfor feature, score in zip(features, doc_tfidf):\n    if score > 0:\n        print(f\"  {feature}: {score:.4f}\")\n\n# Find most important terms\nprint(\"\\nMost important terms across all documents:\")\nmean_tfidf = tfidf_matrix.mean(axis=0).A1\ntop_indices = np.argsort(mean_tfidf)[-5:][::-1]\nfor idx in top_indices:\n    print(f\"  {features[idx]}: {mean_tfidf[idx]:.4f}\")"
        ]
      ]
    },
