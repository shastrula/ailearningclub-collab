      "source": [
        [
          "python",
          "# Install umap-learn if needed: pip install umap-learn\ntry:\n    from umap import UMAP\nexcept ImportError:\n    print(\"UMAP not installed. Install with: pip install umap-learn\")\n    UMAP = None\n\nif UMAP:\n    # Apply UMAP\n    umap = UMAP(n_components=2, n_neighbors=15, min_dist=0.1, random_state=42)\n    X_umap = umap.fit_transform(X_normalized)\n    \n    # Compare all three methods\n    fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n    \n    # PCA\n    axes[0].scatter(X_pca[:, 0], X_pca[:, 1], c=digits.target, cmap='tab10', s=30, alpha=0.7)\n    axes[0].set_title(f'PCA ({pca.explained_variance_ratio_.sum():.1%} variance)')\n    axes[0].grid(alpha=0.3)\n    \n    # t-SNE\n    axes[1].scatter(X_tsne[:, 0], X_tsne[:, 1], c=digits.target, cmap='tab10', s=30, alpha=0.7)\n    axes[1].set_title('t-SNE (Local Structure)')\n    axes[1].grid(alpha=0.3)\n    \n    # UMAP\n    axes[2].scatter(X_umap[:, 0], X_umap[:, 1], c=digits.target, cmap='tab10', s=30, alpha=0.7)\n    axes[2].set_title('UMAP (Balanced Structure)')\n    axes[2].grid(alpha=0.3)\n    \n    plt.tight_layout()\n    plt.show()"
        ]
      ]
