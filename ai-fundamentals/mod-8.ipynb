      "source": [
        [
          "python",
          "import numpy as np\nfrom sklearn.decomposition import PCA\nfrom sklearn.datasets import load_iris\nfrom sklearn.preprocessing import StandardScaler\nimport matplotlib.pyplot as plt\n\n# Load iris dataset (4 features, 150 samples)\niris = load_iris()\nX = iris.data\n\n# Standardize features (crucial for PCA)\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\n# Apply PCA\npca = PCA()\npca.fit(X_scaled)\n\n# Calculate cumulative explained variance\ncumsum_var = np.cumsum(pca.explained_variance_ratio_)\n\n# Plot explained variance\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n# Scree plot\naxes[0].bar(range(1, 5), pca.explained_variance_ratio_)\naxes[0].set_xlabel('Principal Component')\naxes[0].set_ylabel('Explained Variance Ratio')\naxes[0].set_title('Scree Plot: Variance Explained by Each PC')\naxes[0].set_xticks(range(1, 5))\n\n# Cumulative explained variance\naxes[1].plot(range(1, 5), cumsum_var, 'bo-', linewidth=2, markersize=8)\naxes[1].axhline(y=0.95, c='r', linestyle='--', label='95% threshold')\naxes[1].set_xlabel('Number of Components')\naxes[1].set_ylabel('Cumulative Explained Variance')\naxes[1].set_title('Cumulative Explained Variance')\naxes[1].set_xticks(range(1, 5))\naxes[1].legend()\naxes[1].grid(alpha=0.3)\n\nplt.tight_layout()\nplt.show()\n\nprint(f\"Explained variance ratio: {pca.explained_variance_ratio_}\")\nprint(f\"Components needed for 95% variance: {np.argmax(cumsum_var >= 0.95) + 1}\")\n\n# Project to 2D for visualization\npca_2d = PCA(n_components=2)\nX_pca = pca_2d.fit_transform(X_scaled)\n\nplt.figure(figsize=(10, 6))\nscatter = plt.scatter(X_pca[:, 0], X_pca[:, 1], c=iris.target, cmap='viridis', s=50, alpha=0.7)\nplt.xlabel(f'PC1 ({pca_2d.explained_variance_ratio_[0]:.1%} variance)')\nplt.ylabel(f'PC2 ({pca_2d.explained_variance_ratio_[1]:.1%} variance)')\nplt.title('PCA Projection of Iris Dataset to 2D')\nplt.colorbar(scatter, label='Species')\nplt.grid(alpha=0.3)\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.manifold import TSNE\nfrom sklearn.datasets import load_digits\n\n# Load digits dataset (8x8 images, 1797 samples)\ndigits = load_digits()\nX = digits.data\n\n# Normalize data\nX_normalized = (X - X.mean()) / X.std()\n\n# Apply t-SNE (takes longer than PCA)\ntsne = TSNE(n_components=2, random_state=42, perplexity=30, n_iter=1000)\nX_tsne = tsne.fit_transform(X_normalized)\n\n# Visualize\nplt.figure(figsize=(12, 8))\nscatter = plt.scatter(X_tsne[:, 0], X_tsne[:, 1], c=digits.target, \n                     cmap='tab10', s=30, alpha=0.7, edgecolors='black', linewidth=0.5)\nplt.xlabel('t-SNE Component 1')\nplt.ylabel('t-SNE Component 2')\nplt.title('t-SNE Visualization of Handwritten Digits')\nplt.colorbar(scatter, label='Digit')\nplt.grid(alpha=0.3)\nplt.show()\n\n# Compare with PCA\npca = PCA(n_components=2)\nX_pca = pca.fit_transform(X_normalized)\n\nfig, axes = plt.subplots(1, 2, figsize=(14, 6))\n\naxes[0].scatter(X_pca[:, 0], X_pca[:, 1], c=digits.target, cmap='tab10', s=30, alpha=0.7)\naxes[0].set_title(f'PCA Projection ({pca.explained_variance_ratio_.sum():.1%} variance)')\naxes[0].grid(alpha=0.3)\n\naxes[1].scatter(X_tsne[:, 0], X_tsne[:, 1], c=digits.target, cmap='tab10', s=30, alpha=0.7)\naxes[1].set_title('t-SNE Projection')\naxes[1].grid(alpha=0.3)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
