        [
          "python",
          "import pandas as pd\nimport numpy as np\nfrom sklearn.model_selection import train_test_split, cross_val_score\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import classification_report, confusion_matrix\nimport shap\n\n# Step 1: Load and explore data\nnp.random.seed(42)\nn_samples = 1000\ndata = {\n    'contract_length': np.random.choice([1, 2, 3], n_samples),\n    'monthly_charges': np.random.uniform(20, 150, n_samples),\n    'tenure_months': np.random.uniform(0, 72, n_samples),\n    'age': np.random.uniform(18, 75, n_samples),\n    'internet_service': np.random.choice(['Fiber', 'DSL', 'None'], n_samples),\n}\nX = pd.DataFrame(data)\n\n# Churn probability depends on tenure and charges\nchurn_prob = 0.9 - (X['tenure_months'] / 72) * 0.6 + (X['monthly_charges'] / 150) * 0.3\ny = (np.random.random(n_samples) < churn_prob).astype(int)\n\n# Step 2: Prepare data (encode categorical, scale)\nX_encoded = pd.get_dummies(X, columns=['internet_service'], drop_first=True)\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X_encoded)\n\n# Step 3: Split and train\nX_train, X_test, y_train, y_test = train_test_split(\n    X_scaled, y, test_size=0.2, random_state=42, stratify=y\n)\n\nmodel = RandomForestClassifier(n_estimators=100, max_depth=10, random_state=42)\nmodel.fit(X_train, y_train)\n\n# Step 4: Evaluate\ny_pred = model.predict(X_test)\nprint(\"Classification Report:\")\nprint(classification_report(y_test, y_pred))\n\n# Step 5: Explainability (SHAP)\nexplainer = shap.TreeExplainer(model)\nshap_values = explainer.shap_values(X_test)\n\nprint(\"\\nTop 3 features by importance (mean |SHAP value|):\")\nmean_abs_shap = np.abs(shap_values[1]).mean(axis=0)  # Class 1 (churn)\nfeature_names = X_encoded.columns\nimportance = sorted(zip(feature_names, mean_abs_shap), key=lambda x: x[1], reverse=True)\nfor feat, val in importance[:3]:\n    print(f\"  {feat}: {val:.4f}\")\n\n# Step 6: Fairness assessment\n# Check performance across age groups\nage_original = X['age'].values\nage_groups = np.digitize(age_original, bins=[30, 50, 70])\n\nprint(\"\\nFairness Assessment - Performance by Age Group:\")\nfor group in np.unique(age_groups):\n    mask = age_groups == group\n    acc = (y_pred[mask] == y_test.values[mask]).mean()\n    churn_rate = y_test.values[mask].mean()\n    print(f\"  Age group {group}: Accuracy={acc:.3f}, Churn rate={churn_rate:.3f}\")\n\n# Step 7: Recommendations\nrecommendations = [\n    \"1. High SHAP values indicate tenure and monthly charges drive churn predictions\",\n    \"2. Monitor fairness across age groups; implement interventions equitably\",\n    \"3. Require human review for customers with borderline churn probabilities\",\n    \"4. Document model decisions for explainability to customers\",\n    \"5. Implement privacy protections for customer data used in model\",\n]\n\nprint(\"\\nResponsible AI Recommendations:\")\nfor rec in recommendations:\n    print(f\"  {rec}\")"
        ]
      ]
