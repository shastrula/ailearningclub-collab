          "python",
          "# Conceptual example (full implementation requires deep learning framework)\nimport numpy as np\n\nclass TransferLearningModel:\n    def __init__(self, pretrained_weights, freeze_until_layer=10):\n        \"\"\"\n        Args:\n            pretrained_weights: Weights from model trained on large dataset\n            freeze_until_layer: Layers to keep frozen (0-10), others trainable\n        \"\"\"\n        self.weights = pretrained_weights.copy()\n        self.freeze_until = freeze_until_layer\n    \n    def fine_tune(self, X_train, y_train, learning_rate=0.0001, epochs=10):\n        \"\"\"\n        Fine-tune on target task with low learning rate\n        \n        Only layers after freeze_until are updated significantly\n        \"\"\"\n        print(f\"Fine-tuning with learning rate: {learning_rate}\")\n        print(f\"Frozen layers: 0-{self.freeze_until}\")\n        print(f\"Trainable layers: {self.freeze_until+1}+\")\n        \n        for epoch in range(epochs):\n            # Simulate training: loss decreases\n            loss = 0.5 * np.exp(-epoch / 3)  # Exponential decay\n            if epoch % 3 == 0:\n                print(f\"  Epoch {epoch+1}: loss = {loss:.4f}\")\n        \n        return self.weights\n\n# Example usage\npretrained_weights = np.random.randn(1000, 100)  # Large model weights\nmodel = TransferLearningModel(pretrained_weights, freeze_until_layer=8)\n\n# Simulate target dataset\nX_train_target = np.random.randn(100, 100)  # Small dataset\ny_train_target = np.random.randint(0, 10, 100)\n\n# Fine-tune on target task\nfine_tuned_weights = model.fine_tune(X_train_target, y_train_target, learning_rate=0.0001)\nprint(\"\\nFine-tuning complete. Model adapted to target task.\")"
        ]
      ]
    },
