          "python",
          "import numpy as np\nfrom sklearn.preprocessing import StandardScaler\n\nclass PrototypicalNetwork:\n    \"\"\"\n    Few-shot learning via prototypical networks\n    Learn to classify new classes given few examples\n    \"\"\"\n    def __init__(self):\n        self.prototypes = {}\n    \n    def fit(self, X, y, n_way=3, n_shot=5):\n        \"\"\"\n        Train on few examples per class\n        n_way: number of classes\n        n_shot: number of examples per class\n        \"\"\"\n        self.prototypes = {}\n        \n        for class_id in np.unique(y):\n            class_mask = y == class_id\n            class_examples = X[class_mask]\n            \n            # Prototype = mean of class examples\n            prototype = class_examples.mean(axis=0)\n            self.prototypes[class_id] = prototype\n    \n    def predict(self, X):\n        \"\"\"Classify by distance to prototypes\"\"\"\n        distances = np.zeros((X.shape[0], len(self.prototypes)))\n        \n        for i, class_id in enumerate(self.prototypes):\n            prototype = self.prototypes[class_id]\n            # Euclidean distance\n            distances[:, i] = np.linalg.norm(X - prototype, axis=1)\n        \n        # Closest prototype\n        return np.argmin(distances, axis=1)\n\n# Few-shot learning example\nfrom sklearn.datasets import load_iris\n\niris = load_iris()\nX_all = iris.data\ny_all = iris.target\n\n# Simulate: we only have 2 examples per class\nfew_shot_X = []\nfew_shot_y = []\n\nfor class_id in [0, 1, 2]:\n    class_indices = np.where(y_all == class_id)[0]\n    sampled = np.random.choice(class_indices, 2, replace=False)\n    few_shot_X.extend(X_all[sampled])\n    few_shot_y.extend([class_id, class_id])\n\nfew_shot_X = np.array(few_shot_X)\nfew_shot_y = np.array(few_shot_y)\n\n# Train on few examples\nmodel = PrototypicalNetwork()\nmodel.fit(few_shot_X, few_shot_y)\n\n# Evaluate on held-out set\ntest_mask = ~np.isin(range(len(X_all)), \n                     np.concatenate([np.where(y_all == c)[0][:2] for c in [0,1,2]]))\nX_test = X_all[test_mask]\ny_test = y_all[test_mask]\n\npredictions = model.predict(X_test)\naccuracy = (predictions == y_test).mean()\n\nprint(f\"Few-shot learning with 2 examples per class:\")\nprint(f\"  Test accuracy: {accuracy:.4f}\")\nprint(f\"  This demonstrates rapid adaptation to new classes\")"
        ]
      ]
