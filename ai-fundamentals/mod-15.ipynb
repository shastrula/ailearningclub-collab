          "python",
          "import numpy as np\n\nclass FederatedLearner:\n    def __init__(self, num_devices=5):\n        self.num_devices = num_devices\n        self.global_weights = np.random.randn(10, 5)  # Shared model weights\n        self.device_data = [\n            np.random.randn(20, 10) for _ in range(num_devices)\n        ]\n    \n    def local_training(self, device_id, epochs=5, learning_rate=0.01):\n        \"\"\"\n        Device trains on local data without sharing raw data\n        Returns only weight updates, not data\n        \"\"\"\n        local_weights = self.global_weights.copy()\n        local_data = self.device_data[device_id]\n        \n        for epoch in range(epochs):\n            # Simulate training\n            loss = 1.0 / (epoch + 1)\n        \n        # Return only updates (weight changes), not raw data\n        weight_update = local_weights - self.global_weights\n        return weight_update\n    \n    def aggregate_updates(self, all_updates):\n        \"\"\"\n        Server aggregates updates from all devices\n        Using FedAvg: average weight updates\n        \"\"\"\n        avg_update = np.mean(all_updates, axis=0)\n        self.global_weights += avg_update\n        return self.global_weights\n    \n    def federated_training_round(self):\n        \"\"\"One round of federated training\"\"\"\n        # Devices train locally\n        updates = []\n        for device_id in range(self.num_devices):\n            update = self.local_training(device_id)\n            updates.append(update)\n        \n        # Server aggregates\n        new_weights = self.aggregate_updates(updates)\n        print(f\"Federated round complete. Global weights norm: {np.linalg.norm(new_weights):.4f}\")\n        \n        return new_weights\n\n# Simulate federated learning\nfederated = FederatedLearner(num_devices=5)\nprint(\"Federated Learning Simulation:\")\nprint(f\"Initial global weights norm: {np.linalg.norm(federated.global_weights):.4f}\")\n\nfor round_num in range(3):\n    federated.federated_training_round()\n\nprint(f\"Final global weights norm: {np.linalg.norm(federated.global_weights):.4f}\")\nprint(\"\\nPrivacy preserved: Raw data never left local devices\")"
        ]
      ]
