          "python",
          "import numpy as np\n\nclass SimpleNAS:\n    \"\"\"\n    Simplified Neural Architecture Search\n    Evolves network architectures to maximize accuracy\n    \"\"\"\n    def __init__(self, population_size=10, generations=5):\n        self.pop_size = population_size\n        self.generations = generations\n    \n    def create_random_architecture(self):\n        \"\"\"Random architecture: [num_layers, layer_type, units]\"\"\"\n        num_layers = np.random.randint(2, 6)\n        architecture = {\n            'layers': num_layers,\n            'layer_sizes': [np.random.randint(32, 512, dtype=int) for _ in range(num_layers)],\n            'layer_types': [np.random.choice(['dense', 'conv', 'lstm']) for _ in range(num_layers)]\n        }\n        return architecture\n    \n    def evaluate_architecture(self, architecture):\n        \"\"\"Simulate training and return accuracy\"\"\"\n        num_layers = architecture['layers']\n        total_params = sum(architecture['layer_sizes'])\n        \n        # Simulate: more layers = better (up to a point), more params = slower\n        accuracy = 0.7 + 0.2 * np.tanh(num_layers / 5) - 0.0001 * total_params\n        accuracy = np.clip(accuracy, 0, 1)\n        \n        return accuracy\n    \n    def mutate(self, architecture):\n        \"\"\"Create variation of architecture\"\"\"\n        new_arch = {\n            'layers': architecture['layers'] + np.random.randint(-1, 2),\n            'layer_sizes': [size + np.random.randint(-50, 51) for size in architecture['layer_sizes']],\n            'layer_types': architecture['layer_types'].copy()\n        }\n        new_arch['layers'] = np.clip(new_arch['layers'], 2, 6)\n        return new_arch\n    \n    def search(self):\n        \"\"\"Evolutionary search for best architecture\"\"\"\n        # Initialize population\n        population = [self.create_random_architecture() for _ in range(self.pop_size)]\n        \n        for gen in range(self.generations):\n            # Evaluate all architectures\n            accuracies = [self.evaluate_architecture(arch) for arch in population]\n            \n            # Select top architectures\n            top_indices = np.argsort(accuracies)[-3:]\n            top_architectures = [population[i] for i in top_indices]\n            top_accuracies = [accuracies[i] for i in top_indices]\n            \n            print(f\"Generation {gen+1}: Best accuracy = {max(accuracies):.4f}\")\n            \n            # Create next generation via mutation\n            population = top_architectures + [\n                self.mutate(np.random.choice(top_architectures)) \n                for _ in range(self.pop_size - 3)\n            ]\n        \n        # Return best architecture found\n        best_idx = np.argmax([self.evaluate_architecture(a) for a in population])\n        return population[best_idx], self.evaluate_architecture(population[best_idx])\n\n# Run NAS\nnas = SimpleNAS(population_size=10, generations=5)\nbest_arch, best_acc = nas.search()\n\nprint(f\"\\nBest architecture found:\")\nprint(f\"  Layers: {best_arch['layers']}\")\nprint(f\"  Layer sizes: {best_arch['layer_sizes']}\")\nprint(f\"  Accuracy: {best_acc:.4f}\")"
        ]
