          "python",
          "from sklearn.model_selection import GridSearchCV, RandomizedSearchCV\nfrom sklearn.svm import SVC\nfrom sklearn.datasets import make_classification\nfrom sklearn.preprocessing import StandardScaler\nimport numpy as np\n\n# Create dataset\nX, y = make_classification(n_samples=500, n_features=20, random_state=42)\nscaler = StandardScaler()\nX = scaler.fit_transform(X)\n\n# Grid search: try all combinations\nparam_grid = {\n    'C': [0.1, 1, 10],\n    'kernel': ['linear', 'rbf'],\n    'gamma': ['scale', 'auto'],\n}\n\n# Method 1: Exhaustive Grid Search\nprint(\"Grid Search (exhaustive):\")\ngrid_search = GridSearchCV(SVC(), param_grid, cv=5, n_jobs=-1)\ngrid_search.fit(X, y)\n\nprint(f\"  Best parameters: {grid_search.best_params_}\")\nprint(f\"  Best CV score: {grid_search.best_score_:.4f}\")\nprint(f\"  Total combinations tried: {len(grid_search.cv_results_['params'])}\")\n\n# Method 2: Random Search (more efficient for large spaces)\nprint(\"\\nRandom Search:\")\nrandom_search = RandomizedSearchCV(\n    SVC(), param_grid, n_iter=6, cv=5, random_state=42, n_jobs=-1\n)\nrandom_search.fit(X, y)\n\nprint(f\"  Best parameters: {random_search.best_params_}\")\nprint(f\"  Best CV score: {random_search.best_score_:.4f}\")\nprint(f\"  Total combinations tried: {len(random_search.cv_results_['params'])}\")\n\n# Compare efficiency\nprint(f\"\\nGrid Search: {len(grid_search.cv_results_['params'])} combinations\")\nprint(f\"Random Search: {len(random_search.cv_results_['params'])} combinations\")\nprint(f\"Search space contains: {np.prod([len(v) for v in param_grid.values()])} possible combinations\")"
        ]
      ]
