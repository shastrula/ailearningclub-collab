          "python",
          "def monitor_model_drift(y_test_recent, y_pred_recent, y_test_baseline, y_pred_baseline):\n    \"\"\"\n    Compare model performance on recent vs baseline data\n    \"\"\"\n    from sklearn.metrics import accuracy_score\n    \n    acc_recent = accuracy_score(y_test_recent, y_pred_recent)\n    acc_baseline = accuracy_score(y_test_baseline, y_pred_baseline)\n    \n    performance_drop = acc_baseline - acc_recent\n    \n    print(f\"Model Monitoring Report:\")\n    print(f\"  Baseline accuracy: {acc_baseline:.4f}\")\n    print(f\"  Recent accuracy:   {acc_recent:.4f}\")\n    print(f\"  Performance drop:  {performance_drop:.4f}\")\n    \n    if performance_drop > 0.05:\n        print(f\"  \u26a0\ufe0f  ALERT: Significant drift detected. Recommend retraining.\")\n    \n    return performance_drop"
        ]
      ]
