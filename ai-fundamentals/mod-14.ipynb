          "python",
          "from sklearn.metrics import confusion_matrix, precision_score, recall_score\nimport numpy as np\n\ndef compute_fairness_metrics(y_true, y_pred, group_labels):\n    \"\"\"\n    Compute fairness metrics across demographic groups\n    \n    Args:\n        y_true: Ground truth labels\n        y_pred: Model predictions\n        group_labels: Demographic group for each sample\n    \"\"\"\n    groups = np.unique(group_labels)\n    metrics = {}\n    \n    for group in groups:\n        mask = group_labels == group\n        \n        # Precision: of predicted positives, how many are actually positive\n        precision = precision_score(y_true[mask], y_pred[mask], zero_division=0)\n        \n        # Recall: of actual positives, how many did we predict\n        recall = recall_score(y_true[mask], y_pred[mask], zero_division=0)\n        \n        # False positive rate: of negatives, how many we incorrectly predicted positive\n        tn, fp, fn, tp = confusion_matrix(y_true[mask], y_pred[mask]).ravel()\n        fpr = fp / (fp + tn) if (fp + tn) > 0 else 0\n        \n        # False negative rate: of positives, how many we incorrectly predicted negative\n        fnr = fn / (fn + tp) if (fn + tp) > 0 else 0\n        \n        metrics[str(group)] = {\n            'precision': precision,\n            'recall': recall,\n            'fpr': fpr,\n            'fnr': fnr,\n            'samples': mask.sum()\n        }\n    \n    return metrics\n\n# Example: simulated bias in predictions\nnp.random.seed(42)\nn_samples = 1000\n\n# Create synthetic demographic groups and labels\ngroups = np.random.choice(['GroupA', 'GroupB', 'GroupC'], n_samples)\ny_true = np.random.randint(0, 2, n_samples)\n\n# Simulate biased model: performs worse on GroupB\ny_pred = y_true.copy()\ngroup_b_mask = groups == 'GroupB'\n# Flip 30% of GroupB predictions to introduce bias\nflip_indices = np.random.choice(np.where(group_b_mask)[0], \n                                size=int(0.3 * group_b_mask.sum()), \n                                replace=False)\ny_pred[flip_indices] = 1 - y_pred[flip_indices]\n\n# Compute metrics\nmetrics = compute_fairness_metrics(y_true, y_pred, groups)\n\nprint(\"Fairness Metrics Across Groups:\")\nprint(\"-\" * 60)\nfor group, group_metrics in metrics.items():\n    print(f\"\\n{group}:\")\n    for metric_name, value in group_metrics.items():\n        if metric_name != 'samples':\n            print(f\"  {metric_name:15} {value:.4f}\")\n    print(f\"  {'samples':15} {value['samples']}\")\n\n# Compute disparity ratios (how much does the metric differ across groups)\ngroup_list = list(metrics.keys())\nprint(\"\\n\\nDisparity Ratios (min/max across groups):\")\nprint(\"-\" * 60)\n\nfor metric in ['precision', 'recall', 'fpr', 'fnr']:\n    values = [metrics[g][metric] for g in group_list if metrics[g][metric] > 0]\n    if values:\n        ratio = min(values) / max(values) if max(values) > 0 else 0\n        print(f\"{metric:15} {ratio:.4f} (closer to 1 = more fair)\")"
        ]
