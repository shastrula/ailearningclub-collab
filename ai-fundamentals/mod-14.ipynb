          "python",
          "from sklearn.inspection import permutation_importance\nimport matplotlib.pyplot as plt\n\n# Feature importance via permutation\ndef explain_prediction(model, X, y, feature_names):\n    \"\"\"\n    Compute feature importance showing which features drive predictions\n    \"\"\"\n    importance = permutation_importance(model, X, y, n_repeats=10, random_state=42)\n    \n    # Sort by importance\n    indices = np.argsort(importance.importances_mean)[::-1]\n    \n    print(\"Feature Importance (Top features):\")\n    for idx in indices[:5]:\n        print(f\"  {feature_names[idx]:20} {importance.importances_mean[idx]:.4f}\")\n    \n    # Plot\n    plt.figure(figsize=(10, 6))\n    plt.bar(range(len(indices[:10])), importance.importances_mean[indices[:10]])\n    plt.xticks(range(len(indices[:10])), [feature_names[i] for i in indices[:10]], rotation=45)\n    plt.ylabel('Feature Importance')\n    plt.title('Model Feature Importance')\n    plt.tight_layout()\n    \n    return importance\n\n# Example with iris dataset\nfrom sklearn.datasets import load_iris\nfrom sklearn.ensemble import RandomForestClassifier\n\niris = load_iris()\nX_test, y_test = iris.data[:50], iris.target[:50]\nmodel = RandomForestClassifier(n_estimators=10, random_state=42)\nmodel.fit(iris.data[50:], iris.target[50:])\n\nimportance = explain_prediction(model, X_test, y_test, iris.feature_names)"
        ]
