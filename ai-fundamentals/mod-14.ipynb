          "python",
          "from sklearn.utils.class_weight import compute_sample_weight\n\n# Pre-processing approach: adjust sample weights for underrepresented group\ndef create_fair_sample_weights(y, groups, group_of_interest='GroupB'):\n    \"\"\"\n    Increase weight for underrepresented group to balance training\n    \"\"\"\n    weights = np.ones(len(y))\n    \n    # Increase weight for target group samples\n    target_mask = groups == group_of_interest\n    weights[target_mask] *= 2  # Double weight for this group\n    \n    return weights\n\n# Post-processing: adjust thresholds per group\nclass ThresholdOptimizer:\n    def __init__(self, metric_target='equal_fpr'):\n        self.metric_target = metric_target\n        self.thresholds = {}\n    \n    def fit(self, y_true, y_proba, groups):\n        \"\"\"Find optimal thresholds per group\"\"\"\n        for group in np.unique(groups):\n            mask = groups == group\n            \n            if self.metric_target == 'equal_fpr':\n                # Find threshold that targets specific FPR\n                best_threshold = self._find_threshold_for_fpr(\n                    y_true[mask], y_proba[mask], target_fpr=0.1\n                )\n            \n            self.thresholds[str(group)] = best_threshold\n    \n    def _find_threshold_for_fpr(self, y_true, y_proba, target_fpr):\n        \"\"\"Binary search for threshold achieving target FPR\"\"\"\n        for threshold in np.linspace(0, 1, 100):\n            y_pred = (y_proba >= threshold).astype(int)\n            tn, fp, _, _ = confusion_matrix(y_true, y_pred).ravel()\n            fpr = fp / (fp + tn) if (fp + tn) > 0 else 0\n            \n            if fpr >= target_fpr:\n                return threshold\n        \n        return 0.5\n    \n    def predict(self, y_proba, groups):\n        \"\"\"Apply group-specific thresholds\"\"\"\n        predictions = np.zeros(len(y_proba))\n        \n        for group in np.unique(groups):\n            mask = groups == group\n            threshold = self.thresholds.get(str(group), 0.5)\n            predictions[mask] = (y_proba[mask] >= threshold).astype(int)\n        \n        return predictions"
        ]
      ]
    },
