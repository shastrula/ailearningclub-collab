          "java",
          "// Class definition\npublic class Animal {\n    protected String name;\n    protected int age;\n    \n    public Animal(String name, int age) {\n        this.name = name;\n        this.age = age;\n    }\n    \n    public void speak() {\n        System.out.println(name + \" makes a sound\");\n    }\n}\n\n// Inheritance\npublic class Dog extends Animal {\n    public Dog(String name, int age) {\n        super(name, age);\n    }\n    \n    @Override  // Annotation indicating we override parent method\n    public void speak() {\n        System.out.println(name + \" barks\");\n    }\n}\n\n// Usage\npublic class Main {\n    public static void main(String[] args) {\n        Animal animal = new Dog(\"Buddy\", 3);\n        animal.speak();  // Output: Buddy barks\n        \n        // Polymorphism: same interface, different behavior\n        Animal[] animals = {\n            new Dog(\"Rex\", 2),\n            new Animal(\"Unknown\", 1)\n        };\n        \n        for (Animal a : animals) {\n            a.speak();\n        }\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "import java.util.*;\n\npublic class Collections {\n    public static void main(String[] args) {\n        // List: ordered, indexed\n        List<String> fruits = new ArrayList<>();\n        fruits.add(\"Apple\");\n        fruits.add(\"Banana\");\n        fruits.add(\"Cherry\");\n        System.out.println(fruits.get(0));  // Apple\n        \n        // Set: unique elements, no order\n        Set<Integer> numbers = new HashSet<>();\n        numbers.add(1);\n        numbers.add(2);\n        numbers.add(2);  // Duplicate ignored\n        System.out.println(numbers.size());  // 2\n        \n        // Map: key-value pairs\n        Map<String, Integer> ages = new HashMap<>();\n        ages.put(\"Alice\", 30);\n        ages.put(\"Bob\", 25);\n        System.out.println(ages.get(\"Alice\"));  // 30\n        \n        // Iteration\n        for (String fruit : fruits) {\n            System.out.println(fruit);\n        }\n        \n        for (Map.Entry<String, Integer> entry : ages.entrySet()) {\n            System.out.println(entry.getKey() + \": \" + entry.getValue());\n        }\n    }\n}"
        ]
      ]
    },
