        [
          "python",
          "from prophet import Prophet\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Generate synthetic data with trend, seasonality, noise\nnp.random.seed(42)\ndates = pd.date_range('2020-01-01', periods=365, freq='D')\ntrend = np.linspace(100, 150, 365)\nseasonality = 10 * np.sin(np.arange(365) * 2 * np.pi / 365)\nnoise = np.random.normal(0, 2, 365)\ny = trend + seasonality + noise\n\ndf = pd.DataFrame({'ds': dates, 'y': y})\n\n# Define holidays\nholidays = pd.DataFrame({\n    'holiday': 'Holiday',\n    'ds': pd.to_datetime(['2020-01-01', '2020-12-25']),\n})\n\n# Fit model with custom configuration\nmodel = Prophet(\n    yearly_seasonality=True,\n    weekly_seasonality=False,\n    daily_seasonality=False,\n    changepoint_prior_scale=0.01,\n    seasonality_prior_scale=10.0,\n    holidays=holidays\n)\n\nmodel.fit(df)\n\n# Make future dataframe for 60-day forecast\nfuture = model.make_future_dataframe(periods=60)\nforecast = model.predict(future)\n\n# Extract relevant columns\nresults = forecast[['ds', 'yhat', 'yhat_lower', 'yhat_upper']]\nprint(results.tail(10))\n\n# Plot results\nfig = model.plot(forecast)\nplt.title('Time Series Forecast with Prophet')\nplt.xlabel('Date')\nplt.ylabel('Value')\nplt.show()\n\n# Plot components\nfig = model.plot_components(forecast)\nplt.show()"
        ]
      ]
