      "source": [
        [
          "python",
          "from prophet.diagnostics import cross_validation, performance_metrics\n\n# Cross-validate with rolling window\ncv_results = cross_validation(\n    model,\n    initial='730 days',      # Training period (2 years)\n    period='180 days',       # Retraining frequency\n    horizon='30 days',       # Forecast horizon (30 days ahead)\n    parallel='processes'\n)\n\n# Compute metrics\nmetrics = performance_metrics(cv_results)\nprint(metrics[['horizon', 'mape', 'rmse']].head(10))\n\n# Average metrics by horizon\navg_metrics = metrics.groupby('horizon')[['mape', 'rmse']].mean()\nprint(avg_metrics)"
        ]
