      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\n\n# Create sample time series\nnp.random.seed(42)\ndates = pd.date_range('2023-01-01', periods=365, freq='D')\ntrend = np.linspace(100, 150, 365)\nseasonal = 10 * np.sin(2 * np.pi * np.arange(365) / 365)\nnoise = np.random.normal(0, 3, 365)\nvalues = trend + seasonal + noise\n\nts = pd.Series(values, index=dates)\n\n# Basic analysis\nprint(\"Time Series Analysis:\")\nprint(f\"  Period: {ts.index[0].date()} to {ts.index[-1].date()}\")\nprint(f\"  Mean: {ts.mean():.1f}\")\nprint(f\"  Trend: {ts.iloc[-30:].mean() - ts.iloc[:30].mean():.1f} increase\")\n\n# Moving averages\nma_7 = ts.rolling(7).mean()\nma_30 = ts.rolling(30).mean()\n\n# Simple forecast (last 30-day average)\nforecast = ts.iloc[-30:].mean()\nprint(f\"  Simple forecast (next period): {forecast:.1f}\")\n\n# Decomposition check\nmonthly = ts.resample('M').mean()\nprint(f\"\\nMonthly averages (last 3):\")\nprint(monthly.tail(3))"
        ]
      ]
