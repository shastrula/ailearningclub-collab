          "python",
          "import numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\n# Create non-stationary series\nnp.random.seed(42)\nt = np.arange(0, 100)\ny = 10 + 0.5*t + np.cumsum(np.random.normal(0, 1, 100))\n\n# First differencing\ny_diff1 = np.diff(y)\n\n# Second differencing\ny_diff2 = np.diff(y_diff1)\n\n# Plot\nfig, axes = plt.subplots(3, 1, figsize=(10, 8))\n\naxes[0].plot(y)\naxes[0].set_title('Original Series (Non-Stationary)')\naxes[0].set_ylabel('Value')\n\naxes[1].plot(y_diff1)\naxes[1].set_title('First Difference')\naxes[1].set_ylabel('Change')\n\naxes[2].plot(y_diff2)\naxes[2].set_title('Second Difference')\naxes[2].set_ylabel('Rate of Change')\n\nfor ax in axes:\n    ax.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.show()\n\n# Apply ADF test to each\nfrom statsmodels.tsa.stattools import adfuller\n\nfor series, name in [(y, 'Original'), (y_diff1, 'Diff 1'), (y_diff2, 'Diff 2')]:\n    stat, pvalue, _, _, _, _ = adfuller(series)\n    print(f\"{name}: p-value = {pvalue:.6f}, stationary = {pvalue <= 0.05}\")"
