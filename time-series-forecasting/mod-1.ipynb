          "import numpy as np\nfrom sklearn.preprocessing import StandardScaler\n\n# Create sequences for neural networks\ndef create_sequences(data, seq_length):\n    \"\"\"Convert time series into (X, y) pairs for supervised learning\"\"\"\n    X, y = [], []\n    for i in range(len(data) - seq_length):\n        X.append(data[i:i+seq_length])\n        y.append(data[i+seq_length])\n    return np.array(X), np.array(y)\n\n# Normalize to 0-1 range\nscaler = StandardScaler()\ny_normalized = scaler.fit_transform(y.reshape(-1, 1)).flatten()\n\n# Create sequences of length 12 (12 months to predict next month)\nX, y = create_sequences(y_normalized, seq_length=12)\n\nprint(f\"X shape: {X.shape}\")  # (num_sequences, 12)\nprint(f\"y shape: {y.shape}\")  # (num_sequences,)\n\n# Split train/test\nsplit = int(0.8 * len(X))\nX_train, X_test = X[:split], X[split:]\ny_train, y_test = y[:split], y[split:]"
