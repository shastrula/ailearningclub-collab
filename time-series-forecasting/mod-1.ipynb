          "python",
          "import pandas as pd\nfrom statsmodels.tsa.stattools import adfuller\n\n# Load example data (airline passengers)\ndata = pd.read_csv('airline_passengers.csv')\ny = data['Passengers'].values\n\n# Augmented Dickey-Fuller test for stationarity\nresult = adfuller(y)\n\nprint(f\"ADF Test Statistic: {result[0]:.6f}\")\nprint(f\"P-value: {result[1]:.6f}\")\nprint(f\"Critical Values:\")\nfor key, value in result[4].items():\n    print(f\"  {key}: {value:.3f}\")\n\nif result[1] <= 0.05:\n    print(\"\\nSeries is stationary (reject null hypothesis)\")\nelse:\n    print(\"\\nSeries is non-stationary (fail to reject null hypothesis)\")"
