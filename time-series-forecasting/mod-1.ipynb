      "source": [
        [
          "python",
          "# Simple moving average forecast\nimport pandas as pd\nimport numpy as np\n\ndates = pd.date_range(\"2024-01-01\", periods=100, freq=\"D\")\nts = pd.Series(np.cumsum(np.random.randn(100)) + 100, index=dates)\n\nforecast = ts.rolling(7).mean()\nprint(f\"Last value: {ts.iloc[-1]:.1f}\")\nprint(f\"7-day MA forecast: {forecast.iloc[-1]:.1f}\")"
        ]
      ]
    }
