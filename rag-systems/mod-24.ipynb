        [
          "python",
          "import re\n\ndef chunk_text(text, chunk_size=500):\n    return [text[i:i+chunk_size] for i in range(0, len(text), chunk_size)]\n\ntext = \"This is a long text that needs to be chunked into smaller pieces for processing.\"\nchunks = chunk_text(text)\nprint(chunks)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def rerank_results(results, relevance_scores):\n    ranked_results = sorted(zip(results, relevance_scores), key=lambda x: x[1], reverse=True)\n    return [result for result, score in ranked_results]\n\nresults = [\"result1\", \"result2\", \"result3\"]\nrelevance_scores = [0.8, 0.6, 0.9]\nreranked_results = rerank_results(results, relevance_scores)\nprint(reranked_results)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import pipeline\n\ngenerator = pipeline('text-generation', model='gpt2')\nprompt = 'Once upon a time,'\ngenerated_text = generator(prompt, max_length=50, num_return_sequences=1)\nprint(generated_text)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.feature_extraction.text import TfidfVectorizer\nfrom sentence_transformers import SentenceTransformer\n\n# Keyword search\nvectorizer = TfidfVectorizer()\ncorpus = [\"This is the first document.\", \"This document is the second document.\"]\ntfidf_matrix = vectorizer.fit_transform(corpus)\n\n# Semantic search\nmodel = SentenceTransformer('paraphrase-MiniLM-L6-v2')\nembeddings = model.encode(corpus)\n\ndef hybrid_search(query, tfidf_matrix, embeddings, vectorizer):\n    query_tfidf = vectorizer.transform([query])\n    query_embedding = model.encode([query])\n    \n    # Keyword search\n    keyword_scores = query_tfidf.dot(tfidf_matrix.T).toarray().ravel()\n    \n    # Semantic search\n    semantic_scores = embeddings @ query_embedding.T\n    \n    # Combine scores\n    combined_scores = keyword_scores + semantic_scores.ravel()\n    ranked_results = sorted(range(len(combined_scores)), key=lambda i: combined_scores[i], reverse=True)\n    \n    return [corpus[i] for i in ranked_results]\n\nquery = \"document\"\nresults = hybrid_search(query, tfidf_matrix, embeddings, vectorizer)\nprint(results)"
        ]
      ]
    }
