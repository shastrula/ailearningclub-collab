          "python",
          "from sentence_transformers import CrossEncoder\nimport time\n\nquery = \"What are the benefits of machine learning?\"\ndocuments = [\n    \"ML enables systems to learn from data...\",\n    \"Python is a popular programming language...\",\n    \"Applications include computer vision...\",\n]\n\n# Cross-encoder reranking\nencoder = CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')\n\nstart = time.time()\nscores = encoder.predict([(query, doc) for doc in documents])\nelapsed = time.time() - start\n\nprint(f\"Cross-encoder scores: {scores}\")\nprint(f\"Time: {elapsed*1000:.1f}ms for {len(documents)} documents\")\n\n# Cross-encoders are slower than embeddings but more accurate\n# Embeddings: <1ms for hundreds of docs\n# Cross-encoders: 10-50ms per document depending on length"
        ]
      ]
    },
    {
      "cell_type": "code",
