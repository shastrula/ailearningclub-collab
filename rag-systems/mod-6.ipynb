          "python",
          "# Simple RAG: retrieve context then generate\nfrom sentence_transformers import SentenceTransformer\nimport numpy as np\n\nembedder = SentenceTransformer(\"all-MiniLM-L6-v2\")\ndocs = [\"Python is great for ML\", \"RAG combines retrieval with generation\"]\nembeddings = embedder.encode(docs)\n\nquery = embedder.encode([\"What is RAG?\"])\nscores = np.dot(embeddings, query.T).flatten()\nprint(f\"Most relevant: {docs[scores.argmax()]}\")"
        ]
      ]
    }
