          "python",
          "from sentence_transformers import CrossEncoder, SentenceTransformer\nimport numpy as np\n\n# Stage 1: Fast retrieval using embedding model\nembedding_model = SentenceTransformer('all-MiniLM-L6-v2')\nquery = \"What is machine learning?\"\n\n# Suppose we retrieved 100 candidates via similarity search\ncandidates = [\n    \"Machine learning is a branch of AI...\",\n    \"Python is a programming language...\",\n    \"Supervised learning uses labeled data...\",\n    \"The weather is sunny today...\",\n    \"Deep learning uses neural networks...\",\n]\n\n# Stage 2: Rerank using cross-encoder\ncross_encoder = CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')\nscores = cross_encoder.predict([(query, doc) for doc in candidates])\n\n# Sort by reranking score\nranked = sorted(zip(candidates, scores), key=lambda x: x[1], reverse=True)\n\nprint(\"Reranked results:\")\nfor doc, score in ranked[:3]:\n    print(f\"Score: {score:.3f} | {doc[:50]}...\")"
        ]
      ]
    },
