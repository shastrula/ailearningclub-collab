        [
          "python",
          "from colbert.inference.onnx_colbert import ColBERTInference\n\n# Initialize ColBERT model\ncolbert = ColBERTInference(\"colbert-ir/colbertv2.0\")\n\n# Encode query (token-level embeddings)\nquery_embeddings = colbert.encode_query(\"What is machine learning?\")\n\n# Encode documents\ndocuments = [\n    \"Machine learning enables systems to learn from data...\",\n    \"Python is used for data science...\",\n]\ndoc_embeddings = [colbert.encode_document(doc) for doc in documents]\n\n# Score using late interaction\nscores = colbert.score_batch(query_embeddings, doc_embeddings)\nprint(f\"ColBERT scores: {scores}\")"
        ]
      ]
