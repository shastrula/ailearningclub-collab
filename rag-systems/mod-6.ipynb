          "python",
          "import cohere\n\nco = cohere.Client(api_key=\"YOUR_COHERE_API_KEY\")\n\n# Stage 1: Retrieve candidates (from any search system)\nquery = \"What is machine learning?\"\ndocuments = [\n    \"Machine learning is a branch of AI...\",\n    \"Python is a programming language...\",\n    \"Supervised learning uses labeled data...\",\n    \"Deep learning uses neural networks...\",\n]\n\n# Stage 2: Rerank with Cohere\nresults = co.rerank(\n    model=\"rerank-english-v3.0\",\n    query=query,\n    documents=documents,\n    top_n=2\n)\n\nprint(\"Reranked results:\")\nfor result in results.results:\n    print(f\"Index: {result.index}, Score: {result.relevance_score:.3f}\")\n    print(f\"Document: {documents[result.index][:60]}...\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def reciprocal_rank_fusion(rankings, k=60):\n    \"\"\"\n    Combine multiple rankings using RRF.\n    rankings: list of lists, each inner list is ranked documents\n    Returns: combined ranking with RRF scores\n    \"\"\"\n    scores = {}\n    for rank_list in rankings:\n        for rank, doc in enumerate(rank_list, 1):\n            scores[doc] = scores.get(doc, 0) + 1 / (k + rank)\n    \n    return sorted(scores.items(), key=lambda x: x[1], reverse=True)\n\n# Example: combine BM25 (keyword) and semantic search\nbm25_ranking = [\"doc1\", \"doc3\", \"doc5\", \"doc7\"]\nsemantic_ranking = [\"doc2\", \"doc1\", \"doc4\", \"doc3\"]\n\nfused = reciprocal_rank_fusion([bm25_ranking, semantic_ranking])\nprint(\"Fused ranking:\")\nfor doc, score in fused[:4]:\n    print(f\"{doc}: {score:.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def ndcg(relevant_docs, ranked_docs, k=10):\n    \"\"\"Compute NDCG@k\"\"\"\n    dcg = sum(\n        1 / np.log2(i + 2) \n        for i, doc in enumerate(ranked_docs[:k]) \n        if doc in relevant_docs\n    )\n    idcg = sum(\n        1 / np.log2(i + 2) \n        for i in range(min(k, len(relevant_docs)))\n    )\n    return dcg / idcg if idcg > 0 else 0\n\n# Example\nrelevant = {\"doc1\", \"doc3\", \"doc5\"}\nranked = [\"doc2\", \"doc1\", \"doc4\", \"doc3\"]\nscore = ndcg(relevant, ranked, k=4)\nprint(f\"NDCG@4: {score:.3f}\")"
        ]
      ]
    },
    {
