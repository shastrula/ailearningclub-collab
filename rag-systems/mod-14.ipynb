        [
          "python",
          "import numpy as np\n\n# Sample predictions and ground truth\npredictions = np.array([1, 0, 1, 1, 0])\nground_truth = np.array([1, 0, 1, 0, 0])\n\n# Calculate accuracy\naccuracy = np.mean(predictions == ground_truth)\nprint(f\"Accuracy: {accuracy}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.metrics import precision_score, recall_score\n\n# Sample predictions and ground truth\npredictions = [1, 0, 1, 1, 0]\nground_truth = [1, 0, 1, 0, 0]\n\n# Calculate precision and recall\nprecision = precision_score(ground_truth, predictions)\nrecall = recall_score(ground_truth, predictions)\n\nprint(f\"Precision: {precision}\")\nprint(f\"Recall: {recall}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.metrics import f1_score\n\n# Sample predictions and ground truth\npredictions = [1, 0, 1, 1, 0]\nground_truth = [1, 0, 1, 0, 0]\n\n# Calculate F1 Score\nf1 = f1_score(ground_truth, predictions)\nprint(f\"F1 Score: {f1}\")"
        ]
      ]
    }
