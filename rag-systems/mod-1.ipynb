      "source": [
        [
          "python",
          "from sentence_transformers import SentenceTransformer\n\n# Load an open-source embedding model\nmodel = SentenceTransformer('all-MiniLM-L6-v2')\n\n# Embed some text\ntext1 = \"The cat sat on the mat\"\ntext2 = \"The feline rested on the rug\"\ntext3 = \"Python is a programming language\"\n\nembedding1 = model.encode(text1)\nembedding2 = model.encode(text2)\nembedding3 = model.encode(text3)\n\n# Compute similarity (dot product or cosine distance)\nfrom sklearn.metrics.pairwise import cosine_similarity\nprint(f\"Similarity (text1, text2): {cosine_similarity([embedding1], [embedding2])[0][0]:.3f}\")\nprint(f\"Similarity (text1, text3): {cosine_similarity([embedding1], [embedding3])[0][0]:.3f}\")\n# text1 and text2 are similar (cats/rugs), different from text3 (programming)"
        ]
