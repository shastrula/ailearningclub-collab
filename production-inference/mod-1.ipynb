          "python",
          "# nginx configuration\nupstream ml_backend {\n    server ml1:8000 weight=1;\n    server ml2:8000 weight=1;\n    server ml3:8000 weight=1;\n}\n\nserver {\n    listen 80;\n    \n    location /predict {\n        proxy_pass http://ml_backend;\n        proxy_set_header X-Real-IP $remote_addr;\n    }\n}"
        ]
