        [
          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n\nint main() {\n    FILE *fp;\n    \n    // Open for writing\n    fp = fopen(\"output.txt\", \"w\");\n    if (fp == NULL) {\n        printf(\"Error opening file for writing\\n\");\n        return 1;\n    }\n    fprintf(fp, \"Hello, File I/O!\\n\");\n    fprintf(fp, \"Line 2\\n\");\n    fclose(fp);\n    \n    // Open for reading\n    fp = fopen(\"output.txt\", \"r\");\n    if (fp == NULL) {\n        printf(\"Error opening file for reading\\n\");\n        return 1;\n    }\n    \n    char buffer[100];\n    while (fgets(buffer, sizeof(buffer), fp) != NULL) {\n        printf(\"%s\", buffer);\n    }\n    fclose(fp);\n    \n    // Open for appending\n    fp = fopen(\"output.txt\", \"a\");\n    if (fp == NULL) {\n        printf(\"Error opening file for appending\\n\");\n        return 1;\n    }\n    fprintf(fp, \"Line 3 (appended)\\n\");\n    fclose(fp);\n    \n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\ntypedef struct {\n    char name[50];\n    int age;\n    float salary;\n} Employee;\n\nint main() {\n    FILE *fp;\n    \n    // Write structured data\n    fp = fopen(\"employees.txt\", \"w\");\n    if (fp == NULL) {\n        perror(\"fopen\");\n        return 1;\n    }\n    \n    Employee emp1 = {\"Alice\", 30, 75000.0};\n    Employee emp2 = {\"Bob\", 25, 60000.0};\n    \n    fprintf(fp, \"%s %d %.2f\\n\", emp1.name, emp1.age, emp1.salary);\n    fprintf(fp, \"%s %d %.2f\\n\", emp2.name, emp2.age, emp2.salary);\n    fclose(fp);\n    \n    // Read structured data\n    fp = fopen(\"employees.txt\", \"r\");\n    if (fp == NULL) {\n        perror(\"fopen\");\n        return 1;\n    }\n    \n    Employee emp;\n    while (fscanf(fp, \"%s %d %f\", emp.name, &emp.age, &emp.salary) == 3) {\n        printf(\"Read: %s, %d, %.2f\\n\", emp.name, emp.age, emp.salary);\n    }\n    fclose(fp);\n    \n    return 0;\n}"
        ]
      ]
    },
    {
