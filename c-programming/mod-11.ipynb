        [
          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#define MAX_LINE 1024\n#define MAX_FIELD 256\n\nint parse_csv_line(char *line, char **fields, int max_fields) {\n    int field_count = 0;\n    char *start = line;\n    int in_quotes = 0;\n    \n    for (char *p = line; *p && field_count < max_fields; p++) {\n        if (*p == '\"') {\n            in_quotes = !in_quotes;\n        } else if (*p == ',' && !in_quotes) {\n            *p = '\\0';\n            fields[field_count++] = start;\n            start = p + 1;\n        }\n    }\n    fields[field_count++] = start;\n    return field_count;\n}\n\nint main() {\n    FILE *fp = fopen(\"data.csv\", \"w\");\n    if (fp == NULL) {\n        perror(\"fopen\");\n        return 1;\n    }\n    \n    fprintf(fp, \"Name,Age,City\\n\");\n    fprintf(fp, \"Alice,30,\\\"New York\\\"\\n\");\n    fprintf(fp, \"Bob,25,Boston\\n\");\n    fprintf(fp, \"Carol,28,\\\"Los Angeles\\\"\\n\");\n    fclose(fp);\n    \n    // Read CSV\n    fp = fopen(\"data.csv\", \"r\");\n    if (fp == NULL) {\n        perror(\"fopen\");\n        return 1;\n    }\n    \n    char line[MAX_LINE];\n    char *fields[10];\n    \n    while (fgets(line, MAX_LINE, fp) != NULL) {\n        line[strcspn(line, \"\\n\")] = '\\0';  // Remove newline\n        int count = parse_csv_line(line, fields, 10);\n        \n        printf(\"Row with %d fields: \", count);\n        for (int i = 0; i < count; i++) {\n            printf(\"[%s] \", fields[i]);\n        }\n        printf(\"\\n\");\n    }\n    \n    fclose(fp);\n    return 0;\n}"
        ]
      ]
    },
