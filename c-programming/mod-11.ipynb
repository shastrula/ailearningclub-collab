        [
          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    int id;\n    char name[30];\n    double balance;\n} Account;\n\nint main() {\n    FILE *fp;\n    \n    // Write binary data\n    fp = fopen(\"accounts.bin\", \"wb\");\n    if (fp == NULL) {\n        perror(\"fopen\");\n        return 1;\n    }\n    \n    Account acc1 = {101, \"Alice\", 5000.0};\n    Account acc2 = {102, \"Bob\", 3500.0};\n    \n    fwrite(&acc1, sizeof(Account), 1, fp);\n    fwrite(&acc2, sizeof(Account), 1, fp);\n    fclose(fp);\n    \n    // Read binary data\n    fp = fopen(\"accounts.bin\", \"rb\");\n    if (fp == NULL) {\n        perror(\"fopen\");\n        return 1;\n    }\n    \n    Account acc;\n    size_t count;\n    \n    printf(\"Accounts read from file:\\n\");\n    while ((count = fread(&acc, sizeof(Account), 1, fp)) == 1) {\n        printf(\"ID: %d, Name: %s, Balance: %.2f\\n\", acc.id, acc.name, acc.balance);\n    }\n    \n    if (feof(fp)) {\n        printf(\"Reached end of file\\n\");\n    } else if (ferror(fp)) {\n        printf(\"Error reading file\\n\");\n    }\n    \n    fclose(fp);\n    return 0;\n}"
        ]
      ]
    },
