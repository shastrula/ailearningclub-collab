        [
          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n// Basic C programming concepts\n\n// Struct definition\ntypedef struct {\n    char name[50];\n    int age;\n    float gpa;\n} Student;\n\n// Function with pointer parameter\nvoid print_student(const Student *s) {\n    printf(\"Name: %s, Age: %d, GPA: %.2f\\n\", s->name, s->age, s->gpa);\n}\n\n// Dynamic memory allocation\nStudent* create_student(const char *name, int age, float gpa) {\n    Student *s = (Student*)malloc(sizeof(Student));\n    if (s == NULL) {\n        fprintf(stderr, \"Memory allocation failed\\n\");\n        return NULL;\n    }\n    strncpy(s->name, name, 49);\n    s->age = age;\n    s->gpa = gpa;\n    return s;\n}\n\nint main() {\n    // Stack allocation\n    Student alice = {\"Alice\", 20, 3.8};\n    print_student(&alice);\n    \n    // Heap allocation\n    Student *bob = create_student(\"Bob\", 22, 3.5);\n    if (bob) {\n        print_student(bob);\n        free(bob);  // Always free heap memory!\n    }\n    \n    // Array operations\n    int numbers[] = {5, 2, 8, 1, 9, 3};\n    int n = sizeof(numbers) / sizeof(numbers[0]);\n    \n    int sum = 0;\n    for (int i = 0; i < n; i++) {\n        sum += numbers[i];\n    }\n    printf(\"Sum: %d, Average: %.1f\\n\", sum, (float)sum / n);\n    \n    return 0;\n}"
        ]
      ]
    }
