          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n\nint main() {\n    FILE *fp = fopen(\"seektest.txt\", \"w+\");\n    if (fp == NULL) {\n        perror(\"fopen\");\n        return 1;\n    }\n    \n    fprintf(fp, \"Hello World!\");\n    fflush(fp);  // Force write to disk\n    \n    // Seek to beginning\n    fseek(fp, 0, SEEK_SET);\n    \n    char c;\n    printf(\"Reading from beginning: \");\n    while (fread(&c, 1, 1, fp) == 1) {\n        printf(\"%c\", c);\n    }\n    printf(\"\\n\");\n    \n    // Seek to 6th byte\n    fseek(fp, 6, SEEK_SET);\n    fread(&c, 1, 1, fp);\n    printf(\"Character at position 6: %c\\n\", c);\n    \n    // Seek to end, then back\n    fseek(fp, -1, SEEK_END);\n    fread(&c, 1, 1, fp);\n    printf(\"Last character: %c\\n\", c);\n    \n    fclose(fp);\n    return 0;\n}"
        ]
      ]
    },
    {
