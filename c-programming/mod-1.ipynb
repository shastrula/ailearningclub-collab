          "makefile",
          "CC = gcc\nCFLAGS = -Wall -g -O2\nTARGET = program\nSOURCES = main.c utils.c\n\nOBJECTS = $(SOURCES:.c=.o)\n\n$(TARGET): $(OBJECTS)\n\t$(CC) -o $@ $^\n\n%.o: %.c\n\t$(CC) $(CFLAGS) -c $<\n\nclean:\n\trm -f $(OBJECTS) $(TARGET)\n\n.PHONY: clean"
        ]
