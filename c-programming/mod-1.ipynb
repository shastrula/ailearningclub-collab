        [
          "c",
          "#include <stdio.h>\n\nint main() {\n    int age;\n    char name[50];\n    float height;\n    \n    printf(\"Enter your name: \");\n    scanf(\"%s\", name);  // Note: no & for strings\n    \n    printf(\"Enter your age: \");\n    scanf(\"%d\", &age);  // Note: & for other types\n    \n    printf(\"Enter your height (m): \");\n    scanf(\"%f\", &height);\n    \n    printf(\"Name: %s, Age: %d, Height: %.2f\\n\", name, age, height);\n    \n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n\nint main() {\n    int x = 42;\n    int *ptr = &x;  // ptr points to x\n    \n    printf(\"Value of x: %d\\n\", x);           // 42\n    printf(\"Address of x: %p\\n\", &x);        // 0x...\n    printf(\"Value at ptr: %d\\n\", *ptr);      // 42 (dereference)\n    printf(\"Address in ptr: %p\\n\", ptr);     // 0x...\n    \n    *ptr = 100;  // Change x via pointer\n    printf(\"New x value: %d\\n\", x);          // 100\n    \n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n\nint main() {\n    // Dynamic allocation\n    int *array = (int *)malloc(10 * sizeof(int));\n    \n    for (int i = 0; i < 10; i++) {\n        array[i] = i * 10;\n    }\n    \n    printf(\"array[5] = %d\\n\", array[5]);  // 50\n    \n    free(array);  // Release memory\n    array = NULL; // Good practice: set to NULL after free\n    \n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n// Structure definition\ntypedef struct {\n    char name[50];\n    int age;\n    float salary;\n} Employee;\n\n// Function using pointers\nvoid update_salary(Employee *emp, float new_salary) {\n    emp->salary = new_salary;  // -> dereferences and accesses field\n}\n\nint main() {\n    // Create employee\n    Employee emp = {\"John Doe\", 30, 50000.0};\n    \n    // Modify via function\n    update_salary(&emp, 55000.0);\n    \n    // Write to file\n    FILE *file = fopen(\"employees.dat\", \"wb\");\n    if (file == NULL) {\n        printf(\"Error opening file\\n\");\n        return 1;\n    }\n    \n    fwrite(&emp, sizeof(Employee), 1, file);\n    fclose(file);\n    \n    // Read from file\n    Employee emp2;\n    file = fopen(\"employees.dat\", \"rb\");\n    fread(&emp2, sizeof(Employee), 1, file);\n    fclose(file);\n    \n    printf(\"Read back: %s, age %d, salary %.2f\\n\",\n           emp2.name, emp2.age, emp2.salary);\n    \n    return 0;\n}"
        ]
      ]
