          "c",
          "#include <stdio.h>\n\nint main() {\n    // Integer types\n    int count = 42;\n    short small_number = 10;\n    long large_number = 1000000L;\n    unsigned int positive_only = 50;\n    \n    // Floating point\n    float price = 19.99f;\n    double precise_value = 3.14159265359;\n    \n    // Character (single byte)\n    char letter = 'A';\n    char digit = '5';\n    \n    // Boolean (C99+)\n    #include <stdbool.h>\n    bool flag = true;\n    \n    // Print values\n    printf(\"Integer: %d\\n\", count);\n    printf(\"Long: %ld\\n\", large_number);\n    printf(\"Float: %.2f\\n\", price);\n    printf(\"Double: %.10lf\\n\", precise_value);\n    printf(\"Char: %c\\n\", letter);\n    printf(\"Unsigned: %u\\n\", positive_only);\n    \n    return 0;\n}"
        ]
      ]
    },
