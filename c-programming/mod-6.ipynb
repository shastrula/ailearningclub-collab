          "c",
          "#include <stdio.h>\n\n// Global scope: visible to all functions, persists entire program\nint global_count = 0;\n\nint get_next_id() {\n    // Static function-scope variable: persists between calls\n    static int id_counter = 1000;\n    return id_counter++;  // Returns current value, then increments\n}\n\nvoid process_item() {\n    // Local scope: exists only during function execution\n    int local_temp = 0;\n    global_count++;\n    printf(\"Item %d processed. Global count: %d\\n\", global_count, global_count);\n}\n\nint main() {\n    for (int i = 0; i < 3; i++) {\n        printf(\"Next ID: %d\\n\", get_next_id());  // 1000, 1001, 1002\n        process_item();\n    }\n    \n    printf(\"Final global count: %d\\n\", global_count);  // 3\n    \n    return 0;\n}\n\n## Header Files\n\nHeader files (`.h` files) contain function declarations, type definitions, and constants that are shared across multiple files. The preprocessor directive `#include` inserts the header content into the source file. Use `#include <header>` for standard library headers and `#include \"header\"` for local headers."
