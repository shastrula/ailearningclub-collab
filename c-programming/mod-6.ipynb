          "c",
          "#include <stdio.h>\n\nvoid increment(int x) {\n    x++;  // Modifies the local copy, not the caller's variable\n}\n\nvoid increment_pointer(int *x) {\n    (*x)++;  // Dereferences the pointer and modifies the original\n}\n\nint main() {\n    int num = 5;\n    \n    increment(num);\n    printf(\"After increment(num): %d\\n\", num);  // 5 (unchanged)\n    \n    increment_pointer(&num);\n    printf(\"After increment_pointer(&num): %d\\n\", num);  // 6 (changed)\n    \n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n\nint add(int a, int b) { return a + b; }\nint subtract(int a, int b) { return a - b; }\nint multiply(int a, int b) { return a * b; }\n\n// Function that takes a function pointer as parameter\nint apply_operation(int x, int y, int (*op)(int, int)) {\n    return op(x, y);\n}\n\nint main() {\n    // Create function pointers\n    int (*operation)(int, int) = add;\n    \n    printf(\"add(10, 5): %d\\n\", operation(10, 5));  // 15\n    \n    operation = subtract;\n    printf(\"subtract(10, 5): %d\\n\", operation(10, 5));  // 5\n    \n    // Pass function pointer to another function\n    printf(\"apply_operation(10, 5, multiply): %d\\n\", apply_operation(10, 5, multiply));  // 50\n    \n    // Array of function pointers\n    int (*operations[])(int, int) = {add, subtract, multiply};\n    for (int i = 0; i < 3; i++) {\n        printf(\"Operation %d: %d\\n\", i, operations[i](10, 5));\n    }\n    \n    return 0;\n}"
        ]
      ]
    },
    {
