          "c",
          "#include <stdio.h>\n\n// Poor design: unclear name, modifies global state, no documentation\nint global_counter = 0;\nvoid foo(int x) {\n    global_counter++;  // Side effect\n    printf(\"%d\\n\", x);\n}\n\n// Good design: clear name, no side effects, documented\n// Description: Calculates the average of two numbers\n// Parameters: \n//   - num1: first number (any value)\n//   - num2: second number (any value)\n// Returns: the average as a double\n// Precondition: none\n// Postcondition: the returned value is (num1 + num2) / 2\ndouble calculate_average(double num1, double num2) {\n    return (num1 + num2) / 2.0;\n}\n\n// Good: validates input, returns error code\n// Description: Finds an element in a sorted array using binary search\n// Parameters:\n//   - arr: sorted array of integers (must not be NULL)\n//   - size: number of elements (must be positive)\n//   - target: value to search for\n// Returns: index of target if found, -1 if not found\n// Precondition: arr must be NULL-terminated or size must be accurate\n// Postcondition: array is not modified\nint binary_search(int *arr, int size, int target) {\n    if (arr == NULL || size <= 0) {\n        return -1;\n    }\n    \n    int left = 0, right = size - 1;\n    while (left <= right) {\n        int mid = left + (right - left) / 2;\n        if (arr[mid] == target) {\n            return mid;\n        } else if (arr[mid] < target) {\n            left = mid + 1;\n        } else {\n            right = mid - 1;\n        }\n    }\n    return -1;\n}\n\nint main() {\n    printf(\"Average of 10 and 20: %.2f\\n\", calculate_average(10.0, 20.0));\n    \n    int sorted[] = {1, 3, 5, 7, 9, 11};\n    int result = binary_search(sorted, 6, 7);\n    printf(\"Search result: %d\\n\", result);  // 3\n    \n    return 0;\n}"
        ]
