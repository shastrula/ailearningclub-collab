          "c",
          "#include <stdio.h>\n\n// No return value, takes parameters\nvoid greet(char *name) {\n    printf(\"Hello, %s!\\n\", name);\n}\n\n// Returns a value\ndouble calculate_average(double a, double b) {\n    return (a + b) / 2.0;\n}\n\n// No parameters, returns a value\nint get_random() {\n    return 42;  // Simplified; a real random generator is more complex\n}\n\n// No parameters, no return\nvoid print_separator() {\n    printf(\"---\\n\");\n}\n\nint main() {\n    greet(\"Alice\");\n    printf(\"Average: %.2f\\n\", calculate_average(10.0, 20.0));  // 15.00\n    printf(\"Random: %d\\n\", get_random());  // 42\n    print_separator();\n    \n    return 0;\n}"
        ]
      ]
