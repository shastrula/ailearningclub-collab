          "c",
          "#include <stdio.h>\n#include <limits.h>\n\nint main() {\n    printf(\"Size of char: %zu bytes\\n\", sizeof(char));\n    printf(\"Size of int: %zu bytes\\n\", sizeof(int));\n    printf(\"Size of float: %zu bytes\\n\", sizeof(float));\n    printf(\"Size of double: %zu bytes\\n\", sizeof(double));\n    printf(\"Size of long: %zu bytes\\n\", sizeof(long));\n    \n    printf(\"\\nType limits:\\n\");\n    printf(\"INT_MAX: %d\\n\", INT_MAX);\n    printf(\"INT_MIN: %d\\n\", INT_MIN);\n    printf(\"CHAR_MAX: %d\\n\", CHAR_MAX);\n    printf(\"UINT_MAX: %u\\n\", UINT_MAX);\n    \n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n\nint main() {\n    int num = 42;\n    double d = 3.14159;\n    char c = 'A';\n    \n    // Implicit conversions\n    double from_int = num;  // 42.0\n    printf(\"int to double (implicit): %.1f\\n\", from_int);\n    \n    // Explicit casts\n    int from_double = (int)d;  // 3 (truncated)\n    printf(\"double to int (explicit): %d\\n\", from_double);\n    \n    int from_char = (int)c;  // 65 (ASCII)\n    printf(\"char to int: %d\\n\", from_char);\n    \n    char back = (char)65;  // 'A'\n    printf(\"int to char: %c\\n\", back);\n    \n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
