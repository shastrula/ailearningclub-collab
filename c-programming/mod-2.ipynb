          "c",
          "#include <stdio.h>\n\nconst int MAX_USERS = 100;\nconst double PI = 3.14159265359;\n\n#define BUFFER_SIZE 1024\n#define MIN(a, b) ((a) < (b) ? (a) : (b))\n\nint main() {\n    printf(\"MAX_USERS: %d\\n\", MAX_USERS);\n    printf(\"PI: %.10f\\n\", PI);\n    printf(\"BUFFER_SIZE: %d\\n\", BUFFER_SIZE);\n    printf(\"MIN(5, 3): %d\\n\", MIN(5, 3));\n    \n    // const int x = 10;\n    // x = 20;  // Compile error\n    \n    return 0;\n}"
        ]
