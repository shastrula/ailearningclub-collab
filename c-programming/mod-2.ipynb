          "c",
          "#include <stdio.h>\n\nvoid increment() {\n    static int counter = 0;\n    counter++;\n    printf(\"Counter: %d\\n\", counter);\n}\n\nint main() {\n    increment();  // Counter: 1\n    increment();  // Counter: 2\n    increment();  // Counter: 3\n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n#include <limits.h>\n\nint main() {\n    // Understanding overflow\n    int x = INT_MAX;\n    printf(\"INT_MAX: %d\\n\", x);\n    printf(\"INT_MAX + 1: %d\\n\", x + 1);  // Undefined (usually negative)\n    \n    unsigned int ux = UINT_MAX;\n    printf(\"UINT_MAX: %u\\n\", ux);\n    printf(\"UINT_MAX + 1: %u\\n\", ux + 1);  // Wraps to 0 (well-defined)\n    \n    // Detecting overflow before it happens\n    if (x < INT_MAX) {\n        x++;  // Safe\n    }\n    \n    // Using larger types to prevent overflow\n    long long big = (long long)INT_MAX + 1;\n    printf(\"(long long)INT_MAX + 1: %lld\\n\", big);\n    \n    return 0;\n}"
        ]
      ]
    },
    {
