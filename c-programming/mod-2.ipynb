          "c",
          "#include <stdio.h>\n#include <string.h>\n\nint main() {\n    int x;  // Uninitialized, undefined value\n    printf(\"Uninitialized x: %d\\n\", x);  // Undefined behavior\n    \n    int y = 42;  // Initialized\n    printf(\"Initialized y: %d\\n\", y);\n    \n    int arr[10] = {0};  // All elements set to 0\n    printf(\"First array element: %d\\n\", arr[0]);\n    \n    char buffer[256];\n    memset(buffer, 0, sizeof(buffer));  // Explicitly clear\n    printf(\"Buffer cleared, size: %zu\\n\", sizeof(buffer));\n    \n    return 0;\n}"
        ]
      ]
