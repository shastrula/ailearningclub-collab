          "c",
          "#include <stdio.h>\n\nint validate_age(int age) {\n    if (age < 0 || age > 150) {\n        printf(\"Invalid age.\\n\");\n        return 0;\n    }\n    if (age < 18) {\n        printf(\"Minor.\\n\");\n        return 0;\n    }\n    printf(\"Adult.\\n\");\n    return 1;\n}\n\nint main() {\n    validate_age(25);    // Adult.\n    validate_age(-5);    // Invalid age.\n    validate_age(10);    // Minor.\n    return 0;\n}"
