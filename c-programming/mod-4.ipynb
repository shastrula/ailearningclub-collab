          "#include <stdio.h>\n\nint main() {\n    int age = 25;\n    int hasLicense = 1;\n    int isInsured = 1;\n    \n    // Nested approach (avoid)\n    if (age >= 18) {\n        if (hasLicense) {\n            if (isInsured) {\n                printf(\"Can drive legally.\\n\");\n            }\n        }\n    }\n    \n    // Logical approach (prefer)\n    if (age >= 18 && hasLicense && isInsured) {\n        printf(\"Can drive legally.\\n\");\n    }\n    \n    return 0;\n}"
