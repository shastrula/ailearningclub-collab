          "c",
          "#include <stdio.h>\n\nint main() {\n    int age = 25;\n    \n    if (age >= 18) {\n        printf(\"You are an adult.\\n\");\n    } else {\n        printf(\"You are a minor.\\n\");\n    }\n    \n    // else if chain\n    int score = 85;\n    if (score >= 90) {\n        printf(\"Grade: A\\n\");\n    } else if (score >= 80) {\n        printf(\"Grade: B\\n\");\n    } else if (score >= 70) {\n        printf(\"Grade: C\\n\");\n    } else {\n        printf(\"Grade: F\\n\");\n    }\n    \n    // Single statement does not require braces (but include them for clarity)\n    int x = 10;\n    if (x > 0)\n        printf(\"Positive\\n\");\n    \n    return 0;\n}"
