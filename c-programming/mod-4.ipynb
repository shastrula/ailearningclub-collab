          "c",
          "#include <stdio.h>\n\nint main() {\n    int day = 3;\n    \n    switch (day) {\n        case 1:\n            printf(\"Monday\\n\");\n            break;\n        case 2:\n            printf(\"Tuesday\\n\");\n            break;\n        case 3:\n            printf(\"Wednesday\\n\");\n            break;\n        case 4:\n            printf(\"Thursday\\n\");\n            break;\n        case 5:\n            printf(\"Friday\\n\");\n            break;\n        case 6:\n        case 7:  // Fall-through: cases 6 and 7 share code\n            printf(\"Weekend\\n\");\n            break;\n        default:\n            printf(\"Invalid day\\n\");\n    }\n    \n    return 0;\n}"
