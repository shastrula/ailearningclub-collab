          "c",
          "#include <stdio.h>\n#include <string.h>\n\nint check_login(const char *username, const char *password, int is_active) {\n    // Guard clauses: fail fast on invalid inputs\n    if (username == NULL || password == NULL) {\n        printf(\"Error: NULL parameters.\\n\");\n        return 0;\n    }\n    \n    if (strlen(username) == 0 || strlen(password) == 0) {\n        printf(\"Error: Empty credentials.\\n\");\n        return 0;\n    }\n    \n    if (!is_active) {\n        printf(\"Error: Account is inactive.\\n\");\n        return 0;\n    }\n    \n    // Check hardcoded credentials (in real code, compare against hashed values in database)\n    if (strcmp(username, \"admin\") == 0 && strcmp(password, \"secret123\") == 0) {\n        printf(\"Login successful.\\n\");\n        return 1;\n    }\n    \n    printf(\"Error: Invalid credentials.\\n\");\n    return 0;\n}\n\nint main() {\n    check_login(\"admin\", \"secret123\", 1);    // Login successful.\n    check_login(\"user\", \"password\", 1);      // Error: Invalid credentials.\n    check_login(\"admin\", \"secret123\", 0);    // Error: Account is inactive.\n    check_login(NULL, \"secret123\", 1);       // Error: NULL parameters.\n    \n    return 0;\n}"
        ]
