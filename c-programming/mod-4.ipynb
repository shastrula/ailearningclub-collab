          "#include <stdio.h>\n\nint main() {\n    int error_flag = 0;\n    \n    // Simple example of error handling with goto\n    FILE *file = fopen(\"data.txt\", \"r\");\n    if (file == NULL) {\n        error_flag = 1;\n        goto cleanup;\n    }\n    \n    // ... process file ...\n    \n    fclose(file);\n    \ncleanup:\n    if (error_flag) {\n        printf(\"An error occurred.\\n\");\n    }\n    printf(\"Cleanup complete.\\n\");\n    \n    return 0;\n}"
