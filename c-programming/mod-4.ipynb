          "c",
          "#include <stdio.h>\n#include <assert.h>\n\nint divide(int numerator, int denominator) {\n    // Defensive checks\n    if (denominator == 0) {\n        printf(\"Error: division by zero.\\n\");\n        return 0;  // or use an error code\n    }\n    assert(denominator != 0);  // Development check\n    return numerator / denominator;\n}\n\nint array_get(int *arr, int size, int index) {\n    // Defensive checks\n    if (arr == NULL) {\n        printf(\"Error: array is NULL.\\n\");\n        return -1;\n    }\n    if (index < 0 || index >= size) {\n        printf(\"Error: index out of bounds.\\n\");\n        return -1;\n    }\n    return arr[index];\n}\n\n// Function with clear contract\n// Precondition: ptr must not be NULL, size must be positive\n// Postcondition: returns the sum of array elements, or -1 on error\nint array_sum(int *ptr, int size) {\n    if (ptr == NULL || size <= 0) {\n        return -1;  // Clear error indication\n    }\n    \n    int sum = 0;\n    for (int i = 0; i < size; i++) {\n        sum += ptr[i];\n    }\n    return sum;\n}\n\nint main() {\n    int result = divide(10, 2);\n    printf(\"Result: %d\\n\", result);  // 5\n    \n    int arr[] = {1, 2, 3};\n    printf(\"Element: %d\\n\", array_get(arr, 3, 1));  // 2\n    printf(\"Element: %d\\n\", array_get(arr, 3, 5));  // Error, returns -1\n    \n    int sum = array_sum(arr, 3);\n    printf(\"Sum: %d\\n\", sum);  // 6\n    \n    return 0;\n}"
        ]
      ]
    },
