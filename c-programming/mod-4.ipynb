          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n\nint process_file_with_goto(const char *filename) {\n    FILE *file = NULL;\n    char *buffer = NULL;\n    int *data = NULL;\n    int error = 0;\n    \n    file = fopen(filename, \"r\");\n    if (file == NULL) {\n        fprintf(stderr, \"Error: Cannot open file.\\n\");\n        error = 1;\n        goto cleanup;\n    }\n    \n    buffer = malloc(1024);\n    if (buffer == NULL) {\n        fprintf(stderr, \"Error: Memory allocation failed.\\n\");\n        error = 2;\n        goto cleanup;\n    }\n    \n    data = malloc(256 * sizeof(int));\n    if (data == NULL) {\n        fprintf(stderr, \"Error: Data allocation failed.\\n\");\n        error = 3;\n        goto cleanup;\n    }\n    \n    // Process the file... (omitted for brevity)\n    printf(\"File processed successfully.\\n\");\n    \ncleanup:\n    if (data != NULL) free(data);\n    if (buffer != NULL) free(buffer);\n    if (file != NULL) fclose(file);\n    \n    return error;\n}\n\nint main() {\n    process_file_with_goto(\"test.txt\");\n    return 0;\n}"
        ]
      ]
