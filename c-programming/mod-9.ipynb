          "c",
          "#include <stdio.h>\n\nstruct Unaligned {\n    char c;      // 1 byte\n    short s;     // 2 bytes\n    char c2;     // 1 byte\n    int i;       // 4 bytes\n};\n\nstruct Aligned {\n    int i;       // 4 bytes\n    short s;     // 2 bytes\n    char c;      // 1 byte\n    char c2;     // 1 byte\n};\n\nint main() {\n    printf(\"Unaligned size: %lu (with padding)\\n\", sizeof(struct Unaligned));\n    printf(\"Aligned size: %lu (optimized order)\\n\", sizeof(struct Aligned));\n    \n    struct Unaligned u;\n    printf(\"Offsets in Unaligned:\\n\");\n    printf(\"  c at %lu\\n\", (char*)&u.c - (char*)&u);\n    printf(\"  s at %lu\\n\", (char*)&u.s - (char*)&u);\n    printf(\"  c2 at %lu\\n\", (char*)&u.c2 - (char*)&u);\n    printf(\"  i at %lu\\n\", (char*)&u.i - (char*)&u);\n    \n    return 0;\n}"
        ]
      ]
    },
