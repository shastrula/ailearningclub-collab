          "c",
          "#include <stdio.h>\n\ntypedef struct {\n    unsigned int mode : 2;      // 2 bits for mode\n    unsigned int enabled : 1;   // 1 bit for flag\n    unsigned int reserved : 5;  // 5 bits padding\n} DeviceFlags;\n\ntypedef struct {\n    unsigned int year : 12;     // 12 bits for year\n    unsigned int month : 4;     // 4 bits for month\n    unsigned int day : 5;       // 5 bits for day\n} CompactDate;\n\nint main() {\n    printf(\"Size of DeviceFlags: %lu bytes\\n\", sizeof(DeviceFlags));\n    printf(\"Size of CompactDate: %lu bytes\\n\", sizeof(CompactDate));\n    \n    CompactDate date;\n    date.year = 2024;\n    date.month = 6;\n    date.day = 14;\n    \n    printf(\"Date: %d/%d/%d\\n\", date.day, date.month, date.year);\n    \n    return 0;\n}"
        ]
