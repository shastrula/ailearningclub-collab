          "c",
          "#pragma pack(1)\nstruct PackedData {\n    char a;       // 1 byte\n    int b;        // 4 bytes (no padding before it with pragma pack(1))\n    short c;      // 2 bytes\n};\n#pragma pack()\n\nstruct NormalData {\n    char a;       // 1 byte, then 3 bytes padding\n    int b;        // 4 bytes\n    short c;      // 2 bytes, then 2 bytes padding\n};\n\nint main() {\n    printf(\"PackedData: %zu bytes (a at 0, b at 1, c at 5)\\n\", sizeof(struct PackedData));    \n    printf(\"NormalData: %zu bytes (a at 0, b at 4, c at 8)\\n\", sizeof(struct NormalData));    \n    return 0;\n}"
        ]
      ]
