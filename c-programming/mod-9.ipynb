          "c",
          "typedef void (*FreeFunc)(void *);\n\ntypedef struct {\n    void *data;\n    FreeFunc cleanup;\n} Container;\n\nContainer* container_create(void *data, FreeFunc cleanup) {\n    Container *c = (Container *)malloc(sizeof(Container));\n    c->data = data;\n    c->cleanup = cleanup;\n    return c;\n}\n\nvoid container_destroy(Container *c) {\n    if (c != NULL) {\n        if (c->cleanup != NULL) {\n            c->cleanup(c->data);\n        }\n        free(c);\n    }\n}\n\nvoid free_string(void *ptr) {\n    free((char *)ptr);\n}\n\nvoid free_array(void *ptr) {\n    free((int *)ptr);\n}\n\nint main() {\n    Container *c1 = container_create(strdup(\"Hello\"), free_string);\n    Container *c2 = container_create(malloc(10 * sizeof(int)), free_array);\n    \n    container_destroy(c1);\n    container_destroy(c2);\n    return 0;\n}"
        ]
      ]
