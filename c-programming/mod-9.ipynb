          "c",
          "#include <stdio.h>\n#include <string.h>\n\nstruct Person {\n    char name[50];\n    int age;\n    double height;\n};\n\nint main() {\n    struct Person p1;\n    strcpy(p1.name, \"Alice\");\n    p1.age = 30;\n    p1.height = 5.7;\n    \n    printf(\"Name: %s\\n\", p1.name);\n    printf(\"Age: %d\\n\", p1.age);\n    printf(\"Height: %.1f\\n\", p1.height);\n    \n    // Pointer to struct\n    struct Person *ptr = &p1;\n    printf(\"Via pointer: %s is %d years old\\n\", ptr->name, ptr->age);\n    \n    // Array of structs\n    struct Person people[2];\n    strcpy(people[0].name, \"Bob\");\n    people[0].age = 25;\n    strcpy(people[1].name, \"Carol\");\n    people[1].age = 28;\n    \n    for (int i = 0; i < 2; i++) {\n        printf(\"%s: %d\\n\", people[i].name, people[i].age);\n    }\n    \n    return 0;\n}"
        ]
      ]
    },
