          "c",
          "#include <stdio.h>\n\ntypedef struct {\n    int id;\n    char *title;\n    float rating;\n} Book;\n\ntypedef struct {\n    char *name;\n    Book books[100];\n    int book_count;\n} Library;\n\nint main() {\n    Book book1 = {1, \"C Programming\", 4.8};\n    Book book2 = {2, \"Unix Programming\", 4.9};\n    \n    Library lib = {\"City Library\", {book1, book2}, 2};\n    \n    printf(\"Library: %s\\n\", lib.name);\n    for (int i = 0; i < lib.book_count; i++) {\n        printf(\"  %s (%.1f)\\n\", lib.books[i].title, lib.books[i].rating);\n    }\n    \n    return 0;\n}"
        ]
      ]
