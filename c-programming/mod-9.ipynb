          "#include <stdio.h>\n#include <string.h>\n\ntypedef struct {\n    int day, month, year;\n} Date;\n\ntypedef struct {\n    char name[50];\n    int employee_id;\n    Date hire_date;\n} Employee;\n\nint main() {\n    Employee emp;\n    strcpy(emp.name, \"John Doe\");\n    emp.employee_id = 1001;\n    emp.hire_date.day = 15;\n    emp.hire_date.month = 6;\n    emp.hire_date.year = 2020;\n    \n    printf(\"%s hired on %d/%d/%d\\n\",\n           emp.name,\n           emp.hire_date.day,\n           emp.hire_date.month,\n           emp.hire_date.year);\n    \n    return 0;\n}"
