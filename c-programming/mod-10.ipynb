          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n\nint main() {\n    // calloc: allocate and zero-initialize\n    int *nums = (int *)calloc(3, sizeof(int));\n    \n    if (nums == NULL) {\n        printf(\"Allocation failed\\n\");\n        return 1;\n    }\n    \n    printf(\"After calloc (should be zeros): \");\n    for (int i = 0; i < 3; i++) {\n        printf(\"%d \", nums[i]);\n    }\n    printf(\"\\n\");\n    \n    nums[0] = 100;\n    nums[1] = 200;\n    nums[2] = 300;\n    \n    // Resize to 5 elements\n    int *expanded = (int *)realloc(nums, 5 * sizeof(int));\n    \n    if (expanded == NULL) {\n        printf(\"Reallocation failed\\n\");\n        free(nums);\n        return 1;\n    }\n    \n    nums = expanded;\n    nums[3] = 400;\n    nums[4] = 500;\n    \n    printf(\"After realloc: \");\n    for (int i = 0; i < 5; i++) {\n        printf(\"%d \", nums[i]);\n    }\n    printf(\"\\n\");\n    \n    free(nums);\n    nums = NULL;\n    \n    return 0;\n}"
        ]
      ]
