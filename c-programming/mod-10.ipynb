          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nint main() {\n    int *arr = (int *)malloc(5 * sizeof(int));\n    \n    if (arr == NULL) {\n        printf(\"Memory allocation failed\\n\");\n        return 1;\n    }\n    \n    arr[0] = 10;\n    arr[1] = 20;\n    arr[2] = 30;\n    arr[3] = 40;\n    arr[4] = 50;\n    \n    printf(\"Array: \");\n    for (int i = 0; i < 5; i++) {\n        printf(\"%d \", arr[i]);\n    }\n    printf(\"\\n\");\n    \n    char *str = (char *)malloc(50 * sizeof(char));\n    strcpy(str, \"Hello, World!\");\n    printf(\"String: %s\\n\", str);\n    \n    free(str);\n    str = NULL;\n    \n    free(arr);\n    arr = NULL;\n    \n    return 0;\n}"
        ]
