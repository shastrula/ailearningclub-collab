          "c",
          "typedef struct {\n    void *objects;\n    int *free_list;\n    int object_size;\n    int pool_size;\n    int available;\n} MemoryPool;\n\nMemoryPool* pool_create(int object_size, int pool_size) {\n    MemoryPool *p = (MemoryPool *)malloc(sizeof(MemoryPool));\n    p->objects = malloc(object_size * pool_size);\n    p->free_list = (int *)malloc(pool_size * sizeof(int));\n    p->object_size = object_size;\n    p->pool_size = pool_size;\n    p->available = pool_size;\n    \n    for (int i = 0; i < pool_size; i++) {\n        p->free_list[i] = i;\n    }\n    return p;\n}\n\nvoid* pool_allocate(MemoryPool *p) {\n    if (p->available == 0) return NULL;\n    int idx = p->free_list[--p->available];\n    return (char *)p->objects + (idx * p->object_size);\n}\n\nvoid pool_free(MemoryPool *p, void *ptr) {\n    if (p->available >= p->pool_size) return;\n    int idx = ((char *)ptr - (char *)p->objects) / p->object_size;\n    p->free_list[p->available++] = idx;\n}"
