          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\ntypedef struct {\n    char *buffer;\n    int offset;\n    int capacity;\n} Arena;\n\nArena* arena_create(int size) {\n    Arena *a = (Arena *)malloc(sizeof(Arena));\n    a->buffer = (char *)malloc(size);\n    a->offset = 0;\n    a->capacity = size;\n    return a;\n}\n\nvoid* arena_alloc(Arena *a, int size) {\n    if (a->offset + size > a->capacity) {\n        printf(\"Arena out of space\\n\");\n        return NULL;\n    }\n    void *ptr = &a->buffer[a->offset];\n    a->offset += size;\n    return ptr;\n}\n\nvoid arena_reset(Arena *a) {\n    a->offset = 0;\n}\n\nvoid arena_destroy(Arena *a) {\n    free(a->buffer);\n    free(a);\n}\n\nint main() {\n    Arena *a = arena_create(1000);\n    \n    // Allocate several structures\n    typedef struct { int x, y; } Point;\n    \n    Point *p1 = (Point *)arena_alloc(a, sizeof(Point));\n    p1->x = 10; p1->y = 20;\n    \n    Point *p2 = (Point *)arena_alloc(a, sizeof(Point));\n    p2->x = 30; p2->y = 40;\n    \n    printf(\"p1: (%d, %d), p2: (%d, %d)\\n\", p1->x, p1->y, p2->x, p2->y);\n    printf(\"Arena used: %d bytes\\n\", a->offset);\n    \n    arena_reset(a);\n    printf(\"After reset, arena used: %d bytes\\n\", a->offset);\n    \n    arena_destroy(a);\n    return 0;\n}"
        ]
      ]
