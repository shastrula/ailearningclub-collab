          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\ntypedef struct {\n    int *data;\n    int size;\n    int capacity;\n} DynamicArray;\n\nDynamicArray* array_create() {\n    DynamicArray *arr = (DynamicArray *)malloc(sizeof(DynamicArray));\n    arr->capacity = 10;\n    arr->size = 0;\n    arr->data = (int *)malloc(10 * sizeof(int));\n    return arr;\n}\n\nvoid array_push(DynamicArray *arr, int value) {\n    if (arr->size == arr->capacity) {\n        arr->capacity *= 2;\n        arr->data = (int *)realloc(arr->data, arr->capacity * sizeof(int));\n    }\n    arr->data[arr->size++] = value;\n}\n\nint array_get(DynamicArray *arr, int index) {\n    if (index < 0 || index >= arr->size) {\n        printf(\"Index out of bounds\\n\");\n        return -1;\n    }\n    return arr->data[index];\n}\n\nvoid array_destroy(DynamicArray *arr) {\n    free(arr->data);\n    free(arr);\n}\n\nint main() {\n    DynamicArray *arr = array_create();\n    \n    for (int i = 0; i < 25; i++) {\n        array_push(arr, i * 10);\n    }\n    \n    printf(\"Array contents: \");\n    for (int i = 0; i < arr->size; i++) {\n        printf(\"%d \", array_get(arr, i));\n    }\n    printf(\"\\n\");\n    printf(\"Size: %d, Capacity: %d\\n\", arr->size, arr->capacity);\n    \n    array_destroy(arr);\n    return 0;\n}"
        ]
      ]
