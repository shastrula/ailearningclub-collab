        [
          "c",
          "#include <stdio.h>\n\nint main() {\n    int a = 5, b = 10;\n    \n    // AND: both must be true\n    printf(\"(a > 0) && (b > 0): %d\\n\", (a > 0) && (b > 0));  // 1 (true)\n    printf(\"(a > 10) && (b > 0): %d\\n\", (a > 10) && (b > 0));  // 0 (false)\n    \n    // OR: at least one must be true\n    printf(\"(a > 10) || (b > 0): %d\\n\", (a > 10) || (b > 0));  // 1 (true)\n    \n    // NOT: inverts result\n    printf(\"!(a > 10): %d\\n\", !(a > 10));  // 1 (true)\n    \n    // Short-circuit evaluation\n    int x = 0;\n    if (0 && ++x) {}  // ++x is NOT executed\n    printf(\"x after (0 && ++x): %d\\n\", x);  // 0\n    \n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n\nint main() {\n    unsigned char a = 0x0F;  // 0000 1111\n    unsigned char b = 0x33;  // 0011 0011\n    \n    // Bitwise AND: 1 if both bits are 1\n    printf(\"a & b: 0x%02X (0x03)\\n\", a & b);  // 0000 0011 = 0x03\n    \n    // Bitwise OR: 1 if either bit is 1\n    printf(\"a | b: 0x%02X (0x3F)\\n\", a | b);  // 0011 1111 = 0x3F\n    \n    // Bitwise XOR: 1 if bits differ\n    printf(\"a ^ b: 0x%02X (0x3C)\\n\", a ^ b);  // 0011 1100 = 0x3C\n    \n    // Bitwise NOT: flip all bits\n    printf(\"~a: 0x%02X\\n\", ~a);               // 1111 0000 = 0xF0 (for full int)\n    \n    // Left shift: multiply by 2^n\n    int x = 5;\n    printf(\"%d << 2: %d\\n\", x, x << 2);       // 5 * 4 = 20\n    \n    // Right shift: divide by 2^n\n    printf(\"%d >> 1: %d\\n\", x, x >> 1);       // 5 / 2 = 2\n    \n    return 0;\n}"
        ]
      ]
    },
    {
