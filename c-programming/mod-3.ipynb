        [
          "c",
          "#include <stdio.h>\n\nint main() {\n    int a = 17, b = 5;\n    \n    printf(\"Addition: %d + %d = %d\\n\", a, b, a + b);        // 22\n    printf(\"Subtraction: %d - %d = %d\\n\", a, b, a - b);      // 12\n    printf(\"Multiplication: %d * %d = %d\\n\", a, b, a * b);   // 85\n    printf(\"Division: %d / %d = %d\\n\", a, b, a / b);         // 3 (integer)\n    printf(\"Modulo: %d %% %d = %d\\n\", a, b, a % b);          // 2\n    \n    double x = 17.0, y = 5.0;\n    printf(\"Float division: %.2f / %.2f = %.2f\\n\", x, y, x / y);  // 3.40\n    \n    // Negation\n    int c = 10;\n    printf(\"Negation: -%d = %d\\n\", c, -c);                   // -10\n    \n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n\nint main() {\n    int x = 10, y = 20;\n    \n    printf(\"x < y: %d\\n\", x < y);      // 1 (true)\n    printf(\"x == y: %d\\n\", x == y);    // 0 (false)\n    printf(\"x != y: %d\\n\", x != y);    // 1 (true)\n    printf(\"x >= 10: %d\\n\", x >= 10);  // 1 (true)\n    \n    // Beware: assignment vs equality\n    int condition = (x == y);           // 0\n    printf(\"x == y stored: %d\\n\", condition);\n    \n    // Comparing floats - be careful!\n    double d1 = 0.1 + 0.2;\n    double d2 = 0.3;\n    printf(\"0.1 + 0.2 == 0.3: %d\\n\", d1 == d2);  // 0 (false!) due to precision\n    \n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
