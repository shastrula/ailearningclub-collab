          "c",
          "#include <stdio.h>\n\nint main() {\n    int x = 15;\n    int y = x > 10 ? 1 : 0;  // y = 1\n    printf(\"y: %d\\n\", y);\n    \n    int age = 25;\n    char *status = age >= 18 ? \"Adult\" : \"Minor\";\n    printf(\"Status: %s\\n\", status);  // \"Adult\"\n    \n    int max = (x > 10) ? x : 10;\n    printf(\"max: %d\\n\", max);  // 15\n    \n    // Nested ternary (harder to read)\n    int grade = 85;\n    char letter = (grade >= 90) ? 'A' : (grade >= 80) ? 'B' : 'C';\n    printf(\"Grade: %c\\n\", letter);  // 'B'\n    \n    return 0;\n}"
        ]
      ]
