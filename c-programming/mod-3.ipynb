          "c",
          "#include <stdio.h>\n\nint main() {\n    int x = 10;\n    \n    x += 5;      // x = x + 5 = 15\n    printf(\"After += 5: %d\\n\", x);\n    \n    x *= 2;      // x = x * 2 = 30\n    printf(\"After *= 2: %d\\n\", x);\n    \n    x -= 10;     // x = x - 10 = 20\n    printf(\"After -= 10: %d\\n\", x);\n    \n    x /= 4;      // x = x / 4 = 5\n    printf(\"After /= 4: %d\\n\", x);\n    \n    unsigned char flags = 0;\n    flags |= 0x01;  // Set bit 0\n    flags |= 0x04;  // Set bit 2\n    printf(\"Flags after |=: 0x%02X\\n\", flags);  // 0x05\n    \n    return 0;\n}"
        ]
      ]
    },
