          "c",
          "#include <stdio.h>\n\nint main() {\n    int i = 5;\n    double d = 2.5;\n    int result = i + d;  // i is promoted to 5.0, then 5.0 + 2.5 = 7.5, truncated to 7\n    printf(\"int + double: %d\\n\", result);  // 7\n    \n    unsigned int ui = 5;\n    int si = -3;\n    // si is converted to unsigned (large positive), so ui + si is a large number\n    unsigned int sum = ui + si;\n    printf(\"unsigned + signed: %u\\n\", sum);  // Large value\n    \n    return 0;\n}"
        ]
      ]
