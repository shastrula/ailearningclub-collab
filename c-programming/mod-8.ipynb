    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n\nint main() {\n    int x = 42;\n    int *ptr = &x;           // ptr stores the address of x\n    \n    printf(\"x = %d\\n\", x);           // Output: x = 42\n    printf(\"Address of x: %p\\n\", (void*)&x);  // Output: 0x7ffc...\n    printf(\"ptr = %p\\n\", (void*)ptr);         // Same address\n    printf(\"*ptr = %d\\n\", *ptr);     // Output: *ptr = 42\n    \n    *ptr = 100;              // Modify x through the pointer\n    printf(\"x after *ptr = 100: %d\\n\", x);  // Output: 100\n    \n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n\nint main() {\n    int arr[] = {10, 20, 30, 40, 50};\n    int *ptr = arr;  // Arrays decay to pointers\n    \n    printf(\"arr[0] = %d, *ptr = %d\\n\", arr[0], *ptr);\n    \n    ptr++;  // Move to next int (4 bytes on most systems)\n    printf(\"arr[1] = %d, *ptr = %d\\n\", arr[1], *ptr);\n    \n    ptr += 2;  // Move 2 ints forward\n    printf(\"arr[3] = %d, *ptr = %d\\n\", arr[3], *ptr);\n    \n    int diff = ptr - arr;  // Pointer subtraction\n    printf(\"Distance: %ld\\n\", diff);  // Output: 3\n    \n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
