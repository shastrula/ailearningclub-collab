          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n\nvoid dangling_example() {\n    int *ptr;\n    {\n        int x = 42;\n        ptr = &x;  // ptr points to local variable\n    }\n    // x is out of scope; ptr is now dangling\n    // printf(\"%d\\n\", *ptr);  // UNDEFINED BEHAVIOR - DO NOT UNCOMMENT\n}\n\nvoid wild_example() {\n    int *ptr;  // Uninitialized - points to garbage\n    // printf(\"%d\\n\", *ptr);  // UNDEFINED BEHAVIOR - DO NOT UNCOMMENT\n}\n\nvoid safe_example() {\n    int *ptr = NULL;  // Initialize to NULL\n    if (ptr != NULL) {\n        printf(\"%d\\n\", *ptr);\n    }\n    \n    int x = 42;\n    ptr = &x;\n    printf(\"%d\\n\", *ptr);  // Safe: x is in scope\n}\n\nint main() {\n    safe_example();\n    return 0;\n}"
        ]
      ]
    },
    {
