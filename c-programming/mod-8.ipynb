          "c",
          "typedef int (*CompareFunc)(int, int);\n\nint ascending(int a, int b) { return a < b; }\nint descending(int a, int b) { return a > b; }\n\nvoid sort_with_comparator(int arr[], int n, CompareFunc cmp) {\n    for (int i = 0; i < n - 1; i++) {\n        for (int j = 0; j < n - i - 1; j++) {\n            if (cmp(arr[j], arr[j + 1])) {\n                int temp = arr[j];\n                arr[j] = arr[j + 1];\n                arr[j + 1] = temp;\n            }\n        }\n    }\n}\n\nint main() {\n    int arr[] = {3, 1, 4, 1, 5, 9};\n    int n = 6;\n    \n    sort_with_comparator(arr, n, ascending);\n    printf(\"Ascending: \");\n    for (int i = 0; i < n; i++) printf(\"%d \", arr[i]);\n    printf(\"\\n\");\n    \n    return 0;\n}"
        ]
      ]
    },
