          "c",
          "#include <stdio.h>\n\nvoid swap(int *a, int *b) {\n    int temp = *a;\n    *a = *b;\n    *b = temp;\n}\n\nint main() {\n    int x = 10, y = 20;\n    printf(\"Before: x = %d, y = %d\\n\", x, y);\n    \n    swap(&x, &y);\n    printf(\"After: x = %d, y = %d\\n\", x, y);\n    \n    return 0;\n}"
        ]
      ]
    },
    {
