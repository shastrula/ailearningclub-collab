          "c",
          "#include <stdio.h>\n\nint main() {\n    int arr[] = {1, 2, 3, 4, 5};\n    int *ptr = arr;  // arr decays to &arr[0]\n    \n    // Both work equivalently\n    printf(\"arr[2] = %d\\n\", arr[2]);\n    printf(\"ptr[2] = %d\\n\", ptr[2]);\n    printf(\"*(arr + 2) = %d\\n\", *(arr + 2));\n    printf(\"*(ptr + 2) = %d\\n\", *(ptr + 2));\n    \n    // Key difference: sizeof\n    int size_arr = sizeof(arr);      // 5 * sizeof(int) = 20 bytes\n    int size_ptr = sizeof(ptr);      // 8 bytes (on 64-bit system)\n    printf(\"sizeof(arr) = %d\\n\", size_arr);\n    printf(\"sizeof(ptr) = %d\\n\", size_ptr);\n    \n    // String as array of chars\n    char str[] = \"Hello\";  // str[5] = {'H','e','l','l','o','\\0'}\n    char *pstr = str;\n    printf(\"%c %c\\n\", str[0], pstr[0]);  // Both: H H\n    \n    return 0;\n}"
        ]
      ]
    },
