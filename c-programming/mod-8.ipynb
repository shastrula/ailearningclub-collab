          "c",
          "#include <stdio.h>\n#include <stdlib.h>\n\nint main() {\n    int *int_ptr = NULL;  // NULL pointer\n    \n    if (int_ptr == NULL) {\n        printf(\"Pointer is NULL\\n\");\n    }\n    \n    // Void pointer\n    int x = 42;\n    void *generic = &x;    // Can hold any address\n    \n    int *specific = (int *)generic;  // Explicit cast\n    printf(\"*specific = %d\\n\", *specific);\n    \n    // Generic function working with any type\n    double d = 3.14;\n    generic = &d;\n    double *dptr = (double *)generic;\n    printf(\"*dptr = %.2f\\n\", *dptr);\n    \n    return 0;\n}"
        ]
      ]
    },
