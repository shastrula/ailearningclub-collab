          "c",
          "#include <stdio.h>\n\nvoid print_matrix(int arr[][3], int rows) {  // Note: [][3] required\n    for (int i = 0; i < rows; i++) {\n        for (int j = 0; j < 3; j++) {\n            printf(\"%d \", arr[i][j]);\n        }\n        printf(\"\\n\");\n    }\n}\n\nint main() {\n    int matrix[2][3] = {{1, 2, 3}, {4, 5, 6}};\n    print_matrix(matrix, 2);\n    return 0;\n}"
        ]
