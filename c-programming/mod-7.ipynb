    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n\nint main() {\n    // Declaration and initialization\n    int arr[] = {10, 20, 30, 40, 50};\n    int size = 5;\n    \n    // Access elements\n    printf(\"First element: %d\\n\", arr[0]);      // 10\n    printf(\"Last element: %d\\n\", arr[size - 1]);  // 50\n    \n    // Modify elements\n    arr[2] = 99;\n    printf(\"Modified arr[2]: %d\\n\", arr[2]);    // 99\n    \n    // Iterate through array\n    for (int i = 0; i < size; i++) {\n        printf(\"arr[%d] = %d\\n\", i, arr[i]);\n    }\n    \n    // Array size calculation\n    int full_array[10];\n    printf(\"Bytes in full_array: %zu\\n\", sizeof(full_array));  // 40 (4*10)\n    printf(\"Elements: %zu\\n\", sizeof(full_array) / sizeof(full_array[0]));  // 10\n    \n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n\nvoid print_array(int *arr, int size) {\n    for (int i = 0; i < size; i++) {\n        printf(\"%d \", arr[i]);\n    }\n    printf(\"\\n\");\n}\n\nint main() {\n    int nums[] = {1, 2, 3, 4, 5};\n    print_array(nums, 5);  // nums decays to &nums[0]\n    return 0;\n}"
        ]
      ]
    },
