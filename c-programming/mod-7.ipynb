        [
          "c",
          "#include <stdio.h>\n\nint main() {\n    // Character array: modifiable\n    char str1[] = \"hello\";\n    str1[0] = 'H';  // OK\n    printf(\"%s\\n\", str1);  // \"Hello\"\n    \n    // String pointer: read-only\n    char *str2 = \"hello\";\n    // str2[0] = 'H';  // DANGEROUS - attempts to modify read-only memory\n    printf(\"%s\\n\", str2);  // \"hello\"\n    \n    // Dynamic allocation: modifiable\n    char *str3 = malloc(6);  // Allocate 6 bytes\n    strcpy(str3, \"hello\");\n    str3[0] = 'H';  // OK\n    printf(\"%s\\n\", str3);  // \"Hello\"\n    free(str3);  // Always free allocated memory\n    \n    return 0;\n}"
        ]
      ]
    },
