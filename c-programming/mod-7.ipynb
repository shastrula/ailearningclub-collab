          "c",
          "#include <stdio.h>\n#include <string.h>\n\nint main() {\n    // String literals (read-only)\n    char *msg = \"Hello, World!\";\n    printf(\"%s\\n\", msg);\n    \n    // Character array (modifiable)\n    char str[] = \"hello\";  // Size is 6 (5 chars + null terminator)\n    printf(\"String: %s\\n\", str);\n    printf(\"Length: %zu\\n\", strlen(str));  // 5\n    printf(\"Array size: %zu\\n\", sizeof(str));  // 6\n    \n    // Initialize with enough space\n    char buffer[50] = \"Hello\";\n    printf(\"Buffer: %s, size: %zu\\n\", buffer, sizeof(buffer));  // 50\n    \n    // Iterate through string\n    for (int i = 0; str[i] != '\\0'; i++) {\n        printf(\"%c \", str[i]);\n    }\n    printf(\"\\n\");\n    \n    return 0;\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n#include <string.h>\n\nint main() {\n    char src[] = \"Hello\";\n    char dest[50];\n    \n    // strlen: string length (doesn't include null terminator)\n    printf(\"strlen(\\\"Hello\\\"): %zu\\n\", strlen(src));  // 5\n    \n    // strcpy: copy string (DANGEROUS - can overflow)\n    // strcpy(dest, src);  // Not recommended\n    \n    // strncpy: safe string copy (specify max chars)\n    strncpy(dest, src, sizeof(dest) - 1);\n    dest[sizeof(dest) - 1] = '\\0';  // Ensure null-terminated\n    printf(\"After strncpy: %s\\n\", dest);  // \"Hello\"\n    \n    // strcmp: compare strings (returns 0 if equal)\n    if (strcmp(src, \"Hello\") == 0) {\n        printf(\"Strings are equal\\n\");\n    }\n    \n    // strcat: concatenate (DANGEROUS - can overflow)\n    char buffer[50] = \"Hello\";\n    // strcat(buffer, \", World\");  // Not recommended\n    \n    // strncat: safe concatenation\n    strncat(buffer, \", World\", sizeof(buffer) - strlen(buffer) - 1);\n    printf(\"After strncat: %s\\n\", buffer);  // \"Hello, World\"\n    \n    // strchr: find character in string\n    char *ptr = strchr(\"Hello\", 'l');\n    if (ptr != NULL) {\n        printf(\"Found 'l' at position %ld\\n\", ptr - \"Hello\");  // 2\n    }\n    \n    return 0;\n}"
        ]
      ]
    },
    {
