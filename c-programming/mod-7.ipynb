          "c",
          "#include <stdio.h>\n#include <string.h>\n\nint main() {\n    char small_buffer[5];  // Only 5 bytes\n    \n    // DANGEROUS: strcpy does not check size\n    // strcpy(small_buffer, \"This is a very long string\");  // Overflow!\n    \n    // SAFE: Use strncpy with explicit size\n    strncpy(small_buffer, \"This is a very long string\", sizeof(small_buffer) - 1);\n    small_buffer[sizeof(small_buffer) - 1] = '\\0';\n    printf(\"Safe copy: %s\\n\", small_buffer);  // \"This\"\n    \n    // When reading user input, always use size limits\n    char input[50];\n    // scanf(\"%s\", input);  // DANGEROUS - unbounded input\n    // scanf(\"%49s\", input);  // SAFE - limits to 49 chars\n    \n    // fgets is safer for reading lines\n    // fgets(input, sizeof(input), stdin);  // Reads up to size-1 chars\n    \n    return 0;\n}"
        ]
      ]
