        [
          "c",
          "#include <stdio.h>\n\nint main() {\n    // 3x3 matrix\n    int matrix[3][3] = {\n        {1, 2, 3},\n        {4, 5, 6},\n        {7, 8, 9}\n    };\n    \n    // Access elements\n    printf(\"matrix[1][2]: %d\\n\", matrix[1][2]);  // 6\n    \n    // Iterate through 2D array\n    for (int i = 0; i < 3; i++) {\n        for (int j = 0; j < 3; j++) {\n            printf(\"%d \", matrix[i][j]);\n        }\n        printf(\"\\n\");\n    }\n    \n    // Partial initialization\n    int partial[2][3] = {\n        {1, 2, 3},\n        {4, 5, 6}\n    };\n    \n    // Row-major order: elements are stored row by row\n    int flat[6];\n    for (int i = 0; i < 2; i++) {\n        for (int j = 0; j < 3; j++) {\n            flat[i * 3 + j] = partial[i][j];\n        }\n    }\n    \n    return 0;\n}"
        ]
      ]
    },
    {
