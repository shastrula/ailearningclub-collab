          "c",
          "#include <stdio.h>\n#include <string.h>\n#include <ctype.h>\n\nint main() {\n    // Reverse a string\n    char str[] = \"hello\";\n    int len = strlen(str);\n    printf(\"Reverse of '%s': \", str);\n    for (int i = len - 1; i >= 0; i--) {\n        printf(\"%c\", str[i]);  // olleh\n    }\n    printf(\"\\n\");\n    \n    // Convert to uppercase\n    char text[] = \"Hello, World!\";\n    printf(\"Uppercase: \");\n    for (int i = 0; text[i] != '\\0'; i++) {\n        printf(\"%c\", toupper(text[i]));  // HELLO, WORLD!\n    }\n    printf(\"\\n\");\n    \n    // Count occurrences of a character\n    char input[] = \"Mississippi\";\n    int count = 0;\n    for (int i = 0; input[i] != '\\0'; i++) {\n        if (input[i] == 's') count++;\n    }\n    printf(\"Count of 's' in '%s': %d\\n\", input, count);  // 4\n    \n    // Find first word (split by space)\n    char sentence[] = \"Hello world from C\";\n    int i = 0;\n    printf(\"First word: \");\n    while (sentence[i] != ' ' && sentence[i] != '\\0') {\n        printf(\"%c\", sentence[i]);  // Hello\n        i++;\n    }\n    printf(\"\\n\");\n    \n    // Validate string contains only digits\n    char digit_string[] = \"12345\";\n    int is_digit_only = 1;\n    for (int i = 0; digit_string[i] != '\\0'; i++) {\n        if (!isdigit(digit_string[i])) {\n            is_digit_only = 0;\n            break;\n        }\n    }\n    printf(\"'%s' is digits only: %d\\n\", digit_string, is_digit_only);  // 1\n    \n    // Remove trailing whitespace (trim)\n    char with_spaces[] = \"hello   \";\n    int end = strlen(with_spaces) - 1;\n    while (end >= 0 && isspace(with_spaces[end])) {\n        with_spaces[end] = '\\0';\n        end--;\n    }\n    printf(\"Trimmed: '%s'\\n\", with_spaces);  // \"hello\"\n    \n    return 0;\n}"
        ]
      ]
    },
