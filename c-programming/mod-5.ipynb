          "c",
          "#include <stdio.h>\n\nint main() {\n    // Print multiplication table\n    for (int i = 1; i <= 3; i++) {\n        for (int j = 1; j <= 3; j++) {\n            printf(\"%d*%d=%d  \", i, j, i * j);\n        }\n        printf(\"\\n\");\n    }\n    \n    // Break out of nested loop\n    int found = 0;\n    for (int i = 0; i < 3 && !found; i++) {\n        for (int j = 0; j < 3; j++) {\n            if (i == 1 && j == 1) {\n                printf(\"Found at (%d, %d)\\n\", i, j);\n                found = 1;\n                break;\n            }\n        }\n    }\n    \n    return 0;\n}"
        ]
      ]
