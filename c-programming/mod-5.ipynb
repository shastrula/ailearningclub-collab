    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "#include <stdio.h>\n\nint main() {\n    // Simple count-up\n    for (int i = 0; i < 5; i++) {\n        printf(\"%d \", i);  // 0 1 2 3 4\n    }\n    printf(\"\\n\");\n    \n    // Iterate through an array\n    int arr[] = {10, 20, 30, 40, 50};\n    int size = 5;\n    for (int i = 0; i < size; i++) {\n        printf(\"arr[%d] = %d\\n\", i, arr[i]);\n    }\n    \n    // Count down\n    for (int i = 5; i > 0; i--) {\n        printf(\"%d \", i);  // 5 4 3 2 1\n    }\n    printf(\"\\n\");\n    \n    // Multiple updates\n    for (int i = 0, j = 10; i < 5; i++, j--) {\n        printf(\"i=%d, j=%d\\n\", i, j);\n    }\n    \n    // Infinite loop (broken by break)\n    for (;;) {\n        printf(\"This would loop forever.\\n\");\n        break;  // Exit the loop\n    }\n    \n    return 0;\n}"
        ]
      ]
    },
