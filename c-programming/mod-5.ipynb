          "c",
          "#include <stdio.h>\n\nint main() {\n    int choice;\n    do {\n        printf(\"Menu:\\n1. Option 1\\n2. Option 2\\n3. Exit\\n\");\n        printf(\"Enter choice: \");\n        scanf(\"%d\", &choice);\n        \n        switch (choice) {\n            case 1:\n                printf(\"You chose option 1.\\n\");\n                break;\n            case 2:\n                printf(\"You chose option 2.\\n\");\n                break;\n            case 3:\n                printf(\"Exiting.\\n\");\n                break;\n            default:\n                printf(\"Invalid choice.\\n\");\n        }\n    } while (choice != 3);\n    \n    return 0;\n}"
