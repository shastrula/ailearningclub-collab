          "c",
          "#include <stdio.h>\n\nint main() {\n    int count = 0;\n    while (count < 3) {\n        printf(\"Count: %d\\n\", count);\n        count++;\n    }\n    \n    // Reading input until sentinel value\n    int num;\n    printf(\"Enter numbers (0 to stop):\\n\");\n    while (scanf(\"%d\", &num) == 1 && num != 0) {\n        printf(\"You entered: %d\\n\", num);\n    }\n    \n    // Processing a string\n    char str[] = \"hello\";\n    int i = 0;\n    while (str[i] != '\\0') {\n        printf(\"%c\", str[i]);\n        i++;\n    }\n    printf(\"\\n\");\n    \n    return 0;\n}"
        ]
      ]
    },
