          "c",
          "#include <stdio.h>\n\nint sum_simple(int *arr, int size) {\n    int sum = 0;\n    for (int i = 0; i < size; i++) {\n        sum += arr[i];\n    }\n    return sum;\n}\n\nint sum_manual_unroll(int *arr, int size) {\n    // Manually unroll: process 4 elements per iteration\n    int sum = 0;\n    int i;\n    for (i = 0; i + 3 < size; i += 4) {\n        sum += arr[i] + arr[i+1] + arr[i+2] + arr[i+3];\n    }\n    // Handle remainder\n    for (; i < size; i++) {\n        sum += arr[i];\n    }\n    return sum;\n}\n\nint main() {\n    int data[100] = {1, 2, 3, 4, 5};  // Most elements are 0\n    printf(\"Simple sum: %d\\n\", sum_simple(data, 100));\n    printf(\"Unrolled sum: %d\\n\", sum_manual_unroll(data, 100));\n    return 0;\n}"
        ]
      ]
