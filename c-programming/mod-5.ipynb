          "c",
          "#include <stdio.h>\n\nint main() {\n    // break example: find first occurrence\n    int arr[] = {10, 20, 30, 40, 50};\n    int target = 30;\n    int found = 0;\n    \n    for (int i = 0; i < 5; i++) {\n        if (arr[i] == target) {\n            printf(\"Found %d at index %d\\n\", target, i);\n            found = 1;\n            break;  // Exit the loop\n        }\n    }\n    \n    // continue example: skip even numbers\n    for (int i = 1; i <= 10; i++) {\n        if (i % 2 == 0) {\n            continue;  // Skip this iteration\n        }\n        printf(\"%d \", i);  // 1 3 5 7 9\n    }\n    printf(\"\\n\");\n    \n    return 0;\n}"
        ]
      ]
    },
