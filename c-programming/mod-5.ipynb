          "c",
          "#include <stdio.h>\n#include <ctype.h>\n\n// Example: Parse a CSV-like string with quoted fields\nvoid parse_csv(const char *line) {\n    int in_quotes = 0;\n    int field_start = 0;\n    int line_len = 0;\n    \n    // Calculate string length\n    for (int j = 0; line[j] != '\\0'; j++) line_len++;\n    \n    for (int i = 0; line[i] != '\\0'; i++) {\n        char c = line[i];\n        \n        if (c == '\"') {\n            in_quotes = !in_quotes;  // Toggle quote state\n        } else if (c == ',' && !in_quotes) {\n            // End of field\n            printf(\"Field: [%d to %d]\\n\", field_start, i);\n            field_start = i + 1;\n        }\n    }\n    \n    // Final field\n    printf(\"Field: [%d to %d]\\n\", field_start, line_len);\n}\n\nint main() {\n    parse_csv(\"name,\\\"John Doe\\\",age\");\n    return 0;\n}"
        ]
      ]
