          "c",
          "#include <stdio.h>\n#include <string.h>\n#include <time.h>\n\nint main() {\n    char str[] = \"hello\";\n    \n    // Inefficient: strlen() called each iteration\n    // for (int i = 0; i < strlen(str); i++) {\n    //     printf(\"%c\", str[i]);\n    // }\n    \n    // Efficient: length calculated once\n    int len = strlen(str);\n    for (int i = 0; i < len; i++) {\n        printf(\"%c\", str[i]);\n    }\n    printf(\"\\n\");\n    \n    // Inefficient: computation inside loop (calculated 100 times)\n    // for (int i = 0; i < 100; i++) {\n    //     int offset = 5 * 2;  // Constant, should be outside\n    //     arr[i] = i + offset;\n    // }\n    \n    // Efficient: computation outside loop (calculated once)\n    int offset = 5 * 2;\n    int arr[100];\n    for (int i = 0; i < 100; i++) {\n        arr[i] = i + offset;\n    }\n    \n    // Inefficient: nested multiplication in inner loop\n    // for (int i = 0; i < 100; i++) {\n    //     for (int j = 0; j < 100; j++) {\n    //         data[i][j] = i * j * 2;  // Two multiplications per iteration\n    //     }\n    // }\n    \n    // More efficient: reduce multiplication\n    int data[100][100];\n    for (int i = 0; i < 100; i++) {\n        int row_base = i * 2;\n        for (int j = 0; j < 100; j++) {\n            data[i][j] = row_base * j;  // One multiplication per iteration\n        }\n    }\n    \n    return 0;\n}"
