          "makefile",
          "CC = gcc\nCFLAGS = -Wall -g\n\nall: program\n\nprogram: main.o lib.o\n\t$(CC) $(CFLAGS) -o program main.o lib.o\n\nmain.o: main.c header.h\n\t$(CC) $(CFLAGS) -c main.c\n\nlib.o: lib.c header.h\n\t$(CC) $(CFLAGS) -c lib.c\n\nclean:\n\trm -f *.o program"
        ]
