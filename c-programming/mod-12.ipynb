        [
          "makefile",
          "CC = gcc\nCFLAGS = -Wall -Wextra -std=c99 -g\nTARGET = myapp\nSOURCES = main.c math_lib.c utils.c\nOBJECTS = $(SOURCES:.c=.o)\n\nall: $(TARGET)\n\n$(TARGET): $(OBJECTS)\n\t$(CC) $(CFLAGS) -o $@ $^\n\n%.o: %.c\n\t$(CC) $(CFLAGS) -c $< -o $@\n\nclean:\n\trm -f $(OBJECTS) $(TARGET)\n\nrebuild: clean all\n\n.PHONY: all clean rebuild"
        ]
      ]
    },
