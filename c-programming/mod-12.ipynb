    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "// math_lib.c\n#include \"math_lib.h\"\n\nint add(int a, int b) { return a + b; }\nint subtract(int a, int b) { return a - b; }\nint multiply(int a, int b) { return a * b; }"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "c",
          "// main.c\n#include <stdio.h>\n#include \"math_lib.h\"\n\nint main() {\n    printf(\"10 + 5 = %d\\n\", add(10, 5));\n    printf(\"10 - 5 = %d\\n\", subtract(10, 5));\n    printf(\"10 * 5 = %d\\n\", multiply(10, 5));\n    return 0;\n}"
        ]
      ]
    },
