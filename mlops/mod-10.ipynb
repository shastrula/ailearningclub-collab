          "python",
          "from kfp import dsl\nfrom kfp.v2 import compiler\n\n@dsl.component\ndef prepare_data(data_path: str) -> str:\n    \"\"\"Prepare training data.\"\"\"\n    # This runs in a container\n    import pandas as pd\n    df = pd.read_csv(data_path)\n    df_clean = df.dropna()\n    df_clean.to_csv(\"/tmp/clean_data.csv\")\n    return \"/tmp/clean_data.csv\"\n\n@dsl.component\ndef train_model(data_path: str, epochs: int = 10) -> str:\n    \"\"\"Train ML model.\"\"\"\n    import pickle\n    # Load data, train model\n    model = train(data_path, epochs)\n    with open(\"/tmp/model.pkl\", \"wb\") as f:\n        pickle.dump(model, f)\n    return \"/tmp/model.pkl\"\n\n@dsl.component\ndef evaluate_model(model_path: str, test_data: str) -> float:\n    \"\"\"Evaluate model performance.\"\"\"\n    import pickle\n    with open(model_path, \"rb\") as f:\n        model = pickle.load(f)\n    accuracy = evaluate(model, test_data)\n    return accuracy\n\n@dsl.pipeline(name=\"ML-Pipeline\")\ndef ml_pipeline(data_path: str, epochs: int = 10):\n    \"\"\"Define pipeline DAG.\"\"\"\n    prepare_task = prepare_data(data_path)\n    \n    train_task = train_model(\n        data_path=prepare_task.output,\n        epochs=epochs\n    )\n    \n    eval_task = evaluate_model(\n        model_path=train_task.output,\n        test_data=prepare_task.output\n    )\n\n# Compile to Kubeflow Pipelines spec\ncompiler.Compiler().compile(\n    ml_pipeline,\n    package_path=\"pipeline.yaml\"\n)\n\n# Deploy to Kubeflow\n# kfp run submit --run-name test_run pipeline.yaml"
        ]
      ]
    },
