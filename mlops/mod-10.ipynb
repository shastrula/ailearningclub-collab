          "python",
          "from kubeflow.katib import models\n\n# Define parameter search space\nparameters = [\n    models.ParameterSpec(\n        name=\"lr\",\n        parameter_type=\"double\",\n        feasible_space=models.FeasibleSpace(min=\"0.001\", max=\"0.1\")\n    ),\n    models.ParameterSpec(\n        name=\"batch_size\",\n        parameter_type=\"int\",\n        feasible_space=models.FeasibleSpace(min=\"16\", max=\"256\")\n    )\n]\n\n# Define objective (maximize accuracy)\nobjective = models.ObjectiveSpec(\n    type=\"maximize\",\n    goal=0.95,\n    objective_metric_name=\"accuracy\"\n)\n\n# Define algorithm (Bayesian search)\nalgorithm = models.AlgorithmSpec(\n    algorithm_name=\"bayesian\"\n)\n\n# Katib runs 100s of experiments in parallel across cluster\n# Each trial trains a model with different hyperparameters\n# Stops early if objective reached or max trials exceeded"
