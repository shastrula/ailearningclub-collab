          "python",
          "from kfp import dsl\nfrom kubeflow.training import PyTorchJob\n\n@dsl.component\ndef distributed_training(\n    dataset_path: str,\n    model_name: str,\n    num_workers: int = 4\n):\n    \"\"\"Distributed training using PyTorch.\"\"\"\n    # Kubeflow creates 1 master + 4 workers\n    # Master: loss calculation, parameter updates\n    # Workers: forward/backward passes in parallel\n    \n    import torch\n    import torch.nn as nn\n    from torch.nn.parallel import DistributedDataParallel as DDP\n    \n    # Initialize distributed environment\n    torch.distributed.init_process_group(\"nccl\")\n    \n    model = MyModel().cuda()\n    ddp_model = DDP(model)\n    \n    # Training loop (standard PyTorch)\n    optimizer = torch.optim.Adam(ddp_model.parameters())\n    for epoch in range(10):\n        for batch in dataloader:\n            optimizer.zero_grad()\n            loss = ddp_model(batch)\n            loss.backward()\n            optimizer.step()"
        ]
      ]
    },
