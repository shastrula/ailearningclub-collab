          "python",
          "Supervised Learning:\n\u251c\u2500 Linear Learner (regression, classification)\n\u251c\u2500 XGBoost (gradient boosting)\n\u251c\u2500 LightGBM (gradient boosting)\n\u251c\u2500 CatBoost (gradient boosting)\n\u251c\u2500 SVM (support vector machines)\n\u2514\u2500 Neural Networks\n\nUnsupervised Learning:\n\u251c\u2500 K-Means (clustering)\n\u251c\u2500 PCA (dimensionality reduction)\n\u251c\u2500 Random Cut Forest (anomaly detection)\n\u2514\u2500 KNN (k-nearest neighbors)\n\nNLP:\n\u251c\u2500 BlazingText (text classification, word embeddings)\n\u2514\u2500 Sequence-to-Sequence (machine translation, summarization)\n\nComputer Vision:\n\u251c\u2500 Image Classification\n\u251c\u2500 Object Detection (YOLO)\n\u251c\u2500 Semantic Segmentation\n\u2514\u2500 Instance Segmentation\n\nForecasting:\n\u2514\u2500 DeepAR (deep learning time series)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sagemaker.amazon.amazon_estimator import get_image_uri\n\n# Get pre-built XGBoost container\nxgb_container = get_image_uri(region, \"xgboost\", \"latest\")\n\n# Create estimator pointing to built-in algorithm\nestimator = sagemaker.estimator.Estimator(\n    image_uri=xgb_container,\n    role=role,\n    instance_type=\"ml.m5.xlarge\",\n    instance_count=1,\n    output_path=s3_output_path,\n    ...\n)\n\n# Train\nestimator.fit(training_data)\n\n# Deploy\npredictor = estimator.deploy(1, \"ml.m5.large\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sagemaker.workflow.pipeline import Pipeline\nfrom sagemaker.workflow.steps import TrainingStep, ProcessingStep\nfrom sagemaker.workflow.properties import PropertyFile\n\n# Step 1: Data processing\nprocessor = ScriptProcessor(...)\nprocess_step = ProcessingStep(\n    name=\"ProcessData\",\n    processor=processor,\n    code=\"process.py\",\n    job_arguments=[\"--input\", \"s3://bucket/raw\", \"--output\", \"s3://bucket/processed\"]\n)\n\n# Step 2: Training\ntraining_step = TrainingStep(\n    name=\"TrainModel\",\n    estimator=estimator,\n    inputs={\"training\": \"s3://bucket/processed\"}\n)\n\n# Step 3: Evaluation\nevaluate_step = ProcessingStep(\n    name=\"EvaluateModel\",\n    processor=processor,\n    code=\"evaluate.py\",\n    job_arguments=[\n        \"--model\", training_step.properties.ModelArtifacts.S3ModelArtifact,\n        \"--test-data\", \"s3://bucket/test\"\n    ]\n)\n\n# Step 4: Conditional deployment (only if accuracy > 90%)\nfrom sagemaker.workflow.conditions import ConditionLessThanOrEqualTo\nfrom sagemaker.workflow.steps import ConditionStep\n\ncondition_step = ConditionStep(\n    name=\"CheckAccuracy\",\n    conditions=[\n        ConditionLessThanOrEqualTo(\n            left=evaluate_step.properties.ProcessingOutputConfig.Outputs[\"evaluation\"].S3Output.S3Uri,\n            right=\"0.9\"\n        )\n    ],\n    if_steps=[deploy_step],\n    else_steps=[]\n)\n\n# Create pipeline\npipeline = Pipeline(\n    name=\"ml-pipeline\",\n    steps=[process_step, training_step, evaluate_step, condition_step]\n)\n\n# Submit\npipeline.upsert(role_arn=role)\npipeline.start()"
        ]
      ]
