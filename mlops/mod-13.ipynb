          "python",
          "# 1. Use spot instances (up to 90% cheaper)\nestimator = XGBoost(\n    ...\n    instance_type=\"ml.m5.large\",\n    instance_count=1,\n    use_spot_instances=True,  # Use spot\n    max_wait=3600,            # Max wait time\n    checkpoint_s3_uri=\"s3://bucket/checkpoints\"  # Resume from checkpoints\n)\n\n# 2. Auto-stopping endpoints\npredictor.endpoint_context.auto_terminate(\n    warmup_seconds=120,\n    max_inactivity_seconds=3600  # Stop if no requests for 1 hour\n)\n\n# 3. Batch transform instead of real-time\ntransformer = estimator.transformer(\n    instance_count=1,\n    instance_type=\"ml.m5.xlarge\"\n)\ntransformer.transform(\n    data=\"s3://bucket/batch-input\",\n    content_type=\"application/json\"\n)\n# Processes all data at once, stops instance after\n\n# 4. Right-size instances\n# ml.t3.medium (cheap, for experiments)\n# ml.m5.large (standard)\n# ml.p3.2xlarge (GPU, expensive)\n# \u2192 Use cheapest that meets requirements\n\n# 5. Monitor costs\nimport boto3\nce = boto3.client(\"ce\")\ncosts = ce.get_cost_and_usage(\n    TimePeriod={\"Start\": \"2024-01-01\", \"End\": \"2024-01-31\"},\n    Granularity=\"DAILY\",\n    Metrics=[\"UnblendedCost\"],\n    Filter={\n        \"Dimensions\": {\n            \"Key\": \"SERVICE\",\n            \"Values\": [\"Amazon SageMaker\"]\n        }\n    }\n)"
        ]
