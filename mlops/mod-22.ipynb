        [
          "python",
          "import json\nimport hashlib\nfrom datetime import datetime\nfrom dataclasses import dataclass, asdict\n\n@dataclass\nclass ModelMetadata:\n    model_name: str\n    version: str\n    accuracy: float\n    training_date: str\n    data_hash: str\n    parameters: dict\n\ndef log_experiment(model_name, metrics, params):\n    \"\"\"Log ML experiment metadata for reproducibility.\"\"\"\n    metadata = ModelMetadata(\n        model_name=model_name,\n        version=f\"v{datetime.now().strftime('%Y%m%d_%H%M')}\",\n        accuracy=metrics.get(\"accuracy\", 0),\n        training_date=datetime.now().isoformat(),\n        data_hash=hashlib.md5(str(params).encode()).hexdigest()[:8],\n        parameters=params\n    )\n    \n    print(f\"Experiment logged:\")\n    print(json.dumps(asdict(metadata), indent=2))\n    return metadata\n\n# Log an experiment\nlog_experiment(\n    model_name=\"random_forest_v2\",\n    metrics={\"accuracy\": 0.94, \"f1\": 0.92},\n    params={\"n_estimators\": 200, \"max_depth\": 10, \"min_samples_split\": 5}\n)"
        ]
      ]
    }
