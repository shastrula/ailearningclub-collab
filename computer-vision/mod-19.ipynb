      "source": [
        [
          "python",
          "import numpy as np\n\n# Simulating image operations (concepts used in OpenCV/PyTorch)\n# In practice: import cv2 or torchvision\n\ndef create_sample_image(h=64, w=64, channels=3):\n    \"\"\"Create a random RGB image.\"\"\"\n    return np.random.randint(0, 256, (h, w, channels), dtype=np.uint8)\n\ndef apply_filter(image, kernel):\n    \"\"\"Apply a convolution kernel to an image (simplified).\"\"\"\n    h, w = image.shape[:2]\n    kh, kw = kernel.shape\n    pad = kh // 2\n    output = np.zeros_like(image[:,:,0], dtype=float)\n    \n    gray = image.mean(axis=2)  # convert to grayscale\n    padded = np.pad(gray, pad, mode='constant')\n    \n    for i in range(h):\n        for j in range(w):\n            region = padded[i:i+kh, j:j+kw]\n            output[i, j] = (region * kernel).sum()\n    return output\n\n# Edge detection kernel (Sobel)\nsobel_x = np.array([[-1, 0, 1], [-2, 0, 2], [-1, 0, 1]])\nimage = create_sample_image()\nedges = apply_filter(image, sobel_x)\nprint(f\"Image shape: {image.shape}\")\nprint(f\"Edge map: min={edges.min():.0f}, max={edges.max():.0f}\")"
        ]
      ]
    }
