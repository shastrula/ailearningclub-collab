      "source": [
        [
          "python",
          "import cv2\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Load image in RGB\nimage = cv2.imread('photo.jpg')\nimage_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)  # OpenCV uses BGR by default\n\nprint(f\"Image shape: {image_rgb.shape}\")  # (height, width, 3)\nprint(f\"Data type: {image_rgb.dtype}\")    # uint8 (0-255)\n\n# Display\nplt.imshow(image_rgb)\nplt.title('RGB Image')\nplt.show()\n\n# Access pixel values\nheight, width, channels = image_rgb.shape\ntop_left_pixel = image_rgb[0, 0]  # [row, col]\nprint(f\"Top-left pixel RGB: {top_left_pixel}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Convert between color spaces\ngray = cv2.cvtColor(image_rgb, cv2.COLOR_RGB2GRAY)\nhsv = cv2.cvtColor(image_rgb, cv2.COLOR_RGB2HSV)\n\n# Use HSV for skin detection\nlower_skin = np.array([0, 10, 60])\nupper_skin = np.array([20, 150, 255])\nmask = cv2.inRange(hsv, lower_skin, upper_skin)\nresult = cv2.bitwise_and(image_rgb, image_rgb, mask=mask)\n\nplt.imshow(result)\nplt.title('Skin Detection (HSV-based)')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import cv2\nfrom tensorflow.keras.applications import VGG16\nfrom tensorflow.keras.applications.vgg16 import preprocess_input, decode_predictions\nfrom PIL import Image\nimport numpy as np\n\n# Load pre-trained model\nmodel = VGG16(weights='imagenet')\n\n# Prepare image\nimage = Image.open('photo.jpg').resize((224, 224))\nimage_array = np.array(image)\nimage_array = np.expand_dims(image_array, axis=0)\nimage_array = preprocess_input(image_array)\n\n# Predict\npredictions = model.predict(image_array)\ndecoded = decode_predictions(predictions, top=3)[0]\n\nfor label, accuracy in decoded:\n    print(f\"{label}: {accuracy:.2%}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Using YOLO (You Only Look Once)\nimport cv2\n\n# Load YOLO\nnet = cv2.dnn.readNet('yolov3.weights', 'yolov3.cfg')\nlayer_names = net.getLayerNames()\noutput_layers = [layer_names[i - 1] for i in net.getUnconnectedOutLayers()]\n\n# Prepare image\nimage = cv2.imread('photo.jpg')\nheight, width, channels = image.shape\nblob = cv2.dnn.blobFromImage(image, 0.00392, (416, 416), (0, 0, 0), True, False)\n\n# Detect\nnet.setInput(blob)\nouts = net.forward(output_layers)\n\n# Parse detections\nboxes = []\nconfidences = []\nclass_ids = []\n\nfor out in outs:\n    for detection in out:\n        scores = detection[5:]\n        class_id = np.argmax(scores)\n        confidence = scores[class_id]\n        \n        if confidence > 0.5:  # Confidence threshold\n            center_x = int(detection[0] * width)\n            center_y = int(detection[1] * height)\n            w = int(detection[2] * width)\n            h = int(detection[3] * height)\n            x = int(center_x - w / 2)\n            y = int(center_y - h / 2)\n            \n            boxes.append([x, y, w, h])\n            confidences.append(float(confidence))\n            class_ids.append(class_id)\n\n# Draw boxes\nindices = cv2.dnn.NMSBoxes(boxes, confidences, 0.5, 0.4)\nfor i in indices:\n    i = i[0]\n    x, y, w, h = boxes[i]\n    cv2.rectangle(image, (x, y), (x + w, y + h), (0, 255, 0), 2)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Haar Cascade for face detection (simple, fast)\nface_cascade = cv2.CascadeClassifier(\n    cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'\n)\n\nimage = cv2.imread('photo.jpg')\ngray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n\n# Detect faces\nfaces = face_cascade.detectMultiScale(gray, 1.3, 5)\n\n# Draw rectangles\nfor (x, y, w, h) in faces:\n    cv2.rectangle(image, (x, y), (x+w, y+h), (255, 0, 0), 2)\n\ncv2.imshow('Face Detection', image)\ncv2.waitKey(0)\ncv2.destroyAllWindows()"
        ]
      ]
    },
