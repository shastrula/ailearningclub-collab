          "java",
          "public class Matrix {\n    public static int[][] transpose(int[][] matrix) {\n        int rows = matrix.length;\n        int cols = matrix[0].length;\n        int[][] result = new int[cols][rows];\n        \n        for (int i = 0; i < rows; i++) {\n            for (int j = 0; j < cols; j++) {\n                result[j][i] = matrix[i][j];\n            }\n        }\n        return result;\n    }\n}"
        ]
      ]
