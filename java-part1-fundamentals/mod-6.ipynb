          "java",
          "public class SlidingWindow {\n    public static void processConsecutive(int[] nums, int windowSize) {\n        for (int i = 0; i <= nums.length - windowSize; i++) {\n            int sum = 0;\n            for (int j = i; j < i + windowSize; j++) {\n                sum += nums[j];\n            }\n            System.out.println(\"Window sum: \" + sum);\n        }\n    }\n}"
        ]
      ]
