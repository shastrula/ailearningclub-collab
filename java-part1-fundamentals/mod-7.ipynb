          "java",
          "import java.util.ArrayList;\nimport java.util.Collections;\n\npublic class ArrayListAdvanced {\n    public static void main(String[] args) {\n        ArrayList<Integer> numbers = new ArrayList<>();\n        numbers.add(5);\n        numbers.add(2);\n        numbers.add(8);\n        numbers.add(2);\n        \n        // Sorting\n        Collections.sort(numbers);\n        System.out.println(numbers);  // [2, 2, 5, 8]\n        \n        // Finding max/min\n        int max = Collections.max(numbers);\n        int min = Collections.min(numbers);\n        \n        // Reversing\n        Collections.reverse(numbers);\n        System.out.println(numbers);  // [8, 5, 2, 2]\n        \n        // Removing duplicates\n        ArrayList<Integer> unique = new ArrayList<>(new java.util.HashSet<>(numbers));\n        \n        // Checking containment\n        System.out.println(numbers.contains(5));  // true\n    }\n}"
