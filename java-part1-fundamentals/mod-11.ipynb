          "java",
          "// This violates LSP\nclass Bird {\n    public void fly() { }\n}\n\nclass Penguin extends Bird {\n    @Override\n    public void fly() {\n        throw new UnsupportedOperationException(\"Penguins can't fly\");\n    }\n}\n\n// Better approach:\nclass Bird {\n    public void move() { }\n}\n\nclass Penguin extends Bird {\n    @Override\n    public void move() {\n        System.out.println(\"Penguin waddles\");\n    }\n}"
