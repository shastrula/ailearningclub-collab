          "python",
          "async def agent_with_timeout(query: str, timeout_sec: int = 30) -> str:\n    try:\n        return await asyncio.wait_for(\n            orchestrate(query),\n            timeout=timeout_sec\n        )\n    except asyncio.TimeoutError:\n        return \"Agent timed out. Please try a simpler query.\""
