      "source": [
        "# Agentic Ai Patterns - mod-1\n\n",
        "**Course:** agentic-ai-patterns\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from langchain.agents import initialize_agent, Tool\nfrom langchain.tools import tool\nfrom langchain_openai import ChatOpenAI\n\n@tool\ndef search_web(query: str) -> str:\n    \"\"\"Search the web for information\"\"\"\n    return f\"Search results for '{query}': Found 5 relevant articles about {query}\"\n\n@tool\ndef calculate(expression: str) -> str:\n    \"\"\"Execute a mathematical calculation\"\"\"\n    result = eval(expression)\n    return f\"Result of {expression} = {result}\"\n\ntools = [search_web, calculate]\nllm = ChatOpenAI(model=\"gpt-4\", temperature=0)\nagent = initialize_agent(\n    tools, \n    llm, \n    agent=\"openai-tools\",\n    verbose=True\n)\n\nresponse = agent.run(\"What is 15% of 300? Search for current inflation rates.\")\nprint(response)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from langchain.agents import AgentType, initialize_agent\nfrom langchain_openai import ChatOpenAI\nfrom langchain.callbacks import get_openai_callback\nimport json\n\n# Detailed tool definitions\ntools = [\n    Tool(\n        name=\"SearchDatabase\",\n        func=lambda query: json.dumps({\"results\": f\"Found records matching '{query}'\"}),\n        description=\"Search company database for customer records. Input: search query\"\n    ),\n    Tool(\n        name=\"UpdateRecord\",\n        func=lambda update: json.dumps({\"status\": \"updated\"}),\n        description=\"Update a customer record. Input: JSON with changes\"\n    ),\n]\n\nllm = ChatOpenAI(model=\"gpt-4\", temperature=0)\nagent = initialize_agent(\n    tools,\n    llm,\n    agent=AgentType.ZERO_SHOT_REACT_DESCRIPTION,\n    verbose=True\n)\n\n# Track token usage\nwith get_openai_callback() as cb:\n    result = agent.run(\"Search for customer 'John Smith' and update their status to 'verified'\")\n    print(f\"Tokens used: {cb.total_tokens}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from langchain.memory import ConversationBufferMemory, ConversationSummaryMemory\nfrom langchain.agents import initialize_agent, AgentType\nfrom langchain_openai import ChatOpenAI\n\n# Short-term: Full conversation history\nshort_memory = ConversationBufferMemory(\n    memory_key=\"chat_history\",\n    return_messages=True\n)\n\n# Long-term: Summarized interactions\nlong_memory = ConversationSummaryMemory(\n    llm=ChatOpenAI(model=\"gpt-3.5-turbo\"),\n    memory_key=\"long_history\",\n    return_messages=True\n)\n\nllm = ChatOpenAI(model=\"gpt-4\", temperature=0.7)\n\nagent = initialize_agent(\n    tools=[],\n    llm=llm,\n    agent=AgentType.CONVERSATIONAL_REACT_DESCRIPTION,\n    memory=short_memory,\n    verbose=True\n)\n\n# First interaction\nagent.run(\"I'm interested in learning Python for data science\")\n\n# Second interaction - agent remembers the goal\nagent.run(\"What should I focus on next?\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from langchain.agents import load_tools, initialize_agent, AgentType\nfrom langchain_openai import ChatOpenAI\n\n# LangChain approach: flexible component composition\nllm = ChatOpenAI(model=\"gpt-4\", temperature=0)\ntools = load_tools([\"serpapi\", \"llm-math\"], llm=llm)\n\nagent = initialize_agent(\n    tools,\n    llm,\n    agent=AgentType.ZERO_SHOT_REACT_DESCRIPTION,\n    verbose=True\n)\n\nresult = agent.run(\"What's the current population of France? Multiply by 1.05\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from crewai import Agent, Task, Crew\nfrom langchain_openai import ChatOpenAI\n\nllm = ChatOpenAI(model=\"gpt-4\")\n\n# CrewAI approach: role-based agent definitions\nresearcher = Agent(\n    role=\"Market Researcher\",\n    goal=\"Research market trends\",\n    backstory=\"Expert analyst with 10 years experience\",\n    llm=llm\n)\n\nanalyst = Agent(\n    role=\"Data Analyst\",\n    goal=\"Analyze and interpret data\",\n    backstory=\"PhD in Statistics\",\n    llm=llm\n)\n\nresearch_task = Task(\n    description=\"Research AI market growth for 2024\",\n    agent=researcher,\n    expected_output=\"Market analysis report\"\n)\n\nanalysis_task = Task(\n    description=\"Analyze the research findings\",\n    agent=analyst,\n    expected_output=\"Statistical analysis of trends\"\n)\n\ncrew = Crew(agents=[researcher, analyst], tasks=[research_task, analysis_task])\nresult = crew.kickoff()"
        ]
      ]
    }
