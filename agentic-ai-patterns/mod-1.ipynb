          "python",
          "# Build an AI agent that uses tools\nfrom typing import Callable\n\ndef create_agent(tools: dict[str, Callable]):\n    \"\"\"Create a simple tool-using agent.\"\"\"\n    def run(task: str):\n        for name, func in tools.items():\n            if name in task.lower():\n                return func(task)\n        return \"No matching tool found\"\n    return run\n\nagent = create_agent({\"search\": lambda q: f\"Results for: {q}\"})\nprint(agent(\"search for Python tutorials\"))"
        ]
      ]
    }
