      "source": [
        "# Agentic Ai Patterns - mod-7\n\n",
        "**Course:** agentic-ai-patterns\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from autogen import ConversableAgent\nfrom autogen.agentchat.contrib.code_execution_agent import CodeExecutionAgent\n\n# Define specialized agents\ncode_writer = ConversableAgent(\n    name=\"CodeWriter\",\n    system_message=\"You are an expert Python developer. Write clean, well-documented code.\",\n    llm_config={\"config_list\": [{\"model\": \"gpt-4\", \"api_key\": \"YOUR_KEY\"}]},\n)\n\ncode_reviewer = ConversableAgent(\n    name=\"CodeReviewer\",\n    system_message=\"You are a code quality expert. Review code for bugs, security, and style.\",\n    llm_config={\"config_list\": [{\"model\": \"gpt-4\", \"api_key\": \"YOUR_KEY\"}]},\n)\n\nexecutor = CodeExecutionAgent(\n    name=\"Executor\",\n    code_execution_config={\"work_dir\": \"coding\"},\n)\n\n# Display agent configurations\nprint(f\"Writer: {code_writer.name}\")\nprint(f\"Reviewer: {code_reviewer.name}\")\nprint(f\"Executor: {executor.name}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from autogen import GroupChat, GroupChatManager\n\n# Create a group chat\ngroup_chat = GroupChat(\n    agents=[code_writer, code_reviewer, executor],\n    messages=[],\n    max_round=10,\n    speaker_selection_method=\"auto\",\n)\n\n# Create a manager to orchestrate the group\nmanager = GroupChatManager(\n    groupchat=group_chat,\n    llm_config={\"config_list\": [{\"model\": \"gpt-4\", \"api_key\": \"YOUR_KEY\"}]},\n)\n\n# Initiate group conversation\ncode_writer.initiate_chat(\n    manager,\n    message=\"Write Python code to load CSV data and calculate mean, median, and std deviation\",\n)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from autogen import UserProxyAgent, AssistantAgent\n\n# Agent that can execute code\ncode_executor = UserProxyAgent(\n    name=\"Executor\",\n    human_input_mode=\"NEVER\",\n    max_consecutive_auto_reply=10,\n    is_termination_msg=lambda x: \"EXECUTION_COMPLETE\" in x.get(\"content\", \"\"),\n    code_execution_config={\n        \"work_dir\": \"coding\",\n        \"use_docker\": False,  # Set True for Docker isolation\n    },\n)\n\n# Agent that writes code\nassistant = AssistantAgent(\n    name=\"Programmer\",\n    llm_config={\"config_list\": [{\"model\": \"gpt-4\", \"api_key\": \"YOUR_KEY\"}]},\n)\n\n# Start conversation: assistant writes code, executor runs it\ncode_executor.initiate_chat(\n    assistant,\n    message=\"Generate a list of prime numbers up to 100 and verify each one\",\n)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from autogen import UserProxyAgent, AssistantAgent\n\n# Human-supervised workflow\nhuman = UserProxyAgent(\n    name=\"Human\",\n    human_input_mode=\"SOMETIMES\",  # Ask for input at decision points\n    max_consecutive_auto_reply=3,   # Limit autonomous responses\n    is_termination_msg=lambda x: \"APPROVED\" in x.get(\"content\", \"\"),\n    code_execution_config={\"work_dir\": \"coding\"},\n)\n\nassistant = AssistantAgent(\n    name=\"Assistant\",\n    system_message=\"You are a helpful assistant. Propose solutions but wait for human approval on significant decisions.\",\n    llm_config={\"config_list\": [{\"model\": \"gpt-4\", \"api_key\": \"YOUR_KEY\"}]},\n)\n\n# Conversation with human oversight\nhuman.initiate_chat(\n    assistant,\n    message=\"I have 50,000 customer records. Should we delete records older than 2 years?\",\n)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from autogen import AssistantAgent, UserProxyAgent, GroupChat, GroupChatManager\n\n# Complete AutoGen workflow example\nconfig_list = [{\"model\": \"gpt-4\", \"api_key\": \"YOUR_KEY\"}]\n\n# Define three specialist agents\nquestion_expert = AssistantAgent(\n    name=\"QuestionExpert\",\n    system_message=\"You ask clarifying questions and ensure you understand the problem completely.\",\n    llm_config={\"config_list\": config_list},\n)\n\nsolution_expert = AssistantAgent(\n    name=\"SolutionExpert\", \n    system_message=\"You propose solutions based on the problem understanding.\",\n    llm_config={\"config_list\": config_list},\n)\n\ncritic = AssistantAgent(\n    name=\"Critic\",\n    system_message=\"You critique solutions, identify issues, and suggest improvements.\",\n    llm_config={\"config_list\": config_list},\n)\n\n# Human participant\nuser = UserProxyAgent(\n    name=\"User\",\n    human_input_mode=\"SOMETIMES\",\n    code_execution_config={\"work_dir\": \"coding\"},\n)\n\n# Group conversation\ngroup = GroupChat(\n    agents=[question_expert, solution_expert, critic, user],\n    messages=[],\n    max_round=15,\n    speaker_selection_method=\"auto\",\n)\n\nmanager = GroupChatManager(\n    groupchat=group,\n    llm_config={\"config_list\": config_list},\n)\n\n# Start the process\nuser.initiate_chat(\n    manager,\n    message=\"How can I optimize Python code that loads 100GB datasets into memory?\",\n)"
        ]
      ]
    }
  ],
