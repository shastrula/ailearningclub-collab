          "python",
          "# AWS SDK (boto3) patterns\n# pip install boto3\nimport json\n\n# Simulated AWS service interactions\nclass AWSService:\n    \"\"\"Demonstrates AWS SDK patterns (simplified).\"\"\"\n    \n    @staticmethod\n    def s3_upload(bucket, key, data):\n        \"\"\"Upload to S3.\"\"\"\n        # In production: boto3.client('s3').put_object(...)\n        print(f\"Uploading to s3://{bucket}/{key} ({len(data)} bytes)\")\n        return {\"status\": \"success\", \"bucket\": bucket, \"key\": key}\n    \n    @staticmethod\n    def lambda_invoke(function_name, payload):\n        \"\"\"Invoke Lambda function.\"\"\"\n        # In production: boto3.client('lambda').invoke(...)\n        print(f\"Invoking Lambda: {function_name}\")\n        return {\"StatusCode\": 200, \"Payload\": json.dumps({\"result\": \"ok\"})}\n    \n    @staticmethod\n    def dynamodb_put(table, item):\n        \"\"\"Put item in DynamoDB.\"\"\"\n        # In production: boto3.resource('dynamodb').Table(table).put_item(...)\n        print(f\"Put item in {table}: {item.get('id', 'unknown')}\")\n        return {\"ResponseMetadata\": {\"HTTPStatusCode\": 200}}\n\n# Usage examples\naws = AWSService()\naws.s3_upload(\"my-bucket\", \"data/model.pkl\", b\"model_bytes\" * 100)\naws.lambda_invoke(\"process-data\", {\"records\": [1, 2, 3]})\naws.dynamodb_put(\"users\", {\"id\": \"user-123\", \"name\": \"Alice\", \"score\": 95})"
        ]
      ]
    }
