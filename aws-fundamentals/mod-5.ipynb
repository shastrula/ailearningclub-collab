      "source": [
        "# Aws Fundamentals - mod-5\n\n",
        "**Course:** aws-fundamentals\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "VPC (10.0.0.0/16)\n\u251c\u2500\u2500 Public Subnet (10.0.1.0/24) \u2500\u2500 Internet Gateway\n\u2502   \u251c\u2500\u2500 NAT Gateway\n\u2502   \u251c\u2500\u2500 ALB\n\u2502   \u2514\u2500\u2500 Bastion Host\n\u251c\u2500\u2500 Private Subnet (10.0.2.0/24) \u2500\u2500 NAT Gateway (outbound only)\n\u2502   \u251c\u2500\u2500 App Servers (EC2/ECS)\n\u2502   \u2514\u2500\u2500 Lambda functions\n\u2514\u2500\u2500 Private Subnet (10.0.3.0/24) \u2500\u2500 No internet\n    \u251c\u2500\u2500 RDS Database\n    \u2514\u2500\u2500 ElastiCache"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create VPC\nVPC_ID=$(aws ec2 create-vpc --cidr-block 10.0.0.0/16 \\\n  --tag-specifications 'ResourceType=vpc,Tags=[{Key=Name,Value=production}]' \\\n  --query 'Vpc.VpcId' --output text)\n\n# Create subnets\naws ec2 create-subnet --vpc-id $VPC_ID --cidr-block 10.0.1.0/24 \\\n  --availability-zone us-east-1a \\\n  --tag-specifications 'ResourceType=subnet,Tags=[{Key=Name,Value=public-1a}]'\n\naws ec2 create-subnet --vpc-id $VPC_ID --cidr-block 10.0.2.0/24 \\\n  --availability-zone us-east-1a \\\n  --tag-specifications 'ResourceType=subnet,Tags=[{Key=Name,Value=private-1a}]'\n\n# Create Internet Gateway (for public subnets)\nIGW_ID=$(aws ec2 create-internet-gateway --query 'InternetGateway.InternetGatewayId' --output text)\naws ec2 attach-internet-gateway --internet-gateway-id $IGW_ID --vpc-id $VPC_ID\n\n# Route table: public subnet \u2192 internet\nRTB_ID=$(aws ec2 create-route-table --vpc-id $VPC_ID --query 'RouteTable.RouteTableId' --output text)\naws ec2 create-route --route-table-id $RTB_ID --destination-cidr-block 0.0.0.0/0 --gateway-id $IGW_ID\naws ec2 associate-route-table --route-table-id $RTB_ID --subnet-id $PUBLIC_SUBNET_ID"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Security Group: allow app traffic\naws ec2 create-security-group --group-name app-sg --description \"App tier\" --vpc-id $VPC_ID\naws ec2 authorize-security-group-ingress --group-id sg-app \\\n  --protocol tcp --port 8000 --source-group sg-alb  # only from ALB\n\n# NACL: block a bad IP at subnet level\naws ec2 create-network-acl-entry --network-acl-id acl-xxx \\\n  --rule-number 50 --protocol -1 --rule-action deny \\\n  --cidr-block 203.0.113.0/24 --ingress"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Gateway endpoint for S3 (free, no NAT needed)\naws ec2 create-vpc-endpoint \\\n  --vpc-id $VPC_ID \\\n  --service-name com.amazonaws.us-east-1.s3 \\\n  --route-table-ids $PRIVATE_RTB_ID\n\n# Interface endpoint for other services (e.g., Secrets Manager)\naws ec2 create-vpc-endpoint \\\n  --vpc-id $VPC_ID \\\n  --service-name com.amazonaws.us-east-1.secretsmanager \\\n  --vpc-endpoint-type Interface \\\n  --subnet-ids $PRIVATE_SUBNET_ID \\\n  --security-group-ids sg-endpoint"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import boto3\n\nec2 = boto3.resource('ec2')\n\n# Create VPC with all components\nvpc = ec2.create_vpc(CidrBlock='10.0.0.0/16')\nvpc.create_tags(Tags=[{'Key': 'Name', 'Value': 'production'}])\nvpc.wait_until_available()\n\n# Enable DNS\nclient = boto3.client('ec2')\nclient.modify_vpc_attribute(VpcId=vpc.id, EnableDnsHostnames={'Value': True})\n\n# Create subnet\nsubnet = vpc.create_subnet(CidrBlock='10.0.1.0/24', AvailabilityZone='us-east-1a')\nprint(f\"VPC: {vpc.id}, Subnet: {subnet.id}\")"
        ]
      ]
    }
  ],
