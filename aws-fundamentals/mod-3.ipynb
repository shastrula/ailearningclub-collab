      "source": [
        "# Aws Fundamentals - mod-3\n\n",
        "**Course:** aws-fundamentals\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Launch a t3.micro instance\naws ec2 run-instances \\\n  --image-id ami-0c02fb55956c7d316 \\\n  --instance-type t3.micro \\\n  --key-name my-keypair \\\n  --security-group-ids sg-0123456789abcdef0 \\\n  --subnet-id subnet-0123456789abcdef0 \\\n  --tag-specifications 'ResourceType=instance,Tags=[{Key=Name,Value=web-server}]' \\\n  --user-data file://setup.sh\n\n# setup.sh \u2014 runs on first boot\n#!/bin/bash\nyum update -y\nyum install -y nginx\nsystemctl start nginx\nsystemctl enable nginx\necho \"<h1>Hello from $(hostname)</h1>\" > /usr/share/nginx/html/index.html"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create a security group\naws ec2 create-security-group \\\n  --group-name web-sg \\\n  --description \"Allow HTTP and SSH\" \\\n  --vpc-id vpc-0123456789abcdef0\n\n# Allow HTTP from anywhere\naws ec2 authorize-security-group-ingress \\\n  --group-id sg-xxx \\\n  --protocol tcp --port 80 --cidr 0.0.0.0/0\n\n# Allow SSH from your IP only\naws ec2 authorize-security-group-ingress \\\n  --group-id sg-xxx \\\n  --protocol tcp --port 22 --cidr $(curl -s ifconfig.me)/32"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import boto3\n\nec2 = boto3.resource('ec2', region_name='us-east-1')\nclient = boto3.client('ec2', region_name='us-east-1')\n\n# Launch an instance\ninstances = ec2.create_instances(\n    ImageId='ami-0c02fb55956c7d316',\n    InstanceType='t3.micro',\n    MinCount=1, MaxCount=1,\n    KeyName='my-keypair',\n    SecurityGroupIds=['sg-xxx'],\n    TagSpecifications=[{\n        'ResourceType': 'instance',\n        'Tags': [{'Key': 'Name', 'Value': 'api-server'}]\n    }]\n)\ninstance = instances[0]\nprint(f\"Launched: {instance.id}\")\n\n# Wait until running\ninstance.wait_until_running()\ninstance.reload()\nprint(f\"Public IP: {instance.public_ip_address}\")\n\n# List running instances\nrunning = ec2.instances.filter(\n    Filters=[{'Name': 'instance-state-name', 'Values': ['running']}]\n)\nfor i in running:\n    name = next((t['Value'] for t in (i.tags or []) if t['Key'] == 'Name'), 'unnamed')\n    print(f\"  {i.id} | {name} | {i.instance_type} | {i.public_ip_address}\")\n\n# Stop/terminate\ninstance.stop()   # preserves data\ninstance.terminate()  # permanently deletes"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# SSH (traditional \u2014 requires key pair + port 22 open)\nssh -i my-keypair.pem ec2-user@<public-ip>\n\n# Session Manager (no SSH keys, no open ports \u2014 preferred)\naws ssm start-session --target i-1234567890abcdef0\n\n# Run a command remotely\naws ssm send-command \\\n  --instance-ids i-1234567890abcdef0 \\\n  --document-name \"AWS-RunShellScript\" \\\n  --parameters commands=[\"uptime\",\"df -h\"]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create launch template\naws ec2 create-launch-template \\\n  --launch-template-name web-template \\\n  --launch-template-data '{\n    \"ImageId\": \"ami-0c02fb55956c7d316\",\n    \"InstanceType\": \"t3.micro\",\n    \"SecurityGroupIds\": [\"sg-xxx\"],\n    \"UserData\": \"IyEvYmluL2Jhc2gKeXVtIGluc3RhbGwgLXkgbmdpbng=\"\n  }'\n\n# Create Auto Scaling Group\naws autoscaling create-auto-scaling-group \\\n  --auto-scaling-group-name web-asg \\\n  --launch-template LaunchTemplateName=web-template,Version='$Latest' \\\n  --min-size 2 --max-size 10 --desired-capacity 3 \\\n  --vpc-zone-identifier \"subnet-aaa,subnet-bbb\" \\\n  --target-group-arns \"arn:aws:elasticloadbalancing:...\"\n\n# Add scaling policy (scale up when CPU > 70%)\naws autoscaling put-scaling-policy \\\n  --auto-scaling-group-name web-asg \\\n  --policy-name scale-up \\\n  --policy-type TargetTrackingScaling \\\n  --target-tracking-configuration '{\n    \"PredefinedMetricSpecification\": {\"PredefinedMetricType\": \"ASGAverageCPUUtilization\"},\n    \"TargetValue\": 70.0\n  }'"
        ]
      ]
    }
  ],
