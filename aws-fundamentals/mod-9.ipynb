      "source": [
        "# Aws Fundamentals - mod-9\n\n",
        "**Course:** aws-fundamentals\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Get EC2 CPU utilization\naws cloudwatch get-metric-statistics \\\n  --namespace AWS/EC2 \\\n  --metric-name CPUUtilization \\\n  --dimensions Name=InstanceId,Value=i-1234567890abcdef0 \\\n  --start-time $(date -u -v-1H +%Y-%m-%dT%H:%M:%S) \\\n  --end-time $(date -u +%Y-%m-%dT%H:%M:%S) \\\n  --period 300 --statistics Average\n\n# Create alarm: alert if CPU > 80% for 5 minutes\naws cloudwatch put-metric-alarm \\\n  --alarm-name high-cpu-production \\\n  --metric-name CPUUtilization \\\n  --namespace AWS/EC2 \\\n  --statistic Average \\\n  --period 300 \\\n  --threshold 80 \\\n  --comparison-operator GreaterThanThreshold \\\n  --evaluation-periods 2 \\\n  --alarm-actions arn:aws:sns:us-east-1:123456:ops-alerts \\\n  --dimensions Name=InstanceId,Value=i-1234567890abcdef0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import boto3\n\ncloudwatch = boto3.client('cloudwatch')\n\n# Publish custom metric (e.g., queue depth, business KPI)\ncloudwatch.put_metric_data(\n    Namespace='MyApp/Production',\n    MetricData=[{\n        'MetricName': 'OrdersProcessed',\n        'Value': 142,\n        'Unit': 'Count',\n        'Dimensions': [\n            {'Name': 'Service', 'Value': 'order-processor'},\n            {'Name': 'Environment', 'Value': 'production'}\n        ]\n    }]\n)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import boto3\n\nlogs = boto3.client('logs')\n\n# Search logs with Insights query\nresponse = logs.start_query(\n    logGroupName='/aws/lambda/my-function',\n    startTime=int((datetime.now() - timedelta(hours=1)).timestamp()),\n    endTime=int(datetime.now().timestamp()),\n    queryString='''\n        fields @timestamp, @message\n        | filter @message like /ERROR/\n        | sort @timestamp desc\n        | limit 20\n    '''\n)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Tail logs in real-time\naws logs tail /aws/lambda/my-function --follow\n\n# Filter for errors\naws logs filter-log-events \\\n  --log-group-name /aws/lambda/my-function \\\n  --filter-pattern \"ERROR\" \\\n  --start-time $(date -d '1 hour ago' +%s000)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import boto3, json\n\ncloudwatch = boto3.client('cloudwatch')\n\n# Create a dashboard\ncloudwatch.put_dashboard(\n    DashboardName='Production-Overview',\n    DashboardBody=json.dumps({\n        \"widgets\": [{\n            \"type\": \"metric\",\n            \"properties\": {\n                \"metrics\": [\n                    [\"AWS/EC2\", \"CPUUtilization\", \"InstanceId\", \"i-xxx\"],\n                    [\"AWS/RDS\", \"DatabaseConnections\", \"DBInstanceIdentifier\", \"prod-db\"]\n                ],\n                \"period\": 300,\n                \"title\": \"System Health\"\n            }\n        }]\n    })\n)"
        ]
      ]
    }
  ],
