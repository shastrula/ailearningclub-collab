      "source": [
        "# Aws Fundamentals - mod-4\n\n",
        "**Course:** aws-fundamentals\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create a bucket\naws s3 mb s3://my-company-data-2025 --region us-east-1\n\n# Upload files\naws s3 cp report.pdf s3://my-bucket/reports/\naws s3 sync ./local-folder/ s3://my-bucket/data/ --delete\n\n# Download\naws s3 cp s3://my-bucket/reports/report.pdf ./\naws s3 sync s3://my-bucket/data/ ./local-copy/\n\n# List and find\naws s3 ls s3://my-bucket/reports/\naws s3 ls s3://my-bucket/ --recursive --human-readable --summarize"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import boto3\nfrom botocore.exceptions import ClientError\n\ns3 = boto3.client('s3')\n\n# Upload a file\ns3.upload_file('model.pkl', 'my-bucket', 'models/v1/model.pkl',\n    ExtraArgs={'ServerSideEncryption': 'AES256'})\n\n# Upload with metadata\ns3.put_object(\n    Bucket='my-bucket',\n    Key='data/users.json',\n    Body=json.dumps({\"users\": []}),\n    ContentType='application/json',\n    Metadata={'version': '2.0', 'source': 'etl-pipeline'}\n)\n\n# Download\ns3.download_file('my-bucket', 'models/v1/model.pkl', './model.pkl')\n\n# Read object directly into memory\nresponse = s3.get_object(Bucket='my-bucket', Key='data/config.json')\ncontent = json.loads(response['Body'].read())\n\n# List objects with prefix\npaginator = s3.get_paginator('list_objects_v2')\nfor page in paginator.paginate(Bucket='my-bucket', Prefix='logs/2025/'):\n    for obj in page.get('Contents', []):\n        print(f\"  {obj['Key']} ({obj['Size']} bytes)\")\n\n# Generate presigned URL (temporary access without credentials)\nurl = s3.generate_presigned_url('get_object',\n    Params={'Bucket': 'my-bucket', 'Key': 'reports/q4.pdf'},\n    ExpiresIn=3600  # 1 hour\n)\nprint(f\"Download link (expires in 1hr): {url}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "json",
          "// Lifecycle rule: move to cheaper storage over time\n{\n  \"Rules\": [{\n    \"ID\": \"ArchiveOldData\",\n    \"Status\": \"Enabled\",\n    \"Prefix\": \"logs/\",\n    \"Transitions\": [\n      {\"Days\": 30, \"StorageClass\": \"STANDARD_IA\"},\n      {\"Days\": 90, \"StorageClass\": \"GLACIER\"},\n      {\"Days\": 365, \"StorageClass\": \"DEEP_ARCHIVE\"}\n    ],\n    \"Expiration\": {\"Days\": 730}\n  }]\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Enable versioning (protects against accidental deletes)\naws s3api put-bucket-versioning \\\n  --bucket my-bucket \\\n  --versioning-configuration Status=Enabled\n\n# List versions of an object\naws s3api list-object-versions --bucket my-bucket --prefix config.json\n\n# Restore a deleted object (delete the delete marker)\naws s3api delete-object --bucket my-bucket --key config.json \\\n  --version-id \"deletemarker-version-id\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Host a static site on S3 + CloudFront\naws s3 website s3://my-site --index-document index.html --error-document error.html\n\n# Bucket policy for public read\naws s3api put-bucket-policy --bucket my-site --policy '{\n  \"Statement\": [{\n    \"Effect\": \"Allow\",\n    \"Principal\": \"*\",\n    \"Action\": \"s3:GetObject\",\n    \"Resource\": \"arn:aws:s3:::my-site/*\"\n  }]\n}'\n\n# Better: use CloudFront OAC (Origin Access Control) instead of public bucket"
        ]
      ]
    }
  ],
