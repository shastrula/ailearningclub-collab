      "source": [
        "# Aws Fundamentals - mod-11\n\n",
        "**Course:** aws-fundamentals\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Get current month's costs by service\naws ce get-cost-and-usage \\\n  --time-period Start=2025-01-01,End=2025-01-31 \\\n  --granularity MONTHLY \\\n  --metrics BlendedCost \\\n  --group-by Type=DIMENSION,Key=SERVICE\n\n# Top 5 most expensive services\naws ce get-cost-and-usage \\\n  --time-period Start=$(date -d '30 days ago' +%Y-%m-%d),End=$(date +%Y-%m-%d) \\\n  --granularity MONTHLY --metrics BlendedCost \\\n  --group-by Type=DIMENSION,Key=SERVICE \\\n  --query 'ResultsByTime[0].Groups | sort_by(@, &Metrics.BlendedCost.Amount) | [-5:]'"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create a monthly budget with alert\naws budgets create-budget --account-id 123456789012 --budget '{\n  \"BudgetName\": \"Monthly-Total\",\n  \"BudgetLimit\": {\"Amount\": \"500\", \"Unit\": \"USD\"},\n  \"TimeUnit\": \"MONTHLY\",\n  \"BudgetType\": \"COST\"\n}' --notifications-with-subscribers '[{\n  \"Notification\": {\n    \"NotificationType\": \"ACTUAL\",\n    \"ComparisonOperator\": \"GREATER_THAN\",\n    \"Threshold\": 80\n  },\n  \"Subscribers\": [{\"SubscriptionType\": \"EMAIL\", \"Address\": \"ops@company.com\"}]\n}]'"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# 1. Right-sizing: use CloudWatch to find underutilized instances\n#    CPU < 20% average \u2192 downsize instance type\n\n# 2. Savings Plans: commit to $/hr for 1-3 years (up to 72% discount)\n#    Compute Savings Plan: flexible across instance families/regions\n#    EC2 Instance Savings Plan: specific family, highest discount\n\n# 3. Spot Instances: up to 90% off for interruptible workloads\n#    Good for: batch jobs, CI/CD, training ML models\n#    Bad for: databases, stateful services\n\n# 4. Reserved capacity: commit to specific resources\n#    RDS Reserved Instances, ElastiCache Reserved Nodes\n\n# 5. S3 Lifecycle: move old data to cheaper storage classes\n# 6. Delete unused resources: unattached EBS volumes, old snapshots, idle NAT Gateways"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Tag resources for cost allocation\naws ec2 create-tags --resources i-xxx \\\n  --tags Key=Team,Value=backend Key=Environment,Value=production Key=Project,Value=api\n\n# Find untagged resources\naws resourcegroupstaggingapi get-resources \\\n  --tag-filters Key=Team,Values=[] \\\n  --resource-type-filters ec2:instance"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import boto3\n\nce = boto3.client('ce')\n\n# Cost by team tag\nresponse = ce.get_cost_and_usage(\n    TimePeriod={'Start': '2025-01-01', 'End': '2025-02-01'},\n    Granularity='MONTHLY',\n    Metrics=['BlendedCost'],\n    GroupBy=[{'Type': 'TAG', 'Key': 'Team'}]\n)\nfor group in response['ResultsByTime'][0]['Groups']:\n    team = group['Keys'][0].replace('Team$', '')\n    cost = float(group['Metrics']['BlendedCost']['Amount'])\n    print(f\"  {team}: ${cost:.2f}\")"
        ]
      ]
    }
  ],
