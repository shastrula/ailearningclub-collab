      "source": [
        "# Aws Fundamentals - mod-6\n\n",
        "**Course:** aws-fundamentals\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create DB subnet group\naws rds create-db-subnet-group \\\n  --db-subnet-group-name my-db-subnets \\\n  --db-subnet-group-description \"Private subnets for RDS\" \\\n  --subnet-ids subnet-aaa subnet-bbb\n\n# Launch RDS PostgreSQL\naws rds create-db-instance \\\n  --db-instance-identifier production-db \\\n  --db-instance-class db.r6g.large \\\n  --engine postgres \\\n  --engine-version 16.1 \\\n  --master-username admin \\\n  --master-user-password \"$DB_PASSWORD\" \\\n  --allocated-storage 100 \\\n  --max-allocated-storage 500 \\\n  --storage-type gp3 \\\n  --storage-encrypted \\\n  --multi-az \\\n  --db-subnet-group-name my-db-subnets \\\n  --vpc-security-group-ids sg-db \\\n  --backup-retention-period 7 \\\n  --no-publicly-accessible"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import boto3\nfrom decimal import Decimal\n\ndynamodb = boto3.resource('dynamodb')\n\n# Create table\ntable = dynamodb.create_table(\n    TableName='Users',\n    KeySchema=[\n        {'AttributeName': 'user_id', 'KeyType': 'HASH'},   # partition key\n        {'AttributeName': 'created_at', 'KeyType': 'RANGE'}  # sort key\n    ],\n    AttributeDefinitions=[\n        {'AttributeName': 'user_id', 'AttributeType': 'S'},\n        {'AttributeName': 'created_at', 'AttributeType': 'S'},\n    ],\n    BillingMode='PAY_PER_REQUEST'  # on-demand pricing\n)\ntable.wait_until_exists()\n\n# Put item\ntable.put_item(Item={\n    'user_id': 'u-12345',\n    'created_at': '2025-01-15T10:30:00Z',\n    'name': 'Alice',\n    'email': 'alice@example.com',\n    'score': Decimal('95.5')\n})\n\n# Get item\nresponse = table.get_item(Key={'user_id': 'u-12345', 'created_at': '2025-01-15T10:30:00Z'})\nprint(response['Item'])\n\n# Query (all items for a user, sorted by date)\nresponse = table.query(\n    KeyConditionExpression='user_id = :uid',\n    ExpressionAttributeValues={':uid': 'u-12345'},\n    ScanIndexForward=False,  # newest first\n    Limit=10\n)\nfor item in response['Items']:\n    print(f\"  {item['created_at']}: {item['name']}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Multi-AZ: automatic failover (high availability)\n# Already enabled with --multi-az flag above\n\n# Read Replica: offload read traffic\naws rds create-db-instance-read-replica \\\n  --db-instance-identifier production-db-read \\\n  --source-db-instance-identifier production-db \\\n  --db-instance-class db.r6g.large\n\n# Cross-region replica (disaster recovery)\naws rds create-db-instance-read-replica \\\n  --db-instance-identifier production-db-dr \\\n  --source-db-instance-identifier production-db \\\n  --region eu-west-1"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import psycopg2\nimport boto3\nimport json\n\n# Get credentials from Secrets Manager (don't hardcode!)\nsecrets = boto3.client('secretsmanager')\nsecret = json.loads(\n    secrets.get_secret_value(SecretId='production/database')['SecretString']\n)\n\nconn = psycopg2.connect(\n    host=secret['host'],\n    port=secret['port'],\n    dbname=secret['dbname'],\n    user=secret['username'],\n    password=secret['password'],\n    sslmode='require'\n)\n\ncursor = conn.cursor()\ncursor.execute(\"SELECT COUNT(*) FROM users WHERE active = true\")\nprint(f\"Active users: {cursor.fetchone()[0]}\")\nconn.close()"
        ]
      ]
    }
  ],
