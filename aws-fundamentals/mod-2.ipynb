      "source": [
        "# Aws Fundamentals - mod-2\n\n",
        "**Course:** aws-fundamentals\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Principal (who)  \u2192  Action (what)  \u2192  Resource (which)\n   User/Role         s3:PutObject       arn:aws:s3:::my-bucket/*"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create a user\naws iam create-user --user-name developer\n\n# Create access keys (for CLI/SDK)\naws iam create-access-key --user-name developer\n\n# Add user to a group\naws iam add-user-to-group --user-name developer --group-name Developers\n\n# Create a role (for services like EC2, Lambda)\naws iam create-role --role-name LambdaExecutionRole \\\n  --assume-role-policy-document file://trust-policy.json"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "json",
          "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:GetObject\",\n        \"s3:PutObject\"\n      ],\n      \"Resource\": \"arn:aws:s3:::my-app-data/*\"\n    },\n    {\n      \"Effect\": \"Deny\",\n      \"Action\": \"s3:DeleteBucket\",\n      \"Resource\": \"*\"\n    }\n  ]\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "json",
          "// Read-only S3 access\n{\n  \"Effect\": \"Allow\",\n  \"Action\": [\"s3:GetObject\", \"s3:ListBucket\"],\n  \"Resource\": [\n    \"arn:aws:s3:::my-bucket\",\n    \"arn:aws:s3:::my-bucket/*\"\n  ]\n}\n\n// Allow EC2 instances to assume a role\n// trust-policy.json\n{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [{\n    \"Effect\": \"Allow\",\n    \"Principal\": {\"Service\": \"ec2.amazonaws.com\"},\n    \"Action\": \"sts:AssumeRole\"\n  }]\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import boto3\nimport json\n\niam = boto3.client('iam')\n\n# List all users\nusers = iam.list_users()['Users']\nfor user in users:\n    print(f\"{user['UserName']} (created {user['CreateDate'].strftime('%Y-%m-%d')})\")\n\n# Create a policy\npolicy_doc = {\n    \"Version\": \"2012-10-17\",\n    \"Statement\": [{\n        \"Effect\": \"Allow\",\n        \"Action\": [\"s3:GetObject\"],\n        \"Resource\": \"arn:aws:s3:::my-bucket/*\"\n    }]\n}\n\nresponse = iam.create_policy(\n    PolicyName='S3ReadOnly',\n    PolicyDocument=json.dumps(policy_doc)\n)\nprint(f\"Policy ARN: {response['Policy']['Arn']}\")\n\n# Attach policy to role\niam.attach_role_policy(\n    RoleName='MyAppRole',\n    PolicyArn=response['Policy']['Arn']\n)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# 1. Enable MFA on root account (ALWAYS)\n# 2. Never use root for daily tasks\n# 3. Use roles instead of long-lived access keys\n# 4. Apply least privilege \u2014 start with zero permissions, add as needed\n# 5. Enable CloudTrail for auditing\n\n# Check for access keys older than 90 days\naws iam generate-credential-report\naws iam get-credential-report --output text --query Content | base64 --decode | \\\n  awk -F, '$5 == \"true\" {print $1, $10}'\n\n# List policies attached to a user (audit)\naws iam list-attached-user-policies --user-name developer\naws iam list-user-policies --user-name developer"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import boto3\n\nsts = boto3.client('sts')\n\n# Assume a role (get temporary credentials)\nresponse = sts.assume_role(\n    RoleArn='arn:aws:iam::123456789012:role/CrossAccountAccess',\n    RoleSessionName='my-session',\n    DurationSeconds=3600  # 1 hour\n)\n\ncredentials = response['Credentials']\n# Use these temporary credentials for cross-account access\ns3 = boto3.client('s3',\n    aws_access_key_id=credentials['AccessKeyId'],\n    aws_secret_access_key=credentials['SecretAccessKey'],\n    aws_session_token=credentials['SessionToken']\n)"
        ]
      ]
    }
