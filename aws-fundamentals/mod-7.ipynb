      "source": [
        "# Aws Fundamentals - mod-7\n\n",
        "**Course:** aws-fundamentals\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# lambda_function.py\nimport json\n\ndef lambda_handler(event, context):\n    \"\"\"Process incoming event and return response.\"\"\"\n    name = event.get('name', 'World')\n    \n    return {\n        'statusCode': 200,\n        'headers': {'Content-Type': 'application/json'},\n        'body': json.dumps({\n            'message': f'Hello, {name}!',\n            'requestId': context.aws_request_id\n        })\n    }"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Package and create function\nzip function.zip lambda_function.py\naws lambda create-function \\\n  --function-name hello-api \\\n  --runtime python3.12 \\\n  --handler lambda_function.lambda_handler \\\n  --role arn:aws:iam::123456:role/LambdaExecutionRole \\\n  --zip-file fileb://function.zip \\\n  --timeout 30 \\\n  --memory-size 256\n\n# Invoke directly\naws lambda invoke --function-name hello-api \\\n  --payload '{\"name\": \"Alice\"}' response.json\ncat response.json\n\n# Update code\nzip function.zip lambda_function.py\naws lambda update-function-code \\\n  --function-name hello-api \\\n  --zip-file fileb://function.zip"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create HTTP API (simpler than REST API)\nAPI_ID=$(aws apigatewayv2 create-api \\\n  --name my-api \\\n  --protocol-type HTTP \\\n  --target arn:aws:lambda:us-east-1:123456:function:hello-api \\\n  --query 'ApiId' --output text)\n\necho \"API endpoint: https://$API_ID.execute-api.us-east-1.amazonaws.com\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# S3 trigger: process uploaded files\ndef lambda_handler(event, context):\n    for record in event['Records']:\n        bucket = record['s3']['bucket']['name']\n        key = record['s3']['object']['key']\n        print(f\"New file: s3://{bucket}/{key}\")\n        # Process the file...\n\n# SQS trigger: process queue messages\ndef lambda_handler(event, context):\n    for record in event['Records']:\n        body = json.loads(record['body'])\n        print(f\"Processing order: {body['order_id']}\")\n        # Process order...\n    \n    # Return failed message IDs for retry\n    return {'batchItemFailures': []}\n\n# Scheduled (cron): run daily cleanup\n# EventBridge rule: rate(1 day) or cron(0 2 * * ? *)\ndef lambda_handler(event, context):\n    print(\"Running daily cleanup...\")\n    # Delete old records, send reports, etc."
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import boto3\nimport json\n\nlamb = boto3.client('lambda')\n\n# Invoke a function\nresponse = lamb.invoke(\n    FunctionName='process-order',\n    InvocationType='Event',  # async (don't wait)\n    Payload=json.dumps({'order_id': 'ord-123', 'amount': 99.99})\n)\nprint(f\"Status: {response['StatusCode']}\")  # 202 for async\n\n# List functions\nfunctions = lamb.list_functions()['Functions']\nfor f in functions:\n    print(f\"  {f['FunctionName']} | {f['Runtime']} | {f['MemorySize']}MB\")\n\n# Get function URL (no API Gateway needed)\nresponse = lamb.create_function_url_config(\n    FunctionName='hello-api',\n    AuthType='NONE'  # or AWS_IAM for authenticated\n)\nprint(f\"Function URL: {response['FunctionUrl']}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# template.yaml\nAWSTemplateFormatVersion: '2010-09-09'\nTransform: AWS::Serverless-2016-10-31\n\nGlobals:\n  Function:\n    Runtime: python3.12\n    Timeout: 30\n    MemorySize: 256\n\nResources:\n  ApiFunction:\n    Type: AWS::Serverless::Function\n    Properties:\n      Handler: app.handler\n      CodeUri: src/\n      Events:\n        Api:\n          Type: HttpApi\n          Properties:\n            Path: /users/{id}\n            Method: GET\n      Environment:\n        Variables:\n          TABLE_NAME: !Ref UsersTable\n      Policies:\n        - DynamoDBCrudPolicy:\n            TableName: !Ref UsersTable\n\n  UsersTable:\n    Type: AWS::Serverless::SimpleTable\n    Properties:\n      PrimaryKey:\n        Name: id\n        Type: String"
        ]
      ]
    },
    {
