          "python",
          "import plotly.express as px\n\ndf = px.data.tips()\n\n# Create a grid of scatter plots\nfig = px.scatter(df, x='total_bill', y='tip', \n                 facet_col='day', facet_row='sex',\n                 color='time',\n                 title='Tips Across Days and Sex',\n                 height=800)\nfig.show()\n\n# Histogram with facets\nfig = px.histogram(df, x='total_bill', \n                   facet_col='sex', facet_col_wrap=2,\n                   color='day',\n                   title='Bill Distribution Analysis',\n                   marginal='box')\nfig.show()"
