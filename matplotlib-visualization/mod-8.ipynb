          "python",
          "import plotly.express as px\n\ndf = px.data.tips()\nfig = px.scatter(df, x='total_bill', y='tip', color='sex')\n\n# Save as HTML (fully interactive)\nfig.write_html('plot.html')\n\n# Save as static image (requires kaleido)\nfig.write_image('plot.png', width=1000, height=600)\nfig.write_image('plot.pdf')\nfig.write_image('plot.svg')\n\n# Save as JSON (useful for programmatic access)\nfig.write_json('plot.json')\n\n# Get HTML string for embedding\nhtml_string = fig.to_html()\nprint(html_string)  # Can be inserted into web pages"
