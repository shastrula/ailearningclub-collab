        [
          "python",
          "import seaborn as sns\nimport matplotlib.pyplot as plt\n\ntips = sns.load_dataset('tips')\n\n# Create plot with seaborn\nfig, ax = plt.subplots(figsize=(10, 6))\nsns.scatterplot(data=tips, x='total_bill', y='tip', hue='sex', size='party_size', ax=ax)\n\n# Customize with matplotlib\nax.set_xlabel('Total Bill ($)', fontsize=12, fontweight='bold')\nax.set_ylabel('Tip ($)', fontsize=12, fontweight='bold')\nax.set_title('Tip Amount Analysis', fontsize=14, fontweight='bold', pad=20)\nax.grid(True, alpha=0.3)\n\n# Customize legend\nhandles, labels = ax.get_legend_handles_labels()\nax.legend(handles[:2], labels[:2], title='Sex', loc='upper left', frameon=True, shadow=True)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
