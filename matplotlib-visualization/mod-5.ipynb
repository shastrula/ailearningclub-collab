    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import seaborn as sns\nimport matplotlib.pyplot as plt\nimport pandas as pd\nimport numpy as np\n\n# Load example dataset\ndiamonds = sns.load_dataset('diamonds')\n\n# Basic histogram (no statistical overlay)\nfig, axes = plt.subplots(2, 2, figsize=(14, 10))\n\n# KDE (Kernel Density Estimation) overlay\nsns.histplot(data=diamonds, x='price', kde=True, ax=axes[0, 0])\naxes[0, 0].set_title('Histogram with KDE')\n\n# Distribution plot with rug plot (shows individual data points)\nsns.histplot(data=diamonds, x='price', kde=True, stat='density', ax=axes[0, 1])\naxes[0, 1].set_title('Density Plot')\n\n# Separate distributions by category\nsns.histplot(data=diamonds, x='price', hue='cut', kde=True, ax=axes[1, 0], stat='density')\naxes[1, 0].set_title('Distributions by Category')\n\n# Cumulative distribution\nsns.histplot(data=diamonds, x='price', cumulative=True, ax=axes[1, 1], stat='density')\naxes[1, 1].set_title('Cumulative Distribution')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import seaborn as sns\nimport matplotlib.pyplot as plt\n\n# Load data\ntips = sns.load_dataset('tips')\n\n# Create a categorical plot\nfig = sns.catplot(data=tips, x='day', y='total_bill', hue='sex', kind='box', height=6)\nfig.set_axis_labels('Day of Week', 'Total Bill ($)')\nfig.fig.suptitle('Total Bill by Day and Sex (Box Plot)', y=1.00)\nplt.show()\n\n# Strip plot shows individual points\nfig = sns.catplot(data=tips, x='day', y='total_bill', hue='sex', kind='strip', height=6, jitter=True)\nfig.set_axis_labels('Day of Week', 'Total Bill ($)')\nplt.show()\n\n# Violin plot combines box plot with density estimation\nfig = sns.catplot(data=tips, x='day', y='total_bill', hue='sex', kind='violin', height=6, split=True)\nfig.set_axis_labels('Day of Week', 'Total Bill ($)')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import seaborn as sns\nimport matplotlib.pyplot as plt\n\ntips = sns.load_dataset('tips')\n\n# Scatter plot with categorical encoding\nfig = sns.relplot(data=tips, x='total_bill', y='tip', hue='sex', \n                  size='party_size', style='time', height=7)\nfig.set_axis_labels('Total Bill ($)', 'Tip ($)')\nfig.fig.suptitle('Tip vs Bill with Multiple Encodings', y=1.00)\nplt.show()\n\n# Line plot across a continuous variable\nflights = sns.load_dataset('flights')\nfig = sns.relplot(data=flights, x='month', y='passengers', hue='year', \n                  kind='line', height=6, aspect=1.5)\nfig.set_axis_labels('Month', 'Passengers')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import seaborn as sns\nimport matplotlib.pyplot as plt\n\n# Available themes: 'darkgrid', 'whitegrid', 'dark', 'white', 'ticks'\nthemes = ['darkgrid', 'whitegrid', 'dark', 'white', 'ticks']\n\ntips = sns.load_dataset('tips')\n\nfor theme in themes:\n    sns.set_theme(style=theme)\n    plt.figure(figsize=(8, 4))\n    sns.scatterplot(data=tips, x='total_bill', y='tip')\n    plt.title(f'Theme: {theme}')\n    plt.show()\n\n# Color palettes: deep, muted, pastel, bright, dark, colorblind, husl, Set1, etc.\npalettes = ['deep', 'muted', 'pastel', 'bright', 'colorblind']\n\nfor palette in palettes:\n    sns.set_palette(palette)\n    plt.figure(figsize=(8, 4))\n    sns.scatterplot(data=tips, x='total_bill', y='tip', hue='sex')\n    plt.title(f'Palette: {palette}')\n    plt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
