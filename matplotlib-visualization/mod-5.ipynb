      "source": [
        [
          "python",
          "import seaborn as sns\nimport matplotlib.pyplot as plt\nimport numpy as np\n\n# Correlation matrix heatmap\nflights = sns.load_dataset('flights')\npivot_flights = flights.pivot(index='month', columns='year', values='passengers')\n\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n# Heatmap with annotations\nsns.heatmap(pivot_flights, annot=True, fmt='d', cmap='YlOrRd', ax=axes[0], cbar_kws={'label': 'Passengers'})\naxes[0].set_title('Flight Passengers Heatmap (Annotated)')\n\n# Heatmap with custom color center\nsns.heatmap(pivot_flights, cmap='coolwarm', center=pivot_flights.values.mean(), ax=axes[1], cbar_kws={'label': 'Passengers'})\naxes[1].set_title('Flight Passengers Heatmap (Centered)')\n\nplt.tight_layout()\nplt.show()\n\n# Clustermap (hierarchical clustering)\nsns.clustermap(pivot_flights, cmap='YlOrRd', figsize=(10, 6))\nplt.suptitle('Flight Passengers with Hierarchical Clustering', y=0.98)\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
