        [
          "python",
          "import seaborn as sns\n\n# Contexts: paper, notebook, talk, poster (from smallest to largest text)\nsns.set_context('talk')  # Large fonts for presentations\n# Elements scaled: font_scale, line_width, legend elements\n\n# You can also scale everything uniformly\nsns.set_context('notebook', font_scale=1.5)  # 150% text size"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import seaborn as sns\nimport matplotlib.pyplot as plt\n\ntips = sns.load_dataset('tips')\n\n# Create a grid with separate plots for each day\ng = sns.FacetGrid(tips, col='day', row='sex', height=4)\n\n# Map a plot function to each facet\ng.map(sns.scatterplot, 'total_bill', 'tip')\n\n# Add labels and adjust layout\ng.set_axis_labels('Total Bill ($)', 'Tip ($)')\ng.fig.suptitle('Tips by Day and Sex', y=1.00)\nplt.tight_layout()\nplt.show()\n\n# More complex example with ordering and hue\ng = sns.FacetGrid(tips, col='time', row='sex', hue='day', \n                  col_order=['Lunch', 'Dinner'], height=5)\ng.map(sns.scatterplot, 'total_bill', 'tip', alpha=0.6)\ng.add_legend()\nplt.tight_layout()\nplt.show()\n\n# Using different plot functions\ng = sns.FacetGrid(tips, col='day', col_wrap=3, height=4)\ng.map(sns.histplot, 'total_bill', kde=True, stat='density')\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
