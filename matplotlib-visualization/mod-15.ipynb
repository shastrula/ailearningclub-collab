        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Generate data\nx = np.linspace(0, 10, 100)\ny1 = np.sin(x)\ny2 = np.cos(x)\n\n# Create a publication-quality figure\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\n# Plot 1: Line chart\naxes[0].plot(x, y1, label='sin(x)', color='blue', linewidth=2)\naxes[0].plot(x, y2, label='cos(x)', color='red', linestyle='--')\naxes[0].set_xlabel('x')\naxes[0].set_ylabel('y')\naxes[0].set_title('Trigonometric Functions')\naxes[0].legend()\naxes[0].grid(True, alpha=0.3)\n\n# Plot 2: Histogram\ndata = np.random.normal(0, 1, 1000)\naxes[1].hist(data, bins=30, edgecolor='black', alpha=0.7, color='steelblue')\naxes[1].axvline(data.mean(), color='red', linestyle='--', label=f'Mean: {data.mean():.2f}')\naxes[1].set_xlabel('Value')\naxes[1].set_ylabel('Frequency')\naxes[1].set_title('Normal Distribution')\naxes[1].legend()\n\nplt.tight_layout()\nplt.savefig('figure.png', dpi=150, bbox_inches='tight')\nprint(\"Figure saved as figure.png\")"
        ]
      ]
