          "python",
          "import matplotlib.pyplot as plt\nimport numpy as np\n\n# Generate data\nx = np.linspace(0, 10, 100)\ny = np.sin(x)\n\n# Create figure and axes\nfig, ax = plt.subplots(figsize=(10, 6))\n\n# Plot data\nax.plot(x, y, linewidth=2, label='sin(x)')\nax.scatter(x[::10], y[::10], color='red', s=100, zorder=5, label='sampled points')\n\n# Customize\nax.set_xlabel('x', fontsize=12)\nax.set_ylabel('y', fontsize=12)\nax.set_title('Sine Wave with Sampling', fontsize=14, fontweight='bold')\nax.legend()\nax.grid(True, alpha=0.3)\n\n# Display\nplt.tight_layout()\nplt.show()"
