          "python",
          "fig, ax = plt.subplots(figsize=(10, 6))\n\n# Generate scatter data\nnp.random.seed(42)\nx = np.random.randn(100)\ny = np.random.randn(100)\ncolors = x + y  # Color based on sum\n\n# Create scatter with color mapping\nscatter = ax.scatter(x, y, c=colors, cmap='viridis', s=100, alpha=0.6)\nax.set_xlabel('X')\nax.set_ylabel('Y')\nax.set_title('Scatter Plot with Color Mapping')\n\n# Add colorbar\ncbar = plt.colorbar(scatter, ax=ax)\ncbar.set_label('X + Y')\n\nplt.tight_layout()\nplt.show()"
