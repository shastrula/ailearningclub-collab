      "outputs": [],
      "source": [
        [
          "python",
          "import matplotlib.pyplot as plt\nimport numpy as np\n\n# Generate data from different distributions\ndata_normal = np.random.normal(100, 15, 1000)\ndata_uniform = np.random.uniform(70, 130, 1000)\ndata_bimodal = np.concatenate([\n    np.random.normal(80, 8, 500),\n    np.random.normal(120, 8, 500)\n])\n\n# Create figure with 3 subplots\nfig, axes = plt.subplots(1, 3, figsize=(15, 4))\n\n# Plot 1: Histograms\naxes[0].hist(data_normal, bins=30, alpha=0.7, label='Normal', color='blue')\naxes[0].hist(data_uniform, bins=30, alpha=0.7, label='Uniform', color='orange')\naxes[0].set_title('Overlapping Distributions', fontweight='bold')\naxes[0].set_ylabel('Frequency')\naxes[0].legend()\n\n# Plot 2: Box plot\naxes[1].boxplot([data_normal, data_uniform, data_bimodal],\n                labels=['Normal', 'Uniform', 'Bimodal'])\naxes[1].set_ylabel('Values')\naxes[1].set_title('Distribution Comparison', fontweight='bold')\naxes[1].grid(True, alpha=0.3, axis='y')\n\n# Plot 3: Violin plot (requires violinplot)\naxes[2].violinplot([data_normal, data_uniform, data_bimodal])\naxes[2].set_xticks([1, 2, 3])\naxes[2].set_xticklabels(['Normal', 'Uniform', 'Bimodal'])\naxes[2].set_ylabel('Values')\naxes[2].set_title('Distribution Shapes', fontweight='bold')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
