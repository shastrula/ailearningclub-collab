        [
          "python",
          "from dash import Dash, dcc, html\nimport plotly.express as px\n\napp = Dash(__name__)\ntips = px.data.tips()\nfig = px.scatter(tips, x='total_bill', y='tip', color='sex')\n\napp.layout = html.Div([\n    html.H1('Dash Example'),\n    dcc.Graph(figure=fig)\n])\n\nif __name__ == '__main__':\n    app.run_server(debug=True)"
        ]
