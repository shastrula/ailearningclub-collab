      "source": [
        "# Matplotlib Visualization - mod-2\n\n",
        "**Course:** matplotlib-visualization\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create a dedicated environment (recommended)\nconda create -n viz_env python=3.11\nconda activate viz_env\n\n# Install the visualization stack\nconda install matplotlib seaborn plotly pandas numpy jupyter -c conda-forge\n\n# Optional but recommended: install additional utilities\nconda install scikit-learn scipy statsmodels -c conda-forge\n\n# Verify installation\npython -c \"import matplotlib; print(matplotlib.__version__)\"\npython -c \"import seaborn; print(seaborn.__version__)\"\npython -c \"import plotly; print(plotly.__version__)\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create virtual environment\npython3 -m venv viz_env\nsource viz_env/bin/activate  # On Windows: viz_env\\Scripts\\activate\n\n# Upgrade pip first (important!)\npip install --upgrade pip setuptools wheel\n\n# Install visualization libraries\npip install matplotlib seaborn plotly pandas numpy jupyter\n\n# Verify\npython -c \"import matplotlib; print(matplotlib.__version__)\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# At the top of your notebook\n%matplotlib inline          # Static plots (default)\n# OR\n%matplotlib notebook        # Interactive plots with toolbar\n# OR\n%matplotlib widget          # Interactive plots with ipywidgets (recommended)\n\n# Then import libraries\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport seaborn as sns\nimport plotly.express as px\nimport plotly.graph_objects as go\n\n# Verify\nfig, ax = plt.subplots()\nax.plot([1, 2, 3], [1, 4, 9])\nplt.show()  # Should display inline"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import matplotlib\nprint(matplotlib.get_backend())  # Might print 'agg' or 'tkagg'"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import matplotlib\nmatplotlib.use('agg')  # Set before pyplot import\nimport matplotlib.pyplot as plt\n\n# Now matplotlib uses the agg backend"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import matplotlib.pyplot as plt\n\n# List available styles\nprint(plt.style.available)\n# Output: ['bmh', 'classic', 'dark_background', 'fivethirtyeight', 'ggplot', 'seaborn-v0_8', ...]\n\n# Apply a style\nplt.style.use('seaborn-v0_8-darkgrid')\n\n# Now all plots use this style\nfig, ax = plt.subplots()\nax.plot([1, 2, 3], [1, 4, 9])\nax.set_title('With seaborn style')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import matplotlib.pyplot as plt\n\n# Change specific settings\nplt.rcParams['figure.figsize'] = (12, 6)\nplt.rcParams['font.size'] = 11\nplt.rcParams['lines.linewidth'] = 2.5\nplt.rcParams['axes.labelsize'] = 12\nplt.rcParams['xtick.labelsize'] = 10\nplt.rcParams['ytick.labelsize'] = 10\nplt.rcParams['legend.fontsize'] = 10\nplt.rcParams['axes.grid'] = True\nplt.rcParams['grid.alpha'] = 0.3\n\n# Create figure with new settings\nfig, ax = plt.subplots()\nax.plot([1, 2, 3], [1, 4, 9], label='data')\nax.set_title('With custom rcParams')\nax.legend()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Custom matplotlib style\nlines.linewidth: 2.5\nlines.markersize: 8\nfigure.figsize: 12, 6\nfont.size: 11\naxes.labelsize: 12\naxes.grid: True\ngrid.alpha: 0.3\naxes.facecolor: white\nfigure.facecolor: white"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "plt.style.use('mystyle')"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import matplotlib.pyplot as plt\nimport seaborn as sns\nimport pandas as pd\nimport numpy as np\n\n# Set seaborn style (this modifies matplotlib rcParams)\nsns.set_theme(style='darkgrid', palette='husl')\n\n# Available styles: 'darkgrid', 'whitegrid', 'dark', 'white', 'ticks'\n# Available palettes: 'deep', 'muted', 'pastel', 'bright', 'dark', 'colorblind', 'husl'\n\n# Create sample data\ndata = pd.DataFrame({\n    'x': np.random.randn(100),\n    'y': np.random.randn(100),\n    'category': np.random.choice(['A', 'B', 'C'], 100)\n})\n\n# Plot with seaborn\nsns.scatterplot(data=data, x='x', y='y', hue='category')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import seaborn as sns\nimport matplotlib.pyplot as plt\nimport numpy as np\n\n# Create data\ntips = sns.load_dataset('tips')  # Built-in example dataset\n\n# Different palette options\nfig, axes = plt.subplots(2, 2, figsize=(12, 10))\n\n# Sequential palette (for ordered data)\nsns.scatterplot(data=tips, x='total_bill', y='tip', \n                ax=axes[0, 0], palette='viridis', hue='size')\naxes[0, 0].set_title('Sequential: viridis')\n\n# Diverging palette (for data with meaningful center)\nsns.scatterplot(data=tips, x='total_bill', y='tip', \n                ax=axes[0, 1], palette='coolwarm', hue='size')\naxes[0, 1].set_title('Diverging: coolwarm')\n\n# Categorical palette\nsns.scatterplot(data=tips, x='total_bill', y='tip', \n                ax=axes[1, 0], palette='Set2', hue='sex')\naxes[1, 0].set_title('Categorical: Set2')\n\n# Colorblind-friendly palette\nsns.scatterplot(data=tips, x='total_bill', y='tip', \n                ax=axes[1, 1], palette='colorblind', hue='sex')\naxes[1, 1].set_title('Colorblind-friendly')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import plotly.express as px\nimport plotly.graph_objects as go\nimport pandas as pd\n\n# Plotly Express (high-level, easier API)\ntips = px.data.tips()\nfig = px.scatter(tips, x='total_bill', y='tip', color='sex', size='size')\nfig.show()\n\n# In Jupyter, plotly plots render automatically and interactively"
        ]
      ]
