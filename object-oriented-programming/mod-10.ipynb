          "python",
          "# Python: Abstract classes with abc module\nfrom abc import ABC, abstractmethod\n\nclass DataStore(ABC):\n    \"\"\"Abstract class defining the interface for data storage\"\"\"\n\n    @abstractmethod\n    def connect(self):\n        \"\"\"Establish connection to the data store\"\"\"\n        pass\n\n    @abstractmethod\n    def read(self, key):\n        \"\"\"Read a value by key\"\"\"\n        pass\n\n    @abstractmethod\n    def write(self, key, value):\n        \"\"\"Write a key-value pair\"\"\"\n        pass\n\n    @abstractmethod\n    def delete(self, key):\n        \"\"\"Delete a key-value pair\"\"\"\n        pass\n\n    def exists(self, key):\n        \"\"\"Concrete method - shared implementation\"\"\"\n        try:\n            self.read(key)\n            return True\n        except KeyError:\n            return False\n\n\nclass InMemoryStore(DataStore):\n    def __init__(self):\n        self._data = {}\n        self._connected = False\n\n    def connect(self):\n        self._connected = True\n        return \"Connected to in-memory store\"\n\n    def read(self, key):\n        if key not in self._data:\n            raise KeyError(f\"Key '{key}' not found\")\n        return self._data[key]\n\n    def write(self, key, value):\n        self._data[key] = value\n\n    def delete(self, key):\n        if key in self._data:\n            del self._data[key]\n\n\nclass FileStore(DataStore):\n    def __init__(self, filepath):\n        self.filepath = filepath\n        self._data = {}\n\n    def connect(self):\n        # In real code: open file, parse contents\n        self._data = {}\n        return f\"Connected to file: {self.filepath}\"\n\n    def read(self, key):\n        if key not in self._data:\n            raise KeyError(f\"Key '{key}' not found\")\n        return self._data[key]\n\n    def write(self, key, value):\n        self._data[key] = value\n\n    def delete(self, key):\n        self._data.pop(key, None)\n\n\n# Cannot instantiate abstract class\n# store = DataStore()  # TypeError!\n\n# Must use concrete implementations\nstore = InMemoryStore()\nstore.connect()\nstore.write(\"user:1\", {\"name\": \"Alice\", \"role\": \"admin\"})\nprint(store.read(\"user:1\"))\nprint(store.exists(\"user:1\"))   # True (uses inherited concrete method)\nprint(store.exists(\"user:99\"))  # False"
        ]
      ]
