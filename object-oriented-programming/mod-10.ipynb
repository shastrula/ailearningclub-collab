          "java",
          "// Java: Abstract class\npublic abstract class DataStore {\n    protected String connectionString;\n    protected boolean connected;\n\n    public DataStore(String connectionString) {\n        this.connectionString = connectionString;\n        this.connected = false;\n    }\n\n    // Abstract methods - must be implemented by subclasses\n    public abstract void connect();\n    public abstract Object read(String key);\n    public abstract void write(String key, Object value);\n    public abstract void delete(String key);\n\n    // Concrete method - shared by all subclasses\n    public boolean exists(String key) {\n        try {\n            read(key);\n            return true;\n        } catch (Exception e) {\n            return false;\n        }\n    }\n\n    // Concrete method with shared logic\n    public boolean isConnected() {\n        return connected;\n    }\n}\n\npublic class RedisStore extends DataStore {\n    private Map<String, Object> cache;\n\n    public RedisStore(String host, int port) {\n        super(host + \":\" + port);\n        this.cache = new HashMap<>();\n    }\n\n    @Override\n    public void connect() {\n        // In real code: connect to Redis\n        this.connected = true;\n    }\n\n    @Override\n    public Object read(String key) {\n        if (!cache.containsKey(key)) {\n            throw new RuntimeException(\"Key not found: \" + key);\n        }\n        return cache.get(key);\n    }\n\n    @Override\n    public void write(String key, Object value) {\n        cache.put(key, value);\n    }\n\n    @Override\n    public void delete(String key) {\n        cache.remove(key);\n    }\n}"
        ]
