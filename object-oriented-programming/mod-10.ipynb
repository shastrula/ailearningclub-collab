          "python",
          "# Python: Abstract properties\nfrom abc import ABC, abstractmethod\n\nclass Vehicle(ABC):\n    def __init__(self, make, model):\n        self.make = make\n        self.model = model\n\n    @property\n    @abstractmethod\n    def fuel_type(self):\n        \"\"\"Each vehicle must declare its fuel type\"\"\"\n        pass\n\n    @property\n    @abstractmethod\n    def max_speed(self):\n        \"\"\"Each vehicle must declare its max speed\"\"\"\n        pass\n\n    @abstractmethod\n    def calculate_range(self, fuel_amount):\n        \"\"\"Calculate range given fuel amount\"\"\"\n        pass\n\n    def info(self):\n        return (f\"{self.make} {self.model} | \"\n                f\"Fuel: {self.fuel_type} | \"\n                f\"Max Speed: {self.max_speed} km/h\")\n\n\nclass GasCar(Vehicle):\n    @property\n    def fuel_type(self):\n        return \"Gasoline\"\n\n    @property\n    def max_speed(self):\n        return 220\n\n    def calculate_range(self, fuel_amount):\n        return fuel_amount * 12  # 12 km per liter\n\n\nclass ElectricCar(Vehicle):\n    @property\n    def fuel_type(self):\n        return \"Electric\"\n\n    @property\n    def max_speed(self):\n        return 250\n\n    def calculate_range(self, fuel_amount):\n        return fuel_amount * 6  # 6 km per kWh\n\n\ncars = [GasCar(\"Toyota\", \"Camry\"), ElectricCar(\"Tesla\", \"Model 3\")]\nfor car in cars:\n    print(car.info())\n    print(f\"  Range with 50 units: {car.calculate_range(50)} km\")"
        ]
      ]
