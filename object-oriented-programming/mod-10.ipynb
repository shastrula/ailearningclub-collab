          "python",
          "# Python: Template Method pattern\nfrom abc import ABC, abstractmethod\n\nclass ReportGenerator(ABC):\n    \"\"\"Template: defines the algorithm structure\"\"\"\n\n    def generate_report(self, data):\n        \"\"\"Template method - defines the steps\"\"\"\n        processed = self.process_data(data)\n        formatted = self.format_output(processed)\n        header = self.create_header()\n        footer = self.create_footer()\n        return f\"{header}\\n{formatted}\\n{footer}\"\n\n    @abstractmethod\n    def process_data(self, data):\n        pass\n\n    @abstractmethod\n    def format_output(self, processed_data):\n        pass\n\n    def create_header(self):\n        return \"=\" * 40\n\n    def create_footer(self):\n        return \"=\" * 40\n\n\nclass SalesReport(ReportGenerator):\n    def process_data(self, data):\n        total = sum(item[\"amount\"] for item in data)\n        return {\"items\": data, \"total\": total, \"count\": len(data)}\n\n    def format_output(self, processed):\n        lines = [f\"Sales Report ({processed['count']} transactions)\"]\n        for item in processed[\"items\"]:\n            lines.append(f\"  {item['product']}: ${item['amount']:.2f}\")\n        lines.append(f\"  TOTAL: ${processed['total']:.2f}\")\n        return \"\\n\".join(lines)\n\n\nsales_data = [\n    {\"product\": \"Widget A\", \"amount\": 29.99},\n    {\"product\": \"Widget B\", \"amount\": 49.99},\n    {\"product\": \"Widget C\", \"amount\": 19.99},\n]\n\nreport = SalesReport()\nprint(report.generate_report(sales_data))"
        ]
