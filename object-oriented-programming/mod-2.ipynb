          "python",
          "# WRONG: Mutable default argument (shared across instances!)\nclass StudentWrong:\n    def __init__(self, name, grades=[]):\n        self.name = name\n        self.grades = grades  # All instances share the SAME list!\n\n# CORRECT: Use None as default, create new list in __init__\nclass Student:\n    def __init__(self, name, grades=None):\n        self.name = name\n        self.grades = grades if grades is not None else []\n\n    def add_grade(self, grade):\n        self.grades.append(grade)\n\n    def average_grade(self):\n        if not self.grades:\n            return 0\n        return sum(self.grades) / len(self.grades)\n\n\ns1 = Student(\"Alice\")\ns2 = Student(\"Bob\")\n\ns1.add_grade(95)\ns1.add_grade(87)\nprint(s1.grades)  # [95, 87]\nprint(s2.grades)  # [] (correctly independent)"
        ]
      ]
