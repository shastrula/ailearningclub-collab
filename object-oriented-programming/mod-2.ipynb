          "python",
          "# Python: Dynamic attribute addition\nclass Config:\n    def __init__(self):\n        self.debug = False\n        self.version = \"1.0\"\n\nconfig = Config()\nconfig.database_url = \"localhost:5432\"  # Added dynamically!\nprint(config.database_url)  # Works fine\n\n# Using __slots__ to prevent dynamic attributes (optimization)\nclass StrictConfig:\n    __slots__ = ['debug', 'version']\n\n    def __init__(self):\n        self.debug = False\n        self.version = \"1.0\"\n\nstrict = StrictConfig()\n# strict.database_url = \"localhost\"  # AttributeError!"
        ]
