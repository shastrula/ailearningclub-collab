          "python",
          "# Python: Instance variables\nclass Employee:\n    def __init__(self, name, department, salary):\n        self.name = name              # Instance variable\n        self.department = department  # Instance variable\n        self.salary = salary          # Instance variable\n\n    def give_raise(self, amount):\n        self.salary += amount\n\n# Each object has its own data\nemp1 = Employee(\"Alice\", \"Engineering\", 85000)\nemp2 = Employee(\"Bob\", \"Marketing\", 72000)\n\nemp1.give_raise(5000)\nprint(emp1.salary)  # 90000\nprint(emp2.salary)  # 72000 (unaffected)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "// Java: Instance variables\npublic class Employee {\n    private String name;          // Instance variable\n    private String department;    // Instance variable\n    private double salary;        // Instance variable\n\n    public Employee(String name, String department, double salary) {\n        this.name = name;\n        this.department = department;\n        this.salary = salary;\n    }\n\n    public void giveRaise(double amount) {\n        this.salary += amount;\n    }\n\n    public double getSalary() {\n        return salary;\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Python: Class variables vs instance variables\nclass Employee:\n    # Class variable - shared by all instances\n    company_name = \"TechCorp\"\n    employee_count = 0\n\n    def __init__(self, name, role):\n        # Instance variables - unique to each instance\n        self.name = name\n        self.role = role\n        self.employee_id = Employee.employee_count + 1\n        Employee.employee_count += 1\n\n    def display(self):\n        return f\"{self.name} ({self.role}) at {Employee.company_name}\"\n\n# All employees share the company name\nemp1 = Employee(\"Alice\", \"Developer\")\nemp2 = Employee(\"Bob\", \"Designer\")\n\nprint(emp1.display())  # Alice (Developer) at TechCorp\nprint(emp2.display())  # Bob (Designer) at TechCorp\nprint(Employee.employee_count)  # 2\n\n# Changing class variable affects all instances\nEmployee.company_name = \"MegaCorp\"\nprint(emp1.display())  # Alice (Developer) at MegaCorp"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "// Java: Static (class) variables\npublic class Employee {\n    // Static variable - shared by all instances\n    private static String companyName = \"TechCorp\";\n    private static int employeeCount = 0;\n\n    // Instance variables\n    private String name;\n    private String role;\n    private int employeeId;\n\n    public Employee(String name, String role) {\n        this.name = name;\n        this.role = role;\n        employeeCount++;\n        this.employeeId = employeeCount;\n    }\n\n    public static int getEmployeeCount() {\n        return employeeCount;\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Python: Properties and computed attributes\nclass Rectangle:\n    def __init__(self, width, height):\n        self._width = width\n        self._height = height\n\n    @property\n    def width(self):\n        return self._width\n\n    @width.setter\n    def width(self, value):\n        if value <= 0:\n            raise ValueError(\"Width must be positive\")\n        self._width = value\n\n    @property\n    def height(self):\n        return self._height\n\n    @height.setter\n    def height(self, value):\n        if value <= 0:\n            raise ValueError(\"Height must be positive\")\n        self._height = value\n\n    @property\n    def area(self):\n        \"\"\"Computed attribute - not stored, calculated on access\"\"\"\n        return self._width * self._height\n\n    @property\n    def perimeter(self):\n        \"\"\"Another computed attribute\"\"\"\n        return 2 * (self._width + self._height)\n\n\nrect = Rectangle(5, 3)\nprint(rect.area)       # 15\nprint(rect.perimeter)  # 16\n\nrect.width = 10\nprint(rect.area)       # 30 (automatically recalculated)"
        ]
      ]
    },
