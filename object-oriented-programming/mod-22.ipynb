          "python",
          "# SMELL: Feature Envy - method uses another object's data extensively\nclass Order:\n    def __init__(self, customer, items):\n        self.customer = customer\n        self.items = items\n\n    def get_discount(self):\n        # This method is too interested in Customer's data\n        if self.customer.loyalty_years > 5:\n            if self.customer.total_purchases > 10000:\n                return 0.20\n            return 0.10\n        elif self.customer.total_purchases > 5000:\n            return 0.05\n        return 0"
        ]
      ]
