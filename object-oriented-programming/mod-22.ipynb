          "python",
          "# REFACTORED: Extract methods and use configuration objects\nclass ReportConfig:\n    def __init__(self, year, month, department):\n        self.year = year\n        self.month = month\n        self.department = department\n        self.include_charts = False\n        self.format_type = \"pdf\"\n\nclass DeliveryConfig:\n    def __init__(self):\n        self.send_email = False\n        self.recipients = []\n        self.save_to_disk = False\n        self.file_path = None\n\nclass ReportGenerator:\n    def generate(self, report_config: ReportConfig):\n        data = self._fetch_data(report_config)\n        processed = self._process_data(data)\n        return self._format_report(processed, report_config)\n\n    def deliver(self, report, delivery_config: DeliveryConfig):\n        if delivery_config.send_email:\n            self._send_email(report, delivery_config.recipients)\n        if delivery_config.save_to_disk:\n            self._save_file(report, delivery_config.file_path)\n\n    def _fetch_data(self, config):\n        return {\"department\": config.department, \"period\": f\"{config.year}-{config.month}\"}\n\n    def _process_data(self, data):\n        return {\"processed\": True, **data}\n\n    def _format_report(self, data, config):\n        return f\"Report: {data} (format: {config.format_type})\"\n\n    def _send_email(self, report, recipients):\n        print(f\"Emailing to {recipients}\")\n\n    def _save_file(self, report, path):\n        print(f\"Saving to {path}\")"
        ]
