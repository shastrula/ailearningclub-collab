          "python",
          "# REFACTORED: Separate responsibilities\nclass OrderService:\n    def __init__(self, inventory, payment, shipping):\n        self.inventory = inventory\n        self.payment = payment\n        self.shipping = shipping\n        self.orders = {}\n\n    def create_order(self, customer_id, items):\n        for item_id, qty in items.items():\n            if not self.inventory.check_stock(item_id, qty):\n                raise ValueError(f\"Insufficient stock: {item_id}\")\n        order = {\"customer_id\": customer_id, \"items\": items, \"status\": \"pending\"}\n        order_id = f\"ORD-{len(self.orders)+1}\"\n        self.orders[order_id] = order\n        return order_id\n\nclass InventoryService:\n    def __init__(self):\n        self.stock = {}\n\n    def check_stock(self, item_id, quantity):\n        return self.stock.get(item_id, 0) >= quantity\n\n    def reserve(self, item_id, quantity):\n        if self.check_stock(item_id, quantity):\n            self.stock[item_id] -= quantity\n            return True\n        return False\n\nclass PaymentService:\n    def process(self, amount, payment_method):\n        return {\"status\": \"charged\", \"amount\": amount}\n\nclass ShippingService:\n    def calculate_cost(self, address, weight):\n        return weight * 0.5 + 5.00"
        ]
