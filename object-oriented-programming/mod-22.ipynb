          "# SMELL: God Class - does everything\nclass OrderSystem:\n    def __init__(self):\n        self.orders = {}\n        self.inventory = {}\n        self.customers = {}\n\n    def create_order(self, customer_id, items): ...\n    def cancel_order(self, order_id): ...\n    def update_inventory(self, item_id, quantity): ...\n    def check_stock(self, item_id): ...\n    def register_customer(self, name, email): ...\n    def send_confirmation_email(self, order_id): ...\n    def calculate_shipping(self, address): ...\n    def process_payment(self, order_id, card_info): ...\n    def generate_invoice(self, order_id): ...\n    def apply_discount(self, order_id, code): ...\n    # ... 50+ more methods"
