          "python",
          "# Python: Small, focused interfaces\nfrom abc import ABC, abstractmethod\n\nclass Readable(ABC):\n    @abstractmethod\n    def read(self) -> str:\n        pass\n\nclass Writable(ABC):\n    @abstractmethod\n    def write(self, data: str) -> None:\n        pass\n\nclass Closeable(ABC):\n    @abstractmethod\n    def close(self) -> None:\n        pass\n\n# Compose interfaces as needed\nclass ReadWriteStream(Readable, Writable, Closeable):\n    \"\"\"Combines multiple interfaces\"\"\"\n    pass\n\nclass ReadOnlyFile(Readable, Closeable):\n    def __init__(self, content):\n        self._content = content\n        self._open = True\n\n    def read(self) -> str:\n        if not self._open:\n            raise IOError(\"File is closed\")\n        return self._content\n\n    def close(self) -> None:\n        self._open = False"
