          "python",
          "# Python: Protocol-based interfaces (structural typing)\nfrom typing import Protocol, runtime_checkable\n\n@runtime_checkable\nclass Drawable(Protocol):\n    def draw(self) -> str:\n        ...\n\n    def get_bounds(self) -> tuple:\n        ...\n\n@runtime_checkable\nclass Resizable(Protocol):\n    def resize(self, factor: float) -> None:\n        ...\n\n    def get_size(self) -> tuple:\n        ...\n\n\n# Classes do NOT need to explicitly inherit from the Protocol\nclass Circle:\n    def __init__(self, x, y, radius):\n        self.x = x\n        self.y = y\n        self.radius = radius\n\n    def draw(self) -> str:\n        return f\"Drawing circle at ({self.x}, {self.y}) with radius {self.radius}\"\n\n    def get_bounds(self) -> tuple:\n        return (self.x - self.radius, self.y - self.radius,\n                self.x + self.radius, self.y + self.radius)\n\n    def resize(self, factor: float) -> None:\n        self.radius *= factor\n\n    def get_size(self) -> tuple:\n        return (self.radius * 2, self.radius * 2)\n\n\nclass TextBox:\n    def __init__(self, x, y, width, height, text):\n        self.x = x\n        self.y = y\n        self.width = width\n        self.height = height\n        self.text = text\n\n    def draw(self) -> str:\n        return f\"Drawing text '{self.text}' at ({self.x}, {self.y})\"\n\n    def get_bounds(self) -> tuple:\n        return (self.x, self.y, self.x + self.width, self.y + self.height)\n\n    def resize(self, factor: float) -> None:\n        self.width *= factor\n        self.height *= factor\n\n    def get_size(self) -> tuple:\n        return (self.width, self.height)\n\n\n# Type checking with protocols\ndef render_all(items: list[Drawable]) -> list[str]:\n    return [item.draw() for item in items]\n\ndef scale_all(items: list[Resizable], factor: float) -> None:\n    for item in items:\n        item.resize(factor)\n\n\n# Runtime protocol checking\ncircle = Circle(10, 10, 5)\nprint(isinstance(circle, Drawable))   # True\nprint(isinstance(circle, Resizable))  # True\n\nshapes = [Circle(0, 0, 5), TextBox(10, 10, 100, 50, \"Hello\")]\nprint(render_all(shapes))"
        ]
      ]
