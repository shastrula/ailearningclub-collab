          "python",
          "# Python: ABC as strict interface\nfrom abc import ABC, abstractmethod\n\nclass CacheInterface(ABC):\n    \"\"\"Pure interface - all methods are abstract\"\"\"\n\n    @abstractmethod\n    def get(self, key: str):\n        pass\n\n    @abstractmethod\n    def set(self, key: str, value, ttl: int = 300):\n        pass\n\n    @abstractmethod\n    def delete(self, key: str) -> bool:\n        pass\n\n    @abstractmethod\n    def clear(self) -> int:\n        pass\n\n    @abstractmethod\n    def has(self, key: str) -> bool:\n        pass\n\n\nclass MemoryCache(CacheInterface):\n    def __init__(self):\n        self._store = {}\n        self._expiry = {}\n\n    def get(self, key: str):\n        import time\n        if key in self._expiry and time.time() > self._expiry[key]:\n            self.delete(key)\n            return None\n        return self._store.get(key)\n\n    def set(self, key: str, value, ttl: int = 300):\n        import time\n        self._store[key] = value\n        self._expiry[key] = time.time() + ttl\n\n    def delete(self, key: str) -> bool:\n        if key in self._store:\n            del self._store[key]\n            self._expiry.pop(key, None)\n            return True\n        return False\n\n    def clear(self) -> int:\n        count = len(self._store)\n        self._store.clear()\n        self._expiry.clear()\n        return count\n\n    def has(self, key: str) -> bool:\n        return self.get(key) is not None\n\n\nclass RedisCache(CacheInterface):\n    def __init__(self, host=\"localhost\", port=6379):\n        self.host = host\n        self.port = port\n        self._store = {}  # Simulated\n\n    def get(self, key: str):\n        return self._store.get(key)\n\n    def set(self, key: str, value, ttl: int = 300):\n        self._store[key] = value\n\n    def delete(self, key: str) -> bool:\n        return self._store.pop(key, None) is not None\n\n    def clear(self) -> int:\n        count = len(self._store)\n        self._store.clear()\n        return count\n\n    def has(self, key: str) -> bool:\n        return key in self._store\n\n\n# Both satisfy the same interface\ndef warm_cache(cache: CacheInterface, data: dict):\n    for key, value in data.items():\n        cache.set(key, value)\n\ncache = MemoryCache()\nwarm_cache(cache, {\"user:1\": \"Alice\", \"user:2\": \"Bob\"})\nprint(cache.get(\"user:1\"))  # Alice\nprint(cache.has(\"user:3\"))  # False"
        ]
