      "source": [
        [
          "python",
          "# Python: Composition for a game character system\nclass HealthComponent:\n    def __init__(self, max_hp):\n        self.max_hp = max_hp\n        self.current_hp = max_hp\n\n    def take_damage(self, amount):\n        self.current_hp = max(0, self.current_hp - amount)\n        return self.current_hp > 0  # Returns True if alive\n\n    def heal(self, amount):\n        self.current_hp = min(self.max_hp, self.current_hp + amount)\n\n    @property\n    def is_alive(self):\n        return self.current_hp > 0\n\n\nclass InventoryComponent:\n    def __init__(self, capacity):\n        self.capacity = capacity\n        self.items = []\n\n    def add_item(self, item):\n        if len(self.items) >= self.capacity:\n            return False, \"Inventory full\"\n        self.items.append(item)\n        return True, f\"Added {item}\"\n\n    def remove_item(self, item):\n        if item in self.items:\n            self.items.remove(item)\n            return True\n        return False\n\n\nclass CombatComponent:\n    def __init__(self, attack_power, defense):\n        self.attack_power = attack_power\n        self.defense = defense\n\n    def calculate_damage(self, target_defense):\n        return max(1, self.attack_power - target_defense)\n\n\nclass MagicComponent:\n    def __init__(self, max_mana, spells=None):\n        self.max_mana = max_mana\n        self.current_mana = max_mana\n        self.spells = spells or []\n\n    def cast_spell(self, spell_name, cost):\n        if spell_name not in self.spells:\n            return None, \"Unknown spell\"\n        if self.current_mana < cost:\n            return None, \"Not enough mana\"\n        self.current_mana -= cost\n        return spell_name, \"Cast successfully\"\n\n\nclass Character:\n    \"\"\"Composed of components - flexible and extensible\"\"\"\n\n    def __init__(self, name, health, inventory=None,\n                 combat=None, magic=None):\n        self.name = name\n        self.health = health\n        self.inventory = inventory\n        self.combat = combat\n        self.magic = magic\n\n    def status(self):\n        parts = [f\"{self.name}: HP={self.health.current_hp}/{self.health.max_hp}\"]\n        if self.magic:\n            parts.append(f\"MP={self.magic.current_mana}/{self.magic.max_mana}\")\n        if self.inventory:\n            parts.append(f\"Items={len(self.inventory.items)}/{self.inventory.capacity}\")\n        return \" | \".join(parts)\n\n\n# Create diverse characters through composition\nwarrior = Character(\n    \"Thorin\",\n    health=HealthComponent(200),\n    inventory=InventoryComponent(20),\n    combat=CombatComponent(attack_power=25, defense=15)\n)\n\nmage = Character(\n    \"Gandalf\",\n    health=HealthComponent(100),\n    inventory=InventoryComponent(10),\n    combat=CombatComponent(attack_power=10, defense=5),\n    magic=MagicComponent(200, spells=[\"fireball\", \"heal\", \"shield\"])\n)\n\n# A merchant NPC - no combat needed!\nmerchant = Character(\n    \"Bob\",\n    health=HealthComponent(50),\n    inventory=InventoryComponent(100)\n)\n\nprint(warrior.status())\nprint(mage.status())\nprint(merchant.status())\n\n# Combat interaction\ndamage = warrior.combat.calculate_damage(mage.combat.defense)\nmage.health.take_damage(damage)\nprint(f\"\\n{warrior.name} attacks {mage.name} for {damage} damage!\")\nprint(mage.status())"
        ]
      ]
    },
