      "source": [
        [
          "python",
          "# The fragile base class problem\nclass Bird:\n    def __init__(self, name):\n        self.name = name\n\n    def fly(self):\n        return f\"{self.name} is flying\"\n\n    def eat(self):\n        return f\"{self.name} is eating\"\n\n\nclass Penguin(Bird):\n    def fly(self):\n        # Penguins can't fly! We have to override and break the contract\n        raise NotImplementedError(\"Penguins can't fly!\")\n\n    def swim(self):\n        return f\"{self.name} is swimming\"\n\n\n# This violates the Liskov Substitution Principle\ndef make_birds_fly(birds):\n    for bird in birds:\n        print(bird.fly())  # Breaks for Penguin!"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Python: Composition - building with components\nclass FlyingAbility:\n    def __init__(self, speed=30):\n        self.speed = speed\n\n    def fly(self, name):\n        return f\"{name} is flying at {self.speed} km/h\"\n\n\nclass SwimmingAbility:\n    def __init__(self, depth=5):\n        self.max_depth = depth\n\n    def swim(self, name):\n        return f\"{name} is swimming (max depth: {self.max_depth}m)\"\n\n\nclass WalkingAbility:\n    def __init__(self, speed=5):\n        self.speed = speed\n\n    def walk(self, name):\n        return f\"{name} is walking at {self.speed} km/h\"\n\n\nclass Bird:\n    def __init__(self, name, abilities=None):\n        self.name = name\n        self.abilities = abilities or {}\n\n    def perform(self, action):\n        ability = self.abilities.get(action)\n        if ability is None:\n            return f\"{self.name} cannot {action}\"\n        method = getattr(ability, action)\n        return method(self.name)\n\n\n# Compose birds with appropriate abilities\neagle = Bird(\"Eagle\", {\n    \"fly\": FlyingAbility(speed=160),\n    \"walk\": WalkingAbility(speed=3)\n})\n\npenguin = Bird(\"Penguin\", {\n    \"swim\": SwimmingAbility(depth=500),\n    \"walk\": WalkingAbility(speed=4)\n})\n\nduck = Bird(\"Duck\", {\n    \"fly\": FlyingAbility(speed=80),\n    \"swim\": SwimmingAbility(depth=3),\n    \"walk\": WalkingAbility(speed=2)\n})\n\nprint(eagle.perform(\"fly\"))     # Eagle is flying at 160 km/h\nprint(penguin.perform(\"swim\"))  # Penguin is swimming (max depth: 500m)\nprint(penguin.perform(\"fly\"))   # Penguin cannot fly\nprint(duck.perform(\"fly\"))      # Duck is flying at 80 km/h"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
