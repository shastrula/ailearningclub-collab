          "python",
          "# Python: Access conventions\nclass BankAccount:\n    def __init__(self, owner, account_number, initial_balance=0):\n        self.owner_name = owner              # Public\n        self._account_number = account_number  # Protected (convention)\n        self.__balance = initial_balance       # Private (name mangled)\n        self.__transaction_log = []\n\n    def get_balance(self):\n        return self.__balance\n\n    def deposit(self, amount):\n        if amount <= 0:\n            raise ValueError(\"Deposit amount must be positive\")\n        self.__balance += amount\n        self.__log_transaction(\"DEPOSIT\", amount)\n        return self.__balance\n\n    def withdraw(self, amount):\n        if amount <= 0:\n            raise ValueError(\"Withdrawal amount must be positive\")\n        if amount > self.__balance:\n            raise ValueError(\"Insufficient funds\")\n        self.__balance -= amount\n        self.__log_transaction(\"WITHDRAWAL\", amount)\n        return self.__balance\n\n    def __log_transaction(self, trans_type, amount):\n        self.__transaction_log.append({\n            \"type\": trans_type,\n            \"amount\": amount,\n            \"balance\": self.__balance\n        })\n\n    def get_statement(self):\n        return list(self.__transaction_log)\n\n\naccount = BankAccount(\"Alice\", \"ACC-001\", 1000)\naccount.deposit(500)\naccount.withdraw(200)\n\nprint(account.get_balance())        # 1300\nprint(account.owner_name)           # Alice (public)\n# print(account.__balance)          # AttributeError! (name mangled)"
        ]
      ]
