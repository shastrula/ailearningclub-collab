          "java",
          "// Java: Access modifiers\npublic class BankAccount {\n    private String accountNumber;     // Only this class can access\n    private double balance;           // Hidden from outside\n    protected String accountType;     // Accessible to subclasses\n    public String ownerName;          // Accessible from anywhere\n\n    public BankAccount(String owner, String accountNumber, double initialBalance) {\n        this.ownerName = owner;\n        this.accountNumber = accountNumber;\n        this.balance = initialBalance;\n        this.accountType = \"Checking\";\n    }\n\n    public double getBalance() {\n        return balance;\n    }\n\n    public boolean deposit(double amount) {\n        if (amount <= 0) {\n            return false;\n        }\n        balance += amount;\n        logTransaction(\"DEPOSIT\", amount);\n        return true;\n    }\n\n    public boolean withdraw(double amount) {\n        if (amount <= 0 || amount > balance) {\n            return false;\n        }\n        balance -= amount;\n        logTransaction(\"WITHDRAWAL\", amount);\n        return true;\n    }\n\n    private void logTransaction(String type, double amount) {\n        System.out.println(type + \": $\" + amount + \" | Balance: $\" + balance);\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
