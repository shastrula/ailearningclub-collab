          "python",
          "# Python: Testing with mocks\nfrom unittest.mock import Mock, patch, MagicMock\n\nclass EmailService:\n    def send(self, to, subject, body):\n        # In real code: sends actual email\n        pass\n\nclass UserRepository:\n    def save(self, user_data):\n        # In real code: writes to database\n        pass\n\n    def find_by_email(self, email):\n        # In real code: queries database\n        pass\n\nclass UserRegistrationService:\n    def __init__(self, user_repo, email_service):\n        self.user_repo = user_repo\n        self.email_service = email_service\n\n    def register(self, username, email, password):\n        existing = self.user_repo.find_by_email(email)\n        if existing:\n            raise ValueError(\"Email already registered\")\n\n        user_data = {\n            \"username\": username,\n            \"email\": email,\n            \"password_hash\": self._hash(password)\n        }\n        user_id = self.user_repo.save(user_data)\n        self.email_service.send(\n            to=email,\n            subject=\"Welcome!\",\n            body=f\"Hi {username}, welcome aboard!\"\n        )\n        return user_id\n\n    def _hash(self, password):\n        import hashlib\n        return hashlib.sha256(password.encode()).hexdigest()\n\n\nclass TestUserRegistration(unittest.TestCase):\n    def setUp(self):\n        self.mock_repo = Mock(spec=UserRepository)\n        self.mock_email = Mock(spec=EmailService)\n        self.service = UserRegistrationService(self.mock_repo, self.mock_email)\n\n    def test_successful_registration(self):\n        self.mock_repo.find_by_email.return_value = None\n        self.mock_repo.save.return_value = \"user-123\"\n\n        result = self.service.register(\"alice\", \"alice@example.com\", \"pass123\")\n\n        self.assertEqual(result, \"user-123\")\n        self.mock_repo.save.assert_called_once()\n        self.mock_email.send.assert_called_once_with(\n            to=\"alice@example.com\",\n            subject=\"Welcome!\",\n            body=\"Hi alice, welcome aboard!\"\n        )\n\n    def test_duplicate_email_raises_error(self):\n        self.mock_repo.find_by_email.return_value = {\"email\": \"alice@example.com\"}\n\n        with self.assertRaises(ValueError):\n            self.service.register(\"alice\", \"alice@example.com\", \"pass123\")\n\n        # Email should NOT be sent\n        self.mock_email.send.assert_not_called()\n        # User should NOT be saved\n        self.mock_repo.save.assert_not_called()"
