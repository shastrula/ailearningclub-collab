          "python",
          "# Python: Testing abstract classes and their implementations\nfrom abc import ABC, abstractmethod\n\nclass Validator(ABC):\n    @abstractmethod\n    def validate(self, value) -> tuple:\n        pass\n\nclass EmailValidator(Validator):\n    def validate(self, value) -> tuple:\n        if not value or \"@\" not in value:\n            return False, \"Invalid email format\"\n        local, domain = value.rsplit(\"@\", 1)\n        if not local or not domain or \".\" not in domain:\n            return False, \"Invalid email format\"\n        return True, \"Valid\"\n\nclass AgeValidator(Validator):\n    def __init__(self, min_age=0, max_age=150):\n        self.min_age = min_age\n        self.max_age = max_age\n\n    def validate(self, value) -> tuple:\n        if not isinstance(value, int):\n            return False, \"Age must be an integer\"\n        if value < self.min_age or value > self.max_age:\n            return False, f\"Age must be between {self.min_age} and {self.max_age}\"\n        return True, \"Valid\"\n\n\nclass TestEmailValidator(unittest.TestCase):\n    def setUp(self):\n        self.validator = EmailValidator()\n\n    def test_valid_emails(self):\n        valid_cases = [\"user@example.com\", \"a@b.co\", \"test.name@domain.org\"]\n        for email in valid_cases:\n            is_valid, _ = self.validator.validate(email)\n            self.assertTrue(is_valid, f\"Expected {email} to be valid\")\n\n    def test_invalid_emails(self):\n        invalid_cases = [\"\", \"noat\", \"@no-local.com\", \"no-domain@\", \"no@dots\"]\n        for email in invalid_cases:\n            is_valid, _ = self.validator.validate(email)\n            self.assertFalse(is_valid, f\"Expected {email} to be invalid\")\n\n\nclass TestAgeValidator(unittest.TestCase):\n    def setUp(self):\n        self.validator = AgeValidator(min_age=18, max_age=120)\n\n    def test_valid_age(self):\n        is_valid, _ = self.validator.validate(25)\n        self.assertTrue(is_valid)\n\n    def test_too_young(self):\n        is_valid, msg = self.validator.validate(15)\n        self.assertFalse(is_valid)\n        self.assertIn(\"18\", msg)\n\n    def test_non_integer(self):\n        is_valid, msg = self.validator.validate(\"twenty\")\n        self.assertFalse(is_valid)\n        self.assertIn(\"integer\", msg)"
        ]
      ]
