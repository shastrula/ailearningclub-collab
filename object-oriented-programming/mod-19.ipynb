          "python",
          "# Python: Bounded TypeVar\nfrom typing import TypeVar\n\nclass Comparable:\n    def __lt__(self, other): ...\n    def __gt__(self, other): ...\n\nCT = TypeVar('CT', bound='Comparable')\n\ndef find_max(items: list[CT]) -> CT:\n    if not items:\n        raise ValueError(\"Empty list\")\n    max_item = items[0]\n    for item in items[1:]:\n        if item > max_item:\n            max_item = item\n    return max_item\n\n# Works with any comparable type\nprint(find_max([3, 1, 4, 1, 5]))       # 5\nprint(find_max([\"apple\", \"banana\"]))    # \"banana\""
        ]
      ]
