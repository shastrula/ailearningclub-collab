          "java",
          "// Java: Generic class with multiple type parameters\npublic class Pair<K, V> {\n    private final K key;\n    private final V value;\n\n    public Pair(K key, V value) {\n        this.key = key;\n        this.value = value;\n    }\n\n    public K getKey() { return key; }\n    public V getValue() { return value; }\n\n    @Override\n    public String toString() {\n        return \"(\" + key + \", \" + value + \")\";\n    }\n}\n\n// Usage\nPair<String, Integer> age = new Pair<>(\"Alice\", 30);\nPair<Integer, List<String>> indexed = new Pair<>(1, List.of(\"a\", \"b\"));"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Python: Generic classes with typing\nfrom typing import TypeVar, Generic, Optional\n\nT = TypeVar('T')\nK = TypeVar('K')\nV = TypeVar('V')\n\nclass Box(Generic[T]):\n    def __init__(self, content: Optional[T] = None):\n        self._content = content\n\n    def put(self, item: T) -> None:\n        self._content = item\n\n    def get(self) -> Optional[T]:\n        return self._content\n\n    def is_empty(self) -> bool:\n        return self._content is None\n\n    def __repr__(self):\n        return f\"Box({self._content!r})\"\n\n\n# Type hints guide usage\nstring_box: Box[str] = Box(\"Hello\")\nint_box: Box[int] = Box(42)\n\nprint(string_box.get())  # \"Hello\"\nprint(int_box.get())     # 42\n\n\nclass Pair(Generic[K, V]):\n    def __init__(self, key: K, value: V):\n        self.key = key\n        self.value = value\n\n    def __repr__(self):\n        return f\"Pair({self.key!r}, {self.value!r})\"\n\n\npair: Pair[str, int] = Pair(\"age\", 30)\nprint(pair)  # Pair('age', 30)"
        ]
      ]
    },
