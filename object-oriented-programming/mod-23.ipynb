        [
          "python",
          "# Python: Mixin pattern\nimport json\n\nclass SerializableMixin:\n    def to_dict(self):\n        return {k: v for k, v in self.__dict__.items() if not k.startswith('_')}\n\n    def to_json(self):\n        return json.dumps(self.to_dict(), default=str)\n\n    @classmethod\n    def from_dict(cls, data):\n        return cls(**data)\n\n\nclass ComparableMixin:\n    def __eq__(self, other):\n        if type(self) != type(other):\n            return False\n        return self.__dict__ == other.__dict__\n\n    def __ne__(self, other):\n        return not self.__eq__(other)\n\n\nclass DisplayMixin:\n    def display(self):\n        class_name = self.__class__.__name__\n        attrs = \", \".join(f\"{k}={v!r}\" for k, v in self.__dict__.items()\n                         if not k.startswith('_'))\n        return f\"{class_name}({attrs})\"\n\n\nclass User(SerializableMixin, ComparableMixin, DisplayMixin):\n    def __init__(self, name, email, role=\"user\"):\n        self.name = name\n        self.email = email\n        self.role = role\n\n\nuser = User(\"Alice\", \"alice@example.com\", \"admin\")\nprint(user.display())       # User(name='Alice', email='alice@example.com', role='admin')\nprint(user.to_json())       # {\"name\": \"Alice\", \"email\": \"alice@example.com\", \"role\": \"admin\"}\n\nuser2 = User.from_dict({\"name\": \"Alice\", \"email\": \"alice@example.com\", \"role\": \"admin\"})\nprint(user == user2)        # True"
        ]
      ]
