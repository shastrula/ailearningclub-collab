        [
          "python",
          "# Python: __slots__ for memory-efficient objects\nclass Point:\n    __slots__ = ('x', 'y')\n\n    def __init__(self, x, y):\n        self.x = x\n        self.y = y\n\n    def distance_to(self, other):\n        return ((self.x - other.x) ** 2 + (self.y - other.y) ** 2) ** 0.5\n\n    def __repr__(self):\n        return f\"Point({self.x}, {self.y})\"\n\n\n# Significantly less memory per instance\n# Cannot add arbitrary attributes\np = Point(3, 4)\n# p.z = 5  # AttributeError: 'Point' object has no attribute 'z'"
        ]
      ]
    },
