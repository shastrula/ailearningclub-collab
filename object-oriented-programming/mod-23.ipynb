          "python",
          "# Python: NamedTuple for simple immutable classes\nfrom typing import NamedTuple\n\nclass Color(NamedTuple):\n    red: int\n    green: int\n    blue: int\n\n    @property\n    def hex(self):\n        return f\"#{self.red:02x}{self.green:02x}{self.blue:02x}\"\n\n    def blend(self, other: 'Color', ratio: float = 0.5) -> 'Color':\n        return Color(\n            red=int(self.red * (1 - ratio) + other.red * ratio),\n            green=int(self.green * (1 - ratio) + other.green * ratio),\n            blue=int(self.blue * (1 - ratio) + other.blue * ratio),\n        )\n\n\nred = Color(255, 0, 0)\nblue = Color(0, 0, 255)\npurple = red.blend(blue)\n\nprint(f\"{red.hex} + {blue.hex} = {purple.hex}\")  # #ff0000 + #0000ff = #7f007f"
        ]
      ]
