          "python",
          "# Python: Static methods\nclass MathUtils:\n    @staticmethod\n    def is_prime(n):\n        \"\"\"Utility function - no access to self or cls needed\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n ** 0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    @staticmethod\n    def factorial(n):\n        if n <= 1:\n            return 1\n        result = 1\n        for i in range(2, n + 1):\n            result *= i\n        return result\n\n    @staticmethod\n    def fibonacci(n):\n        \"\"\"Return first n Fibonacci numbers\"\"\"\n        if n <= 0:\n            return []\n        fib = [0, 1]\n        while len(fib) < n:\n            fib.append(fib[-1] + fib[-2])\n        return fib[:n]\n\n\n# Called on the class, not on an instance\nprint(MathUtils.is_prime(17))     # True\nprint(MathUtils.factorial(5))     # 120\nprint(MathUtils.fibonacci(8))     # [0, 1, 1, 2, 3, 5, 8, 13]"
        ]
      ]
    },
