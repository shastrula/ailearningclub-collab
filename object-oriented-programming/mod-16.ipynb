          "python",
          "# Python: Facade pattern for a video conversion system\nclass VideoFile:\n    def __init__(self, filename):\n        self.filename = filename\n        self.format = filename.split(\".\")[-1]\n\nclass CodecFactory:\n    @staticmethod\n    def get_codec(format_type):\n        codecs = {\"mp4\": \"MPEG4Codec\", \"avi\": \"AVICodec\", \"webm\": \"VP9Codec\"}\n        return codecs.get(format_type, \"GenericCodec\")\n\nclass AudioMixer:\n    def mix(self, video_file):\n        return f\"Mixing audio for {video_file.filename}\"\n\nclass BitrateReader:\n    def read(self, video_file):\n        return f\"Reading bitrate of {video_file.filename}\"\n\n    def convert(self, buffer, codec):\n        return f\"Converting bitrate using {codec}\"\n\nclass VideoConverter:\n    def convert(self, video_file, codec):\n        return f\"Converting {video_file.filename} with {codec}\"\n\n\nclass VideoConversionFacade:\n    \"\"\"Facade - simple interface to complex subsystem\"\"\"\n\n    def convert(self, filename: str, target_format: str) -> str:\n        # Complex subsystem interactions hidden behind simple method\n        video = VideoFile(filename)\n        codec = CodecFactory.get_codec(target_format)\n\n        audio_mixer = AudioMixer()\n        bitrate_reader = BitrateReader()\n        converter = VideoConverter()\n\n        steps = []\n        steps.append(bitrate_reader.read(video))\n        steps.append(audio_mixer.mix(video))\n        steps.append(bitrate_reader.convert(\"buffer\", codec))\n        steps.append(converter.convert(video, codec))\n\n        output_name = filename.rsplit(\".\", 1)[0] + f\".{target_format}\"\n        steps.append(f\"Output saved: {output_name}\")\n\n        return \"\\n\".join(steps)\n\n\n# Client uses the simple facade interface\nfacade = VideoConversionFacade()\nprint(facade.convert(\"birthday_party.avi\", \"mp4\"))\nprint()\nprint(facade.convert(\"presentation.webm\", \"mp4\"))"
        ]
      ]
    },
