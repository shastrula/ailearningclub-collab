        [
          "python",
          "# Python: Adapter pattern - integrating different payment APIs\nclass StripeAPI:\n    \"\"\"Third-party Stripe API with its own interface\"\"\"\n    def create_charge(self, amount_cents, currency, card_token):\n        return {\n            \"id\": \"ch_stripe_123\",\n            \"amount\": amount_cents,\n            \"currency\": currency,\n            \"status\": \"succeeded\"\n        }\n\nclass PayPalAPI:\n    \"\"\"Third-party PayPal API with different interface\"\"\"\n    def make_payment(self, total, currency_code, payer_email):\n        return {\n            \"payment_id\": \"PAY-paypal-456\",\n            \"total\": total,\n            \"state\": \"approved\"\n        }\n\nclass SquareAPI:\n    \"\"\"Third-party Square API with yet another interface\"\"\"\n    def process_transaction(self, amount_money, source_id):\n        return {\n            \"transaction_id\": \"sq_789\",\n            \"amount_money\": amount_money,\n            \"status\": \"COMPLETED\"\n        }\n\n\n# Unified interface our application expects\nclass PaymentGateway:\n    def charge(self, amount: float, currency: str, source: str) -> dict:\n        raise NotImplementedError\n\n\nclass StripeAdapter(PaymentGateway):\n    def __init__(self):\n        self.stripe = StripeAPI()\n\n    def charge(self, amount: float, currency: str, source: str) -> dict:\n        result = self.stripe.create_charge(\n            amount_cents=int(amount * 100),\n            currency=currency,\n            card_token=source\n        )\n        return {\n            \"transaction_id\": result[\"id\"],\n            \"amount\": amount,\n            \"status\": \"success\" if result[\"status\"] == \"succeeded\" else \"failed\"\n        }\n\n\nclass PayPalAdapter(PaymentGateway):\n    def __init__(self):\n        self.paypal = PayPalAPI()\n\n    def charge(self, amount: float, currency: str, source: str) -> dict:\n        result = self.paypal.make_payment(\n            total=amount,\n            currency_code=currency,\n            payer_email=source\n        )\n        return {\n            \"transaction_id\": result[\"payment_id\"],\n            \"amount\": amount,\n            \"status\": \"success\" if result[\"state\"] == \"approved\" else \"failed\"\n        }\n\n\nclass SquareAdapter(PaymentGateway):\n    def __init__(self):\n        self.square = SquareAPI()\n\n    def charge(self, amount: float, currency: str, source: str) -> dict:\n        result = self.square.process_transaction(\n            amount_money={\"amount\": int(amount * 100), \"currency\": currency},\n            source_id=source\n        )\n        return {\n            \"transaction_id\": result[\"transaction_id\"],\n            \"amount\": amount,\n            \"status\": \"success\" if result[\"status\"] == \"COMPLETED\" else \"failed\"\n        }\n\n\n# Client code works with ANY payment gateway uniformly\ndef process_payment(gateway: PaymentGateway, amount, currency, source):\n    result = gateway.charge(amount, currency, source)\n    print(f\"Payment {result['status']}: ${result['amount']} ({result['transaction_id']})\")\n    return result\n\n# Swap payment providers without changing business logic\nprocess_payment(StripeAdapter(), 49.99, \"USD\", \"tok_visa\")\nprocess_payment(PayPalAdapter(), 29.99, \"USD\", \"user@email.com\")\nprocess_payment(SquareAdapter(), 19.99, \"USD\", \"cnon_card_nonce\")"
        ]
      ]
