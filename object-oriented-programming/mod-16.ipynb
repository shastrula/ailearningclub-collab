          "python",
          "# Python: Decorator pattern for data pipeline\nclass DataProcessor:\n    \"\"\"Base component\"\"\"\n    def process(self, data: str) -> str:\n        return data\n\n\nclass ProcessorDecorator(DataProcessor):\n    \"\"\"Base decorator\"\"\"\n    def __init__(self, processor: DataProcessor):\n        self._processor = processor\n\n    def process(self, data: str) -> str:\n        return self._processor.process(data)\n\n\nclass UpperCaseDecorator(ProcessorDecorator):\n    def process(self, data: str) -> str:\n        result = super().process(data)\n        return result.upper()\n\n\nclass TrimDecorator(ProcessorDecorator):\n    def process(self, data: str) -> str:\n        result = super().process(data)\n        return result.strip()\n\n\nclass EncryptDecorator(ProcessorDecorator):\n    def __init__(self, processor: DataProcessor, shift: int = 3):\n        super().__init__(processor)\n        self.shift = shift\n\n    def process(self, data: str) -> str:\n        result = super().process(data)\n        encrypted = \"\"\n        for char in result:\n            if char.isalpha():\n                base = ord('A') if char.isupper() else ord('a')\n                encrypted += chr((ord(char) - base + self.shift) % 26 + base)\n            else:\n                encrypted += char\n        return encrypted\n\n\nclass CompressDecorator(ProcessorDecorator):\n    def process(self, data: str) -> str:\n        result = super().process(data)\n        # Simple run-length encoding\n        if not result:\n            return result\n        compressed = []\n        count = 1\n        for i in range(1, len(result)):\n            if result[i] == result[i-1]:\n                count += 1\n            else:\n                compressed.append(f\"{result[i-1]}{count}\" if count > 1 else result[i-1])\n                count = 1\n        compressed.append(f\"{result[-1]}{count}\" if count > 1 else result[-1])\n        return \"\".join(compressed)\n\n\n# Stack decorators to build processing pipelines\nbase = DataProcessor()\npipeline = CompressDecorator(\n    UpperCaseDecorator(\n        TrimDecorator(base)\n    )\n)\n\ndata = \"  hello world  \"\nprint(f\"Original: '{data}'\")\nprint(f\"Processed: '{pipeline.process(data)}'\")\n\n# Different pipeline for different needs\nsecure_pipeline = EncryptDecorator(TrimDecorator(base), shift=5)\nprint(f\"Encrypted: '{secure_pipeline.process(data)}'\")"
        ]
      ]
    },
