          "python",
          "# Real-world: Facade + Adapter + Factory\nclass EmailProvider:\n    def send(self, to, subject, body):\n        raise NotImplementedError\n\nclass SendGridAdapter(EmailProvider):\n    def send(self, to, subject, body):\n        return f\"SendGrid: Sent '{subject}' to {to}\"\n\nclass MailgunAdapter(EmailProvider):\n    def send(self, to, subject, body):\n        return f\"Mailgun: Sent '{subject}' to {to}\"\n\nclass CommunicationFacade:\n    \"\"\"Facade combining email, SMS, and push into one simple API\"\"\"\n    def __init__(self, email_provider: EmailProvider):\n        self.email = email_provider\n\n    def notify_user(self, user_email, event_type, details):\n        subjects = {\"order\": \"Order Update\", \"alert\": \"Important Alert\"}\n        subject = subjects.get(event_type, \"Notification\")\n        return self.email.send(user_email, subject, details)\n\nfacade = CommunicationFacade(SendGridAdapter())\nprint(facade.notify_user(\"user@email.com\", \"order\", \"Your order shipped!\"))"
        ]
      ]
    }
