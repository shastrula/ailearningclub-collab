          "python",
          "# Python: Practical mixins\nimport json\nfrom datetime import datetime\n\nclass TimestampMixin:\n    \"\"\"Adds creation and modification timestamps\"\"\"\n    def __init_subclass__(cls, **kwargs):\n        super().__init_subclass__(**kwargs)\n        original_init = cls.__init__\n\n        def new_init(self, *args, **kwargs):\n            original_init(self, *args, **kwargs)\n            if not hasattr(self, 'created_at'):\n                self.created_at = datetime.now()\n            self.modified_at = datetime.now()\n\n        cls.__init__ = new_init\n\n    def touch(self):\n        self.modified_at = datetime.now()\n\n\nclass SerializationMixin:\n    \"\"\"Adds JSON serialization capabilities\"\"\"\n    def to_dict(self):\n        result = {}\n        for key, value in self.__dict__.items():\n            if key.startswith('_'):\n                continue\n            if isinstance(value, datetime):\n                result[key] = value.isoformat()\n            else:\n                result[key] = value\n        return result\n\n    def to_json(self, indent=2):\n        return json.dumps(self.to_dict(), indent=indent, default=str)\n\n    @classmethod\n    def from_dict(cls, data):\n        return cls(**{k: v for k, v in data.items()\n                     if k in cls.__init__.__code__.co_varnames})\n\n\nclass ValidationMixin:\n    \"\"\"Adds field validation\"\"\"\n    _validators = {}\n\n    @classmethod\n    def add_validator(cls, field, validator_func, message=\"Invalid\"):\n        if not hasattr(cls, '_validators') or cls._validators is ValidationMixin._validators:\n            cls._validators = {}\n        cls._validators[field] = (validator_func, message)\n\n    def validate(self):\n        errors = []\n        for field, (func, message) in self._validators.items():\n            value = getattr(self, field, None)\n            if not func(value):\n                errors.append(f\"{field}: {message}\")\n        if errors:\n            raise ValueError(f\"Validation errors: {'; '.join(errors)}\")\n        return True\n\n\nclass EventMixin:\n    \"\"\"Adds simple event emission\"\"\"\n    def __init_subclass__(cls, **kwargs):\n        super().__init_subclass__(**kwargs)\n        cls._event_handlers = {}\n\n    @classmethod\n    def on(cls, event_name, handler):\n        if event_name not in cls._event_handlers:\n            cls._event_handlers[event_name] = []\n        cls._event_handlers[event_name].append(handler)\n\n    def emit(self, event_name, **data):\n        handlers = self._event_handlers.get(event_name, [])\n        for handler in handlers:\n            handler(self, **data)\n\n\n# Combining mixins to build a rich model\nclass Article(TimestampMixin, SerializationMixin, ValidationMixin, EventMixin):\n    def __init__(self, title, content, author):\n        self.title = title\n        self.content = content\n        self.author = author\n        self.published = False\n\n    def publish(self):\n        self.validate()\n        self.published = True\n        self.touch()\n        self.emit(\"published\", title=self.title)\n\n\n# Set up validation\nArticle.add_validator(\"title\", lambda x: x and len(x) >= 5, \"Title too short\")\nArticle.add_validator(\"content\", lambda x: x and len(x) >= 50, \"Content too short\")\n\n# Set up event handlers\nArticle.on(\"published\", lambda article, **kw: print(f\"Published: {kw['title']}\"))\n\n# Use the composed class\narticle = Article(\n    title=\"Understanding Mixins\",\n    content=\"Mixins are a powerful pattern for code reuse in Python. \" * 5,\n    author=\"Alice\"\n)\n\narticle.publish()\nprint(article.to_json())"
        ]
      ]
