        [
          "python",
          "# Python: Metaclass that validates class definitions\nclass ValidatedModelMeta(type):\n    \"\"\"Ensures all model classes have required attributes\"\"\"\n\n    def __new__(mcs, name, bases, namespace):\n        cls = super().__new__(mcs, name, bases, namespace)\n\n        # Skip validation for the base class\n        if not bases:\n            return cls\n\n        # Ensure required class attributes exist\n        required = ['table_name', 'fields']\n        for attr in required:\n            if attr not in namespace:\n                raise TypeError(\n                    f\"Class '{name}' must define '{attr}'\"\n                )\n\n        # Validate fields structure\n        fields = namespace.get('fields', {})\n        if not isinstance(fields, dict):\n            raise TypeError(f\"'fields' in '{name}' must be a dict\")\n\n        return cls\n\n\nclass Model(metaclass=ValidatedModelMeta):\n    table_name = None\n    fields = {}\n\n    def __init__(self, **kwargs):\n        for field_name in self.fields:\n            value = kwargs.get(field_name)\n            setattr(self, field_name, value)\n\n    def __repr__(self):\n        attrs = \", \".join(f\"{k}={getattr(self, k)!r}\" for k in self.fields)\n        return f\"{self.__class__.__name__}({attrs})\"\n\n\nclass User(Model):\n    table_name = \"users\"\n    fields = {\"name\": str, \"email\": str, \"age\": int}\n\n\nclass Product(Model):\n    table_name = \"products\"\n    fields = {\"name\": str, \"price\": float, \"stock\": int}\n\n\nuser = User(name=\"Alice\", email=\"alice@example.com\", age=30)\nprint(user)  # User(name='Alice', email='alice@example.com', age=30)\n\n# This would raise TypeError at class definition time:\n# class Bad(Model):\n#     pass  # Missing table_name and fields!"
        ]
      ]
    },
