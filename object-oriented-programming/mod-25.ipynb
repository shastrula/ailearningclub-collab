      "source": [
        [
          "python",
          "# Python: Understanding metaclasses\n# type is the default metaclass\nclass Dog:\n    def bark(self):\n        return \"Woof!\"\n\n# These are equivalent:\n# class Dog: ... is the same as:\n# Dog = type('Dog', (), {'bark': lambda self: 'Woof!'})\n\nprint(type(Dog))        # <class 'type'>\nprint(type(Dog()))      # <class '__main__.Dog'>\n\n\n# Custom metaclass\nclass SingletonMeta(type):\n    \"\"\"Metaclass that makes classes singletons\"\"\"\n    _instances = {}\n\n    def __call__(cls, *args, **kwargs):\n        if cls not in cls._instances:\n            cls._instances[cls] = super().__call__(*args, **kwargs)\n        return cls._instances[cls]\n\n\nclass Database(metaclass=SingletonMeta):\n    def __init__(self, host=\"localhost\"):\n        self.host = host\n        self.connected = False\n\n    def connect(self):\n        self.connected = True\n        return f\"Connected to {self.host}\"\n\n\n# Always returns the same instance\ndb1 = Database(\"server-1\")\ndb2 = Database(\"server-2\")\nprint(db1 is db2)    # True\nprint(db2.host)      # \"server-1\" (first initialization wins)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Python: Metaclass that auto-registers classes\nclass PluginMeta(type):\n    \"\"\"Metaclass that registers all subclasses\"\"\"\n    registry = {}\n\n    def __new__(mcs, name, bases, namespace):\n        cls = super().__new__(mcs, name, bases, namespace)\n        # Don't register the base class itself\n        if bases:\n            plugin_name = namespace.get('plugin_name', name.lower())\n            mcs.registry[plugin_name] = cls\n        return cls\n\n    @classmethod\n    def get_plugin(mcs, name):\n        return mcs.registry.get(name)\n\n    @classmethod\n    def list_plugins(mcs):\n        return list(mcs.registry.keys())\n\n\nclass Plugin(metaclass=PluginMeta):\n    \"\"\"Base class for all plugins\"\"\"\n    plugin_name = None\n\n    def execute(self):\n        raise NotImplementedError\n\n\nclass MarkdownPlugin(Plugin):\n    plugin_name = \"markdown\"\n\n    def execute(self):\n        return \"Processing Markdown...\"\n\n\nclass JSONPlugin(Plugin):\n    plugin_name = \"json\"\n\n    def execute(self):\n        return \"Processing JSON...\"\n\n\nclass XMLPlugin(Plugin):\n    plugin_name = \"xml\"\n\n    def execute(self):\n        return \"Processing XML...\"\n\n\n# Plugins are automatically registered\nprint(PluginMeta.list_plugins())  # ['markdown', 'json', 'xml']\n\n# Create plugin by name\nplugin_cls = PluginMeta.get_plugin(\"json\")\nplugin = plugin_cls()\nprint(plugin.execute())  # \"Processing JSON...\""
        ]
      ]
    },
