        [
          "python",
          "# Python: Multiple inheritance and MRO\nclass A:\n    def method(self):\n        return \"A\"\n\nclass B(A):\n    def method(self):\n        return \"B\"\n\nclass C(A):\n    def method(self):\n        return \"C\"\n\nclass D(B, C):\n    pass\n\n# MRO determines the order\nprint(D.__mro__)\n# (<class 'D'>, <class 'B'>, <class 'C'>, <class 'A'>, <class 'object'>)\n\nd = D()\nprint(d.method())  # \"B\" (B comes before C in MRO)\n\n\n# Cooperative multiple inheritance with super()\nclass Base:\n    def __init__(self, **kwargs):\n        pass  # Absorbs remaining kwargs\n\nclass Named(Base):\n    def __init__(self, name=\"\", **kwargs):\n        super().__init__(**kwargs)\n        self.name = name\n\nclass Aged(Base):\n    def __init__(self, age=0, **kwargs):\n        super().__init__(**kwargs)\n        self.age = age\n\nclass Located(Base):\n    def __init__(self, location=\"\", **kwargs):\n        super().__init__(**kwargs)\n        self.location = location\n\nclass Person(Named, Aged, Located):\n    def __init__(self, **kwargs):\n        super().__init__(**kwargs)\n\n    def __repr__(self):\n        return f\"Person(name={self.name!r}, age={self.age}, location={self.location!r})\"\n\n\n# All parent __init__ methods are called via cooperative super()\nperson = Person(name=\"Alice\", age=30, location=\"NYC\")\nprint(person)  # Person(name='Alice', age=30, location='NYC')"
        ]
      ]
