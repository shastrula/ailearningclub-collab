          "python",
          "# Python: Discouraging overriding (convention-based)\nclass SecurityManager:\n    def authenticate(self, user, password):\n        \"\"\"This method should NOT be overridden\"\"\"\n        if not self._validate_input(user, password):\n            return False\n        return self._check_credentials(user, password)\n\n    def _validate_input(self, user, password):\n        \"\"\"Protected - can be overridden by subclasses\"\"\"\n        return bool(user) and bool(password)\n\n    def _check_credentials(self, user, password):\n        \"\"\"Protected - subclasses should override this\"\"\"\n        raise NotImplementedError(\"Subclasses must implement _check_credentials\")\n\n\nclass DatabaseAuth(SecurityManager):\n    def _check_credentials(self, user, password):\n        \"\"\"Override the hook method, not authenticate()\"\"\"\n        # In real code: query database\n        return user == \"admin\" and password == \"secret\""
