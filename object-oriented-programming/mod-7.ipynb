          "python",
          "# Python: Extending parent methods\nclass Logger:\n    def __init__(self, name):\n        self.name = name\n        self.logs = []\n\n    def log(self, message):\n        entry = f\"[{self.name}] {message}\"\n        self.logs.append(entry)\n        return entry\n\n\nclass TimestampLogger(Logger):\n    def log(self, message):\n        \"\"\"Extend: adds timestamp before calling parent's log\"\"\"\n        from datetime import datetime\n        timestamp = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n        timestamped_msg = f\"{timestamp} - {message}\"\n        return super().log(timestamped_msg)\n\n\nclass FilteredLogger(Logger):\n    def __init__(self, name, min_level=\"INFO\"):\n        super().__init__(name)\n        self.min_level = min_level\n        self.levels = {\"DEBUG\": 0, \"INFO\": 1, \"WARNING\": 2, \"ERROR\": 3}\n\n    def log(self, message, level=\"INFO\"):\n        \"\"\"Extend: filter messages below minimum level\"\"\"\n        if self.levels.get(level, 0) >= self.levels.get(self.min_level, 0):\n            formatted = f\"[{level}] {message}\"\n            return super().log(formatted)\n        return None\n\n\n# Using extended methods\nts_logger = TimestampLogger(\"App\")\nprint(ts_logger.log(\"Server started\"))\n\nf_logger = FilteredLogger(\"App\", min_level=\"WARNING\")\nf_logger.log(\"Debug info\", level=\"DEBUG\")      # Filtered out\nf_logger.log(\"Something broke\", level=\"ERROR\") # Logged\nprint(f_logger.logs)  # Only ERROR entry"
        ]
