          "java",
          "// Java: final prevents overriding\npublic class SecurityManager {\n    // Cannot be overridden\n    public final boolean authenticate(String user, String password) {\n        if (!validateInput(user, password)) {\n            return false;\n        }\n        return checkCredentials(user, password);\n    }\n\n    // Can be overridden by subclasses\n    protected boolean checkCredentials(String user, String password) {\n        return false;\n    }\n\n    private boolean validateInput(String user, String password) {\n        return user != null && !user.isEmpty()\n            && password != null && !password.isEmpty();\n    }\n}"
