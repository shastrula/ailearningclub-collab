          "python",
          "# BAD: Fat interface forces unnecessary implementations\nfrom abc import ABC, abstractmethod\n\nclass Worker(ABC):\n    @abstractmethod\n    def work(self):\n        pass\n\n    @abstractmethod\n    def eat(self):\n        pass\n\n    @abstractmethod\n    def sleep(self):\n        pass\n\n    @abstractmethod\n    def attend_meeting(self):\n        pass\n\n    @abstractmethod\n    def write_report(self):\n        pass\n\nclass Robot(Worker):\n    def work(self):\n        return \"Robot working\"\n\n    def eat(self):\n        pass  # Robots don't eat! Forced to implement useless method\n\n    def sleep(self):\n        pass  # Robots don't sleep!\n\n    def attend_meeting(self):\n        pass  # Robots don't attend meetings!\n\n    def write_report(self):\n        return \"Generating report\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# GOOD: Segregated interfaces - small and focused\nfrom abc import ABC, abstractmethod\n\nclass Workable(ABC):\n    @abstractmethod\n    def work(self):\n        pass\n\nclass Feedable(ABC):\n    @abstractmethod\n    def eat(self):\n        pass\n\nclass Sleepable(ABC):\n    @abstractmethod\n    def sleep(self):\n        pass\n\nclass Reportable(ABC):\n    @abstractmethod\n    def write_report(self):\n        pass\n\nclass Meetable(ABC):\n    @abstractmethod\n    def attend_meeting(self):\n        pass\n\n\n# Each class implements only what it needs\nclass HumanWorker(Workable, Feedable, Sleepable, Meetable, Reportable):\n    def __init__(self, name):\n        self.name = name\n\n    def work(self):\n        return f\"{self.name} is working\"\n\n    def eat(self):\n        return f\"{self.name} is eating lunch\"\n\n    def sleep(self):\n        return f\"{self.name} is sleeping\"\n\n    def attend_meeting(self):\n        return f\"{self.name} in meeting\"\n\n    def write_report(self):\n        return f\"{self.name} writing report\"\n\n\nclass RobotWorker(Workable, Reportable):\n    def __init__(self, model):\n        self.model = model\n\n    def work(self):\n        return f\"Robot {self.model} performing task\"\n\n    def write_report(self):\n        return f\"Robot {self.model} generating report\"\n\n\n# Functions depend only on the interfaces they need\ndef assign_task(worker: Workable):\n    print(worker.work())\n\ndef lunch_break(eater: Feedable):\n    print(eater.eat())\n\nhuman = HumanWorker(\"Alice\")\nrobot = RobotWorker(\"RX-78\")\n\nassign_task(human)  # Works\nassign_task(robot)  # Works\nlunch_break(human)  # Works\n# lunch_break(robot)  # Would fail type check - robots don't eat"
        ]
      ]
    },
    {
