          "python",
          "# GOOD: Both depend on abstraction\nfrom abc import ABC, abstractmethod\n\nclass Database(ABC):\n    \"\"\"Abstraction that both levels depend on\"\"\"\n    @abstractmethod\n    def query(self, statement: str) -> list:\n        pass\n\n    @abstractmethod\n    def execute(self, statement: str) -> bool:\n        pass\n\n\nclass MySQLDatabase(Database):\n    def query(self, statement: str) -> list:\n        return [{\"result\": f\"MySQL: {statement}\"}]\n\n    def execute(self, statement: str) -> bool:\n        print(f\"MySQL executing: {statement}\")\n        return True\n\n\nclass PostgresDatabase(Database):\n    def query(self, statement: str) -> list:\n        return [{\"result\": f\"Postgres: {statement}\"}]\n\n    def execute(self, statement: str) -> bool:\n        print(f\"Postgres executing: {statement}\")\n        return True\n\n\nclass InMemoryDatabase(Database):\n    \"\"\"Great for testing!\"\"\"\n    def __init__(self):\n        self.data = {}\n\n    def query(self, statement: str) -> list:\n        return list(self.data.values())\n\n    def execute(self, statement: str) -> bool:\n        return True\n\n\nclass UserService:\n    \"\"\"High-level module depends on abstraction, not concrete DB\"\"\"\n    def __init__(self, database: Database):\n        self.db = database\n\n    def get_user(self, user_id):\n        results = self.db.query(f\"SELECT * FROM users WHERE id={user_id}\")\n        return results[0] if results else None\n\n    def create_user(self, username, email):\n        return self.db.execute(\n            f\"INSERT INTO users (username, email) VALUES ('{username}', '{email}')\"\n        )\n\n\n# Easy to swap implementations\nproduction_service = UserService(PostgresDatabase())\ntest_service = UserService(InMemoryDatabase())\n\n# Both work the same way through the abstraction\nproduction_service.create_user(\"alice\", \"alice@example.com\")\ntest_service.create_user(\"bob\", \"bob@example.com\")"
        ]
      ]
    },
