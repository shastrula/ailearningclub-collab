          "python",
          "# Python: Multi-level inheritance\nclass LivingThing:\n    def __init__(self, name):\n        self.name = name\n        self.is_alive = True\n\n    def die(self):\n        self.is_alive = False\n\nclass Animal(LivingThing):\n    def __init__(self, name, species):\n        super().__init__(name)\n        self.species = species\n\n    def move(self):\n        return f\"{self.name} is moving\"\n\nclass Pet(Animal):\n    def __init__(self, name, species, owner):\n        super().__init__(name, species)\n        self.owner = owner\n        self.vaccinated = False\n\n    def vaccinate(self):\n        self.vaccinated = True\n        return f\"{self.name} has been vaccinated\"\n\n# Pet inherits from Animal, which inherits from LivingThing\nmy_pet = Pet(\"Buddy\", \"Dog\", \"Alice\")\nprint(my_pet.move())        # From Animal\nprint(my_pet.vaccinate())   # From Pet\nprint(my_pet.is_alive)      # From LivingThing"
        ]
      ]
    }
