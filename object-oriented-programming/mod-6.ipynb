          "python",
          "# Python: Using super() effectively\nclass Vehicle:\n    def __init__(self, make, model, year):\n        self.make = make\n        self.model = model\n        self.year = year\n        self.odometer = 0\n        self.fuel_level = 100\n\n    def drive(self, distance):\n        fuel_needed = distance * 0.1\n        if fuel_needed > self.fuel_level:\n            return \"Not enough fuel\"\n        self.odometer += distance\n        self.fuel_level -= fuel_needed\n        return f\"Drove {distance}km. Odometer: {self.odometer}km\"\n\n    def info(self):\n        return f\"{self.year} {self.make} {self.model}\"\n\n\nclass ElectricVehicle(Vehicle):\n    def __init__(self, make, model, year, battery_capacity):\n        super().__init__(make, model, year)\n        self.battery_capacity = battery_capacity\n        self.charge_level = 100\n\n    def drive(self, distance):\n        charge_needed = distance * 0.2\n        if charge_needed > self.charge_level:\n            return \"Not enough charge\"\n        self.odometer += distance\n        self.charge_level -= charge_needed\n        return f\"Silently drove {distance}km. Charge: {self.charge_level}%\"\n\n    def charge(self, amount):\n        self.charge_level = min(100, self.charge_level + amount)\n        return f\"Charge level: {self.charge_level}%\"\n\n    def info(self):\n        base_info = super().info()\n        return f\"{base_info} (Electric, {self.battery_capacity}kWh)\"\n\n\ntesla = ElectricVehicle(\"Tesla\", \"Model 3\", 2023, 75)\nprint(tesla.info())         # 2023 Tesla Model 3 (Electric, 75kWh)\nprint(tesla.drive(50))      # Silently drove 50km. Charge: 90.0%"
        ]
      ]
    },
