          "python",
          "# Python: Builder pattern for complex objects\nclass HTTPRequest:\n    def __init__(self):\n        self.method = \"GET\"\n        self.url = \"\"\n        self.headers = {}\n        self.body = None\n        self.timeout = 30\n        self.retries = 0\n        self.auth = None\n\n    def __str__(self):\n        parts = [f\"{self.method} {self.url}\"]\n        for key, value in self.headers.items():\n            parts.append(f\"  {key}: {value}\")\n        if self.body:\n            parts.append(f\"  Body: {self.body[:50]}...\")\n        return \"\\n\".join(parts)\n\n\nclass RequestBuilder:\n    def __init__(self, url):\n        self._request = HTTPRequest()\n        self._request.url = url\n\n    def method(self, method):\n        self._request.method = method.upper()\n        return self\n\n    def header(self, key, value):\n        self._request.headers[key] = value\n        return self\n\n    def json_body(self, data):\n        import json\n        self._request.body = json.dumps(data)\n        self._request.headers[\"Content-Type\"] = \"application/json\"\n        return self\n\n    def timeout(self, seconds):\n        self._request.timeout = seconds\n        return self\n\n    def retries(self, count):\n        self._request.retries = count\n        return self\n\n    def bearer_auth(self, token):\n        self._request.headers[\"Authorization\"] = f\"Bearer {token}\"\n        return self\n\n    def build(self) -> HTTPRequest:\n        if not self._request.url:\n            raise ValueError(\"URL is required\")\n        return self._request\n\n\n# Fluent API for building complex requests\nrequest = (RequestBuilder(\"https://api.example.com/users\")\n           .method(\"POST\")\n           .header(\"Accept\", \"application/json\")\n           .json_body({\"name\": \"Alice\", \"email\": \"alice@example.com\"})\n           .bearer_auth(\"abc123token\")\n           .timeout(10)\n           .retries(3)\n           .build())\n\nprint(request)"
        ]
      ]
