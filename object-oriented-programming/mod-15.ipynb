        [
          "python",
          "# Python: Singleton pattern\nclass DatabaseConnection:\n    \"\"\"Singleton - only one database connection pool\"\"\"\n    _instance = None\n\n    def __new__(cls, *args, **kwargs):\n        if cls._instance is None:\n            cls._instance = super().__new__(cls)\n            cls._instance._initialized = False\n        return cls._instance\n\n    def __init__(self, host=\"localhost\", port=5432):\n        if self._initialized:\n            return\n        self.host = host\n        self.port = port\n        self.connection_pool = []\n        self._initialized = True\n        print(f\"Database connection initialized: {host}:{port}\")\n\n    def execute(self, query):\n        return f\"Executing on {self.host}:{self.port}: {query}\"\n\n\n# Both variables reference the SAME instance\ndb1 = DatabaseConnection(\"prod-server\", 5432)\ndb2 = DatabaseConnection(\"other-server\", 3306)  # Ignored! Already initialized\n\nprint(db1 is db2)        # True\nprint(db2.host)          # prod-server (not other-server)\nprint(db1.execute(\"SELECT 1\"))"
        ]
      ]
    },
