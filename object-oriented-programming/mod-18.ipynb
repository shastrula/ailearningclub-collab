          "python",
          "# DO: Be specific with exception handling\ndef process_order(order_data):\n    try:\n        validate_order(order_data)\n    except ValidationError as e:\n        # Handle specific validation issues\n        return {\"error\": \"invalid_order\", \"field\": e.field}\n\n    try:\n        charge_payment(order_data[\"payment\"])\n    except PaymentDeclinedError:\n        return {\"error\": \"payment_declined\"}\n    except PaymentGatewayError:\n        # Retry or notify support\n        return {\"error\": \"payment_system_unavailable\"}\n\n# DON'T: Catch everything silently\ndef bad_process_order(order_data):\n    try:\n        # Everything in one big try block\n        validate_order(order_data)\n        charge_payment(order_data[\"payment\"])\n        fulfill_order(order_data)\n    except Exception:\n        pass  # Swallowing ALL errors - very bad!"
