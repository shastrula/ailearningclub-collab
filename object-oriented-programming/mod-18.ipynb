        [
          "python",
          "# Python: Using the exception hierarchy in a service\nclass UserService:\n    def __init__(self):\n        self.users = {\n            \"user-1\": {\"name\": \"Alice\", \"email\": \"alice@example.com\", \"role\": \"admin\"},\n            \"user-2\": {\"name\": \"Bob\", \"email\": \"bob@example.com\", \"role\": \"user\"},\n        }\n\n    def get_user(self, user_id):\n        user = self.users.get(user_id)\n        if user is None:\n            raise NotFoundError(\"User\", user_id)\n        return user\n\n    def update_email(self, user_id, new_email, requester_role):\n        if requester_role not in (\"admin\", \"self\"):\n            raise AuthorizationError(\"User.email\", \"update\")\n\n        if not new_email or \"@\" not in new_email:\n            raise ValidationError(\"email\", \"must be a valid email address\", new_email)\n\n        user = self.get_user(user_id)\n        user[\"email\"] = new_email\n        return user\n\n    def delete_user(self, user_id, requester_role):\n        if requester_role != \"admin\":\n            raise AuthorizationError(\"User\", \"delete\")\n        user = self.get_user(user_id)\n        del self.users[user_id]\n        return user\n\n\n# Handling exceptions at different levels\nservice = UserService()\n\ndef handle_request(action):\n    try:\n        result = action()\n        print(f\"Success: {result}\")\n    except NotFoundError as e:\n        print(f\"404: {e}\")\n    except ValidationError as e:\n        print(f\"400: {e} (field: {e.field})\")\n    except AuthorizationError as e:\n        print(f\"403: {e}\")\n    except AppError as e:\n        print(f\"500: Unexpected app error: {e}\")\n\n\nhandle_request(lambda: service.get_user(\"user-1\"))\nhandle_request(lambda: service.get_user(\"user-999\"))\nhandle_request(lambda: service.update_email(\"user-1\", \"invalid\", \"admin\"))\nhandle_request(lambda: service.delete_user(\"user-1\", \"user\"))"
        ]
      ]
    },
