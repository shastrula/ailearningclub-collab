          "java",
          "// Java: Custom exception hierarchy\npublic abstract class AppException extends Exception {\n    private final String code;\n    private final Map<String, Object> details;\n\n    protected AppException(String message, String code, Map<String, Object> details) {\n        super(message);\n        this.code = code;\n        this.details = details != null ? details : new HashMap<>();\n    }\n\n    public String getCode() { return code; }\n    public Map<String, Object> getDetails() { return details; }\n}\n\npublic class NotFoundException extends AppException {\n    public NotFoundException(String resourceType, String id) {\n        super(\n            resourceType + \" with id '\" + id + \"' not found\",\n            \"NOT_FOUND\",\n            Map.of(\"resource_type\", resourceType, \"id\", id)\n        );\n    }\n}\n\npublic class ValidationException extends AppException {\n    public ValidationException(String field, String message) {\n        super(\n            \"Validation failed for '\" + field + \"': \" + message,\n            \"VALIDATION_ERROR\",\n            Map.of(\"field\", field)\n        );\n    }\n}\n\n// Usage with try-catch\npublic class UserController {\n    private UserService service;\n\n    public Response handleGetUser(String userId) {\n        try {\n            User user = service.getUser(userId);\n            return Response.ok(user);\n        } catch (NotFoundException e) {\n            return Response.notFound(e.getMessage());\n        } catch (AppException e) {\n            return Response.error(e.getCode(), e.getMessage());\n        }\n    }\n}"
        ]
      ]
    },
