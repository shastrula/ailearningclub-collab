          "python",
          "# Python: Custom exception hierarchy\nclass AppError(Exception):\n    \"\"\"Base exception for our application\"\"\"\n    def __init__(self, message, code=None, details=None):\n        super().__init__(message)\n        self.code = code\n        self.details = details or {}\n\n    def to_dict(self):\n        return {\n            \"error\": self.__class__.__name__,\n            \"message\": str(self),\n            \"code\": self.code,\n            \"details\": self.details\n        }\n\n\nclass ValidationError(AppError):\n    \"\"\"Data validation failures\"\"\"\n    def __init__(self, field, message, value=None):\n        super().__init__(\n            f\"Validation failed for '{field}': {message}\",\n            code=\"VALIDATION_ERROR\",\n            details={\"field\": field, \"value\": value}\n        )\n        self.field = field\n\n\nclass AuthenticationError(AppError):\n    \"\"\"Authentication failures\"\"\"\n    def __init__(self, message=\"Authentication failed\"):\n        super().__init__(message, code=\"AUTH_ERROR\")\n\n\nclass AuthorizationError(AppError):\n    \"\"\"Permission/authorization failures\"\"\"\n    def __init__(self, resource, action):\n        super().__init__(\n            f\"Not authorized to {action} on {resource}\",\n            code=\"FORBIDDEN\",\n            details={\"resource\": resource, \"action\": action}\n        )\n\n\nclass NotFoundError(AppError):\n    \"\"\"Resource not found\"\"\"\n    def __init__(self, resource_type, resource_id):\n        super().__init__(\n            f\"{resource_type} with id '{resource_id}' not found\",\n            code=\"NOT_FOUND\",\n            details={\"resource_type\": resource_type, \"id\": resource_id}\n        )\n\n\nclass RateLimitError(AppError):\n    \"\"\"Rate limit exceeded\"\"\"\n    def __init__(self, limit, window_seconds):\n        super().__init__(\n            f\"Rate limit exceeded: {limit} requests per {window_seconds}s\",\n            code=\"RATE_LIMITED\",\n            details={\"limit\": limit, \"window\": window_seconds}\n        )"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
