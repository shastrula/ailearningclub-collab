      "source": [
        [
          "python",
          "# Python: Method overriding (runtime polymorphism)\nclass Serializer:\n    def serialize(self, data):\n        raise NotImplementedError\n\n    def deserialize(self, raw):\n        raise NotImplementedError\n\n    def round_trip(self, data):\n        \"\"\"Template method using overridden serialize/deserialize\"\"\"\n        raw = self.serialize(data)\n        return self.deserialize(raw)\n\n\nclass JSONSerializer(Serializer):\n    def serialize(self, data):\n        import json\n        return json.dumps(data)\n\n    def deserialize(self, raw):\n        import json\n        return json.loads(raw)\n\n\nclass CSVSerializer(Serializer):\n    def serialize(self, data):\n        if isinstance(data, list) and all(isinstance(r, dict) for r in data):\n            headers = list(data[0].keys())\n            rows = [\",\".join(headers)]\n            for row in data:\n                rows.append(\",\".join(str(row[h]) for h in headers))\n            return \"\\n\".join(rows)\n        raise ValueError(\"CSVSerializer requires list of dicts\")\n\n    def deserialize(self, raw):\n        lines = raw.strip().split(\"\\n\")\n        headers = lines[0].split(\",\")\n        return [dict(zip(headers, line.split(\",\"))) for line in lines[1:]]\n\n\n# Runtime polymorphism - correct method chosen based on object type\ndata = [{\"name\": \"Alice\", \"age\": \"30\"}, {\"name\": \"Bob\", \"age\": \"25\"}]\n\nserializers = [JSONSerializer(), CSVSerializer()]\nfor s in serializers:\n    raw = s.serialize(data)\n    print(f\"{s.__class__.__name__}:\")\n    print(f\"  Serialized: {raw[:50]}...\")\n    restored = s.deserialize(raw)\n    print(f\"  Restored: {restored}\")\n    print()"
        ]
      ]
    },
