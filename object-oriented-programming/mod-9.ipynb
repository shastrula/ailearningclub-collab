          "python",
          "# Python: Using functools.singledispatch for type-based dispatch\nfrom functools import singledispatch\n\n@singledispatch\ndef format_value(value):\n    \"\"\"Default formatter\"\"\"\n    return str(value)\n\n@format_value.register(int)\ndef _(value):\n    return f\"Integer: {value:,}\"\n\n@format_value.register(float)\ndef _(value):\n    return f\"Float: {value:.4f}\"\n\n@format_value.register(list)\ndef _(value):\n    return f\"List ({len(value)} items): {value}\"\n\n@format_value.register(dict)\ndef _(value):\n    return f\"Dict ({len(value)} keys): {list(value.keys())}\"\n\n\nprint(format_value(42))              # Integer: 42\nprint(format_value(3.14159))         # Float: 3.1416\nprint(format_value([1, 2, 3]))       # List (3 items): [1, 2, 3]\nprint(format_value({\"a\": 1}))        # Dict (1 keys): ['a']"
        ]
      ]
    },
    {
      "cell_type": "code",
