          "python",
          "# Python: Combining both concepts in a practical example\nclass Shape:\n    def area(self):\n        return 0\n\nclass Circle(Shape):\n    def __init__(self, radius):\n        self.radius = radius\n\n    def area(self):  # Overriding\n        import math\n        return math.pi * self.radius ** 2\n\nclass ShapeFactory:\n    @staticmethod\n    def create(*args):\n        \"\"\"Simulated overloading via argument inspection\"\"\"\n        if len(args) == 1:\n            return Circle(args[0])\n        elif len(args) == 2:\n            return Rectangle(args[0], args[1])\n        raise ValueError(\"Invalid arguments\")\n\nclass Rectangle(Shape):\n    def __init__(self, width, height):\n        self.width = width\n        self.height = height\n\n    def area(self):  # Overriding\n        return self.width * self.height\n\n\n# Factory uses simulated overloading\ncircle = ShapeFactory.create(5)\nrect = ShapeFactory.create(4, 6)\n\n# area() uses runtime overriding\nprint(f\"Circle area: {circle.area():.2f}\")  # 78.54\nprint(f\"Rectangle area: {rect.area():.2f}\") # 24.00"
        ]
      ]
    }
