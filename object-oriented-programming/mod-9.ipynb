      "source": [
        [
          "python",
          "# Python: Simulating overloading with default parameters\nclass Calculator:\n    def add(self, *args):\n        \"\"\"Accepts any number of arguments\"\"\"\n        if all(isinstance(a, (int, float)) for a in args):\n            return sum(args)\n        elif all(isinstance(a, str) for a in args):\n            return \"\".join(args)\n        else:\n            raise TypeError(\"All arguments must be the same type\")\n\n\ncalc = Calculator()\nprint(calc.add(1, 2))           # 3\nprint(calc.add(1, 2, 3, 4))    # 10\nprint(calc.add(1.5, 2.5))      # 4.0\nprint(calc.add(\"Hello\", \" \", \"World\"))  # \"Hello World\""
        ]
      ]
    },
