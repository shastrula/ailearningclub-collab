          "python",
          "# Python: Strategy pattern - Sorting and filtering\nfrom abc import ABC, abstractmethod\n\nclass SortStrategy(ABC):\n    @abstractmethod\n    def sort(self, data: list) -> list:\n        pass\n\n    @property\n    @abstractmethod\n    def name(self) -> str:\n        pass\n\n\nclass AlphabeticalSort(SortStrategy):\n    def sort(self, data: list) -> list:\n        return sorted(data, key=lambda x: x.get(\"name\", \"\").lower())\n\n    @property\n    def name(self) -> str:\n        return \"Alphabetical\"\n\n\nclass PriceSort(SortStrategy):\n    def __init__(self, ascending=True):\n        self.ascending = ascending\n\n    def sort(self, data: list) -> list:\n        return sorted(data, key=lambda x: x.get(\"price\", 0),\n                      reverse=not self.ascending)\n\n    @property\n    def name(self) -> str:\n        direction = \"Low to High\" if self.ascending else \"High to Low\"\n        return f\"Price ({direction})\"\n\n\nclass RatingSort(SortStrategy):\n    def sort(self, data: list) -> list:\n        return sorted(data, key=lambda x: x.get(\"rating\", 0), reverse=True)\n\n    @property\n    def name(self) -> str:\n        return \"Highest Rated\"\n\n\nclass PopularitySort(SortStrategy):\n    def sort(self, data: list) -> list:\n        return sorted(data, key=lambda x: x.get(\"sales\", 0), reverse=True)\n\n    @property\n    def name(self) -> str:\n        return \"Most Popular\"\n\n\nclass ProductCatalog:\n    def __init__(self, products):\n        self.products = products\n        self._sort_strategy = AlphabeticalSort()\n\n    def set_sort_strategy(self, strategy: SortStrategy):\n        self._sort_strategy = strategy\n\n    def get_sorted_products(self):\n        sorted_products = self._sort_strategy.sort(self.products)\n        return sorted_products\n\n    def display(self):\n        print(f\"\\nSorted by: {self._sort_strategy.name}\")\n        print(\"-\" * 40)\n        for p in self.get_sorted_products():\n            print(f\"  {p['name']}: ${p['price']} (Rating: {p['rating']})\")\n\n\nproducts = [\n    {\"name\": \"Laptop\", \"price\": 999, \"rating\": 4.5, \"sales\": 500},\n    {\"name\": \"Mouse\", \"price\": 29, \"rating\": 4.8, \"sales\": 2000},\n    {\"name\": \"Keyboard\", \"price\": 79, \"rating\": 4.2, \"sales\": 800},\n    {\"name\": \"Monitor\", \"price\": 449, \"rating\": 4.6, \"sales\": 300},\n]\n\ncatalog = ProductCatalog(products)\n\n# Change strategy at runtime\ncatalog.display()\ncatalog.set_sort_strategy(PriceSort(ascending=True))\ncatalog.display()\ncatalog.set_sort_strategy(RatingSort())\ncatalog.display()"
        ]
      ]
