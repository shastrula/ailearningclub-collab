        [
          "python",
          "# Python: Observer pattern - Event system\nfrom abc import ABC, abstractmethod\n\nclass EventManager:\n    \"\"\"Subject/Publisher that manages subscriptions\"\"\"\n    def __init__(self):\n        self._subscribers = {}\n\n    def subscribe(self, event_type: str, listener):\n        if event_type not in self._subscribers:\n            self._subscribers[event_type] = []\n        self._subscribers[event_type].append(listener)\n\n    def unsubscribe(self, event_type: str, listener):\n        if event_type in self._subscribers:\n            self._subscribers[event_type].remove(listener)\n\n    def notify(self, event_type: str, data=None):\n        if event_type in self._subscribers:\n            for listener in self._subscribers[event_type]:\n                listener.update(event_type, data)\n\n\nclass EventListener(ABC):\n    @abstractmethod\n    def update(self, event_type: str, data):\n        pass\n\n\nclass LoggingListener(EventListener):\n    def __init__(self, log_file):\n        self.log_file = log_file\n        self.logs = []\n\n    def update(self, event_type: str, data):\n        entry = f\"[{event_type}] {data}\"\n        self.logs.append(entry)\n        print(f\"Log ({self.log_file}): {entry}\")\n\n\nclass EmailAlertListener(EventListener):\n    def __init__(self, email):\n        self.email = email\n\n    def update(self, event_type: str, data):\n        print(f\"Email to {self.email}: {event_type} - {data}\")\n\n\nclass MetricsListener(EventListener):\n    def __init__(self):\n        self.event_counts = {}\n\n    def update(self, event_type: str, data):\n        self.event_counts[event_type] = self.event_counts.get(event_type, 0) + 1\n\n\n# Application using the observer pattern\nclass UserService:\n    def __init__(self):\n        self.events = EventManager()\n        self.users = {}\n\n    def register_user(self, username, email):\n        self.users[username] = {\"email\": email, \"active\": True}\n        self.events.notify(\"user_registered\", {\"username\": username, \"email\": email})\n\n    def deactivate_user(self, username):\n        if username in self.users:\n            self.users[username][\"active\"] = False\n            self.events.notify(\"user_deactivated\", {\"username\": username})\n\n\n# Set up observers\nservice = UserService()\nlogger = LoggingListener(\"audit.log\")\nalerts = EmailAlertListener(\"admin@company.com\")\nmetrics = MetricsListener()\n\nservice.events.subscribe(\"user_registered\", logger)\nservice.events.subscribe(\"user_registered\", alerts)\nservice.events.subscribe(\"user_registered\", metrics)\nservice.events.subscribe(\"user_deactivated\", logger)\n\n# Actions trigger notifications automatically\nservice.register_user(\"alice\", \"alice@email.com\")\nservice.register_user(\"bob\", \"bob@email.com\")\nservice.deactivate_user(\"alice\")\n\nprint(f\"\\nMetrics: {metrics.event_counts}\")"
        ]
      ]
    },
