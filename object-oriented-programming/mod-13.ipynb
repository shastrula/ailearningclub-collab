          "python",
          "# BAD: Class with multiple responsibilities\nclass UserManager:\n    def __init__(self):\n        self.users = {}\n\n    def create_user(self, username, email, password):\n        # Responsibility 1: User management\n        user_id = len(self.users) + 1\n        self.users[user_id] = {\n            \"username\": username,\n            \"email\": email,\n            \"password\": self._hash_password(password)\n        }\n        # Responsibility 2: Email sending\n        self._send_welcome_email(email, username)\n        # Responsibility 3: Logging\n        self._log_action(f\"User created: {username}\")\n        return user_id\n\n    def _hash_password(self, password):\n        import hashlib\n        return hashlib.sha256(password.encode()).hexdigest()\n\n    def _send_welcome_email(self, email, username):\n        print(f\"Sending email to {email}...\")\n\n    def _log_action(self, message):\n        print(f\"LOG: {message}\")"
        ]
      ]
