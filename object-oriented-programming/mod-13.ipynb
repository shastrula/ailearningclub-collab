          "python",
          "# Python: OCP through strategy pattern\nfrom abc import ABC, abstractmethod\n\nclass DiscountStrategy(ABC):\n    @abstractmethod\n    def calculate(self, price: float) -> float:\n        pass\n\n    @abstractmethod\n    def description(self) -> str:\n        pass\n\n\nclass NoDiscount(DiscountStrategy):\n    def calculate(self, price: float) -> float:\n        return price\n\n    def description(self) -> str:\n        return \"No discount\"\n\n\nclass PercentageDiscount(DiscountStrategy):\n    def __init__(self, percent):\n        self.percent = percent\n\n    def calculate(self, price: float) -> float:\n        return price * (1 - self.percent / 100)\n\n    def description(self) -> str:\n        return f\"{self.percent}% off\"\n\n\nclass BuyOneGetOneFree(DiscountStrategy):\n    def calculate(self, price: float) -> float:\n        return price / 2\n\n    def description(self) -> str:\n        return \"Buy one get one free\"\n\n\nclass FixedAmountDiscount(DiscountStrategy):\n    def __init__(self, amount):\n        self.amount = amount\n\n    def calculate(self, price: float) -> float:\n        return max(0, price - self.amount)\n\n    def description(self) -> str:\n        return f\"${self.amount} off\"\n\n\n# The Order class is CLOSED for modification\nclass Order:\n    def __init__(self, items, discount_strategy: DiscountStrategy = None):\n        self.items = items\n        self.discount = discount_strategy or NoDiscount()\n\n    def subtotal(self):\n        return sum(item[\"price\"] * item[\"quantity\"] for item in self.items)\n\n    def total(self):\n        return self.discount.calculate(self.subtotal())\n\n    def summary(self):\n        return (f\"Subtotal: ${self.subtotal():.2f} | \"\n                f\"Discount: {self.discount.description()} | \"\n                f\"Total: ${self.total():.2f}\")\n\n\n# Adding new discount types never requires changing Order\nitems = [{\"name\": \"Widget\", \"price\": 25.00, \"quantity\": 2}]\n\norder1 = Order(items, PercentageDiscount(20))\norder2 = Order(items, BuyOneGetOneFree())\norder3 = Order(items, FixedAmountDiscount(10))\n\nprint(order1.summary())\nprint(order2.summary())\nprint(order3.summary())"
        ]
      ]
