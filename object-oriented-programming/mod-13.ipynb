          "python",
          "# GOOD: Each class has one responsibility\nclass UserRepository:\n    \"\"\"Responsibility: Store and retrieve user data\"\"\"\n    def __init__(self):\n        self.users = {}\n\n    def save(self, user_data):\n        user_id = len(self.users) + 1\n        self.users[user_id] = user_data\n        return user_id\n\n    def find_by_id(self, user_id):\n        return self.users.get(user_id)\n\n    def find_by_email(self, email):\n        for uid, data in self.users.items():\n            if data[\"email\"] == email:\n                return data\n        return None\n\n\nclass PasswordHasher:\n    \"\"\"Responsibility: Handle password hashing\"\"\"\n    @staticmethod\n    def hash(password):\n        import hashlib\n        return hashlib.sha256(password.encode()).hexdigest()\n\n    @staticmethod\n    def verify(password, hashed):\n        import hashlib\n        return hashlib.sha256(password.encode()).hexdigest() == hashed\n\n\nclass EmailService:\n    \"\"\"Responsibility: Send emails\"\"\"\n    def send_welcome(self, email, username):\n        print(f\"Welcome email sent to {email}\")\n\n    def send_reset_password(self, email, token):\n        print(f\"Password reset sent to {email}\")\n\n\nclass AuditLogger:\n    \"\"\"Responsibility: Log actions for audit\"\"\"\n    def __init__(self):\n        self.logs = []\n\n    def log(self, action, details=None):\n        from datetime import datetime\n        entry = {\n            \"timestamp\": datetime.now().isoformat(),\n            \"action\": action,\n            \"details\": details\n        }\n        self.logs.append(entry)\n\n\nclass UserService:\n    \"\"\"Orchestrator: coordinates single-responsibility classes\"\"\"\n    def __init__(self, repo, hasher, email_service, logger):\n        self.repo = repo\n        self.hasher = hasher\n        self.email = email_service\n        self.logger = logger\n\n    def create_user(self, username, email, password):\n        user_data = {\n            \"username\": username,\n            \"email\": email,\n            \"password\": self.hasher.hash(password)\n        }\n        user_id = self.repo.save(user_data)\n        self.email.send_welcome(email, username)\n        self.logger.log(\"user_created\", {\"username\": username})\n        return user_id\n\n\n# Usage: each piece is independently testable and replaceable\nservice = UserService(\n    repo=UserRepository(),\n    hasher=PasswordHasher(),\n    email_service=EmailService(),\n    logger=AuditLogger()\n)\nservice.create_user(\"alice\", \"alice@example.com\", \"password123\")"
        ]
      ]
