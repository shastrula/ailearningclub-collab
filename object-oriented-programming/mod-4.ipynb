        [
          "python",
          "# Python: Default parameters\nclass Connection:\n    def __init__(self, host, port=5432, database=\"default\",\n                 timeout=30, ssl=True):\n        self.host = host\n        self.port = port\n        self.database = database\n        self.timeout = timeout\n        self.ssl = ssl\n\n    def connection_string(self):\n        protocol = \"ssl\" if self.ssl else \"tcp\"\n        return f\"{protocol}://{self.host}:{self.port}/{self.database}\"\n\n\n# Various ways to create Connection objects\nconn1 = Connection(\"localhost\")\nconn2 = Connection(\"prod-server\", port=3306, database=\"myapp\")\nconn3 = Connection(\"dev-server\", ssl=False, timeout=60)\n\nprint(conn1.connection_string())  # ssl://localhost:5432/default\nprint(conn2.connection_string())  # ssl://prod-server:3306/myapp"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "// Java: Constructor overloading (no default params)\npublic class Connection {\n    private String host;\n    private int port;\n    private String database;\n    private int timeout;\n    private boolean ssl;\n\n    // Full constructor\n    public Connection(String host, int port, String database,\n                      int timeout, boolean ssl) {\n        this.host = host;\n        this.port = port;\n        this.database = database;\n        this.timeout = timeout;\n        this.ssl = ssl;\n    }\n\n    // Simplified constructors calling the full one\n    public Connection(String host) {\n        this(host, 5432, \"default\", 30, true);\n    }\n\n    public Connection(String host, int port, String database) {\n        this(host, port, database, 30, true);\n    }\n}"
        ]
      ]
    },
