          "python",
          "# Python: Copy constructor / cloning\nclass GameState:\n    def __init__(self, player_name, level=1, score=0, inventory=None):\n        self.player_name = player_name\n        self.level = level\n        self.score = score\n        self.inventory = inventory if inventory is not None else []\n\n    @classmethod\n    def from_existing(cls, other):\n        \"\"\"Copy constructor - creates a new GameState from an existing one\"\"\"\n        return cls(\n            player_name=other.player_name,\n            level=other.level,\n            score=other.score,\n            inventory=list(other.inventory)\n        )\n\n    def add_item(self, item):\n        self.inventory.append(item)\n\n    def __repr__(self):\n        return (f\"GameState(player='{self.player_name}', \"\n                f\"level={self.level}, score={self.score})\")\n\n\n# Create a save point by copying\ncurrent = GameState(\"Hero\", level=5, score=2500)\ncurrent.add_item(\"sword\")\ncurrent.add_item(\"shield\")\n\nsave_point = GameState.from_existing(current)\n\n# Modify current without affecting save\ncurrent.score = 3000\ncurrent.add_item(\"potion\")\n\nprint(current)     # GameState(player='Hero', level=5, score=3000)\nprint(save_point)  # GameState(player='Hero', level=5, score=2500)\nprint(current.inventory)     # ['sword', 'shield', 'potion']\nprint(save_point.inventory)  # ['sword', 'shield']"
        ]
      ]
    }
