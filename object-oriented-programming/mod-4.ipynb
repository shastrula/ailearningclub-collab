          "java",
          "// Java: Basic constructor\npublic class Person {\n    private String name;\n    private int age;\n    private String email;\n\n    // Constructor - same name as class, no return type\n    public Person(String name, int age, String email) {\n        this.name = name;\n        this.age = age;\n        this.email = email;\n    }\n\n    @Override\n    public String toString() {\n        return \"Person(name='\" + name + \"', age=\" + age + \")\";\n    }\n}"
        ]
      ]
    },
    {
