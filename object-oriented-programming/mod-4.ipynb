        [
          "python",
          "# Python: Constructor with validation\nclass Temperature:\n    ABSOLUTE_ZERO_CELSIUS = -273.15\n\n    def __init__(self, celsius):\n        if celsius < self.ABSOLUTE_ZERO_CELSIUS:\n            raise ValueError(\n                f\"Temperature cannot be below absolute zero \"\n                f\"({self.ABSOLUTE_ZERO_CELSIUS}C)\"\n            )\n        self._celsius = celsius\n\n    @property\n    def celsius(self):\n        return self._celsius\n\n    @property\n    def fahrenheit(self):\n        return self._celsius * 9/5 + 32\n\n    @property\n    def kelvin(self):\n        return self._celsius + 273.15\n\n    @classmethod\n    def from_fahrenheit(cls, f):\n        return cls((f - 32) * 5/9)\n\n    @classmethod\n    def from_kelvin(cls, k):\n        return cls(k - 273.15)\n\n\n# Valid creation\nwater_boiling = Temperature(100)\nprint(water_boiling.fahrenheit)  # 212.0\nprint(water_boiling.kelvin)      # 373.15\n\nbody_temp = Temperature.from_fahrenheit(98.6)\nprint(body_temp.celsius)  # 37.0"
        ]
      ]
    },
    {
