          "python",
          "# Python: Polymorphic notification system\nclass NotificationChannel:\n    def __init__(self, recipient):\n        self.recipient = recipient\n\n    def send(self, subject, message):\n        raise NotImplementedError\n\n    def validate(self):\n        raise NotImplementedError\n\n\nclass EmailNotification(NotificationChannel):\n    def send(self, subject, message):\n        if not self.validate():\n            return \"Invalid email address\"\n        return f\"Email sent to {self.recipient}: [{subject}] {message}\"\n\n    def validate(self):\n        return \"@\" in self.recipient and \".\" in self.recipient\n\n\nclass SMSNotification(NotificationChannel):\n    def send(self, subject, message):\n        if not self.validate():\n            return \"Invalid phone number\"\n        short_msg = message[:160]\n        return f\"SMS sent to {self.recipient}: {short_msg}\"\n\n    def validate(self):\n        return self.recipient.replace(\"+\", \"\").replace(\"-\", \"\").isdigit()\n\n\nclass SlackNotification(NotificationChannel):\n    def send(self, subject, message):\n        if not self.validate():\n            return \"Invalid Slack channel\"\n        return f\"Slack message to {self.recipient}: *{subject}*\\n{message}\"\n\n    def validate(self):\n        return self.recipient.startswith(\"#\") or self.recipient.startswith(\"@\")\n\n\n# Polymorphic dispatch - send to all channels uniformly\ndef notify_all(channels, subject, message):\n    results = []\n    for channel in channels:\n        results.append(channel.send(subject, message))\n    return results\n\n\nchannels = [\n    EmailNotification(\"dev@company.com\"),\n    SMSNotification(\"+1-555-0123\"),\n    SlackNotification(\"#alerts\"),\n]\n\nresults = notify_all(channels, \"Server Alert\", \"CPU usage above 90%\")\nfor r in results:\n    print(r)"
        ]
