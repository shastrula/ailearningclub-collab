          "python",
          "# Python: Polymorphism through method overriding\nclass PaymentProcessor:\n    def __init__(self, amount):\n        self.amount = amount\n\n    def process(self):\n        raise NotImplementedError\n\n    def get_fee(self):\n        raise NotImplementedError\n\n    def total_charge(self):\n        return self.amount + self.get_fee()\n\n\nclass CreditCardPayment(PaymentProcessor):\n    def __init__(self, amount, card_number):\n        super().__init__(amount)\n        self.card_number = card_number\n\n    def process(self):\n        return f\"Processing ${self.amount:.2f} via credit card ending in {self.card_number[-4:]}\"\n\n    def get_fee(self):\n        return self.amount * 0.029  # 2.9% fee\n\n\nclass PayPalPayment(PaymentProcessor):\n    def __init__(self, amount, email):\n        super().__init__(amount)\n        self.email = email\n\n    def process(self):\n        return f\"Processing ${self.amount:.2f} via PayPal ({self.email})\"\n\n    def get_fee(self):\n        return self.amount * 0.035 + 0.30  # 3.5% + $0.30\n\n\nclass BankTransfer(PaymentProcessor):\n    def __init__(self, amount, routing_number):\n        super().__init__(amount)\n        self.routing_number = routing_number\n\n    def process(self):\n        return f\"Processing ${self.amount:.2f} via bank transfer\"\n\n    def get_fee(self):\n        return 1.50  # Flat fee\n\n\nclass CryptoPayment(PaymentProcessor):\n    def __init__(self, amount, wallet_address):\n        super().__init__(amount)\n        self.wallet_address = wallet_address\n\n    def process(self):\n        return f\"Processing ${self.amount:.2f} via crypto to {self.wallet_address[:8]}...\"\n\n    def get_fee(self):\n        return self.amount * 0.01  # 1% fee\n\n\n# Polymorphism: same interface, different behaviors\npayments = [\n    CreditCardPayment(100.00, \"4532015112830366\"),\n    PayPalPayment(50.00, \"user@email.com\"),\n    BankTransfer(1000.00, \"021000021\"),\n    CryptoPayment(250.00, \"0x742d35Cc6634C0532925a3b844Bc9e7595f\")\n]\n\n# Process all payments uniformly - no type checking needed\nfor payment in payments:\n    print(payment.process())\n    print(f\"  Fee: ${payment.get_fee():.2f}\")\n    print(f\"  Total: ${payment.total_charge():.2f}\")\n    print()"
        ]
      ]
    },
