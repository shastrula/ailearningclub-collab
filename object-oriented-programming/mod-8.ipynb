          "java",
          "// Java: Polymorphism through interfaces\npublic interface Exportable {\n    String exportToCSV();\n    String exportToJSON();\n    String getFilename();\n}\n\npublic class UserReport implements Exportable {\n    private String username;\n    private int loginCount;\n\n    public UserReport(String username, int loginCount) {\n        this.username = username;\n        this.loginCount = loginCount;\n    }\n\n    @Override\n    public String exportToCSV() {\n        return username + \",\" + loginCount;\n    }\n\n    @Override\n    public String exportToJSON() {\n        return \"{\\\"user\\\":\\\"\" + username + \"\\\",\\\"logins\\\":\" + loginCount + \"}\";\n    }\n\n    @Override\n    public String getFilename() {\n        return \"user_report_\" + username;\n    }\n}\n\npublic class SalesReport implements Exportable {\n    private String product;\n    private double revenue;\n\n    public SalesReport(String product, double revenue) {\n        this.product = product;\n        this.revenue = revenue;\n    }\n\n    @Override\n    public String exportToCSV() {\n        return product + \",\" + revenue;\n    }\n\n    @Override\n    public String exportToJSON() {\n        return \"{\\\"product\\\":\\\"\" + product + \"\\\",\\\"revenue\\\":\" + revenue + \"}\";\n    }\n\n    @Override\n    public String getFilename() {\n        return \"sales_\" + product.toLowerCase().replace(\" \", \"_\");\n    }\n}\n\n// Polymorphic usage\npublic class ReportExporter {\n    public void exportAll(List<Exportable> reports, String format) {\n        for (Exportable report : reports) {\n            if (format.equals(\"csv\")) {\n                System.out.println(report.exportToCSV());\n            } else {\n                System.out.println(report.exportToJSON());\n            }\n        }\n    }\n}"
        ]
      ]
    },
