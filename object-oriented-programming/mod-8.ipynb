          "python",
          "# Python: Duck typing - no shared parent needed\nclass Dog:\n    def speak(self):\n        return \"Woof!\"\n\n    def move(self):\n        return \"Running on four legs\"\n\nclass Cat:\n    def speak(self):\n        return \"Meow!\"\n\n    def move(self):\n        return \"Sneaking silently\"\n\nclass Duck:\n    def speak(self):\n        return \"Quack!\"\n\n    def move(self):\n        return \"Waddling and swimming\"\n\nclass Robot:\n    def speak(self):\n        return \"Beep boop!\"\n\n    def move(self):\n        return \"Rolling on wheels\"\n\n\n# These classes have no common parent, but polymorphism works\ndef introduce(creature):\n    \"\"\"Works with ANY object that has speak() and move()\"\"\"\n    print(f\"  Sound: {creature.speak()}\")\n    print(f\"  Movement: {creature.move()}\")\n\ncreatures = [Dog(), Cat(), Duck(), Robot()]\nfor c in creatures:\n    introduce(c)\n    print()"
        ]
      ]
    },
