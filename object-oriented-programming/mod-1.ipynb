      "source": [
        [
          "python",
          "# Without OOP (procedural approach)\ndef create_student(name, grade):\n    return {\"name\": name, \"grade\": grade}\n\ndef get_student_info(student):\n    return f\"{student['name']} - Grade: {student['grade']}\"\n\n# With OOP\nclass Student:\n    def __init__(self, name, grade):\n        self.name = name\n        self.grade = grade\n\n    def get_info(self):\n        return f\"{self.name} - Grade: {self.grade}\"\n\n    def is_passing(self):\n        return self.grade >= 60\n\n# The OOP version is more organized and extensible\nstudent = Student(\"Maria\", 85)\nprint(student.get_info())      # Maria - Grade: 85\nprint(student.is_passing())    # True"
        ]
      ]
    }
