          "java",
          "// Java: Creating objects (instances)\npublic class Main {\n    public static void main(String[] args) {\n        Car myCar = new Car(\"Toyota\", \"Camry\", 2023);\n        Car yourCar = new Car(\"Honda\", \"Civic\", 2022);\n\n        System.out.println(myCar.displayInfo());   // Output: 2023 Toyota Camry\n        System.out.println(yourCar.displayInfo()); // Output: 2022 Honda Civic\n    }\n}"
