          "java",
          "// Java: Defining a simple class\npublic class Car {\n    private String make;\n    private String model;\n    private int year;\n\n    public Car(String make, String model, int year) {\n        this.make = make;\n        this.model = model;\n        this.year = year;\n    }\n\n    public String displayInfo() {\n        return year + \" \" + make + \" \" + model;\n    }\n}"
