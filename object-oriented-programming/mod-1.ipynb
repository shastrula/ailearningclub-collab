          "python",
          "# Python: Creating objects (instances)\nmy_car = Car(\"Toyota\", \"Camry\", 2023)\nyour_car = Car(\"Honda\", \"Civic\", 2022)\n\nprint(my_car.display_info())   # Output: 2023 Toyota Camry\nprint(your_car.display_info()) # Output: 2022 Honda Civic\n\n# Each object is independent\nprint(my_car is your_car)  # Output: False"
        ]
