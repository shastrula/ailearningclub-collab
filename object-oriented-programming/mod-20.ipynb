          "python",
          "# Python: Fluent collection operations\nclass QueryableList:\n    \"\"\"Collection with chainable query methods\"\"\"\n    def __init__(self, items=None):\n        self._items = list(items) if items else []\n\n    def where(self, predicate):\n        \"\"\"Filter items\"\"\"\n        return QueryableList(item for item in self._items if predicate(item))\n\n    def select(self, transform):\n        \"\"\"Transform items\"\"\"\n        return QueryableList(transform(item) for item in self._items)\n\n    def order_by(self, key, reverse=False):\n        \"\"\"Sort items\"\"\"\n        return QueryableList(sorted(self._items, key=key, reverse=reverse))\n\n    def take(self, n):\n        \"\"\"First n items\"\"\"\n        return QueryableList(self._items[:n])\n\n    def skip(self, n):\n        \"\"\"Skip n items\"\"\"\n        return QueryableList(self._items[n:])\n\n    def group_by(self, key_func):\n        \"\"\"Group items by key\"\"\"\n        groups = {}\n        for item in self._items:\n            key = key_func(item)\n            if key not in groups:\n                groups[key] = []\n            groups[key].append(item)\n        return groups\n\n    def first(self, default=None):\n        return self._items[0] if self._items else default\n\n    def count(self):\n        return len(self._items)\n\n    def sum(self, key=None):\n        if key:\n            return sum(key(item) for item in self._items)\n        return sum(self._items)\n\n    def to_list(self):\n        return list(self._items)\n\n    def __iter__(self):\n        return iter(self._items)\n\n    def __repr__(self):\n        return f\"QueryableList({self._items})\"\n\n\n# Expressive data querying\nproducts = QueryableList([\n    {\"name\": \"Laptop\", \"category\": \"Electronics\", \"price\": 999, \"stock\": 50},\n    {\"name\": \"Phone\", \"category\": \"Electronics\", \"price\": 699, \"stock\": 200},\n    {\"name\": \"Desk\", \"category\": \"Furniture\", \"price\": 299, \"stock\": 30},\n    {\"name\": \"Chair\", \"category\": \"Furniture\", \"price\": 199, \"stock\": 100},\n    {\"name\": \"Tablet\", \"category\": \"Electronics\", \"price\": 449, \"stock\": 75},\n])\n\n# Chain operations for complex queries\nexpensive_electronics = (products\n    .where(lambda p: p[\"category\"] == \"Electronics\")\n    .where(lambda p: p[\"price\"] > 500)\n    .order_by(lambda p: p[\"price\"], reverse=True)\n    .to_list())\n\nprint(\"Expensive electronics:\")\nfor p in expensive_electronics:\n    print(f\"  {p['name']}: ${p['price']}\")\n\n# Aggregate\ntotal_stock = products.sum(lambda p: p[\"stock\"])\nprint(f\"\\nTotal stock: {total_stock}\")\n\n# Group\nby_category = products.group_by(lambda p: p[\"category\"])\nfor cat, items in by_category.items():\n    print(f\"\\n{cat}: {len(items)} products\")"
        ]
      ]
