        [
          "python",
          "# Python: Custom collection with business logic\nclass Playlist:\n    def __init__(self, name, max_songs=100):\n        self.name = name\n        self._songs = []\n        self._max_songs = max_songs\n\n    def add_song(self, song):\n        if len(self._songs) >= self._max_songs:\n            raise ValueError(f\"Playlist full (max {self._max_songs} songs)\")\n        if song in self._songs:\n            raise ValueError(f\"'{song['title']}' already in playlist\")\n        self._songs.append(song)\n\n    def remove_song(self, title):\n        self._songs = [s for s in self._songs if s[\"title\"] != title]\n\n    def shuffle(self):\n        import random\n        shuffled = list(self._songs)\n        random.shuffle(shuffled)\n        return shuffled\n\n    def total_duration(self):\n        return sum(s.get(\"duration\", 0) for s in self._songs)\n\n    def search(self, query):\n        query_lower = query.lower()\n        return [s for s in self._songs\n                if query_lower in s[\"title\"].lower()\n                or query_lower in s.get(\"artist\", \"\").lower()]\n\n    def __len__(self):\n        return len(self._songs)\n\n    def __iter__(self):\n        return iter(self._songs)\n\n    def __contains__(self, song):\n        return song in self._songs\n\n    def __getitem__(self, index):\n        return self._songs[index]\n\n\nplaylist = Playlist(\"Road Trip\", max_songs=50)\nplaylist.add_song({\"title\": \"Bohemian Rhapsody\", \"artist\": \"Queen\", \"duration\": 355})\nplaylist.add_song({\"title\": \"Hotel California\", \"artist\": \"Eagles\", \"duration\": 391})\nplaylist.add_song({\"title\": \"Stairway to Heaven\", \"artist\": \"Led Zeppelin\", \"duration\": 482})\n\nprint(f\"Songs: {len(playlist)}\")\nprint(f\"Duration: {playlist.total_duration()}s\")\nprint(f\"Search 'queen': {playlist.search('queen')}\")\n\nfor song in playlist:\n    print(f\"  {song['title']} - {song['artist']}\")"
        ]
      ]
    },
