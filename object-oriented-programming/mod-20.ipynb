          "python",
          "# Python: Type-safe sorted collection\nfrom typing import TypeVar, Generic, List, Callable\n\nT = TypeVar('T')\n\nclass SortedList(Generic[T]):\n    \"\"\"A list that maintains sorted order\"\"\"\n    def __init__(self, key: Callable[[T], any] = None):\n        self._items: List[T] = []\n        self._key = key or (lambda x: x)\n\n    def add(self, item: T) -> None:\n        # Binary search for insertion point\n        lo, hi = 0, len(self._items)\n        item_key = self._key(item)\n        while lo < hi:\n            mid = (lo + hi) // 2\n            if self._key(self._items[mid]) < item_key:\n                lo = mid + 1\n            else:\n                hi = mid\n        self._items.insert(lo, item)\n\n    def remove(self, item: T) -> bool:\n        try:\n            self._items.remove(item)\n            return True\n        except ValueError:\n            return False\n\n    def find(self, predicate: Callable[[T], bool]) -> List[T]:\n        return [item for item in self._items if predicate(item)]\n\n    def __len__(self):\n        return len(self._items)\n\n    def __iter__(self):\n        return iter(self._items)\n\n    def __getitem__(self, index):\n        return self._items[index]\n\n    def __repr__(self):\n        return f\"SortedList({self._items})\"\n\n\n# Sorted by score (descending)\nclass Player:\n    def __init__(self, name, score):\n        self.name = name\n        self.score = score\n\n    def __repr__(self):\n        return f\"{self.name}:{self.score}\"\n\nleaderboard = SortedList(key=lambda p: -p.score)\nleaderboard.add(Player(\"Alice\", 2500))\nleaderboard.add(Player(\"Bob\", 3200))\nleaderboard.add(Player(\"Charlie\", 1800))\nleaderboard.add(Player(\"Diana\", 4100))\n\nprint(\"Leaderboard:\")\nfor i, player in enumerate(leaderboard, 1):\n    print(f\"  {i}. {player.name}: {player.score} pts\")"
        ]
      ]
