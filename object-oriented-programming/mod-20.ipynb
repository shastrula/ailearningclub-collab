        [
          "python",
          "# Python: Custom iterator\nclass DateRange:\n    \"\"\"Iterate over a range of dates\"\"\"\n    def __init__(self, start_date, end_date):\n        from datetime import date\n        if isinstance(start_date, str):\n            start_date = date.fromisoformat(start_date)\n        if isinstance(end_date, str):\n            end_date = date.fromisoformat(end_date)\n        self.start_date = start_date\n        self.end_date = end_date\n\n    def __iter__(self):\n        from datetime import timedelta\n        current = self.start_date\n        while current <= self.end_date:\n            yield current\n            current += timedelta(days=1)\n\n    def __len__(self):\n        return (self.end_date - self.start_date).days + 1\n\n    def __contains__(self, date):\n        return self.start_date <= date <= self.end_date\n\n    def weekdays(self):\n        return [d for d in self if d.weekday() < 5]\n\n    def weekends(self):\n        return [d for d in self if d.weekday() >= 5]\n\n\n# Use like any iterable\ndates = DateRange(\"2024-01-01\", \"2024-01-10\")\nprint(f\"Total days: {len(dates)}\")\nprint(f\"Weekdays: {len(dates.weekdays())}\")\n\nfor d in dates:\n    day_type = \"Weekend\" if d.weekday() >= 5 else \"Weekday\"\n    print(f\"  {d} ({day_type})\")"
        ]
      ]
    },
