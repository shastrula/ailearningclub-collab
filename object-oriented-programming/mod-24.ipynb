      "source": [
        [
          "python",
          "@dataclass\nclass Member:\n    member_id: str\n    name: str\n    email: str\n    max_items: int = 5\n    _borrowed_items: List[str] = field(default_factory=list, repr=False)\n    _history: List[dict] = field(default_factory=list, repr=False)\n    fines: float = 0.0\n\n    @property\n    def borrowed_count(self) -> int:\n        return len(self._borrowed_items)\n\n    @property\n    def can_borrow(self) -> bool:\n        return self.borrowed_count < self.max_items and self.fines == 0\n\n    def add_borrowed(self, item_id: str):\n        if not self.can_borrow:\n            if self.fines > 0:\n                raise ValueError(f\"Outstanding fines: ${self.fines:.2f}\")\n            raise ValueError(f\"Borrow limit reached ({self.max_items})\")\n        self._borrowed_items.append(item_id)\n\n    def remove_borrowed(self, item_id: str):\n        self._borrowed_items.remove(item_id)\n\n    def add_to_history(self, action: str, item_id: str):\n        self._history.append({\n            \"action\": action,\n            \"item_id\": item_id,\n            \"date\": datetime.now().isoformat()\n        })\n\n    def charge_fine(self, amount: float):\n        self.fines += amount\n\n    def pay_fine(self, amount: float):\n        self.fines = max(0, self.fines - amount)"
        ]
      ]
    },
    {
      "cell_type": "code",
