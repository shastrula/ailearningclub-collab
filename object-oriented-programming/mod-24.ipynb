        [
          "python",
          "class Library:\n    \"\"\"Facade: simplified interface to the library system\"\"\"\n\n    def __init__(self, name: str):\n        self.name = name\n        self._catalog: dict[str, LibraryItem] = {}\n        self._members: dict[str, Member] = {}\n        self._loans: dict[str, Loan] = {}\n        self._search_engine = SearchEngine()\n        self._loan_counter = 0\n\n    def add_item(self, item: LibraryItem):\n        self._catalog[item.item_id] = item\n\n    def register_member(self, member: Member):\n        self._members[member.member_id] = member\n\n    def checkout(self, item_id: str, member_id: str) -> Loan:\n        item = self._catalog.get(item_id)\n        if not item:\n            raise ValueError(f\"Item not found: {item_id}\")\n\n        member = self._members.get(member_id)\n        if not member:\n            raise ValueError(f\"Member not found: {member_id}\")\n\n        member.add_borrowed(item_id)\n        item.checkout(member_id)\n\n        self._loan_counter += 1\n        loan = Loan(\n            loan_id=f\"LOAN-{self._loan_counter:04d}\",\n            item_id=item_id,\n            member_id=member_id,\n            checkout_date=datetime.now(),\n            due_date=datetime.now() + timedelta(days=item.loan_period_days)\n        )\n        self._loans[loan.loan_id] = loan\n        member.add_to_history(\"checkout\", item_id)\n        return loan\n\n    def return_item(self, item_id: str) -> dict:\n        item = self._catalog.get(item_id)\n        if not item:\n            raise ValueError(f\"Item not found: {item_id}\")\n\n        active_loan = None\n        for loan in self._loans.values():\n            if loan.item_id == item_id and loan.is_active:\n                active_loan = loan\n                break\n\n        if not active_loan:\n            raise ValueError(f\"No active loan for: {item_id}\")\n\n        member = self._members[active_loan.member_id]\n        fine = 0.0\n\n        if active_loan.is_overdue:\n            fine = active_loan.days_overdue * item.late_fee_per_day\n            member.charge_fine(fine)\n\n        active_loan.complete()\n        item.return_item()\n        member.remove_borrowed(item_id)\n        member.add_to_history(\"return\", item_id)\n\n        return {\"loan_id\": active_loan.loan_id, \"fine\": fine}\n\n    def search(self, query: str, search_type: str = \"title\") -> List[LibraryItem]:\n        items = list(self._catalog.values())\n        return self._search_engine.search(items, query, search_type)\n\n    def get_member_loans(self, member_id: str) -> List[Loan]:\n        return [l for l in self._loans.values()\n                if l.member_id == member_id and l.is_active]\n\n    def get_overdue_items(self) -> List[Loan]:\n        return [l for l in self._loans.values() if l.is_overdue]\n\n\n# Using the complete library system\nlibrary = Library(\"City Central Library\")\n\n# Add items\nlibrary.add_item(Book(\"B001\", \"Clean Code\", author=\"Robert Martin\", genre=\"Programming\"))\nlibrary.add_item(Book(\"B002\", \"Design Patterns\", author=\"Gang of Four\", genre=\"Programming\"))\nlibrary.add_item(DVD(\"D001\", \"The Matrix\", director=\"Wachowskis\", rating=\"R\"))\nlibrary.add_item(Magazine(\"M001\", \"Python Weekly #42\", publisher=\"PyMedia\", issue_number=42))\n\n# Register members\nlibrary.register_member(Member(\"MEM-001\", \"Alice Smith\", \"alice@email.com\"))\nlibrary.register_member(Member(\"MEM-002\", \"Bob Johnson\", \"bob@email.com\"))\n\n# Operations\nloan = library.checkout(\"B001\", \"MEM-001\")\nprint(f\"Checked out: {loan.loan_id}, due: {loan.due_date.strftime('%Y-%m-%d')}\")\n\nresults = library.search(\"clean\", \"title\")\nprint(f\"Search results: {[r.title for r in results]}\")\n\nresults = library.search(\"programming\", \"genre\")\nprint(f\"Programming books: {[r.title for r in results]}\")"
        ]
