      "source": [
        [
          "python",
          "class SearchStrategy(ABC):\n    @abstractmethod\n    def search(self, items: List[LibraryItem], query: str) -> List[LibraryItem]:\n        pass\n\nclass TitleSearch(SearchStrategy):\n    def search(self, items: List[LibraryItem], query: str) -> List[LibraryItem]:\n        query_lower = query.lower()\n        return [item for item in items if query_lower in item.title.lower()]\n\nclass AuthorSearch(SearchStrategy):\n    def search(self, items: List[LibraryItem], query: str) -> List[LibraryItem]:\n        query_lower = query.lower()\n        return [item for item in items\n                if hasattr(item, 'author') and query_lower in item.author.lower()]\n\nclass GenreSearch(SearchStrategy):\n    def search(self, items: List[LibraryItem], query: str) -> List[LibraryItem]:\n        query_lower = query.lower()\n        return [item for item in items\n                if hasattr(item, 'genre') and query_lower in item.genre.lower()]\n\nclass SearchEngine:\n    def __init__(self):\n        self._strategies = {\n            \"title\": TitleSearch(),\n            \"author\": AuthorSearch(),\n            \"genre\": GenreSearch(),\n        }\n\n    def search(self, items: List[LibraryItem], query: str,\n               search_type: str = \"title\") -> List[LibraryItem]:\n        strategy = self._strategies.get(search_type)\n        if not strategy:\n            raise ValueError(f\"Unknown search type: {search_type}\")\n        return strategy.search(items, query)"
        ]
      ]
    },
    {
