      "source": [
        [
          "python",
          "# Core domain classes\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timedelta\nfrom typing import List, Optional\nfrom abc import ABC, abstractmethod\nfrom enum import Enum\n\nclass ItemStatus(Enum):\n    AVAILABLE = \"available\"\n    BORROWED = \"borrowed\"\n    RESERVED = \"reserved\"\n    MAINTENANCE = \"maintenance\"\n\n\n@dataclass\nclass LibraryItem(ABC):\n    \"\"\"Base class for all library items\"\"\"\n    item_id: str\n    title: str\n    status: ItemStatus = ItemStatus.AVAILABLE\n    _borrower: Optional[str] = field(default=None, repr=False)\n\n    @property\n    @abstractmethod\n    def loan_period_days(self) -> int:\n        pass\n\n    @property\n    @abstractmethod\n    def late_fee_per_day(self) -> float:\n        pass\n\n    @property\n    def is_available(self) -> bool:\n        return self.status == ItemStatus.AVAILABLE\n\n    def checkout(self, member_id: str):\n        if not self.is_available:\n            raise ValueError(f\"'{self.title}' is not available (status: {self.status.value})\")\n        self.status = ItemStatus.BORROWED\n        self._borrower = member_id\n\n    def return_item(self):\n        self.status = ItemStatus.AVAILABLE\n        self._borrower = None\n\n\n@dataclass\nclass Book(LibraryItem):\n    author: str = \"\"\n    isbn: str = \"\"\n    pages: int = 0\n    genre: str = \"\"\n\n    @property\n    def loan_period_days(self) -> int:\n        return 21  # 3 weeks\n\n    @property\n    def late_fee_per_day(self) -> float:\n        return 0.25\n\n\n@dataclass\nclass DVD(LibraryItem):\n    director: str = \"\"\n    duration_minutes: int = 0\n    rating: str = \"\"\n\n    @property\n    def loan_period_days(self) -> int:\n        return 7  # 1 week\n\n    @property\n    def late_fee_per_day(self) -> float:\n        return 1.00\n\n\n@dataclass\nclass Magazine(LibraryItem):\n    issue_number: int = 0\n    publisher: str = \"\"\n\n    @property\n    def loan_period_days(self) -> int:\n        return 7\n\n    @property\n    def late_fee_per_day(self) -> float:\n        return 0.10"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
