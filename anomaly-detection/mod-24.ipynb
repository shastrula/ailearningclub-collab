          "python",
          "import numpy as np\nimport pandas as pd\n\n# Simulated final rankings based on benchmark results\nrankings = {\n    'Method': ['Isolation Forest', 'LOF', 'One-Class SVM', 'Elliptic Envelope'],\n    'Simple Data': [2, 3, 3, 1],\n    'Multi-cluster': [2, 1, 3, 4],\n    'Varying Density': [2, 1, 3, 4],\n    'High-dim': [2, 4, 3, 1],\n    'Local Anomalies': [2, 1, 3, 4],\n    'Avg Rank': [2.0, 2.0, 3.0, 2.8],\n}\n\ndf_rank = pd.DataFrame(rankings)\nprint(\"Method Rankings Across Datasets (1=best, 4=worst)\")\nprint(\"=\" * 75)\nprint(df_rank.to_string(index=False))\n\nprint(\"\\n\\nMethod Selection Decision Framework:\")\nprint(\"=\" * 55)\nprint(\"\"\"\nIF your data has:\n  - Single Gaussian cluster \u2192 Elliptic Envelope\n  - Multiple clusters, varying density \u2192 LOF\n  - High dimensions (>20 features) \u2192 Isolation Forest\n  - Local anomalies (between clusters) \u2192 LOF\n  - Very large dataset (>100K) \u2192 Isolation Forest\n  - Need for fast training \u2192 Elliptic Envelope\n  - Need for novelty detection \u2192 LOF or One-Class SVM\n  - Unknown structure \u2192 Start with Isolation Forest\n\"\"\")"
        ]
