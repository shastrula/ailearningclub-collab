      "source": [
        "# Anomaly Detection - mod-24\n\n",
        "**Course:** anomaly-detection\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.neighbors import LocalOutlierFactor\nfrom sklearn.svm import OneClassSVM\nfrom sklearn.covariance import EllipticEnvelope\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import f1_score, average_precision_score\nimport time\n\nnp.random.seed(42)\n\ndef create_benchmark_datasets():\n    \"\"\"Create diverse datasets for benchmarking.\"\"\"\n    datasets = {}\n    \n    # Dataset 1: Simple (single cluster, point anomalies)\n    X_n, _ = make_blobs(n_samples=950, centers=1, cluster_std=1.0, random_state=42)\n    X_a = np.random.uniform(-5, 5, (50, 2))\n    datasets['Simple (1 cluster)'] = (np.vstack([X_n, X_a]), np.array([0]*950 + [1]*50))\n    \n    # Dataset 2: Multi-cluster\n    X_n, _ = make_blobs(n_samples=950, centers=5, cluster_std=0.8, random_state=42)\n    X_a = np.random.uniform(-12, 12, (50, 2))\n    datasets['Multi-cluster (5)'] = (np.vstack([X_n, X_a]), np.array([0]*950 + [1]*50))\n    \n    # Dataset 3: Varying density\n    X1 = np.random.normal([0, 0], 0.3, (300, 2))\n    X2 = np.random.normal([5, 5], 2.0, (300, 2))\n    X3 = np.random.normal([-5, 5], 1.0, (350, 2))\n    X_a = np.array([[2.5, 2.5], [-2, 8], [8, 0], [-8, -3], [0, 10]] * 10)\n    datasets['Varying density'] = (np.vstack([X1, X2, X3, X_a]), np.array([0]*950 + [1]*50))\n    \n    # Dataset 4: High dimensional (20 features)\n    X_n = np.random.normal(0, 1, (950, 20))\n    X_a = np.random.uniform(-4, 4, (50, 20))\n    datasets['High-dim (20 feat)'] = (np.vstack([X_n, X_a]), np.array([0]*950 + [1]*50))\n    \n    # Dataset 5: Local anomalies (between clusters)\n    X_n, _ = make_blobs(n_samples=950, centers=[[0,0],[8,8]], cluster_std=1.0, random_state=42)\n    X_a = np.random.normal([4, 4], 0.5, (50, 2))  # Between clusters\n    datasets['Local anomalies'] = (np.vstack([X_n, X_a]), np.array([0]*950 + [1]*50))\n    \n    return datasets\n\ndatasets = create_benchmark_datasets()\n\n# Define methods\ndef get_methods():\n    return {\n        'Isolation Forest': lambda: IsolationForest(contamination=0.05, n_estimators=200, random_state=42),\n        'LOF': lambda: LocalOutlierFactor(contamination=0.05, n_neighbors=20),\n        'One-Class SVM': lambda: OneClassSVM(nu=0.05, kernel='rbf'),\n        'Elliptic Envelope': lambda: EllipticEnvelope(contamination=0.05, random_state=42),\n    }\n\n# Run benchmark\nresults = []\nmethods = get_methods()\n\nfor ds_name, (X, y) in datasets.items():\n    X_scaled = StandardScaler().fit_transform(X)\n    \n    for method_name, method_factory in methods.items():\n        start = time.time()\n        model = method_factory()\n        \n        try:\n            if method_name == 'LOF':\n                y_pred = (model.fit_predict(X_scaled) == -1).astype(int)\n                scores = -model.negative_outlier_factor_\n            else:\n                model.fit(X_scaled)\n                y_pred = (model.predict(X_scaled) == -1).astype(int)\n                scores = -model.decision_function(X_scaled)\n            \n            elapsed = time.time() - start\n            f1 = f1_score(y, y_pred, zero_division=0)\n            pr_auc = average_precision_score(y, scores)\n            \n            results.append({\n                'Dataset': ds_name, 'Method': method_name,\n                'F1': f1, 'PR-AUC': pr_auc, 'Time': elapsed\n            })\n        except Exception as e:\n            results.append({\n                'Dataset': ds_name, 'Method': method_name,\n                'F1': 0, 'PR-AUC': 0, 'Time': 0\n            })\n\nresults_df = pd.DataFrame(results)\n\nprint(\"Comprehensive Anomaly Detection Benchmark\")\nprint(\"=\" * 75)\nfor ds_name in datasets.keys():\n    ds_results = results_df[results_df['Dataset'] == ds_name]\n    print(f\"\\n{ds_name}:\")\n    print(f\"  {'Method':<20} {'F1':<8} {'PR-AUC':<10} {'Time (s)':<10}\")\n    print(f\"  {'-'*50}\")\n    for _, row in ds_results.iterrows():\n        print(f\"  {row['Method']:<20} {row['F1']:<8.4f} {row['PR-AUC']:<10.4f} {row['Time']:<10.4f}\")"
        ]
      ]
    },
