          "python",
          "import numpy as np\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.neighbors import LocalOutlierFactor\nfrom sklearn.svm import OneClassSVM\nfrom sklearn.covariance import EllipticEnvelope\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import f1_score, precision_score, recall_score\n\nnp.random.seed(42)\n\n# Generate dataset\nX_normal, _ = make_blobs(n_samples=900, centers=3, cluster_std=1.0, random_state=42)\nX_anomaly = np.random.uniform(-8, 8, (50, 2))\nX = np.vstack([X_normal, X_anomaly])\ny_true = np.array([0]*900 + [1]*50)\nX_scaled = StandardScaler().fit_transform(X)\n\n# Individual detectors\ndetectors = {\n    'Isolation Forest': IsolationForest(contamination=0.05, random_state=42),\n    'LOF': LocalOutlierFactor(n_neighbors=20, contamination=0.05),\n    'One-Class SVM': OneClassSVM(nu=0.05, kernel='rbf'),\n    'Elliptic Envelope': EllipticEnvelope(contamination=0.05, random_state=42),\n}\n\npredictions = {}\nfor name, model in detectors.items():\n    if name == 'LOF':\n        pred = (model.fit_predict(X_scaled) == -1).astype(int)\n    else:\n        model.fit(X_scaled)\n        pred = (model.predict(X_scaled) == -1).astype(int)\n    predictions[name] = pred\n\n# Voting ensembles\nvote_matrix = np.column_stack(list(predictions.values()))\n\n# Different voting thresholds\nprint(\"Voting Ensemble Results\")\nprint(\"=\" * 65)\nprint(f\"{'Strategy':<25} {'Precision':<12} {'Recall':<10} {'F1':<8} {'Detected'}\")\nprint(\"-\" * 65)\n\n# Individual models\nfor name, pred in predictions.items():\n    prec = precision_score(y_true, pred, zero_division=0)\n    rec = recall_score(y_true, pred, zero_division=0)\n    f1 = f1_score(y_true, pred, zero_division=0)\n    print(f\"{name:<25} {prec:<12.4f} {rec:<10.4f} {f1:<8.4f} {pred.sum()}\")\n\nprint(\"-\" * 65)\n\n# Ensembles\nfor min_votes in [1, 2, 3, 4]:\n    ensemble_pred = (vote_matrix.sum(axis=1) >= min_votes).astype(int)\n    prec = precision_score(y_true, ensemble_pred, zero_division=0)\n    rec = recall_score(y_true, ensemble_pred, zero_division=0)\n    f1 = f1_score(y_true, ensemble_pred, zero_division=0)\n    label = f\"Ensemble (>={min_votes}/4 votes)\"\n    print(f\"{label:<25} {prec:<12.4f} {rec:<10.4f} {f1:<8.4f} {ensemble_pred.sum()}\")"
        ]
      ]
    },
