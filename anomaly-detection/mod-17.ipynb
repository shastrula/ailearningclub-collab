          "python",
          "import numpy as np\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.neighbors import LocalOutlierFactor\nfrom sklearn.svm import OneClassSVM\nfrom sklearn.preprocessing import StandardScaler, MinMaxScaler\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import f1_score, average_precision_score\n\nnp.random.seed(42)\n\nX_normal, _ = make_blobs(n_samples=900, centers=3, cluster_std=1.0, random_state=42)\nX_anomaly = np.random.uniform(-8, 8, (50, 2))\nX = np.vstack([X_normal, X_anomaly])\ny_true = np.array([0]*900 + [1]*50)\nX_scaled = StandardScaler().fit_transform(X)\n\n# Get continuous scores from each detector\n# Isolation Forest\niforest = IsolationForest(n_estimators=200, random_state=42)\niforest.fit(X_scaled)\nscores_if = -iforest.decision_function(X_scaled)\n\n# LOF\nlof = LocalOutlierFactor(n_neighbors=20)\nlof.fit_predict(X_scaled)\nscores_lof = -lof.negative_outlier_factor_\n\n# One-Class SVM\nocsvm = OneClassSVM(nu=0.05, kernel='rbf')\nocsvm.fit(X_scaled)\nscores_svm = -ocsvm.decision_function(X_scaled)\n\n# Normalize scores to [0, 1]\nscaler_scores = MinMaxScaler()\nall_scores = np.column_stack([scores_if, scores_lof, scores_svm])\nall_scores_normalized = scaler_scores.fit_transform(all_scores)\n\n# Averaging methods\navg_score = all_scores_normalized.mean(axis=1)\nmax_score = all_scores_normalized.max(axis=1)\nweighted_avg = np.average(all_scores_normalized, axis=1, weights=[0.4, 0.4, 0.2])\n\nprint(\"Score-Averaging Ensemble\")\nprint(\"=\" * 55)\nprint(f\"{'Method':<20} {'PR-AUC':<10} {'F1 @95pctl':<12}\")\nprint(\"-\" * 55)\n\nfor name, scores in [(\"IF only\", all_scores_normalized[:, 0]),\n                     (\"LOF only\", all_scores_normalized[:, 1]),\n                     (\"SVM only\", all_scores_normalized[:, 2]),\n                     (\"Average\", avg_score),\n                     (\"Max\", max_score),\n                     (\"Weighted (4:4:2)\", weighted_avg)]:\n    pr_auc = average_precision_score(y_true, scores)\n    threshold = np.percentile(scores, 95)\n    preds = (scores > threshold).astype(int)\n    f1 = f1_score(y_true, preds, zero_division=0)\n    print(f\"{name:<20} {pr_auc:<10.4f} {f1:<12.4f}\")"
        ]
      ]
    },
