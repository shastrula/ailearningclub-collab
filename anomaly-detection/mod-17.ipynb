        [
          "python",
          "import numpy as np\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score, average_precision_score\n\nnp.random.seed(42)\n\n# High-dimensional dataset\nn_features = 20\nn_normal = 800\nX_normal = np.random.normal(0, 1, (n_normal, n_features))\n# Add correlations\nX_normal[:, 10:] = X_normal[:, :10] + np.random.normal(0, 0.5, (n_normal, 10))\n\n# Anomalies: break correlations\nn_anomaly = 40\nX_anomaly = np.random.uniform(-3, 3, (n_anomaly, n_features))\n\nX = np.vstack([X_normal, X_anomaly])\ny_true = np.array([0]*n_normal + [1]*n_anomaly)\nX_scaled = StandardScaler().fit_transform(X)\n\n# Feature bagging: train detectors on random feature subsets\nn_bags = 10\nfeature_fraction = 0.5\nn_selected = int(n_features * feature_fraction)\nbag_predictions = []\nbag_scores = []\n\nfor i in range(n_bags):\n    # Random feature subset\n    selected_features = np.random.choice(n_features, n_selected, replace=False)\n    X_subset = X_scaled[:, selected_features]\n    \n    # Train detector on subset\n    clf = IsolationForest(n_estimators=100, contamination=0.05, random_state=i)\n    clf.fit(X_subset)\n    \n    scores = -clf.decision_function(X_subset)\n    pred = (clf.predict(X_subset) == -1).astype(int)\n    \n    bag_scores.append(scores)\n    bag_predictions.append(pred)\n\n# Combine predictions\nvote_matrix = np.column_stack(bag_predictions)\nscore_matrix = np.column_stack(bag_scores)\n\n# Normalize and average scores\nfrom sklearn.preprocessing import MinMaxScaler\nscore_normalized = MinMaxScaler().fit_transform(score_matrix)\navg_bag_score = score_normalized.mean(axis=1)\n\n# Compare single full model vs bagged ensemble\nsingle_clf = IsolationForest(n_estimators=100, contamination=0.05, random_state=42)\nsingle_clf.fit(X_scaled)\nsingle_scores = -single_clf.decision_function(X_scaled)\nsingle_pred = (single_clf.predict(X_scaled) == -1).astype(int)\n\n# Ensemble prediction\nensemble_pred = (vote_matrix.sum(axis=1) >= 5).astype(int)  # Majority vote\n\nprint(\"Feature Bagging Ensemble (20 features)\")\nprint(\"=\" * 55)\nprint(f\"Bags: {n_bags}, Features per bag: {n_selected}/{n_features}\")\nprint(f\"\\n{'Method':<25} {'PR-AUC':<10} {'F1':<8}\")\nprint(\"-\" * 55)\nprint(f\"{'Single (all features)':<25} {average_precision_score(y_true, single_scores):<10.4f} \"\n      f\"{f1_score(y_true, single_pred):<8.4f}\")\nprint(f\"{'Bagged (majority vote)':<25} {average_precision_score(y_true, avg_bag_score):<10.4f} \"\n      f\"{f1_score(y_true, ensemble_pred):<8.4f}\")"
        ]
      ]
    },
