      "source": [
        [
          "python",
          "import numpy as np\nfrom sklearn.metrics import fbeta_score, precision_score, recall_score\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.datasets import make_blobs\n\nnp.random.seed(42)\n\n# Dataset\nX_normal, _ = make_blobs(n_samples=950, centers=3, cluster_std=1.0, random_state=42)\nX_anomaly = np.random.uniform(-8, 8, (50, 2))\nX = np.vstack([X_normal, X_anomaly])\ny_true = np.array([0]*950 + [1]*50)\nX_scaled = StandardScaler().fit_transform(X)\n\n# Train model and get scores\niforest = IsolationForest(n_estimators=200, random_state=42)\niforest.fit(X_scaled)\nscores = -iforest.decision_function(X_scaled)\n\n# Different thresholds give different precision-recall trade-offs\nprint(\"F-beta Scores at Different Thresholds\")\nprint(\"=\" * 75)\nprint(f\"{'Threshold':<12} {'Precision':<12} {'Recall':<10} {'F1':<8} {'F0.5':<8} {'F2':<8}\")\nprint(\"-\" * 75)\n\npercentiles = [90, 92, 94, 95, 96, 97, 98, 99]\nfor pctl in percentiles:\n    threshold = np.percentile(scores, pctl)\n    y_pred = (scores > threshold).astype(int)\n    \n    prec = precision_score(y_true, y_pred, zero_division=0)\n    rec = recall_score(y_true, y_pred, zero_division=0)\n    f1 = fbeta_score(y_true, y_pred, beta=1, zero_division=0)\n    f05 = fbeta_score(y_true, y_pred, beta=0.5, zero_division=0)  # Favors precision\n    f2 = fbeta_score(y_true, y_pred, beta=2, zero_division=0)    # Favors recall\n    \n    print(f\"{pctl}th pctl   {prec:<12.4f} {rec:<10.4f} {f1:<8.4f} {f05:<8.4f} {f2:<8.4f}\")\n\nprint(f\"\\nF0.5: Prioritizes precision (fewer false alarms)\")\nprint(f\"F2: Prioritizes recall (catch more anomalies)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
