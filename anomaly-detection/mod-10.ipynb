        [
          "python",
          "import numpy as np\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.neighbors import LocalOutlierFactor\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import precision_recall_curve, auc, average_precision_score\n\nnp.random.seed(42)\n\n# Dataset\nX_normal, _ = make_blobs(n_samples=950, centers=3, cluster_std=1.0, random_state=42)\nX_anomaly = np.random.uniform(-8, 8, (50, 2))\nX = np.vstack([X_normal, X_anomaly])\ny_true = np.array([0]*950 + [1]*50)\nX_scaled = StandardScaler().fit_transform(X)\n\n# Get continuous scores from each model\n# Isolation Forest\niforest = IsolationForest(n_estimators=200, random_state=42)\niforest.fit(X_scaled)\nscores_if = -iforest.decision_function(X_scaled)  # Higher = more anomalous\n\n# LOF\nlof = LocalOutlierFactor(n_neighbors=20)\nlof.fit_predict(X_scaled)\nscores_lof = -lof.negative_outlier_factor_  # Higher = more anomalous\n\n# One-Class SVM\nocsvm = OneClassSVM(nu=0.05, kernel='rbf')\nocsvm.fit(X_scaled)\nscores_svm = -ocsvm.decision_function(X_scaled)\n\nprint(\"Precision-Recall AUC Comparison\")\nprint(\"=\" * 55)\nprint(f\"Baseline (random): {y_true.mean():.4f} (anomaly proportion)\")\nprint(f\"\\n{'Method':<18} {'PR-AUC':<10} {'Avg Precision':<15}\")\nprint(\"-\" * 55)\n\nfor name, scores in [(\"Isolation Forest\", scores_if),\n                     (\"LOF\", scores_lof),\n                     (\"One-Class SVM\", scores_svm)]:\n    precision, recall, _ = precision_recall_curve(y_true, scores)\n    pr_auc = auc(recall, precision)\n    avg_prec = average_precision_score(y_true, scores)\n    print(f\"{name:<18} {pr_auc:<10.4f} {avg_prec:<15.4f}\")\n\n# Show PR curve points for best model\nbest_scores = scores_lof\nprecision, recall, thresholds = precision_recall_curve(y_true, best_scores)\nprint(f\"\\nPR Curve Points (LOF - sample):\")\nprint(f\"{'Threshold':<12} {'Precision':<12} {'Recall':<10}\")\nprint(\"-\" * 35)\nindices = np.linspace(0, len(thresholds)-1, 8, dtype=int)\nfor idx in indices:\n    print(f\"{thresholds[idx]:<12.4f} {precision[idx]:<12.4f} {recall[idx]:<10.4f}\")"
        ]
      ]
    },
