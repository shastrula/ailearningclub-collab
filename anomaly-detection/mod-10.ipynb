          "python",
          "import numpy as np\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import roc_auc_score, average_precision_score, roc_curve\n\nnp.random.seed(42)\n\n# Test with different imbalance ratios\nprint(\"ROC-AUC vs PR-AUC at Different Imbalance Ratios\")\nprint(\"=\" * 60)\nprint(f\"{'Anomaly %':<12} {'ROC-AUC':<10} {'PR-AUC':<10} {'Difference':<12}\")\nprint(\"-\" * 60)\n\nfor anomaly_pct in [0.5, 1.0, 2.0, 5.0, 10.0, 20.0]:\n    n_total = 1000\n    n_anomaly = int(n_total * anomaly_pct / 100)\n    n_normal = n_total - n_anomaly\n    \n    X_normal, _ = make_blobs(n_samples=n_normal, centers=2, cluster_std=1.0, random_state=42)\n    X_anomaly = np.random.uniform(-6, 6, (n_anomaly, 2))\n    X = np.vstack([X_normal, X_anomaly])\n    y_true = np.array([0]*n_normal + [1]*n_anomaly)\n    X_scaled = StandardScaler().fit_transform(X)\n    \n    iforest = IsolationForest(n_estimators=100, random_state=42)\n    iforest.fit(X_scaled)\n    scores = -iforest.decision_function(X_scaled)\n    \n    roc = roc_auc_score(y_true, scores)\n    pr = average_precision_score(y_true, scores)\n    \n    print(f\"{anomaly_pct:<12.1f} {roc:<10.4f} {pr:<10.4f} {roc-pr:<12.4f}\")\n\nprint(f\"\\nKey insight: ROC-AUC is optimistic for rare anomalies.\")\nprint(f\"PR-AUC better reflects practical detection performance.\")"
        ]
      ]
    },
    {
