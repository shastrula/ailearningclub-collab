        [
          "python",
          "import numpy as np\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.neighbors import LocalOutlierFactor\nfrom sklearn.svm import OneClassSVM\nfrom sklearn.datasets import make_blobs\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import precision_score, recall_score, f1_score, confusion_matrix\n\nnp.random.seed(42)\n\n# Create imbalanced dataset (5% anomalies)\nX_normal, _ = make_blobs(n_samples=950, centers=3, cluster_std=1.0, random_state=42)\nX_anomaly = np.random.uniform(-8, 8, (50, 2))\nX = np.vstack([X_normal, X_anomaly])\ny_true = np.array([0]*950 + [1]*50)\nX_scaled = StandardScaler().fit_transform(X)\n\nmodels = {\n    'Isolation Forest': IsolationForest(contamination=0.05, random_state=42),\n    'LOF': LocalOutlierFactor(n_neighbors=20, contamination=0.05),\n    'One-Class SVM': OneClassSVM(nu=0.05, kernel='rbf'),\n}\n\nprint(\"Confusion Matrix and Metrics Comparison\")\nprint(\"=\" * 65)\n\nfor name, model in models.items():\n    if name == 'LOF':\n        y_pred = (model.fit_predict(X_scaled) == -1).astype(int)\n    else:\n        model.fit(X_scaled)\n        y_pred = (model.predict(X_scaled) == -1).astype(int)\n    \n    tn, fp, fn, tp = confusion_matrix(y_true, y_pred).ravel()\n    prec = precision_score(y_true, y_pred)\n    rec = recall_score(y_true, y_pred)\n    f1 = f1_score(y_true, y_pred)\n    \n    print(f\"\\n{name}:\")\n    print(f\"  Confusion Matrix: TP={tp}, FP={fp}, FN={fn}, TN={tn}\")\n    print(f\"  Precision: {prec:.4f} (of predicted anomalies, how many are real)\")\n    print(f\"  Recall: {rec:.4f} (of real anomalies, how many are caught)\")\n    print(f\"  F1 Score: {f1:.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
