          "python",
          "import numpy as np\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import f1_score\nfrom sklearn.preprocessing import StandardScaler\n\nnp.random.seed(42)\n\n# Fixed dataset\nX_normal, _ = make_blobs(n_samples=950, centers=3, cluster_std=1.0, random_state=42)\nanomalies = np.random.uniform(low=-8, high=8, size=(50, 2))\nX = np.vstack([X_normal, anomalies])\ny_true = np.array([0]*950 + [1]*50)\nX_scaled = StandardScaler().fit_transform(X)\n\n# Parameter sweep: n_estimators\nprint(\"Effect of n_estimators (contamination=0.05)\")\nprint(\"=\" * 45)\nprint(f\"{'n_estimators':<15} {'F1 Score':<10} {'Detected':<10}\")\nprint(\"-\" * 45)\nfor n_est in [10, 50, 100, 200, 500]:\n    clf = IsolationForest(n_estimators=n_est, contamination=0.05, random_state=42)\n    y_pred = (clf.fit_predict(X_scaled) == -1).astype(int)\n    f1 = f1_score(y_true, y_pred)\n    print(f\"{n_est:<15} {f1:<10.4f} {y_pred.sum():<10}\")\n\n# Parameter sweep: contamination\nprint(f\"\\nEffect of contamination (n_estimators=200)\")\nprint(\"=\" * 45)\nprint(f\"{'contamination':<15} {'F1 Score':<10} {'Detected':<10}\")\nprint(\"-\" * 45)\nfor cont in [0.01, 0.03, 0.05, 0.10, 0.15]:\n    clf = IsolationForest(n_estimators=200, contamination=cont, random_state=42)\n    y_pred = (clf.fit_predict(X_scaled) == -1).astype(int)\n    f1 = f1_score(y_true, y_pred)\n    print(f\"{cont:<15} {f1:<10.4f} {y_pred.sum():<10}\")\n\n# Parameter sweep: max_samples\nprint(f\"\\nEffect of max_samples (n_estimators=200, contamination=0.05)\")\nprint(\"=\" * 45)\nprint(f\"{'max_samples':<15} {'F1 Score':<10} {'Detected':<10}\")\nprint(\"-\" * 45)\nfor ms in [64, 128, 256, 512, 'auto']:\n    clf = IsolationForest(n_estimators=200, max_samples=ms, contamination=0.05, random_state=42)\n    y_pred = (clf.fit_predict(X_scaled) == -1).astype(int)\n    f1 = f1_score(y_true, y_pred)\n    print(f\"{str(ms):<15} {f1:<10.4f} {y_pred.sum():<10}\")"
