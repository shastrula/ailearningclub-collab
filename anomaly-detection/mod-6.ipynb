          "python",
          "import numpy as np\n\nnp.random.seed(42)\n\nclass IsolationTree:\n    def __init__(self, max_depth=10):\n        self.max_depth = max_depth\n        self.split_feature = None\n        self.split_value = None\n        self.left = None\n        self.right = None\n        self.size = 0\n        self.depth = 0\n        self.is_leaf = False\n    \n    def fit(self, X, depth=0):\n        self.size = len(X)\n        self.depth = depth\n        \n        if depth >= self.max_depth or len(X) <= 1:\n            self.is_leaf = True\n            return\n        \n        # Random feature and split value\n        n_features = X.shape[1]\n        self.split_feature = np.random.randint(0, n_features)\n        feature_min = X[:, self.split_feature].min()\n        feature_max = X[:, self.split_feature].max()\n        \n        if feature_min == feature_max:\n            self.is_leaf = True\n            return\n        \n        self.split_value = np.random.uniform(feature_min, feature_max)\n        \n        # Split data\n        left_mask = X[:, self.split_feature] < self.split_value\n        X_left = X[left_mask]\n        X_right = X[~left_mask]\n        \n        self.left = IsolationTree(self.max_depth)\n        self.right = IsolationTree(self.max_depth)\n        self.left.fit(X_left, depth + 1)\n        self.right.fit(X_right, depth + 1)\n    \n    def path_length(self, x):\n        if self.is_leaf:\n            return self.depth + self._c(self.size)\n        \n        if x[self.split_feature] < self.split_value:\n            return self.left.path_length(x)\n        else:\n            return self.right.path_length(x)\n    \n    @staticmethod\n    def _c(n):\n        \"\"\"Average path length of unsuccessful search in BST.\"\"\"\n        if n <= 1:\n            return 0\n        return 2 * (np.log(n - 1) + 0.5772156649) - 2 * (n - 1) / n\n\n\nclass SimpleIsolationForest:\n    def __init__(self, n_trees=100, max_samples=256, max_depth=None):\n        self.n_trees = n_trees\n        self.max_samples = max_samples\n        self.max_depth = max_depth\n        self.trees = []\n    \n    def fit(self, X):\n        if self.max_depth is None:\n            self.max_depth = int(np.ceil(np.log2(self.max_samples)))\n        \n        for _ in range(self.n_trees):\n            # Subsample\n            idx = np.random.choice(len(X), min(self.max_samples, len(X)), replace=False)\n            X_sample = X[idx]\n            \n            tree = IsolationTree(self.max_depth)\n            tree.fit(X_sample)\n            self.trees.append(tree)\n        \n        return self\n    \n    def anomaly_score(self, X):\n        avg_path_lengths = np.zeros(len(X))\n        for tree in self.trees:\n            for i, x in enumerate(X):\n                avg_path_lengths[i] += tree.path_length(x)\n        \n        avg_path_lengths /= self.n_trees\n        c_n = IsolationTree._c(self.max_samples)\n        scores = 2 ** (-avg_path_lengths / c_n)\n        return scores\n\n\n# Generate test data\nX_normal = np.random.normal(loc=0, scale=1, size=(200, 2))\nanomalies = np.array([[5, 5], [-5, -5], [5, -5], [-5, 5], [4, 4]])\nX = np.vstack([X_normal, anomalies])\ny_true = np.array([0]*200 + [1]*5)\n\n# Fit our custom Isolation Forest\niforest = SimpleIsolationForest(n_trees=100, max_samples=128)\niforest.fit(X)\nscores = iforest.anomaly_score(X)\n\n# Threshold\nthreshold = np.percentile(scores, 95)\npredictions = (scores > threshold).astype(int)\n\ntp = np.sum((predictions == 1) & (y_true == 1))\nfp = np.sum((predictions == 1) & (y_true == 0))\n\nprint(\"Custom Isolation Forest Results\")\nprint(\"=\" * 45)\nprint(f\"Number of trees: 100\")\nprint(f\"Max samples per tree: 128\")\nprint(f\"\\nAnomaly score statistics:\")\nprint(f\"  Normal points mean score: {scores[:200].mean():.4f}\")\nprint(f\"  Anomaly points mean score: {scores[200:].mean():.4f}\")\nprint(f\"  Threshold (95th pctl): {threshold:.4f}\")\nprint(f\"\\nDetection results:\")\nprint(f\"  True Positives: {tp}\")\nprint(f\"  False Positives: {fp}\")\nprint(f\"  All anomalies detected: {tp == 5}\")"
