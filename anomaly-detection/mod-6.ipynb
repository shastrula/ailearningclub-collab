          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.preprocessing import StandardScaler\n\nnp.random.seed(42)\n\n# Create data where anomalies are visible in specific features\nn_samples = 500\nfeature_names = ['cpu_usage', 'memory_mb', 'disk_io', 'network_kb', 'response_ms']\n\n# Normal data\nX_normal = np.column_stack([\n    np.random.normal(45, 10, n_samples),   # cpu\n    np.random.normal(4000, 500, n_samples), # memory\n    np.random.normal(100, 20, n_samples),   # disk_io\n    np.random.normal(500, 100, n_samples),  # network\n    np.random.normal(200, 30, n_samples)    # response_ms\n])\n\n# Anomalies: high CPU and high response time (other features normal)\nn_anomalies = 20\nX_anomalies = np.column_stack([\n    np.random.normal(95, 3, n_anomalies),      # HIGH cpu\n    np.random.normal(4000, 500, n_anomalies),  # normal memory\n    np.random.normal(100, 20, n_anomalies),    # normal disk\n    np.random.normal(500, 100, n_anomalies),   # normal network\n    np.random.normal(800, 50, n_anomalies)     # HIGH response\n])\n\nX = np.vstack([X_normal, X_anomalies])\ny_true = np.array([0]*n_samples + [1]*n_anomalies)\n\n# Scale and fit\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\nclf = IsolationForest(n_estimators=200, contamination=0.04, random_state=42)\nclf.fit(X_scaled)\ny_pred = (clf.predict(X_scaled) == -1).astype(int)\n\n# Analyze which features differ most between normal and detected anomalies\ndetected_mask = y_pred == 1\nnormal_mask = y_pred == 0\n\nprint(\"Feature Analysis for Detected Anomalies\")\nprint(\"=\" * 65)\nprint(f\"{'Feature':<15} {'Normal Mean':<14} {'Anomaly Mean':<14} {'Diff (std)':<12}\")\nprint(\"-\" * 65)\nfor i, name in enumerate(feature_names):\n    normal_mean = X[normal_mask, i].mean()\n    anomaly_mean = X[detected_mask, i].mean()\n    normal_std = X[normal_mask, i].std()\n    diff_std = (anomaly_mean - normal_mean) / normal_std\n    print(f\"{name:<15} {normal_mean:<14.2f} {anomaly_mean:<14.2f} {diff_std:<12.2f}\")\n\nprint(f\"\\nTotal detected: {y_pred.sum()}\")\nprint(f\"True Positives: {np.sum((y_pred == 1) & (y_true == 1))}\")\nprint(f\"False Positives: {np.sum((y_pred == 1) & (y_true == 0))}\")"
        ]
      ]
