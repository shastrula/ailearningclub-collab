          "python",
          "import numpy as np\nimport pandas as pd\nfrom collections import Counter\nfrom sklearn.metrics import f1_score, precision_score, recall_score\n\nnp.random.seed(42)\n\n# Simulate hourly log counts by template (time windows)\nn_hours = 200\nn_templates = 8\n\n# Normal hourly counts for each template\nnormal_rates = [50, 30, 25, 40, 35, 20, 10, 5]  # Expected per hour\n\n# Generate count matrix (hours x templates)\nlog_counts = np.zeros((n_hours, n_templates))\nfor t in range(n_templates):\n    log_counts[:, t] = np.random.poisson(normal_rates[t], n_hours)\n\n# Inject anomalous hours\nanomaly_hours = [50, 100, 150]\ny_true = np.zeros(n_hours)\n\n# Hour 50: Error burst\nlog_counts[50, 6] = 200  # Massive increase in warnings\nlog_counts[50, 7] = 50   # Error spike\ny_true[50] = 1\n\n# Hour 100: Service outage (drop in normal + spike in errors)\nlog_counts[100, :5] = [5, 3, 2, 4, 3]  # Normal traffic drops\nlog_counts[100, 7] = 80  # Errors spike\ny_true[100] = 1\n\n# Hour 150: Brute force attack\nlog_counts[150, 0] = 500  # Login attempts spike\nlog_counts[150, 6] = 300  # Auth failures spike\ny_true[150] = 1\n\n# Detection: Z-score per template + combined score\ntemplate_means = log_counts.mean(axis=0)\ntemplate_stds = log_counts.std(axis=0)\n\nz_scores = np.abs((log_counts - template_means) / (template_stds + 0.001))\ncombined_score = z_scores.max(axis=1)  # Maximum Z across all templates\n\n# Threshold\nthreshold = 3.0\npredictions = (combined_score > threshold).astype(int)\n\ntp = np.sum((predictions == 1) & (y_true == 1))\nfp = np.sum((predictions == 1) & (y_true == 0))\n\nprint(\"Frequency-Based Log Anomaly Detection\")\nprint(\"=\" * 55)\nprint(f\"Time windows: {n_hours} hours\")\nprint(f\"Log templates monitored: {n_templates}\")\nprint(f\"Threshold: Z > {threshold}\")\nprint(f\"\\nDetected anomalies: {predictions.sum()}\")\nprint(f\"True Positives: {tp}\")\nprint(f\"False Positives: {fp}\")\nprint(f\"\\nAnomalous hours detected:\")\nfor idx in np.where(predictions == 1)[0]:\n    top_template = np.argmax(z_scores[idx])\n    print(f\"  Hour {idx}: max_z={combined_score[idx]:.2f} (template {top_template})\")"
        ]
      ]
