          "python",
          "import numpy as np\nimport pandas as pd\nimport re\nfrom collections import Counter\n\nnp.random.seed(42)\n\n# Generate synthetic log data\nlog_templates = {\n    'normal': [\n        'INFO User {user} logged in from {ip}',\n        'INFO Request processed in {ms}ms',\n        'INFO Database query completed successfully',\n        'DEBUG Cache hit for key {key}',\n        'INFO Session created for user {user}',\n        'INFO File uploaded: {filename}',\n        'WARN Slow query detected: {ms}ms',\n    ],\n    'anomalous': [\n        'ERROR Authentication failed for user {user} from {ip}',\n        'CRITICAL Database connection pool exhausted',\n        'ERROR Disk space below threshold: {pct}%',\n        'CRITICAL Service unavailable: timeout after {ms}ms',\n        'ERROR Permission denied: user {user} accessing {resource}',\n        'CRITICAL Memory usage exceeds 95%',\n    ]\n}\n\ndef generate_logs(n_normal=1000, n_anomalous=50):\n    logs = []\n    labels = []\n    \n    for _ in range(n_normal):\n        template = np.random.choice(log_templates['normal'])\n        log = template.format(\n            user=f'user_{np.random.randint(1, 100)}',\n            ip=f'192.168.{np.random.randint(1,255)}.{np.random.randint(1,255)}',\n            ms=np.random.randint(10, 500),\n            key=f'cache_key_{np.random.randint(1, 50)}',\n            filename=f'file_{np.random.randint(1, 200)}.pdf'\n        )\n        logs.append(log)\n        labels.append(0)\n    \n    for _ in range(n_anomalous):\n        template = np.random.choice(log_templates['anomalous'])\n        log = template.format(\n            user=f'user_{np.random.randint(1, 100)}',\n            ip=f'10.{np.random.randint(1,255)}.{np.random.randint(1,255)}.{np.random.randint(1,255)}',\n            ms=np.random.randint(5000, 30000),\n            pct=np.random.randint(1, 10),\n            resource=f'/admin/secret_{np.random.randint(1,20)}'\n        )\n        logs.append(log)\n        labels.append(1)\n    \n    return logs, np.array(labels)\n\nlogs, y_true = generate_logs(n_normal=1000, n_anomalous=50)\n\n# Extract log templates by removing variable parts\ndef extract_template(log):\n    \"\"\"Convert a log line to its template (replace numbers, IPs, etc.).\"\"\"\n    template = re.sub(r'\\d+\\.\\d+\\.\\d+\\.\\d+', '<IP>', log)\n    template = re.sub(r'user_\\d+', '<USER>', template)\n    template = re.sub(r'\\d+', '<NUM>', template)\n    template = re.sub(r'[a-f0-9]{8,}', '<HEX>', template)\n    template = re.sub(r'\\S+\\.(pdf|jpg|txt|log)', '<FILE>', template)\n    return template\n\ntemplates = [extract_template(log) for log in logs]\ntemplate_counts = Counter(templates)\n\nprint(\"Log Template Extraction\")\nprint(\"=\" * 60)\nprint(f\"Total logs: {len(logs)}\")\nprint(f\"Unique templates: {len(template_counts)}\")\nprint(f\"\\nTop 10 templates:\")\nfor template, count in template_counts.most_common(10):\n    print(f\"  [{count:>4}] {template[:60]}\")"
        ]
      ]
    },
