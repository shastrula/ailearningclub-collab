          "python",
          "import numpy as np\nimport pandas as pd\nimport re\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# Generate log lines grouped into sessions\ndef generate_sessions(n_normal=200, n_anomalous=15, lines_per_session=20):\n    sessions = []\n    labels = []\n    \n    normal_patterns = [\n        'GET /index.html 200', 'GET /api/users 200', 'POST /api/login 200',\n        'GET /static/css/main.css 200', 'GET /api/products 200',\n        'GET /dashboard 200', 'POST /api/cart 201', 'GET /api/orders 200'\n    ]\n    \n    attack_patterns = [\n        'POST /api/login 401', 'POST /api/login 401', 'GET /admin 403',\n        'GET /../../etc/passwd 404', 'POST /api/sql 500',\n        'GET /wp-admin 404', 'POST /api/login 401', 'GET /admin/config 403'\n    ]\n    \n    for _ in range(n_normal):\n        session = np.random.choice(normal_patterns, lines_per_session)\n        sessions.append(' '.join(session))\n        labels.append(0)\n    \n    for _ in range(n_anomalous):\n        session = np.random.choice(attack_patterns, lines_per_session)\n        sessions.append(' '.join(session))\n        labels.append(1)\n    \n    return sessions, np.array(labels)\n\nsessions, y_true = generate_sessions()\n\n# Vectorize sessions\ntfidf = TfidfVectorizer(max_features=100, ngram_range=(1, 2))\nX = tfidf.fit_transform(sessions).toarray()\n\n# Detect anomalies\nclf = IsolationForest(contamination=0.07, random_state=42)\ny_pred = (clf.fit_predict(X) == -1).astype(int)\n\ntp = np.sum((y_pred == 1) & (y_true == 1))\nfp = np.sum((y_pred == 1) & (y_true == 0))\nfn = np.sum((y_pred == 0) & (y_true == 1))\nprec = tp / (tp + fp) if (tp + fp) > 0 else 0\nrec = tp / (tp + fn) if (tp + fn) > 0 else 0\n\nprint(\"TF-IDF Log Session Anomaly Detection\")\nprint(\"=\" * 50)\nprint(f\"Sessions: {len(sessions)} ({(y_true==1).sum()} anomalous)\")\nprint(f\"TF-IDF features: {X.shape[1]}\")\nprint(f\"\\nResults:\")\nprint(f\"  Precision: {prec:.4f}\")\nprint(f\"  Recall: {rec:.4f}\")\nprint(f\"  F1: {2*prec*rec/(prec+rec) if (prec+rec) > 0 else 0:.4f}\")\nprint(f\"\\nTop discriminating terms:\")\nfeature_names = tfidf.get_feature_names_out()\n# Terms with highest mean difference between normal and anomalous\nnormal_mean = X[y_true == 0].mean(axis=0)\nanomaly_mean = X[y_true == 1].mean(axis=0)\ndiff = anomaly_mean - normal_mean\ntop_idx = np.argsort(diff)[-5:][::-1]\nfor idx in top_idx:\n    print(f\"  '{feature_names[idx]}': anomaly={anomaly_mean[idx]:.3f}, normal={normal_mean[idx]:.3f}\")"
        ]
      ]
    },
