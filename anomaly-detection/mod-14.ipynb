        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom scipy import stats\n\nnp.random.seed(42)\n\n# Data with variance change and mean change\ndata = np.concatenate([\n    np.random.normal(100, 5, 200),   # Low variance\n    np.random.normal(100, 15, 150),  # HIGH variance (change at 200)\n    np.random.normal(120, 5, 150),   # Mean shift (change at 350)\n    np.random.normal(120, 5, 200)    # Stable\n])\n\ntrue_cps = [200, 350]\n\ndef sliding_window_test(data, window_size=50, step=5, alpha=0.001):\n    \"\"\"Detect changes using two-sample t-test on adjacent windows.\"\"\"\n    changepoints = []\n    scores = []\n    positions = []\n    \n    for i in range(window_size, len(data) - window_size, step):\n        window_before = data[i-window_size:i]\n        window_after = data[i:i+window_size]\n        \n        # Two-sample t-test\n        t_stat, p_value = stats.ttest_ind(window_before, window_after)\n        scores.append(-np.log10(max(p_value, 1e-50)))\n        positions.append(i)\n        \n        if p_value < alpha:\n            changepoints.append(i)\n    \n    return changepoints, positions, scores\n\ndetected, positions, scores = sliding_window_test(data, window_size=50, step=5)\n\n# Filter adjacent detections\nfiltered = []\nfor cp in detected:\n    if not filtered or cp - filtered[-1] > 30:\n        filtered.append(cp)\n\nprint(\"Sliding Window Change Point Detection\")\nprint(\"=\" * 50)\nprint(f\"Window size: 50, Step: 5, Alpha: 0.001\")\nprint(f\"\\nTrue change points: {true_cps}\")\nprint(f\"Detected (filtered): {filtered}\")\nprint(f\"\\nTop scoring positions:\")\nscore_array = np.array(scores)\npos_array = np.array(positions)\ntop_idx = np.argsort(score_array)[-5:][::-1]\nfor idx in top_idx:\n    print(f\"  Position {pos_array[idx]}: score={score_array[idx]:.2f}\")"
        ]
      ]
    },
