          "python",
          "import numpy as np\n\nnp.random.seed(42)\n\nclass OnlineChangeDetector:\n    \"\"\"Simple Bayesian-inspired online change point detector.\"\"\"\n    \n    def __init__(self, hazard_rate=1/200, observation_likelihood_std=5.0):\n        self.hazard = hazard_rate\n        self.obs_std = observation_likelihood_std\n        self.run_length = 0\n        self.running_mean = 0\n        self.running_var = 0\n        self.n_obs = 0\n        self.changepoints = []\n    \n    def update(self, x, t):\n        \"\"\"Process a new observation.\"\"\"\n        self.n_obs += 1\n        \n        if self.n_obs < 10:\n            # Burn-in period\n            old_mean = self.running_mean\n            self.running_mean += (x - self.running_mean) / self.n_obs\n            self.running_var += (x - old_mean) * (x - self.running_mean)\n            self.run_length += 1\n            return False\n        \n        # Calculate how likely this observation is under current model\n        current_std = max(np.sqrt(self.running_var / self.n_obs), 1.0)\n        z_score = abs(x - self.running_mean) / current_std\n        \n        # If observation is very unlikely AND run_length is long enough\n        if z_score > 3.5 and self.run_length > 20:\n            self.changepoints.append(t)\n            # Reset statistics\n            self.running_mean = x\n            self.running_var = 0\n            self.n_obs = 1\n            self.run_length = 0\n            return True\n        \n        # Update running statistics\n        old_mean = self.running_mean\n        self.running_mean += (x - self.running_mean) / self.n_obs\n        self.running_var += (x - old_mean) * (x - self.running_mean)\n        self.run_length += 1\n        return False\n\n# Simulate streaming data\ndata = np.concatenate([\n    np.random.normal(50, 3, 200),\n    np.random.normal(70, 3, 150),   # Mean shift up\n    np.random.normal(70, 3, 100),\n    np.random.normal(40, 3, 200),   # Mean shift down\n])\n\ntrue_cps = [200, 450]\n\ndetector = OnlineChangeDetector()\nfor t, x in enumerate(data):\n    detector.update(x, t)\n\nprint(\"Online Change Point Detection\")\nprint(\"=\" * 50)\nprint(f\"Data length: {len(data)}\")\nprint(f\"True change points: {true_cps}\")\nprint(f\"Detected change points: {detector.changepoints}\")\nprint(f\"\\nDetection delay:\")\nfor true_cp in true_cps:\n    closest = min(detector.changepoints, key=lambda x: abs(x - true_cp))\n    delay = closest - true_cp\n    print(f\"  True: {true_cp}, Detected: {closest}, Delay: {delay} steps\")"
        ]
      ]
