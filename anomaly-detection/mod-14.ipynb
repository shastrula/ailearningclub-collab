          "python",
          "import numpy as np\nfrom scipy import stats\n\nnp.random.seed(42)\n\n# Data where only variance changes (mean stays the same)\ndata = np.concatenate([\n    np.random.normal(50, 2, 200),   # Low variance\n    np.random.normal(50, 8, 200),   # HIGH variance (change at 200)\n    np.random.normal(50, 2, 200),   # Back to low (change at 400)\n])\n\ntrue_cps = [200, 400]\n\ndef variance_change_detection(data, window_size=50, step=5, threshold=3.0):\n    \"\"\"Detect variance changes using F-test.\"\"\"\n    changepoints = []\n    ratios = []\n    positions = []\n    \n    for i in range(window_size, len(data) - window_size, step):\n        var_before = np.var(data[i-window_size:i])\n        var_after = np.var(data[i:i+window_size])\n        \n        # F-statistic (ratio of variances)\n        f_ratio = max(var_before, var_after) / min(var_before, var_after)\n        ratios.append(f_ratio)\n        positions.append(i)\n        \n        if f_ratio > threshold:\n            changepoints.append(i)\n    \n    return changepoints, positions, ratios\n\ndetected, positions, ratios = variance_change_detection(data, threshold=4.0)\n\n# Filter\nfiltered = []\nfor cp in detected:\n    if not filtered or cp - filtered[-1] > 30:\n        filtered.append(cp)\n\nprint(\"Variance Change Point Detection (F-test)\")\nprint(\"=\" * 50)\nprint(f\"True change points: {true_cps}\")\nprint(f\"Detected (filtered): {filtered}\")\nprint(f\"\\nVariance by segment:\")\nprint(f\"  Segment 1 (0-199): var={np.var(data[:200]):.2f}\")\nprint(f\"  Segment 2 (200-399): var={np.var(data[200:400]):.2f}\")\nprint(f\"  Segment 3 (400-599): var={np.var(data[400:]):.2f}\")\nprint(f\"\\nMax F-ratio: {max(ratios):.2f} at position {positions[np.argmax(ratios)]}\")"
        ]
      ]
