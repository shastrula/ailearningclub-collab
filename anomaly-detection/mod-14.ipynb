        [
          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Generate data with mean shifts\nsegment1 = np.random.normal(50, 3, 200)   # Normal operation\nsegment2 = np.random.normal(60, 3, 150)   # Elevated (shift at t=200)\nsegment3 = np.random.normal(50, 3, 150)   # Back to normal (shift at t=350)\nsegment4 = np.random.normal(45, 5, 200)   # Lower mean, higher variance (shift at t=500)\n\ndata = np.concatenate([segment1, segment2, segment3, segment4])\ntrue_changepoints = [200, 350, 500]\n\ndef cusum(data, target=None, threshold=5.0, drift=0.5):\n    \"\"\"Tabular CUSUM for detecting upward and downward shifts.\"\"\"\n    if target is None:\n        target = np.mean(data[:50])  # Use initial segment as baseline\n    \n    n = len(data)\n    s_pos = np.zeros(n)  # Cumulative sum for upward shifts\n    s_neg = np.zeros(n)  # Cumulative sum for downward shifts\n    changepoints = []\n    \n    for i in range(1, n):\n        s_pos[i] = max(0, s_pos[i-1] + (data[i] - target) - drift)\n        s_neg[i] = max(0, s_neg[i-1] - (data[i] - target) - drift)\n        \n        if s_pos[i] > threshold or s_neg[i] > threshold:\n            changepoints.append(i)\n            # Reset after detection\n            s_pos[i] = 0\n            s_neg[i] = 0\n    \n    return changepoints, s_pos, s_neg\n\n# Apply CUSUM\ndetected_cps, s_pos, s_neg = cusum(data, threshold=15.0, drift=1.0)\n\n# Filter to significant change points (first detection in each region)\nfiltered_cps = []\nmin_gap = 30\nfor cp in detected_cps:\n    if not filtered_cps or cp - filtered_cps[-1] > min_gap:\n        filtered_cps.append(cp)\n\nprint(\"CUSUM Change Point Detection\")\nprint(\"=\" * 50)\nprint(f\"Data length: {len(data)}\")\nprint(f\"Target (baseline mean): {np.mean(data[:50]):.2f}\")\nprint(f\"Threshold: 15.0, Drift: 1.0\")\nprint(f\"\\nTrue change points: {true_changepoints}\")\nprint(f\"Detected (filtered): {filtered_cps}\")\nprint(f\"\\nSegment statistics:\")\nprint(f\"  Segment 1 (0-199): mean={segment1.mean():.2f}, std={segment1.std():.2f}\")\nprint(f\"  Segment 2 (200-349): mean={segment2.mean():.2f}, std={segment2.std():.2f}\")\nprint(f\"  Segment 3 (350-499): mean={segment3.mean():.2f}, std={segment3.std():.2f}\")\nprint(f\"  Segment 4 (500-699): mean={segment4.mean():.2f}, std={segment4.std():.2f}\")"
        ]
      ]
    },
