          "python",
          "import numpy as np\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import f1_score, precision_score, recall_score\nfrom sklearn.neighbors import NearestNeighbors\n\nnp.random.seed(42)\n\ndef simple_smote(X_minority, n_synthetic, k=5):\n    \"\"\"Simplified SMOTE implementation.\"\"\"\n    nn = NearestNeighbors(n_neighbors=k)\n    nn.fit(X_minority)\n    _, indices = nn.kneighbors(X_minority)\n    \n    synthetic = []\n    for _ in range(n_synthetic):\n        idx = np.random.randint(0, len(X_minority))\n        neighbor_idx = indices[idx, np.random.randint(1, k)]\n        diff = X_minority[neighbor_idx] - X_minority[idx]\n        gap = np.random.random()\n        new_sample = X_minority[idx] + gap * diff\n        synthetic.append(new_sample)\n    \n    return np.array(synthetic)\n\n# Create imbalanced dataset\nX, y = make_classification(\n    n_samples=5000, n_features=10, n_informative=5,\n    n_redundant=2, weights=[0.98, 0.02], random_state=42\n)\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42, stratify=y)\n\n# Apply SMOTE to training data\nX_minority = X_train[y_train == 1]\nX_majority = X_train[y_train == 0]\n\nn_synthetic = len(X_majority) - len(X_minority)\nX_synthetic = simple_smote(X_minority, n_synthetic, k=5)\n\n# Create balanced training set\nX_train_balanced = np.vstack([X_majority, X_minority, X_synthetic])\ny_train_balanced = np.concatenate([\n    np.zeros(len(X_majority)),\n    np.ones(len(X_minority)),\n    np.ones(len(X_synthetic))\n])\n\nprint(\"SMOTE Resampling Results\")\nprint(\"=\" * 50)\nprint(f\"Before SMOTE:\")\nprint(f\"  Majority: {len(X_majority)}, Minority: {len(X_minority)}\")\nprint(f\"After SMOTE:\")\nprint(f\"  Majority: {len(X_majority)}, Minority: {len(X_minority) + len(X_synthetic)}\")\n\n# Train on balanced data\nclf_smote = RandomForestClassifier(n_estimators=100, random_state=42)\nclf_smote.fit(X_train_balanced, y_train_balanced)\ny_pred_smote = clf_smote.predict(X_test)\n\n# Compare with baseline\nclf_base = RandomForestClassifier(n_estimators=100, random_state=42)\nclf_base.fit(X_train, y_train)\ny_pred_base = clf_base.predict(X_test)\n\nprint(f\"\\n{'Method':<15} {'Precision':<12} {'Recall':<10} {'F1':<8}\")\nprint(\"-\" * 50)\nfor name, y_pred in [(\"Baseline\", y_pred_base), (\"SMOTE\", y_pred_smote)]:\n    prec = precision_score(y_test, y_pred, zero_division=0)\n    rec = recall_score(y_test, y_pred, zero_division=0)\n    f1 = f1_score(y_test, y_pred, zero_division=0)\n    print(f\"{name:<15} {prec:<12.4f} {rec:<10.4f} {f1:<8.4f}\")"
        ]
