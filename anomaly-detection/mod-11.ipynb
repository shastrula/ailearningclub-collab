          "python",
          "import numpy as np\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import f1_score, precision_score, recall_score\n\nnp.random.seed(42)\n\nX, y = make_classification(\n    n_samples=5000, n_features=10, n_informative=5,\n    n_redundant=2, weights=[0.98, 0.02], random_state=42\n)\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42, stratify=y)\n\nX_minority = X_train[y_train == 1]\nX_majority = X_train[y_train == 0]\n\n# Different undersampling ratios\nprint(\"Effect of Undersampling Ratio\")\nprint(\"=\" * 60)\nprint(f\"Minority class size: {len(X_minority)}\")\nprint(f\"\\n{'Ratio':<8} {'Majority Used':<15} {'Precision':<12} {'Recall':<10} {'F1':<8}\")\nprint(\"-\" * 60)\n\nfor ratio in [1.0, 2.0, 3.0, 5.0, 10.0]:\n    n_majority_keep = int(len(X_minority) * ratio)\n    n_majority_keep = min(n_majority_keep, len(X_majority))\n    \n    # Random undersample majority\n    idx = np.random.choice(len(X_majority), n_majority_keep, replace=False)\n    X_maj_sample = X_majority[idx]\n    \n    X_train_us = np.vstack([X_maj_sample, X_minority])\n    y_train_us = np.concatenate([np.zeros(len(X_maj_sample)), np.ones(len(X_minority))])\n    \n    clf = RandomForestClassifier(n_estimators=100, random_state=42)\n    clf.fit(X_train_us, y_train_us)\n    y_pred = clf.predict(X_test)\n    \n    prec = precision_score(y_test, y_pred, zero_division=0)\n    rec = recall_score(y_test, y_pred, zero_division=0)\n    f1 = f1_score(y_test, y_pred, zero_division=0)\n    \n    print(f\"{ratio:<8.1f} {n_majority_keep:<15} {prec:<12.4f} {rec:<10.4f} {f1:<8.4f}\")"
        ]
      ]
