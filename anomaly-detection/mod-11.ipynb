          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import classification_report, f1_score\n\nnp.random.seed(42)\n\n# Create imbalanced dataset (2% positive/anomaly class)\nX, y = make_classification(\n    n_samples=5000, n_features=10, n_informative=5,\n    n_redundant=2, n_classes=2, weights=[0.98, 0.02],\n    flip_y=0.01, random_state=42\n)\n\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42, stratify=y)\n\nprint(\"Dataset Imbalance\")\nprint(\"=\" * 40)\nprint(f\"Training set:\")\nprint(f\"  Normal (0): {(y_train==0).sum()} ({(y_train==0).mean():.1%})\")\nprint(f\"  Anomaly (1): {(y_train==1).sum()} ({(y_train==1).mean():.1%})\")\nprint(f\"\\nTest set:\")\nprint(f\"  Normal (0): {(y_test==0).sum()}\")\nprint(f\"  Anomaly (1): {(y_test==1).sum()}\")\n\n# Baseline: no imbalance handling\nclf = RandomForestClassifier(n_estimators=100, random_state=42)\nclf.fit(X_train, y_train)\ny_pred = clf.predict(X_test)\n\nprint(f\"\\nBaseline (no imbalance handling):\")\nprint(classification_report(y_test, y_pred, target_names=['Normal', 'Anomaly']))"
        ]
      ]
