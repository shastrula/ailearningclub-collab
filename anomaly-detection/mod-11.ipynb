          "python",
          "import numpy as np\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import train_test_split, cross_val_score\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import f1_score, precision_score, recall_score, make_scorer\nfrom sklearn.neighbors import NearestNeighbors\n\nnp.random.seed(42)\n\nX, y = make_classification(\n    n_samples=5000, n_features=10, n_informative=5,\n    n_redundant=2, weights=[0.98, 0.02], random_state=42\n)\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42, stratify=y)\n\nresults = {}\n\n# 1. Baseline\nclf = RandomForestClassifier(n_estimators=100, random_state=42)\nclf.fit(X_train, y_train)\ny_pred = clf.predict(X_test)\nresults['Baseline'] = (precision_score(y_test, y_pred, zero_division=0),\n                       recall_score(y_test, y_pred, zero_division=0),\n                       f1_score(y_test, y_pred, zero_division=0))\n\n# 2. Class weights (balanced)\nclf = RandomForestClassifier(n_estimators=100, class_weight='balanced', random_state=42)\nclf.fit(X_train, y_train)\ny_pred = clf.predict(X_test)\nresults['Class Weights'] = (precision_score(y_test, y_pred, zero_division=0),\n                            recall_score(y_test, y_pred, zero_division=0),\n                            f1_score(y_test, y_pred, zero_division=0))\n\n# 3. Random Undersampling\nX_min = X_train[y_train == 1]\nX_maj = X_train[y_train == 0]\nidx = np.random.choice(len(X_maj), len(X_min)*3, replace=False)\nX_us = np.vstack([X_maj[idx], X_min])\ny_us = np.concatenate([np.zeros(len(idx)), np.ones(len(X_min))])\nclf = RandomForestClassifier(n_estimators=100, random_state=42)\nclf.fit(X_us, y_us)\ny_pred = clf.predict(X_test)\nresults['Undersampling (3:1)'] = (precision_score(y_test, y_pred, zero_division=0),\n                                  recall_score(y_test, y_pred, zero_division=0),\n                                  f1_score(y_test, y_pred, zero_division=0))\n\n# 4. SMOTE\ndef smote(X_min, n_synthetic, k=5):\n    nn = NearestNeighbors(n_neighbors=k)\n    nn.fit(X_min)\n    _, indices = nn.kneighbors(X_min)\n    synthetic = []\n    for _ in range(n_synthetic):\n        i = np.random.randint(0, len(X_min))\n        j = indices[i, np.random.randint(1, k)]\n        gap = np.random.random()\n        synthetic.append(X_min[i] + gap * (X_min[j] - X_min[i]))\n    return np.array(synthetic)\n\nX_synthetic = smote(X_min, len(X_maj) - len(X_min))\nX_sm = np.vstack([X_maj, X_min, X_synthetic])\ny_sm = np.concatenate([np.zeros(len(X_maj)), np.ones(len(X_min) + len(X_synthetic))])\nclf = RandomForestClassifier(n_estimators=100, random_state=42)\nclf.fit(X_sm, y_sm)\ny_pred = clf.predict(X_test)\nresults['SMOTE'] = (precision_score(y_test, y_pred, zero_division=0),\n                    recall_score(y_test, y_pred, zero_division=0),\n                    f1_score(y_test, y_pred, zero_division=0))\n\n# 5. Combined: SMOTE + Undersampling\nX_maj_half = X_maj[np.random.choice(len(X_maj), len(X_maj)//2, replace=False)]\nX_syn_half = smote(X_min, len(X_maj_half) - len(X_min))\nX_comb = np.vstack([X_maj_half, X_min, X_syn_half])\ny_comb = np.concatenate([np.zeros(len(X_maj_half)), np.ones(len(X_min) + len(X_syn_half))])\nclf = RandomForestClassifier(n_estimators=100, random_state=42)\nclf.fit(X_comb, y_comb)\ny_pred = clf.predict(X_test)\nresults['SMOTE + Undersample'] = (precision_score(y_test, y_pred, zero_division=0),\n                                  recall_score(y_test, y_pred, zero_division=0),\n                                  f1_score(y_test, y_pred, zero_division=0))\n\nprint(\"Comprehensive Strategy Comparison\")\nprint(\"=\" * 65)\nprint(f\"{'Strategy':<22} {'Precision':<12} {'Recall':<10} {'F1':<8}\")\nprint(\"-\" * 65)\nfor name, (prec, rec, f1) in results.items():\n    print(f\"{name:<22} {prec:<12.4f} {rec:<10.4f} {f1:<8.4f}\")"
        ]
