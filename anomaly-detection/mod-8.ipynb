      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.neural_network import MLPRegressor\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score, classification_report\n\nnp.random.seed(42)\n\n# Generate sensor data (5 features)\nn_normal = 800\nX_normal = np.column_stack([\n    np.random.normal(50, 5, n_normal),\n    np.random.normal(100, 10, n_normal),\n    np.random.normal(30, 3, n_normal),\n    np.random.normal(75, 8, n_normal),\n    np.random.normal(200, 20, n_normal)\n])\n\n# Anomalies (sensor malfunctions - correlated failures)\nn_anomaly = 40\nX_anomaly = np.column_stack([\n    np.random.normal(80, 3, n_anomaly),   # High temp\n    np.random.normal(150, 5, n_anomaly),  # High pressure\n    np.random.normal(10, 2, n_anomaly),   # Low flow\n    np.random.normal(120, 5, n_anomaly),  # High vibration\n    np.random.normal(50, 10, n_anomaly)   # Low output\n])\n\n# Split: train on normal only, test on mix\nX_train = X_normal[:600]\nX_test = np.vstack([X_normal[600:], X_anomaly])\ny_test = np.array([0]*200 + [1]*40)\n\n# Scale\nscaler = StandardScaler()\nX_train_scaled = scaler.fit_transform(X_train)\nX_test_scaled = scaler.transform(X_test)\n\n# Train autoencoder (input -> compressed -> input)\nautoencoder = MLPRegressor(\n    hidden_layer_sizes=(10, 3, 10),  # Encoder: 5->10->3, Decoder: 3->10->5\n    activation='relu',\n    max_iter=500,\n    random_state=42,\n    early_stopping=True,\n    validation_fraction=0.1\n)\nautoencoder.fit(X_train_scaled, X_train_scaled)\n\n# Calculate reconstruction error\nX_train_reconstructed = autoencoder.predict(X_train_scaled)\nX_test_reconstructed = autoencoder.predict(X_test_scaled)\n\ntrain_errors = np.mean((X_train_scaled - X_train_reconstructed) ** 2, axis=1)\ntest_errors = np.mean((X_test_scaled - X_test_reconstructed) ** 2, axis=1)\n\n# Set threshold from training error distribution\nthreshold = np.percentile(train_errors, 95)\npredictions = (test_errors > threshold).astype(int)\n\ntp = np.sum((predictions == 1) & (y_test == 1))\nfp = np.sum((predictions == 1) & (y_test == 0))\nfn = np.sum((predictions == 0) & (y_test == 1))\nprecision = tp / (tp + fp) if (tp + fp) > 0 else 0\nrecall = tp / (tp + fn) if (tp + fn) > 0 else 0\nf1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0\n\nprint(\"Autoencoder Anomaly Detection (sklearn MLPRegressor)\")\nprint(\"=\" * 55)\nprint(f\"Architecture: 5 -> 10 -> 3 -> 10 -> 5\")\nprint(f\"Training samples: {len(X_train)}\")\nprint(f\"Test samples: {len(X_test)} (normal: 200, anomaly: 40)\")\nprint(f\"\\nReconstruction Error Statistics:\")\nprint(f\"  Train MSE mean: {train_errors.mean():.6f}\")\nprint(f\"  Train MSE std: {train_errors.std():.6f}\")\nprint(f\"  Test normal MSE mean: {test_errors[:200].mean():.6f}\")\nprint(f\"  Test anomaly MSE mean: {test_errors[200:].mean():.6f}\")\nprint(f\"  Threshold (95th pctl): {threshold:.6f}\")\nprint(f\"\\nResults:\")\nprint(f\"  Precision: {precision:.4f}\")\nprint(f\"  Recall: {recall:.4f}\")\nprint(f\"  F1 Score: {f1:.4f}\")"
        ]
      ]
    },
