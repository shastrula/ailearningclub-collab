        [
          "python",
          "import numpy as np\nfrom sklearn.preprocessing import StandardScaler\n\nnp.random.seed(42)\n\nclass SimpleAutoencoder:\n    def __init__(self, input_dim, encoding_dim, learning_rate=0.01):\n        self.lr = learning_rate\n        # Encoder weights\n        self.W1 = np.random.randn(input_dim, encoding_dim) * 0.1\n        self.b1 = np.zeros(encoding_dim)\n        # Decoder weights\n        self.W2 = np.random.randn(encoding_dim, input_dim) * 0.1\n        self.b2 = np.zeros(input_dim)\n    \n    def relu(self, x):\n        return np.maximum(0, x)\n    \n    def relu_grad(self, x):\n        return (x > 0).astype(float)\n    \n    def forward(self, X):\n        self.z1 = X @ self.W1 + self.b1\n        self.a1 = self.relu(self.z1)  # Encoded\n        self.z2 = self.a1 @ self.W2 + self.b2\n        return self.z2  # Reconstruction (linear output)\n    \n    def train(self, X, epochs=100, batch_size=32):\n        n_samples = len(X)\n        losses = []\n        \n        for epoch in range(epochs):\n            # Shuffle\n            idx = np.random.permutation(n_samples)\n            X_shuffled = X[idx]\n            \n            epoch_loss = 0\n            for i in range(0, n_samples, batch_size):\n                batch = X_shuffled[i:i+batch_size]\n                \n                # Forward\n                output = self.forward(batch)\n                \n                # Loss (MSE)\n                loss = np.mean((batch - output) ** 2)\n                epoch_loss += loss\n                \n                # Backward\n                d_output = 2 * (output - batch) / batch.shape[0]\n                \n                # Decoder gradients\n                dW2 = self.a1.T @ d_output\n                db2 = d_output.sum(axis=0)\n                \n                # Encoder gradients\n                d_a1 = d_output @ self.W2.T\n                d_z1 = d_a1 * self.relu_grad(self.z1)\n                dW1 = batch.T @ d_z1\n                db1 = d_z1.sum(axis=0)\n                \n                # Update\n                self.W2 -= self.lr * dW2\n                self.b2 -= self.lr * db2\n                self.W1 -= self.lr * dW1\n                self.b1 -= self.lr * db1\n            \n            losses.append(epoch_loss / (n_samples // batch_size))\n        \n        return losses\n    \n    def reconstruction_error(self, X):\n        output = self.forward(X)\n        return np.mean((X - output) ** 2, axis=1)\n\n# Generate data\nn_train = 500\nX_train = np.random.normal(loc=[1, 2, 3, 4, 5], scale=[0.5, 0.5, 0.5, 0.5, 0.5], size=(n_train, 5))\nX_test_normal = np.random.normal(loc=[1, 2, 3, 4, 5], scale=[0.5, 0.5, 0.5, 0.5, 0.5], size=(100, 5))\nX_test_anomaly = np.random.uniform(low=-3, high=8, size=(20, 5))\n\nscaler = StandardScaler()\nX_train_s = scaler.fit_transform(X_train)\nX_test_normal_s = scaler.transform(X_test_normal)\nX_test_anomaly_s = scaler.transform(X_test_anomaly)\n\n# Train\nae = SimpleAutoencoder(input_dim=5, encoding_dim=2, learning_rate=0.005)\nlosses = ae.train(X_train_s, epochs=200, batch_size=32)\n\n# Evaluate\ntrain_errors = ae.reconstruction_error(X_train_s)\nnormal_errors = ae.reconstruction_error(X_test_normal_s)\nanomaly_errors = ae.reconstruction_error(X_test_anomaly_s)\n\nthreshold = np.percentile(train_errors, 95)\n\nprint(\"Custom Numpy Autoencoder\")\nprint(\"=\" * 45)\nprint(f\"Architecture: 5 -> 2 -> 5\")\nprint(f\"Training loss (final): {losses[-1]:.6f}\")\nprint(f\"Training loss (initial): {losses[0]:.6f}\")\nprint(f\"\\nReconstruction Errors:\")\nprint(f\"  Training mean: {train_errors.mean():.6f}\")\nprint(f\"  Normal test mean: {normal_errors.mean():.6f}\")\nprint(f\"  Anomaly test mean: {anomaly_errors.mean():.6f}\")\nprint(f\"  Threshold: {threshold:.6f}\")\nprint(f\"\\nDetection (threshold={threshold:.4f}):\")\nprint(f\"  Normal flagged: {(normal_errors > threshold).sum()}/100\")\nprint(f\"  Anomalies flagged: {(anomaly_errors > threshold).sum()}/20\")"
        ]
      ]
    },
