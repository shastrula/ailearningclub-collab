          "python",
          "import numpy as np\nfrom sklearn.neural_network import MLPRegressor\nfrom sklearn.preprocessing import StandardScaler\n\nnp.random.seed(42)\n\n# Per-feature reconstruction analysis\nn_features = 5\nfeature_names = ['temperature', 'pressure', 'flow_rate', 'vibration', 'power']\n\nX_train = np.random.normal([70, 30, 100, 5, 500], [5, 3, 10, 1, 50], (500, 5))\n\n# Anomaly types\nanomaly_types = {\n    'temperature_spike': np.array([[120, 30, 100, 5, 500]]),\n    'pressure_drop': np.array([[70, 5, 100, 5, 500]]),\n    'multi_feature': np.array([[110, 10, 40, 15, 200]]),\n}\n\nscaler = StandardScaler()\nX_train_s = scaler.fit_transform(X_train)\n\nae = MLPRegressor(hidden_layer_sizes=(10, 3, 10), max_iter=500, random_state=42)\nae.fit(X_train_s, X_train_s)\n\nprint(\"Per-Feature Reconstruction Error Analysis\")\nprint(\"=\" * 70)\nprint(f\"\\n{'Anomaly Type':<20} \", end=\"\")\nfor name in feature_names:\n    print(f\"{name:<12} \", end=\"\")\nprint(\"Total MSE\")\nprint(\"-\" * 70)\n\n# Normal baseline\nX_normal_test = np.random.normal([70, 30, 100, 5, 500], [5, 3, 10, 1, 50], (1, 5))\nX_ns = scaler.transform(X_normal_test)\nrecon = ae.predict(X_ns)\nper_feature_err = (X_ns - recon) ** 2\nprint(f\"{'Normal':<20} \", end=\"\")\nfor e in per_feature_err[0]:\n    print(f\"{e:<12.6f} \", end=\"\")\nprint(f\"{per_feature_err.mean():.6f}\")\n\nfor name, X_anom in anomaly_types.items():\n    X_as = scaler.transform(X_anom)\n    recon = ae.predict(X_as)\n    per_feature_err = (X_as - recon) ** 2\n    print(f\"{name:<20} \", end=\"\")\n    for e in per_feature_err[0]:\n        print(f\"{e:<12.6f} \", end=\"\")\n    print(f\"{per_feature_err.mean():.6f}\")"
        ]
