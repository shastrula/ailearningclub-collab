          "python",
          "import numpy as np\nfrom sklearn.neural_network import MLPRegressor\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# 10-feature dataset\nn_features = 10\nX_normal = np.random.normal(0, 1, (600, n_features))\nX_normal[:, 5:] = X_normal[:, :5] + np.random.normal(0, 0.3, (600, 5))  # Correlated\n\nX_test_normal = np.random.normal(0, 1, (100, n_features))\nX_test_normal[:, 5:] = X_test_normal[:, :5] + np.random.normal(0, 0.3, (100, 5))\n\nX_anomaly = np.random.uniform(-4, 4, (30, n_features))\n\nX_test = np.vstack([X_test_normal, X_anomaly])\ny_test = np.array([0]*100 + [1]*30)\n\nscaler = StandardScaler()\nX_train_s = scaler.fit_transform(X_normal)\nX_test_s = scaler.transform(X_test)\n\nprint(\"Effect of Bottleneck Size\")\nprint(\"=\" * 60)\nprint(f\"Input features: {n_features}\")\nprint(f\"{'Bottleneck':<12} {'Train MSE':<12} {'Normal MSE':<12} {'Anomaly MSE':<13} {'F1':<8}\")\nprint(\"-\" * 60)\n\nfor bottleneck in [1, 2, 3, 5, 7, 9]:\n    layers = (n_features, bottleneck, n_features)\n    ae = MLPRegressor(hidden_layer_sizes=layers, max_iter=500, \n                      random_state=42, early_stopping=True)\n    ae.fit(X_train_s, X_train_s)\n    \n    train_err = np.mean((X_train_s - ae.predict(X_train_s))**2, axis=1)\n    test_pred = ae.predict(X_test_s)\n    test_err = np.mean((X_test_s - test_pred)**2, axis=1)\n    \n    threshold = np.percentile(train_err, 95)\n    preds = (test_err > threshold).astype(int)\n    f1 = f1_score(y_test, preds, zero_division=0)\n    \n    print(f\"{bottleneck:<12} {train_err.mean():<12.6f} {test_err[:100].mean():<12.6f} \"\n          f\"{test_err[100:].mean():<13.6f} {f1:<8.4f}\")"
        ]
      ]
