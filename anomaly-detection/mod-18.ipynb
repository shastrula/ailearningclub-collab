          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# Raw network traffic data\nn_normal = 500\nnormal_traffic = pd.DataFrame({\n    'bytes_sent': np.random.exponential(500, n_normal),\n    'bytes_received': np.random.exponential(1000, n_normal),\n    'packets': np.random.poisson(20, n_normal),\n    'duration_sec': np.random.exponential(5, n_normal),\n    'src_port': np.random.choice([80, 443, 8080, 3000], n_normal),\n})\n\n# Anomalous traffic (port scanning)\nn_anomaly = 25\nanomaly_traffic = pd.DataFrame({\n    'bytes_sent': np.random.exponential(50, n_anomaly),\n    'bytes_received': np.random.exponential(30, n_anomaly),\n    'packets': np.random.poisson(3, n_anomaly),\n    'duration_sec': np.random.exponential(0.1, n_anomaly),\n    'src_port': np.random.randint(1024, 65535, n_anomaly),\n})\n\ndf = pd.concat([normal_traffic, anomaly_traffic], ignore_index=True)\ny_true = np.array([0]*n_normal + [1]*n_anomaly)\n\n# Feature Engineering\ndef engineer_features(df):\n    features = df.copy()\n    \n    # Ratio features\n    features['bytes_ratio'] = df['bytes_sent'] / (df['bytes_received'] + 1)\n    features['bytes_per_packet'] = (df['bytes_sent'] + df['bytes_received']) / (df['packets'] + 1)\n    features['bytes_per_second'] = (df['bytes_sent'] + df['bytes_received']) / (df['duration_sec'] + 0.001)\n    features['packets_per_second'] = df['packets'] / (df['duration_sec'] + 0.001)\n    \n    # Log transforms (handle skewness)\n    features['log_bytes_sent'] = np.log1p(df['bytes_sent'])\n    features['log_duration'] = np.log1p(df['duration_sec'])\n    \n    # Interaction features\n    features['intensity'] = df['bytes_sent'] * df['packets'] / (df['duration_sec'] + 0.001)\n    \n    # Port category (high port numbers are unusual)\n    features['is_high_port'] = (df['src_port'] > 1024).astype(int)\n    \n    return features\n\n# Compare raw vs engineered features\nX_raw = df[['bytes_sent', 'bytes_received', 'packets', 'duration_sec']].values\nX_engineered = engineer_features(df).drop('src_port', axis=1).values\n\n# Evaluate with Isolation Forest\nresults = {}\nfor name, X in [(\"Raw Features\", X_raw), (\"Engineered Features\", X_engineered)]:\n    scaler = StandardScaler()\n    X_s = scaler.fit_transform(X)\n    clf = IsolationForest(contamination=0.05, random_state=42)\n    pred = (clf.fit_predict(X_s) == -1).astype(int)\n    results[name] = f1_score(y_true, pred)\n\nprint(\"Feature Engineering Impact on Detection\")\nprint(\"=\" * 50)\nprint(f\"{'Feature Set':<25} {'F1 Score':<10} {'Features':<10}\")\nprint(\"-\" * 50)\nprint(f\"{'Raw (4 features)':<25} {results['Raw Features']:<10.4f} {X_raw.shape[1]:<10}\")\nprint(f\"{'Engineered (12 features)':<25} {results['Engineered Features']:<10.4f} {X_engineered.shape[1]:<10}\")\nprint(f\"\\nImprovement: {(results['Engineered Features']-results['Raw Features'])/results['Raw Features']*100:.1f}%\")"
        ]
      ]
    },
