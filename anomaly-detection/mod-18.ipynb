          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# Generate dataset with informative and noise features\nn_normal = 500\nn_anomaly = 25\n\n# 5 informative features\nX_informative_normal = np.random.normal(0, 1, (n_normal, 5))\nX_informative_anomaly = np.random.uniform(-5, 5, (n_anomaly, 5))\n\n# 15 noise features (same for normal and anomaly)\nX_noise_normal = np.random.normal(0, 1, (n_normal, 15))\nX_noise_anomaly = np.random.normal(0, 1, (n_anomaly, 15))\n\nX = np.vstack([\n    np.hstack([X_informative_normal, X_noise_normal]),\n    np.hstack([X_informative_anomaly, X_noise_anomaly])\n])\ny_true = np.array([0]*n_normal + [1]*n_anomaly)\n\n# Feature importance via individual feature anomaly detection performance\nfeature_scores = []\nfor i in range(X.shape[1]):\n    X_single = X[:, i:i+1]\n    X_s = StandardScaler().fit_transform(X_single)\n    clf = IsolationForest(contamination=0.05, random_state=42)\n    pred = (clf.fit_predict(X_s) == -1).astype(int)\n    f1 = f1_score(y_true, pred, zero_division=0)\n    feature_scores.append(f1)\n\n# Rank features\nfeature_ranking = np.argsort(feature_scores)[::-1]\n\nprint(\"Feature Importance for Anomaly Detection\")\nprint(\"=\" * 50)\nprint(f\"Total features: {X.shape[1]} (5 informative + 15 noise)\")\nprint(f\"\\n{'Rank':<6} {'Feature':<12} {'F1 Score':<10} {'Type'}\")\nprint(\"-\" * 50)\nfor rank, idx in enumerate(feature_ranking[:10]):\n    feat_type = \"INFORMATIVE\" if idx < 5 else \"noise\"\n    print(f\"{rank+1:<6} Feature {idx:<4} {feature_scores[idx]:<10.4f} {feat_type}\")\n\n# Compare using top-k features vs all features\nprint(f\"\\nDetection with different feature sets:\")\nprint(f\"{'Features':<25} {'F1 Score':<10}\")\nprint(\"-\" * 40)\n\nfor k in [5, 10, 15, 20]:\n    top_k = feature_ranking[:k]\n    X_subset = X[:, top_k]\n    X_s = StandardScaler().fit_transform(X_subset)\n    clf = IsolationForest(contamination=0.05, random_state=42)\n    pred = (clf.fit_predict(X_s) == -1).astype(int)\n    f1 = f1_score(y_true, pred, zero_division=0)\n    print(f\"Top {k} features          {f1:.4f}\")"
        ]
      ]
