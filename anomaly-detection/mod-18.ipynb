          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# E-commerce transaction features\nn_normal = 500\nn_fraud = 20\n\n# Normal transactions\nnormal = pd.DataFrame({\n    'amount': np.random.lognormal(3.5, 1.0, n_normal),\n    'hour': np.random.choice(range(8, 22), n_normal),  # Business hours\n    'n_items': np.random.poisson(3, n_normal) + 1,\n    'user_age_days': np.random.exponential(365, n_normal),\n    'n_past_transactions': np.random.poisson(20, n_normal),\n})\n\n# Fraudulent transactions\nfraud = pd.DataFrame({\n    'amount': np.random.lognormal(6, 0.5, n_fraud),  # Higher amounts\n    'hour': np.random.choice(range(0, 6), n_fraud),   # Odd hours\n    'n_items': np.random.poisson(1, n_fraud) + 1,     # Few items\n    'user_age_days': np.random.exponential(30, n_fraud),  # New accounts\n    'n_past_transactions': np.random.poisson(2, n_fraud),  # Few past txns\n})\n\ndf = pd.concat([normal, fraud], ignore_index=True)\ny_true = np.array([0]*n_normal + [1]*n_fraud)\n\n# Domain-specific features\ndf['amount_per_item'] = df['amount'] / df['n_items']\ndf['is_night'] = ((df['hour'] < 6) | (df['hour'] > 22)).astype(int)\ndf['txn_velocity'] = df['n_past_transactions'] / (df['user_age_days'] + 1)\ndf['log_amount'] = np.log1p(df['amount'])\ndf['is_new_user'] = (df['user_age_days'] < 30).astype(int)\ndf['amount_deviation'] = abs(df['amount'] - df['amount'].mean()) / df['amount'].std()\n\n# Show feature distributions for normal vs fraud\nprint(\"Feature Comparison: Normal vs Fraudulent Transactions\")\nprint(\"=\" * 65)\nprint(f\"{'Feature':<22} {'Normal (mean)':<15} {'Fraud (mean)':<15} {'Separation'}\")\nprint(\"-\" * 65)\n\nfor col in ['amount', 'amount_per_item', 'is_night', 'txn_velocity', \n            'log_amount', 'is_new_user', 'amount_deviation']:\n    normal_mean = df.loc[y_true==0, col].mean()\n    fraud_mean = df.loc[y_true==1, col].mean()\n    normal_std = df.loc[y_true==0, col].std()\n    separation = abs(fraud_mean - normal_mean) / (normal_std + 0.001)\n    print(f\"{col:<22} {normal_mean:<15.4f} {fraud_mean:<15.4f} {separation:<.2f}\u03c3\")"
