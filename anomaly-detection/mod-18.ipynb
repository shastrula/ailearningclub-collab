          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# Simulated server metrics (1 reading per minute, 24 hours)\nn = 1440  # 24 hours\ntimestamps = pd.date_range('2024-01-01', periods=n, freq='min')\n\ncpu = np.random.normal(45, 5, n)\n# Inject anomalous period (10 minutes of high CPU)\ncpu[600:610] = np.random.normal(90, 3, 10)\ncpu[1000:1005] = np.random.normal(92, 2, 5)\n\ndf = pd.DataFrame({'timestamp': timestamps, 'cpu': cpu})\ny_true = np.zeros(n)\ny_true[600:610] = 1\ny_true[1000:1005] = 1\n\n# Temporal features\ndef create_temporal_features(df, col='cpu'):\n    features = pd.DataFrame()\n    features['value'] = df[col]\n    \n    # Rolling statistics (multiple windows)\n    for window in [5, 15, 60]:\n        features[f'rolling_mean_{window}'] = df[col].rolling(window).mean()\n        features[f'rolling_std_{window}'] = df[col].rolling(window).std()\n        features[f'rolling_max_{window}'] = df[col].rolling(window).max()\n        features[f'rolling_min_{window}'] = df[col].rolling(window).min()\n    \n    # Lag features\n    for lag in [1, 5, 10]:\n        features[f'lag_{lag}'] = df[col].shift(lag)\n        features[f'diff_{lag}'] = df[col].diff(lag)\n    \n    # Rate of change\n    features['pct_change'] = df[col].pct_change()\n    features['acceleration'] = df[col].diff().diff()\n    \n    # Distance from rolling mean\n    features['deviation_from_rolling'] = abs(df[col] - df[col].rolling(30).mean())\n    \n    # Hour of day (cyclical)\n    features['hour_sin'] = np.sin(2 * np.pi * df['timestamp'].dt.hour / 24)\n    features['hour_cos'] = np.cos(2 * np.pi * df['timestamp'].dt.hour / 24)\n    \n    return features.dropna()\n\n# Create features\nX_temporal = create_temporal_features(df)\ny_aligned = y_true[len(y_true)-len(X_temporal):]\n\n# Compare raw vs temporal\nX_raw_only = df[['cpu']].iloc[len(df)-len(X_temporal):].values\nX_temp_values = X_temporal.values\n\nscaler = StandardScaler()\nfor name, X, y in [(\"Raw CPU only\", X_raw_only, y_aligned),\n                   (\"Temporal Features\", X_temp_values, y_aligned)]:\n    X_s = scaler.fit_transform(X)\n    clf = IsolationForest(contamination=0.01, random_state=42)\n    pred = (clf.fit_predict(X_s) == -1).astype(int)\n    f1 = f1_score(y, pred, zero_division=0)\n    print(f\"{name:<25}: F1={f1:.4f}, Detected={pred.sum()}\")"
