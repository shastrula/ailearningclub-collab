          "python",
          "import numpy as np\nfrom sklearn.decomposition import PCA\nfrom sklearn.covariance import EllipticEnvelope\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.neighbors import LocalOutlierFactor\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# 10-feature dataset with subtle multivariate anomalies\nn_features = 10\nn_normal = 800\nX_normal = np.random.multivariate_normal(\n    np.zeros(n_features),\n    np.eye(n_features) + 0.3 * np.ones((n_features, n_features)),\n    n_normal\n)\n\n# Anomalies that break correlation structure\nn_anomaly = 40\nX_anomaly = np.random.multivariate_normal(\n    np.zeros(n_features),\n    np.eye(n_features) * 3,  # Independent (no correlation)\n    n_anomaly\n)\n\nX = np.vstack([X_normal, X_anomaly])\ny_true = np.array([0]*n_normal + [1]*n_anomaly)\nX_scaled = StandardScaler().fit_transform(X)\n\n# Method 1: PCA reconstruction error\npca = PCA(n_components=5)\nX_pca = pca.fit_transform(X_scaled)\nX_recon = pca.inverse_transform(X_pca)\npca_scores = np.mean((X_scaled - X_recon)**2, axis=1)\npca_pred = (pca_scores > np.percentile(pca_scores, 95)).astype(int)\n\n# Method 2: Elliptic Envelope\nee = EllipticEnvelope(contamination=0.05, random_state=42)\nee_pred = (ee.fit_predict(X_scaled) == -1).astype(int)\n\n# Method 3: Isolation Forest\niforest = IsolationForest(contamination=0.05, random_state=42)\nif_pred = (iforest.fit_predict(X_scaled) == -1).astype(int)\n\n# Method 4: LOF\nlof = LocalOutlierFactor(n_neighbors=20, contamination=0.05)\nlof_pred = (lof.fit_predict(X_scaled) == -1).astype(int)\n\n# Ensemble: majority vote\nensemble_score = pca_pred + ee_pred + if_pred + lof_pred\nensemble_pred = (ensemble_score >= 2).astype(int)  # At least 2 of 4 agree\n\nprint(\"Multivariate Detection Method Comparison (10 features)\")\nprint(\"=\" * 55)\nprint(f\"{'Method':<22} {'F1':<8} {'Precision':<12} {'Recall':<10}\")\nprint(\"-\" * 55)\nfor name, pred in [(\"PCA Reconstruction\", pca_pred),\n                   (\"Elliptic Envelope\", ee_pred),\n                   (\"Isolation Forest\", if_pred),\n                   (\"LOF\", lof_pred),\n                   (\"Ensemble (2/4 vote)\", ensemble_pred)]:\n    f1 = f1_score(y_true, pred, zero_division=0)\n    prec = f1_score(y_true, pred, zero_division=0)\n    from sklearn.metrics import precision_score, recall_score\n    p = precision_score(y_true, pred, zero_division=0)\n    r = recall_score(y_true, pred, zero_division=0)\n    print(f\"{name:<22} {f1:<8.4f} {p:<12.4f} {r:<10.4f}\")"
