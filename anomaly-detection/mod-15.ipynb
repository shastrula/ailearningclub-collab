      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.decomposition import PCA\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score, precision_score, recall_score\n\nnp.random.seed(42)\n\n# Generate correlated normal data (manufacturing sensors)\nn_normal = 500\nmean = [100, 50, 75, 200, 30]\ncov = [[10, 5, 3, 8, 2],\n       [5, 8, 4, 6, 1],\n       [3, 4, 12, 5, 3],\n       [8, 6, 5, 15, 4],\n       [2, 1, 3, 4, 6]]\nX_normal = np.random.multivariate_normal(mean, cov, n_normal)\n\n# Anomalies: unusual feature combinations\nX_anomaly = np.array([\n    [130, 30, 95, 250, 10],  # High temp, low pressure\n    [70, 70, 55, 150, 50],   # Inverse correlation broken\n    [120, 65, 90, 180, 45],  # All slightly off\n    [80, 35, 60, 230, 15],   # Mixed\n    [140, 25, 100, 260, 8],  # Extreme correlation break\n    [90, 60, 40, 170, 40],\n    [115, 30, 85, 240, 12],\n    [75, 68, 50, 160, 48],\n    [125, 28, 92, 255, 9],\n    [85, 62, 45, 165, 42],\n])\n\nX = np.vstack([X_normal, X_anomaly])\ny_true = np.array([0]*n_normal + [1]*len(X_anomaly))\n\n# Scale\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\n# PCA - keep components explaining 90% variance\npca = PCA(n_components=0.90)\nX_transformed = pca.fit_transform(X_scaled)\nX_reconstructed = pca.inverse_transform(X_transformed)\n\n# Reconstruction error as anomaly score\nreconstruction_error = np.mean((X_scaled - X_reconstructed) ** 2, axis=1)\n\n# Threshold from training data\nthreshold = np.percentile(reconstruction_error[:n_normal], 95)\ny_pred = (reconstruction_error > threshold).astype(int)\n\nprec = precision_score(y_true, y_pred, zero_division=0)\nrec = recall_score(y_true, y_pred, zero_division=0)\nf1 = f1_score(y_true, y_pred, zero_division=0)\n\nprint(\"PCA-Based Anomaly Detection\")\nprint(\"=\" * 55)\nprint(f\"Original features: {X.shape[1]}\")\nprint(f\"PCA components retained: {pca.n_components_}\")\nprint(f\"Variance explained: {pca.explained_variance_ratio_.sum():.4f}\")\nprint(f\"\\nReconstruction Error:\")\nprint(f\"  Normal mean: {reconstruction_error[:n_normal].mean():.6f}\")\nprint(f\"  Anomaly mean: {reconstruction_error[n_normal:].mean():.6f}\")\nprint(f\"  Threshold (95th pctl): {threshold:.6f}\")\nprint(f\"\\nResults:\")\nprint(f\"  Precision: {prec:.4f}\")\nprint(f\"  Recall: {rec:.4f}\")\nprint(f\"  F1 Score: {f1:.4f}\")"
        ]
      ]
    },
