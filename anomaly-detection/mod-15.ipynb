          "python",
          "import numpy as np\nfrom sklearn.covariance import EllipticEnvelope\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score, classification_report\n\nnp.random.seed(42)\n\n# Generate multivariate normal data\nn_normal = 500\nmean = [0, 0, 0, 0]\ncov = [[4, 2, 1, 0.5],\n       [2, 3, 1.5, 1],\n       [1, 1.5, 5, 2],\n       [0.5, 1, 2, 3]]\nX_normal = np.random.multivariate_normal(mean, cov, n_normal)\n\n# Various anomaly types\nanomalies = np.vstack([\n    np.random.uniform(-8, 8, (10, 4)),  # Global outliers\n    np.array([[3, -4, 6, -5], [4, -3, 5, -6], [-5, 4, -6, 5],\n              [5, 5, -5, -5], [-4, -4, 5, 5]])  # Correlation breakers\n])\n\nX = np.vstack([X_normal, anomalies])\ny_true = np.array([0]*n_normal + [1]*15)\n\n# Scale\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\n# Elliptic Envelope\nee = EllipticEnvelope(contamination=0.03, random_state=42)\ny_pred = (ee.fit_predict(X_scaled) == -1).astype(int)\nscores = -ee.decision_function(X_scaled)\n\nprint(\"Elliptic Envelope (Robust Covariance)\")\nprint(\"=\" * 50)\nprint(f\"Contamination: 0.03\")\nprint(f\"Features: 4\")\nprint(f\"\\nClassification Report:\")\nprint(classification_report(y_true, y_pred, target_names=['Normal', 'Anomaly']))"
        ]
