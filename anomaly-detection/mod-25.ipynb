      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score\nimport json\nimport time\n\nnp.random.seed(42)\n\nclass AnomalyDetectionPipeline:\n    \"\"\"Production-ready anomaly detection pipeline.\"\"\"\n    \n    def __init__(self, model_config):\n        self.config = model_config\n        self.scaler = StandardScaler()\n        self.model = None\n        self.threshold = None\n        self.metadata = {}\n        self.performance_history = []\n    \n    def train(self, X_train):\n        \"\"\"Train the model on normal data.\"\"\"\n        start_time = time.time()\n        \n        # Fit scaler\n        X_scaled = self.scaler.fit_transform(X_train)\n        \n        # Train model\n        self.model = IsolationForest(\n            n_estimators=self.config['n_estimators'],\n            contamination=self.config['contamination'],\n            max_samples=self.config.get('max_samples', 'auto'),\n            random_state=42\n        )\n        self.model.fit(X_scaled)\n        \n        # Set threshold from training scores\n        train_scores = -self.model.decision_function(X_scaled)\n        self.threshold = np.percentile(train_scores, \n                                       (1 - self.config['contamination']) * 100)\n        \n        # Store metadata\n        self.metadata = {\n            'training_samples': len(X_train),\n            'n_features': X_train.shape[1],\n            'training_time_sec': time.time() - start_time,\n            'threshold': self.threshold,\n            'training_score_mean': float(train_scores.mean()),\n            'training_score_std': float(train_scores.std()),\n            'model_version': self.config.get('version', '1.0'),\n        }\n        \n        return self.metadata\n    \n    def predict(self, X):\n        \"\"\"Score and classify new observations.\"\"\"\n        X_scaled = self.scaler.transform(X)\n        scores = -self.model.decision_function(X_scaled)\n        predictions = (scores > self.threshold).astype(int)\n        \n        return {\n            'scores': scores,\n            'predictions': predictions,\n            'n_anomalies': int(predictions.sum()),\n            'max_score': float(scores.max()),\n            'mean_score': float(scores.mean()),\n        }\n    \n    def evaluate(self, X, y_true):\n        \"\"\"Evaluate model performance.\"\"\"\n        result = self.predict(X)\n        f1 = f1_score(y_true, result['predictions'], zero_division=0)\n        \n        eval_metrics = {\n            'f1_score': f1,\n            'n_samples': len(X),\n            'n_true_anomalies': int(y_true.sum()),\n            'n_predicted_anomalies': result['n_anomalies'],\n            'timestamp': time.time(),\n        }\n        \n        self.performance_history.append(eval_metrics)\n        return eval_metrics\n    \n    def check_drift(self, X, window_size=100):\n        \"\"\"Check if score distribution has shifted (concept drift).\"\"\"\n        X_scaled = self.scaler.transform(X)\n        current_scores = -self.model.decision_function(X_scaled)\n        \n        score_mean = current_scores.mean()\n        score_std = current_scores.std()\n        \n        # Compare to training distribution\n        drift_z = abs(score_mean - self.metadata['training_score_mean']) / \\\n                  (self.metadata['training_score_std'] + 0.001)\n        \n        needs_retrain = drift_z > 3.0\n        \n        return {\n            'drift_z_score': float(drift_z),\n            'current_mean': float(score_mean),\n            'training_mean': self.metadata['training_score_mean'],\n            'needs_retrain': needs_retrain,\n        }\n\n# Demo the pipeline\nconfig = {\n    'n_estimators': 200,\n    'contamination': 0.05,\n    'max_samples': 256,\n    'version': '1.0'\n}\n\n# Generate data\nX_train_normal = np.random.normal(0, 1, (1000, 5))\nX_test = np.vstack([\n    np.random.normal(0, 1, (200, 5)),\n    np.random.uniform(-5, 5, (10, 5))\n])\ny_test = np.array([0]*200 + [1]*10)\n\n# Run pipeline\npipeline = AnomalyDetectionPipeline(config)\ntrain_meta = pipeline.train(X_train_normal)\neval_result = pipeline.evaluate(X_test, y_test)\ndrift_result = pipeline.check_drift(X_test)\n\nprint(\"Production Anomaly Detection Pipeline\")\nprint(\"=\" * 55)\nprint(f\"\\nTraining Metadata:\")\nfor k, v in train_meta.items():\n    print(f\"  {k}: {v:.4f}\" if isinstance(v, float) else f\"  {k}: {v}\")\n\nprint(f\"\\nEvaluation Results:\")\nfor k, v in eval_result.items():\n    if k != 'timestamp':\n        print(f\"  {k}: {v:.4f}\" if isinstance(v, float) else f\"  {k}: {v}\")\n\nprint(f\"\\nDrift Check:\")\nfor k, v in drift_result.items():\n    print(f\"  {k}: {v:.4f}\" if isinstance(v, float) else f\"  {k}: {v}\")"
        ]
      ]
    },
