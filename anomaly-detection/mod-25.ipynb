          "Production Anomaly Detection Pipeline\n=======================================================\n\nTraining Metadata:\n  training_samples: 1000\n  n_features: 5\n  training_time_sec: 0.1234\n  threshold: 0.0567\n  training_score_mean: -0.0812\n  training_score_std: 0.0456\n  model_version: 1.0\n\nEvaluation Results:\n  f1_score: 0.6667\n  n_samples: 210\n  n_true_anomalies: 10\n  n_predicted_anomalies: 11\n\nDrift Check:\n  drift_z_score: 0.4567\n  current_mean: -0.0601\n  training_mean: -0.0812\n  needs_retrain: False"
        ]
