          "python",
          "import numpy as np\nfrom collections import deque\n\nnp.random.seed(42)\n\nclass AlertingSystem:\n    \"\"\"Multi-tier alerting for anomaly detection.\"\"\"\n    \n    def __init__(self):\n        self.alert_history = deque(maxlen=1000)\n        self.thresholds = {\n            'low': 0.3,      # Informational\n            'medium': 0.5,   # Review required\n            'high': 0.7,     # Immediate attention\n            'critical': 0.9  # Auto-action + page on-call\n        }\n        self.suppression_window = 10  # Suppress duplicate alerts\n        self.recent_alerts = {}\n    \n    def process_score(self, score, metadata=None):\n        \"\"\"Process an anomaly score and generate alerts.\"\"\"\n        severity = self.get_severity(score)\n        \n        if severity == 'normal':\n            return None\n        \n        # Deduplicate\n        alert_key = metadata.get('source', 'unknown') if metadata else 'unknown'\n        if alert_key in self.recent_alerts:\n            if self.recent_alerts[alert_key] > 0:\n                self.recent_alerts[alert_key] -= 1\n                return {'severity': severity, 'suppressed': True}\n        \n        alert = {\n            'severity': severity,\n            'score': score,\n            'suppressed': False,\n            'action': self.get_action(severity),\n            'metadata': metadata,\n        }\n        \n        self.alert_history.append(alert)\n        self.recent_alerts[alert_key] = self.suppression_window\n        \n        return alert\n    \n    def get_severity(self, score):\n        if score >= self.thresholds['critical']:\n            return 'critical'\n        elif score >= self.thresholds['high']:\n            return 'high'\n        elif score >= self.thresholds['medium']:\n            return 'medium'\n        elif score >= self.thresholds['low']:\n            return 'low'\n        return 'normal'\n    \n    def get_action(self, severity):\n        actions = {\n            'low': 'Log for review',\n            'medium': 'Add to review queue',\n            'high': 'Alert analyst immediately',\n            'critical': 'Auto-block + page on-call engineer',\n        }\n        return actions[severity]\n\n# Simulate production scoring\nalerting = AlertingSystem()\n\n# Simulated anomaly scores from production\nscores = np.concatenate([\n    np.random.normal(0.1, 0.05, 90),   # Normal (low scores)\n    np.array([0.35, 0.42, 0.55, 0.62, 0.75, 0.82, 0.91, 0.95, 0.45, 0.38])  # Anomalous\n])\n\nalert_counts = {'normal': 0, 'low': 0, 'medium': 0, 'high': 0, 'critical': 0}\nfor i, score in enumerate(scores):\n    result = alerting.process_score(score, metadata={'source': f'sensor_{i%5}', 'index': i})\n    if result is None:\n        alert_counts['normal'] += 1\n    elif not result.get('suppressed', False):\n        alert_counts[result['severity']] += 1\n\nprint(\"Production Alerting System\")\nprint(\"=\" * 55)\nprint(f\"Threshold Configuration:\")\nfor level, thresh in alerting.thresholds.items():\n    print(f\"  {level:<10}: score >= {thresh}\")\n\nprint(f\"\\nSimulation Results ({len(scores)} observations):\")\nprint(f\"{'Severity':<12} {'Count':<8} {'Action'}\")\nprint(\"-\" * 55)\nfor severity in ['normal', 'low', 'medium', 'high', 'critical']:\n    action = alerting.get_action(severity) if severity != 'normal' else 'No action'\n    print(f\"{severity:<12} {alert_counts[severity]:<8} {action}\")"
        ]
      ]
