          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\nclass RetrainingScheduler:\n    \"\"\"Manages model retraining based on performance and drift.\"\"\"\n    \n    def __init__(self, retrain_threshold_f1=0.5, drift_threshold=3.0, \n                 min_samples_retrain=500):\n        self.retrain_threshold_f1 = retrain_threshold_f1\n        self.drift_threshold = drift_threshold\n        self.min_samples_retrain = min_samples_retrain\n        self.retrain_buffer = []\n        self.retrain_history = []\n    \n    def should_retrain(self, current_f1, drift_z, buffer_size):\n        \"\"\"Determine if retraining is needed.\"\"\"\n        reasons = []\n        \n        if current_f1 < self.retrain_threshold_f1:\n            reasons.append(f\"F1 dropped below {self.retrain_threshold_f1}\")\n        \n        if drift_z > self.drift_threshold:\n            reasons.append(f\"Drift z-score ({drift_z:.2f}) exceeds threshold\")\n        \n        if buffer_size >= self.min_samples_retrain and len(reasons) > 0:\n            return True, reasons\n        \n        return False, reasons\n    \n    def log_retrain(self, reason, old_f1, new_f1, n_samples):\n        self.retrain_history.append({\n            'reason': reason,\n            'old_f1': old_f1,\n            'new_f1': new_f1,\n            'n_samples': n_samples,\n        })\n\n# Simulate production operation over time\nscheduler = RetrainingScheduler()\n\n# Simulated weekly performance\nweeks = [\n    {'f1': 0.75, 'drift_z': 0.5, 'buffer': 200},\n    {'f1': 0.72, 'drift_z': 0.8, 'buffer': 400},\n    {'f1': 0.68, 'drift_z': 1.2, 'buffer': 600},\n    {'f1': 0.55, 'drift_z': 2.1, 'buffer': 800},\n    {'f1': 0.42, 'drift_z': 3.5, 'buffer': 1000},  # Retrain triggered\n    {'f1': 0.78, 'drift_z': 0.3, 'buffer': 200},   # After retrain\n    {'f1': 0.76, 'drift_z': 0.4, 'buffer': 400},\n]\n\nprint(\"Model Retraining Schedule Simulation\")\nprint(\"=\" * 70)\nprint(f\"{'Week':<6} {'F1':<6} {'Drift Z':<9} {'Buffer':<8} {'Action'}\")\nprint(\"-\" * 70)\n\nfor i, week in enumerate(weeks):\n    needs_retrain, reasons = scheduler.should_retrain(\n        week['f1'], week['drift_z'], week['buffer']\n    )\n    action = f\"RETRAIN: {'; '.join(reasons)}\" if needs_retrain else \"Monitor\"\n    print(f\"{i+1:<6} {week['f1']:<6.2f} {week['drift_z']:<9.2f} {week['buffer']:<8} {action}\")"
        ]
      ]
    },
