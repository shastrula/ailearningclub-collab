          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.metrics import classification_report, f1_score\n\nnp.random.seed(42)\n\ndef generate_network_data(n_normal=2000, n_portscan=50, n_ddos=30, n_exfil=20):\n    normal = pd.DataFrame({\n        'duration': np.random.exponential(5, n_normal),\n        'bytes_sent': np.random.lognormal(6, 1.5, n_normal),\n        'bytes_received': np.random.lognormal(8, 1.5, n_normal),\n        'packets_sent': np.random.poisson(15, n_normal),\n        'packets_received': np.random.poisson(30, n_normal),\n        'src_port': np.random.choice([80, 443, 8080, 8443], n_normal),\n        'dst_port': np.random.randint(1024, 65535, n_normal),\n        'protocol': np.random.choice([6, 17], n_normal, p=[0.8, 0.2]),\n        'label': 'normal'\n    })\n    portscan = pd.DataFrame({\n        'duration': np.random.exponential(0.01, n_portscan),\n        'bytes_sent': np.random.poisson(60, n_portscan),\n        'bytes_received': np.random.poisson(40, n_portscan),\n        'packets_sent': np.random.poisson(2, n_portscan) + 1,\n        'packets_received': np.random.poisson(1, n_portscan),\n        'src_port': np.random.randint(1024, 65535, n_portscan),\n        'dst_port': np.random.randint(1, 1024, n_portscan),\n        'protocol': np.full(n_portscan, 6),\n        'label': 'portscan'\n    })\n    ddos = pd.DataFrame({\n        'duration': np.random.exponential(0.5, n_ddos),\n        'bytes_sent': np.random.poisson(100, n_ddos),\n        'bytes_received': np.random.poisson(10, n_ddos),\n        'packets_sent': np.random.poisson(500, n_ddos),\n        'packets_received': np.random.poisson(5, n_ddos),\n        'src_port': np.random.randint(1024, 65535, n_ddos),\n        'dst_port': np.random.choice([80, 443], n_ddos),\n        'protocol': np.full(n_ddos, 17),\n        'label': 'ddos'\n    })\n    exfil = pd.DataFrame({\n        'duration': np.random.exponential(300, n_exfil),\n        'bytes_sent': np.random.lognormal(15, 1, n_exfil),\n        'bytes_received': np.random.poisson(500, n_exfil),\n        'packets_sent': np.random.poisson(50, n_exfil),\n        'packets_received': np.random.poisson(10, n_exfil),\n        'src_port': np.random.randint(1024, 65535, n_exfil),\n        'dst_port': np.random.choice([443, 8443, 22], n_exfil),\n        'protocol': np.full(n_exfil, 6),\n        'label': 'exfiltration'\n    })\n    return pd.concat([normal, portscan, ddos, exfil], ignore_index=True)\n\ndf = generate_network_data()\ny_true = (df['label'] != 'normal').astype(int)\n\ndef engineer_network_features(df):\n    \"\"\"Create network-specific anomaly detection features.\"\"\"\n    features = pd.DataFrame()\n    \n    # Basic ratios\n    features['bytes_ratio'] = df['bytes_sent'] / (df['bytes_received'] + 1)\n    features['packet_ratio'] = df['packets_sent'] / (df['packets_received'] + 1)\n    \n    # Rates\n    features['bytes_per_sec'] = (df['bytes_sent'] + df['bytes_received']) / (df['duration'] + 0.001)\n    features['packets_per_sec'] = (df['packets_sent'] + df['packets_received']) / (df['duration'] + 0.001)\n    \n    # Packet sizes\n    features['avg_packet_size_sent'] = df['bytes_sent'] / (df['packets_sent'] + 1)\n    features['avg_packet_size_recv'] = df['bytes_received'] / (df['packets_received'] + 1)\n    \n    # Log transforms\n    features['log_duration'] = np.log1p(df['duration'])\n    features['log_bytes_total'] = np.log1p(df['bytes_sent'] + df['bytes_received'])\n    \n    # Port features\n    features['is_well_known_dst'] = (df['dst_port'] < 1024).astype(int)\n    features['is_well_known_src'] = (df['src_port'] < 1024).astype(int)\n    \n    # Protocol\n    features['is_udp'] = (df['protocol'] == 17).astype(int)\n    \n    # Intensity\n    features['flow_intensity'] = df['bytes_sent'] * df['packets_sent'] / (df['duration'] + 0.001)\n    \n    return features\n\nX = engineer_network_features(df)\nX_scaled = StandardScaler().fit_transform(X)\n\n# Detect with Isolation Forest\nclf = IsolationForest(n_estimators=200, contamination=0.05, random_state=42)\ny_pred = (clf.fit_predict(X_scaled) == -1).astype(int)\n\nprint(\"Network Traffic Anomaly Detection Results\")\nprint(\"=\" * 55)\nprint(f\"Features engineered: {X.shape[1]}\")\nprint(f\"\\nOverall:\")\nprint(classification_report(y_true, y_pred, target_names=['Normal', 'Attack']))\n\n# Per-attack-type detection\nprint(\"Per-Attack Detection Rate:\")\nprint(\"-\" * 40)\nfor attack in ['portscan', 'ddos', 'exfiltration']:\n    mask = df['label'] == attack\n    detected = y_pred[mask].sum()\n    total = mask.sum()\n    print(f\"  {attack:<15}: {detected}/{total} detected ({detected/total:.0%})\")"
        ]
      ]
