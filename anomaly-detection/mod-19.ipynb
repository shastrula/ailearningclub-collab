          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.neighbors import LocalOutlierFactor\nfrom sklearn.svm import OneClassSVM\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# Use the same data generation and feature engineering\n# (condensed for brevity)\nn = 2000\nnormal_features = np.column_stack([\n    np.random.exponential(5, n),          # duration\n    np.random.lognormal(6, 1.5, n),       # bytes\n    np.random.poisson(20, n),             # packets\n    np.random.lognormal(6, 1.5, n) / (np.random.poisson(20, n) + 1),  # bytes/pkt\n])\n\nn_attack = 80\nattack_features = np.column_stack([\n    np.random.exponential(0.1, n_attack),\n    np.random.poisson(80, n_attack).astype(float),\n    np.random.poisson(300, n_attack),\n    np.random.poisson(80, n_attack) / (np.random.poisson(300, n_attack) + 1),\n])\n\nX = np.vstack([normal_features, attack_features])\ny_true = np.array([0]*n + [1]*n_attack)\nX_scaled = StandardScaler().fit_transform(X)\n\n# Multiple detectors\nmodels = {\n    'Isolation Forest': IsolationForest(contamination=0.04, random_state=42),\n    'LOF': LocalOutlierFactor(n_neighbors=20, contamination=0.04),\n    'One-Class SVM': OneClassSVM(nu=0.04),\n}\n\npredictions = {}\nfor name, model in models.items():\n    if name == 'LOF':\n        pred = (model.fit_predict(X_scaled) == -1).astype(int)\n    else:\n        model.fit(X_scaled)\n        pred = (model.predict(X_scaled) == -1).astype(int)\n    predictions[name] = pred\n\n# Ensemble\nvote_matrix = np.column_stack(list(predictions.values()))\nensemble_pred = (vote_matrix.sum(axis=1) >= 2).astype(int)\npredictions['Ensemble (2/3)'] = ensemble_pred\n\nprint(\"Multi-Model Network Anomaly Detection\")\nprint(\"=\" * 55)\nprint(f\"{'Model':<20} {'F1':<8} {'Precision':<12} {'Recall':<10}\")\nprint(\"-\" * 55)\nfor name, pred in predictions.items():\n    from sklearn.metrics import precision_score, recall_score\n    f1 = f1_score(y_true, pred, zero_division=0)\n    prec = precision_score(y_true, pred, zero_division=0)\n    rec = recall_score(y_true, pred, zero_division=0)\n    print(f\"{name:<20} {f1:<8.4f} {prec:<12.4f} {rec:<10.4f}\")"
        ]
