          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.preprocessing import StandardScaler\n\nnp.random.seed(42)\n\ndef generate_network_data(n_normal=2000, n_portscan=50, n_ddos=30, n_exfil=20):\n    \"\"\"Generate synthetic network flow data with labeled attacks.\"\"\"\n    \n    # Normal HTTP/HTTPS traffic\n    normal = pd.DataFrame({\n        'duration': np.random.exponential(5, n_normal),\n        'bytes_sent': np.random.lognormal(6, 1.5, n_normal),\n        'bytes_received': np.random.lognormal(8, 1.5, n_normal),\n        'packets_sent': np.random.poisson(15, n_normal),\n        'packets_received': np.random.poisson(30, n_normal),\n        'src_port': np.random.choice([80, 443, 8080, 8443], n_normal),\n        'dst_port': np.random.randint(1024, 65535, n_normal),\n        'protocol': np.random.choice([6, 17], n_normal, p=[0.8, 0.2]),  # TCP/UDP\n        'label': 'normal'\n    })\n    \n    # Port scanning: many short connections to different ports\n    portscan = pd.DataFrame({\n        'duration': np.random.exponential(0.01, n_portscan),\n        'bytes_sent': np.random.poisson(60, n_portscan),\n        'bytes_received': np.random.poisson(40, n_portscan),\n        'packets_sent': np.random.poisson(2, n_portscan) + 1,\n        'packets_received': np.random.poisson(1, n_portscan),\n        'src_port': np.random.randint(1024, 65535, n_portscan),\n        'dst_port': np.random.randint(1, 1024, n_portscan),\n        'protocol': np.full(n_portscan, 6),  # TCP SYN\n        'label': 'portscan'\n    })\n    \n    # DDoS: high packet rate, small packets\n    ddos = pd.DataFrame({\n        'duration': np.random.exponential(0.5, n_ddos),\n        'bytes_sent': np.random.poisson(100, n_ddos),\n        'bytes_received': np.random.poisson(10, n_ddos),\n        'packets_sent': np.random.poisson(500, n_ddos),\n        'packets_received': np.random.poisson(5, n_ddos),\n        'src_port': np.random.randint(1024, 65535, n_ddos),\n        'dst_port': np.random.choice([80, 443], n_ddos),\n        'protocol': np.full(n_ddos, 17),  # UDP flood\n        'label': 'ddos'\n    })\n    \n    # Data exfiltration: long duration, high bytes sent, low packets\n    exfil = pd.DataFrame({\n        'duration': np.random.exponential(300, n_exfil),\n        'bytes_sent': np.random.lognormal(15, 1, n_exfil),\n        'bytes_received': np.random.poisson(500, n_exfil),\n        'packets_sent': np.random.poisson(50, n_exfil),\n        'packets_received': np.random.poisson(10, n_exfil),\n        'src_port': np.random.randint(1024, 65535, n_exfil),\n        'dst_port': np.random.choice([443, 8443, 22], n_exfil),\n        'protocol': np.full(n_exfil, 6),\n        'label': 'exfiltration'\n    })\n    \n    return pd.concat([normal, portscan, ddos, exfil], ignore_index=True)\n\ndf = generate_network_data()\ny_true = (df['label'] != 'normal').astype(int)\n\nprint(\"Synthetic Network Traffic Dataset\")\nprint(\"=\" * 45)\nprint(f\"Total flows: {len(df)}\")\nprint(f\"\\nLabel distribution:\")\nprint(df['label'].value_counts().to_string())\nprint(f\"\\nAnomaly rate: {y_true.mean():.2%}\")"
        ]
