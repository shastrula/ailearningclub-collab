      "source": [
        "# Anomaly Detection - mod-3\n\n",
        "**Course:** anomaly-detection\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom scipy import stats\n\nnp.random.seed(42)\n\n# Simulate CPU usage data (normal operation + anomalies)\nnormal_cpu = np.random.normal(loc=45, scale=8, size=1000)\nanomaly_cpu = np.array([95, 98, 92, 97, 3, 2, 96, 94, 1, 99])\ncpu_data = np.concatenate([normal_cpu, anomaly_cpu])\ntrue_labels = np.array([0]*1000 + [1]*10)\n\n# Fit Gaussian distribution\nmu = np.mean(cpu_data)\nsigma = np.std(cpu_data)\n\n# Calculate probability density for each point\npdf_values = stats.norm.pdf(cpu_data, mu, sigma)\n\n# Set threshold (points with very low probability are anomalies)\nepsilon = 1e-4  # probability threshold\npredictions = (pdf_values < epsilon).astype(int)\n\n# Results\ntp = np.sum((predictions == 1) & (true_labels == 1))\nfp = np.sum((predictions == 1) & (true_labels == 0))\nfn = np.sum((predictions == 0) & (true_labels == 1))\n\nprint(\"Univariate Gaussian Anomaly Detection\")\nprint(\"=\" * 45)\nprint(f\"Fitted parameters: mu={mu:.2f}, sigma={sigma:.2f}\")\nprint(f\"Probability threshold (epsilon): {epsilon}\")\nprint(f\"\\nTotal samples: {len(cpu_data)}\")\nprint(f\"Anomalies detected: {predictions.sum()}\")\nprint(f\"True Positives: {tp}\")\nprint(f\"False Positives: {fp}\")\nprint(f\"False Negatives: {fn}\")\nprint(f\"Precision: {tp/(tp+fp):.4f}\")\nprint(f\"Recall: {tp/(tp+fn):.4f}\")\n\n# Show the probability of detected anomalies\nanomaly_values = cpu_data[predictions == 1]\nanomaly_probs = pdf_values[predictions == 1]\nprint(f\"\\nDetected anomaly values and their probabilities:\")\nfor val, prob in sorted(zip(anomaly_values, anomaly_probs))[:5]:\n    print(f\"  Value: {val:.1f}, P(x): {prob:.2e}\")"
        ]
      ]
    },
