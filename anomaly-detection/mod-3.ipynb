          "python",
          "import numpy as np\nimport pandas as pd\nfrom scipy import stats\nfrom scipy.stats import multivariate_normal\nfrom sklearn.preprocessing import PowerTransformer\n\nnp.random.seed(42)\n\n# Generate skewed data (e.g., transaction amounts)\nn_samples = 500\nraw_feature1 = np.random.exponential(scale=50, size=n_samples)  # Right-skewed\nraw_feature2 = np.random.lognormal(mean=3, sigma=0.5, size=n_samples)  # Log-normal\n\n# Add anomalies\nanomaly_f1 = np.array([500, 600, 550, 480, 520])\nanomaly_f2 = np.array([200, 250, 180, 220, 300])\nfeature1 = np.concatenate([raw_feature1, anomaly_f1])\nfeature2 = np.concatenate([raw_feature2, anomaly_f2])\n\nX = np.column_stack([feature1, feature2])\ny_true = np.array([0]*n_samples + [1]*5)\n\n# Without transformation\nmu_raw = np.mean(X, axis=0)\ncov_raw = np.cov(X.T)\nmvn_raw = multivariate_normal(mean=mu_raw, cov=cov_raw)\nprobs_raw = mvn_raw.pdf(X)\npreds_raw = (probs_raw < np.percentile(probs_raw, 2)).astype(int)\n\n# With Box-Cox transformation (PowerTransformer)\npt = PowerTransformer(method='yeo-johnson')\nX_transformed = pt.fit_transform(X)\n\nmu_trans = np.mean(X_transformed, axis=0)\ncov_trans = np.cov(X_transformed.T)\nmvn_trans = multivariate_normal(mean=mu_trans, cov=cov_trans)\nprobs_trans = mvn_trans.pdf(X_transformed)\npreds_trans = (probs_trans < np.percentile(probs_trans, 2)).astype(int)\n\n# Compare\ndef calc_metrics(preds, true):\n    tp = np.sum((preds == 1) & (true == 1))\n    fp = np.sum((preds == 1) & (true == 0))\n    fn = np.sum((preds == 0) & (true == 1))\n    prec = tp/(tp+fp) if (tp+fp) > 0 else 0\n    rec = tp/(tp+fn) if (tp+fn) > 0 else 0\n    f1 = 2*prec*rec/(prec+rec) if (prec+rec) > 0 else 0\n    return prec, rec, f1\n\nprec_r, rec_r, f1_r = calc_metrics(preds_raw, y_true)\nprec_t, rec_t, f1_t = calc_metrics(preds_trans, y_true)\n\nprint(\"Effect of Power Transformation on Gaussian Detection\")\nprint(\"=\" * 55)\nprint(f\"\\nSkewness before transform:\")\nprint(f\"  Feature 1: {stats.skew(X[:, 0]):.4f}\")\nprint(f\"  Feature 2: {stats.skew(X[:, 1]):.4f}\")\nprint(f\"\\nSkewness after transform:\")\nprint(f\"  Feature 1: {stats.skew(X_transformed[:, 0]):.4f}\")\nprint(f\"  Feature 2: {stats.skew(X_transformed[:, 1]):.4f}\")\nprint(f\"\\n{'Method':<20} {'Precision':<12} {'Recall':<10} {'F1':<8}\")\nprint(\"-\" * 55)\nprint(f\"{'Raw (no transform)':<20} {prec_r:<12.4f} {rec_r:<10.4f} {f1_r:<8.4f}\")\nprint(f\"{'Power Transform':<20} {prec_t:<12.4f} {rec_t:<10.4f} {f1_t:<8.4f}\")"
        ]
      ]
