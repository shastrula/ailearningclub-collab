          "python",
          "import numpy as np\nimport pandas as pd\nfrom scipy.stats import multivariate_normal\n\nnp.random.seed(42)\n\n# Generate 2D sensor data (temperature and pressure - correlated)\nn_normal = 500\nmean_normal = [70, 30]  # temperature, pressure\ncov_normal = [[10, 5], [5, 8]]  # correlated features\n\nX_normal = np.random.multivariate_normal(mean_normal, cov_normal, n_normal)\n\n# Anomalies: unusual combinations\nanomalies = np.array([\n    [90, 50], [95, 55], [40, 10], [45, 5], [92, 12],\n    [30, 45], [88, 48], [35, 8], [93, 52], [38, 6]\n])\n\nX = np.vstack([X_normal, anomalies])\ny_true = np.array([0]*n_normal + [1]*len(anomalies))\n\n# Fit multivariate Gaussian\nmu = np.mean(X, axis=0)\ncov = np.cov(X.T)\n\n# Calculate log-likelihood for each point\nmvn = multivariate_normal(mean=mu, cov=cov)\nlog_likelihoods = mvn.logpdf(X)\n\n# Set threshold using percentile on training data\nthreshold = np.percentile(log_likelihoods, 2)  # Bottom 2%\npredictions = (log_likelihoods < threshold).astype(int)\n\ntp = np.sum((predictions == 1) & (y_true == 1))\nfp = np.sum((predictions == 1) & (y_true == 0))\nfn = np.sum((predictions == 0) & (y_true == 1))\nprecision = tp / (tp + fp) if (tp + fp) > 0 else 0\nrecall = tp / (tp + fn) if (tp + fn) > 0 else 0\n\nprint(\"Multivariate Gaussian Anomaly Detection\")\nprint(\"=\" * 45)\nprint(f\"Fitted mean: [{mu[0]:.2f}, {mu[1]:.2f}]\")\nprint(f\"Covariance matrix:\")\nprint(f\"  [[{cov[0,0]:.2f}, {cov[0,1]:.2f}],\")\nprint(f\"   [{cov[1,0]:.2f}, {cov[1,1]:.2f}]]\")\nprint(f\"\\nLog-likelihood threshold: {threshold:.4f}\")\nprint(f\"Anomalies detected: {predictions.sum()}\")\nprint(f\"True Positives: {tp}\")\nprint(f\"False Positives: {fp}\")\nprint(f\"False Negatives: {fn}\")\nprint(f\"Precision: {precision:.4f}\")\nprint(f\"Recall: {recall:.4f}\")"
        ]
      ]
