          "python",
          "import numpy as np\nimport pandas as pd\nfrom scipy.spatial.distance import mahalanobis\n\nnp.random.seed(42)\n\n# Generate correlated 3D data (simulating manufacturing sensors)\nn_samples = 500\nmean = [100, 50, 75]\ncov = [[15, 5, 3],\n       [5, 10, 4],\n       [3, 4, 12]]\n\nX_normal = np.random.multivariate_normal(mean, cov, n_samples)\n\n# Add anomalies\nanomalies = np.array([\n    [130, 70, 95],   # All high\n    [70, 30, 55],    # All low\n    [100, 80, 75],   # Unusual correlation\n    [120, 30, 90],   # Conflicting features\n    [80, 65, 60],    # Unusual pattern\n])\n\nX = np.vstack([X_normal, anomalies])\ny_true = np.array([0]*n_samples + [1]*len(anomalies))\n\n# Calculate Mahalanobis distance\nmu = np.mean(X, axis=0)\ncov_matrix = np.cov(X.T)\ncov_inv = np.linalg.inv(cov_matrix)\n\ndistances = np.array([mahalanobis(x, mu, cov_inv) for x in X])\n\n# Chi-squared threshold for 3 degrees of freedom at 99.5%\nfrom scipy.stats import chi2\nthreshold = np.sqrt(chi2.ppf(0.995, df=3))\npredictions = (distances > threshold).astype(int)\n\ntp = np.sum((predictions == 1) & (y_true == 1))\nfp = np.sum((predictions == 1) & (y_true == 0))\nfn = np.sum((predictions == 0) & (y_true == 1))\nprecision = tp / (tp + fp) if (tp + fp) > 0 else 0\nrecall = tp / (tp + fn) if (tp + fn) > 0 else 0\n\nprint(\"Mahalanobis Distance Anomaly Detection\")\nprint(\"=\" * 45)\nprint(f\"Feature means: [{mu[0]:.1f}, {mu[1]:.1f}, {mu[2]:.1f}]\")\nprint(f\"Chi-squared threshold (df=3, 99.5%): {threshold:.4f}\")\nprint(f\"\\nDistance statistics:\")\nprint(f\"  Mean distance: {distances.mean():.4f}\")\nprint(f\"  Max distance: {distances.max():.4f}\")\nprint(f\"  Anomaly distances: {sorted(distances[-5:])}\")\nprint(f\"\\nResults:\")\nprint(f\"  Anomalies detected: {predictions.sum()}\")\nprint(f\"  True Positives: {tp}\")\nprint(f\"  False Positives: {fp}\")\nprint(f\"  Precision: {precision:.4f}\")\nprint(f\"  Recall: {recall:.4f}\")"
        ]
      ]
