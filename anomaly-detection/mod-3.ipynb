          "python",
          "import numpy as np\nfrom scipy.stats import multivariate_normal\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# Generate training data (only normal samples)\nn_train = 400\nmean = [50, 30]\ncov = [[8, 3], [3, 6]]\nX_train = np.random.multivariate_normal(mean, cov, n_train)\n\n# Generate validation data (with some anomalies)\nX_val_normal = np.random.multivariate_normal(mean, cov, 100)\nX_val_anomaly = np.random.uniform(low=[20, 5], high=[80, 55], size=(10, 2))\nX_val = np.vstack([X_val_normal, X_val_anomaly])\ny_val = np.array([0]*100 + [1]*10)\n\n# Fit model on training data\nmu = np.mean(X_train, axis=0)\ncov_fit = np.cov(X_train.T)\nmvn = multivariate_normal(mean=mu, cov=cov_fit)\n\n# Calculate probabilities for validation set\nval_probs = mvn.pdf(X_val)\n\n# Try different thresholds\nepsilons = np.logspace(-8, -1, 50)\nbest_f1 = 0\nbest_epsilon = None\n\nresults = []\nfor eps in epsilons:\n    preds = (val_probs < eps).astype(int)\n    f1 = f1_score(y_val, preds, zero_division=0)\n    results.append((eps, f1, preds.sum()))\n    if f1 > best_f1:\n        best_f1 = f1\n        best_epsilon = eps\n\nprint(\"Epsilon Selection via F1 Optimization\")\nprint(\"=\" * 50)\nprint(f\"{'Epsilon':<15} {'F1 Score':<10} {'Detected':<10}\")\nprint(\"-\" * 50)\nfor eps, f1, det in results[::10]:\n    print(f\"{eps:<15.2e} {f1:<10.4f} {det:<10}\")\n\nprint(f\"\\nBest epsilon: {best_epsilon:.2e}\")\nprint(f\"Best F1 score: {best_f1:.4f}\")\n\n# Final evaluation with best epsilon\nfinal_preds = (val_probs < best_epsilon).astype(int)\ntp = np.sum((final_preds == 1) & (y_val == 1))\nfp = np.sum((final_preds == 1) & (y_val == 0))\nfn = np.sum((final_preds == 0) & (y_val == 1))\nprint(f\"TP: {tp}, FP: {fp}, FN: {fn}\")"
        ]
      ]
    },
