          "python",
          "import numpy as np\nfrom sklearn.svm import OneClassSVM\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.neighbors import LocalOutlierFactor\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score, precision_score, recall_score\nfrom sklearn.datasets import make_blobs\nimport time\n\nnp.random.seed(42)\n\n# Create challenging dataset\nX_normal, _ = make_blobs(n_samples=900, centers=4, cluster_std=[0.5, 1.0, 1.5, 0.8], random_state=42)\nanomalies = np.vstack([\n    np.random.uniform(-8, 8, (30, 2)),  # Global anomalies\n    np.random.normal([2, 0], 0.3, (20, 2))  # Local anomalies between clusters\n])\nX = np.vstack([X_normal, anomalies])\ny_true = np.array([0]*900 + [1]*50)\nX_scaled = StandardScaler().fit_transform(X)\n\nresults = []\n\n# One-Class SVM\nstart = time.time()\nocsvm = OneClassSVM(kernel='rbf', gamma='scale', nu=0.05)\nocsvm.fit(X_scaled)\ny_pred = (ocsvm.predict(X_scaled) == -1).astype(int)\nt_svm = time.time() - start\nresults.append(('One-Class SVM', f1_score(y_true, y_pred), \n                precision_score(y_true, y_pred, zero_division=0),\n                recall_score(y_true, y_pred), t_svm))\n\n# Isolation Forest\nstart = time.time()\niforest = IsolationForest(n_estimators=200, contamination=0.05, random_state=42)\ny_pred = (iforest.fit_predict(X_scaled) == -1).astype(int)\nt_if = time.time() - start\nresults.append(('Isolation Forest', f1_score(y_true, y_pred),\n                precision_score(y_true, y_pred, zero_division=0),\n                recall_score(y_true, y_pred), t_if))\n\n# LOF\nstart = time.time()\nlof = LocalOutlierFactor(n_neighbors=20, contamination=0.05)\ny_pred = (lof.fit_predict(X_scaled) == -1).astype(int)\nt_lof = time.time() - start\nresults.append(('LOF', f1_score(y_true, y_pred),\n                precision_score(y_true, y_pred, zero_division=0),\n                recall_score(y_true, y_pred), t_lof))\n\nprint(\"Method Comparison on Multi-Cluster Data\")\nprint(\"=\" * 70)\nprint(f\"{'Method':<18} {'F1':<8} {'Precision':<12} {'Recall':<10} {'Time (s)':<10}\")\nprint(\"-\" * 70)\nfor name, f1, prec, rec, t in results:\n    print(f\"{name:<18} {f1:<8.4f} {prec:<12.4f} {rec:<10.4f} {t:<10.4f}\")"
        ]
