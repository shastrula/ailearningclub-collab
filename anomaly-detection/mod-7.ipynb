      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.svm import OneClassSVM\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import classification_report, f1_score\n\nnp.random.seed(42)\n\n# Generate normal data (manufacturing measurements)\nn_normal = 500\nX_normal = np.column_stack([\n    np.random.normal(50, 3, n_normal),   # Length (mm)\n    np.random.normal(25, 1.5, n_normal)  # Width (mm)\n])\n\n# Anomalies (defective parts)\nanomalies = np.array([\n    [60, 30], [40, 20], [62, 32], [38, 18], [58, 28],\n    [42, 21], [55, 31], [43, 19], [61, 33], [39, 17]\n])\n\nX = np.vstack([X_normal, anomalies])\ny_true = np.array([0]*n_normal + [1]*len(anomalies))\n\n# Scale features\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\n# Train One-Class SVM\nocsvm = OneClassSVM(kernel='rbf', gamma='scale', nu=0.05)\nocsvm.fit(X_scaled)\n\n# Predict\ny_pred_raw = ocsvm.predict(X_scaled)\ny_pred = (y_pred_raw == -1).astype(int)\n\n# Get decision function scores\nscores = -ocsvm.decision_function(X_scaled)\n\ntp = np.sum((y_pred == 1) & (y_true == 1))\nfp = np.sum((y_pred == 1) & (y_true == 0))\nfn = np.sum((y_pred == 0) & (y_true == 1))\nprecision = tp / (tp + fp) if (tp + fp) > 0 else 0\nrecall = tp / (tp + fn) if (tp + fn) > 0 else 0\n\nprint(\"One-Class SVM (RBF Kernel)\")\nprint(\"=\" * 45)\nprint(f\"Parameters: kernel=rbf, gamma=scale, nu=0.05\")\nprint(f\"Support vectors: {ocsvm.n_support_[0]}\")\nprint(f\"\\nScore distribution:\")\nprint(f\"  Normal mean: {scores[y_true==0].mean():.4f}\")\nprint(f\"  Anomaly mean: {scores[y_true==1].mean():.4f}\")\nprint(f\"\\nResults:\")\nprint(f\"  Detected anomalies: {y_pred.sum()}\")\nprint(f\"  True Positives: {tp}\")\nprint(f\"  False Positives: {fp}\")\nprint(f\"  False Negatives: {fn}\")\nprint(f\"  Precision: {precision:.4f}\")\nprint(f\"  Recall: {recall:.4f}\")\nprint(f\"  F1 Score: {2*precision*recall/(precision+recall) if (precision+recall)>0 else 0:.4f}\")"
        ]
      ]
    },
