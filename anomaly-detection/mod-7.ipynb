          "python",
          "import numpy as np\nfrom sklearn.svm import OneClassSVM\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import classification_report\n\nnp.random.seed(42)\n\n# Training: only normal network traffic\nn_train = 1000\nX_train = np.column_stack([\n    np.random.normal(500, 100, n_train),    # bytes_sent\n    np.random.normal(1000, 200, n_train),   # bytes_received\n    np.random.normal(50, 10, n_train),      # packets_per_sec\n    np.random.normal(30, 5, n_train)        # connection_duration\n])\n\n# Test: mix of normal and attack traffic\nn_test_normal = 200\nX_test_normal = np.column_stack([\n    np.random.normal(500, 100, n_test_normal),\n    np.random.normal(1000, 200, n_test_normal),\n    np.random.normal(50, 10, n_test_normal),\n    np.random.normal(30, 5, n_test_normal)\n])\n\n# Attack traffic (DDoS-like: high packets, high bytes)\nn_attacks = 30\nX_test_attack = np.column_stack([\n    np.random.normal(2000, 200, n_attacks),   # HIGH bytes_sent\n    np.random.normal(100, 50, n_attacks),     # LOW bytes_received\n    np.random.normal(500, 50, n_attacks),     # HIGH packets\n    np.random.normal(2, 1, n_attacks)         # SHORT duration\n])\n\nX_test = np.vstack([X_test_normal, X_test_attack])\ny_test = np.array([0]*n_test_normal + [1]*n_attacks)\n\n# Scale using training statistics\nscaler = StandardScaler()\nX_train_scaled = scaler.fit_transform(X_train)\nX_test_scaled = scaler.transform(X_test)\n\n# Train One-Class SVM (novelty detection)\nocsvm = OneClassSVM(kernel='rbf', gamma='scale', nu=0.03)\nocsvm.fit(X_train_scaled)\n\n# Predict on test data\ny_pred = (ocsvm.predict(X_test_scaled) == -1).astype(int)\n\nprint(\"One-Class SVM - Network Intrusion Detection\")\nprint(\"=\" * 50)\nprint(f\"Training samples (normal only): {n_train}\")\nprint(f\"Test samples: {len(X_test)} ({n_test_normal} normal, {n_attacks} attacks)\")\nprint(f\"\\nClassification Report:\")\nprint(classification_report(y_test, y_pred, target_names=['Normal', 'Attack']))"
        ]
