          "python",
          "import numpy as np\nfrom sklearn.svm import OneClassSVM\nfrom sklearn.linear_model import SGDOneClassSVM\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score\nimport time\n\nnp.random.seed(42)\n\n# Larger dataset\nsizes = [500, 2000, 5000]\nprint(\"Scalability: OneClassSVM vs SGDOneClassSVM\")\nprint(\"=\" * 65)\nprint(f\"{'Size':<8} {'SVM F1':<10} {'SVM Time':<12} {'SGD F1':<10} {'SGD Time':<12}\")\nprint(\"-\" * 65)\n\nfor n in sizes:\n    X = np.random.normal(0, 1, (n, 10))\n    anomalies = np.random.uniform(-5, 5, (int(n*0.05), 10))\n    X_all = np.vstack([X, anomalies])\n    y_true = np.array([0]*n + [1]*len(anomalies))\n    X_scaled = StandardScaler().fit_transform(X_all)\n    \n    # Standard One-Class SVM\n    start = time.time()\n    ocsvm = OneClassSVM(kernel='rbf', nu=0.05)\n    y_pred = (ocsvm.fit_predict(X_scaled) == -1).astype(int)\n    t_svm = time.time() - start\n    f1_svm = f1_score(y_true, y_pred, zero_division=0)\n    \n    # SGD One-Class SVM\n    start = time.time()\n    sgd = SGDOneClassSVM(nu=0.05, random_state=42)\n    sgd.fit(X_scaled)\n    y_pred_sgd = (sgd.predict(X_scaled) == -1).astype(int)\n    t_sgd = time.time() - start\n    f1_sgd = f1_score(y_true, y_pred_sgd, zero_division=0)\n    \n    print(f\"{n:<8} {f1_svm:<10.4f} {t_svm:<12.4f} {f1_sgd:<10.4f} {t_sgd:<12.4f}\")"
        ]
      ]
