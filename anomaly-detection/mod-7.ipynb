          "python",
          "import numpy as np\nfrom sklearn.svm import OneClassSVM\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# Non-linear data pattern (ring-shaped normal data)\ntheta = np.random.uniform(0, 2*np.pi, 400)\nr = np.random.normal(5, 0.5, 400)\nX_normal = np.column_stack([r * np.cos(theta), r * np.sin(theta)])\n\n# Anomalies: center and far outside\nanomalies = np.vstack([\n    np.random.normal(0, 0.5, (10, 2)),  # Inside the ring\n    np.random.uniform(-10, 10, (10, 2))  # Outside\n])\n\nX = np.vstack([X_normal, anomalies])\ny_true = np.array([0]*400 + [1]*20)\nX_scaled = StandardScaler().fit_transform(X)\n\nprint(\"Kernel Comparison on Ring-Shaped Data\")\nprint(\"=\" * 60)\nprint(f\"{'Kernel':<15} {'Params':<25} {'F1':<8} {'Detected':<10}\")\nprint(\"-\" * 60)\n\nconfigs = [\n    ('linear', {}),\n    ('poly', {'degree': 2}),\n    ('poly', {'degree': 3}),\n    ('rbf', {'gamma': 'scale'}),\n    ('rbf', {'gamma': 0.1}),\n    ('rbf', {'gamma': 1.0}),\n    ('sigmoid', {'gamma': 'scale'}),\n]\n\nfor kernel, params in configs:\n    try:\n        ocsvm = OneClassSVM(kernel=kernel, nu=0.05, **params)\n        ocsvm.fit(X_scaled)\n        y_pred = (ocsvm.predict(X_scaled) == -1).astype(int)\n        f1 = f1_score(y_true, y_pred, zero_division=0)\n        param_str = str(params) if params else '-'\n        print(f\"{kernel:<15} {param_str:<25} {f1:<8.4f} {y_pred.sum():<10}\")\n    except Exception as e:\n        print(f\"{kernel:<15} {'ERROR':<25}\")"
        ]
