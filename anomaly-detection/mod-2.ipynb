          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Simulate transaction amounts\nnormal_transactions = np.random.exponential(scale=50, size=500)\nfraudulent = np.array([2500, 3200, 4100, 2800, 5000, 3500, 2900])\nall_transactions = np.concatenate([normal_transactions, fraudulent])\n\n# IQR method\nQ1 = np.percentile(all_transactions, 25)\nQ3 = np.percentile(all_transactions, 75)\nIQR = Q3 - Q1\n\nlower_bound = Q1 - 1.5 * IQR\nupper_bound = Q3 + 1.5 * IQR\n\noutliers = (all_transactions < lower_bound) | (all_transactions > upper_bound)\n\nprint(\"IQR-Based Outlier Detection\")\nprint(\"=\" * 40)\nprint(f\"Q1 (25th percentile): ${Q1:.2f}\")\nprint(f\"Q3 (75th percentile): ${Q3:.2f}\")\nprint(f\"IQR: ${IQR:.2f}\")\nprint(f\"Lower bound: ${lower_bound:.2f}\")\nprint(f\"Upper bound: ${upper_bound:.2f}\")\nprint(f\"\\nTotal transactions: {len(all_transactions)}\")\nprint(f\"Outliers detected: {outliers.sum()}\")\nprint(f\"\\nOutlier values (top 10 by amount):\")\noutlier_values = sorted(all_transactions[outliers], reverse=True)[:10]\nfor val in outlier_values:\n    print(f\"  ${val:.2f}\")"
        ]
      ]
