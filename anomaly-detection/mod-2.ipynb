          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Generate sensor data with known anomalies\nnormal = np.random.normal(loc=100, scale=10, size=500)\nanomalies_high = np.array([180, 175, 190, 165, 200])\nanomalies_low = np.array([20, 25, 15, 30, 10])\ndata = np.concatenate([normal, anomalies_high, anomalies_low])\ntrue_labels = np.array([0]*500 + [1]*5 + [1]*5)\n\n# Method 1: Z-Score\nmean, std = np.mean(data), np.std(data)\nz_detected = np.abs((data - mean) / std) > 3\n\n# Method 2: Modified Z-Score\nmedian = np.median(data)\nmad = np.median(np.abs(data - median))\nmz_detected = (0.6745 * np.abs(data - median) / mad) > 3.5\n\n# Method 3: IQR\nQ1, Q3 = np.percentile(data, 25), np.percentile(data, 75)\nIQR = Q3 - Q1\niqr_detected = (data < Q1 - 1.5*IQR) | (data > Q3 + 1.5*IQR)\n\n# Evaluate each method\ndef evaluate(predicted, actual):\n    tp = np.sum((predicted == 1) & (actual == 1))\n    fp = np.sum((predicted == 1) & (actual == 0))\n    fn = np.sum((predicted == 0) & (actual == 1))\n    precision = tp / (tp + fp) if (tp + fp) > 0 else 0\n    recall = tp / (tp + fn) if (tp + fn) > 0 else 0\n    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0\n    return tp, fp, fn, precision, recall, f1\n\nresults = {}\nfor name, detected in [(\"Z-Score\", z_detected), (\"Modified Z\", mz_detected), (\"IQR\", iqr_detected)]:\n    tp, fp, fn, prec, rec, f1 = evaluate(detected.astype(int), true_labels)\n    results[name] = {'TP': tp, 'FP': fp, 'FN': fn, \n                     'Precision': prec, 'Recall': rec, 'F1': f1}\n\nprint(\"Method Comparison on Sensor Data\")\nprint(\"=\" * 60)\nprint(f\"{'Method':<12} {'TP':>4} {'FP':>4} {'FN':>4} {'Precision':>10} {'Recall':>8} {'F1':>6}\")\nprint(\"-\" * 60)\nfor method, metrics in results.items():\n    print(f\"{method:<12} {metrics['TP']:>4} {metrics['FP']:>4} {metrics['FN']:>4} \"\n          f\"{metrics['Precision']:>10.4f} {metrics['Recall']:>8.4f} {metrics['F1']:>6.4f}\")"
        ]
