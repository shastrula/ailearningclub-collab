          "python",
          "import numpy as np\nfrom scipy import stats\n\nnp.random.seed(42)\n\n# Dataset with a potential outlier\ndata = np.array([45, 48, 52, 49, 47, 51, 50, 48, 53, 46, 49, 120])\n\ndef grubbs_test(data, alpha=0.05):\n    \"\"\"Perform Grubbs' test for a single outlier.\"\"\"\n    n = len(data)\n    mean = np.mean(data)\n    std = np.std(data, ddof=1)\n    \n    # Find the point farthest from mean\n    abs_deviations = np.abs(data - mean)\n    max_idx = np.argmax(abs_deviations)\n    G = abs_deviations[max_idx] / std\n    \n    # Critical value\n    t_critical = stats.t.ppf(1 - alpha / (2 * n), n - 2)\n    G_critical = ((n - 1) / np.sqrt(n)) * np.sqrt(t_critical**2 / (n - 2 + t_critical**2))\n    \n    is_outlier = G > G_critical\n    \n    return {\n        'test_statistic': G,\n        'critical_value': G_critical,\n        'suspect_value': data[max_idx],\n        'suspect_index': max_idx,\n        'is_outlier': is_outlier\n    }\n\nresult = grubbs_test(data, alpha=0.05)\n\nprint(\"Grubbs' Test for Outliers\")\nprint(\"=\" * 40)\nprint(f\"Data: {data}\")\nprint(f\"Mean: {np.mean(data):.2f}\")\nprint(f\"Std Dev: {np.std(data, ddof=1):.2f}\")\nprint(f\"\\nSuspect value: {result['suspect_value']}\")\nprint(f\"Test statistic (G): {result['test_statistic']:.4f}\")\nprint(f\"Critical value: {result['critical_value']:.4f}\")\nprint(f\"Is outlier (alpha=0.05): {result['is_outlier']}\")"
        ]
      ]
