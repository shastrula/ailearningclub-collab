          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Generate synthetic sensor readings with anomalies\nnormal_data = np.random.normal(loc=50, scale=5, size=200)\nanomalies = np.array([85, 90, 12, 8, 95])  # Injected anomalies\ndata = np.concatenate([normal_data, anomalies])\n\n# Shuffle to simulate real-world data\nindices = np.arange(len(data))\nnp.random.shuffle(indices)\ndata = data[indices]\n\n# Calculate Z-scores\nmean = np.mean(data)\nstd = np.std(data)\nz_scores = np.abs((data - mean) / std)\n\n# Detect anomalies (|Z| > 3)\nthreshold = 3\nanomaly_mask = z_scores > threshold\n\nprint(\"Z-Score Anomaly Detection\")\nprint(\"=\" * 40)\nprint(f\"Mean: {mean:.2f}\")\nprint(f\"Std Dev: {std:.2f}\")\nprint(f\"Threshold: {threshold} standard deviations\")\nprint(f\"Total points: {len(data)}\")\nprint(f\"Anomalies detected: {anomaly_mask.sum()}\")\nprint(f\"\\nDetected anomaly values:\")\nprint(f\"  {sorted(data[anomaly_mask])}\")\nprint(f\"\\nZ-scores of detected anomalies:\")\nfor val, z in zip(data[anomaly_mask], z_scores[anomaly_mask]):\n    print(f\"  Value: {val:.2f}, Z-score: {z:.2f}\")"
        ]
