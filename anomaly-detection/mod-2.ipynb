          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Data with extreme outliers\nnormal_data = np.random.normal(loc=50, scale=5, size=200)\nanomalies = np.array([85, 90, 12, 8, 95, 150])  # Including extreme value\ndata = np.concatenate([normal_data, anomalies])\n\n# Standard Z-score\nmean = np.mean(data)\nstd = np.std(data)\nz_scores = np.abs((data - mean) / std)\n\n# Modified Z-score using MAD\nmedian = np.median(data)\nmad = np.median(np.abs(data - median))\nmodified_z_scores = 0.6745 * np.abs(data - median) / mad\n\n# Compare detection\nz_anomalies = z_scores > 3\nmz_anomalies = modified_z_scores > 3.5\n\nprint(\"Standard vs Modified Z-Score Comparison\")\nprint(\"=\" * 50)\nprint(f\"\\nStandard Z-Score (threshold=3):\")\nprint(f\"  Mean: {mean:.2f}, Std: {std:.2f}\")\nprint(f\"  Anomalies detected: {z_anomalies.sum()}\")\nprint(f\"  Values: {sorted(data[z_anomalies])}\")\nprint(f\"\\nModified Z-Score (threshold=3.5):\")\nprint(f\"  Median: {median:.2f}, MAD: {mad:.2f}\")\nprint(f\"  Anomalies detected: {mz_anomalies.sum()}\")\nprint(f\"  Values: {sorted(data[mz_anomalies])}\")"
        ]
