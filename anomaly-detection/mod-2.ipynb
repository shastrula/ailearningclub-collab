          "python",
          "import numpy as np\nfrom scipy import stats\n\nnp.random.seed(42)\n\ndata = np.array([45, 48, 52, 49, 47, 51, 50, 48, 53, 46, 49, 120, 5, 110])\n\ndef grubbs_test(data, alpha=0.05):\n    n = len(data)\n    mean = np.mean(data)\n    std = np.std(data, ddof=1)\n    abs_deviations = np.abs(data - mean)\n    max_idx = np.argmax(abs_deviations)\n    G = abs_deviations[max_idx] / std\n    t_critical = stats.t.ppf(1 - alpha / (2 * n), n - 2)\n    G_critical = ((n - 1) / np.sqrt(n)) * np.sqrt(t_critical**2 / (n - 2 + t_critical**2))\n    return G > G_critical, data[max_idx], max_idx\n\ndef iterative_grubbs(data, alpha=0.05):\n    outliers = []\n    clean_data = data.copy()\n    \n    while len(clean_data) > 2:\n        is_outlier, value, idx = grubbs_test(clean_data, alpha)\n        if is_outlier:\n            outliers.append(value)\n            clean_data = np.delete(clean_data, idx)\n        else:\n            break\n    \n    return outliers, clean_data\n\noutliers, clean = iterative_grubbs(data)\n\nprint(\"Iterative Grubbs' Test\")\nprint(\"=\" * 40)\nprint(f\"Original data: {data}\")\nprint(f\"Original size: {len(data)}\")\nprint(f\"\\nOutliers found: {outliers}\")\nprint(f\"Clean data: {clean}\")\nprint(f\"Clean data size: {len(clean)}\")\nprint(f\"Clean mean: {np.mean(clean):.2f}\")\nprint(f\"Clean std: {np.std(clean, ddof=1):.2f}\")"
        ]
      ]
    },
