          "python",
          "import numpy as np\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# When you have SOME labels\nX_normal, _ = make_blobs(n_samples=1900, centers=3, cluster_std=1.0, random_state=42)\nX_anomaly = np.random.uniform(-8, 8, (100, 2))\nX = np.vstack([X_normal, X_anomaly])\ny = np.array([0]*1900 + [1]*100)\nX_scaled = StandardScaler().fit_transform(X)\n\n# 5-fold cross-validation\nkf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n\ncontamination_range = np.arange(0.02, 0.15, 0.01)\ncv_results = {}\n\nfor cont in contamination_range:\n    fold_scores = []\n    for train_idx, val_idx in kf.split(X_scaled, y):\n        X_train_fold = X_scaled[train_idx]\n        y_val_fold = y[val_idx]\n        X_val_fold = X_scaled[val_idx]\n        \n        clf = IsolationForest(contamination=cont, random_state=42)\n        clf.fit(X_train_fold)\n        pred = (clf.predict(X_val_fold) == -1).astype(int)\n        f1 = f1_score(y_val_fold, pred, zero_division=0)\n        fold_scores.append(f1)\n    \n    cv_results[cont] = (np.mean(fold_scores), np.std(fold_scores))\n\nbest_cont = max(cv_results, key=lambda x: cv_results[x][0])\n\nprint(\"Cross-Validation for Contamination Selection\")\nprint(\"=\" * 55)\nprint(f\"{'Contamination':<15} {'Mean F1':<10} {'Std F1':<10}\")\nprint(\"-\" * 55)\nfor cont in sorted(cv_results.keys()):\n    mean_f1, std_f1 = cv_results[cont]\n    marker = \" <-- BEST\" if cont == best_cont else \"\"\n    if cont % 0.02 < 0.001 or cont == best_cont:\n        print(f\"{cont:<15.3f} {mean_f1:<10.4f} {std_f1:<10.4f}{marker}\")\n\nprint(f\"\\nBest contamination: {best_cont:.3f}\")\nprint(f\"Best CV F1: {cv_results[best_cont][0]:.4f} \u00b1 {cv_results[best_cont][1]:.4f}\")"
        ]
      ]
