          "python",
          "import numpy as np\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# Dataset\nX_normal, _ = make_blobs(n_samples=1900, centers=3, cluster_std=1.0, random_state=42)\nX_anomaly = np.random.uniform(-8, 8, (100, 2))\nX = np.vstack([X_normal, X_anomaly])\ny = np.array([0]*1900 + [1]*100)\n\n# Split: use validation set for tuning\nX_train, X_val, y_train, y_val = train_test_split(X, y, test_size=0.3, random_state=42, stratify=y)\nX_scaled_train = StandardScaler().fit_transform(X_train)\nX_scaled_val = StandardScaler().fit_transform(X_val)\n\n# Grid search over contamination values\nprint(\"Validation-Based Contamination Selection\")\nprint(\"=\" * 55)\nprint(f\"Train size: {len(X_train)}, Validation size: {len(X_val)}\")\nprint(f\"True anomaly rate: {y.mean():.3f}\")\nprint(f\"\\n{'Contamination':<15} {'Val F1':<10} {'Val Precision':<15} {'Val Recall':<12}\")\nprint(\"-\" * 55)\n\nbest_f1 = 0\nbest_cont = None\ncandidates = np.arange(0.01, 0.20, 0.01)\n\nfor cont in candidates:\n    clf = IsolationForest(n_estimators=200, contamination=cont, random_state=42)\n    clf.fit(X_scaled_train)\n    y_pred_val = (clf.predict(X_scaled_val) == -1).astype(int)\n    \n    f1 = f1_score(y_val, y_pred_val, zero_division=0)\n    prec = f1_score(y_val, y_pred_val, zero_division=0)\n    from sklearn.metrics import precision_score, recall_score\n    p = precision_score(y_val, y_pred_val, zero_division=0)\n    r = recall_score(y_val, y_pred_val, zero_division=0)\n    \n    if f1 > best_f1:\n        best_f1 = f1\n        best_cont = cont\n    \n    if cont in [0.01, 0.03, 0.05, 0.07, 0.10, 0.15]:\n        print(f\"{cont:<15.2f} {f1:<10.4f} {p:<15.4f} {r:<12.4f}\")\n\nprint(f\"\\nOptimal contamination: {best_cont:.3f}\")\nprint(f\"Best validation F1: {best_f1:.4f}\")"
