          "python",
          "import numpy as np\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.neighbors import LocalOutlierFactor\nfrom sklearn.svm import OneClassSVM\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import f1_score, precision_score, recall_score\n\nnp.random.seed(42)\n\n# Dataset with known 5% anomaly rate\nX_normal, _ = make_blobs(n_samples=950, centers=3, cluster_std=1.0, random_state=42)\nX_anomaly = np.random.uniform(-8, 8, (50, 2))\nX = np.vstack([X_normal, X_anomaly])\ny_true = np.array([0]*950 + [1]*50)\nX_scaled = StandardScaler().fit_transform(X)\ntrue_contamination = y_true.mean()\n\nprint(\"Contamination Sensitivity Analysis\")\nprint(\"=\" * 70)\nprint(f\"True anomaly rate: {true_contamination:.3f} ({y_true.sum()} of {len(y_true)})\")\nprint(f\"\\n{'Contamination':<15} {'IF F1':<8} {'IF Prec':<9} {'IF Rec':<8} {'LOF F1':<8} {'LOF Prec':<9} {'LOF Rec':<8}\")\nprint(\"-\" * 70)\n\nfor cont in [0.01, 0.02, 0.03, 0.05, 0.07, 0.10, 0.15, 0.20]:\n    # Isolation Forest\n    clf_if = IsolationForest(contamination=cont, random_state=42)\n    pred_if = (clf_if.fit_predict(X_scaled) == -1).astype(int)\n    f1_if = f1_score(y_true, pred_if, zero_division=0)\n    prec_if = precision_score(y_true, pred_if, zero_division=0)\n    rec_if = recall_score(y_true, pred_if, zero_division=0)\n    \n    # LOF\n    lof = LocalOutlierFactor(contamination=cont, n_neighbors=20)\n    pred_lof = (lof.fit_predict(X_scaled) == -1).astype(int)\n    f1_lof = f1_score(y_true, pred_lof, zero_division=0)\n    prec_lof = precision_score(y_true, pred_lof, zero_division=0)\n    rec_lof = recall_score(y_true, pred_lof, zero_division=0)\n    \n    print(f\"{cont:<15.3f} {f1_if:<8.4f} {prec_if:<9.4f} {rec_if:<8.4f} \"\n          f\"{f1_lof:<8.4f} {prec_lof:<9.4f} {rec_lof:<8.4f}\")"
        ]
      ]
