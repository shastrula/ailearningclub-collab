          "python",
          "import numpy as np\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.datasets import make_blobs\n\nnp.random.seed(42)\n\n# Unlabeled dataset (we know it has ~5% anomalies but pretend we don't)\nX_normal, _ = make_blobs(n_samples=950, centers=3, cluster_std=1.0, random_state=42)\nX_anomaly = np.random.uniform(-8, 8, (50, 2))\nX = np.vstack([X_normal, X_anomaly])\nX_scaled = StandardScaler().fit_transform(X)\n\n# Strategy 1: Score distribution analysis (look for bimodal distribution)\nclf = IsolationForest(n_estimators=200, contamination='auto', random_state=42)\nclf.fit(X_scaled)\nscores = -clf.decision_function(X_scaled)\n\n# Find natural break in score distribution\nsorted_scores = np.sort(scores)\nscore_diffs = np.diff(sorted_scores)\n# Largest gap suggests natural separation\ngap_idx = np.argmax(score_diffs[-50:]) + (len(score_diffs) - 50)\nestimated_contamination_gap = 1 - (gap_idx + 1) / len(scores)\n\n# Strategy 2: Knee/elbow method on sorted scores\n# Find where scores start increasing rapidly\npercentiles = np.arange(90, 100, 0.5)\nscore_at_pctl = [np.percentile(scores, p) for p in percentiles]\nsecond_diff = np.diff(np.diff(score_at_pctl))\nelbow_idx = np.argmax(second_diff) + 90\nestimated_contamination_elbow = (100 - elbow_idx) / 100\n\n# Strategy 3: Domain knowledge bounds\nprint(\"Estimating Contamination Without Labels\")\nprint(\"=\" * 55)\nprint(f\"\\nStrategy 1: Score Gap Analysis\")\nprint(f\"  Estimated contamination: {estimated_contamination_gap:.3f}\")\nprint(f\"\\nStrategy 2: Elbow Method\")\nprint(f\"  Estimated contamination: {estimated_contamination_elbow:.3f}\")\nprint(f\"\\nStrategy 3: Domain Knowledge\")\nprint(f\"  Industry benchmarks:\")\nprint(f\"    Credit card fraud: 0.001 - 0.01\")\nprint(f\"    Network intrusion: 0.01 - 0.05\")\nprint(f\"    Manufacturing defects: 0.01 - 0.03\")\nprint(f\"    Sensor failures: 0.005 - 0.02\")\nprint(f\"\\nScore distribution percentiles:\")\nfor p in [90, 95, 97, 99, 99.5]:\n    print(f\"  {p}th percentile: {np.percentile(scores, p):.4f}\")"
        ]
      ]
