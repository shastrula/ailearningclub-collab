          "python",
          "import numpy as np\n\nnp.random.seed(42)\n\nclass AdaptiveDetector:\n    \"\"\"Detector that adapts to concept drift by forgetting old data.\"\"\"\n    \n    def __init__(self, forget_factor=0.995, threshold_sigma=3.5):\n        self.forget_factor = forget_factor\n        self.threshold_sigma = threshold_sigma\n        self.weighted_sum = 0\n        self.weighted_sum_sq = 0\n        self.weight_total = 0\n        self.anomalies = []\n        self.t = 0\n    \n    def update(self, x):\n        self.t += 1\n        \n        # Decay old statistics\n        self.weighted_sum *= self.forget_factor\n        self.weighted_sum_sq *= self.forget_factor\n        self.weight_total *= self.forget_factor\n        \n        # Add new observation\n        self.weighted_sum += x\n        self.weighted_sum_sq += x**2\n        self.weight_total += 1.0\n        \n        if self.t < 30:\n            return False\n        \n        mean = self.weighted_sum / self.weight_total\n        var = (self.weighted_sum_sq / self.weight_total) - mean**2\n        std = np.sqrt(max(var, 0.001))\n        \n        z = abs(x - mean) / std\n        is_anomaly = z > self.threshold_sigma\n        \n        if is_anomaly:\n            self.anomalies.append({'t': self.t, 'value': x, 'z': z, 'mean': mean})\n        \n        return is_anomaly\n\n# Data with concept drift + anomalies\ndata = np.concatenate([\n    np.random.normal(50, 3, 200),\n    np.linspace(50, 80, 100) + np.random.normal(0, 3, 100),  # Gradual drift\n    np.random.normal(80, 3, 200),\n    np.random.normal(80, 3, 200),\n])\n\n# Point anomalies\ndata[150] = 80   # Before drift\ndata[400] = 50   # After drift (would be normal in old regime)\ndata[600] = 110  # True anomaly\n\n# Compare adaptive vs static\nadaptive = AdaptiveDetector(forget_factor=0.99, threshold_sigma=3.5)\nstatic = OnlineAnomalyDetector(threshold_sigma=3.5, warmup=50)\n\nfor x in data:\n    adaptive.update(x)\n    static.update(x)\n\nprint(\"Concept Drift Handling: Adaptive vs Static\")\nprint(\"=\" * 55)\nprint(f\"Data: 200 pts at mean=50, drift to mean=80, then 400 pts at mean=80\")\nprint(f\"\\nAdaptive detector (forget_factor=0.99):\")\nprint(f\"  Anomalies: {len(adaptive.anomalies)}\")\nfor a in adaptive.anomalies[:5]:\n    print(f\"    t={a['t']}: value={a['value']:.1f}, z={a['z']:.2f}, running_mean={a['mean']:.1f}\")\n\nprint(f\"\\nStatic detector (all-time stats):\")\nprint(f\"  Anomalies: {len(static.anomalies)}\")\nfor a in static.anomalies[:5]:\n    print(f\"    t={a['index']}: value={a['value']:.1f}, z={a['z_score']:.2f}\")"
        ]
