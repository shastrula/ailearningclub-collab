          "python",
          "import numpy as np\nfrom collections import deque\n\nnp.random.seed(42)\n\nclass SlidingWindowDetector:\n    \"\"\"Anomaly detector using a fixed-size sliding window.\"\"\"\n    \n    def __init__(self, window_size=100, threshold_sigma=3.0):\n        self.window = deque(maxlen=window_size)\n        self.threshold_sigma = threshold_sigma\n        self.anomalies = []\n        self.t = 0\n    \n    def update(self, x):\n        self.t += 1\n        \n        if len(self.window) < self.window.maxlen:\n            self.window.append(x)\n            return False\n        \n        window_array = np.array(self.window)\n        mean = window_array.mean()\n        std = window_array.std()\n        \n        z_score = abs(x - mean) / std if std > 0 else 0\n        is_anomaly = z_score > self.threshold_sigma\n        \n        if is_anomaly:\n            self.anomalies.append({'t': self.t, 'value': x, 'z': z_score,\n                                   'window_mean': mean, 'window_std': std})\n        \n        # Add to window AFTER checking (don't include anomaly in window)\n        if not is_anomaly:\n            self.window.append(x)\n        \n        return is_anomaly\n\n# Non-stationary data: mean shifts over time\ndata = np.concatenate([\n    np.random.normal(50, 3, 300),   # Regime 1\n    np.random.normal(70, 3, 300),   # Regime 2 (gradual shift handled by window)\n    np.random.normal(90, 3, 300),   # Regime 3\n])\n\n# Inject point anomalies\nanomaly_idx = [100, 250, 450, 600, 750, 850]\nfor idx in anomaly_idx:\n    data[idx] += np.random.choice([-1, 1]) * 30\n\ndetector = SlidingWindowDetector(window_size=100, threshold_sigma=3.0)\nfor value in data:\n    detector.update(value)\n\nprint(\"Sliding Window Anomaly Detection\")\nprint(\"=\" * 55)\nprint(f\"Window size: 100\")\nprint(f\"Total points processed: {detector.t}\")\nprint(f\"Anomalies detected: {len(detector.anomalies)}\")\nprint(f\"\\nDetected anomalies:\")\nfor a in detector.anomalies[:8]:\n    print(f\"  t={a['t']}: value={a['value']:.1f}, z={a['z']:.2f}, \"\n          f\"window_mean={a['window_mean']:.1f}\")"
        ]
      ]
