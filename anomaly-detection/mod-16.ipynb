          "python",
          "import numpy as np\n\nnp.random.seed(42)\n\nclass EWMADetector:\n    \"\"\"EWMA-based anomaly detector with adaptive threshold.\"\"\"\n    \n    def __init__(self, alpha=0.1, threshold_multiplier=3.0):\n        self.alpha = alpha\n        self.threshold_multiplier = threshold_multiplier\n        self.ewma_mean = None\n        self.ewma_var = None\n        self.anomalies = []\n        self.t = 0\n    \n    def update(self, x):\n        self.t += 1\n        \n        if self.ewma_mean is None:\n            self.ewma_mean = x\n            self.ewma_var = 0.0\n            return False\n        \n        # Update EWMA statistics\n        residual = x - self.ewma_mean\n        self.ewma_mean = self.alpha * x + (1 - self.alpha) * self.ewma_mean\n        self.ewma_var = self.alpha * residual**2 + (1 - self.alpha) * self.ewma_var\n        \n        ewma_std = np.sqrt(self.ewma_var)\n        threshold = self.threshold_multiplier * ewma_std\n        \n        is_anomaly = abs(residual) > threshold and self.t > 20\n        \n        if is_anomaly:\n            self.anomalies.append({\n                't': self.t, 'value': x, 'residual': residual,\n                'threshold': threshold, 'ewma_mean': self.ewma_mean\n            })\n        \n        return is_anomaly\n\n# Compare different alpha values\ndata = np.random.normal(100, 5, 500)\ndata[100] = 150\ndata[200] = 50\ndata[300] = 160\ndata[400] = 40\n\nprint(\"EWMA Detector: Effect of Alpha\")\nprint(\"=\" * 55)\nprint(f\"{'Alpha':<8} {'Anomalies':<12} {'Responsiveness'}\")\nprint(\"-\" * 55)\n\nfor alpha in [0.01, 0.05, 0.1, 0.2, 0.5]:\n    det = EWMADetector(alpha=alpha, threshold_multiplier=3.0)\n    for x in data:\n        det.update(x)\n    speed = \"Slow\" if alpha < 0.05 else \"Medium\" if alpha < 0.15 else \"Fast\"\n    print(f\"{alpha:<8} {len(det.anomalies):<12} {speed}\")\n\n# Detailed results with alpha=0.1\ndet = EWMADetector(alpha=0.1, threshold_multiplier=3.0)\nfor x in data:\n    det.update(x)\n\nprint(f\"\\nDetailed results (alpha=0.1):\")\nfor a in det.anomalies:\n    print(f\"  t={a['t']}: value={a['value']:.1f}, residual={a['residual']:.1f}, \"\n          f\"threshold=\u00b1{a['threshold']:.1f}\")"
        ]
      ]
