          "python",
          "import numpy as np\n\nnp.random.seed(42)\n\nclass OnlineAnomalyDetector:\n    \"\"\"Online anomaly detector using Welford's algorithm for running statistics.\"\"\"\n    \n    def __init__(self, threshold_sigma=3.0, warmup=50):\n        self.n = 0\n        self.mean = 0.0\n        self.M2 = 0.0  # Running sum of squared differences\n        self.threshold_sigma = threshold_sigma\n        self.warmup = warmup\n        self.anomalies = []\n    \n    def update(self, x, timestamp=None):\n        \"\"\"Process one observation. Returns True if anomalous.\"\"\"\n        self.n += 1\n        delta = x - self.mean\n        self.mean += delta / self.n\n        delta2 = x - self.mean\n        self.M2 += delta * delta2\n        \n        if self.n < self.warmup:\n            return False\n        \n        variance = self.M2 / (self.n - 1)\n        std = np.sqrt(variance)\n        z_score = abs(x - self.mean) / std if std > 0 else 0\n        \n        is_anomaly = z_score > self.threshold_sigma\n        if is_anomaly:\n            self.anomalies.append({'index': self.n - 1, 'value': x, 'z_score': z_score})\n        \n        return is_anomaly\n    \n    @property\n    def std(self):\n        return np.sqrt(self.M2 / (self.n - 1)) if self.n > 1 else 0\n\n# Simulate streaming data\nn_points = 1000\nnormal_data = np.random.normal(100, 5, n_points)\n\n# Inject anomalies at specific positions\nanomaly_positions = [150, 300, 500, 700, 850]\nfor pos in anomaly_positions:\n    normal_data[pos] = 100 + np.random.choice([-1, 1]) * 25\n\ndetector = OnlineAnomalyDetector(threshold_sigma=3.5, warmup=50)\n\nfor i, value in enumerate(normal_data):\n    detector.update(value, timestamp=i)\n\nprint(\"Online Streaming Anomaly Detection (Welford's)\")\nprint(\"=\" * 55)\nprint(f\"Total observations processed: {detector.n}\")\nprint(f\"Running mean: {detector.mean:.4f}\")\nprint(f\"Running std: {detector.std:.4f}\")\nprint(f\"Warmup period: {detector.warmup}\")\nprint(f\"Threshold: {detector.threshold_sigma} sigma\")\nprint(f\"\\nAnomalies detected: {len(detector.anomalies)}\")\nprint(f\"True anomaly positions: {anomaly_positions}\")\nprint(f\"\\nDetected anomalies:\")\nfor a in detector.anomalies[:6]:\n    print(f\"  Index {a['index']}: value={a['value']:.2f}, z={a['z_score']:.2f}\")"
        ]
      ]
    },
