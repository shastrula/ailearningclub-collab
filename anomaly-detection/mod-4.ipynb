          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.neighbors import NearestNeighbors\nfrom sklearn.datasets import make_blobs\n\nnp.random.seed(42)\n\n# Generate clustered normal data\nX_normal, _ = make_blobs(n_samples=500, centers=3, cluster_std=1.0, random_state=42)\n\n# Inject anomalies\nanomalies = np.array([\n    [10, 10], [-10, -10], [10, -10], [-10, 10],\n    [8, 8], [-8, -8], [0, 12], [12, 0]\n])\n\nX = np.vstack([X_normal, anomalies])\ny_true = np.array([0]*500 + [1]*8)\n\n# Fit KNN model\nk = 5\nknn = NearestNeighbors(n_neighbors=k)\nknn.fit(X)\n\n# Get distances to k-th nearest neighbor\ndistances, indices = knn.kneighbors(X)\nanomaly_scores = distances[:, -1]  # Distance to k-th neighbor\n\n# Set threshold at 95th percentile\nthreshold = np.percentile(anomaly_scores, 95)\npredictions = (anomaly_scores > threshold).astype(int)\n\ntp = np.sum((predictions == 1) & (y_true == 1))\nfp = np.sum((predictions == 1) & (y_true == 0))\nfn = np.sum((predictions == 0) & (y_true == 1))\nprecision = tp / (tp + fp) if (tp + fp) > 0 else 0\nrecall = tp / (tp + fn) if (tp + fn) > 0 else 0\n\nprint(\"KNN-Based Anomaly Detection\")\nprint(\"=\" * 40)\nprint(f\"Number of neighbors (k): {k}\")\nprint(f\"Threshold (95th percentile): {threshold:.4f}\")\nprint(f\"\\nScore statistics:\")\nprint(f\"  Mean score (normal): {anomaly_scores[:500].mean():.4f}\")\nprint(f\"  Mean score (anomalies): {anomaly_scores[500:].mean():.4f}\")\nprint(f\"  Max normal score: {anomaly_scores[:500].max():.4f}\")\nprint(f\"  Min anomaly score: {anomaly_scores[500:].min():.4f}\")\nprint(f\"\\nDetection results:\")\nprint(f\"  Predicted anomalies: {predictions.sum()}\")\nprint(f\"  True Positives: {tp}\")\nprint(f\"  False Positives: {fp}\")\nprint(f\"  False Negatives: {fn}\")\nprint(f\"  Precision: {precision:.4f}\")\nprint(f\"  Recall: {recall:.4f}\")"
        ]
      ]
