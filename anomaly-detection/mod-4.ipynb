          "python",
          "import numpy as np\nfrom scipy.spatial.distance import cdist\n\nnp.random.seed(42)\n\n# Generate data\nn_normal = 200\nX_normal = np.random.normal(loc=0, scale=1, size=(n_normal, 2))\nanomalies = np.array([[5, 5], [-5, -5], [4, -4], [-4, 4], [6, 0]])\nX = np.vstack([X_normal, anomalies])\ny_true = np.array([0]*n_normal + [1]*5)\n\ndef knn_anomaly_score(X, k=5, metric='euclidean'):\n    \"\"\"Calculate KNN anomaly scores from scratch.\"\"\"\n    # Compute pairwise distances\n    dist_matrix = cdist(X, X, metric=metric)\n    \n    # For each point, find k-th nearest neighbor distance\n    # (exclude self - distance 0)\n    scores = np.zeros(len(X))\n    for i in range(len(X)):\n        distances = np.sort(dist_matrix[i])\n        # Skip index 0 (self, distance=0), take k-th neighbor\n        scores[i] = distances[k]  # k-th nearest (1-indexed from non-self)\n    \n    return scores\n\n# Calculate scores with different k values\nfor k in [3, 5, 10]:\n    scores = knn_anomaly_score(X, k=k)\n    threshold = np.percentile(scores, 95)\n    preds = (scores > threshold).astype(int)\n    tp = np.sum((preds == 1) & (y_true == 1))\n    fp = np.sum((preds == 1) & (y_true == 0))\n    recall = tp / y_true.sum()\n    precision = tp / preds.sum() if preds.sum() > 0 else 0\n    print(f\"k={k:>2}: Threshold={threshold:.3f}, Detected={preds.sum():>2}, \"\n          f\"TP={tp}, FP={fp}, Precision={precision:.3f}, Recall={recall:.3f}\")"
        ]
      ]
