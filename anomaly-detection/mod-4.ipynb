          "python",
          "import numpy as np\nfrom sklearn.neighbors import NearestNeighbors\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import f1_score, precision_score, recall_score\n\nnp.random.seed(42)\n\n# Dataset with 5% anomalies\nX_normal, _ = make_blobs(n_samples=475, centers=3, cluster_std=1.0, random_state=42)\nanomalies = np.random.uniform(low=-10, high=10, size=(25, 2))\nX = np.vstack([X_normal, anomalies])\ny_true = np.array([0]*475 + [1]*25)\n\nprint(\"Effect of k on KNN Anomaly Detection\")\nprint(\"=\" * 60)\nprint(f\"{'k':<5} {'Precision':<12} {'Recall':<10} {'F1':<8} {'Detected':<10}\")\nprint(\"-\" * 60)\n\nk_values = [1, 3, 5, 10, 20, 30, 50]\nfor k in k_values:\n    knn = NearestNeighbors(n_neighbors=k)\n    knn.fit(X)\n    distances, _ = knn.kneighbors(X)\n    scores = distances[:, -1]\n    threshold = np.percentile(scores, 95)\n    preds = (scores > threshold).astype(int)\n    \n    prec = precision_score(y_true, preds, zero_division=0)\n    rec = recall_score(y_true, preds, zero_division=0)\n    f1 = f1_score(y_true, preds, zero_division=0)\n    \n    print(f\"{k:<5} {prec:<12.4f} {rec:<10.4f} {f1:<8.4f} {preds.sum():<10}\")"
        ]
      ]
