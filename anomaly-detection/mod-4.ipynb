          "python",
          "import numpy as np\nfrom sklearn.neighbors import NearestNeighbors\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# Generate data with different scales per feature\nX_normal = np.column_stack([\n    np.random.normal(100, 10, 300),   # Feature 1: large scale\n    np.random.normal(0.5, 0.1, 300),  # Feature 2: small scale\n    np.random.normal(50, 5, 300)      # Feature 3: medium scale\n])\n\n# Anomalies visible only in feature 2\nanomalies = np.column_stack([\n    np.random.normal(100, 10, 10),    # Normal range\n    np.random.uniform(2, 5, 10),      # Anomalous!\n    np.random.normal(50, 5, 10)       # Normal range\n])\n\nX = np.vstack([X_normal, anomalies])\ny_true = np.array([0]*300 + [1]*10)\n\nk = 5\nresults = {}\n\n# Without scaling (Euclidean dominated by Feature 1)\nknn = NearestNeighbors(n_neighbors=k, metric='euclidean')\nknn.fit(X)\ndists, _ = knn.kneighbors(X)\nscores = dists[:, -1]\nthreshold = np.percentile(scores, 95)\npreds = (scores > threshold).astype(int)\nresults['Euclidean (raw)'] = f1_score(y_true, preds, zero_division=0)\n\n# With scaling\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\nknn_scaled = NearestNeighbors(n_neighbors=k, metric='euclidean')\nknn_scaled.fit(X_scaled)\ndists_s, _ = knn_scaled.kneighbors(X_scaled)\nscores_s = dists_s[:, -1]\nthreshold_s = np.percentile(scores_s, 95)\npreds_s = (scores_s > threshold_s).astype(int)\nresults['Euclidean (scaled)'] = f1_score(y_true, preds_s, zero_division=0)\n\n# Manhattan distance (scaled)\nknn_man = NearestNeighbors(n_neighbors=k, metric='manhattan')\nknn_man.fit(X_scaled)\ndists_m, _ = knn_man.kneighbors(X_scaled)\nscores_m = dists_m[:, -1]\nthreshold_m = np.percentile(scores_m, 95)\npreds_m = (scores_m > threshold_m).astype(int)\nresults['Manhattan (scaled)'] = f1_score(y_true, preds_m, zero_division=0)\n\n# Chebyshev distance (max dimension difference)\nknn_cheb = NearestNeighbors(n_neighbors=k, metric='chebyshev')\nknn_cheb.fit(X_scaled)\ndists_c, _ = knn_cheb.kneighbors(X_scaled)\nscores_c = dists_c[:, -1]\nthreshold_c = np.percentile(scores_c, 95)\npreds_c = (scores_c > threshold_c).astype(int)\nresults['Chebyshev (scaled)'] = f1_score(y_true, preds_c, zero_division=0)\n\nprint(\"Impact of Distance Metrics on Detection\")\nprint(\"=\" * 50)\nprint(f\"{'Metric':<22} {'F1 Score':<10}\")\nprint(\"-\" * 50)\nfor metric, f1 in results.items():\n    print(f\"{metric:<22} {f1:<10.4f}\")\nprint(f\"\\nKey insight: Without scaling, Feature 1 (scale=10)\")\nprint(f\"dominates distances, masking anomalies in Feature 2.\")"
