          "python",
          "import numpy as np\nfrom sklearn.neighbors import NearestNeighbors\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# Generate data with subtle anomalies\nX_normal, _ = make_blobs(n_samples=400, centers=2, cluster_std=1.5, random_state=42)\n# Anomalies between clusters (harder to detect)\nanomalies = np.array([[0, 3], [1, 4], [-1, 2], [0.5, 5], [-0.5, 1],\n                      [8, 8], [-8, -8], [7, -7]])\nX = np.vstack([X_normal, anomalies])\ny_true = np.array([0]*400 + [1]*8)\n\nk = 10\nknn = NearestNeighbors(n_neighbors=k)\nknn.fit(X)\ndistances, _ = knn.kneighbors(X)\n\n# Method 1: K-th neighbor distance\nscore_kth = distances[:, -1]\n\n# Method 2: Average distance to all k neighbors\nscore_avg = distances.mean(axis=1)\n\n# Method 3: Maximum distance to k neighbors\nscore_max = distances.max(axis=1)\n\n# Evaluate each at 97th percentile threshold\nresults = {}\nfor name, scores in [(\"K-th neighbor\", score_kth), \n                     (\"Average KNN\", score_avg),\n                     (\"Max KNN\", score_max)]:\n    threshold = np.percentile(scores, 97)\n    preds = (scores > threshold).astype(int)\n    f1 = f1_score(y_true, preds, zero_division=0)\n    tp = np.sum((preds == 1) & (y_true == 1))\n    results[name] = {'f1': f1, 'tp': tp, 'detected': preds.sum()}\n\nprint(\"KNN Scoring Variants Comparison (k=10)\")\nprint(\"=\" * 55)\nprint(f\"{'Method':<18} {'F1 Score':<10} {'TP':<5} {'Total Detected':<15}\")\nprint(\"-\" * 55)\nfor method, m in results.items():\n    print(f\"{method:<18} {m['f1']:<10.4f} {m['tp']:<5} {m['detected']:<15}\")"
        ]
      ]
