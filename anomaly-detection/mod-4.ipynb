          "python",
          "import numpy as np\nfrom sklearn.neighbors import NearestNeighbors\nimport time\n\nnp.random.seed(42)\n\n# Benchmark different algorithms\nsizes = [1000, 5000, 10000]\nprint(\"KNN Algorithm Performance Comparison\")\nprint(\"=\" * 55)\nprint(f\"{'Size':<8} {'Ball Tree':<14} {'KD Tree':<14} {'Brute':<14}\")\nprint(\"-\" * 55)\n\nfor n in sizes:\n    X = np.random.normal(0, 1, (n, 10))\n    \n    times = {}\n    for algo in ['ball_tree', 'kd_tree', 'brute']:\n        start = time.time()\n        knn = NearestNeighbors(n_neighbors=5, algorithm=algo)\n        knn.fit(X)\n        knn.kneighbors(X)\n        elapsed = time.time() - start\n        times[algo] = elapsed\n    \n    print(f\"{n:<8} {times['ball_tree']:<14.4f} {times['kd_tree']:<14.4f} {times['brute']:<14.4f}\")\n\nprint(\"\\nNote: Ball Tree and KD Tree provide O(n log n) for low dimensions.\")\nprint(\"For high dimensions (d > 20), brute force may be faster.\")"
        ]
      ]
