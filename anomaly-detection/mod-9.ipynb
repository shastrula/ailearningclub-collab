          "python",
          "import numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import f1_score, precision_score, recall_score\n\nnp.random.seed(42)\n\nX_clusters, _ = make_blobs(n_samples=500, centers=3, cluster_std=0.8, random_state=42)\noutliers = np.random.uniform(low=-10, high=10, size=(25, 2))\nX = np.vstack([X_clusters, outliers])\ny_true = np.array([0]*500 + [1]*25)\nX_scaled = StandardScaler().fit_transform(X)\n\nprint(\"Effect of min_samples (eps=0.5)\")\nprint(\"=\" * 65)\nprint(f\"{'min_samples':<13} {'Clusters':<10} {'Noise':<8} {'Precision':<12} {'Recall':<10} {'F1':<8}\")\nprint(\"-\" * 65)\n\nfor ms in [3, 5, 7, 10, 15, 20, 30]:\n    db = DBSCAN(eps=0.5, min_samples=ms)\n    labels = db.fit_predict(X_scaled)\n    n_clusters = len(set(labels)) - (1 if -1 in labels else 0)\n    preds = (labels == -1).astype(int)\n    \n    prec = precision_score(y_true, preds, zero_division=0)\n    rec = recall_score(y_true, preds, zero_division=0)\n    f1 = f1_score(y_true, preds, zero_division=0)\n    \n    print(f\"{ms:<13} {n_clusters:<10} {preds.sum():<8} {prec:<12.4f} {rec:<10.4f} {f1:<8.4f}\")"
        ]
      ]
