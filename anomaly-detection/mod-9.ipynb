          "python",
          "import numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# Network traffic data\nn_normal = 500\n# Normal: HTTP traffic (moderate bytes, moderate duration)\nnormal_traffic = np.column_stack([\n    np.random.normal(1000, 200, n_normal),    # bytes\n    np.random.normal(0.5, 0.1, n_normal),     # duration_sec\n    np.random.normal(10, 3, n_normal),        # packets\n    np.random.choice([80, 443], n_normal)     # port\n])\n\n# Anomalous: Port scanning (many ports, tiny packets, short duration)\nn_anomaly = 20\nanomaly_traffic = np.column_stack([\n    np.random.normal(100, 30, n_anomaly),     # small bytes\n    np.random.normal(0.01, 0.005, n_anomaly), # very short\n    np.random.normal(1, 0.5, n_anomaly),      # few packets\n    np.random.choice(range(1, 65535), n_anomaly)  # random ports\n])\n\nX = np.vstack([normal_traffic, anomaly_traffic])\ny_true = np.array([0]*n_normal + [1]*n_anomaly)\n\n# Method 1: DBSCAN on raw features (scaled)\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\ndb1 = DBSCAN(eps=0.8, min_samples=5)\nlabels1 = db1.fit_predict(X_scaled)\npreds1 = (labels1 == -1).astype(int)\n\n# Method 2: DBSCAN on selected features (bytes, duration, packets only)\nX_selected = X[:, :3]\nX_sel_scaled = StandardScaler().fit_transform(X_selected)\ndb2 = DBSCAN(eps=0.8, min_samples=5)\nlabels2 = db2.fit_predict(X_sel_scaled)\npreds2 = (labels2 == -1).astype(int)\n\n# Method 3: DBSCAN with engineered features\nbytes_per_packet = X[:, 0] / np.maximum(X[:, 2], 1)\nbytes_per_second = X[:, 0] / np.maximum(X[:, 1], 0.001)\nX_engineered = np.column_stack([X[:, :3], bytes_per_packet, bytes_per_second])\nX_eng_scaled = StandardScaler().fit_transform(X_engineered)\ndb3 = DBSCAN(eps=0.8, min_samples=5)\nlabels3 = db3.fit_predict(X_eng_scaled)\npreds3 = (labels3 == -1).astype(int)\n\nprint(\"DBSCAN with Different Feature Spaces\")\nprint(\"=\" * 60)\nprint(f\"{'Features':<25} {'Noise':<8} {'Precision':<12} {'Recall':<10} {'F1':<8}\")\nprint(\"-\" * 60)\nfor name, preds in [(\"All raw features\", preds1), \n                    (\"Selected (no port)\", preds2),\n                    (\"Engineered features\", preds3)]:\n    from sklearn.metrics import precision_score, recall_score\n    prec = precision_score(y_true, preds, zero_division=0)\n    rec = recall_score(y_true, preds, zero_division=0)\n    f1 = f1_score(y_true, preds, zero_division=0)\n    print(f\"{name:<25} {preds.sum():<8} {prec:<12.4f} {rec:<10.4f} {f1:<8.4f}\")"
        ]
