          "python",
          "import numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.neighbors import LocalOutlierFactor\nfrom sklearn.svm import OneClassSVM\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import f1_score, precision_score, recall_score\n\nnp.random.seed(42)\n\n# Complex dataset: multiple density clusters\nX1, _ = make_blobs(n_samples=200, centers=[[0, 0]], cluster_std=0.5, random_state=42)\nX2, _ = make_blobs(n_samples=150, centers=[[5, 5]], cluster_std=1.5, random_state=43)\nX3, _ = make_blobs(n_samples=100, centers=[[-4, 4]], cluster_std=0.3, random_state=44)\nanomalies = np.random.uniform(-8, 10, (25, 2))\n\nX = np.vstack([X1, X2, X3, anomalies])\ny_true = np.array([0]*450 + [1]*25)\nX_scaled = StandardScaler().fit_transform(X)\n\nresults = {}\n\n# DBSCAN\ndb = DBSCAN(eps=0.5, min_samples=5)\npreds = (db.fit_predict(X_scaled) == -1).astype(int)\nresults['DBSCAN'] = (precision_score(y_true, preds, zero_division=0),\n                     recall_score(y_true, preds, zero_division=0),\n                     f1_score(y_true, preds, zero_division=0))\n\n# Isolation Forest\niforest = IsolationForest(contamination=0.05, random_state=42)\npreds = (iforest.fit_predict(X_scaled) == -1).astype(int)\nresults['Isolation Forest'] = (precision_score(y_true, preds, zero_division=0),\n                               recall_score(y_true, preds, zero_division=0),\n                               f1_score(y_true, preds, zero_division=0))\n\n# LOF\nlof = LocalOutlierFactor(n_neighbors=20, contamination=0.05)\npreds = (lof.fit_predict(X_scaled) == -1).astype(int)\nresults['LOF'] = (precision_score(y_true, preds, zero_division=0),\n                  recall_score(y_true, preds, zero_division=0),\n                  f1_score(y_true, preds, zero_division=0))\n\n# One-Class SVM\nocsvm = OneClassSVM(nu=0.05, kernel='rbf')\npreds = (ocsvm.fit_predict(X_scaled) == -1).astype(int)\nresults['One-Class SVM'] = (precision_score(y_true, preds, zero_division=0),\n                            recall_score(y_true, preds, zero_division=0),\n                            f1_score(y_true, preds, zero_division=0))\n\nprint(\"DBSCAN vs Dedicated Anomaly Detectors\")\nprint(\"=\" * 60)\nprint(f\"Dataset: 450 normal (3 clusters, varying density) + 25 anomalies\")\nprint(f\"\\n{'Method':<18} {'Precision':<12} {'Recall':<10} {'F1':<8}\")\nprint(\"-\" * 60)\nfor method, (prec, rec, f1) in results.items():\n    print(f\"{method:<18} {prec:<12.4f} {rec:<10.4f} {f1:<8.4f}\")"
        ]
