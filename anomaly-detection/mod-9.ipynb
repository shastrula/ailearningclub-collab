        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.cluster import DBSCAN\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# Generate clustered data with outliers\nX_clusters, _ = make_blobs(n_samples=500, centers=3, cluster_std=0.8, random_state=42)\noutliers = np.random.uniform(low=-10, high=10, size=(25, 2))\nX = np.vstack([X_clusters, outliers])\ny_true = np.array([0]*500 + [1]*25)\n\n# Scale features\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\n# Apply DBSCAN\ndbscan = DBSCAN(eps=0.5, min_samples=5)\nlabels = dbscan.fit_predict(X_scaled)\n\n# Noise points (label = -1) are outliers\ny_pred = (labels == -1).astype(int)\n\ntp = np.sum((y_pred == 1) & (y_true == 1))\nfp = np.sum((y_pred == 1) & (y_true == 0))\nfn = np.sum((y_pred == 0) & (y_true == 1))\nprecision = tp / (tp + fp) if (tp + fp) > 0 else 0\nrecall = tp / (tp + fn) if (tp + fn) > 0 else 0\nf1 = f1_score(y_true, y_pred)\n\nprint(\"DBSCAN Outlier Detection\")\nprint(\"=\" * 45)\nprint(f\"Parameters: eps=0.5, min_samples=5\")\nprint(f\"Clusters found: {len(set(labels)) - (1 if -1 in labels else 0)}\")\nprint(f\"Noise points (outliers): {(labels == -1).sum()}\")\nprint(f\"Core samples: {len(dbscan.core_sample_indices_)}\")\nprint(f\"\\nDetection Results:\")\nprint(f\"  True Positives: {tp}\")\nprint(f\"  False Positives: {fp}\")\nprint(f\"  False Negatives: {fn}\")\nprint(f\"  Precision: {precision:.4f}\")\nprint(f\"  Recall: {recall:.4f}\")\nprint(f\"  F1 Score: {f1:.4f}\")"
        ]
      ]
    },
