          "python",
          "import numpy as np\nfrom sklearn.neighbors import NearestNeighbors\nfrom sklearn.cluster import DBSCAN\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import f1_score\n\nnp.random.seed(42)\n\n# Generate data\nX_clusters, _ = make_blobs(n_samples=500, centers=3, cluster_std=0.8, random_state=42)\noutliers = np.random.uniform(low=-10, high=10, size=(25, 2))\nX = np.vstack([X_clusters, outliers])\ny_true = np.array([0]*500 + [1]*25)\nX_scaled = StandardScaler().fit_transform(X)\n\n# K-distance analysis for choosing eps\nk = 5  # Same as min_samples\nnbrs = NearestNeighbors(n_neighbors=k)\nnbrs.fit(X_scaled)\ndistances, _ = nbrs.kneighbors(X_scaled)\nk_distances = np.sort(distances[:, -1])\n\n# Find the \"elbow\" - where distance starts increasing rapidly\n# Use the difference in sorted k-distances\ndiffs = np.diff(k_distances)\nelbow_idx = np.argmax(diffs > np.percentile(diffs, 90))\noptimal_eps = k_distances[elbow_idx]\n\nprint(\"K-Distance Analysis for eps Selection\")\nprint(\"=\" * 50)\nprint(f\"k (min_samples): {k}\")\nprint(f\"K-distance percentiles:\")\nprint(f\"  25th percentile: {np.percentile(k_distances, 25):.4f}\")\nprint(f\"  50th percentile: {np.percentile(k_distances, 50):.4f}\")\nprint(f\"  75th percentile: {np.percentile(k_distances, 75):.4f}\")\nprint(f\"  90th percentile: {np.percentile(k_distances, 90):.4f}\")\nprint(f\"  95th percentile: {np.percentile(k_distances, 95):.4f}\")\nprint(f\"  Estimated optimal eps: {optimal_eps:.4f}\")\n\n# Test different eps values\nprint(f\"\\n{'eps':<8} {'Clusters':<10} {'Noise':<8} {'F1':<8}\")\nprint(\"-\" * 40)\nfor eps in [0.3, 0.4, 0.5, 0.6, 0.8, 1.0]:\n    db = DBSCAN(eps=eps, min_samples=k)\n    labels = db.fit_predict(X_scaled)\n    n_clusters = len(set(labels)) - (1 if -1 in labels else 0)\n    n_noise = (labels == -1).sum()\n    preds = (labels == -1).astype(int)\n    f1 = f1_score(y_true, preds, zero_division=0)\n    print(f\"{eps:<8.1f} {n_clusters:<10} {n_noise:<8} {f1:<8.4f}\")"
        ]
