          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.preprocessing import StandardScaler\n\nnp.random.seed(42)\n\n# Simulate time-ordered data showing degradation\nn_points = 500\ntime = np.arange(n_points)\n\n# Equipment starts normal, gradually degrades, then fails\nphase1 = 300  # Normal operation\nphase2 = 150  # Degradation\nphase3 = 50   # Near failure\n\ntemp = np.concatenate([\n    np.random.normal(70, 2, phase1),\n    70 + np.linspace(0, 15, phase2) + np.random.normal(0, 2, phase2),\n    np.random.normal(88, 4, phase3)\n])\n\nvibration = np.concatenate([\n    np.random.normal(2, 0.2, phase1),\n    2 + np.linspace(0, 4, phase2) + np.random.normal(0, 0.3, phase2),\n    np.random.normal(7, 1, phase3)\n])\n\n# Train on first 200 points (known good operation)\ntrain_data = np.column_stack([temp[:200], vibration[:200]])\nscaler = StandardScaler()\ntrain_scaled = scaler.fit_transform(train_data)\n\nclf = IsolationForest(n_estimators=200, random_state=42)\nclf.fit(train_scaled)\n\n# Score all data\nall_data = np.column_stack([temp, vibration])\nall_scaled = scaler.transform(all_data)\nscores = -clf.decision_function(all_scaled)\n\n# Create health indicator\ndf_health = pd.DataFrame({\n    'time': time,\n    'temperature': temp,\n    'vibration': vibration,\n    'anomaly_score': scores,\n    'phase': ['normal']*phase1 + ['degradation']*phase2 + ['failure']*phase3\n})\n\n# Rolling health score\ndf_health['health_score'] = pd.Series(scores).rolling(20).mean()\n\nprint(\"Condition Monitoring - Equipment Health\")\nprint(\"=\" * 55)\nprint(f\"Training period: First 200 samples (healthy)\")\nprint(f\"\\nAnomaly Score by Phase:\")\nprint(f\"{'Phase':<15} {'Mean Score':<12} {'Max Score':<12} {'% Above 0'}\")\nprint(\"-\" * 55)\nfor phase in ['normal', 'degradation', 'failure']:\n    mask = df_health['phase'] == phase\n    phase_scores = df_health.loc[mask, 'anomaly_score']\n    above_zero = (phase_scores > 0).mean()\n    print(f\"{phase:<15} {phase_scores.mean():<12.4f} {phase_scores.max():<12.4f} {above_zero:.1%}\")\n\nprint(f\"\\nEarly warning capability:\")\nprint(f\"  First score > 0 at time: {(scores > 0).argmax()}\")\nprint(f\"  Degradation starts at time: {phase1}\")\nprint(f\"  Lead time: {phase1 - (scores > 0).argmax()} samples\")"
        ]
      ]
