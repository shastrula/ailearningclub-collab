          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\ndef generate_manufacturing_data(n_normal=2000, n_degradation=200, n_failure=50):\n    \"\"\"Simulate a manufacturing process with temperature, pressure, vibration, power.\"\"\"\n    \n    # Normal operation: sensors follow physical relationships\n    # Temperature drives pressure (ideal gas law approximation)\n    temp_normal = np.random.normal(70, 3, n_normal)\n    pressure_normal = 0.5 * temp_normal + np.random.normal(0, 1, n_normal)\n    vibration_normal = np.random.normal(2.0, 0.3, n_normal)\n    power_normal = 0.3 * temp_normal + 0.2 * vibration_normal + np.random.normal(0, 1, n_normal)\n    flow_normal = np.random.normal(100, 5, n_normal)\n    \n    # Degradation: gradual change in vibration and temperature correlation breaks\n    temp_deg = np.random.normal(75, 4, n_degradation)  # Slightly elevated\n    pressure_deg = 0.5 * temp_deg + np.random.normal(2, 1.5, n_degradation)  # Higher offset\n    vibration_deg = np.random.normal(4.0, 0.8, n_degradation)  # Elevated vibration\n    power_deg = 0.3 * temp_deg + 0.5 * vibration_deg + np.random.normal(2, 1.5, n_degradation)\n    flow_deg = np.random.normal(92, 8, n_degradation)  # Reduced flow\n    \n    # Failure: extreme values and broken correlations\n    temp_fail = np.random.normal(95, 5, n_failure)\n    pressure_fail = np.random.normal(20, 5, n_failure)  # Pressure drops (leak)\n    vibration_fail = np.random.normal(8.0, 2.0, n_failure)  # High vibration\n    power_fail = np.random.normal(50, 10, n_failure)  # Power spikes\n    flow_fail = np.random.normal(40, 15, n_failure)  # Flow drops significantly\n    \n    # Combine\n    df = pd.DataFrame({\n        'temperature': np.concatenate([temp_normal, temp_deg, temp_fail]),\n        'pressure': np.concatenate([pressure_normal, pressure_deg, pressure_fail]),\n        'vibration': np.concatenate([vibration_normal, vibration_deg, vibration_fail]),\n        'power': np.concatenate([power_normal, power_deg, power_fail]),\n        'flow_rate': np.concatenate([flow_normal, flow_deg, flow_fail]),\n    })\n    \n    labels = np.array(['normal']*n_normal + ['degradation']*n_degradation + ['failure']*n_failure)\n    \n    return df, labels\n\ndf, labels = generate_manufacturing_data()\ny_binary = (labels != 'normal').astype(int)\n\nprint(\"Manufacturing Sensor Dataset\")\nprint(\"=\" * 50)\nprint(f\"Total samples: {len(df)}\")\nprint(f\"\\nLabel distribution:\")\nfor label in ['normal', 'degradation', 'failure']:\n    count = (labels == label).sum()\n    print(f\"  {label:<15}: {count} ({count/len(df):.1%})\")\nprint(f\"\\nSensor statistics (normal operation):\")\nnormal_mask = labels == 'normal'\nfor col in df.columns:\n    print(f\"  {col:<15}: mean={df.loc[normal_mask, col].mean():.2f}, \"\n          f\"std={df.loc[normal_mask, col].std():.2f}\")"
