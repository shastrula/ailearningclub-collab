          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import classification_report, f1_score\n\nnp.random.seed(42)\n\ndef generate_manufacturing_data(n_normal=2000, n_degradation=200, n_failure=50):\n    temp_normal = np.random.normal(70, 3, n_normal)\n    pressure_normal = 0.5 * temp_normal + np.random.normal(0, 1, n_normal)\n    vibration_normal = np.random.normal(2.0, 0.3, n_normal)\n    power_normal = 0.3 * temp_normal + 0.2 * vibration_normal + np.random.normal(0, 1, n_normal)\n    flow_normal = np.random.normal(100, 5, n_normal)\n    \n    temp_deg = np.random.normal(75, 4, n_degradation)\n    pressure_deg = 0.5 * temp_deg + np.random.normal(2, 1.5, n_degradation)\n    vibration_deg = np.random.normal(4.0, 0.8, n_degradation)\n    power_deg = 0.3 * temp_deg + 0.5 * vibration_deg + np.random.normal(2, 1.5, n_degradation)\n    flow_deg = np.random.normal(92, 8, n_degradation)\n    \n    temp_fail = np.random.normal(95, 5, n_failure)\n    pressure_fail = np.random.normal(20, 5, n_failure)\n    vibration_fail = np.random.normal(8.0, 2.0, n_failure)\n    power_fail = np.random.normal(50, 10, n_failure)\n    flow_fail = np.random.normal(40, 15, n_failure)\n    \n    df = pd.DataFrame({\n        'temperature': np.concatenate([temp_normal, temp_deg, temp_fail]),\n        'pressure': np.concatenate([pressure_normal, pressure_deg, pressure_fail]),\n        'vibration': np.concatenate([vibration_normal, vibration_deg, vibration_fail]),\n        'power': np.concatenate([power_normal, power_deg, power_fail]),\n        'flow_rate': np.concatenate([flow_normal, flow_deg, flow_fail]),\n    })\n    labels = np.array(['normal']*n_normal + ['degradation']*n_degradation + ['failure']*n_failure)\n    return df, labels\n\ndf, labels = generate_manufacturing_data()\ny_binary = (labels != 'normal').astype(int)\n\ndef engineer_manufacturing_features(df):\n    \"\"\"Create physics-informed features for manufacturing data.\"\"\"\n    features = df.copy()\n    \n    # Relationship features (based on physical laws)\n    features['temp_pressure_ratio'] = df['temperature'] / (df['pressure'] + 1)\n    features['pressure_deviation'] = df['pressure'] - 0.5 * df['temperature']  # Expected relationship\n    features['power_efficiency'] = df['power'] / (df['temperature'] + df['vibration'] + 1)\n    \n    # Vibration-related\n    features['vibration_squared'] = df['vibration'] ** 2  # Energy proportional to v\u00b2\n    features['vibration_power_ratio'] = df['vibration'] / (df['power'] + 1)\n    \n    # Flow-related\n    features['flow_pressure_product'] = df['flow_rate'] * df['pressure']\n    features['flow_deviation'] = abs(df['flow_rate'] - 100)  # Deviation from nominal\n    \n    # Cross-sensor correlations\n    features['temp_vibration_product'] = df['temperature'] * df['vibration']\n    \n    return features\n\n# Compare raw vs engineered\nX_raw = df.values\nX_engineered = engineer_manufacturing_features(df).values\n\nresults = {}\nfor name, X in [(\"Raw Sensors\", X_raw), (\"Engineered Features\", X_engineered)]:\n    scaler = StandardScaler()\n    X_s = scaler.fit_transform(X)\n    clf = IsolationForest(contamination=0.11, random_state=42)\n    y_pred = (clf.fit_predict(X_s) == -1).astype(int)\n    f1 = f1_score(y_binary, y_pred, zero_division=0)\n    results[name] = f1\n\nprint(\"Physics-Informed Feature Engineering Results\")\nprint(\"=\" * 55)\nprint(f\"{'Feature Set':<25} {'F1 Score':<10} {'Features'}\")\nprint(\"-\" * 55)\nfor name, f1 in results.items():\n    n_feat = X_raw.shape[1] if 'Raw' in name else X_engineered.shape[1]\n    print(f\"{name:<25} {f1:<10.4f} {n_feat}\")\n\n# Detection by anomaly type\nX_eng_s = StandardScaler().fit_transform(X_engineered)\nclf = IsolationForest(contamination=0.11, random_state=42)\ny_pred = (clf.fit_predict(X_eng_s) == -1).astype(int)\n\nprint(f\"\\nDetection by condition type:\")\nfor condition in ['normal', 'degradation', 'failure']:\n    mask = labels == condition\n    detected = y_pred[mask].sum()\n    total = mask.sum()\n    rate = detected/total\n    print(f\"  {condition:<15}: {detected}/{total} flagged ({rate:.1%})\")"
        ]
