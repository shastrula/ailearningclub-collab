          "python",
          "import numpy as np\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import StandardScaler, MinMaxScaler\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.neighbors import LocalOutlierFactor\nfrom sklearn.neural_network import MLPRegressor\nfrom sklearn.metrics import f1_score, average_precision_score, precision_score, recall_score\n\nnp.random.seed(42)\n\nX, y = make_classification(n_samples=20000, n_features=30, n_informative=15,\n    n_redundant=5, weights=[0.995, 0.005], flip_y=0.01, random_state=42)\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42, stratify=y)\n\nscaler = StandardScaler()\nX_train_s = scaler.fit_transform(X_train)\nX_test_s = scaler.transform(X_test)\nX_train_legit = X_train_s[y_train == 0]\n\n# Get scores from all methods\n# IF\nclf_if = IsolationForest(n_estimators=300, contamination=0.005, random_state=42)\nclf_if.fit(X_train_legit)\nscores_if = -clf_if.decision_function(X_test_s)\n\n# LOF\nlof = LocalOutlierFactor(n_neighbors=20, novelty=True, contamination=0.005)\nlof.fit(X_train_legit)\nscores_lof = -lof.decision_function(X_test_s)\n\n# Autoencoder\nae = MLPRegressor(hidden_layer_sizes=(20, 10, 5, 10, 20), max_iter=200, random_state=42, early_stopping=True)\nae.fit(X_train_legit, X_train_legit)\nscores_ae = np.mean((X_test_s - ae.predict(X_test_s)) ** 2, axis=1)\n\n# Normalize all scores to [0, 1]\nall_scores = np.column_stack([scores_if, scores_lof, scores_ae])\nscore_scaler = MinMaxScaler()\nall_scores_norm = score_scaler.fit_transform(all_scores)\n\n# Ensemble: weighted average\nweights = [0.35, 0.30, 0.35]\nensemble_score = np.average(all_scores_norm, axis=1, weights=weights)\n\n# Find best threshold via F1\nbest_f1 = 0\nbest_threshold = 0\nfor pctl in np.arange(95, 99.9, 0.1):\n    t = np.percentile(ensemble_score, pctl)\n    pred = (ensemble_score > t).astype(int)\n    f1 = f1_score(y_test, pred, zero_division=0)\n    if f1 > best_f1:\n        best_f1 = f1\n        best_threshold = t\n\ny_pred_ensemble = (ensemble_score > best_threshold).astype(int)\n\nprint(\"Credit Card Fraud Detection - Final Results\")\nprint(\"=\" * 65)\nprint(f\"\\n{'Method':<20} {'PR-AUC':<10} {'F1':<8} {'Precision':<12} {'Recall':<10}\")\nprint(\"-\" * 65)\n\nmethods = [\n    (\"Isolation Forest\", scores_if, (scores_if > np.percentile(scores_if, 99.5)).astype(int)),\n    (\"LOF\", scores_lof, (scores_lof > np.percentile(scores_lof, 99.5)).astype(int)),\n    (\"Autoencoder\", scores_ae, (scores_ae > np.percentile(scores_ae, 99.5)).astype(int)),\n    (\"Ensemble\", ensemble_score, y_pred_ensemble),\n]\n\nfor name, scores, preds in methods:\n    pr_auc = average_precision_score(y_test, scores)\n    f1 = f1_score(y_test, preds, zero_division=0)\n    prec = precision_score(y_test, preds, zero_division=0)\n    rec = recall_score(y_test, preds, zero_division=0)\n    print(f\"{name:<20} {pr_auc:<10.4f} {f1:<8.4f} {prec:<12.4f} {rec:<10.4f}\")\n\nprint(f\"\\nBest ensemble threshold: {best_threshold:.4f}\")\nprint(f\"Best ensemble F1: {best_f1:.4f}\")"
        ]
      ]
