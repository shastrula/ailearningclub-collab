          "python",
          "import numpy as np\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.metrics import classification_report, average_precision_score, f1_score\n\nnp.random.seed(42)\n\nX, y = make_classification(n_samples=20000, n_features=30, n_informative=15,\n    n_redundant=5, weights=[0.995, 0.005], flip_y=0.01, random_state=42)\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42, stratify=y)\n\nscaler = StandardScaler()\nX_train_s = scaler.fit_transform(X_train)\nX_test_s = scaler.transform(X_test)\n\n# Train only on legitimate transactions (unsupervised)\nX_train_legit = X_train_s[y_train == 0]\n\nclf_if = IsolationForest(n_estimators=300, contamination=0.005, max_samples=256, random_state=42)\nclf_if.fit(X_train_legit)\n\n# Score test data\nscores_if = -clf_if.decision_function(X_test_s)\ny_pred_if = (clf_if.predict(X_test_s) == -1).astype(int)\n\nprint(\"Method 1: Isolation Forest\")\nprint(\"=\" * 50)\nprint(f\"Trained on: {len(X_train_legit)} legitimate transactions\")\nprint(f\"\\nTest Results:\")\nprint(classification_report(y_test, y_pred_if, target_names=['Legitimate', 'Fraud']))\nprint(f\"PR-AUC: {average_precision_score(y_test, scores_if):.4f}\")"
        ]
