          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import StandardScaler\n\nnp.random.seed(42)\n\n# Generate synthetic credit card data mimicking PCA-transformed features\n# Real dataset has 28 PCA components + Time + Amount\nn_samples = 20000\nn_fraud = 100  # 0.5% fraud rate\n\nX, y = make_classification(\n    n_samples=n_samples,\n    n_features=28,\n    n_informative=15,\n    n_redundant=5,\n    n_classes=2,\n    weights=[1 - n_fraud/n_samples, n_fraud/n_samples],\n    flip_y=0.01,\n    random_state=42\n)\n\n# Add Amount and Time features\namount = np.where(y == 0, \n    np.random.lognormal(3.5, 1.5, n_samples),  # Normal: median ~$33\n    np.random.lognormal(5.0, 1.0, n_samples))   # Fraud: median ~$148\namount = np.abs(amount)\n\ntime_feature = np.cumsum(np.random.exponential(30, n_samples))  # Seconds between transactions\n\n# Create DataFrame\nfeature_names = [f'V{i+1}' for i in range(28)]\ndf = pd.DataFrame(X, columns=feature_names)\ndf['Amount'] = amount\ndf['Time'] = time_feature\ndf['Class'] = y\n\n# Split into train (for model fitting) and test\nX_all = df.drop('Class', axis=1).values\ny_all = df['Class'].values\n\nX_train, X_test, y_train, y_test = train_test_split(\n    X_all, y_all, test_size=0.3, random_state=42, stratify=y_all\n)\n\nprint(\"Credit Card Fraud Detection Dataset\")\nprint(\"=\" * 50)\nprint(f\"Total transactions: {n_samples:,}\")\nprint(f\"Fraudulent: {y_all.sum()} ({y_all.mean():.2%})\")\nprint(f\"Legitimate: {(1-y_all).sum():,.0f}\")\nprint(f\"\\nTrain set: {len(X_train):,} ({y_train.sum()} fraud)\")\nprint(f\"Test set: {len(X_test):,} ({y_test.sum()} fraud)\")\nprint(f\"\\nAmount statistics:\")\nprint(f\"  Legitimate mean: ${amount[y==0].mean():.2f}\")\nprint(f\"  Fraud mean: ${amount[y==1].mean():.2f}\")\nprint(f\"  Legitimate median: ${np.median(amount[y==0]):.2f}\")\nprint(f\"  Fraud median: ${np.median(amount[y==1]):.2f}\")"
