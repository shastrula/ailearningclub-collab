          "python",
          "import numpy as np\nfrom sklearn.datasets import make_classification\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.neural_network import MLPRegressor\nfrom sklearn.metrics import classification_report, average_precision_score, f1_score\n\nnp.random.seed(42)\n\nX, y = make_classification(n_samples=20000, n_features=30, n_informative=15,\n    n_redundant=5, weights=[0.995, 0.005], flip_y=0.01, random_state=42)\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42, stratify=y)\n\nscaler = StandardScaler()\nX_train_s = scaler.fit_transform(X_train)\nX_test_s = scaler.transform(X_test)\n\n# Train autoencoder only on legitimate\nX_train_legit = X_train_s[y_train == 0]\n\nae = MLPRegressor(\n    hidden_layer_sizes=(20, 10, 5, 10, 20),\n    activation='relu',\n    max_iter=200,\n    random_state=42,\n    early_stopping=True\n)\nae.fit(X_train_legit, X_train_legit)\n\n# Reconstruction error as anomaly score\nX_test_recon = ae.predict(X_test_s)\nscores_ae = np.mean((X_test_s - X_test_recon) ** 2, axis=1)\n\n# Threshold from training reconstruction error\ntrain_recon = ae.predict(X_train_legit)\ntrain_errors = np.mean((X_train_legit - train_recon) ** 2, axis=1)\nthreshold = np.percentile(train_errors, 99.5)\n\ny_pred_ae = (scores_ae > threshold).astype(int)\n\nprint(\"Method 3: Autoencoder (Reconstruction Error)\")\nprint(\"=\" * 50)\nprint(f\"Architecture: 30 -> 20 -> 10 -> 5 -> 10 -> 20 -> 30\")\nprint(f\"Threshold (99.5th pctl of training error): {threshold:.6f}\")\nprint(f\"\\nReconstruction Error:\")\nprint(f\"  Legitimate mean: {scores_ae[y_test==0].mean():.6f}\")\nprint(f\"  Fraud mean: {scores_ae[y_test==1].mean():.6f}\")\nprint(f\"\\n{classification_report(y_test, y_pred_ae, target_names=['Legitimate', 'Fraud'])}\")\nprint(f\"PR-AUC: {average_precision_score(y_test, scores_ae):.4f}\")"
        ]
      ]
