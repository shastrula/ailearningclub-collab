          "python",
          "import numpy as np\nfrom sklearn.datasets import make_blobs\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.metrics import classification_report\n\nnp.random.seed(42)\n\n# Step 1-2: Generate and preprocess data\nX_normal, _ = make_blobs(n_samples=300, centers=1, cluster_std=1.0, random_state=42)\nX_anomalies = np.random.uniform(low=-6, high=6, size=(15, 2))\nX = np.vstack([X_normal, X_anomalies])\ny_true = np.array([0] * 300 + [1] * 15)\n\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\n# Step 3-5: Train Isolation Forest\nclf = IsolationForest(contamination=0.05, random_state=42)\ny_pred_raw = clf.fit_predict(X_scaled)\n\n# Convert: IsolationForest uses -1 for anomaly, 1 for normal\ny_pred = (y_pred_raw == -1).astype(int)\n\n# Step 6-7: Evaluate\nprint(\"Anomaly Detection Pipeline Results\")\nprint(\"=\" * 40)\nprint(f\"Total samples: {len(X)}\")\nprint(f\"Predicted anomalies: {y_pred.sum()}\")\nprint(f\"Actual anomalies: {y_true.sum()}\")\nprint(f\"\\nClassification Report:\")\nprint(classification_report(y_true, y_pred, target_names=['Normal', 'Anomaly']))"
        ]
      ]
    },
