      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.datasets import make_blobs\n\nnp.random.seed(42)\n\n# Generate data\nX_normal, _ = make_blobs(n_samples=300, centers=1, cluster_std=1.0, center_box=(0, 0), random_state=42)\nX_anomalies = np.random.uniform(low=-8, high=8, size=(15, 2))\nX = np.vstack([X_normal, X_anomalies])\nlabels = np.array([0] * 300 + [1] * 15)\n\n# Calculate distance from center (mean of normal data)\ncenter = X_normal.mean(axis=0)\ndistances = np.sqrt(np.sum((X - center) ** 2, axis=1))\n\n# Set threshold at 95th percentile of distances\nthreshold = np.percentile(distances, 95)\npredictions = (distances > threshold).astype(int)\n\n# Evaluate\ntrue_positives = np.sum((predictions == 1) & (labels == 1))\nfalse_positives = np.sum((predictions == 1) & (labels == 0))\nfalse_negatives = np.sum((predictions == 0) & (labels == 1))\n\nprecision = true_positives / (true_positives + false_positives) if (true_positives + false_positives) > 0 else 0\nrecall = true_positives / (true_positives + false_negatives) if (true_positives + false_negatives) > 0 else 0\n\nprint(f\"Threshold: {threshold:.4f}\")\nprint(f\"Detected anomalies: {predictions.sum()}\")\nprint(f\"True anomalies: {labels.sum()}\")\nprint(f\"True Positives: {true_positives}\")\nprint(f\"False Positives: {false_positives}\")\nprint(f\"False Negatives: {false_negatives}\")\nprint(f\"Precision: {precision:.4f}\")\nprint(f\"Recall: {recall:.4f}\")"
        ]
      ]
    },
