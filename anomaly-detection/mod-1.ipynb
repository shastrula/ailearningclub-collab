          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.datasets import make_blobs\n\nnp.random.seed(42)\n\n# Generate normal data (cluster of points)\nX_normal, _ = make_blobs(n_samples=300, centers=1, cluster_std=1.0, center_box=(0, 0), random_state=42)\n\n# Generate anomalies (scattered far from the cluster)\nX_anomalies = np.random.uniform(low=-8, high=8, size=(15, 2))\n\n# Combine\nX = np.vstack([X_normal, X_anomalies])\nlabels = np.array([0] * 300 + [1] * 15)  # 0=normal, 1=anomaly\n\n# Create DataFrame\ndf = pd.DataFrame(X, columns=['feature_1', 'feature_2'])\ndf['is_anomaly'] = labels\n\nprint(f\"Dataset shape: {df.shape}\")\nprint(f\"Normal points: {(df['is_anomaly'] == 0).sum()}\")\nprint(f\"Anomalies: {(df['is_anomaly'] == 1).sum()}\")\nprint(f\"Anomaly ratio: {df['is_anomaly'].mean():.2%}\")\nprint(f\"\\nFirst 5 rows:\")\nprint(df.head().to_string(index=False))"
