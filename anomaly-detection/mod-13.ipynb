      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Generate time series with clear seasonality (hourly data, daily pattern)\nn_days = 60\nhours_per_day = 24\nn_points = n_days * hours_per_day\n\n# Daily pattern: high during business hours, low at night\nhourly_pattern = np.array([20, 18, 15, 12, 10, 12, 25, 45, 70, 85, 90, 88,\n                           85, 82, 80, 78, 75, 70, 60, 50, 40, 35, 30, 25])\nseasonal = np.tile(hourly_pattern, n_days).astype(float)\n\n# Add slight upward trend\ntrend = np.linspace(0, 20, n_points)\n\n# Add noise\nnoise = np.random.normal(0, 5, n_points)\n\n# Combine\nvalues = trend + seasonal + noise\n\n# Inject anomalies\nanomaly_idx = [200, 500, 800, 1100, 1300]\nfor idx in anomaly_idx:\n    values[idx] = values[idx] + np.random.choice([-1, 1]) * 80\n\nts = pd.Series(values)\n\n# Manual seasonal decomposition\nperiod = 24  # daily\n\n# Step 1: Estimate trend using moving average\ntrend_estimate = ts.rolling(window=period, center=True).mean()\n\n# Step 2: Detrend\ndetrended = ts - trend_estimate\n\n# Step 3: Estimate seasonal component (average for each hour)\nseasonal_estimate = np.zeros(n_points)\nfor i in range(period):\n    indices = range(i, n_points, period)\n    seasonal_values = detrended.iloc[list(indices)].dropna()\n    seasonal_estimate[list(indices)] = seasonal_values.mean()\n\nseasonal_series = pd.Series(seasonal_estimate)\n\n# Step 4: Residual\nresidual = ts - trend_estimate - seasonal_series\nresidual = residual.dropna()\n\n# Detect anomalies in residual\nresidual_mean = residual.mean()\nresidual_std = residual.std()\nthreshold = 3 * residual_std\nanomalies_detected = np.abs(residual - residual_mean) > threshold\n\nprint(\"Classical Seasonal Decomposition\")\nprint(\"=\" * 50)\nprint(f\"Time series length: {n_points} points ({n_days} days)\")\nprint(f\"Period: {period} hours (daily)\")\nprint(f\"\\nComponent statistics:\")\nprint(f\"  Trend range: [{trend_estimate.min():.1f}, {trend_estimate.max():.1f}]\")\nprint(f\"  Seasonal range: [{seasonal_series.min():.1f}, {seasonal_series.max():.1f}]\")\nprint(f\"  Residual std: {residual_std:.2f}\")\nprint(f\"  Residual threshold: \u00b1{threshold:.2f}\")\nprint(f\"\\nAnomalies detected: {anomalies_detected.sum()}\")\nprint(f\"Injected anomalies: {len(anomaly_idx)}\")\nprint(f\"\\nDetected anomaly indices (sample):\")\ndetected_idx = residual.index[anomalies_detected]\nfor idx in list(detected_idx)[:8]:\n    print(f\"  Index {idx}: residual={residual.iloc[idx]:.2f}, value={ts.iloc[idx]:.2f}\")"
        ]
      ]
    },
