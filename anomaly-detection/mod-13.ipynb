          "python",
          "import numpy as np\nimport pandas as pd\nfrom statsmodels.tsa.seasonal import STL\n\nnp.random.seed(42)\n\n# Generate weekly data with yearly seasonality\nn_weeks = 104  # 2 years\nweekly_pattern = np.sin(2 * np.pi * np.arange(n_weeks) / 52) * 30  # Yearly cycle\ntrend = np.linspace(100, 130, n_weeks)\nnoise = np.random.normal(0, 5, n_weeks)\nvalues = trend + weekly_pattern + noise\n\n# Inject anomalies\nvalues[20] = 200  # Spike\nvalues[50] = 40   # Drop\nvalues[75] = 210  # Spike\nvalues[90] = 35   # Drop\n\nts = pd.Series(values, index=pd.date_range('2023-01-01', periods=n_weeks, freq='W'))\n\n# Apply STL decomposition\nstl = STL(ts, period=52, robust=True)\nresult = stl.fit()\n\n# Extract components\ntrend_component = result.trend\nseasonal_component = result.seasonal\nresidual_component = result.resid\n\n# Detect anomalies in residual\nresid_median = np.median(residual_component)\nresid_mad = np.median(np.abs(residual_component - resid_median))\nthreshold = 3.5 * resid_mad / 0.6745  # Modified Z-score threshold\n\nanomalies = np.abs(residual_component - resid_median) > threshold\n\nprint(\"STL Decomposition Anomaly Detection\")\nprint(\"=\" * 55)\nprint(f\"Period: 52 weeks (yearly)\")\nprint(f\"Robust STL: Yes\")\nprint(f\"\\nComponent Variance Explained:\")\ntotal_var = ts.var()\nprint(f\"  Trend: {trend_component.var()/total_var:.1%}\")\nprint(f\"  Seasonal: {seasonal_component.var()/total_var:.1%}\")\nprint(f\"  Residual: {residual_component.var()/total_var:.1%}\")\nprint(f\"\\nResidual Statistics:\")\nprint(f\"  Median: {resid_median:.2f}\")\nprint(f\"  MAD: {resid_mad:.2f}\")\nprint(f\"  Threshold: \u00b1{threshold:.2f}\")\nprint(f\"\\nAnomalies detected: {anomalies.sum()}\")\nfor date in ts.index[anomalies]:\n    val = ts.loc[date]\n    resid = residual_component.loc[date]\n    print(f\"  {date.strftime('%Y-%m-%d')}: value={val:.1f}, residual={resid:.1f}\")"
        ]
      ]
