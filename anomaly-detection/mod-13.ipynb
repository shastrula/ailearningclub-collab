          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Data with daily AND weekly seasonality (hourly data)\nn_hours = 24 * 7 * 8  # 8 weeks\nt = np.arange(n_hours)\n\n# Daily pattern (24-hour cycle)\ndaily = 20 * np.sin(2 * np.pi * t / 24)\n\n# Weekly pattern (168-hour cycle)\nweekly = 10 * np.sin(2 * np.pi * t / 168)\n\ntrend = 0.01 * t\nnoise = np.random.normal(0, 3, n_hours)\nvalues = 100 + trend + daily + weekly + noise\n\n# Anomalies\nanomaly_idx = [100, 400, 800, 1000, 1200]\nfor idx in anomaly_idx:\n    values[idx] += np.random.choice([-1, 1]) * 50\n\nts = pd.Series(values)\n\n# Remove daily seasonality first\ndaily_avg = np.zeros(n_hours)\nfor h in range(24):\n    mask = np.arange(h, n_hours, 24)\n    daily_avg[mask] = ts.iloc[mask].mean()\nafter_daily = ts - pd.Series(daily_avg)\n\n# Remove weekly seasonality\nweekly_avg = np.zeros(n_hours)\nfor h in range(168):\n    mask = np.arange(h, n_hours, 168)\n    if len(mask) > 0:\n        weekly_avg[mask] = after_daily.iloc[mask].mean()\nresidual = after_daily - pd.Series(weekly_avg)\n\n# Detect on residual\nthreshold = 3 * residual.std()\ndetected = np.abs(residual) > threshold\n\ntrue_labels = np.zeros(n_hours, dtype=bool)\ntrue_labels[anomaly_idx] = True\n\ntp = np.sum(detected.values & true_labels)\nfp = np.sum(detected.values & ~true_labels)\n\nprint(\"Multi-Seasonality Decomposition\")\nprint(\"=\" * 50)\nprint(f\"Data: {n_hours} hours ({n_hours//24} days)\")\nprint(f\"Seasonalities: Daily (24h) + Weekly (168h)\")\nprint(f\"\\nVariance decomposition:\")\nprint(f\"  Daily component var: {pd.Series(daily_avg).var():.2f}\")\nprint(f\"  Weekly component var: {pd.Series(weekly_avg).var():.2f}\")\nprint(f\"  Residual var: {residual.var():.2f}\")\nprint(f\"\\nAnomaly detection on residual:\")\nprint(f\"  Threshold: \u00b1{threshold:.2f}\")\nprint(f\"  Detected: {detected.sum()}\")\nprint(f\"  True Positives: {tp}\")\nprint(f\"  False Positives: {fp}\")"
