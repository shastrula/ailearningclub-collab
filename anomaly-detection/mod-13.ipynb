          "python",
          "import numpy as np\nimport pandas as pd\nfrom statsmodels.tsa.seasonal import STL\n\nnp.random.seed(42)\n\n# Data with many outliers\nn = 200\nt = np.arange(n)\nseasonal = 20 * np.sin(2 * np.pi * t / 12)\ntrend = 0.5 * t\nnoise = np.random.normal(0, 3, n)\nvalues = trend + seasonal + noise\n\n# Inject 10% outliers (unusually high rate)\nn_outliers = 20\noutlier_idx = np.random.choice(n, n_outliers, replace=False)\nvalues[outlier_idx] += np.random.choice([-1, 1], n_outliers) * np.random.uniform(40, 80, n_outliers)\n\nts = pd.Series(values)\ntrue_anomalies = np.zeros(n, dtype=bool)\ntrue_anomalies[outlier_idx] = True\n\n# Non-robust STL\nstl_normal = STL(ts, period=12, robust=False)\nresult_normal = stl_normal.fit()\nresid_normal = result_normal.resid\nthreshold_normal = 3 * resid_normal.std()\ndetected_normal = np.abs(resid_normal) > threshold_normal\n\n# Robust STL\nstl_robust = STL(ts, period=12, robust=True)\nresult_robust = stl_robust.fit()\nresid_robust = result_robust.resid\nmad = np.median(np.abs(resid_robust - np.median(resid_robust)))\nthreshold_robust = 3.5 * mad / 0.6745\ndetected_robust = np.abs(resid_robust - np.median(resid_robust)) > threshold_robust\n\n# Compare\ndef metrics(detected, true):\n    tp = np.sum(detected & true)\n    fp = np.sum(detected & ~true)\n    fn = np.sum(~detected & true)\n    prec = tp/(tp+fp) if (tp+fp) > 0 else 0\n    rec = tp/(tp+fn) if (tp+fn) > 0 else 0\n    f1 = 2*prec*rec/(prec+rec) if (prec+rec) > 0 else 0\n    return prec, rec, f1\n\nprec_n, rec_n, f1_n = metrics(detected_normal.values, true_anomalies)\nprec_r, rec_r, f1_r = metrics(detected_robust.values, true_anomalies)\n\nprint(\"Robust vs Non-Robust STL (10% outlier rate)\")\nprint(\"=\" * 55)\nprint(f\"{'Method':<20} {'Precision':<12} {'Recall':<10} {'F1':<8} {'Detected'}\")\nprint(\"-\" * 55)\nprint(f\"{'STL (non-robust)':<20} {prec_n:<12.4f} {rec_n:<10.4f} {f1_n:<8.4f} {detected_normal.sum()}\")\nprint(f\"{'STL (robust)':<20} {prec_r:<12.4f} {rec_r:<10.4f} {f1_r:<8.4f} {detected_robust.sum()}\")\nprint(f\"\\nKey: Robust STL downweights outliers during decomposition,\")\nprint(f\"preventing them from corrupting the seasonal/trend estimates.\")"
        ]
      ]
