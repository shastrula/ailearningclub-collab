          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Generate data with level shifts\nn = 500\nvalues = np.concatenate([\n    np.random.normal(50, 3, 200),\n    np.random.normal(50, 3, 100),\n    np.random.normal(50, 3, 200)\n])\n\n# Inject point anomalies and a level shift\nvalues[75] = 80\nvalues[150] = 20\nvalues[350] = 90\nvalues[200:210] = np.random.normal(70, 2, 10)  # Collective anomaly (level shift)\n\nts = pd.Series(values)\n\n# EMA-based detection\nspans = [10, 20, 50]\nresults = {}\n\nfor span in spans:\n    ema = ts.ewm(span=span).mean()\n    ema_std = ts.ewm(span=span).std()\n    \n    residual = np.abs(ts - ema)\n    threshold = 3 * ema_std\n    \n    detected = (residual > threshold).fillna(False)\n    results[span] = detected.sum()\n\nprint(\"EMA-Based Anomaly Detection\")\nprint(\"=\" * 50)\nprint(f\"{'EMA Span':<12} {'Detected':<12} {'Sensitivity'}\")\nprint(\"-\" * 50)\nfor span, count in results.items():\n    sensitivity = \"High\" if count > 15 else \"Medium\" if count > 8 else \"Low\"\n    print(f\"{span:<12} {count:<12} {sensitivity}\")\n\n# Detailed results with span=20\nspan = 20\nema = ts.ewm(span=span).mean()\nema_std = ts.ewm(span=span).std()\nresidual = np.abs(ts - ema)\nthreshold = 3 * ema_std\ndetected = residual > threshold\ndetected = detected.fillna(False)\n\nprint(f\"\\nDetailed results (span={span}):\")\nprint(f\"Detected indices: {list(np.where(detected)[0][:15])}\")\nprint(f\"Total detected: {detected.sum()}\")"
        ]
      ]
    },
