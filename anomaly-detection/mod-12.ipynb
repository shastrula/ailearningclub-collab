      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Generate synthetic time series (daily server response time)\nn_days = 365\ntime_index = pd.date_range('2024-01-01', periods=n_days, freq='D')\n\n# Base pattern: slight upward trend + weekly seasonality + noise\ntrend = np.linspace(100, 120, n_days)\nweekly = 10 * np.sin(2 * np.pi * np.arange(n_days) / 7)\nnoise = np.random.normal(0, 5, n_days)\nvalues = trend + weekly + noise\n\n# Inject anomalies at specific positions\nanomaly_indices = [50, 100, 150, 200, 250, 300]\nanomaly_values = [180, 40, 190, 30, 200, 25]\nfor idx, val in zip(anomaly_indices, anomaly_values):\n    values[idx] = val\n\nts = pd.Series(values, index=time_index)\n\n# Rolling statistics method\nwindow = 14  # 2-week window\nrolling_mean = ts.rolling(window=window, center=True).mean()\nrolling_std = ts.rolling(window=window, center=True).std()\n\n# Anomaly: more than 3 std from rolling mean\nthreshold_multiplier = 3\nupper_bound = rolling_mean + threshold_multiplier * rolling_std\nlower_bound = rolling_mean - threshold_multiplier * rolling_std\n\nanomalies_detected = (ts > upper_bound) | (ts < lower_bound)\nanomalies_detected = anomalies_detected.fillna(False)\n\nprint(\"Rolling Statistics Anomaly Detection\")\nprint(\"=\" * 50)\nprint(f\"Time series length: {n_days} days\")\nprint(f\"Rolling window: {window} days\")\nprint(f\"Threshold: {threshold_multiplier} standard deviations\")\nprint(f\"\\nAnomalies detected: {anomalies_detected.sum()}\")\nprint(f\"Injected anomalies: {len(anomaly_indices)}\")\nprint(f\"\\nDetected anomaly dates and values:\")\ndetected = ts[anomalies_detected]\nfor date, val in detected.items():\n    rm = rolling_mean.loc[date] if date in rolling_mean.index else np.nan\n    print(f\"  {date.strftime('%Y-%m-%d')}: value={val:.1f}, rolling_mean={rm:.1f}\")"
        ]
      ]
    },
