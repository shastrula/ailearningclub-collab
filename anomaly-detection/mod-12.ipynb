          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Time series with strong trend\nn = 300\nt = np.arange(n)\ntrend = 0.5 * t  # Strong upward trend\nseasonal = 15 * np.sin(2 * np.pi * t / 30)  # Monthly cycle\nnoise = np.random.normal(0, 5, n)\nvalues = trend + seasonal + noise\n\n# Inject anomalies\nvalues[50] = values[50] + 60\nvalues[120] = values[120] - 50\nvalues[200] = values[200] + 70\nvalues[250] = values[250] - 55\n\nts = pd.Series(values)\n\n# Method 1: Raw Z-score (doesn't account for trend)\nz_raw = np.abs((ts - ts.mean()) / ts.std())\ndetected_raw = z_raw > 3\n\n# Method 2: Z-score after detrending (polynomial fit)\npoly_coeffs = np.polyfit(t, values, deg=2)\ntrend_fit = np.polyval(poly_coeffs, t)\nresiduals = values - trend_fit\n\nz_detrended = np.abs((residuals - residuals.mean()) / residuals.std())\ndetected_detrended = z_detrended > 3\n\n# Method 3: Z-score on differenced series\ndiff_values = np.diff(values)\nz_diff = np.abs((diff_values - diff_values.mean()) / diff_values.std())\ndetected_diff = np.concatenate([[False], z_diff > 3])\n\nprint(\"Detrending Effect on Anomaly Detection\")\nprint(\"=\" * 55)\nprint(f\"{'Method':<25} {'Detected':<10} {'True Positives':<15}\")\nprint(\"-\" * 55)\n\ntrue_anomaly_idx = {50, 120, 200, 250}\nfor name, detected in [(\"Raw Z-score\", detected_raw), \n                       (\"Detrended Z-score\", detected_detrended),\n                       (\"Differenced Z-score\", detected_diff)]:\n    det_idx = set(np.where(detected)[0])\n    tp = len(det_idx & true_anomaly_idx)\n    print(f\"{name:<25} {detected.sum():<10} {tp:<15}\")"
        ]
      ]
