          "python",
          "import numpy as np\nimport pandas as pd\n\nnp.random.seed(42)\n\n# Generate server metrics time series\nn = 1000\ncpu = np.random.normal(45, 5, n)\nmemory = np.random.normal(60, 8, n)\nresponse_time = np.random.normal(200, 30, n)\n\n# Inject correlated anomalies (system stress events)\nstress_events = [(100, 110), (400, 405), (700, 715), (900, 903)]\nfor start, end in stress_events:\n    cpu[start:end] = np.random.normal(90, 3, end-start)\n    memory[start:end] = np.random.normal(95, 2, end-start)\n    response_time[start:end] = np.random.normal(800, 50, end-start)\n\ndf = pd.DataFrame({'cpu': cpu, 'memory': memory, 'response_time': response_time})\n\n# Create rolling features\nwindow = 20\nfor col in ['cpu', 'memory', 'response_time']:\n    df[f'{col}_rolling_mean'] = df[col].rolling(window).mean()\n    df[f'{col}_rolling_std'] = df[col].rolling(window).std()\n    df[f'{col}_z'] = (df[col] - df[f'{col}_rolling_mean']) / df[f'{col}_rolling_std']\n\n# Combined anomaly score\ndf['combined_z'] = np.sqrt(df['cpu_z']**2 + df['memory_z']**2 + df['response_time_z']**2)\ndf = df.dropna()\n\n# Detect anomalies (combined Z > threshold)\nthreshold = 5.0\ndf['is_anomaly'] = (df['combined_z'] > threshold).astype(int)\n\n# True labels\ntrue_labels = np.zeros(len(df))\nfor start, end in stress_events:\n    adj_start = max(0, start - window)\n    adj_end = min(len(df), end)\n    mask = (df.index >= start) & (df.index < end)\n    true_labels[mask.values[:len(true_labels)]] = 1\n\nprint(\"Multi-Feature Rolling Window Detection\")\nprint(\"=\" * 55)\nprint(f\"Window size: {window}\")\nprint(f\"Features: cpu, memory, response_time\")\nprint(f\"Combined Z threshold: {threshold}\")\nprint(f\"\\nDetected anomalies: {df['is_anomaly'].sum()}\")\nprint(f\"\\nTop anomaly windows:\")\ntop_anomalies = df.nlargest(5, 'combined_z')[['cpu', 'memory', 'response_time', 'combined_z']]\nprint(top_anomalies.to_string())"
        ]
      ]
