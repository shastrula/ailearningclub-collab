        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.neighbors import LocalOutlierFactor\nfrom sklearn.datasets import make_blobs\nfrom sklearn.metrics import classification_report\n\nnp.random.seed(42)\n\n# Generate multi-density dataset\nX1, _ = make_blobs(n_samples=200, centers=[[0, 0]], cluster_std=0.5, random_state=42)\nX2, _ = make_blobs(n_samples=150, centers=[[5, 5]], cluster_std=1.5, random_state=43)\nX3, _ = make_blobs(n_samples=100, centers=[[-5, 5]], cluster_std=0.8, random_state=44)\n\n# Anomalies in different regions\nanomalies = np.array([\n    [2.5, 2.5], [3, 0], [-2, 8], [7, 0], [-3, -3],\n    [0, 8], [8, 2], [-7, 0], [4, -3], [10, 10]\n])\n\nX = np.vstack([X1, X2, X3, anomalies])\ny_true = np.array([0]*450 + [1]*10)\n\n# Apply LOF with different n_neighbors\nprint(\"LOF with Different n_neighbors\")\nprint(\"=\" * 55)\nprint(f\"{'n_neighbors':<14} {'Precision':<12} {'Recall':<10} {'F1':<8}\")\nprint(\"-\" * 55)\n\nfor n_neighbors in [5, 10, 20, 30, 50]:\n    lof = LocalOutlierFactor(n_neighbors=n_neighbors, contamination=0.02)\n    y_pred = lof.fit_predict(X)\n    y_pred_binary = (y_pred == -1).astype(int)\n    \n    tp = np.sum((y_pred_binary == 1) & (y_true == 1))\n    fp = np.sum((y_pred_binary == 1) & (y_true == 0))\n    fn = np.sum((y_pred_binary == 1) & (y_true == 0))\n    prec = tp / (tp + fp) if (tp + fp) > 0 else 0\n    rec = tp / (tp + y_true.sum() - tp) if y_true.sum() > 0 else 0\n    f1 = 2 * prec * rec / (prec + rec) if (prec + rec) > 0 else 0\n    \n    print(f\"{n_neighbors:<14} {prec:<12.4f} {rec:<10.4f} {f1:<8.4f}\")"
        ]
      ]
    },
