          "python",
          "import numpy as np\nfrom sklearn.neighbors import LocalOutlierFactor\nfrom sklearn.preprocessing import StandardScaler\n\nnp.random.seed(42)\n\n# Training data: only normal samples\nX_train = np.random.normal(loc=[50, 100], scale=[5, 10], size=(500, 2))\n\n# Test data: mix of normal and anomalous\nX_test_normal = np.random.normal(loc=[50, 100], scale=[5, 10], size=(50, 2))\nX_test_anomaly = np.array([\n    [80, 150], [20, 50], [75, 140], [25, 60], [85, 160],\n    [15, 45], [70, 135], [30, 55], [90, 170], [10, 40]\n])\nX_test = np.vstack([X_test_normal, X_test_anomaly])\ny_test = np.array([0]*50 + [1]*10)\n\n# Scale features\nscaler = StandardScaler()\nX_train_scaled = scaler.fit_transform(X_train)\nX_test_scaled = scaler.transform(X_test)\n\n# Train LOF in novelty detection mode\nlof = LocalOutlierFactor(n_neighbors=20, novelty=True, contamination=0.05)\nlof.fit(X_train_scaled)\n\n# Predict on test data\ny_pred = lof.predict(X_test_scaled)\ny_pred_binary = (y_pred == -1).astype(int)\nscores = -lof.decision_function(X_test_scaled)\n\n# Results\ntp = np.sum((y_pred_binary == 1) & (y_test == 1))\nfp = np.sum((y_pred_binary == 1) & (y_test == 0))\nfn = np.sum((y_pred_binary == 0) & (y_test == 1))\nprecision = tp / (tp + fp) if (tp + fp) > 0 else 0\nrecall = tp / (tp + fn) if (tp + fn) > 0 else 0\nf1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0\n\nprint(\"LOF Novelty Detection Mode\")\nprint(\"=\" * 45)\nprint(f\"Training samples (all normal): {len(X_train)}\")\nprint(f\"Test samples: {len(X_test)} (normal: 50, anomaly: 10)\")\nprint(f\"\\nResults:\")\nprint(f\"  True Positives: {tp}\")\nprint(f\"  False Positives: {fp}\")\nprint(f\"  False Negatives: {fn}\")\nprint(f\"  Precision: {precision:.4f}\")\nprint(f\"  Recall: {recall:.4f}\")\nprint(f\"  F1 Score: {f1:.4f}\")\nprint(f\"\\nAnomaly scores (higher = more anomalous):\")\nprint(f\"  Normal test points (mean): {scores[:50].mean():.4f}\")\nprint(f\"  Anomaly test points (mean): {scores[50:].mean():.4f}\")"
        ]
      ]
