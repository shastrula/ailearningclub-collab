      "source": [
        [
          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.neighbors import LocalOutlierFactor\n\nnp.random.seed(42)\n\n# Create two clusters with different densities\ndense_cluster = np.random.normal(loc=[0, 0], scale=0.3, size=(200, 2))\nsparse_cluster = np.random.normal(loc=[6, 6], scale=1.5, size=(100, 2))\n\n# Anomalies: one near dense cluster, one near sparse cluster\nanomaly_near_dense = np.array([[2, 2]])      # Far from dense cluster\nanomaly_near_sparse = np.array([[8.5, 8.5]])  # Moderate distance from sparse\n\nX = np.vstack([dense_cluster, sparse_cluster, anomaly_near_dense, anomaly_near_sparse])\ny_true = np.array([0]*200 + [0]*100 + [1, 1])\n\n# KNN-based detection (global threshold)\nfrom sklearn.neighbors import NearestNeighbors\nknn = NearestNeighbors(n_neighbors=10)\nknn.fit(X)\ndists, _ = knn.kneighbors(X)\nknn_scores = dists[:, -1]\n\n# LOF-based detection (local comparison)\nlof = LocalOutlierFactor(n_neighbors=10, contamination=0.01)\nlof_preds = lof.fit_predict(X)\nlof_scores = -lof.negative_outlier_factor_\n\n# Compare scores for the two anomalies\nprint(\"Global vs Local Anomaly Detection\")\nprint(\"=\" * 55)\nprint(f\"\\nAnomaly near dense cluster [2, 2]:\")\nprint(f\"  KNN distance score: {knn_scores[-2]:.4f}\")\nprint(f\"  LOF score: {lof_scores[-2]:.4f}\")\nprint(f\"\\nAnomaly near sparse cluster [8.5, 8.5]:\")\nprint(f\"  KNN distance score: {knn_scores[-1]:.4f}\")\nprint(f\"  LOF score: {lof_scores[-1]:.4f}\")\nprint(f\"\\nKNN threshold (99th pctl): {np.percentile(knn_scores, 99):.4f}\")\nprint(f\"LOF threshold: 1.5 (by convention)\")\nprint(f\"\\nKNN detects anomaly near dense: {knn_scores[-2] > np.percentile(knn_scores, 99)}\")\nprint(f\"KNN detects anomaly near sparse: {knn_scores[-1] > np.percentile(knn_scores, 99)}\")\nprint(f\"LOF detects anomaly near dense: {lof_scores[-2] > 1.5}\")\nprint(f\"LOF detects anomaly near sparse: {lof_scores[-1] > 1.5}\")"
        ]
      ]
    },
    {
