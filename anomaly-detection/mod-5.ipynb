    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.spatial.distance import cdist\n\nnp.random.seed(42)\n\n# Small dataset for demonstration\nX = np.array([\n    [1, 1], [1.1, 1.2], [0.9, 0.8], [1.2, 1.1], [0.8, 1.0],  # Dense cluster\n    [5, 5], [5.5, 5.2], [4.8, 5.1], [5.2, 4.9], [5.1, 5.3],  # Another cluster\n    [3, 8],  # Anomaly\n])\n\nk = 3\nn = len(X)\n\n# Step 1: Compute pairwise distances\ndist_matrix = cdist(X, X)\n\n# Step 2: Find k nearest neighbors and k-distance for each point\nk_distances = np.zeros(n)\nk_neighbors = np.zeros((n, k), dtype=int)\nfor i in range(n):\n    sorted_indices = np.argsort(dist_matrix[i])[1:k+1]  # Exclude self\n    k_neighbors[i] = sorted_indices\n    k_distances[i] = dist_matrix[i, sorted_indices[-1]]  # k-th nearest distance\n\n# Step 3: Compute reachability distances\nreach_dist = np.zeros((n, k))\nfor i in range(n):\n    for j_idx, j in enumerate(k_neighbors[i]):\n        reach_dist[i, j_idx] = max(k_distances[j], dist_matrix[i, j])\n\n# Step 4: Compute Local Reachability Density\nlrd = np.zeros(n)\nfor i in range(n):\n    avg_reach_dist = reach_dist[i].mean()\n    lrd[i] = 1.0 / avg_reach_dist if avg_reach_dist > 0 else np.inf\n\n# Step 5: Compute LOF scores\nlof_scores = np.zeros(n)\nfor i in range(n):\n    neighbor_lrds = lrd[k_neighbors[i]]\n    lof_scores[i] = neighbor_lrds.mean() / lrd[i] if lrd[i] > 0 else np.inf\n\nprint(\"LOF Computation Step by Step (k=3)\")\nprint(\"=\" * 60)\nprint(f\"\\n{'Point':<12} {'Coords':<15} {'k-dist':<10} {'LRD':<12} {'LOF':<8} {'Type'}\")\nprint(\"-\" * 60)\nlabels = ['Dense']*5 + ['Cluster']*5 + ['ANOMALY']\nfor i in range(n):\n    print(f\"Point {i:<4} ({X[i,0]:.1f},{X[i,1]:.1f}){'':>4} \"\n          f\"{k_distances[i]:<10.4f} {lrd[i]:<12.4f} {lof_scores[i]:<8.4f} {labels[i]}\")\n\nprint(f\"\\nAnomaly (Point 10) LOF = {lof_scores[10]:.4f}\")\nprint(f\"LOF > 1.5 indicates anomaly: {lof_scores[10] > 1.5}\")"
        ]
      ]
    },
