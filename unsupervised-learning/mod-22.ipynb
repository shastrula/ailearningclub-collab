          "python",
          "import numpy as np\nfrom sklearn.preprocessing import StandardScaler\n\n# Time series with repeating patterns\nnp.random.seed(42)\nmotif_length = 30\nn_motifs = 3\nrepetitions_per_motif = 3\n\nts_parts = []\nmotifs = []\n\nfor m in range(n_motifs):\n    motif = np.sin(np.linspace(0, 2*np.pi, motif_length) + m*0.5)\n    motifs.append(motif)\n    \n    for r in range(repetitions_per_motif):\n        noisy_motif = motif + 0.05 * np.random.randn(motif_length)\n        ts_parts.append(noisy_motif)\n\n# Add noise between motifs\nfor _ in range(5):\n    ts_parts.append(np.random.normal(0, 0.1, motif_length))\n\nts = np.concatenate(ts_parts)\n\n# Extract subsequences\nsubsequence_length = motif_length\nn_subsequences = len(ts) - subsequence_length + 1\nsubsequences = np.array([ts[i:i+subsequence_length] for i in range(n_subsequences)])\n\nprint(f\"Time series length: {len(ts)}\")\nprint(f\"Subsequences extracted: {len(subsequences)}\")\n\n# Normalize\nscaler = StandardScaler()\nsubsequences_scaled = scaler.fit_transform(subsequences)\n\n# Cluster subsequences\nfrom sklearn.cluster import DBSCAN\n\n# DTW distance matrix (simplified for speed)\ndistance_matrix_motif = np.zeros((len(subsequences), len(subsequences)))\nfor i in range(min(len(subsequences), 15)):  # Limit for speed\n    for j in range(i + 1, min(len(subsequences), 15)):\n        dist = dtw_distance(subsequences_scaled[i], subsequences_scaled[j])\n        distance_matrix_motif[i, j] = dist\n        distance_matrix_motif[j, i] = dist\n\n# DBSCAN clustering\ndbscan = DBSCAN(eps=0.5, min_samples=2)\nmotif_labels = dbscan.fit_predict(distance_matrix_motif[:15, :15])\n\nn_motifs_found = len(set(motif_labels)) - (1 if -1 in motif_labels else 0)\nprint(f\"Motifs found: {n_motifs_found}\")\nprint(f\"Cluster assignments: {motif_labels}\")"
        ]
      ]
