          "python",
          "import numpy as np\nfrom collections import deque\n\nclass StreamingAnomalyDetector:\n    \"\"\"Detects anomalies in streaming time series using moving average/std\"\"\"\n    \n    def __init__(self, window_size=20, threshold_std=3):\n        self.window = deque(maxlen=window_size)\n        self.threshold_std = threshold_std\n    \n    def predict(self, value):\n        \"\"\"Return True if value is anomalous\"\"\"\n        if len(self.window) < self.window.maxlen:\n            self.window.append(value)\n            return False  # Need full window first\n        \n        # Compute local statistics\n        mean = np.mean(self.window)\n        std = np.std(self.window)\n        \n        # Z-score\n        z_score = abs((value - mean) / (std + 1e-6))\n        is_anomaly = z_score > self.threshold_std\n        \n        self.window.append(value)\n        return is_anomaly\n\n# Simulate stream\ndetector = StreamingAnomalyDetector(window_size=20, threshold_std=2.5)\n\nnp.random.seed(42)\nnormal_stream = np.random.normal(100, 10, 100)\nanomaly_value = 200\nfull_stream = np.concatenate([normal_stream[:50], [anomaly_value], normal_stream[50:]])\n\nanomalies_detected = []\nfor i, value in enumerate(full_stream):\n    if detector.predict(value):\n        anomalies_detected.append(i)\n\nprint(f\"Anomalies detected at indices: {anomalies_detected}\")\nprint(f\"True anomaly at index: 50\")\nprint(f\"Detection accuracy: {50 in anomalies_detected}\")"
        ]
      ]
