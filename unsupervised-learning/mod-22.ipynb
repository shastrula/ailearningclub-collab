          "python",
          "import numpy as np\nfrom dtaidistance import dtw\n\n# Create synthetic time series\nnp.random.seed(42)\nt = np.linspace(0, 2 * np.pi, 100)\nseries1 = np.sin(t) + 0.1 * np.random.randn(100)  # Sin wave\nseries2 = np.sin(t + 0.5) + 0.1 * np.random.randn(100)  # Shifted sin\nseries3 = np.cos(t) + 0.1 * np.random.randn(100)  # Cos wave (different)\n\n# Euclidean distance\neuclidean_1_2 = np.sqrt(np.sum((series1 - series2) ** 2))\neuclidean_1_3 = np.sqrt(np.sum((series1 - series3) ** 2))\n\nprint(f\"Euclidean distance (sine vs shifted sine): {euclidean_1_2:.2f}\")\nprint(f\"Euclidean distance (sine vs cosine): {euclidean_1_3:.2f}\")\n\n# DTW distance (if dtaidistance not available, implement simple version)\ntry:\n    dtw_1_2 = dtw.distance(series1, series2)\n    dtw_1_3 = dtw.distance(series1, series3)\n    print(f\"DTW distance (sine vs shifted sine): {dtw_1_2:.2f}\")\n    print(f\"DTW distance (sine vs cosine): {dtw_1_3:.2f}\")\nexcept:\n    # Fallback: simple DTW implementation\n    def dtw_distance(x, y):\n        n, m = len(x), len(y)\n        dtw_matrix = np.full((n + 1, m + 1), np.inf)\n        dtw_matrix[0, 0] = 0\n        \n        for i in range(1, n + 1):\n            for j in range(1, m + 1):\n                cost = abs(x[i - 1] - y[j - 1])\n                dtw_matrix[i, j] = cost + min(dtw_matrix[i - 1, j],\n                                              dtw_matrix[i, j - 1],\n                                              dtw_matrix[i - 1, j - 1])\n        return dtw_matrix[n, m]\n    \n    dtw_1_2 = dtw_distance(series1, series2)\n    dtw_1_3 = dtw_distance(series1, series3)\n    print(f\"DTW distance (sine vs shifted sine): {dtw_1_2:.2f}\")\n    print(f\"DTW distance (sine vs cosine): {dtw_1_3:.2f}\")\n\n# DTW reveals that shifted sine is more similar to original sine\nprint(f\"\\nDTW correctly identifies the shifted sine as more similar to original\")"
        ]
      ]
    },
    {
