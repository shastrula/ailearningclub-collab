          "python",
          "import numpy as np\nfrom statsmodels.tsa.statespace.sarimax import SARIMAX\n\n# Generate time series with trend\nnp.random.seed(42)\nt = np.arange(100)\ntrend = 0.5 * t\nseasonal = 10 * np.sin(2 * np.pi * t / 20)\nnoise = 2 * np.random.randn(100)\nts_arima = trend + seasonal + noise\n\n# Fit ARIMA\ntry:\n    model = SARIMAX(ts_arima, order=(1, 1, 1), seasonal_order=(1, 1, 1, 12))\n    results = model.fit(disp=False)\n    \n    # Get fitted values\n    fitted = results.fittedvalues\n    residuals = results.resid\n    \n    # Anomalies: large residuals\n    threshold = np.percentile(np.abs(residuals), 95)\n    anomaly_indices = np.where(np.abs(residuals) > threshold)[0]\n    \n    print(f\"ARIMA order (1,1,1) fitted successfully\")\n    print(f\"AIC: {results.aic:.1f}\")\n    print(f\"Residuals mean: {residuals.mean():.4f}, std: {residuals.std():.2f}\")\n    print(f\"Anomalies detected: {len(anomaly_indices)}\")\nexcept ImportError:\n    print(\"(statsmodels not installed; ARIMA skipped)\")\nexcept Exception as e:\n    print(f\"(ARIMA fitting error: {e})\")"
        ]
      ]
