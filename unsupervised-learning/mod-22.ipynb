          "python",
          "from sklearn.cluster import AgglomerativeClustering\nimport matplotlib.pyplot as plt\n\n# Generate diverse time series\nnp.random.seed(42)\nt = np.linspace(0, 4 * np.pi, 100)\n\nseries_list = []\nlabels_true = []\n\n# 3 sin waves with different phases (true cluster 0)\nfor phase in [0, 0.5, 1.0]:\n    s = np.sin(t + phase) + 0.05 * np.random.randn(100)\n    series_list.append(s)\n    labels_true.append(0)\n\n# 3 cos waves (true cluster 1)\nfor phase in [0, 0.5, 1.0]:\n    s = np.cos(t + phase) + 0.05 * np.random.randn(100)\n    series_list.append(s)\n    labels_true.append(1)\n\n# 3 random walks (true cluster 2)\nfor _ in range(3):\n    s = np.cumsum(np.random.randn(100)) + 0.1 * np.random.randn(100)\n    series_list.append(s)\n    labels_true.append(2)\n\nseries_array = np.array(series_list)\n\n# Compute DTW distance matrix (simplified)\nn_series = len(series_list)\ndistance_matrix = np.zeros((n_series, n_series))\n\nfor i in range(n_series):\n    for j in range(i + 1, n_series):\n        # Use simplified DTW\n        dist = dtw_distance(series_list[i], series_list[j])\n        distance_matrix[i, j] = dist\n        distance_matrix[j, i] = dist\n\nprint(f\"Distance matrix shape: {distance_matrix.shape}\")\nprint(f\"Average within-cluster distance: {distance_matrix[0, 1]:.2f}\")\nprint(f\"Average between-cluster distance: {distance_matrix[0, 3]:.2f}\")\n\n# Hierarchical clustering\nclusterer = AgglomerativeClustering(n_clusters=3, linkage='average',\n                                   metric='precomputed')\ncluster_labels = clusterer.fit_predict(distance_matrix)\n\n# Evaluate\nfrom sklearn.metrics import adjusted_rand_score, homogeneity_score\nari = adjusted_rand_score(labels_true, cluster_labels)\nhomogeneity = homogeneity_score(labels_true, cluster_labels)\n\nprint(f\"\\nClustering results:\")\nprint(f\"Adjusted Rand Index: {ari:.3f}\")\nprint(f\"Homogeneity: {homogeneity:.3f}\")\nprint(f\"Predicted clusters: {cluster_labels}\")"
        ]
      ]
    },
