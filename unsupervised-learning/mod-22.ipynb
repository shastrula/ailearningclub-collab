          "python",
          "from scipy.signal import argrelextrema\nimport numpy as np\n\n# Synthetic time series with change points\nnp.random.seed(42)\nn_samples = 500\n\n# Regime 1: low variance\nregime1 = np.random.normal(10, 2, 200)\n\n# Regime 2: mean shift + higher variance\nregime2 = np.random.normal(20, 4, 150)\n\n# Regime 3: back to original\nregime3 = np.random.normal(10, 2, 150)\n\nts = np.concatenate([regime1, regime2, regime3])\n\n# Simple change point detection: rolling mean + variance\nwindow = 20\nrolling_mean = np.convolve(ts, np.ones(window) / window, mode='valid')\nrolling_std = np.array([np.std(ts[i:i+window]) for i in range(len(ts) - window + 1)])\n\n# Change points: sudden shifts in mean or variance\nmean_change = np.abs(np.diff(rolling_mean))\nvariance_change = np.abs(np.diff(rolling_std))\n\n# Threshold\nchange_point_threshold = np.percentile(mean_change, 95)\npotential_changes = np.where(mean_change > change_point_threshold)[0]\n\nprint(f\"Potential change points: {potential_changes[:5]}\")\nprint(f\"True change points approximately: {[200, 350]}\")\n\n# PELT (Pruned Exact Linear Time) for precise change points\ntry:\n    from ruptures import Pelt\n    \n    algo = Pelt(model=\"l2\").fit(ts)\n    change_points = algo.predict(pen=10)\n    print(f\"PELT detected change points: {change_points}\")\nexcept ImportError:\n    print(\"(ruptures package not installed; skipping PELT)\")\n\n# Visualize\nprint(f\"\\nTime series statistics:\")\nprint(f\"Regime 1: mean={regime1.mean():.2f}, std={regime1.std():.2f}\")\nprint(f\"Regime 2: mean={regime2.mean():.2f}, std={regime2.std():.2f}\")\nprint(f\"Regime 3: mean={regime3.mean():.2f}, std={regime3.std():.2f}\")"
        ]
      ]
