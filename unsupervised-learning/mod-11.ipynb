      "source": [
        "# Unsupervised Learning - mod-11\n\n",
        "**Course:** unsupervised-learning\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.manifold import TSNE\nfrom sklearn.decomposition import PCA\nimport numpy as np\n\n# Initial data\nX_scaled = scaler.fit_transform(X)\n\n# Multi-stage PCA: 100 -> 50 -> 10 -> 2\npca1 = PCA(n_components=100)\nX_100 = pca1.fit_transform(X_scaled)\n\npca2 = PCA(n_components=50)\nX_50 = pca2.fit_transform(X_100)\n\npca3 = PCA(n_components=10)\nX_10 = pca3.fit_transform(X_50)\n\n# Final t-SNE with 10D PCA init\npca_init = PCA(n_components=2)\ninit = pca_init.fit_transform(X_10)\n\ntsne = TSNE(n_components=2, init=init, random_state=42, n_iter=1000)\nX_tsne = tsne.fit_transform(X_10)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.neighbors import kneighbors_graph\nfrom scipy.sparse.linalg import eigsh\n\n# Build k-nearest neighbor graph\nk = 20\ngraph = kneighbors_graph(X_scaled, k, mode='connectivity', include_self=True)\n\n# Compute Laplacian\nfrom scipy.sparse import diags\ndeg = np.array(graph.sum(axis=1)).flatten()\nD = diags(deg)\nL = D - graph\n\n# Get eigenvectors (2 smallest eigenvalues)\neigenvalues, eigenvectors = eigsh(L, k=2, which='SM')\ninit = eigenvectors\n\n# t-SNE with spectral init\ntsne = TSNE(n_components=2, init=init, random_state=42)\nX_tsne = tsne.fit_transform(X_scaled)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.manifold import TSNE\n\nbest_divergence = float('inf')\nbest_embedding = None\n\nfor i in range(5):\n    tsne = TSNE(n_components=2, random_state=i, n_iter=1000)\n    X_tsne = tsne.fit_transform(X_scaled)\n    \n    # t-SNE stores KL divergence in kl_divergence_\n    if tsne.kl_divergence_ < best_divergence:\n        best_divergence = tsne.kl_divergence_\n        best_embedding = X_tsne\n\nprint(f\"Best KL divergence: {best_divergence:.4f}\")\n# Visualize best_embedding"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.model_selection import train_test_split\n\n# Stratified subsample: 10,000 points keeping class ratios\nX_train, _, y_train, _ = train_test_split(\n    X_scaled, y,\n    train_size=10000,\n    stratify=y,\n    random_state=42\n)\n\n# Run t-SNE on subset\ntsne = TSNE(n_components=2, random_state=42)\nX_tsne_subset = tsne.fit_transform(X_train)\n\n# Project held-out points using nearest neighbors\nfrom sklearn.neighbors import NearestNeighbors\n\nknn = NearestNeighbors(n_neighbors=3)\nknn.fit(X_train)\n\ndistances, indices = knn.kneighbors(X_scaled)\n\n# Average t-SNE embeddings of k nearest neighbors\nX_tsne_full = np.zeros((len(X_scaled), 2))\nfor i, (dist, idx) in enumerate(zip(distances, indices)):\n    weights = 1 / (dist + 1e-8)\n    weights /= weights.sum()\n    X_tsne_full[i] = np.average(X_tsne_subset[idx], axis=0, weights=weights)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Pseudocode for HSNE\n# 1. Cluster data with k-means into 100 clusters\n# 2. Create cluster-level representation (centroids)\n# 3. Run t-SNE on centroids (100 points - very fast)\n# 4. For each point, project to the t-SNE space of its cluster centroid\n# 5. Optional: zoom into individual clusters with t-SNE\n\nfrom sklearn.cluster import KMeans\n\n# Level 1: Cluster-level visualization\nkmeans = KMeans(n_clusters=100, random_state=42)\ncluster_labels = kmeans.fit_predict(X_scaled)\ncentroids = kmeans.cluster_centers_\n\n# t-SNE on centroids (fast, only 100 points)\ntsne = TSNE(n_components=2, random_state=42)\ncentroids_tsne = tsne.fit_transform(centroids)\n\n# Project all points to cluster centroids' t-SNE positions\nX_hsne = centroids_tsne[cluster_labels]\n\n# Optional: add local noise to separate points within clusters\nnp.random.seed(42)\nX_hsne += np.random.normal(0, 0.1, X_hsne.shape)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# This requires a deep learning framework like TensorFlow\n# Pseudocode:\n# 1. Run standard t-SNE on a sample to get target embeddings\n# 2. Train a neural network: X_high -> X_low to match t-SNE embeddings\n# 3. Apply network to full dataset\n# 4. Benefits: orders of magnitude faster, generalizes to new data\n\n# In practice, libraries like openTSNE provide this functionality\nfrom openTSNE import TSNE\n\n# Parametric t-SNE\ntsne = TSNE(n_components=2, perplexity=30, n_jobs=-1)\nX_tsne_fast = tsne.fit(X_scaled)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from umap import UMAP\nfrom sklearn.manifold import TSNE\nimport time\n\n# Compare t-SNE and UMAP on the same data\nstart = time.time()\ntsne = TSNE(n_components=2, random_state=42)\nX_tsne = tsne.fit_transform(X_scaled)\ntime_tsne = time.time() - start\n\nstart = time.time()\numap = UMAP(n_components=2, random_state=42)\nX_umap = umap.fit_transform(X_scaled)\ntime_umap = time.time() - start\n\nprint(f\"t-SNE: {time_tsne:.2f}s\")\nprint(f\"UMAP: {time_umap:.2f}s\")\nprint(f\"Speedup: {time_tsne / time_umap:.1f}x\")\n\n# Visualize both\nfig, axes = plt.subplots(1, 2, figsize=(12, 5))\n\naxes[0].scatter(X_tsne[:, 0], X_tsne[:, 1], c=y, cmap='tab10', s=20, alpha=0.7)\naxes[0].set_title('t-SNE')\n\naxes[1].scatter(X_umap[:, 0], X_umap[:, 1], c=y, cmap='tab10', s=20, alpha=0.7)\naxes[1].set_title('UMAP')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# After t-SNE visualization, validate with clustering metrics\nfrom sklearn.metrics import silhouette_score, davies_bouldin_score\n\n# Run k-means on original high-dimensional data\nkmeans = KMeans(n_clusters=10)\nlabels = kmeans.fit_predict(X_scaled)\n\n# Evaluate clustering quality\nsil_score = silhouette_score(X_scaled, labels)\ndb_score = davies_bouldin_score(X_scaled, labels)\n\nprint(f\"Silhouette Score: {sil_score:.3f}\")\nprint(f\"Davies-Bouldin Index: {db_score:.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# For each point, check if t-SNE neighbors are also high-D neighbors\nfrom sklearn.neighbors import NearestNeighbors\n\nknn_high = NearestNeighbors(n_neighbors=10)\nknn_high.fit(X_scaled)\n_, neighbors_high = knn_high.kneighbors(X_scaled)\n\nknn_low = NearestNeighbors(n_neighbors=10)\nknn_low.fit(X_tsne)\n_, neighbors_low = knn_low.kneighbors(X_tsne)\n\n# Compute overlap: how many of the 10 nearest neighbors match?\noverlaps = []\nfor i in range(len(X_scaled)):\n    overlap = len(set(neighbors_high[i]) & set(neighbors_low[i]))\n    overlaps.append(overlap)\n\navg_overlap = np.mean(overlaps)\nprint(f\"Average neighbor overlap: {avg_overlap:.1f}/10\")"
        ]
      ]
    },
