          "python",
          "import torch\nimport torch.nn as nn\n\n# Simplified multimodal embedding model\nclass MultimodalEmbedding(nn.Module):\n    def __init__(self, text_vocab_size, embedding_dim=128):\n        super().__init__()\n        self.text_embed = nn.Embedding(text_vocab_size, embedding_dim)\n        self.image_proj = nn.Linear(64, embedding_dim)  # Assume 64D image features\n        self.text_proj = nn.Linear(embedding_dim, embedding_dim)\n    \n    def embed_text(self, text_ids):\n        # Average word embeddings\n        embedded = self.text_embed(text_ids)\n        return self.text_proj(embedded.mean(dim=1))\n    \n    def embed_image(self, image_features):\n        return self.image_proj(image_features)\n\n# Create dummy data\nn_samples = 100\ntext_vocab = 1000\nimage_features = torch.randn(n_samples, 64)\ntext_ids = torch.randint(0, text_vocab, (n_samples, 10))\n\nmodel = MultimodalEmbedding(text_vocab, embedding_dim=128)\n\n# Embed both modalities\nimage_embeddings = model.embed_image(image_features)\ntext_embeddings = model.embed_text(text_ids)\n\nprint(f\"Image embeddings shape: {image_embeddings.shape}\")\nprint(f\"Text embeddings shape: {text_embeddings.shape}\")\n\n# Similarity between images and text in shared space\nsimilarity_matrix = torch.nn.functional.cosine_similarity(\n    image_embeddings.unsqueeze(1),\n    text_embeddings.unsqueeze(0),\n    dim=2\n)\n\nprint(f\"Image-text similarity shape: {similarity_matrix.shape}\")\nprint(f\"Most similar image-text pair similarity: {similarity_matrix.max().item():.3f}\")"
        ]
      ]
