          "python",
          "from gensim.models import Word2Vec\nfrom nltk.tokenize import sent_tokenize, word_tokenize\nimport nltk\n\n# Download tokenizer\ntry:\n    nltk.data.find('tokenizers/punkt')\nexcept LookupError:\n    nltk.download('punkt', quiet=True)\n\n# Training corpus\ncorpus = \"\"\"\n    Machine learning is a subset of artificial intelligence that enables \n    systems to learn from data. Deep learning uses neural networks with multiple layers.\n    Natural language processing helps computers understand human language.\n    Computer vision enables machines to see and interpret images.\n    Data science combines statistics programming and domain expertise.\n    Artificial intelligence is transforming technology and society.\n    Neural networks are inspired by biological neurons in the brain.\n    Supervised learning requires labeled training data to learn patterns.\n\"\"\".lower()\n\n# Tokenize\nsentences = []\nfor sent in sent_tokenize(corpus):\n    tokens = [word.lower() for word in word_tokenize(sent) if word.isalpha()]\n    sentences.append(tokens)\n\n# Train Word2Vec\nword2vec = Word2Vec(sentences, vector_size=100, window=5, min_count=1, workers=4, seed=42)\n\nprint(f\"Vocabulary size: {len(word2vec.wv)}\")\nprint(f\"'learning' embedding shape: {word2vec.wv['learning'].shape}\")\n\n# Find similar words\nprint(\"\\nSimilar to 'learning':\")\nfor word, score in word2vec.wv.most_similar('learning', topn=5):\n    print(f\"  {word}: {score:.3f}\")\n\n# Analogies\nprint(\"\\nAnalogies (machine : learning :: computer : ?):\")\ntry:\n    similar = word2vec.wv.most_similar(positive=['computer'], topn=3)\n    for word, score in similar:\n        print(f\"  {word}: {score:.3f}\")\nexcept:\n    print(\"  (insufficient vocabulary)\")\n\n# Vector arithmetic: learning + intelligence - machine \u2248 ?\ntry:\n    result = word2vec.wv.most_similar(positive=['learning', 'intelligence'], negative=['machine'], topn=3)\n    print(\"\\nLearning + intelligence - machine \u2248:\")\n    for word, score in result:\n        print(f\"  {word}: {score:.3f}\")\nexcept:\n    print(\"(semantic arithmetic skipped)\")"
        ]
      ]
