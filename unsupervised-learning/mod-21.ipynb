          "python",
          "from sklearn.feature_extraction.text import CountVectorizer\nfrom sklearn.decomposition import LatentDirichletAllocation\n\n# Sample documents (news articles)\ndocuments = [\n    \"Bitcoin cryptocurrency blockchain technology\",\n    \"Stock market investment portfolio trading\",\n    \"COVID vaccine health pandemic disease\",\n    \"Climate change environmental sustainability green\",\n    \"Machine learning AI neural networks algorithm\",\n    \"Python programming software development coding\",\n    \"Election politics government president congress\",\n    \"Renewable energy solar wind power\",\n    \"Deep learning convolutional neural network image\",\n    \"Data science analytics statistics models\"\n]\n\n# Create document-term matrix\nvectorizer = CountVectorizer(max_features=50, stop_words='english', lowercase=True)\ndoc_term_matrix = vectorizer.fit_transform(documents)\n\nprint(f\"Document-term matrix shape: {doc_term_matrix.shape}\")\nprint(f\"Total terms: {len(vectorizer.get_feature_names_out())}\")\n\n# Train LDA\nn_topics = 3\nlda = LatentDirichletAllocation(n_components=n_topics, random_state=42, max_iter=50)\nlda.fit(doc_term_matrix)\n\n# Display topics\nfeature_names = vectorizer.get_feature_names_out()\nprint(f\"\\nDiscovered {n_topics} topics:\\n\")\n\nfor topic_idx in range(n_topics):\n    top_indices = lda.components_[topic_idx].argsort()[-5:][::-1]\n    top_words = [feature_names[i] for i in top_indices]\n    print(f\"Topic {topic_idx}: {', '.join(top_words)}\")\n\n# Document-topic distribution\ndoc_topics = lda.transform(doc_term_matrix)\nprint(f\"\\nDocument 0 topic distribution: {doc_topics[0]}\")\nprint(f\"Document 0 primary topic: {np.argmax(doc_topics[0])}\")\n\n# Perplexity (lower is better)\nperplexity = lda.perplexity(doc_term_matrix)\nprint(f\"Perplexity: {perplexity:.2f}\")"
        ]
      ]
