          "python",
          "from sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.cluster import DBSCAN\nfrom sklearn.metrics.pairwise import cosine_similarity\n\n# Documents\ntexts = [\n    \"Python is a programming language for data science\",\n    \"Java and C++ are compiled programming languages\",\n    \"Machine learning requires linear algebra and statistics\",\n    \"Deep learning uses convolutional and recurrent networks\",\n    \"Clustering groups similar data points together\",\n    \"Classification assigns labels to data\",\n    \"Natural language processing analyzes text\",\n    \"Computer vision processes images\"\n]\n\n# TF-IDF vectorization\nvectorizer = TfidfVectorizer(stop_words='english', max_features=50)\ntfidf_matrix = vectorizer.fit_transform(texts)\n\nprint(f\"TF-IDF matrix shape: {tfidf_matrix.shape}\")\n\n# Compute pairwise similarity\nsimilarity = cosine_similarity(tfidf_matrix)\n\n# Convert similarity to distance for clustering\ndistance = 1 - similarity\n\n# Cluster with DBSCAN\ndbscan = DBSCAN(eps=0.3, min_samples=1)\ncluster_labels = dbscan.fit_predict(distance)\n\nprint(f\"Number of clusters: {len(set(cluster_labels))}\")\nprint(f\"Cluster assignments: {cluster_labels}\")\n\n# Show clusters\nfor cluster_id in sorted(set(cluster_labels)):\n    indices = np.where(cluster_labels == cluster_id)[0]\n    print(f\"\\nCluster {cluster_id}:\")\n    for idx in indices:\n        print(f\"  {texts[idx]}\")"
