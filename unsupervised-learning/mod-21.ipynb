          "python",
          "import torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\nclass ContrastiveImageEncoder(nn.Module):\n    def __init__(self, embedding_dim=256):\n        super().__init__()\n        # Simple CNN\n        self.conv1 = nn.Conv2d(1, 32, kernel_size=3, padding=1)\n        self.conv2 = nn.Conv2d(32, 64, kernel_size=3, padding=1)\n        self.pool = nn.MaxPool2d(2)\n        self.fc = nn.Linear(64 * 4 * 4, embedding_dim)\n    \n    def forward(self, x):\n        x = self.pool(F.relu(self.conv1(x)))\n        x = self.pool(F.relu(self.conv2(x)))\n        x = x.view(x.size(0), -1)\n        x = self.fc(x)\n        return F.normalize(x, dim=1)\n\n# Simulate digit pairs\nfrom sklearn.datasets import load_digits\ndigits_data = load_digits()\nX = torch.FloatTensor(digits_data.data.reshape(-1, 1, 8, 8)) / 255\n\nencoder = ContrastiveImageEncoder(embedding_dim=128)\n\n# Get embeddings\nembeddings = encoder(X[:100])\nprint(f\"Embeddings shape: {embeddings.shape}\")\n\n# Same-digit pairs are similar\nprint(f\"Embedding norm (should be ~1): {embeddings[0].norm().item():.3f}\")"
        ]
