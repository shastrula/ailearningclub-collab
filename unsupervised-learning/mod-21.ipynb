        [
          "python",
          "import numpy as np\nfrom sklearn.datasets import load_digits\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.decomposition import PCA\nfrom sklearn.cluster import KMeans\nimport matplotlib.pyplot as plt\n\n# Load handwritten digit images (8x8 pixels)\ndigits = load_digits()\nX, y = digits.data, digits.target  # 1797 images, 64 features each\n\n# Standardize\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\n# Extract features via PCA (simulate transfer learning)\npca = PCA(n_components=30, random_state=42)\nX_features = pca.fit_transform(X_scaled)\n\nprint(f\"Original shape: {X.shape} \u2192 PCA features: {X_features.shape}\")\nprint(f\"Variance explained: {pca.explained_variance_ratio_.sum():.1%}\")\n\n# Cluster using KMeans\nkmeans = KMeans(n_clusters=10, random_state=42, n_init=10)\ncluster_labels = kmeans.fit_predict(X_features)\n\n# Evaluate: each digit should map to one cluster\nfrom sklearn.metrics import adjusted_rand_score, homogeneity_score\nari = adjusted_rand_score(y, cluster_labels)\nhomogeneity = homogeneity_score(y, cluster_labels)\n\nprint(f\"Adjusted Rand Index: {ari:.3f} (1.0 = perfect, 0 = random)\")\nprint(f\"Homogeneity: {homogeneity:.3f}\")\n\n# Visualize: show cluster centers\nfig, axes = plt.subplots(2, 5, figsize=(10, 5))\nfor i in range(10):\n    # Reconstruct center from PCA features \u2192 original pixel space\n    center_pca = kmeans.cluster_centers_[i]\n    center_pixels = pca.inverse_transform(center_pca.reshape(1, -1))\n    center_pixels = scaler.inverse_transform(center_pixels)\n    \n    image = center_pixels.reshape(8, 8)\n    axes[i // 5, i % 5].imshow(image, cmap='gray')\n    axes[i // 5, i % 5].set_title(f\"Cluster {i}\")\n    axes[i // 5, i % 5].axis('off')\n\nprint(f\"Cluster sizes: {np.bincount(cluster_labels)}\")"
        ]
      ]
    },
    {
