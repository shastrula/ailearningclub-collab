      "outputs": [],
      "source": [
        [
          "python",
          "Explained Variance Ratio = \u03a3(\u03bb\u2081 + ... + \u03bb\u2096) / \u03a3(\u03bb\u2081 + ... + \u03bb_d)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom sklearn.datasets import load_iris\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.decomposition import PCA\nimport matplotlib.pyplot as plt\n\n# Load data\niris = load_iris()\nX = iris.data\ny = iris.target\n\n# Standardize features (CRITICAL: PCA is sensitive to feature scaling)\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\n# Apply PCA with 2 components\npca = PCA(n_components=2)\nX_pca = pca.fit_transform(X_scaled)\n\n# Check explained variance\nprint(f\"Explained variance ratio: {pca.explained_variance_ratio_}\")\nprint(f\"Cumulative variance: {np.cumsum(pca.explained_variance_ratio_)}\")\n\n# Plot results\nplt.figure(figsize=(8, 6))\nscatter = plt.scatter(X_pca[:, 0], X_pca[:, 1], c=y, cmap='viridis', s=50, alpha=0.7)\nplt.xlabel(f'PC1 ({pca.explained_variance_ratio_[0]:.1%} variance)')\nplt.ylabel(f'PC2 ({pca.explained_variance_ratio_[1]:.1%} variance)')\nplt.colorbar(scatter)\nplt.title('Iris Dataset - PCA Projection')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.decomposition import PCA\n\n# Fit PCA with all components\npca = PCA()\npca.fit(X_scaled)\n\n# Find number of components for 95% variance\ncumsum = np.cumsum(pca.explained_variance_ratio_)\nn_components = np.argmax(cumsum >= 0.95) + 1\nprint(f\"Components needed for 95% variance: {n_components}\")\n\n# Refit with optimal number\npca_optimal = PCA(n_components=n_components)\nX_reduced = pca_optimal.fit_transform(X_scaled)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Get loadings (components)\nloadings = pca.components_\n\n# Create a dataframe for interpretation\nimport pandas as pd\nloadings_df = pd.DataFrame(\n    loadings.T,\n    columns=[f'PC{i+1}' for i in range(loadings.shape[0])],\n    index=iris.feature_names\n)\n\nprint(loadings_df)\n# Positive values: feature increases along this component\n# Negative values: feature decreases along this component\n# Larger absolute values: feature has more influence on this component"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Standard workflow: always scale first\nX_centered = X - X.mean(axis=0)  # Manual centering\nX_scaled = (X_centered) / X_centered.std(axis=0)  # Manual scaling\n\n# Or use sklearn's StandardScaler (recommended)\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Project and reconstruct\nX_pca = pca.transform(X_scaled)\nX_reconstructed = pca.inverse_transform(X_pca)\n\n# Calculate reconstruction error (Mean Squared Error)\nmse = np.mean((X_scaled - X_reconstructed) ** 2)\nprint(f\"Reconstruction MSE: {mse:.4f}\")\n\n# More components = less error\nfor n_comp in [1, 2, 5, 10]:\n    pca_temp = PCA(n_components=n_comp)\n    X_temp = pca_temp.fit_transform(X_scaled)\n    X_recon = pca_temp.inverse_transform(X_temp)\n    error = np.mean((X_scaled - X_recon) ** 2)\n    print(f\"n_components={n_comp}: MSE={error:.4f}\")"
        ]
      ]
    }
