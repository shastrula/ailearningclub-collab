        [
          "python",
          "from sklearn.cluster import Birch\nfrom sklearn.datasets import load_iris\nfrom sklearn.preprocessing import StandardScaler\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Load data\niris = load_iris()\nX = iris.data\nX_scaled = StandardScaler().fit_transform(X)\n\n# BIRCH clustering with different cluster counts\nn_clusters_range = [3, 4, 5]\nfig, axes = plt.subplots(1, 3, figsize=(14, 4))\n\nfor ax, n_clusters in zip(axes, n_clusters_range):\n    birch = Birch(n_clusters=n_clusters, threshold=1.5, branching_factor=50)\n    labels = birch.fit_predict(X_scaled)\n    \n    # Visualize first two features\n    scatter = ax.scatter(X_scaled[:, 0], X_scaled[:, 1], c=labels, \n                        cmap='viridis', s=50, alpha=0.6)\n    ax.scatter(birch.cluster_centers_[:, 0], birch.cluster_centers_[:, 1],\n              c='red', marker='X', s=200, edgecolors='black', linewidth=2)\n    ax.set_title(f'BIRCH (n_clusters={n_clusters})')\n    ax.set_xlabel('Feature 0')\n    ax.set_ylabel('Feature 1')\n\nplt.tight_layout()\nplt.show()\n\n# Compare BIRCH with standard hierarchical clustering\nfrom scipy.cluster.hierarchy import linkage, fcluster\n\nZ_ward = linkage(X_scaled, method='ward')\nlabels_hierarchical = fcluster(Z_ward, t=3, criterion='maxclust') - 1\n\nbirch_model = Birch(n_clusters=3, threshold=1.5)\nlabels_birch = birch_model.fit_predict(X_scaled)\n\nprint(f\"Hierarchical clustering sizes: {np.bincount(labels_hierarchical)}\")\nprint(f\"BIRCH clustering sizes: {np.bincount(labels_birch)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from scipy.cluster.hierarchy import linkage, dendrogram, fcluster\nfrom sklearn.metrics import silhouette_score, davies_bouldin_score\nfrom sklearn.datasets import make_blobs\nfrom sklearn.preprocessing import StandardScaler\n\n# Generate test data\nX, true_labels = make_blobs(n_samples=150, centers=3, n_features=2, random_state=42)\nX_scaled = StandardScaler().fit_transform(X)\n\n# Compare linkage methods\nmethods = ['single', 'complete', 'average', 'ward']\nscores = {'method': [], 'silhouette': [], 'davies_bouldin': []}\n\nfig, axes = plt.subplots(2, 2, figsize=(12, 10))\n\nfor ax, method in zip(axes.flat, methods):\n    Z = linkage(X_scaled, method=method)\n    labels = fcluster(Z, t=3, criterion='maxclust') - 1\n    \n    sil_score = silhouette_score(X_scaled, labels)\n    db_score = davies_bouldin_score(X_scaled, labels)\n    \n    scores['method'].append(method)\n    scores['silhouette'].append(sil_score)\n    scores['davies_bouldin'].append(db_score)\n    \n    dendrogram(Z, ax=ax, no_labels=True)\n    ax.axhline(y=10, c='red', linestyle='--')\n    ax.set_title(f'{method.capitalize()}\\nSilhouette: {sil_score:.3f}, DB: {db_score:.3f}')\n\nplt.tight_layout()\nplt.show()\n\n# Summary\nimport pandas as pd\ndf_scores = pd.DataFrame(scores)\nprint(df_scores.to_string(index=False))\nprint(\"\\nHigher silhouette is better; lower DB-index is better\")"
        ]
      ]
    },
    {
