        [
          "python",
          "from sklearn.metrics import silhouette_score, davies_bouldin_score, calinski_harabasz_score\nfrom scipy.cluster.hierarchy import linkage, fcluster\n\n# Generate data\nX, true_labels = make_blobs(n_samples=200, centers=4, n_features=2, random_state=42)\nX_scaled = StandardScaler().fit_transform(X)\n\n# Hierarchical clustering\nZ = linkage(X_scaled, method='ward')\n\n# Evaluate across different numbers of clusters\nn_clusters_range = range(2, 11)\nsilhouette_scores = []\ndavies_bouldin_scores = []\ncalinski_harabasz_scores = []\n\nfor n_clusters in n_clusters_range:\n    labels = fcluster(Z, t=n_clusters, criterion='maxclust') - 1\n    \n    sil = silhouette_score(X_scaled, labels)\n    db = davies_bouldin_score(X_scaled, labels)\n    ch = calinski_harabasz_score(X_scaled, labels)\n    \n    silhouette_scores.append(sil)\n    davies_bouldin_scores.append(db)\n    calinski_harabasz_scores.append(ch)\n\n# Plot validation metrics\nfig, axes = plt.subplots(1, 3, figsize=(14, 4))\n\naxes[0].plot(n_clusters_range, silhouette_scores, 'bo-')\naxes[0].set_xlabel('Number of Clusters')\naxes[0].set_ylabel('Silhouette Score')\naxes[0].set_title('Silhouette Score (Higher is Better)')\naxes[0].grid(True)\n\naxes[1].plot(n_clusters_range, davies_bouldin_scores, 'ro-')\naxes[1].set_xlabel('Number of Clusters')\naxes[1].set_ylabel('Davies-Bouldin Index')\naxes[1].set_title('Davies-Bouldin Index (Lower is Better)')\naxes[1].grid(True)\n\naxes[2].plot(n_clusters_range, calinski_harabasz_scores, 'go-')\naxes[2].set_xlabel('Number of Clusters')\naxes[2].set_ylabel('Calinski-Harabasz Index')\naxes[2].set_title('Calinski-Harabasz Index (Higher is Better)')\naxes[2].grid(True)\n\nplt.tight_layout()\nplt.show()\n\n# Find optimal k by each metric\noptimal_k_sil = n_clusters_range[np.argmax(silhouette_scores)]\noptimal_k_db = n_clusters_range[np.argmin(davies_bouldin_scores)]\noptimal_k_ch = n_clusters_range[np.argmax(calinski_harabasz_scores)]\n\nprint(f\"Optimal k by silhouette: {optimal_k_sil}\")\nprint(f\"Optimal k by Davies-Bouldin: {optimal_k_db}\")\nprint(f\"Optimal k by Calinski-Harabasz: {optimal_k_ch}\")"
        ]
      ]
    },
