        [
          "python",
          "# Example: Two-level hierarchical clustering\nfrom sklearn.cluster import KMeans\nfrom scipy.cluster.hierarchy import linkage, dendrogram, fcluster\n\n# Generate large dataset\nn_samples = 5000\nX_large = np.random.randn(n_samples, 10)\n\n# Step 1: K-Means for coarse clustering\nkmeans = KMeans(n_clusters=20, random_state=42)\ncoarse_labels = kmeans.fit_predict(X_large)\n\n# Step 2: Hierarchical cluster within each coarse cluster\nfig, ax = plt.subplots(figsize=(10, 6))\n\nrefined_labels = np.zeros(n_samples)\nfor coarse_cluster in range(20):\n    mask = coarse_labels == coarse_cluster\n    X_subset = X_large[mask]\n    \n    if len(X_subset) > 1:\n        Z = linkage(X_subset, method='ward')\n        fine_labels = fcluster(Z, t=3, criterion='maxclust')\n        # Map back to full dataset\n        refined_labels[mask] = coarse_cluster * 100 + fine_labels\n\nprint(f\"Original dataset: {n_samples} points\")\nprint(f\"Coarse clusters: {len(np.unique(coarse_labels))}\")\nprint(f\"Refined clusters: {len(np.unique(refined_labels))}\")\nprint(f\"Time: Much faster than full hierarchical clustering!\")"
        ]
      ]
    }
