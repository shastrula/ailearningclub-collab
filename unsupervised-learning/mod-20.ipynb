      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom sklearn.decomposition import TruncatedSVD\nimport pandas as pd\n\n# Create a user-item rating matrix (rows=users, cols=items)\n# Sparse: users rate few movies\nnp.random.seed(42)\nn_users, n_items = 100, 50\nratings = np.random.randint(1, 6, (n_users, n_items))\nratings[np.random.rand(n_users, n_items) > 0.3] = 0  # Make sparse (~70% missing)\n\nprint(f\"Sparsity: {(ratings == 0).sum() / (n_users * n_items):.1%}\")\n\n# SVD decomposition\nsvd = TruncatedSVD(n_components=10, random_state=42)\nU = svd.fit_transform(ratings)  # User factors\nV = svd.components_.T  # Item factors\n\n# Reconstruct: Approximated ratings = U @ V^T\nratings_approx = U @ V.T\n\nprint(f\"Original shape: {ratings.shape}\")\nprint(f\"User factors: {U.shape}, Item factors: {V.shape}\")\n\n# Evaluate on non-zero entries\nmask = ratings > 0\nmae = np.mean(np.abs(ratings[mask] - ratings_approx[mask]))\nprint(f\"MAE on observed ratings: {mae:.2f}\")\n\n# Recommend for user 0: unrated items with highest predicted scores\nuser_0_scores = ratings_approx[0]\nuser_0_rated = np.where(ratings[0] > 0)[0]\nrecommendations = np.argsort(user_0_scores)[::-1][:5]\nprint(f\"\\nTop 5 recommendations for user 0:\")\nfor i, item_id in enumerate(recommendations, 1):\n    print(f\"  {i}. Item {item_id} (predicted score: {user_0_scores[item_id]:.2f})\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
