      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.decomposition import NMF\n\n# NMF on rating matrix\nnmf = NMF(n_components=10, init='random', random_state=42, max_iter=500)\nU_nmf = nmf.fit_transform(ratings)  # User latent factors\nV_nmf = nmf.components_.T  # Item latent factors\n\n# Reconstruct\nratings_nmf = U_nmf @ V_nmf.T\n\n# Evaluate\nmask = ratings > 0\nmae_nmf = np.mean(np.abs(ratings[mask] - ratings_nmf[mask]))\nprint(f\"NMF MAE: {mae_nmf:.2f}\")\n\n# NMF factors are interpretable (non-negative weights)\nprint(f\"User 0 latent factors (top 3): {np.argsort(U_nmf[0])[::-1][:3]}\")\nprint(f\"  Scores: {U_nmf[0, np.argsort(U_nmf[0])[::-1][:3]]}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport torch.nn as nn\nfrom torch.optim import Adam\n\n# Simulated user-item interactions (implicit feedback)\nn_users, n_items = 50, 30\ninteractions = np.random.randint(0, 2, (n_users, n_items))  # 1 = interacted, 0 = not\n\n# Convert to (user_id, item_id, interaction) format\nuser_ids, item_ids = np.where(interactions > 0)\ninteractions_data = np.column_stack([user_ids, item_ids, interactions[user_ids, item_ids]])\n\nprint(f\"Total interactions: {len(interactions_data)}\")\n\n# Simple embedding model\nclass EmbeddingRecommender(nn.Module):\n    def __init__(self, n_users, n_items, embedding_dim=10):\n        super().__init__()\n        self.user_embed = nn.Embedding(n_users, embedding_dim)\n        self.item_embed = nn.Embedding(n_items, embedding_dim)\n    \n    def forward(self, user_ids, item_ids):\n        user_vec = self.user_embed(user_ids)\n        item_vec = self.item_embed(item_ids)\n        scores = (user_vec * item_vec).sum(dim=1)\n        return torch.sigmoid(scores)\n\nmodel = EmbeddingRecommender(n_users, n_items, embedding_dim=8)\noptimizer = Adam(model.parameters(), lr=0.01)\nloss_fn = nn.BCELoss()\n\n# Train\nfor epoch in range(50):\n    user_tensor = torch.LongTensor(interactions_data[:, 0])\n    item_tensor = torch.LongTensor(interactions_data[:, 1])\n    labels = torch.FloatTensor(interactions_data[:, 2])\n    \n    scores = model(user_tensor, item_tensor)\n    loss = loss_fn(scores, labels)\n    \n    optimizer.zero_grad()\n    loss.backward()\n    optimizer.step()\n    \n    if (epoch + 1) % 10 == 0:\n        print(f\"Epoch {epoch + 1}: Loss = {loss.item():.4f}\")\n\n# Get recommendations: user 0 vs all items\nuser_0_tensor = torch.LongTensor([0] * n_items)\nitem_all_tensor = torch.LongTensor(range(n_items))\nwith torch.no_grad():\n    scores = model(user_0_tensor, item_all_tensor).numpy()\n\ntop_items = np.argsort(scores)[::-1][:5]\nprint(f\"\\nTop 5 items for user 0: {top_items}\")"
        ]
      ]
    },
    {
