        [
          "python",
          "# Hybrid recommendation with item features\n# Assume we have item genres (one-hot encoded)\nitem_features = np.random.randint(0, 2, (n_items, 5))  # 5 genres\n\n# Combine embeddings with content features\nclass HybridRecommender(nn.Module):\n    def __init__(self, n_users, n_items, embedding_dim=8, feature_dim=5):\n        super().__init__()\n        self.user_embed = nn.Embedding(n_users, embedding_dim)\n        self.item_embed = nn.Embedding(n_items, embedding_dim)\n        self.feature_proj = nn.Linear(feature_dim, embedding_dim)\n    \n    def forward(self, user_ids, item_ids, item_feats=None):\n        user_vec = self.user_embed(user_ids)\n        item_vec = self.item_embed(item_ids)\n        \n        # Hybrid: embeddings + content features\n        if item_feats is not None:\n            feat_vec = self.feature_proj(item_feats)\n            item_vec = item_vec + 0.3 * feat_vec\n        \n        scores = (user_vec * item_vec).sum(dim=1)\n        return torch.sigmoid(scores)\n\n# For a cold-start item (new movie), use genre features\nhybrid_model = HybridRecommender(n_users, n_items, embedding_dim=8, feature_dim=5)\nprint(\"Hybrid model handles cold-start via content features\")\n\n# Recommend cold-start item to user 0\ncold_item_features = torch.FloatTensor(item_features[0])\nuser_0_cold = torch.LongTensor([0])\nitem_0_cold = torch.LongTensor([0])\n\nwith torch.no_grad():\n    score = hybrid_model(user_0_cold, item_0_cold, cold_item_features.unsqueeze(0))\n    print(f\"Predicted score for new item: {score.item():.3f}\")"
        ]
      ]
    },
    {
