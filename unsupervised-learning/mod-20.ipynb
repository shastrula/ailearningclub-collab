        [
          "python",
          "def ndcg_score(y_true, y_scores, k=10):\n    \"\"\"Compute NDCG@k\"\"\"\n    order = np.argsort(y_scores)[::-1]\n    y_true_sorted = y_true[order[:k]]\n    \n    # DCG: sum(rel_i / log2(i+2))\n    dcg = np.sum(y_true_sorted / np.log2(np.arange(2, k + 2)))\n    \n    # IDCG: best possible DCG\n    idcg = np.sum(np.sort(y_true)[::-1][:k] / np.log2(np.arange(2, k + 2)))\n    \n    return dcg / idcg if idcg > 0 else 0\n\ndef map_score(y_true, y_scores, k=10):\n    \"\"\"Compute MAP@k\"\"\"\n    order = np.argsort(y_scores)[::-1][:k]\n    y_true_at_k = y_true[order]\n    \n    # Precision at each relevant item\n    precision_sum = 0\n    num_relevant = 0\n    for i, rel in enumerate(y_true_at_k):\n        if rel > 0:\n            num_relevant += 1\n            precision_sum += num_relevant / (i + 1)\n    \n    return precision_sum / max(1, np.sum(y_true)) if np.sum(y_true) > 0 else 0\n\n# Example: user preferences (1=liked, 0=no interaction)\ny_true = np.array([1, 1, 0, 1, 0, 0, 1, 0, 0, 0])\ny_scores = np.array([0.9, 0.8, 0.7, 0.6, 0.5, 0.4, 0.3, 0.2, 0.1, 0.05])\n\nndcg = ndcg_score(y_true, y_scores, k=5)\nmap_val = map_score(y_true, y_scores, k=5)\n\nprint(f\"NDCG@5: {ndcg:.3f}\")\nprint(f\"MAP@5: {map_val:.3f}\")"
        ]
      ]
