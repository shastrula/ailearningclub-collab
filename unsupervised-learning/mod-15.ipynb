      "source": [
        [
          "python",
          "from sklearn.metrics import davies_bouldin_score\n\n# Compare clustering quality across different k values\nk_values = range(2, 10)\ndb_scores = []\nsil_scores = []\n\nfor k in k_values:\n    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n    labels = kmeans.fit_predict(X_good)\n    \n    db_score = davies_bouldin_score(X_good, labels)\n    sil_score = silhouette_score(X_good, labels)\n    \n    db_scores.append(db_score)\n    sil_scores.append(sil_score)\n\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\n# Davies-Bouldin (lower is better)\naxes[0].plot(k_values, db_scores, 'o-', linewidth=2, markersize=8)\naxes[0].set_xlabel('Number of Clusters (k)')\naxes[0].set_ylabel('Davies-Bouldin Index')\naxes[0].set_title('DB Index vs. k (Lower is Better)')\naxes[0].grid(True, alpha=0.3)\n\n# Silhouette (higher is better)\naxes[1].plot(k_values, sil_scores, 'o-', linewidth=2, markersize=8, color='orange')\naxes[1].set_xlabel('Number of Clusters (k)')\naxes[1].set_ylabel('Silhouette Score')\naxes[1].set_title('Silhouette Score vs. k (Higher is Better)')\naxes[1].grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.show()\n\n# Find optimal k\noptimal_k_db = k_values[np.argmin(db_scores)]\noptimal_k_sil = k_values[np.argmax(sil_scores)]\n\nprint(f\"Optimal k by Davies-Bouldin: {optimal_k_db}\")\nprint(f\"Optimal k by Silhouette: {optimal_k_sil}\")"
        ]
      ]
    },
