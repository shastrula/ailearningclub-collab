        [
          "python",
          "from sklearn.metrics import calinski_harabasz_score\n\n# Compare metrics across different clusterings\nfig, axes = plt.subplots(2, 2, figsize=(12, 10))\n\ndatasets_eval = [\n    ('Well-Separated', X_good),\n    ('Overlapping', X_bad),\n]\n\nfor row, (name, X) in enumerate(datasets_eval):\n    X_scaled = scaler.fit_transform(X)\n    \n    k_values = range(2, 10)\n    metrics = {'CH': [], 'Silhouette': [], 'DB': []}\n    \n    for k in k_values:\n        kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n        labels = kmeans.fit_predict(X_scaled)\n        \n        metrics['CH'].append(calinski_harabasz_score(X_scaled, labels))\n        metrics['Silhouette'].append(silhouette_score(X_scaled, labels))\n        metrics['DB'].append(davies_bouldin_score(X_scaled, labels))\n    \n    # Plot Calinski-Harabasz (higher is better)\n    axes[row, 0].plot(k_values, metrics['CH'], 'o-', linewidth=2)\n    axes[row, 0].set_xlabel('k')\n    axes[row, 0].set_ylabel('Calinski-Harabasz')\n    axes[row, 0].set_title(f'{name} - CH Index (\u2191 better)')\n    axes[row, 0].grid(True, alpha=0.3)\n    \n    # Plot all three metrics normalized to [0,1]\n    ch_norm = (np.array(metrics['CH']) - min(metrics['CH'])) / (max(metrics['CH']) - min(metrics['CH']) + 1e-10)\n    sil_norm = (np.array(metrics['Silhouette']) - min(metrics['Silhouette'])) / (max(metrics['Silhouette']) - min(metrics['Silhouette']) + 1e-10)\n    db_norm = 1 - (np.array(metrics['DB']) - min(metrics['DB'])) / (max(metrics['DB']) - min(metrics['DB']) + 1e-10)\n    \n    axes[row, 1].plot(k_values, ch_norm, 'o-', label='CH Index', linewidth=2)\n    axes[row, 1].plot(k_values, sil_norm, 's-', label='Silhouette', linewidth=2)\n    axes[row, 1].plot(k_values, db_norm, '^-', label='Davies-Bouldin', linewidth=2)\n    axes[row, 1].set_xlabel('k')\n    axes[row, 1].set_ylabel('Normalized Score')\n    axes[row, 1].set_title(f'{name} - Metric Comparison')\n    axes[row, 1].legend()\n    axes[row, 1].grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.show()"
        ]
