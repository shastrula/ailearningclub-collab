          "python",
          "from sklearn.decomposition import PCA\nfrom sklearn.preprocessing import StandardScaler\n\n# Load data\nfrom sklearn.datasets import load_digits\n\nX = load_digits().data\ny = load_digits().target\n\n# Standardize\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\n# Vary number of components\ncomponents_range = range(1, 65)\nerrors = []\nvariances = []\n\nfor n_comp in components_range:\n    pca = PCA(n_components=n_comp)\n    X_reduced = pca.fit_transform(X_scaled)\n    X_recon = pca.inverse_transform(X_reduced)\n    \n    # Reconstruction error (MSE)\n    mse = np.mean((X_scaled - X_recon) ** 2)\n    errors.append(mse)\n    \n    # Cumulative variance explained\n    variances.append(np.sum(pca.explained_variance_ratio_))\n\n# Find elbow point (where error decrease slows)\n# Simple heuristic: second derivative\nerrors_array = np.array(errors)\nsecond_deriv = np.diff(errors_array, 2)\n\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\n# Reconstruction error vs components\naxes[0].plot(components_range, errors, 'o-', linewidth=2)\naxes[0].set_xlabel('Number of Components')\naxes[0].set_ylabel('Reconstruction MSE')\naxes[0].set_title('Reconstruction Error vs. Dimensionality')\naxes[0].grid(True, alpha=0.3)\n\n# Variance explained vs reconstruction error (Pareto frontier)\naxes[1].scatter(variances, errors, s=50, alpha=0.7)\naxes[1].set_xlabel('Explained Variance Ratio')\naxes[1].set_ylabel('Reconstruction MSE')\naxes[1].set_title('Information-Error Trade-off')\naxes[1].grid(True, alpha=0.3)\n\n# Mark 95% variance point\nidx_95 = np.argmax(np.array(variances) >= 0.95)\naxes[1].scatter(variances[idx_95], errors[idx_95], s=200, c='red', marker='*',\n               edgecolors='black', linewidth=2, label='95% variance')\naxes[1].legend()\n\nplt.tight_layout()\nplt.show()\n\nprint(f\"Components for 95% variance: {components_range[idx_95]}\")\nprint(f\"Reconstruction MSE at 95%: {errors[idx_95]:.4f}\")"
        ]
      ]
    },
