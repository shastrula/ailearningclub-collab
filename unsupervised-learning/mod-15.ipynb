          "python",
          "from scipy.spatial.distance import norm\nfrom sklearn.metrics import adjusted_rand_score\n\ndef stability_analysis(X, clustering_algo, n_perturbations=10, noise_level=0.01):\n    \"\"\"\n    Test clustering stability by:\n    1. Running clustering on original data\n    2. Adding noise and re-clustering\n    3. Measuring similarity (ARI score)\n    \"\"\"\n    \n    X_scaled = scaler.fit_transform(X)\n    \n    # Original clustering\n    labels_original = clustering_algo.fit_predict(X_scaled)\n    \n    # Perturbed clusterings\n    ari_scores = []\n    \n    for _ in range(n_perturbations):\n        # Add noise\n        noise = np.random.normal(0, noise_level, X_scaled.shape)\n        X_perturbed = X_scaled + noise\n        \n        # Cluster\n        labels_perturbed = clustering_algo.fit_predict(X_perturbed)\n        \n        # Compare (Adjusted Rand Index: 1 = identical, 0 = random)\n        ari = adjusted_rand_score(labels_original, labels_perturbed)\n        ari_scores.append(ari)\n    \n    return {\n        'mean_ari': np.mean(ari_scores),\n        'std_ari': np.std(ari_scores),\n        'ari_scores': ari_scores\n    }\n\n# Test stability for different noise levels\nnoise_levels = [0.005, 0.01, 0.02, 0.05]\nstability_results = {}\n\nkmeans = KMeans(n_clusters=3, random_state=42, n_init=10)\n\nfor noise in noise_levels:\n    result = stability_analysis(X_good, kmeans, n_perturbations=20, noise_level=noise)\n    stability_results[noise] = result\n\n# Visualize stability\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\n# Stability vs noise\nmeans = [stability_results[n]['mean_ari'] for n in noise_levels]\nstds = [stability_results[n]['std_ari'] for n in noise_levels]\n\naxes[0].errorbar(noise_levels, means, yerr=stds, marker='o', linewidth=2, markersize=8)\naxes[0].set_xlabel('Noise Level')\naxes[0].set_ylabel('Adjusted Rand Index')\naxes[0].set_title('Clustering Stability vs. Noise')\naxes[0].grid(True, alpha=0.3)\n\n# Distribution of ARI scores for one noise level\nari_dist = stability_results[0.02]['ari_scores']\naxes[1].hist(ari_dist, bins=10, alpha=0.7, edgecolor='black')\naxes[1].axvline(np.mean(ari_dist), color='red', linestyle='--', label='Mean')\naxes[1].set_xlabel('Adjusted Rand Index')\naxes[1].set_ylabel('Frequency')\naxes[1].set_title('ARI Distribution (noise=0.02)')\naxes[1].legend()\n\nplt.tight_layout()\nplt.show()\n\nprint(\"Stability Results:\")\nfor noise, result in stability_results.items():\n    print(f\"Noise={noise}: ARI Mean={result['mean_ari']:.3f}, Std={result['std_ari']:.3f}\")"
        ]
