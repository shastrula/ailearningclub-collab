        [
          "python",
          "import numpy as np\nfrom sklearn.datasets import make_blobs, make_moons\nfrom sklearn.cluster import KMeans, DBSCAN\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import silhouette_score, silhouette_samples\nimport matplotlib.pyplot as plt\n\n# Create datasets with different characteristics\nnp.random.seed(42)\n\nX_good, _ = make_blobs(n_samples=300, centers=3, cluster_std=0.5, random_state=42)\nX_bad, _ = make_blobs(n_samples=300, centers=3, cluster_std=1.5, random_state=42)\nX_moons, _ = make_moons(n_samples=300, noise=0.1, random_state=42)\n\nscaler = StandardScaler()\n\nfig, axes = plt.subplots(3, 3, figsize=(15, 12))\n\ndatasets = [\n    ('Well-Separated', X_good),\n    ('Overlapping', X_bad),\n    ('Non-Convex', X_moons)\n]\n\nfor row, (name, X) in enumerate(datasets):\n    X_scaled = scaler.fit_transform(X)\n    \n    # Cluster with k-means\n    kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)\n    labels = kmeans.fit_predict(X_scaled)\n    \n    # Silhouette score (global)\n    sil_score = silhouette_score(X_scaled, labels)\n    \n    # Silhouette values per sample\n    sil_values = silhouette_samples(X_scaled, labels)\n    \n    # Plot 1: Clustering result\n    axes[row, 0].scatter(X[:, 0], X[:, 1], c=labels, cmap='viridis', s=50, alpha=0.6)\n    axes[row, 0].scatter(kmeans.cluster_centers_[:, 0], kmeans.cluster_centers_[:, 1],\n                        c='red', marker='X', s=200, edgecolors='black', linewidth=2)\n    axes[row, 0].set_title(f'{name}')\n    axes[row, 0].axis('off')\n    \n    # Plot 2: Silhouette plot\n    y_lower = 10\n    for i in range(3):\n        cluster_sil = sil_values[labels == i]\n        cluster_sil.sort()\n        size_cluster_i = cluster_sil.shape[0]\n        \n        axes[row, 1].fill_betweenx(\n            np.arange(y_lower, y_lower + size_cluster_i),\n            0, cluster_sil,\n            alpha=0.7, label=f'Cluster {i}'\n        )\n        y_lower += size_cluster_i + 10\n    \n    axes[row, 1].axvline(x=sil_score, color='red', linestyle='--', label='Average')\n    axes[row, 1].set_xlabel('Silhouette Coefficient')\n    axes[row, 1].set_ylabel('Cluster')\n    axes[row, 1].set_title(f'Silhouette Plot (Score: {sil_score:.3f})')\n    \n    # Plot 3: Silhouette values by cluster\n    cluster_means = [sil_values[labels == i].mean() for i in range(3)]\n    axes[row, 2].bar(range(3), cluster_means, alpha=0.7)\n    axes[row, 2].axhline(y=sil_score, color='red', linestyle='--', label='Overall Mean')\n    axes[row, 2].set_xlabel('Cluster')\n    axes[row, 2].set_ylabel('Mean Silhouette')\n    axes[row, 2].set_title('Mean Silhouette per Cluster')\n    axes[row, 2].legend()\n\nplt.tight_layout()\nplt.show()\n\nprint(\"Interpretation:\")\nprint(\"- Silhouette ~ 1: Well-separated clusters\")\nprint(\"- Silhouette ~ 0: Clusters overlap significantly\")\nprint(\"- Silhouette < 0: Some points in wrong clusters\")"
        ]
      ]
