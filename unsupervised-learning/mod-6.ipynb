      "source": [
        [
          "python",
          "from scipy.cluster.hierarchy import dendrogram, linkage, fcluster\nfrom sklearn.datasets import load_iris\nfrom sklearn.preprocessing import StandardScaler\nimport matplotlib.pyplot as plt\nimport numpy as np\n\n# Load data\niris = load_iris()\nX = iris.data[:50]  # Use first 50 samples for clarity\nX_scaled = StandardScaler().fit_transform(X)\n\n# Compute linkage matrix using different methods\nmethods = ['single', 'complete', 'average', 'ward']\nfig, axes = plt.subplots(2, 2, figsize=(14, 10))\n\nfor ax, method in zip(axes.flat, methods):\n    Z = linkage(X_scaled, method=method)\n    dendrogram(Z, ax=ax, no_labels=True)\n    ax.set_title(f'{method.capitalize()} Linkage')\n    ax.set_ylabel('Distance')\n\nplt.tight_layout()\nplt.show()\n\n# Detailed view of Ward linkage\nZ = linkage(X_scaled, method='ward')\nplt.figure(figsize=(12, 6))\ndendrogram(Z, no_labels=True)\nplt.axhline(y=15, c='red', linestyle='--', label='Cut at height 15')\nplt.xlabel('Sample Index')\nplt.ylabel('Distance')\nplt.title('Hierarchical Clustering Dendrogram (Ward Linkage)')\nplt.legend()\nplt.show()\n\n# Extract clusters at different cut heights\nclusters_5 = fcluster(Z, t=5, criterion='maxclust')  # 5 clusters\nclusters_3 = fcluster(Z, t=3, criterion='maxclust')  # 3 clusters\n\nprint(f\"5 clusters: {np.bincount(clusters_5)}\")\nprint(f\"3 clusters: {np.bincount(clusters_3)}\")"
        ]
      ]
