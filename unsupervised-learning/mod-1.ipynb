          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.datasets import load_iris, make_blobs\nimport matplotlib.pyplot as plt\n\n# Load iris dataset\niris = load_iris()\nX = iris.data\nfeature_names = iris.feature_names\n\n# Create DataFrame for easy exploration\ndf = pd.DataFrame(X, columns=feature_names)\n\n# Basic statistics\nprint(\"Dataset shape:\", df.shape)\nprint(\"\\nFeature statistics:\")\nprint(df.describe())\n\n# Standardize features (important for many unsupervised algorithms)\nfrom sklearn.preprocessing import StandardScaler\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\nprint(\"\\nScaled data mean:\", X_scaled.mean(axis=0))\nprint(\"Scaled data std:\", X_scaled.std(axis=0))\n\n# Visualize pairwise relationships\nplt.figure(figsize=(10, 8))\nfor i in range(4):\n    for j in range(i+1, 4):\n        plt.scatter(X_scaled[:, i], X_scaled[:, j], alpha=0.6)\n        plt.xlabel(feature_names[i])\n        plt.ylabel(feature_names[j])\n        plt.title(f\"Iris: {feature_names[i]} vs {feature_names[j]}\")\n        plt.show()"
        ]
      ]
    }
