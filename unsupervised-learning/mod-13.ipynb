        [
          "python",
          "import tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers\nimport numpy as np\n\n# Add noise to data\ndef add_noise(x, noise_factor=0.2):\n    x_noisy = x + noise_factor * np.random.normal(loc=0.0, scale=1.0, size=x.shape)\n    return np.clip(x_noisy, 0, 1)\n\n# Prepare data\nfrom sklearn.datasets import load_digits\n\nX = load_digits().data / 16.0\nX_train = X[:1500]\nX_test = X[1500:]\n\n# Create noisy versions\nX_train_noisy = add_noise(X_train, noise_factor=0.2)\nX_test_noisy = add_noise(X_test, noise_factor=0.2)\n\n# Denoising autoencoder: input is noisy, target is clean\ndenoiser = keras.Sequential([\n    layers.Dense(256, activation='relu', input_shape=(64,)),\n    layers.Dense(128, activation='relu'),\n    layers.Dense(64, activation='relu'),\n    layers.Dense(128, activation='relu'),\n    layers.Dense(256, activation='relu'),\n    layers.Dense(64, activation='sigmoid')\n])\n\ndenoiser.compile(optimizer='adam', loss='mse')\n\n# Train: minimize difference between decoder output and original clean data\ndenoiser.fit(\n    X_train_noisy, X_train,  # Input: noisy, Target: clean\n    epochs=50,\n    batch_size=32,\n    validation_data=(X_test_noisy, X_test),\n    verbose=0\n)\n\n# Denoise test data\nX_denoised = denoiser.predict(X_test_noisy)\n\n# Visualize denoising\nfig, axes = plt.subplots(3, 5, figsize=(12, 7))\n\nfor i in range(5):\n    # Original\n    axes[0, i].imshow(X_test[i].reshape(8, 8), cmap='gray')\n    axes[0, i].set_title('Original')\n    axes[0, i].axis('off')\n    \n    # Noisy\n    axes[1, i].imshow(X_test_noisy[i].reshape(8, 8), cmap='gray')\n    axes[1, i].set_title('Noisy')\n    axes[1, i].axis('off')\n    \n    # Denoised\n    axes[2, i].imshow(X_denoised[i].reshape(8, 8), cmap='gray')\n    axes[2, i].set_title('Denoised')\n    axes[2, i].axis('off')\n\nplt.tight_layout()\nplt.show()"
        ]
