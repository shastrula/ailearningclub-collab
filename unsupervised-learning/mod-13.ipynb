          "python",
          "# Contractive autoencoder (simplified version)\n# Penalizes the Jacobian norm of hidden activations w.r.t. inputs\n\ndef contractive_loss(y_pred, y_true, hidden_layer, input_layer, lambda_reg=1e-4):\n    # Reconstruction loss\n    recon_loss = keras.losses.mse(y_true, y_pred)\n    \n    # Contractive penalty: Frobenius norm of Jacobian\n    # Encourages hidden activations to be stable to input changes\n    W = hidden_layer.kernel\n    contractive_penalty = lambda_reg * tf.reduce_mean(tf.square(W))\n    \n    return recon_loss + contractive_penalty"
        ]
      ]
    },
