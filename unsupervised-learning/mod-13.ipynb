          "python",
          "import tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers, regularizers\n\n# Sparse autoencoder with L1 regularization\nsparse_autoencoder = keras.Sequential([\n    layers.Dense(256, activation='relu', input_shape=(64,)),\n    layers.Dense(128, activation='relu',\n                regularizers.L1(1e-5)),  # L1 sparsity\n    layers.Dense(64, activation='relu',\n                regularizers.L1(1e-4)),  # Stronger sparsity on bottleneck\n    layers.Dense(128, activation='relu'),\n    layers.Dense(256, activation='relu'),\n    layers.Dense(64, activation='sigmoid')\n])\n\nsparse_autoencoder.compile(optimizer='adam', loss='mse')\n\n# Train with sparse regularization\nsparse_autoencoder.fit(\n    X_train, X_train,\n    epochs=50,\n    batch_size=32,\n    validation_split=0.2,\n    verbose=0\n)\n\n# Extract bottleneck features and check sparsity\nbottleneck_model = keras.Model(\n    inputs=sparse_autoencoder.inputs,\n    outputs=sparse_autoencoder.layers[2].output\n)\nbottleneck_features = bottleneck_model.predict(X_train)\n\n# Measure sparsity (fraction of near-zero activations)\nsparsity = (np.abs(bottleneck_features) < 0.1).mean()\nprint(f\"Bottleneck sparsity: {sparsity:.1%}\")\nprint(f\"Active neurons per sample: {(np.abs(bottleneck_features) >= 0.1).sum(axis=1).mean():.1f} / {bottleneck_features.shape[1]}\")"
        ]
      ]
