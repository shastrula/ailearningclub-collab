      "source": [
        "# Unsupervised Learning - mod-14\n\n",
        "**Course:** unsupervised-learning\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom sklearn.cluster import KMeans, DBSCAN\nfrom sklearn.datasets import make_blobs, make_moons\nfrom sklearn.preprocessing import StandardScaler\nimport matplotlib.pyplot as plt\n\n# Create different dataset shapes\nnp.random.seed(42)\n\n# Circular clusters (k-means excels)\nX_circular, y_circular = make_blobs(n_samples=300, centers=3, cluster_std=0.5)\n\n# Non-convex clusters (DBSCAN excels)\nX_moons, y_moons = make_moons(n_samples=300, noise=0.05)\n\n# Anomalous data (mixed sizes)\nX_mixed, _ = np.vstack([\n    make_blobs(n_samples=200, centers=1, cluster_std=0.3)[0],\n    make_blobs(n_samples=100, centers=[[3, 3]], cluster_std=0.2)[0],\n    np.random.uniform(-2, 5, (30, 2))  # Outliers\n])\n\nscaler = StandardScaler()\n\nfig, axes = plt.subplots(3, 3, figsize=(15, 12))\n\ndatasets = [\n    ('Circular Clusters', X_circular, y_circular),\n    ('Non-Convex (Moons)', X_moons, y_moons),\n    ('Mixed Sizes + Outliers', X_mixed, np.zeros(len(X_mixed)))\n]\n\nfor row, (name, X, y) in enumerate(datasets):\n    X_scaled = scaler.fit_transform(X)\n    \n    # Original data\n    axes[row, 0].scatter(X[:, 0], X[:, 1], c=y, cmap='viridis', s=50, alpha=0.6)\n    axes[row, 0].set_title(f'{name}')\n    axes[row, 0].axis('off')\n    \n    # K-Means\n    kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)\n    labels_km = kmeans.fit_predict(X_scaled)\n    axes[row, 1].scatter(X[:, 0], X[:, 1], c=labels_km, cmap='viridis', s=50, alpha=0.6)\n    axes[row, 1].scatter(kmeans.cluster_centers_[:, 0], kmeans.cluster_centers_[:, 1],\n                        c='red', marker='X', s=200, edgecolors='black', linewidth=2)\n    axes[row, 1].set_title(f'{name} - K-Means')\n    axes[row, 1].axis('off')\n    \n    # DBSCAN\n    dbscan = DBSCAN(eps=0.2, min_samples=5)\n    labels_db = dbscan.fit_predict(X_scaled)\n    colors = ['red' if l == -1 else 'C' + str(l % 10) for l in labels_db]\n    axes[row, 2].scatter(X[:, 0], X[:, 1], c=colors, s=50, alpha=0.6)\n    axes[row, 2].set_title(f'{name} - DBSCAN (eps=0.2)')\n    axes[row, 2].axis('off')\n\nplt.tight_layout()\nplt.show()\n\nprint(\"K-Means excels with spherical, well-separated clusters\")\nprint(\"DBSCAN excels with arbitrary shapes and automatic cluster detection\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from scipy.cluster.hierarchy import dendrogram, linkage, fcluster\nfrom scipy.spatial.distance import pdist\n\n# Use smaller sample for visualization\nX_sample = X_circular[:100]\nX_scaled = scaler.fit_transform(X_sample)\n\n# Compute linkage matrix (how to merge clusters)\n# Methods: 'ward' (variance), 'complete' (max distance), 'average', 'single'\nlinkage_ward = linkage(X_scaled, method='ward')\nlinkage_complete = linkage(X_scaled, method='complete')\nlinkage_average = linkage(X_scaled, method='average')\n\nfig, axes = plt.subplots(1, 3, figsize=(15, 5))\n\nfor ax, Z, method in zip(axes, [linkage_ward, linkage_complete, linkage_average],\n                         ['Ward', 'Complete', 'Average']):\n    dendrogram(Z, ax=ax, no_labels=True)\n    ax.set_title(f'Hierarchical ({method} linkage)')\n    ax.set_xlabel('Sample Index')\n    ax.set_ylabel('Distance')\n\nplt.tight_layout()\nplt.show()\n\n# Cut dendrogram at specific height to get cluster assignments\n# Ward linkage typically produces balanced clusters\nclusters_ward = fcluster(linkage_ward, t=3, criterion='maxclust')\n\n# Compare hierarchical vs k-means\nfig, axes = plt.subplots(1, 2, figsize=(10, 4))\n\naxes[0].scatter(X_sample[:, 0], X_sample[:, 1], c=clusters_ward, cmap='viridis', s=50)\naxes[0].set_title('Hierarchical (Ward)')\n\nkmeans_sample = KMeans(n_clusters=3, random_state=42)\nlabels_km = kmeans_sample.fit_predict(X_scaled)\naxes[1].scatter(X_sample[:, 0], X_sample[:, 1], c=labels_km, cmap='viridis', s=50)\naxes[1].set_title('K-Means')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.mixture import GaussianMixture\nfrom scipy.stats import multivariate_normal\n\n# Fit GMM\ngmm = GaussianMixture(n_components=3, random_state=42)\nlabels_gmm = gmm.fit_predict(X_scaled)\n\n# Get soft assignments (probabilities)\nsoft_assignments = gmm.predict_proba(X_scaled)\n\nfig, axes = plt.subplots(1, 2, figsize=(12, 5))\n\n# Hard assignments (maximum probability)\naxes[0].scatter(X[:, 0], X[:, 1], c=labels_gmm, cmap='viridis', s=50, alpha=0.6)\naxes[0].set_title('GMM - Hard Assignments')\naxes[0].axis('off')\n\n# Soft assignments (uncertainty: entropy of probability distribution)\nentropy = -np.sum(soft_assignments * np.log(soft_assignments + 1e-10), axis=1)\nscatter = axes[1].scatter(X[:, 0], X[:, 1], c=entropy, cmap='hot', s=50, alpha=0.6)\naxes[1].set_title('GMM - Assignment Uncertainty')\naxes[1].axis('off')\nplt.colorbar(scatter, ax=axes[1])\n\nplt.tight_layout()\nplt.show()\n\n# GMM provides model selection via information criteria\nbic_scores = []\naic_scores = []\nn_components_range = range(1, 11)\n\nfor n in n_components_range:\n    gmm_temp = GaussianMixture(n_components=n, random_state=42)\n    gmm_temp.fit(X_scaled)\n    bic_scores.append(gmm_temp.bic(X_scaled))\n    aic_scores.append(gmm_temp.aic(X_scaled))\n\nfig, ax = plt.subplots()\nax.plot(n_components_range, bic_scores, 'o-', label='BIC')\nax.plot(n_components_range, aic_scores, 's-', label='AIC')\nax.set_xlabel('Number of Components')\nax.set_ylabel('Information Criterion')\nax.legend()\nax.set_title('Model Selection for GMM')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.metrics import silhouette_score, davies_bouldin_score, calinski_harabasz_score\nimport time\n\ndef benchmark_clustering(X, algorithms, true_labels=None):\n    \"\"\"Compare clustering algorithms across multiple metrics\"\"\"\n    \n    X_scaled = StandardScaler().fit_transform(X)\n    results = {}\n    \n    for name, algo in algorithms:\n        # Time the algorithm\n        start = time.time()\n        labels = algo.fit_predict(X_scaled)\n        elapsed = time.time() - start\n        \n        # Compute metrics (higher is better for all except Davies-Bouldin)\n        silhouette = silhouette_score(X_scaled, labels)\n        davies_bouldin = davies_bouldin_score(X_scaled, labels)\n        calinski = calinski_harabasz_score(X_scaled, labels)\n        \n        results[name] = {\n            'time': elapsed,\n            'silhouette': silhouette,\n            'davies_bouldin': davies_bouldin,\n            'calinski': calinski,\n            'n_clusters': len(set(labels))\n        }\n    \n    return results\n\n# Compare algorithms\nalgorithms = [\n    ('K-Means (k=3)', KMeans(n_clusters=3, random_state=42, n_init=10)),\n    ('DBSCAN (eps=0.3)', DBSCAN(eps=0.3, min_samples=5)),\n    ('Hierarchical (Ward)', sklearn.cluster.AgglomerativeClustering(n_clusters=3, linkage='ward')),\n    ('GMM (n=3)', GaussianMixture(n_components=3, random_state=42))\n]\n\nresults = benchmark_clustering(X_circular, algorithms)\n\n# Print comparison table\nprint(\"\\n\" + \"=\"*80)\nprint(f\"{'Algorithm':<30} {'Time':<10} {'Silhouette':<12} {'Davies-Bouldin':<15} {'Clusters':<10}\")\nprint(\"=\"*80)\n\nfor name, metrics in sorted(results.items()):\n    print(f\"{name:<30} {metrics['time']:<10.4f} {metrics['silhouette']:<12.3f} {metrics['davies_bouldin']:<15.3f} {metrics['n_clusters']:<10}\")"
        ]
      ]
    },
