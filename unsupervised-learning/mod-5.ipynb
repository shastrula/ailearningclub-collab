      "source": [
        "# Unsupervised Learning - mod-5\n\n",
        "**Course:** unsupervised-learning\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom sklearn.datasets import make_blobs, make_moons\nfrom sklearn.preprocessing import StandardScaler\nimport matplotlib.pyplot as plt\n\n# Install: pip install hdbscan\nfrom hdbscan import HDBSCAN\nfrom sklearn.cluster import DBSCAN\n\n# Dataset with two clusters of different densities\nnp.random.seed(42)\nX1 = np.random.randn(200, 2) * 0.5 + [0, 0]      # Dense cluster\nX2 = np.random.randn(50, 2) * 2 + [6, 6]         # Sparse cluster\nX = np.vstack([X1, X2])\nX_scaled = StandardScaler().fit_transform(X)\n\n# Standard DBSCAN struggles\ndbscan = DBSCAN(eps=0.5, min_samples=5)\nlabels_dbscan = dbscan.fit_predict(X_scaled)\n\n# HDBSCAN handles it better\nhdbscan = HDBSCAN(min_samples=5)\nlabels_hdbscan = hdbscan.fit_predict(X_scaled)\n\n# Visualize comparison\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 4))\n\n# DBSCAN\nunique = set(labels_dbscan)\ncolors = plt.cm.Spectral(np.linspace(0, 1, len(unique)))\nfor label, color in zip(unique, colors):\n    mask = labels_dbscan == label\n    if label == -1:\n        ax1.scatter(X_scaled[mask, 0], X_scaled[mask, 1], c='black', \n                   marker='x', s=100, label='Noise')\n    else:\n        ax1.scatter(X_scaled[mask, 0], X_scaled[mask, 1], c=[color], \n                   marker='o', s=30)\nax1.set_title('DBSCAN (fixed \u03b5)')\nax1.set_xticks([])\nax1.set_yticks([])\n\n# HDBSCAN\nunique = set(labels_hdbscan)\ncolors = plt.cm.Spectral(np.linspace(0, 1, len(unique)))\nfor label, color in zip(unique, colors):\n    mask = labels_hdbscan == label\n    if label == -1:\n        ax2.scatter(X_scaled[mask, 0], X_scaled[mask, 1], c='black', \n                   marker='x', s=100, label='Noise')\n    else:\n        ax2.scatter(X_scaled[mask, 0], X_scaled[mask, 1], c=[color], \n                   marker='o', s=30)\nax2.set_title('HDBSCAN (adaptive \u03b5)')\nax2.set_xticks([])\nax2.set_yticks([])\nplt.tight_layout()\nplt.show()\n\nprint(f\"DBSCAN: {len(set(labels_dbscan))-1} clusters, {sum(labels_dbscan==-1)} noise\")\nprint(f\"HDBSCAN: {len(set(labels_hdbscan))-1} clusters, {sum(labels_hdbscan==-1)} noise\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.cluster import OPTICS\nimport matplotlib.pyplot as plt\n\n# Using same dataset as above\noptics = OPTICS(min_samples=5)\nlabels_optics = optics.fit_predict(X_scaled)\n\n# Reachability plot\nfig, ax = plt.subplots(figsize=(12, 4))\nreachability = optics.reachability_[optics.ordering_]\ncolors = plt.cm.Spectral(np.linspace(0, 1, len(set(labels_optics))))\nfor label in set(labels_optics):\n    if label == -1:\n        color = 'black'\n    else:\n        color = colors[label]\n    mask = labels_optics[optics.ordering_] == label\n    ax.scatter(np.where(mask)[0], reachability[mask], c=[color], s=10)\n\nax.set_ylabel('Reachability Distance')\nax.set_xlabel('Point Order')\nax.set_title('OPTICS Reachability Plot')\nax.set_yscale('log')\nplt.show()\n\nprint(f\"OPTICS: {len(set(labels_optics))-1} clusters, {sum(labels_optics==-1)} noise\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.metrics import silhouette_score, davies_bouldin_score\n\n# Compare across different min_samples\nmin_samples_range = [3, 5, 10, 20]\nfor min_samp in min_samples_range:\n    hdbscan_model = HDBSCAN(min_samples=min_samp)\n    labels = hdbscan_model.fit_predict(X_scaled)\n    \n    if len(set(labels)) > 1 and -1 in labels:\n        # Compute silhouette only for non-noise points\n        noise_mask = labels != -1\n        if sum(noise_mask) > 1:\n            score = silhouette_score(X_scaled[noise_mask], labels[noise_mask])\n            db_score = davies_bouldin_score(X_scaled[noise_mask], labels[noise_mask])\n            print(f\"min_samples={min_samp}: Silhouette={score:.3f}, DB={db_score:.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.decomposition import PCA\nfrom sklearn.manifold import TSNE\n\n# Generate high-dimensional data\nX_high = np.random.randn(200, 50)  # 50 dimensions\nX_high[:100] += 3  # First 100 points shifted (one cluster)\n\n# Dimensionality reduction then clustering\npca = PCA(n_components=2)\nX_pca = pca.fit_transform(X_high)\n\nhdbscan_model = HDBSCAN(min_samples=5)\nlabels = hdbscan_model.fit_predict(X_pca)\n\nplt.figure(figsize=(8, 6))\nplt.scatter(X_pca[labels!=-1, 0], X_pca[labels!=-1, 1], c=labels[labels!=-1], \n           cmap='Spectral', s=50)\nplt.scatter(X_pca[labels==-1, 0], X_pca[labels==-1, 1], c='black', \n           marker='x', s=100, label='Noise')\nplt.title('HDBSCAN after PCA dimensionality reduction')\nplt.legend()\nplt.show()"
        ]
      ]
    }
