      "source": [
        "# Unsupervised Learning - mod-19\n\n",
        "**Course:** unsupervised-learning\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.decomposition import PCA\nimport matplotlib.pyplot as plt\n\n# High-dimensional dataset (e.g., image pixels, gene expressions)\nnp.random.seed(42)\nX = np.random.randn(500, 50)  # 500 samples, 50 features\n\n# Standardize (PCA requires zero mean)\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\n# Apply PCA\npca = PCA()\nX_pca = pca.fit_transform(X_scaled)\n\n# Explained variance\ncumsum_var = np.cumsum(pca.explained_variance_ratio_)\nn_components = np.argmax(cumsum_var >= 0.95) + 1\n\nprint(f\"Dimensions needed for 95% variance: {n_components} / 50\")\nprint(f\"First 5 components explain: {cumsum_var[4]:.1%}\")\n\n# Reduce to 5D\npca_5d = PCA(n_components=5)\nX_reduced = pca_5d.fit_transform(X_scaled)\nprint(f\"Shape: {X.shape} \u2192 {X_reduced.shape}\")\n\n# Reconstruction\nX_reconstructed = pca_5d.inverse_transform(X_reduced)\nreconstruction_error = np.mean((X_scaled - X_reconstructed)**2)\nprint(f\"Reconstruction MSE: {reconstruction_error:.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import tensorflow as tf\nfrom tensorflow import keras\n\n# Create clean data + add noise\nnp.random.seed(42)\nX_clean = np.random.randn(1000, 20)\nnoise = 0.5 * np.random.randn(1000, 20)\nX_noisy = X_clean + noise\n\n# Split train/test\nX_train_clean, X_test_clean = X_clean[:800], X_clean[800:]\nX_train_noisy, X_test_noisy = X_noisy[:800], X_noisy[800:]\n\n# Denoising autoencoder\nautoencoder = keras.Sequential([\n    keras.layers.Dense(15, activation='relu', input_dim=20),\n    keras.layers.Dense(10, activation='relu'),\n    keras.layers.Dense(15, activation='relu'),\n    keras.layers.Dense(20, activation='linear')\n])\n\nautoencoder.compile(optimizer='adam', loss='mse')\nautoencoder.fit(X_train_noisy, X_train_clean, epochs=30, batch_size=32, \n                validation_data=(X_test_noisy, X_test_clean), verbose=0)\n\n# Denoise test data\nX_denoised = autoencoder.predict(X_test_noisy, verbose=0)\n\nprint(f\"Noisy MSE: {np.mean((X_test_noisy - X_test_clean)**2):.4f}\")\nprint(f\"Denoised MSE: {np.mean((X_denoised - X_test_clean)**2):.4f}\")"
        ]
      ]
    },
    {
