        [
          "python",
          "from gensim.models import Word2Vec\nimport nltk\nfrom nltk.tokenize import sent_tokenize, word_tokenize\n\n# Sample documents\ndocuments = [\n    \"Machine learning is transforming technology and AI\",\n    \"Deep learning powers modern artificial intelligence\",\n    \"Neural networks are the foundation of deep learning\",\n    \"Python is the language for machine learning\"\n]\n\n# Tokenize\nsentences = []\nfor doc in documents:\n    for sent in sent_tokenize(doc.lower()):\n        tokens = word_tokenize(sent)\n        sentences.append([t for t in tokens if t.isalpha()])\n\n# Train Word2Vec\nmodel = Word2Vec(sentences, vector_size=50, window=2, min_count=1, workers=4, seed=42)\n\n# Get embeddings\nprint(\"'learning' vector shape:\", model.wv['learning'].shape)\nprint(\"'machine' vector:\", model.wv['machine'][:5])\n\n# Find similar words\nprint(\"\\nWords similar to 'learning':\")\nfor word, score in model.wv.most_similar('learning', topn=3):\n    print(f\"  {word}: {score:.3f}\")\n\n# Vector arithmetic\n# learning + AI - language \u2248 intelligence concepts\ntry:\n    result = model.wv.most_similar(positive=['learning', 'ai'], negative=['language'], topn=2)\n    print(\"\\nVectors: learning + ai - language:\")\n    for word, score in result:\n        print(f\"  {word}: {score:.3f}\")\nexcept:\n    print(\"\\n(Similar words computation skipped - insufficient vocab)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.feature_extraction.text import CountVectorizer\nfrom sklearn.decomposition import LatentDirichletAllocation\n\n# Sample documents\ndocuments = [\n    \"Python programming languages data science machine learning\",\n    \"Machine learning deep learning neural networks training\",\n    \"Climate change environmental science global warming\",\n    \"Environmental protection ecology sustainable development\",\n    \"Sports football basketball teams players\",\n    \"Sports games competitions athletic training\"\n]\n\n# Vectorize documents (bag of words)\nvectorizer = CountVectorizer(max_features=20, stop_words='english', lowercase=True)\ndoc_term_matrix = vectorizer.fit_transform(documents)\n\n# LDA with 3 topics\nlda = LatentDirichletAllocation(n_components=3, random_state=42, max_iter=20)\nlda.fit(doc_term_matrix)\n\n# Display topics\nfeature_names = vectorizer.get_feature_names_out()\nprint(\"Topics discovered:\")\nfor topic_idx, topic in enumerate(lda.components_):\n    top_words_idx = topic.argsort()[-5:][::-1]\n    top_words = [feature_names[i] for i in top_words_idx]\n    print(f\"Topic {topic_idx}: {', '.join(top_words)}\")\n\n# Document-topic distribution\ndoc_topics = lda.transform(doc_term_matrix)\nprint(f\"\\nDocument 0 topic probabilities: {doc_topics[0].round(3)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
