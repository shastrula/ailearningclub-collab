      "source": [
        "# Unsupervised Learning - mod-10\n\n",
        "**Course:** unsupervised-learning\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "p_{j|i} = exp(-||x_i - x_j||\u00b2) / \u03a3_k exp(-||x_i - x_k||\u00b2)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "q_{ij} = (1 + ||y_i - y_j||\u00b2)^(-1) / \u03a3_k (1 + ||y_i - y_k||\u00b2)^(-1)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.manifold import TSNE\nfrom sklearn.datasets import load_digits\nfrom sklearn.preprocessing import StandardScaler\nimport matplotlib.pyplot as plt\n\n# Load data\nX = load_digits().data\ny = load_digits().target\n\n# Standardize\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\n# Try different perplexities\nfig, axes = plt.subplots(2, 2, figsize=(12, 12))\nperplexities = [5, 30, 50, 100]\n\nfor idx, perp in enumerate(perplexities):\n    ax = axes[idx // 2, idx % 2]\n    \n    # t-SNE with different perplexity\n    tsne = TSNE(n_components=2, perplexity=perp, random_state=42, n_iter=1000)\n    X_tsne = tsne.fit_transform(X_scaled)\n    \n    scatter = ax.scatter(X_tsne[:, 0], X_tsne[:, 1], c=y, cmap='tab10', s=20, alpha=0.7)\n    ax.set_title(f'Perplexity={perp}')\n    ax.set_xlabel('t-SNE 1')\n    ax.set_ylabel('t-SNE 2')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "KL(P || Q) = \u03a3_i \u03a3_j p_{ij} log(p_{ij} / q_{ij})"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# The optimization loop (conceptually)\n# 1. Initialize y with random values or PCA\n# 2. For each iteration:\n#    - Compute q_{ij} for all pairs\n#    - Compute gradients of KL divergence w.r.t. y\n#    - Update y: y = y - learning_rate * gradient\n# 3. Optionally decay learning rate over time"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.manifold import TSNE\nfrom sklearn.decomposition import PCA\n\nX_scaled = scaler.fit_transform(X)\n\n# Strategy 1: Random initialization (default)\ntsne_random = TSNE(n_components=2, random_state=42, init='random')\nX_tsne_random = tsne_random.fit_transform(X_scaled)\n\n# Strategy 2: PCA initialization (often better)\ntsne_pca = TSNE(n_components=2, random_state=42, init='pca')\nX_tsne_pca = tsne_pca.fit_transform(X_scaled)\n\n# Strategy 3: Custom initialization\npca = PCA(n_components=2)\ninit = pca.fit_transform(X_scaled)\ntsne_custom = TSNE(n_components=2, init=init, random_state=42)\nX_tsne_custom = tsne_custom.fit_transform(X_scaled)\n\n# PCA initialization typically leads to faster, more stable convergence"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Compare different hyperparameters\nfig, axes = plt.subplots(2, 2, figsize=(12, 12))\nconfigs = [\n    {'perplexity': 30, 'learning_rate': 200, 'early_exaggeration': 12, 'title': 'Default'},\n    {'perplexity': 30, 'learning_rate': 100, 'early_exaggeration': 12, 'title': 'Low LR'},\n    {'perplexity': 50, 'learning_rate': 200, 'early_exaggeration': 12, 'title': 'High Perplexity'},\n    {'perplexity': 30, 'learning_rate': 200, 'early_exaggeration': 4, 'title': 'Low Exaggeration'},\n]\n\nfor idx, config in enumerate(configs):\n    ax = axes[idx // 2, idx % 2]\n    title = config.pop('title')\n    \n    tsne = TSNE(n_components=2, random_state=42, **config, n_iter=1000)\n    X_tsne = tsne.fit_transform(X_scaled)\n    \n    ax.scatter(X_tsne[:, 0], X_tsne[:, 1], c=y, cmap='tab10', s=20, alpha=0.7)\n    ax.set_title(title)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom sklearn.manifold import TSNE\nfrom sklearn.datasets import fetch_20newsgroups\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nimport matplotlib.pyplot as plt\n\n# Fetch 20 newsgroups dataset\ncategories = ['alt.atheism', 'talk.religion.misc', 'comp.graphics', 'sci.space']\nnewsgroups = fetch_20newsgroups(\n    subset='train',\n    categories=categories,\n    remove=('headers', 'footers', 'quotes')\n)\n\n# Convert text to features\nvectorizer = TfidfVectorizer(max_features=5000, max_df=0.7, min_df=2)\nX = vectorizer.fit_transform(newsgroups.data).toarray()\n\n# t-SNE\ntsne = TSNE(n_components=2, perplexity=30, random_state=42)\nX_tsne = tsne.fit_transform(X)\n\n# Visualize\nplt.figure(figsize=(10, 8))\nscatter = plt.scatter(\n    X_tsne[:, 0], X_tsne[:, 1],\n    c=newsgroups.target,\n    cmap='viridis',\n    s=50,\n    alpha=0.6\n)\nplt.xlabel('t-SNE 1')\nplt.ylabel('t-SNE 2')\nplt.title('20 Newsgroups: Topic Visualization with t-SNE')\nplt.colorbar(scatter, label='Category')\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import time\n\n# Measure t-SNE performance on different dataset sizes\nsizes = [100, 500, 1000, 5000, 10000]\ntimes = []\n\nfor size in sizes:\n    X_sample = X_scaled[:size]\n    start = time.time()\n    tsne = TSNE(n_components=2, random_state=42, n_iter=500)\n    tsne.fit_transform(X_sample)\n    elapsed = time.time() - start\n    times.append(elapsed)\n    print(f\"n={size}: {elapsed:.2f}s\")"
        ]
      ]
    }
