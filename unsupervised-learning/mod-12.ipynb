      "outputs": [],
      "source": [
        [
          "python",
          "Input (784) \u2192 Hidden (512) \u2192 Hidden (256) \u2192 Bottleneck (32) \u2192 Hidden (256) \u2192 Hidden (512) \u2192 Output (784)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Loss = (1/n) * \u03a3 ||x_i - x_reconstructed_i||\u00b2"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Loss = -\u03a3 [x_i * log(\u0177_i) + (1 - x_i) * log(1 - \u0177_i)]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers\nfrom sklearn.datasets import load_digits\nfrom sklearn.preprocessing import StandardScaler\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Load and prepare data\nX = load_digits().data\ny = load_digits().target\n\n# Normalize to [0, 1]\nX = X / 16.0\n\n# Split data\nX_train = X[:1500]\nX_test = X[1500:]\n\n# Build undercomplete autoencoder\ninput_dim = X_train.shape[1]  # 64\nencoding_dim = 16  # Bottleneck size\n\nencoder = keras.Sequential([\n    layers.Dense(32, activation='relu', input_shape=(input_dim,)),\n    layers.Dense(16, activation='relu'),\n    layers.Dense(encoding_dim, activation='relu')\n])\n\ndecoder = keras.Sequential([\n    layers.Dense(16, activation='relu', input_shape=(encoding_dim,)),\n    layers.Dense(32, activation='relu'),\n    layers.Dense(input_dim, activation='sigmoid')\n])\n\n# Full autoencoder\nautoencoder = keras.Sequential([encoder, decoder])\n\nautoencoder.compile(optimizer='adam', loss='mse')\n\n# Train\nhistory = autoencoder.fit(\n    X_train, X_train,\n    epochs=50,\n    batch_size=32,\n    validation_split=0.2,\n    verbose=0\n)\n\n# Evaluate\ntrain_loss = autoencoder.evaluate(X_train, X_train, verbose=0)\ntest_loss = autoencoder.evaluate(X_test, X_test, verbose=0)\n\nprint(f\"Train reconstruction loss: {train_loss:.4f}\")\nprint(f\"Test reconstruction loss: {test_loss:.4f}\")\n\n# Get bottleneck representations\nX_encoded_train = encoder.predict(X_train)\nX_encoded_test = encoder.predict(X_test)\n\nprint(f\"Original shape: {X_train.shape}\")\nprint(f\"Encoded shape: {X_encoded_train.shape}\")\nprint(f\"Compression ratio: {X_train.shape[1] / X_encoded_train.shape[1]:.1f}x\")\n\n# Visualize reconstructions\nX_reconstructed = autoencoder.predict(X_test[:10])\n\nfig, axes = plt.subplots(2, 5, figsize=(12, 4))\n\nfor i in range(5):\n    # Original\n    axes[0, i].imshow(X_test[i].reshape(8, 8), cmap='gray')\n    axes[0, i].set_title('Original')\n    axes[0, i].axis('off')\n    \n    # Reconstructed\n    axes[1, i].imshow(X_reconstructed[i].reshape(8, 8), cmap='gray')\n    axes[1, i].set_title('Reconstructed')\n    axes[1, i].axis('off')\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Overcomplete autoencoder with sparsity regularization\nfrom tensorflow.keras.regularizers import l1\n\ninput_dim = 64\nencoding_dim = 128  # Overcomplete: larger than input\n\nautoencoder_overcomplete = keras.Sequential([\n    layers.Dense(128, activation='relu', input_shape=(input_dim,)),\n    layers.Dense(encoding_dim, activation='relu',\n                 activity_regularizer=keras.regularizers.l1(1e-5)),  # L1 sparsity\n    layers.Dense(128, activation='relu'),\n    layers.Dense(input_dim, activation='sigmoid')\n])\n\nautoencoder_overcomplete.compile(optimizer='adam', loss='mse')\nautoencoder_overcomplete.fit(\n    X_train, X_train,\n    epochs=50,\n    batch_size=32,\n    validation_split=0.2,\n    verbose=0\n)\n\n# Check bottleneck activation\nX_encoded = keras.Model(inputs=autoencoder_overcomplete.inputs,\n                       outputs=autoencoder_overcomplete.layers[1].output)\nbottleneck_vals = X_encoded.predict(X_train)\n\nsparsity = (bottleneck_vals < 0.01).mean()\nprint(f\"Bottleneck sparsity (< 0.01): {sparsity:.1%}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Use autoencoder bottleneck for downstream classification\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import accuracy_score\n\n# Extract bottleneck features\nX_train_encoded = encoder.predict(X_train)\nX_test_encoded = encoder.predict(X_test)\n\n# Train classifier on encoded features\nclf = LogisticRegression(max_iter=200)\nclf.fit(X_train_encoded, y[:1500])\n\n# Predict\npredictions = clf.predict(X_test_encoded)\naccuracy = accuracy_score(y[1500:], predictions)\n\nprint(f\"Classification accuracy: {accuracy:.3f}\")\n\n# Compare with using original features\nclf_orig = LogisticRegression(max_iter=200)\nclf_orig.fit(X_train, y[:1500])\npredictions_orig = clf_orig.predict(X_test)\naccuracy_orig = accuracy_score(y[1500:], predictions_orig)\n\nprint(f\"Accuracy with original features: {accuracy_orig:.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Deep undercomplete autoencoder\ndeep_autoencoder = keras.Sequential([\n    # Encoder: progressive compression\n    layers.Dense(512, activation='relu', input_shape=(784,)),\n    layers.Dense(256, activation='relu'),\n    layers.Dense(128, activation='relu'),\n    layers.Dense(64, activation='relu'),\n    layers.Dense(32, activation='relu'),\n    \n    # Bottleneck\n    layers.Dense(16, activation='relu'),\n    \n    # Decoder: progressive reconstruction\n    layers.Dense(32, activation='relu'),\n    layers.Dense(64, activation='relu'),\n    layers.Dense(128, activation='relu'),\n    layers.Dense(256, activation='relu'),\n    layers.Dense(512, activation='relu'),\n    layers.Dense(784, activation='sigmoid')\n])\n\ndeep_autoencoder.compile(optimizer='adam', loss='mse')"
        ]
      ]
    }
