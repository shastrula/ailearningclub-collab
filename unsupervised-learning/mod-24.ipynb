          "python",
          "print(\"\\nPRODUCTION NEXT STEPS:\\n\")\n\nprint(\"1. MODEL PERSISTENCE:\")\nprint(\"   - Save scaler (RobustScaler) for new customer normalization\")\nprint(\"   - Serialize K-Means model for inference\")\nprint(\"   - Version: timestamp + hyperparameters\")\nprint()\n\nprint(\"2. NEW CUSTOMER ASSIGNMENT:\")\nprint(\"   - Normalize using saved scaler\")\nprint(\"   - Predict cluster using saved K-Means model\")\nprint(\"   - Apply segment-specific strategy immediately\")\nprint()\n\nprint(\"3. MONITORING:\")\nprint(\"   - Track cluster distribution over time (should be stable)\")\nprint(\"   - Monitor silhouette score degradation (retrain if <0.4)\")\nprint(\"   - Alert if customer migrates between clusters unexpectedly\")\nprint()\n\nprint(\"4. RETRAINING SCHEDULE:\")\nprint(\"   - Quarterly: Recompute on new data\")\nprint(\"   - Annual: Full algorithm comparison\")\nprint(\"   - Real-time: Streaming updates for high-value customers\")\nprint()\n\nprint(\"5. BUSINESS INTEGRATION:\")\nprint(\"   - Dashboard: Segment breakdown, trends, churn risk\")\nprint(\"   - API: Assign segment when customer logs in\")\nprint(\"   - CRM: Segment-specific email, offers, support priority\")\nprint(\"   - Finance: Revenue forecasting by segment\")\n\n# Summary statistics\nprint(\"\\n\" + \"=\"*60)\nprint(f\"FINAL SUMMARY\")\nprint(\"=\"*60)\nprint(f\"Customers analyzed:       {len(data_clustered)}\")\nprint(f\"Features engineered:      {len(data.columns)}\")\nprint(f\"Final segments:           {optimal_k}\")\nprint(f\"Clustering quality:       {silhouette:.2f} (Silhouette)\")\nprint(f\"Actionability:            Ready for production\")\nprint(\"=\"*60)"
