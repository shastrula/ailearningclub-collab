      "metadata": {},
      "source": [
        "# Unsupervised Learning - mod-24\n\n",
        "**Course:** unsupervised-learning\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import StandardScaler, RobustScaler\nfrom sklearn.decomposition import PCA\nimport matplotlib.pyplot as plt\n\n# Create realistic customer dataset\nnp.random.seed(42)\nn_customers = 500\n\n# RFM Features\nrecency = np.random.exponential(30, n_customers)  # Days since last purchase\nfrequency = np.random.poisson(5, n_customers) + 1  # Number of purchases\nmonetary = np.random.gamma(2, 500, n_customers)  # Total spending\n\n# Additional features\navg_order_value = monetary / frequency\ndays_customer = np.random.exponential(200, n_customers)  # Account age\n\ndata = pd.DataFrame({\n    'recency': recency,\n    'frequency': frequency,\n    'monetary': monetary,\n    'avg_order_value': avg_order_value,\n    'days_customer': days_customer\n})\n\nprint(\"Dataset Overview:\")\nprint(data.describe())\nprint(f\"\\nMissing values: {data.isnull().sum().sum()}\")\nprint(f\"Dataset shape: {data.shape}\")\n\n# Check for outliers\nprint(\"\\nOutlier detection (IQR):\")\nfor col in data.columns:\n    Q1 = data[col].quantile(0.25)\n    Q3 = data[col].quantile(0.75)\n    IQR = Q3 - Q1\n    outlier_count = ((data[col] < Q1 - 1.5*IQR) | (data[col] > Q3 + 1.5*IQR)).sum()\n    print(f\"  {col}: {outlier_count} outliers\")\n\n# Handle outliers: cap at 95th percentile\ndata_capped = data.copy()\nfor col in data.columns:\n    p95 = data[col].quantile(0.95)\n    data_capped[col] = data_capped[col].clip(upper=p95)\n\nprint(f\"\\nData after capping: shape {data_capped.shape}\")\n\n# Normalization: use RobustScaler for outlier robustness\nscaler = RobustScaler()\ndata_scaled = scaler.fit_transform(data_capped)\ndata_scaled = pd.DataFrame(data_scaled, columns=data.columns)\n\nprint(\"Scaled data statistics:\")\nprint(data_scaled.describe())"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# PCA for visualization\npca = PCA(n_components=2)\npca_features = pca.fit_transform(data_scaled)\n\nprint(f\"PCA variance explained: {pca.explained_variance_ratio_.sum():.1%}\")\nprint(f\"PC1 variance: {pca.explained_variance_ratio_[0]:.1%}\")\nprint(f\"PC2 variance: {pca.explained_variance_ratio_[1]:.1%}\")\n\n# Find optimal dimensions for full analysis\npca_full = PCA()\npca_full.fit(data_scaled)\ncumsum = np.cumsum(pca_full.explained_variance_ratio_)\nn_components_95 = np.argmax(cumsum >= 0.95) + 1\nprint(f\"Dimensions for 95% variance: {n_components_95}\")\n\n# Visualize original data in PCA space (before clustering)\nfig, ax = plt.subplots(figsize=(8, 6))\nax.scatter(pca_features[:, 0], pca_features[:, 1], alpha=0.5, s=30)\nax.set_xlabel(f'PC1 ({pca.explained_variance_ratio_[0]:.1%})')\nax.set_ylabel(f'PC2 ({pca.explained_variance_ratio_[1]:.1%})')\nax.set_title('Customers in PCA Space (Before Clustering)')\nprint(\"(PCA visualization prepared)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.cluster import KMeans\n\n# Elbow method\ninertias = []\nsilhouette_scores = []\nK_range = range(2, 11)\n\nfrom sklearn.metrics import silhouette_score\n\nfor k in K_range:\n    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n    kmeans.fit(data_scaled)\n    inertias.append(kmeans.inertia_)\n    \n    sil_score = silhouette_score(data_scaled, kmeans.labels_)\n    silhouette_scores.append(sil_score)\n    \n    print(f\"K={k}: Inertia={kmeans.inertia_:.1f}, Silhouette={sil_score:.3f}\")\n\n# Optimal K: balance inertia reduction and silhouette score\noptimal_k = K_range[np.argmax(silhouette_scores)]\nprint(f\"\\nOptimal number of clusters: {optimal_k}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.cluster import KMeans, DBSCAN, AgglomerativeClustering\nfrom sklearn.preprocessing import StandardScaler as SS\n\n# Re-scale with StandardScaler for distance-based methods\nscaler_std = SS()\ndata_std = scaler_std.fit_transform(data_capped)\n\n# Algorithm 1: K-Means\nkmeans = KMeans(n_clusters=optimal_k, random_state=42, n_init=20)\nkm_labels = kmeans.fit_predict(data_std)\n\n# Algorithm 2: Hierarchical Clustering (Ward)\nhierarchical = AgglomerativeClustering(n_clusters=optimal_k, linkage='ward')\nhc_labels = hierarchical.fit_predict(data_std)\n\n# Algorithm 3: DBSCAN\n# Find epsilon using k-distance graph\nfrom sklearn.neighbors import NearestNeighbors\nneighbors = NearestNeighbors(n_neighbors=5)\nneighbors_fit = neighbors.fit(data_std)\ndistances, indices = neighbors_fit.kneighbors(data_std)\ndistances = np.sort(distances[:, -1])\n\n# Use 90th percentile as eps\neps = np.percentile(distances, 90)\ndbscan = DBSCAN(eps=eps, min_samples=5)\ndb_labels = dbscan.fit_predict(data_std)\n\nprint(f\"K-Means clusters: {len(set(km_labels))}\")\nprint(f\"Hierarchical clusters: {len(set(hc_labels))}\")\nprint(f\"DBSCAN clusters: {len(set(db_labels)) - (1 if -1 in db_labels else 0)}\")\nprint(f\"DBSCAN noise points: {(db_labels == -1).sum()}\")\n\n# Use K-Means for business analysis (most interpretable)\nfinal_labels = km_labels\nprint(f\"\\nUsing K-Means with {optimal_k} clusters for analysis\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Add cluster labels to original data\ndata_clustered = data.copy()\ndata_clustered['cluster'] = final_labels\n\n# Profile each cluster\nprint(\"CLUSTER PROFILES:\\n\")\nfor cluster in sorted(data_clustered['cluster'].unique()):\n    cluster_data = data_clustered[data_clustered['cluster'] == cluster]\n    \n    print(f\"Cluster {cluster} (n={len(cluster_data)}, {len(cluster_data)/len(data_clustered)*100:.1f}%):\")\n    print(f\"  Recency (days):      {cluster_data['recency'].mean():.1f} \u00b1 {cluster_data['recency'].std():.1f}\")\n    print(f\"  Frequency (orders):  {cluster_data['frequency'].mean():.1f} \u00b1 {cluster_data['frequency'].std():.1f}\")\n    print(f\"  Monetary (spending): ${cluster_data['monetary'].mean():.0f} \u00b1 ${cluster_data['monetary'].std():.0f}\")\n    print(f\"  Avg order value:     ${cluster_data['avg_order_value'].mean():.0f} \u00b1 ${cluster_data['avg_order_value'].std():.0f}\")\n    print(f\"  Customer age (days): {cluster_data['days_customer'].mean():.0f}\")\n    print()\n\n# Business interpretation\nprint(\"BUSINESS INSIGHTS:\\n\")\n\ncluster_means = data_clustered.groupby('cluster').mean()\nrecency_rank = cluster_means['recency'].rank()\nfrequency_rank = cluster_means['frequency'].rank(ascending=False)\nmonetary_rank = cluster_means['monetary'].rank(ascending=False)\n\nfor cluster in sorted(data_clustered['cluster'].unique()):\n    print(f\"Cluster {cluster}:\")\n    \n    rec = recency_rank[cluster]\n    freq = frequency_rank[cluster]\n    mon = monetary_rank[cluster]\n    \n    if rec <= 2 and freq >= 2 and mon >= 2:\n        print(\"  \u2192 BEST CUSTOMERS: Recent, frequent, high-value\")\n        print(\"  Strategy: VIP retention, loyalty rewards\")\n    elif rec >= 3 and freq <= 2 and mon <= 2:\n        print(\"  \u2192 AT-RISK: Inactive, low engagement\")\n        print(\"  Strategy: Re-engagement campaigns, win-back offers\")\n    elif freq >= 2.5:\n        print(\"  \u2192 FREQUENT BUYERS: High engagement\")\n        print(\"  Strategy: Cross-sell, upsell opportunities\")\n    else:\n        print(\"  \u2192 REGULAR CUSTOMERS: Moderate activity\")\n        print(\"  Strategy: Retention, engagement enhancement\")\n    print()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.metrics import silhouette_score, davies_bouldin_score, calinski_harabasz_score\n\n# Silhouette Score (higher is better)\nsilhouette = silhouette_score(data_std, final_labels)\n\n# Davies-Bouldin Index (lower is better)\ndavies_bouldin = davies_bouldin_score(data_std, final_labels)\n\n# Calinski-Harabasz Index (higher is better)\ncalinski_harabasz = calinski_harabasz_score(data_std, final_labels)\n\nprint(\"CLUSTERING QUALITY METRICS:\\n\")\nprint(f\"Silhouette Score:       {silhouette:.3f}\")\nprint(f\"  (Range: -1 to 1, >0.5 is good, >0.7 is excellent)\")\nprint(f\"Davies-Bouldin Index:   {davies_bouldin:.3f}\")\nprint(f\"  (Lower is better, <1.5 is good)\")\nprint(f\"Calinski-Harabasz Index: {calinski_harabasz:.1f}\")\nprint(f\"  (Higher is better, >500 is excellent)\")\n\n# Cluster size balance\nprint(f\"\\nCluster size distribution:\")\ncluster_sizes = data_clustered['cluster'].value_counts().sort_index()\nfor cluster, size in cluster_sizes.items():\n    pct = size / len(data_clustered) * 100\n    print(f\"  Cluster {cluster}: {size} customers ({pct:.1f}%)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Scatter plot of clusters in PCA space\npca_full = PCA(n_components=2)\npca_data = pca_full.fit_transform(data_std)\n\nfig, ax = plt.subplots(figsize=(10, 8))\ncolors = plt.cm.Set3(np.linspace(0, 1, optimal_k))\n\nfor cluster in sorted(set(final_labels)):\n    mask = final_labels == cluster\n    ax.scatter(pca_data[mask, 0], pca_data[mask, 1], \n              label=f'Cluster {cluster}', alpha=0.6, s=50, color=colors[cluster])\n\nax.set_xlabel(f'PC1 ({pca_full.explained_variance_ratio_[0]:.1%})')\nax.set_ylabel(f'PC2 ({pca_full.explained_variance_ratio_[1]:.1%})')\nax.set_title('Customer Segments (K-Means Clustering)')\nax.legend()\nprint(\"(Cluster visualization prepared)\")\n\n# Feature importance per cluster\nprint(\"\\nFEATURE PROFILES PER CLUSTER:\")\nnormalized_profiles = (cluster_means - cluster_means.min()) / (cluster_means.max() - cluster_means.min())\nprint(normalized_profiles.round(2))"
        ]
      ]
    },
    {
