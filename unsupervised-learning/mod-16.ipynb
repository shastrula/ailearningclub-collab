      "source": [
        "# Unsupervised Learning - mod-16\n\n",
        "**Course:** unsupervised-learning\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom sklearn.datasets import make_classification, load_breast_cancer\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import accuracy_score\nimport matplotlib.pyplot as plt\n\n# Create high-dimensional classification dataset\nX, y = make_classification(\n    n_samples=200,\n    n_features=50,  # 50 features\n    n_informative=10,  # Only 10 are truly informative\n    n_redundant=20,  # 20 are redundant\n    random_state=42\n)\n\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)\n\n# Baseline: all features\nscaler = StandardScaler()\nX_train_scaled = scaler.fit_transform(X_train)\nX_test_scaled = scaler.transform(X_test)\n\nclf = LogisticRegression(max_iter=1000)\nclf.fit(X_train_scaled, y_train)\nbaseline_acc = accuracy_score(y_test, clf.predict(X_test_scaled))\n\nprint(f\"Baseline accuracy (50 features): {baseline_acc:.3f}\")\n\n# We'll compare approaches later in the module"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.feature_selection import VarianceThreshold\n\n# Variance threshold: keep features with variance > threshold\n# Default threshold is mean variance\nvar_threshold = VarianceThreshold(threshold=0.01)\nX_filtered = var_threshold.fit_transform(X_train_scaled)\n\nprint(f\"Original features: {X_train_scaled.shape[1]}\")\nprint(f\"Features after variance thresholding: {X_filtered.shape[1]}\")\nprint(f\"Removed features: {X_train_scaled.shape[1] - X_filtered.shape[1]}\")\n\n# Evaluate\nX_test_filtered = var_threshold.transform(X_test_scaled)\nclf.fit(X_filtered, y_train)\nvar_threshold_acc = accuracy_score(y_test, clf.predict(X_test_filtered))\n\nprint(f\"Accuracy with variance filtering: {var_threshold_acc:.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.feature_selection import mutual_info_classif, SelectKBest\n\n# Calculate MI between each feature and target\nmi_scores = mutual_info_classif(X_train, y_train, random_state=42)\n\n# Select top k features by MI\nk = 15\nselector = SelectKBest(score_func=mutual_info_classif, k=k)\nX_mi_selected = selector.fit_transform(X_train, y_train)\n\n# Get selected feature indices\nselected_features = selector.get_support(indices=True)\n\nprint(f\"Top {k} features by MI: {selected_features}\")\nprint(f\"MI scores (top 10): {sorted(mi_scores, reverse=True)[:10]}\")\n\n# Visualize MI scores\nfig, ax = plt.subplots(figsize=(10, 6))\nsorted_idx = np.argsort(mi_scores)\nax.barh(range(len(mi_scores)), mi_scores[sorted_idx])\nax.set_xlabel('Mutual Information Score')\nax.set_ylabel('Feature Index')\nax.set_title('Feature Importance by Mutual Information')\nplt.tight_layout()\nplt.show()\n\n# Evaluate\nX_test_mi = selector.transform(X_test)\nX_test_mi_scaled = scaler.transform(X_test_mi)\nclf.fit(selector.transform(X_train), y_train)\nmi_acc = accuracy_score(y_test, clf.predict(X_test_mi_scaled))\n\nprint(f\"Accuracy with MI selection ({k} features): {mi_acc:.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.feature_selection import f_classif, SelectKBest\n\n# ANOVA F-test: for regression/classification, how much target variance each feature explains\nf_scores, p_values = f_classif(X_train, y_train)\n\n# Select features with significant p-values (p < 0.01)\nsignificant_features = np.where(p_values < 0.01)[0]\n\nprint(f\"Features with p < 0.01: {len(significant_features)}\")\nprint(f\"Top 10 features by F-score:\")\n\ntop_indices = np.argsort(f_scores)[-10:][::-1]\nfor idx in top_indices:\n    print(f\"  Feature {idx}: F-score={f_scores[idx]:.3f}, p-value={p_values[idx]:.4f}\")\n\n# Visualize\nfig, ax = plt.subplots(figsize=(10, 6))\nsorted_idx = np.argsort(f_scores)\nax.barh(range(len(f_scores)), f_scores[sorted_idx])\nax.set_xlabel('F-Score')\nax.set_ylabel('Feature Index')\nax.set_title('Feature Importance by ANOVA F-Test')\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.feature_selection import RFE\nfrom sklearn.linear_model import LogisticRegression\n\n# RFE: recursively remove least important features\nestimator = LogisticRegression(max_iter=1000, random_state=42)\nrfe = RFE(estimator=estimator, n_features_to_select=15, step=1)\nX_rfe = rfe.fit_transform(X_train_scaled, y_train)\n\nrfe_features = rfe.get_support(indices=True)\nprint(f\"Features selected by RFE: {rfe_features}\")\nprint(f\"Feature ranking: {rfe.ranking_}\")\n\n# Evaluate\nX_test_rfe = rfe.transform(X_test_scaled)\nclf.fit(X_rfe, y_train)\nrfe_acc = accuracy_score(y_test, clf.predict(X_test_rfe))\n\nprint(f\"Accuracy with RFE ({len(rfe_features)} features): {rfe_acc:.3f}\")\n\n# Compare RFE with different numbers of features\nn_features_range = range(5, 50, 5)\nrfe_accuracies = []\n\nfor n_feat in n_features_range:\n    rfe_temp = RFE(estimator=estimator, n_features_to_select=n_feat, step=1)\n    X_rfe_temp = rfe_temp.fit_transform(X_train_scaled, y_train)\n    X_test_rfe_temp = rfe_temp.transform(X_test_scaled)\n    \n    clf_temp = LogisticRegression(max_iter=1000)\n    clf_temp.fit(X_rfe_temp, y_train)\n    acc = accuracy_score(y_test, clf_temp.predict(X_test_rfe_temp))\n    rfe_accuracies.append(acc)\n\nfig, ax = plt.subplots()\nax.plot(n_features_range, rfe_accuracies, 'o-', linewidth=2, markersize=8)\nax.axhline(baseline_acc, color='red', linestyle='--', label='Baseline (all features)')\nax.set_xlabel('Number of Features')\nax.set_ylabel('Accuracy')\nax.set_title('RFE: Accuracy vs. Number of Features')\nax.legend()\nax.grid(True, alpha=0.3)\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.linear_model import LassoCV\nfrom sklearn.preprocessing import StandardScaler\n\n# LassoCV: automatically select optimal regularization strength\nlasso = LassoCV(cv=5, random_state=42, max_iter=5000)\nlasso.fit(X_train_scaled, y_train)\n\n# Features with non-zero coefficients\nselected_lasso = np.where(lasso.coef_ != 0)[0]\n\nprint(f\"Number of features selected by LASSO: {len(selected_lasso)}\")\nprint(f\"Optimal alpha (regularization strength): {lasso.alpha_:.4f}\")\nprint(f\"Selected features: {selected_lasso}\")\n\n# Visualize feature coefficients\nfig, ax = plt.subplots(figsize=(10, 6))\ncolors = ['red' if c == 0 else 'blue' for c in lasso.coef_]\nax.bar(range(len(lasso.coef_)), lasso.coef_, color=colors, alpha=0.7)\nax.axhline(0, color='black', linestyle='-', linewidth=0.5)\nax.set_xlabel('Feature Index')\nax.set_ylabel('Coefficient Value')\nax.set_title(f'LASSO Feature Selection (\u03b1={lasso.alpha_:.4f})')\nplt.tight_layout()\nplt.show()\n\n# Evaluate\nX_train_lasso = X_train_scaled[:, selected_lasso]\nX_test_lasso = X_test_scaled[:, selected_lasso]\n\nclf = LogisticRegression(max_iter=1000)\nclf.fit(X_train_lasso, y_train)\nlasso_acc = accuracy_score(y_test, clf.predict(X_test_lasso))\n\nprint(f\"Accuracy with LASSO ({len(selected_lasso)} features): {lasso_acc:.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.ensemble import RandomForestClassifier\n\n# Train random forest\nrf = RandomForestClassifier(n_estimators=100, random_state=42)\nrf.fit(X_train, y_train)\n\n# Feature importances (how much each feature decreases impurity)\nimportances = rf.feature_importances_\nindices = np.argsort(importances)[-15:]  # Top 15\n\nprint(f\"Top 15 features by Random Forest importance:\")\nfor i, idx in enumerate(indices[::-1], 1):\n    print(f\"  {i}. Feature {idx}: {importances[idx]:.4f}\")\n\n# Visualize\nfig, ax = plt.subplots(figsize=(10, 6))\nax.barh(range(len(importances[indices])), importances[indices])\nax.set_yticks(range(len(importances[indices])))\nax.set_yticklabels([f'Feature {i}' for i in indices])\nax.set_xlabel('Feature Importance')\nax.set_title('Random Forest Feature Importances')\nplt.tight_layout()\nplt.show()\n\n# Evaluate\ntop_features = indices[-10:]  # Top 10\nX_train_rf = X_train[:, top_features]\nX_test_rf = X_test[:, top_features]\n\nclf = LogisticRegression(max_iter=1000)\nclf.fit(X_train_rf, y_train)\nrf_acc = accuracy_score(y_test, clf.predict(X_test_rf))\n\nprint(f\"Accuracy with RF feature selection (10 features): {rf_acc:.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Summary comparison\nmethods = {\n    'Baseline (all 50)': (baseline_acc, 50),\n    'Variance Threshold': (var_threshold_acc, X_filtered.shape[1]),\n    'MI Selection': (mi_acc, k),\n    'RFE': (rfe_acc, len(rfe_features)),\n    'LASSO': (lasso_acc, len(selected_lasso)),\n    'Random Forest': (rf_acc, len(top_features))\n}\n\nfig, ax = plt.subplots(figsize=(12, 6))\n\nnames = list(methods.keys())\naccuracies = [v[0] for v in methods.values()]\nn_features = [v[1] for v in methods.values()]\n\ncolors = plt.cm.viridis(np.linspace(0, 1, len(names)))\nbars = ax.bar(names, accuracies, color=colors, alpha=0.7, edgecolor='black')\n\n# Add feature count labels on bars\nfor bar, n_feat in zip(bars, n_features):\n    height = bar.get_height()\n    ax.text(bar.get_x() + bar.get_width()/2., height,\n           f'{n_feat} feat',\n           ha='center', va='bottom', fontsize=9)\n\nax.set_ylabel('Accuracy')\nax.set_title('Feature Selection Methods Comparison')\nax.set_ylim([min(accuracies) - 0.05, max(accuracies) + 0.1])\nplt.xticks(rotation=45, ha='right')\nplt.tight_layout()\nplt.show()"
        ]
      ]
    }
