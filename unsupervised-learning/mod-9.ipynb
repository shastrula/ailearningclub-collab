      "source": [
        [
          "python",
          "from sklearn.decomposition import IncrementalPCA\nfrom sklearn.datasets import load_digits\nimport numpy as np\n\n# Load digits dataset (64 features)\nX = load_digits().data\nn_components = 10\n\n# Standard PCA (for comparison)\npca = PCA(n_components=n_components)\npca.fit(X)\nvariance_standard = pca.explained_variance_ratio_\n\n# Incremental PCA with batch processing\nipca = IncrementalPCA(n_components=n_components, batch_size=10)\n\n# Process data in 10-sample batches\nfor i in range(0, X.shape[0], 10):\n    batch = X[i:i+10]\n    ipca.partial_fit(batch)\n\nvariance_incremental = ipca.explained_variance_ratio_\n\nprint(\"Standard PCA variance:\", variance_standard[:5])\nprint(\"Incremental PCA variance:\", variance_incremental[:5])\nprint(\"Match:\", np.allclose(variance_standard, variance_incremental))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
