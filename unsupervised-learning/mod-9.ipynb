      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.decomposition import SparsePCA\nfrom sklearn.preprocessing import StandardScaler\nimport pandas as pd\n\n# Use a dataset with interpretable features\nX = pd.DataFrame({\n    'age': np.random.randint(20, 80, 100),\n    'income': np.random.randint(30000, 150000, 100),\n    'education': np.random.randint(8, 20, 100),\n    'hours_worked': np.random.randint(20, 60, 100),\n    'savings': np.random.randint(1000, 100000, 100),\n}).values\n\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\n# Standard PCA: all features in each component\npca = PCA(n_components=2)\npca.fit(X_scaled)\n\n# Sparse PCA: only important features in each component\nspca = SparsePCA(n_components=2, alpha=0.01, random_state=42, max_iter=100)\nspca.fit(X_scaled)\n\nprint(\"Standard PCA - PC1 loadings (all features):\")\nprint(pca.components_[0])\nprint(\"\\nSparse PCA - PC1 loadings (sparse):\")\nprint(spca.components_[0])\nprint(\"Number of zero weights in Sparse PC1:\", np.sum(spca.components_[0] == 0))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.decomposition import RandomizedPCA\nimport time\n\n# Create large dataset\nX_large = np.random.randn(5000, 2000)\n\n# Standard PCA\nstart = time.time()\npca = PCA(n_components=50)\npca.fit(X_large)\ntime_standard = time.time() - start\n\n# Randomized PCA\nstart = time.time()\nrpca = RandomizedPCA(n_components=50, random_state=42)\nrpca.fit(X_large)\ntime_randomized = time.time() - start\n\nprint(f\"Standard PCA: {time_standard:.3f}s\")\nprint(f\"Randomized PCA: {time_randomized:.3f}s\")\nprint(f\"Speedup: {time_standard/time_randomized:.1f}x\")\nprint(f\"Variance match: {np.allclose(pca.explained_variance_ratio_, rpca.explained_variance_ratio_, atol=0.01)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.decomposition import PCA\nfrom sklearn.preprocessing import StandardScaler\n\nX = load_digits().data\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\nerrors = []\nvariances = []\n\nfor n_comp in range(1, 65):\n    pca = PCA(n_components=n_comp)\n    X_reduced = pca.fit_transform(X_scaled)\n    X_recon = pca.inverse_transform(X_reduced)\n    \n    # Reconstruction error\n    mse = np.mean((X_scaled - X_recon) ** 2)\n    errors.append(mse)\n    \n    # Cumulative variance\n    cum_var = np.sum(pca.explained_variance_ratio_)\n    variances.append(cum_var)\n\n# Plot trade-off\nfig, ax1 = plt.subplots()\nax1.plot(range(1, 65), errors, 'b-', label='Reconstruction Error')\nax1.set_xlabel('Number of Components')\nax1.set_ylabel('MSE', color='b')\nax1.tick_params(axis='y', labelcolor='b')\n\nax2 = ax1.twinx()\nax2.plot(range(1, 65), variances, 'r-', label='Cumulative Variance')\nax2.set_ylabel('Explained Variance Ratio', color='r')\nax2.tick_params(axis='y', labelcolor='r')\n\nplt.title('PCA: Reconstruction Error vs. Variance Explained')\nplt.show()"
        ]
      ]
    }
