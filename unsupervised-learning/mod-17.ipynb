        [
          "python",
          "from sklearn.datasets import load_digits\nfrom tensorflow import keras\nfrom tensorflow.keras import layers\nimport matplotlib.pyplot as plt\n\n# Load digit images (8x8 grayscale)\nX = load_digits().data\nX = X / 16.0  # Normalize to [0, 1]\n\n# Split\nX_train = X[:1000]\nX_test = X[1000:]\n\n# Build autoencoder for image compression\n# Original: 64 pixels \u2192 Compressed: 16 \u2192 Reconstructed: 64\nencoder = keras.Sequential([\n    layers.Dense(32, activation='relu', input_shape=(64,)),\n    layers.Dense(16, activation='relu')  # Compression layer\n])\n\ndecoder = keras.Sequential([\n    layers.Dense(32, activation='relu', input_shape=(16,)),\n    layers.Dense(64, activation='sigmoid')\n])\n\nautoencoder = keras.Sequential([encoder, decoder])\nautoencoder.compile(optimizer='adam', loss='mse')\n\n# Train\nhistory = autoencoder.fit(\n    X_train, X_train,\n    epochs=50,\n    batch_size=32,\n    validation_split=0.2,\n    verbose=0\n)\n\n# Compression analysis\ncompressed = encoder.predict(X_test)\nreconstructed = autoencoder.predict(X_test)\n\n# Calculate reconstruction error\nmse_per_image = np.mean((X_test - reconstructed) ** 2, axis=1)\navg_mse = mse_per_image.mean()\n\nprint(f\"Compression Statistics:\")\nprint(f\"  Original size: 64 pixels per image\")\nprint(f\"  Compressed size: 16 values per image\")\nprint(f\"  Compression ratio: {64/16:.1f}x\")\nprint(f\"  Average reconstruction MSE: {avg_mse:.4f}\")\nprint(f\"  Average PSNR: {-10*np.log10(avg_mse):.2f} dB\")\n\n# Visualize compression quality\nfig, axes = plt.subplots(3, 10, figsize=(15, 4))\n\nfor i in range(10):\n    # Original\n    axes[0, i].imshow(X_test[i].reshape(8, 8), cmap='gray')\n    axes[0, i].set_title('Original')\n    axes[0, i].axis('off')\n    \n    # Compressed representation (16 values: can't visualize directly)\n    axes[1, i].bar(range(16), compressed[i], alpha=0.7)\n    axes[1, i].set_title('Compressed (16D)')\n    axes[1, i].set_ylim([0, 1])\n    axes[1, i].axis('off')\n    \n    # Reconstructed\n    axes[2, i].imshow(reconstructed[i].reshape(8, 8), cmap='gray')\n    axes[2, i].set_title(f'Reconstructed (MSE={mse_per_image[i]:.3f})')\n    axes[2, i].axis('off')\n\nplt.suptitle('Image Compression with Autoencoder', fontsize=14)\nplt.tight_layout()\nplt.show()\n\n# Storage calculation\nprint(f\"\\nStorage Requirements:\")\nprint(f\"  Original (10,000 images): {10000 * 64 * 4 / 1e6:.1f} MB (32-bit float)\")\nprint(f\"  Compressed: {10000 * 16 * 4 / 1e6:.1f} MB\")\nprint(f\"  Storage saving: {(1 - 16/64) * 100:.0f}%\")"
        ]
      ]
