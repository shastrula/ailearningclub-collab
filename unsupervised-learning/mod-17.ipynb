        [
          "python",
          "import pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.cluster import KMeans\nfrom sklearn.metrics import silhouette_score\nimport matplotlib.pyplot as plt\n\n# Create synthetic customer dataset\nnp.random.seed(42)\nn_customers = 500\n\n# Generate realistic customer segments\nsegment1 = np.column_stack([\n    np.random.normal(30, 5, 150),      # Age\n    np.random.normal(25000, 5000, 150), # Annual spending\n    np.random.normal(0.3, 0.1, 150),    # Purchase frequency (per month)\n    np.random.normal(3, 1, 150)         # Loyalty (years as customer)\n])\n\nsegment2 = np.column_stack([\n    np.random.normal(45, 8, 200),\n    np.random.normal(60000, 15000, 200),\n    np.random.normal(0.8, 0.15, 200),\n    np.random.normal(7, 2, 200)\n])\n\nsegment3 = np.column_stack([\n    np.random.normal(65, 7, 150),\n    np.random.normal(40000, 8000, 150),\n    np.random.normal(0.5, 0.2, 150),\n    np.random.normal(10, 2, 150)\n])\n\nX_customers = np.vstack([segment1, segment2, segment3])\ncolumns = ['Age', 'Annual_Spending', 'Purchase_Frequency', 'Loyalty_Years']\n\ndf = pd.DataFrame(X_customers, columns=columns)\n\n# Add some noise\nfor col in columns:\n    df[col] = np.maximum(0, df[col] + np.random.normal(0, 0.05*df[col].std(), len(df)))\n\nprint(\"Customer Dataset Summary:\")\nprint(df.describe())\n\n# Preprocessing: standardize features (different scales)\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(df)\n\n# Determine optimal number of clusters\nsilhouette_scores = []\ninertias = []\nK_range = range(2, 10)\n\nfor k in K_range:\n    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n    labels = kmeans.fit_predict(X_scaled)\n    sil_score = silhouette_score(X_scaled, labels)\n    silhouette_scores.append(sil_score)\n    inertias.append(kmeans.inertia_)\n\n# Plot elbow curve\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\naxes[0].plot(K_range, inertias, 'o-', linewidth=2)\naxes[0].set_xlabel('Number of Segments')\naxes[0].set_ylabel('Inertia')\naxes[0].set_title('Elbow Method')\naxes[0].grid(True, alpha=0.3)\n\naxes[1].plot(K_range, silhouette_scores, 'o-', linewidth=2, color='orange')\naxes[1].set_xlabel('Number of Segments')\naxes[1].set_ylabel('Silhouette Score')\naxes[1].set_title('Silhouette Analysis')\naxes[1].grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.show()\n\n# Optimal k appears to be 3 (elbow) or matches silhouette peak\noptimal_k = 3\nkmeans = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)\ndf['Segment'] = kmeans.fit_predict(X_scaled)\n\nprint(f\"\\nSegmentation Results (k={optimal_k}):\")\nfor seg in range(optimal_k):\n    segment_data = df[df['Segment'] == seg]\n    print(f\"\\nSegment {seg} ({len(segment_data)} customers):\")\n    print(segment_data[columns].describe().loc[['mean', 'std']])\n    \n    # Business interpretation\n    avg_spending = segment_data['Annual_Spending'].mean()\n    avg_frequency = segment_data['Purchase_Frequency'].mean()\n    \n    if avg_spending > 50000 and avg_frequency > 0.7:\n        print(\"  \u2192 HIGH VALUE: Frequent high-spenders\")\n    elif avg_spending < 30000 and avg_frequency < 0.4:\n        print(\"  \u2192 LOW ENGAGEMENT: At-risk for churn\")\n    else:\n        print(\"  \u2192 REGULAR: Stable customers\")\n\n# Visualization: 2D projection (Annual Spending vs Frequency)\nfig, ax = plt.subplots(figsize=(10, 7))\nscatter = ax.scatter(df['Annual_Spending'], df['Purchase_Frequency'],\n                     c=df['Segment'], cmap='viridis', s=50, alpha=0.6)\n\n# Plot segment centroids\ncentroids = scaler.inverse_transform(kmeans.cluster_centers_)\nax.scatter(centroids[:, 1], centroids[:, 2], c='red', marker='X', s=300,\n          edgecolors='black', linewidth=2, label='Centroids')\n\nax.set_xlabel('Annual Spending ($)')\nax.set_ylabel('Purchase Frequency (per month)')\nax.set_title('Customer Segments')\nax.legend()\nplt.colorbar(scatter, ax=ax, label='Segment')\nplt.tight_layout()\nplt.show()\n\n# Business actions per segment\nprint(\"\\nRecommended Actions:\")\nfor seg in range(optimal_k):\n    segment_data = df[df['Segment'] == seg]\n    print(f\"\\nSegment {seg}:\")\n    if segment_data['Annual_Spending'].mean() > 50000:\n        print(\"  - VIP loyalty program\")\n        print(\"  - Exclusive early access to new products\")\n    elif segment_data['Purchase_Frequency'].mean() < 0.4:\n        print(\"  - Reactivation campaign (discount offer)\")\n        print(\"  - Personalized recommendations\")\n    else:\n        print(\"  - Regular engagement emails\")\n        print(\"  - Seasonal promotions\")"
        ]
      ]
    },
