          "python",
          "# Simulate gene expression data (patients \u00d7 genes)\nnp.random.seed(42)\nn_patients = 100\nn_genes = 5000\n\n# Healthy patients\nhealthy = np.random.normal(1.0, 0.3, (30, n_genes))\n\n# Disease subtype A: different expression pattern\ndiseaseA = np.random.normal(2.5, 0.4, (35, n_genes))\n\n# Disease subtype B: different from A\ndiseaseB = np.random.normal(0.5, 0.3, (35, n_genes))\n\nX_genes = np.vstack([healthy, diseaseA, diseaseB])\ntrue_types = np.array([0]*30 + [1]*35 + [2]*35)\n\n# Preprocessing: log-transform and standardize (standard in genomics)\nX_log = np.log2(X_genes + 1)  # Avoid log(0)\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X_log)\n\n# Dimensionality reduction: PCA to visualize genes patterns\nfrom sklearn.decomposition import PCA\n\npca = PCA(n_components=50)\nX_pca = pca.fit_transform(X_scaled)\n\nprint(f\"Gene Expression Data:\")\nprint(f\"  Original dimensions: {X_genes.shape}\")\nprint(f\"  Samples: {X_genes.shape[0]} patients\")\nprint(f\"  Features: {X_genes.shape[1]} genes\")\nprint(f\"  PCA components explaining 95% variance: {sum(np.cumsum(pca.explained_variance_ratio_) <= 0.95)}\")\n\n# Clustering\nkmeans_genes = KMeans(n_clusters=3, random_state=42, n_init=20)\nclusters = kmeans_genes.fit_predict(X_pca)\n\n# Evaluate\nfrom sklearn.metrics import adjusted_rand_score, normalized_mutual_info_score\n\nari = adjusted_rand_score(true_types, clusters)\nnmi = normalized_mutual_info_score(true_types, clusters)\n\nprint(f\"\\nClustering Quality:\")\nprint(f\"  Adjusted Rand Index: {ari:.3f}\")\nprint(f\"  Normalized Mutual Information: {nmi:.3f}\")\n\n# Visualize first 2 PCs\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n# Colored by true type\nscatter1 = axes[0].scatter(X_pca[:, 0], X_pca[:, 1], c=true_types, cmap='viridis',\n                          s=50, alpha=0.6)\naxes[0].set_xlabel(f'PC1 ({pca.explained_variance_ratio_[0]:.1%})')\naxes[0].set_ylabel(f'PC2 ({pca.explained_variance_ratio_[1]:.1%})')\naxes[0].set_title('True Gene Expression Types')\nplt.colorbar(scatter1, ax=axes[0])\n\n# Colored by cluster\nscatter2 = axes[1].scatter(X_pca[:, 0], X_pca[:, 1], c=clusters, cmap='viridis',\n                          s=50, alpha=0.6)\naxes[1].scatter(kmeans_genes.cluster_centers_[:, 0], kmeans_genes.cluster_centers_[:, 1],\n               c='red', marker='X', s=200, edgecolors='black', linewidth=2)\naxes[1].set_xlabel(f'PC1 ({pca.explained_variance_ratio_[0]:.1%})')\naxes[1].set_ylabel(f'PC2 ({pca.explained_variance_ratio_[1]:.1%})')\naxes[1].set_title('Discovered Clusters')\nplt.colorbar(scatter2, ax=axes[1])\n\nplt.tight_layout()\nplt.show()\n\n# Identify discriminative genes\n# Find genes with largest loadings on first PCA components\nloadings = pca.components_[:3]  # First 3 PCs\ntop_genes = np.argsort(np.abs(loadings).max(axis=0))[-20:]  # Top 20 genes\n\nprint(f\"\\nTop 20 genes driving clustering (by PC loadings):\")\nprint(f\"  Gene indices: {top_genes}\")"
        ]
      ]
    }
