          "python",
          "from sklearn.ensemble import IsolationForest\nfrom sklearn.svm import OneClassSVM\nimport matplotlib.pyplot as plt\n\n# Create sensor data: mostly normal operations + anomalies\nnp.random.seed(42)\n\n# Normal operation: temperatures around 70\u00b0C, vibration low\nnormal_data = np.column_stack([\n    np.random.normal(70, 2, 400),      # Temperature\n    np.random.normal(0.5, 0.1, 400)    # Vibration\n])\n\n# Anomalies: equipment failure patterns\nanomalies = np.column_stack([\n    np.random.normal(95, 5, 20),       # High temperature\n    np.random.normal(2.5, 0.5, 20)     # High vibration\n])\n\nX_sensors = np.vstack([normal_data, anomalies])\ny_true = np.array([0]*400 + [1]*20)  # 0=normal, 1=anomaly\n\n# Isolate anomalies using multiple methods\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n# Method 1: Isolation Forest\niso_forest = IsolationForest(contamination=0.05, random_state=42)\ny_iso = iso_forest.fit_predict(X_sensors)  # -1=anomaly, 1=normal\n\n# Method 2: One-Class SVM\nocs = OneClassSVM(nu=0.05, kernel='rbf', gamma='auto')\ny_ocs = ocs.fit_predict(X_sensors)\n\n# Plot results\nscatter1 = axes[0].scatter(X_sensors[y_iso == 1, 0], X_sensors[y_iso == 1, 1],\n                          c='blue', label='Normal', s=30, alpha=0.6)\naxes[0].scatter(X_sensors[y_iso == -1, 0], X_sensors[y_iso == -1, 1],\n               c='red', marker='X', s=100, label='Anomaly', edgecolors='black', linewidth=1.5)\naxes[0].set_xlabel('Temperature (\u00b0C)')\naxes[0].set_ylabel('Vibration Level')\naxes[0].set_title('Isolation Forest Anomaly Detection')\naxes[0].legend()\naxes[0].grid(True, alpha=0.3)\n\nscatter2 = axes[1].scatter(X_sensors[y_ocs == 1, 0], X_sensors[y_ocs == 1, 1],\n                          c='blue', label='Normal', s=30, alpha=0.6)\naxes[1].scatter(X_sensors[y_ocs == -1, 0], X_sensors[y_ocs == -1, 1],\n               c='red', marker='X', s=100, label='Anomaly', edgecolors='black', linewidth=1.5)\naxes[1].set_xlabel('Temperature (\u00b0C)')\naxes[1].set_ylabel('Vibration Level')\naxes[1].set_title('One-Class SVM Anomaly Detection')\naxes[1].legend()\naxes[1].grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.show()\n\n# Evaluation: anomalies are known in this case\nfrom sklearn.metrics import precision_score, recall_score, f1_score\n\n# Convert to binary (1=anomaly, 0=normal for both methods)\ny_iso_binary = (y_iso == -1).astype(int)\ny_ocs_binary = (y_ocs == -1).astype(int)\n\nprint(\"Isolation Forest Performance:\")\nprint(f\"  Precision: {precision_score(y_true, y_iso_binary):.3f}\")\nprint(f\"  Recall: {recall_score(y_true, y_iso_binary):.3f}\")\nprint(f\"  F1-Score: {f1_score(y_true, y_iso_binary):.3f}\")\n\nprint(\"\\nOne-Class SVM Performance:\")\nprint(f\"  Precision: {precision_score(y_true, y_ocs_binary):.3f}\")\nprint(f\"  Recall: {recall_score(y_true, y_ocs_binary):.3f}\")\nprint(f\"  F1-Score: {f1_score(y_true, y_ocs_binary):.3f}\")\n\n# Real-time application: predict on new sensor readings\nnew_readings = np.array([\n    [72, 0.6],      # Normal\n    [73, 0.55],     # Normal\n    [92, 2.3],      # Anomaly\n    [71, 0.5]       # Normal\n])\n\nanomaly_scores = iso_forest.score_samples(new_readings)\npredictions = iso_forest.predict(new_readings)\n\nprint(\"\\nNew Sensor Readings - Anomaly Detection:\")\nfor i, (temp, vib) in enumerate(new_readings):\n    status = \"ALERT: Anomaly Detected!\" if predictions[i] == -1 else \"Normal\"\n    print(f\"  Temp={temp}\u00b0C, Vib={vib}: {status} (Score={anomaly_scores[i]:.3f})\")"
        ]
      ]
