      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom sklearn.ensemble import IsolationForest\nfrom sklearn.datasets import make_blobs\n\n# Generate normal data with embedded anomalies\nX_normal, _ = make_blobs(n_samples=300, centers=1, n_features=2, random_state=42)\nX_anomalies = np.random.uniform(-10, 10, (10, 2))\nX = np.vstack([X_normal, X_anomalies])\n\n# Train Isolation Forest\niso_forest = IsolationForest(contamination=0.03, random_state=42)\nanomaly_labels = iso_forest.fit_predict(X)\nanomaly_scores = iso_forest.score_samples(X)\n\n# -1 = anomaly, 1 = normal\nprint(f\"Detected {(anomaly_labels == -1).sum()} anomalies\")\nprint(f\"Anomaly scores range: [{anomaly_scores.min():.2f}, {anomaly_scores.max():.2f}]\")\n\n# Real-world example: credit card transactions\nimport pandas as pd\n\ntransactions = pd.DataFrame({\n    'amount': np.concatenate([np.random.normal(50, 30, 1000), np.array([5000, 5100, 4950])]),\n    'merchant_risk': np.concatenate([np.random.uniform(0, 0.2, 1000), np.array([0.9, 0.95, 0.88])])\n})\n\niso = IsolationForest(contamination=0.005)\ntransactions['is_anomaly'] = iso.fit_predict(transactions[['amount', 'merchant_risk']]) == -1\nprint(f\"\\nDetected {transactions['is_anomaly'].sum()} fraudulent transactions\")\nprint(transactions[transactions['is_anomaly']])"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.neighbors import LocalOutlierFactor\n\n# Same dataset\nlof = LocalOutlierFactor(n_neighbors=20, contamination=0.03)\nlof_labels = lof.fit_predict(X)\nlof_scores = -lof.negative_outlier_factor_\n\nprint(f\"LOF detected {(lof_labels == -1).sum()} anomalies\")\nprint(f\"LOF scores (higher = more anomalous): {lof_scores[:5]}\")\n\n# LOF excels when anomalies have varying local densities\n# Transactions with unusual merchant behavior\ntransactions_lof = pd.DataFrame({\n    'transaction_value': np.concatenate([\n        np.random.normal(100, 50, 500),\n        np.random.normal(200, 100, 500),\n        np.array([50000, 45000])  # Extreme transactions\n    ]),\n    'merchant_frequency': np.concatenate([\n        np.random.poisson(10, 500),\n        np.random.poisson(20, 500),\n        np.array([1, 1])  # New merchants\n    ])\n})\n\nlof_detector = LocalOutlierFactor(n_neighbors=15, contamination=0.01)\ntransactions_lof['is_anomaly'] = lof_detector.fit_predict(transactions_lof) == -1\nprint(f\"\\nLOF fraud detections: {transactions_lof['is_anomaly'].sum()}\")"
        ]
      ]
    },
    {
