        [
          "python",
          "from scipy.spatial.distance import mahalanobis\nfrom scipy import stats\n\n# Transaction amounts and frequency (correlated features)\ndata = np.random.multivariate_normal([100, 10], [[500, 50], [50, 5]], 500)\nanomaly_point = np.array([[5000, 0.5]])\n\nmean = np.mean(data, axis=0)\ncov = np.cov(data.T)\ninv_cov = np.linalg.inv(cov)\n\n# Mahalanobis distance\ndistances = []\nfor point in data:\n    dist = mahalanobis(point, mean, inv_cov)\n    distances.append(dist)\n\ndistances = np.array(distances)\n\n# Points beyond 99th percentile are anomalies\nthreshold = np.percentile(distances, 99)\nanomaly_mask = distances > threshold\n\nprint(f\"Mahalanobis distance threshold: {threshold:.2f}\")\nprint(f\"Normal data anomalies: {anomaly_mask.sum()}\")\n\n# For new transactions\ntest_point = np.array([5000, 0.5])\ntest_dist = mahalanobis(test_point, mean, inv_cov)\nprint(f\"Test point distance: {test_dist:.2f} \u2192 {'ANOMALY' if test_dist > threshold else 'NORMAL'}\")"
        ]
      ]
    }
