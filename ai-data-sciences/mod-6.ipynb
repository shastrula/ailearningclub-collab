      "source": [
        [
          "python",
          "import matplotlib.pyplot as plt\nimport numpy as np\n\n# Generate sample data\nages = np.random.normal(35, 10, 1000)\n\nplt.figure(figsize=(8, 5))\nplt.hist(ages, bins=30, edgecolor='black', alpha=0.7, color='steelblue')\nplt.xlabel('Age')\nplt.ylabel('Frequency')\nplt.title('Age Distribution of Customers')\nplt.axvline(np.mean(ages), color='red', linestyle='--', label=f'Mean: {np.mean(ages):.1f}')\nplt.legend()\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import pandas as pd\n\n# Simulated data\nnp.random.seed(42)\nstudy_hours = np.random.uniform(1, 10, 50)\nexam_scores = 40 + 5 * study_hours + np.random.normal(0, 5, 50)\n\nplt.figure(figsize=(8, 5))\nplt.scatter(study_hours, exam_scores, alpha=0.6, c='teal', edgecolors='black')\nplt.xlabel('Study Hours per Day')\nplt.ylabel('Exam Score')\nplt.title('Study Hours vs Exam Performance')\n\n# Add trend line\nz = np.polyfit(study_hours, exam_scores, 1)\np = np.poly1d(z)\nplt.plot(sorted(study_hours), p(sorted(study_hours)), \"r--\", label=f'Trend: y={z[0]:.1f}x+{z[1]:.1f}')\nplt.legend()\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
