      "outputs": [],
      "source": [
        [
          "python",
          "import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Create sample time series: monthly airline passengers\nnp.random.seed(42)\ndates = pd.date_range('2018-01-01', periods=72, freq='M')\ntrend = np.linspace(100, 200, 72)\nseasonal = 30 * np.sin(2 * np.pi * np.arange(72) / 12)\nnoise = np.random.normal(0, 10, 72)\npassengers = trend + seasonal + noise\n\nts = pd.Series(passengers, index=dates)\n\n# Plot\nplt.figure(figsize=(12, 5))\nts.plot()\nplt.title('Monthly Airline Passengers')\nplt.ylabel('Passengers (thousands)')\nplt.xlabel('Date')\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from statsmodels.tsa.seasonal import seasonal_decompose\n\n# Decompose into components\ndecomposition = seasonal_decompose(ts, model='additive', period=12)\n\nfig, axes = plt.subplots(4, 1, figsize=(12, 10))\ndecomposition.observed.plot(ax=axes[0], title='Observed')\ndecomposition.trend.plot(ax=axes[1], title='Trend')\ndecomposition.seasonal.plot(ax=axes[2], title='Seasonal')\ndecomposition.resid.plot(ax=axes[3], title='Residual')\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from statsmodels.tsa.stattools import adfuller\n\n# Augmented Dickey-Fuller test\nresult = adfuller(ts)\nprint(f\"ADF Statistic: {result[0]:.4f}\")\nprint(f\"p-value: {result[1]:.4f}\")\n# p-value < 0.05 \u2192 stationary\n# p-value > 0.05 \u2192 non-stationary (needs differencing)\n\n# Make stationary by differencing\nts_diff = ts.diff().dropna()\nresult_diff = adfuller(ts_diff)\nprint(f\"\\nAfter differencing:\")\nprint(f\"ADF Statistic: {result_diff[0]:.4f}\")\nprint(f\"p-value: {result_diff[1]:.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Simple Moving Average (SMA)\nts_sma_7 = ts.rolling(window=7).mean()\nts_sma_30 = ts.rolling(window=12).mean()\n\nplt.figure(figsize=(12, 5))\nts.plot(label='Original', alpha=0.5)\nts_sma_7.plot(label='7-month SMA', linewidth=2)\nts_sma_30.plot(label='12-month SMA', linewidth=2)\nplt.legend()\nplt.title('Moving Averages')\nplt.tight_layout()\nplt.show()\n\n# Exponential Moving Average (EMA) \u2014 recent data weighted more\nts_ema = ts.ewm(span=12).mean()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from statsmodels.tsa.arima.model import ARIMA\n\n# Split: train on first 60 months, test on last 12\ntrain = ts[:60]\ntest = ts[60:]\n\n# ARIMA(p, d, q): p=autoregressive, d=differencing, q=moving average\nmodel = ARIMA(train, order=(2, 1, 2))\nfitted = model.fit()\nprint(fitted.summary())\n\n# Forecast\nforecast = fitted.forecast(steps=12)\n\nplt.figure(figsize=(12, 5))\ntrain.plot(label='Train')\ntest.plot(label='Actual')\nforecast.plot(label='Forecast', linestyle='--')\nplt.legend()\nplt.title('ARIMA Forecast')\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from pmdarima import auto_arima\n\n# Automatically finds best (p, d, q)\nauto_model = auto_arima(train, seasonal=True, m=12,\n                        suppress_warnings=True, stepwise=True)\nprint(f\"Best model: ARIMA{auto_model.order}\")\nprint(f\"Seasonal: {auto_model.seasonal_order}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Correct: split by time\ntrain = ts[:'2022-12-31']\ntest = ts['2023-01-01':]\n\n# For cross-validation: use expanding or sliding window\nfrom sklearn.model_selection import TimeSeriesSplit\n\ntscv = TimeSeriesSplit(n_splits=5)\nfor train_idx, test_idx in tscv.split(ts):\n    print(f\"Train: {ts.index[train_idx[0]]} to {ts.index[train_idx[-1]]}\")\n    print(f\"Test:  {ts.index[test_idx[0]]} to {ts.index[test_idx[-1]]}\")\n    print()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.metrics import mean_absolute_error, mean_squared_error\n\ny_true = test.values\ny_pred = forecast.values\n\nmae = mean_absolute_error(y_true, y_pred)\nrmse = np.sqrt(mean_squared_error(y_true, y_pred))\nmape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100\n\nprint(f\"MAE: {mae:.2f}\")\nprint(f\"RMSE: {rmse:.2f}\")\nprint(f\"MAPE: {mape:.1f}%\")  # Percentage error \u2014 intuitive for business"
        ]
      ]
    }
