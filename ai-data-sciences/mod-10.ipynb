      "source": [
        [
          "python",
          "# Lasso: good when you suspect many features are irrelevant\nlasso = Lasso(alpha=100.0)\nlasso.fit(X_train, y_train)\nprint(f\"Lasso R\u00b2: {lasso.score(X_test, y_test):.4f}\")\n\n# Which features did Lasso keep?\nselected = pd.DataFrame({\n    'Feature': X.columns,\n    'Coefficient': lasso.coef_\n})\nprint(selected[selected['Coefficient'] != 0])"
        ]
      ]
