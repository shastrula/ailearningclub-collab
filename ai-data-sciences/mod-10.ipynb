        [
          "python",
          "from sklearn.linear_model import Ridge, Lasso, ElasticNet\n\n# Ridge: good when all features are somewhat useful\nridge = Ridge(alpha=1.0)\nridge.fit(X_train, y_train)\nprint(f\"Ridge R\u00b2: {ridge.score(X_test, y_test):.4f}\")"
        ]
      ]
