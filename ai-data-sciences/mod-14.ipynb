      "source": [
        [
          "python",
          "import pandas as pd\nimport numpy as np\n\n# Translate model output to business impact\npredictions = pd.DataFrame({\n    'customer_id': range(1000),\n    'churn_probability': np.random.uniform(0, 1, 1000),\n    'monthly_revenue': np.random.uniform(50, 500, 1000)\n})\n\n# High-risk customers\nhigh_risk = predictions[predictions['churn_probability'] > 0.7]\nrevenue_at_risk = high_risk['monthly_revenue'].sum()\n\nprint(f\"High-risk customers: {len(high_risk)}\")\nprint(f\"Monthly revenue at risk: ${revenue_at_risk:,.0f}\")\nprint(f\"Annual revenue at risk: ${revenue_at_risk * 12:,.0f}\")\nprint(f\"If retention program saves 30%: ${revenue_at_risk * 12 * 0.3:,.0f} saved\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from scipy import stats\n\n# A/B test results\ncontrol_conversion = 0.05    # 5% conversion without model\ntreatment_conversion = 0.07  # 7% conversion with model targeting\n\nn_control = 5000\nn_treatment = 5000\n\n# Statistical significance test\ncontrol_successes = int(control_conversion * n_control)\ntreatment_successes = int(treatment_conversion * n_treatment)\n\n# Two-proportion z-test\ncount = np.array([treatment_successes, control_successes])\nnobs = np.array([n_treatment, n_control])\n\nfrom statsmodels.stats.proportion import proportions_ztest\nz_stat, p_value = proportions_ztest(count, nobs, alternative='larger')\n\nprint(f\"Control conversion: {control_conversion:.1%}\")\nprint(f\"Treatment conversion: {treatment_conversion:.1%}\")\nprint(f\"Lift: {(treatment_conversion - control_conversion) / control_conversion:.1%}\")\nprint(f\"p-value: {p_value:.4f}\")\nprint(f\"Statistically significant: {'Yes' if p_value < 0.05 else 'No'}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import matplotlib.pyplot as plt\nimport matplotlib.patches as mpatches\n\n# Executive dashboard mockup\nfig, axes = plt.subplots(2, 2, figsize=(14, 10))\n\n# 1. Model performance over time\nmonths = pd.date_range('2024-01', periods=12, freq='M')\naccuracy = [0.82, 0.84, 0.83, 0.85, 0.86, 0.85, 0.87, 0.86, 0.88, 0.87, 0.89, 0.88]\naxes[0, 0].plot(months, accuracy, 'b-o')\naxes[0, 0].set_title('Model Accuracy Over Time')\naxes[0, 0].set_ylim(0.7, 1.0)\naxes[0, 0].axhline(0.85, color='green', linestyle='--', alpha=0.5, label='Target')\naxes[0, 0].legend()\n\n# 2. Revenue impact\nsaved = [12, 15, 14, 18, 22, 20, 25, 23, 28, 26, 30, 32]\naxes[0, 1].bar(range(12), saved, color='green', alpha=0.7)\naxes[0, 1].set_title('Monthly Revenue Saved ($K)')\naxes[0, 1].set_xlabel('Month')\n\n# 3. Prediction distribution\npredictions_sample = np.random.beta(2, 5, 1000)\naxes[1, 0].hist(predictions_sample, bins=30, edgecolor='black', alpha=0.7)\naxes[1, 0].axvline(0.7, color='red', linestyle='--', label='Action Threshold')\naxes[1, 0].set_title('Churn Probability Distribution')\naxes[1, 0].legend()\n\n# 4. Key metrics\naxes[1, 1].axis('off')\nmetrics_text = \"\"\"\nKEY METRICS (This Month)\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\nCustomers Flagged:    247\nActions Taken:        189\nRetained:             142 (75%)\nRevenue Saved:        $32K\nModel Accuracy:       88%\n\"\"\"\naxes[1, 1].text(0.1, 0.5, metrics_text, fontfamily='monospace', fontsize=12, va='center')\n\nplt.suptitle('Customer Retention - Monthly Report', fontsize=14, fontweight='bold')\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Different thresholds = different business trade-offs\ncosts = {\n    'cost_of_intervention': 50,       # Cost to send retention offer\n    'revenue_per_customer': 200,      # Monthly revenue from retained customer\n    'months_if_retained': 12          # How long they stay if saved\n}\n\n# Expected value calculation\nfor threshold in [0.3, 0.5, 0.7, 0.9]:\n    flagged = predictions[predictions['churn_probability'] > threshold]\n    n_flagged = len(flagged)\n    \n    # Assume 60% of flagged would actually churn, 40% of those are saved by intervention\n    true_churners = int(n_flagged * 0.6)\n    saved_customers = int(true_churners * 0.4)\n    \n    total_cost = n_flagged * costs['cost_of_intervention']\n    total_revenue_saved = saved_customers * costs['revenue_per_customer'] * costs['months_if_retained']\n    net_value = total_revenue_saved - total_cost\n    \n    print(f\"Threshold {threshold}: Flag {n_flagged}, Save {saved_customers}, \"\n          f\"Cost ${total_cost:,}, Revenue saved ${total_revenue_saved:,}, \"\n          f\"Net ${net_value:,}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Monitor prediction distribution weekly\ndef check_model_drift(current_predictions, baseline_predictions, threshold=0.05):\n    \"\"\"Detect if model behavior has changed significantly.\"\"\"\n    from scipy.stats import ks_2samp\n    \n    stat, p_value = ks_2samp(current_predictions, baseline_predictions)\n    \n    if p_value < threshold:\n        print(f\"\u26a0\ufe0f DRIFT DETECTED: Distribution shift (p={p_value:.4f})\")\n        print(\"Action: Retrain model with recent data\")\n    else:\n        print(f\"\u2713 No drift detected (p={p_value:.4f})\")\n    \n    return p_value < threshold\n\n# Simulate\nbaseline = np.random.beta(2, 5, 1000)\ncurrent = np.random.beta(2.5, 4, 1000)  # Slight shift\ncheck_model_drift(current, baseline)"
        ]
      ]
    },
