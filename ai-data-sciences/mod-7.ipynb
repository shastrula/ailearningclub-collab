      "source": [
        [
          "python",
          "# For nominal categories (no order)\ncolors = pd.DataFrame({'color': ['red', 'blue', 'green', 'red', 'blue']})\nencoded = pd.get_dummies(colors, prefix='color', drop_first=True)\nprint(encoded)\n#    color_blue  color_green  color_red -> dropped 'red' as reference"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.preprocessing import LabelEncoder\n\n# For ordinal categories (has order)\neducation = ['high_school', 'bachelors', 'masters', 'phd']\nle = LabelEncoder()\nle.fit(education)\nprint(le.transform(['bachelors', 'phd', 'high_school']))\n# [0, 2, 1] \u2014 careful: implies 'phd' > 'masters', which may be wrong for some models"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Mean target value per category (use with care \u2014 can leak information)\ndf['city_avg_income'] = df.groupby('city')['income'].transform('mean')"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "df = pd.DataFrame({\n    'purchase_date': pd.date_range('2024-01-01', periods=100, freq='D'),\n    'amount': np.random.uniform(10, 200, 100)\n})\n\n# Extract temporal features\ndf['day_of_week'] = df['purchase_date'].dt.dayofweek     # 0=Monday\ndf['month'] = df['purchase_date'].dt.month\ndf['is_weekend'] = df['day_of_week'].isin([5, 6]).astype(int)\ndf['quarter'] = df['purchase_date'].dt.quarter\ndf['day_of_year'] = df['purchase_date'].dt.dayofyear\n\n# Cyclical encoding (so Dec and Jan are close, not far apart)\ndf['month_sin'] = np.sin(2 * np.pi * df['month'] / 12)\ndf['month_cos'] = np.cos(2 * np.pi * df['month'] / 12)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Basic text features\ndf = pd.DataFrame({'review': [\n    'Great product, very happy!',\n    'Terrible quality. Broken on arrival.',\n    'OK for the price. Nothing special.'\n]})\n\ndf['word_count'] = df['review'].str.split().str.len()\ndf['char_count'] = df['review'].str.len()\ndf['has_exclamation'] = df['review'].str.contains('!').astype(int)\ndf['avg_word_length'] = df['review'].apply(lambda x: np.mean([len(w) for w in x.split()]))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Feature interactions\ndf['price_per_sqft'] = df['price'] / df['sqft']\ndf['bmi'] = df['weight'] / (df['height'] / 100) ** 2\ndf['income_to_debt'] = df['income'] / (df['debt'] + 1)  # +1 to avoid division by zero"
        ]
      ]
