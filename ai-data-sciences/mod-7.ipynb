      "source": [
        [
          "python",
          "import pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import StandardScaler, MinMaxScaler\n\ndf = pd.DataFrame({\n    'age': [25, 35, 45, 55, 65],\n    'income': [30000, 55000, 72000, 90000, 120000],\n    'purchases': [3, 12, 8, 25, 15]\n})\n\n# StandardScaler: mean=0, std=1 (good for algorithms assuming normal distribution)\nscaler = StandardScaler()\ndf_scaled = pd.DataFrame(scaler.fit_transform(df), columns=df.columns)\nprint(df_scaled)\n\n# MinMaxScaler: range [0, 1] (good for neural networks)\nminmax = MinMaxScaler()\ndf_minmax = pd.DataFrame(minmax.fit_transform(df), columns=df.columns)\nprint(df_minmax)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Income is often right-skewed\ndf['log_income'] = np.log1p(df['income'])  # log1p handles zeros safely\nprint(df[['income', 'log_income']])"
        ]
      ]
    },
    {
      "cell_type": "code",
