          "python",
          "# Scikit-learn built-in datasets\nfrom sklearn import datasets\n\niris = datasets.load_iris()          # Classification\nboston = datasets.load_diabetes()     # Regression\ndigits = datasets.load_digits()      # Image classification\n\n# Popular data sources:\n# - Kaggle.com (competitions + datasets)\n# - UCI ML Repository\n# - data.gov (US government data)\n# - Google Dataset Search"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Numbers\nx = 42         # int\ny = 3.14       # float\nz = 1 + 2j     # complex\n\n# Text\ns = \"hello\"    # str\n\n# Boolean\nb = True       # bool\n\n# Collections\nlst = [1, 2, 3]            # list (mutable, ordered)\ntup = (1, 2, 3)            # tuple (immutable, ordered)\nst = {1, 2, 3}             # set (mutable, unordered, unique)\ndct = {\"a\": 1, \"b\": 2}    # dict (mutable, key-value)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# List comprehension\nsquares = [x**2 for x in range(10)]\n\n# Dict comprehension\nword_lengths = {w: len(w) for w in [\"hi\", \"hello\", \"hey\"]}\n\n# Ternary\nresult = \"even\" if x % 2 == 0 else \"odd\"\n\n# Enumerate\nfor i, item in enumerate([\"a\", \"b\", \"c\"]):\n    print(f\"{i}: {item}\")\n\n# Zip\nnames = [\"Alice\", \"Bob\"]\nscores = [85, 92]\nfor name, score in zip(names, scores):\n    print(f\"{name}: {score}\")\n\n# Unpacking\nfirst, *rest = [1, 2, 3, 4, 5]\n# first = 1, rest = [2, 3, 4, 5]"
        ]
      ]
    },
    {
