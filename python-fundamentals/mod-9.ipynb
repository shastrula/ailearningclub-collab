        [
          "python",
          "from pathlib import Path\n\n# Create path objects\ndata_dir = Path(\"data\")\nfile_path = data_dir / \"results\" / \"output.csv\"\n\n# Useful properties\nprint(file_path.name)      # \"output.csv\"\nprint(file_path.stem)      # \"output\"\nprint(file_path.suffix)    # \".csv\"\nprint(file_path.parent)    # \"data/results\"\n\n# Check existence\nif not data_dir.exists():\n    data_dir.mkdir(parents=True)  # create directories\n\n# List files in directory\nfor f in Path(\".\").glob(\"*.py\"):\n    print(f\"Python file: {f}\")\n\n# Read/write shorthand\nPath(\"hello.txt\").write_text(\"Hello!\")\ncontent = Path(\"hello.txt\").read_text()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from pathlib import Path\n\ndef safe_read(filepath):\n    \"\"\"Read a file with proper error handling.\"\"\"\n    path = Path(filepath)\n    \n    if not path.exists():\n        print(f\"Error: {filepath} not found\")\n        return None\n    \n    try:\n        return path.read_text(encoding=\"utf-8\")\n    except PermissionError:\n        print(f\"Error: No permission to read {filepath}\")\n        return None\n    except UnicodeDecodeError:\n        print(f\"Error: {filepath} is not a text file\")\n        return None\n\ncontent = safe_read(\"config.json\")\nif content:\n    print(f\"Read {len(content)} characters\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from collections import Counter\nfrom datetime import datetime\n\n# Sample log data\nlog_entries = \"\"\"\n2025-01-15 10:23:01 INFO User login: alice\n2025-01-15 10:24:15 ERROR Database timeout\n2025-01-15 10:25:30 INFO File uploaded\n2025-01-15 10:26:45 WARNING Disk 80% full\n2025-01-15 10:28:00 ERROR Connection refused\n2025-01-15 10:30:12 INFO User login: bob\n\"\"\".strip()\n\n# Write sample log\nwith open(\"app.log\", \"w\") as f:\n    f.write(log_entries)\n\n# Analyze\ndef analyze_log(filepath):\n    levels = Counter()\n    errors = []\n    \n    with open(filepath, \"r\") as f:\n        for line in f:\n            parts = line.strip().split(\" \", 3)\n            if len(parts) >= 4:\n                date, time, level, message = parts\n                levels[level] += 1\n                if level == \"ERROR\":\n                    errors.append(message)\n    \n    print(\"Log Summary:\")\n    for level, count in levels.most_common():\n        print(f\"  {level}: {count}\")\n    \n    if errors:\n        print(f\"\\nErrors ({len(errors)}):\")\n        for err in errors:\n            print(f\"  \u26a0 {err}\")\n\nanalyze_log(\"app.log\")\n# Log Summary:\n#   INFO: 3\n#   ERROR: 2\n#   WARNING: 1\n# Errors (2):\n#   \u26a0 Database timeout\n#   \u26a0 Connection refused"
        ]
      ]
    }
