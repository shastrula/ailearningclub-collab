      "source": [
        [
          "python",
          "# Writing to a file\nwith open(\"output.txt\", \"w\") as f:\n    f.write(\"Hello, World!\\n\")\n    f.write(\"Second line\\n\")\n\n# Reading entire file\nwith open(\"output.txt\", \"r\") as f:\n    content = f.read()\n    print(content)\n\n# Reading line by line (memory efficient for large files)\nwith open(\"output.txt\", \"r\") as f:\n    for line in f:\n        print(line.strip())  # strip() removes the newline"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Good: automatic cleanup\nwith open(\"data.txt\", \"r\") as f:\n    data = f.read()\n# File is automatically closed here\n\n# Bad: manual management (error-prone)\nf = open(\"data.txt\", \"r\")\ndata = f.read()\nf.close()  # Easy to forget, especially if an error occurs above"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# \"r\"  - Read (default). Error if file doesn't exist.\n# \"w\"  - Write. Creates file or OVERWRITES existing.\n# \"a\"  - Append. Creates file or adds to end.\n# \"x\"  - Create. Error if file already exists.\n# \"rb\" - Read binary (images, PDFs, etc.)\n# \"wb\" - Write binary\n\n# Append to a log file\nwith open(\"app.log\", \"a\") as f:\n    f.write(\"2025-01-15: User logged in\\n\")\n    f.write(\"2025-01-15: File uploaded\\n\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import csv\n\n# Writing CSV\nstudents = [\n    [\"Name\", \"Age\", \"Grade\"],\n    [\"Alice\", 20, \"A\"],\n    [\"Bob\", 22, \"B\"],\n    [\"Charlie\", 21, \"A\"],\n]\n\nwith open(\"students.csv\", \"w\", newline=\"\") as f:\n    writer = csv.writer(f)\n    writer.writerows(students)\n\n# Reading CSV\nwith open(\"students.csv\", \"r\") as f:\n    reader = csv.reader(f)\n    header = next(reader)  # skip header\n    for row in reader:\n        name, age, grade = row\n        print(f\"{name} (age {age}): Grade {grade}\")\n\n# CSV with dictionaries (most convenient)\nwith open(\"students.csv\", \"r\") as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        print(f\"{row['Name']}: {row['Grade']}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import json\n\n# Python dict \u2192 JSON file\nconfig = {\n    \"model\": \"gpt-4\",\n    \"temperature\": 0.7,\n    \"max_tokens\": 1000,\n    \"tags\": [\"ai\", \"ml\", \"nlp\"]\n}\n\n# Save to file\nwith open(\"config.json\", \"w\") as f:\n    json.dump(config, f, indent=2)\n\n# Load from file\nwith open(\"config.json\", \"r\") as f:\n    loaded = json.load(f)\n    print(loaded[\"model\"])  # \"gpt-4\"\n\n# String conversion\njson_string = json.dumps(config, indent=2)\nparsed = json.loads(json_string)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
