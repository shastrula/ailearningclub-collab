      "source": [
        [
          "python",
          "# Without functions: repetitive\nprint(\"=\" * 40)\nprint(\"Report for Alice\")\nprint(\"=\" * 40)\n# ... 50 lines later ...\nprint(\"=\" * 40)\nprint(\"Report for Bob\")\nprint(\"=\" * 40)\n\n# With functions: clean\ndef print_header(name):\n    print(\"=\" * 40)\n    print(f\"Report for {name}\")\n    print(\"=\" * 40)\n\nprint_header(\"Alice\")\nprint_header(\"Bob\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Basic function\ndef greet(name):\n    \"\"\"Greet a person by name.\"\"\"  # docstring (documentation)\n    return f\"Hello, {name}!\"\n\nresult = greet(\"Alice\")\nprint(result)  # \"Hello, Alice!\"\n\n# Function with no return (returns None implicitly)\ndef say_hello():\n    print(\"Hello!\")\n\n# Multiple parameters\ndef add(a, b):\n    return a + b\n\nprint(add(3, 5))  # 8"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Default parameters\ndef power(base, exponent=2):\n    return base ** exponent\n\nprint(power(3))      # 9  (exponent defaults to 2)\nprint(power(3, 3))   # 27\n\n# Keyword arguments (order doesn't matter)\ndef create_user(name, age, role=\"student\"):\n    return {\"name\": name, \"age\": age, \"role\": role}\n\nuser = create_user(age=25, name=\"Alice\", role=\"admin\")\n\n# *args - variable number of positional arguments\ndef average(*numbers):\n    return sum(numbers) / len(numbers)\n\nprint(average(1, 2, 3, 4, 5))  # 3.0\n\n# **kwargs - variable number of keyword arguments\ndef build_profile(**kwargs):\n    return kwargs\n\nprofile = build_profile(name=\"Alice\", age=25, city=\"NYC\")\nprint(profile)  # {'name': 'Alice', 'age': 25, 'city': 'NYC'}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Return multiple values (as tuple)\ndef analyze(numbers):\n    return min(numbers), max(numbers), sum(numbers) / len(numbers)\n\nlo, hi, avg = analyze([4, 8, 2, 9, 1])\nprint(f\"Min: {lo}, Max: {hi}, Avg: {avg:.1f}\")\n\n# Early return (guard clauses)\ndef divide(a, b):\n    if b == 0:\n        return None  # early exit\n    return a / b\n\nresult = divide(10, 0)\nif result is None:\n    print(\"Cannot divide by zero\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Variables inside functions are LOCAL\nx = 10  # global\n\ndef modify():\n    x = 20  # this is a NEW local variable\n    print(f\"Inside: {x}\")  # 20\n\nmodify()\nprint(f\"Outside: {x}\")    # 10 (unchanged!)\n\n# To modify global (avoid this when possible)\ncounter = 0\ndef increment():\n    global counter\n    counter += 1\n\nincrement()\nprint(counter)  # 1"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Lambda: one-line throwaway functions\nsquare = lambda x: x ** 2\nprint(square(5))  # 25\n\n# Most useful with sorted(), map(), filter()\nstudents = [(\"Alice\", 85), (\"Bob\", 92), (\"Charlie\", 78)]\n\n# Sort by grade (second element)\nby_grade = sorted(students, key=lambda s: s[1], reverse=True)\nprint(by_grade)  # [('Bob', 92), ('Alice', 85), ('Charlie', 78)]\n\n# Filter: keep scores above 80\nhigh_scores = list(filter(lambda s: s[1] > 80, students))\nprint(high_scores)  # [('Alice', 85), ('Bob', 92)]\n\n# Map: extract just names\nnames = list(map(lambda s: s[0], students))\nprint(names)  # ['Alice', 'Bob', 'Charlie']"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Functions that take or return functions\ndef apply_twice(func, value):\n    return func(func(value))\n\ndef add_three(x):\n    return x + 3\n\nprint(apply_twice(add_three, 10))  # 16 (10\u219213\u219216)\n\n# Function factory\ndef multiplier(factor):\n    def multiply(x):\n        return x * factor\n    return multiply\n\ndouble = multiplier(2)\ntriple = multiplier(3)\nprint(double(5))  # 10\nprint(triple(5))  # 15"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# A decorator wraps a function with extra behavior\nimport time\n\ndef timer(func):\n    def wrapper(*args, **kwargs):\n        start = time.time()\n        result = func(*args, **kwargs)\n        elapsed = time.time() - start\n        print(f\"{func.__name__} took {elapsed:.4f}s\")\n        return result\n    return wrapper\n\n@timer\ndef slow_function():\n    time.sleep(1)\n    return \"done\"\n\nslow_function()  # prints: slow_function took 1.0012s"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def load_data():\n    \"\"\"Simulate loading raw data.\"\"\"\n    return [\"  Alice, 25 \", \"Bob, 30\", \" Charlie, 35  \", \"\", \"Dave, 28\"]\n\ndef clean(records):\n    \"\"\"Remove empty records and strip whitespace.\"\"\"\n    return [r.strip() for r in records if r.strip()]\n\ndef parse(records):\n    \"\"\"Convert strings to structured data.\"\"\"\n    result = []\n    for record in records:\n        name, age = record.split(\",\")\n        result.append({\"name\": name.strip(), \"age\": int(age.strip())})\n    return result\n\ndef filter_by_age(records, min_age):\n    \"\"\"Keep only records above min_age.\"\"\"\n    return [r for r in records if r[\"age\"] >= min_age]\n\n# Pipeline: load \u2192 clean \u2192 parse \u2192 filter\nraw = load_data()\ncleaned = clean(raw)\nparsed = parse(cleaned)\nadults = filter_by_age(parsed, 30)\n\nfor person in adults:\n    print(f\"{person['name']}: {person['age']}\")\n# Bob: 30\n# Charlie: 35"
        ]
      ]
    },
