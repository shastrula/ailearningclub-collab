        [
          "python",
          "class SimpleClassifier:\n    \"\"\"A basic interface similar to scikit-learn models.\"\"\"\n    \n    def __init__(self, threshold=0.5):\n        self.threshold = threshold\n        self.is_trained = False\n        self.weights = None\n    \n    def fit(self, X, y):\n        \"\"\"Train the model (simplified).\"\"\"\n        # Just compute mean of positive class features\n        positive = [X[i] for i in range(len(y)) if y[i] == 1]\n        self.weights = sum(positive) / len(positive)\n        self.is_trained = True\n        print(f\"Model trained on {len(X)} samples\")\n        return self\n    \n    def predict(self, X):\n        \"\"\"Make predictions.\"\"\"\n        if not self.is_trained:\n            raise RuntimeError(\"Model not trained! Call .fit() first.\")\n        return [1 if x > self.threshold else 0 for x in X]\n    \n    def __repr__(self):\n        status = \"trained\" if self.is_trained else \"untrained\"\n        return f\"SimpleClassifier(threshold={self.threshold}, {status})\"\n\n# Usage (mimics sklearn pattern)\nmodel = SimpleClassifier(threshold=5)\nX_train = [2, 4, 6, 8, 10]\ny_train = [0, 0, 1, 1, 1]\n\nmodel.fit(X_train, y_train)\npredictions = model.predict([3, 5, 7])\nprint(predictions)  # [0, 0, 1]\nprint(model)        # SimpleClassifier(threshold=5, trained)"
        ]
      ]
