        [
          "python",
          "class Student:\n    # Class variable (shared by all instances)\n    school = \"AI Learning Club\"\n    \n    def __init__(self, name, grade):\n        # Instance variables (unique to each object)\n        self.name = name\n        self.grade = grade\n        self.courses = []\n    \n    def enroll(self, course):\n        self.courses.append(course)\n        print(f\"{self.name} enrolled in {course}\")\n    \n    def get_info(self):\n        return f\"{self.name} (Grade: {self.grade}) at {self.school}\"\n\n# Create objects (instances)\nalice = Student(\"Alice\", \"A\")\nbob = Student(\"Bob\", \"B\")\n\nalice.enroll(\"Python Fundamentals\")\nalice.enroll(\"Machine Learning\")\nprint(alice.get_info())   # \"Alice (Grade: A) at AI Learning Club\"\nprint(alice.courses)      # ['Python Fundamentals', 'Machine Learning']"
        ]
      ]
    },
    {
