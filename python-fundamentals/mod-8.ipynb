          "python",
          "class Password:\n    def __init__(self, password):\n        self._password = password  # convention: \"private\" (single underscore)\n        self.__secret = \"hidden\"   # name-mangled (double underscore)\n    \n    def check(self, attempt):\n        return attempt == self._password\n    \n    def change(self, old, new):\n        if self.check(old):\n            self._password = new\n            return True\n        return False\n\np = Password(\"abc123\")\nprint(p.check(\"abc123\"))     # True\nprint(p.check(\"wrong\"))      # False\n# print(p.__secret)          # AttributeError!\n# print(p._password)         # Works but discouraged"
        ]
