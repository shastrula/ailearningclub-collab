          "python",
          "# Output with f-strings (formatted strings)\nname = \"Alice\"\nage = 25\nprint(f\"{name} is {age} years old\")\n\n# Getting user input\nuser_name = input(\"What's your name? \")\nprint(f\"Nice to meet you, {user_name}!\")"
        ]
      ]
