          "# 1. Create variables for your name and age\nmy_name = \"Your Name\"\nmy_age = 20\n\n# 2. Print a formatted greeting\nprint(f\"Hi! I'm {my_name} and I'm {my_age} years old.\")\n\n# 3. Do some math\nbirth_year = 2025 - my_age\nprint(f\"I was born around {birth_year}\")\n\n# 4. Check types\nprint(type(my_name))  # <class 'str'>\nprint(type(my_age))   # <class 'int'>"
