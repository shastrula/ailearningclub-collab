          "python",
          "\"\"\"weather.py - A simple command-line weather tool.\"\"\"\nimport sys\nimport json\nfrom datetime import datetime\n\ndef get_greeting():\n    hour = datetime.now().hour\n    if hour < 12:\n        return \"Good morning\"\n    elif hour < 17:\n        return \"Good afternoon\"\n    return \"Good evening\"\n\ndef format_report(city, temp, condition):\n    return f\"\"\"\n{get_greeting()}! Weather for {city}:\n  \ud83c\udf21\ufe0f  Temperature: {temp}\u00b0C\n  \u2601\ufe0f  Condition: {condition}\n  \ud83d\udcc5  {datetime.now().strftime('%B %d, %Y')}\n\"\"\"\n\nif __name__ == \"__main__\":\n    # Simulated data (real app would call an API)\n    cities = {\n        \"nyc\": (\"New York\", 22, \"Partly Cloudy\"),\n        \"london\": (\"London\", 15, \"Rainy\"),\n        \"tokyo\": (\"Tokyo\", 28, \"Sunny\"),\n    }\n    \n    city_key = sys.argv[1] if len(sys.argv) > 1 else \"nyc\"\n    \n    if city_key in cities:\n        name, temp, condition = cities[city_key]\n        print(format_report(name, temp, condition))\n    else:\n        print(f\"Unknown city: {city_key}\")\n        print(f\"Available: {', '.join(cities.keys())}\")"
