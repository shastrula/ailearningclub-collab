          "python",
          "# Import the whole module\nimport math\nprint(math.sqrt(16))    # 4.0\nprint(math.pi)          # 3.141592653589793\n\n# Import specific items\nfrom math import sqrt, pi\nprint(sqrt(16))         # 4.0 (no prefix needed)\nprint(pi)               # 3.141592653589793\n\n# Import with alias\nimport numpy as np      # convention for numpy\nimport pandas as pd     # convention for pandas\n\n# Import everything (avoid this - pollutes namespace)\nfrom math import *      # now everything is available directly"
        ]
      ]
    },
