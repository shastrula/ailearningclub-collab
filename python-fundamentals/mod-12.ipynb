          "python",
          "import numpy as np\nimport pandas as pd\n\n# Create sample dataset\nnp.random.seed(42)\nn_students = 50\n\ndf = pd.DataFrame({\n    \"student_id\": range(1, n_students + 1),\n    \"hours_studied\": np.random.uniform(1, 10, n_students).round(1),\n    \"exam_score\": np.random.normal(75, 15, n_students).round(1),\n    \"attendance\": np.random.uniform(60, 100, n_students).round(0),\n})\n\n# Clip scores to valid range\ndf[\"exam_score\"] = df[\"exam_score\"].clip(0, 100)\n\n# Analysis\nprint(\"Dataset Overview:\")\nprint(f\"  Students: {len(df)}\")\nprint(f\"  Average score: {df['exam_score'].mean():.1f}\")\nprint(f\"  Score range: {df['exam_score'].min():.0f} - {df['exam_score'].max():.0f}\")\n\n# Correlation between study hours and score\ncorrelation = df[\"hours_studied\"].corr(df[\"exam_score\"])\nprint(f\"\\n  Study hours \u2194 Score correlation: {correlation:.3f}\")\n\n# Create grade categories\ndf[\"grade\"] = pd.cut(df[\"exam_score\"], \n                     bins=[0, 60, 70, 80, 90, 100],\n                     labels=[\"F\", \"D\", \"C\", \"B\", \"A\"])\n\nprint(f\"\\nGrade Distribution:\")\nprint(df[\"grade\"].value_counts().sort_index())\n\n# Top 5 students\nprint(f\"\\nTop 5 Students:\")\ntop5 = df.nlargest(5, \"exam_score\")[[\"student_id\", \"hours_studied\", \"exam_score\"]]\nprint(top5.to_string(index=False))"
