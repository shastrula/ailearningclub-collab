    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Creating variables - no declaration needed\nmessage = \"Hello World\"    # str\ncount = 42                 # int\ntemperature = 98.6         # float\nis_active = True           # bool\n\n# Variables can be reassigned to different types\nx = 10        # x is an integer\nx = \"ten\"     # now x is a string (Python allows this)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Integers - whole numbers, unlimited size\npopulation = 8_000_000_000   # underscores for readability\nnegative = -42\nbig = 10 ** 100              # Python handles huge numbers!\n\n# Floats - decimal numbers\npi = 3.14159\nscientific = 2.5e6           # 2,500,000.0\ntiny = 1.23e-4               # 0.000123\n\n# Type conversion\nint_val = int(3.7)           # 3 (truncates, doesn't round)\nfloat_val = float(42)        # 42.0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Three ways to create strings\nsingle = 'Hello'\ndouble = \"World\"\nmulti = \"\"\"This string\nspans multiple\nlines\"\"\"\n\n# String indexing (0-based)\nword = \"Python\"\nprint(word[0])    # 'P'  (first character)\nprint(word[-1])   # 'n'  (last character)\nprint(word[0:3])  # 'Pyt' (slice: start to end-1)\n\n# Useful string methods\ntext = \"  Hello, World!  \"\nprint(text.strip())        # \"Hello, World!\" (remove whitespace)\nprint(text.lower())        # \"  hello, world!  \"\nprint(text.upper())        # \"  HELLO, WORLD!  \"\nprint(text.replace(\"World\", \"Python\"))  # \"  Hello, Python!  \"\nprint(\"Hello\" in text)     # True (membership test)\n\n# String formatting (f-strings - use these!)\nname = \"Alice\"\nscore = 95.5\nprint(f\"{name} scored {score:.1f}%\")  # \"Alice scored 95.5%\"\nprint(f\"{'centered':^20}\")            # \"      centered      \""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Boolean values\nis_valid = True\nhas_error = False\n\n# Comparison operators return booleans\nprint(5 > 3)       # True\nprint(5 == 3)      # False\nprint(5 != 3)      # True\nprint(5 >= 5)      # True\n\n# Truthy and Falsy values\n# Falsy: 0, 0.0, \"\", [], {}, None, False\n# Truthy: everything else\nprint(bool(0))       # False\nprint(bool(42))      # True\nprint(bool(\"\"))      # False\nprint(bool(\"hi\"))    # True"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# None represents \"nothing\" or \"not set\"\nresult = None\nprint(result)         # None\nprint(type(result))   # <class 'NoneType'>\n\n# Common use: optional function return\ndef find_user(name):\n    if name == \"Alice\":\n        return {\"name\": \"Alice\", \"age\": 25}\n    return None  # user not found"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Check types\nx = 42\nprint(type(x))            # <class 'int'>\nprint(isinstance(x, int)) # True\n\n# Type conversion (casting)\nnum_str = \"123\"\nnum_int = int(num_str)     # 123\nnum_float = float(num_str) # 123.0\nback_to_str = str(num_int) # \"123\"\n\n# Common gotcha\nuser_input = input(\"Enter a number: \")  # Always returns a string!\nnumber = int(user_input)                 # Must convert explicitly"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Assign multiple variables at once\nx, y, z = 1, 2, 3\nprint(x, y, z)  # 1 2 3\n\n# Swap variables (no temp needed!)\na, b = 10, 20\na, b = b, a\nprint(a, b)  # 20 10\n\n# Same value to multiple variables\nr = g = b = 0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Good variable names (snake_case)\nuser_name = \"Alice\"\nmax_retries = 3\nis_authenticated = True\n\n# Constants (ALL_CAPS by convention)\nMAX_CONNECTIONS = 100\nAPI_BASE_URL = \"https://api.example.com\"\n\n# Bad names (avoid these)\n# x = \"Alice\"          # too short, unclear\n# userName = \"Alice\"   # camelCase (not Pythonic)\n# 2nd_place = \"Bob\"   # can't start with number (SyntaxError)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
