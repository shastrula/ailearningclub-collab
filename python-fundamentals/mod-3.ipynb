      "outputs": [],
      "source": [
        [
          "python",
          "x = 10\n\n# All comparison operators\nprint(x == 10)   # True  (equal to)\nprint(x != 5)    # True  (not equal to)\nprint(x > 5)     # True  (greater than)\nprint(x < 20)    # True  (less than)\nprint(x >= 10)   # True  (greater than or equal)\nprint(x <= 10)   # True  (less than or equal)\n\n# Chained comparisons (Python special!)\nscore = 75\nprint(60 <= score <= 100)  # True (between 60 and 100)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "age = 25\nhas_license = True\nis_insured = False\n\n# and - both must be True\ncan_drive = age >= 16 and has_license\nprint(can_drive)  # True\n\n# or - at least one must be True\ncan_rent = age >= 25 or has_license\nprint(can_rent)   # True\n\n# not - flips True/False\nprint(not is_insured)  # True\n\n# Combining operators\ncan_rent_car = age >= 21 and has_license and is_insured\nprint(can_rent_car)  # False (not insured)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "user_input = input(\"Enter your age: \")\n\nif not user_input.isdigit():\n    print(\"Error: Please enter a number\")\nelif int(user_input) < 0:\n    print(\"Error: Age can't be negative\")\nelif int(user_input) > 150:\n    print(\"Error: That seems too high\")\nelse:\n    age = int(user_input)\n    print(f\"Your age is {age}\")"
        ]
      ]
    },
