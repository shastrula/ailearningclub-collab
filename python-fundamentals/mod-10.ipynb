      "source": [
        [
          "python",
          "# Without error handling: crash!\n# number = int(input(\"Enter a number: \"))  # User types \"abc\" \u2192 CRASH\n\n# With error handling: graceful\ntry:\n    number = int(input(\"Enter a number: \"))\n    print(f\"You entered: {number}\")\nexcept ValueError:\n    print(\"That's not a valid number!\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def divide(a, b):\n    try:\n        result = a / b\n    except ZeroDivisionError:\n        print(\"Cannot divide by zero!\")\n        return None\n    except TypeError:\n        print(\"Both arguments must be numbers!\")\n        return None\n    else:\n        # Runs only if NO exception occurred\n        print(f\"{a} / {b} = {result}\")\n        return result\n    finally:\n        # ALWAYS runs, even if there's an exception\n        print(\"Division operation complete.\")\n\ndivide(10, 2)   # 10 / 2 = 5.0 \u2192 Division operation complete.\ndivide(10, 0)   # Cannot divide by zero! \u2192 Division operation complete.\ndivide(10, \"x\") # Both arguments must be numbers! \u2192 Division operation complete."
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# ValueError - wrong value type\nint(\"abc\")          # ValueError: invalid literal for int()\n\n# TypeError - wrong operation for type\n\"hello\" + 5         # TypeError: can only concatenate str to str\n\n# KeyError - missing dictionary key\nd = {\"a\": 1}\nd[\"b\"]              # KeyError: 'b'\n\n# IndexError - list index out of range\nlst = [1, 2, 3]\nlst[10]             # IndexError: list index out of range\n\n# FileNotFoundError\nopen(\"nonexistent.txt\")  # FileNotFoundError\n\n# AttributeError - object has no such attribute\n\"hello\".nonexistent()    # AttributeError\n\n# ImportError\nimport nonexistent_module  # ModuleNotFoundError"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def safe_divide(a, b):\n    try:\n        return a / b\n    except (ZeroDivisionError, TypeError) as e:\n        print(f\"Error: {e}\")\n        return None\n\n# Catch different exceptions differently\ndef process_data(data):\n    try:\n        value = int(data[\"amount\"])\n        result = 100 / value\n        return result\n    except KeyError:\n        print(\"Missing 'amount' field\")\n    except ValueError:\n        print(\"'amount' is not a number\")\n    except ZeroDivisionError:\n        print(\"'amount' cannot be zero\")\n    return None"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def set_age(age):\n    \"\"\"Set age with validation.\"\"\"\n    if not isinstance(age, int):\n        raise TypeError(\"Age must be an integer\")\n    if age < 0:\n        raise ValueError(\"Age cannot be negative\")\n    if age > 150:\n        raise ValueError(\"Age seems unrealistic\")\n    return age\n\n# Usage\ntry:\n    set_age(-5)\nexcept ValueError as e:\n    print(f\"Invalid age: {e}\")  # \"Invalid age: Age cannot be negative\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Define your own exception types\nclass InsufficientFundsError(Exception):\n    def __init__(self, balance, amount):\n        self.balance = balance\n        self.amount = amount\n        super().__init__(\n            f\"Cannot withdraw ${amount}. Balance: ${balance}\"\n        )\n\nclass BankAccount:\n    def __init__(self, balance):\n        self.balance = balance\n    \n    def withdraw(self, amount):\n        if amount > self.balance:\n            raise InsufficientFundsError(self.balance, amount)\n        self.balance -= amount\n        return self.balance\n\n# Usage\naccount = BankAccount(100)\ntry:\n    account.withdraw(150)\nexcept InsufficientFundsError as e:\n    print(e)  # \"Cannot withdraw $150. Balance: $100\"\n    print(f\"Short by: ${e.amount - e.balance}\")  # \"Short by: $50\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# 1. Be specific - don't catch everything\n# Bad:\ntry:\n    result = do_something()\nexcept:  # catches ALL exceptions, even KeyboardInterrupt!\n    pass\n\n# Good:\ntry:\n    result = do_something()\nexcept ValueError as e:\n    print(f\"Bad value: {e}\")\n\n# 2. Use EAFP (Easier to Ask Forgiveness than Permission)\n# Pythonic way:\ntry:\n    value = my_dict[\"key\"]\nexcept KeyError:\n    value = \"default\"\n\n# Even better:\nvalue = my_dict.get(\"key\", \"default\")\n\n# 3. Don't silently swallow exceptions\n# Bad:\ntry:\n    important_operation()\nexcept Exception:\n    pass  # Error disappears silently!\n\n# Good:\nimport logging\ntry:\n    important_operation()\nexcept Exception as e:\n    logging.error(f\"Operation failed: {e}\")\n    raise  # re-raise after logging"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def parse_records(raw_data):\n    \"\"\"Parse a list of 'name,age,score' strings with error recovery.\"\"\"\n    results = []\n    errors = []\n    \n    for i, line in enumerate(raw_data, 1):\n        try:\n            parts = line.strip().split(\",\")\n            if len(parts) != 3:\n                raise ValueError(f\"Expected 3 fields, got {len(parts)}\")\n            \n            name = parts[0].strip()\n            age = int(parts[1].strip())\n            score = float(parts[2].strip())\n            \n            if age < 0 or age > 150:\n                raise ValueError(f\"Invalid age: {age}\")\n            if score < 0 or score > 100:\n                raise ValueError(f\"Invalid score: {score}\")\n            \n            results.append({\"name\": name, \"age\": age, \"score\": score})\n            \n        except (ValueError, IndexError) as e:\n            errors.append(f\"Line {i}: {e} \u2192 '{line.strip()}'\")\n    \n    return results, errors\n\n# Test with messy data\ndata = [\n    \"Alice, 25, 88.5\",\n    \"Bob, thirty, 92\",     # invalid age\n    \"Charlie, 21\",          # missing field\n    \"Dave, 28, 150\",        # invalid score\n    \"Eve, 30, 76.0\",\n]\n\nrecords, errors = parse_records(data)\n\nprint(f\"Parsed {len(records)} records successfully\")\nfor r in records:\n    print(f\"  {r['name']}: age {r['age']}, score {r['score']}\")\n\nprint(f\"\\n{len(errors)} errors:\")\nfor e in errors:\n    print(f\"  \u26a0 {e}\")"
        ]
      ]
    }
