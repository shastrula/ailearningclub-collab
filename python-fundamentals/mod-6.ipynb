          "python",
          "# Use LIST when: order matters, items may repeat\nshopping = [\"milk\", \"eggs\", \"bread\", \"milk\"]\n\n# Use TUPLE when: data shouldn't change\ncoordinates = (40.7128, -74.0060)  # NYC lat/long\n\n# Use DICT when: you need key\u2192value lookup\nconfig = {\"debug\": True, \"port\": 8080, \"host\": \"localhost\"}\n\n# Use SET when: you need unique items or set operations\nskills = {\"python\", \"sql\", \"ml\"}\nrequired = {\"python\", \"sql\", \"docker\"}\nmissing = required - skills  # {\"docker\"}"
        ]
      ]
