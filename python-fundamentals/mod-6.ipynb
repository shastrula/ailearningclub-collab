      "source": [
        [
          "python",
          "# Creating dictionaries\nstudent = {\n    \"name\": \"Alice\",\n    \"age\": 20,\n    \"grades\": [85, 92, 78],\n    \"active\": True\n}\n\n# Access values\nprint(student[\"name\"])           # \"Alice\"\nprint(student.get(\"email\", \"N/A\"))  # \"N/A\" (safe access with default)\n\n# Modify\nstudent[\"age\"] = 21              # update existing\nstudent[\"email\"] = \"a@b.com\"    # add new key\ndel student[\"active\"]            # delete key\n\n# Iterate\nfor key, value in student.items():\n    print(f\"{key}: {value}\")\n\n# Dictionary comprehension\nsquares = {x: x**2 for x in range(6)}\n# {0: 0, 1: 1, 2: 4, 3: 9, 4: 16, 5: 25}\n\n# Useful methods\nprint(student.keys())    # dict_keys(['name', 'age', 'grades', 'email'])\nprint(student.values())  # dict_values([...])\nprint(\"name\" in student) # True (check if key exists)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Creating sets\ncolors = {\"red\", \"green\", \"blue\"}\nnumbers = set([1, 2, 2, 3, 3, 3])  # {1, 2, 3} - duplicates removed\n\n# Set operations\na = {1, 2, 3, 4}\nb = {3, 4, 5, 6}\n\nprint(a | b)   # {1, 2, 3, 4, 5, 6}  union\nprint(a & b)   # {3, 4}                intersection\nprint(a - b)   # {1, 2}                difference\nprint(a ^ b)   # {1, 2, 5, 6}          symmetric difference\n\n# Practical: remove duplicates\nemails = [\"a@b.com\", \"c@d.com\", \"a@b.com\", \"e@f.com\"]\nunique_emails = list(set(emails))\nprint(len(unique_emails))  # 3\n\n# Fast membership testing\nvalid_users = {\"alice\", \"bob\", \"charlie\"}\nprint(\"alice\" in valid_users)  # True (O(1) - instant!)"
        ]
      ]
    },
