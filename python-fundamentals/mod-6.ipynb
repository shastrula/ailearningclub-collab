        [
          "python",
          "# Combine multiple data structures\nclass_data = {\n    \"Alice\": [85, 92, 78, 90],\n    \"Bob\": [72, 68, 81, 77],\n    \"Charlie\": [95, 88, 92, 97],\n}\n\n# Calculate averages\naverages = {}\nfor name, grades in class_data.items():\n    averages[name] = sum(grades) / len(grades)\n\n# Sort by average (highest first)\nranked = sorted(averages.items(), key=lambda x: x[1], reverse=True)\n\nprint(\"Class Rankings:\")\nfor i, (name, avg) in enumerate(ranked, 1):\n    print(f\"  {i}. {name}: {avg:.1f}\")\n\n# Output:\n# Class Rankings:\n#   1. Charlie: 93.0\n#   2. Alice: 86.2\n#   3. Bob: 74.5"
        ]
      ]
