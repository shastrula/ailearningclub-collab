        [
          "python",
          "# Keep only items matching a condition\nscores = [85, 42, 91, 67, 73, 55, 88]\npassing = []\nfor score in scores:\n    if score >= 70:\n        passing.append(score)\nprint(passing)  # [85, 91, 67, 73, 88] \u2014 wait, 67 < 70!\n# Actually: [85, 91, 73, 88]"
        ]
      ]
    },
