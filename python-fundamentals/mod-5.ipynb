        [
          "python",
          "# Apply operation to each item\nnames = [\"alice\", \"bob\", \"charlie\"]\ncapitalized = []\nfor name in names:\n    capitalized.append(name.capitalize())\nprint(capitalized)  # ['Alice', 'Bob', 'Charlie']"
        ]
      ]
