      "source": [
        "# Aws Bedrock - mod-1\n\n",
        "**Course:** aws-bedrock\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Configure AWS credentials\naws configure\n# Enter Access Key ID, Secret Access Key, region, output format\n\n# Or use environment variables\nexport AWS_ACCESS_KEY_ID=your_key\nexport AWS_SECRET_ACCESS_KEY=your_secret\nexport AWS_DEFAULT_REGION=us-east-1"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import boto3\nimport json\n\n# Create Bedrock client\nclient = boto3.client('bedrock-runtime', region_name='us-east-1')\n\n# Define request for Claude\nbody = {\n    \"anthropic_version\": \"bedrock-2023-06-01\",\n    \"max_tokens\": 1024,\n    \"messages\": [\n        {\n            \"role\": \"user\",\n            \"content\": \"Explain quantum computing in simple terms\"\n        }\n    ]\n}\n\n# Call Claude 3.5 Sonnet\nresponse = client.invoke_model(\n    modelId='anthropic.claude-3-5-sonnet-20241022-v2:0',\n    contentType='application/json',\n    accept='application/json',\n    body=json.dumps(body)\n)\n\n# Parse response\nresult = json.loads(response['body'].read())\nprint(result['content'][0]['text'])"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Cost monitoring\ndef estimate_cost(input_tokens, output_tokens, model='claude-3-sonnet'):\n    pricing = {\n        'claude-3-sonnet': {'input': 3/1e6, 'output': 15/1e6},\n        'llama-70b': {'input': 0.75/1e6, 'output': 1/1e6},\n        'titan-text-express': {'input': 0.25/1e6, 'output': 1/1e6}\n    }\n    \n    model_pricing = pricing.get(model, pricing['claude-3-sonnet'])\n    input_cost = input_tokens * model_pricing['input']\n    output_cost = output_tokens * model_pricing['output']\n    \n    return {\n        'input_cost': input_cost,\n        'output_cost': output_cost,\n        'total_cost': input_cost + output_cost\n    }\n\n# Estimate cost for 10k input + 2k output tokens\ncost = estimate_cost(10000, 2000, 'claude-3-sonnet')\nprint(f\"Estimated cost: ${cost['total_cost']:.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Generate product description\nprompt = f\"\"\"\nProduct: Wireless Headphones\nSpecs: 40-hour battery, noise cancellation, foldable design\nPrice: $199\n\nGenerate a compelling 100-word product description for e-commerce.\n\"\"\"\n\nresponse = client.invoke_model(\n    modelId='anthropic.claude-3-5-sonnet-20241022-v2:0',\n    contentType='application/json',\n    accept='application/json',\n    body=json.dumps({\n        \"anthropic_version\": \"bedrock-2023-06-01\",\n        \"max_tokens\": 300,\n        \"messages\": [{\"role\": \"user\", \"content\": prompt}]\n    })\n)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import boto3\nimport json\nfrom typing import List\n\nclass BedrockQASystem:\n    def __init__(self, region='us-east-1'):\n        self.bedrock_client = boto3.client('bedrock-runtime', region_name=region)\n        self.model_id = 'anthropic.claude-3-5-sonnet-20241022-v2:0'\n    \n    def query_documents(self, question: str, documents: List[str]) -> str:\n        \"\"\"Query documents using Claude through Bedrock\"\"\"\n        \n        # Format documents for context\n        context = \"\\n\\n\".join([f\"Document {i+1}:\\n{doc}\" for i, doc in enumerate(documents)])\n        \n        # Build prompt\n        prompt = f\"\"\"You are a helpful assistant. Answer the following question based on the provided documents.\n\nDocuments:\n{context}\n\nQuestion: {question}\n\nProvide a concise, accurate answer based only on the documents provided.\"\"\"\n        \n        # Call Bedrock\n        body = {\n            \"anthropic_version\": \"bedrock-2023-06-01\",\n            \"max_tokens\": 512,\n            \"messages\": [\n                {\n                    \"role\": \"user\",\n                    \"content\": prompt\n                }\n            ]\n        }\n        \n        response = self.bedrock_client.invoke_model(\n            modelId=self.model_id,\n            contentType='application/json',\n            accept='application/json',\n            body=json.dumps(body)\n        )\n        \n        # Parse response\n        result = json.loads(response['body'].read())\n        return result['content'][0]['text']\n    \n    def batch_query(self, questions: List[str], documents: List[str]) -> List[str]:\n        \"\"\"Process multiple questions efficiently\"\"\"\n        results = []\n        for question in questions:\n            answer = self.query_documents(question, documents)\n            results.append(answer)\n        return results\n\n# Usage\nqa_system = BedrockQASystem()\n\ndocuments = [\n    \"Cloud computing is a paradigm shift in IT infrastructure...\",\n    \"AWS Bedrock provides managed access to foundation models...\",\n]\n\nquestions = [\n    \"What is cloud computing?\",\n    \"How does Bedrock help developers?\",\n]\n\nanswers = qa_system.batch_query(questions, documents)\nfor q, a in zip(questions, answers):\n    print(f\"Q: {q}\")\n    print(f\"A: {a}\\n\")"
        ]
      ]
    }
  ],
