          "python",
          "import sagemaker\nimport pandas as pd\nfrom sagemaker.sklearn.estimator import SKLearn\nfrom sklearn.datasets import load_iris\nimport joblib\n\n# Setup\nsession = sagemaker.Session()\nrole = sagemaker.get_execution_role()\nbucket = session.default_bucket()\n\n# Create training script\ntrain_script = \"\"\"\nimport joblib\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import RandomForestClassifier\n\n# Load data\nX = np.load('/opt/ml/input/data/training/features.npy')\ny = np.load('/opt/ml/input/data/training/labels.npy')\n\n# Train\nmodel = RandomForestClassifier(n_estimators=100, random_state=42)\nmodel.fit(X, y)\n\n# Save\njoblib.dump(model, '/opt/ml/model/model.pkl')\n\"\"\"\n\n# Prepare data\niris = load_iris()\nX = iris.data\ny = iris.target\n\n# Save locally\nnp.save('/tmp/features.npy', X)\nnp.save('/tmp/labels.npy', y)\n\n# Upload to S3\ndata_path = session.upload_data(\n    path='/tmp/features.npy',\n    bucket=bucket,\n    key_prefix='iris-data'\n)\n\n# Create training estimator\nestimator = SKLearn(\n    entry_point=train_script,\n    role=role,\n    instance_type='ml.m5.large',\n    instance_count=1,\n    framework_version='1.0-1',\n    py_version='python3'\n)\n\n# Train\nestimator.fit({'training': data_path})\n\n# Deploy\npredictor = estimator.deploy(1, 'ml.m5.large')\n\n# Predict\nsample = np.array([[5.1, 3.5, 1.4, 0.2]])\nprediction = predictor.predict(sample)\nprint(f\"Prediction: {prediction}\")\n\n# Cleanup\npredictor.delete_endpoint()"
