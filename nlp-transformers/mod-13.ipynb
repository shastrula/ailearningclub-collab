          "python",
          "from sklearn.metrics import f1_score, accuracy_score\nfrom sklearn.naive_bayes import MultinomialNB\nfrom sklearn.feature_extraction.text import TfidfVectorizer\n\n# Scenario: Text classification baseline comparison\ntexts = [\"sample 1\", \"sample 2\"] * 100\nlabels = [0, 1] * 100\n\n# Baseline: Simple TF-IDF + Naive Bayes\nvectorizer = TfidfVectorizer()\nX = vectorizer.fit_transform(texts)\n\nbaseline_model = MultinomialNB()\nbaseline_model.fit(X, labels)\n\nbaseline_f1 = f1_score(labels, baseline_model.predict(X))\nprint(f\"Baseline (TF-IDF + NB) F1: {baseline_f1:.3f}\")\n\n# Your model: Transformer\ntransformer_f1 = 0.89  # From previous section\n\n# Is improvement real?\nprint(f\"Transformer F1: {transformer_f1:.3f}\")\nprint(f\"Improvement: +{(transformer_f1 - baseline_f1)*100:.1f}%\")\n\n# Establish performance trends\nresults = {\n    \"Baseline (TF-IDF)\": 0.78,\n    \"Logistic Regression\": 0.82,\n    \"Random Forest\": 0.84,\n    \"BERT\": 0.89,\n    \"RoBERTa\": 0.91,\n}\n\nfor model, score in results.items():\n    print(f\"{model:20} {score:.3f}\")\n\n# Document which model to use\nprint(\"\\nRecommendation: RoBERTa offers best performance (91%)\")\nprint(\"Tradeoff: 3x slower inference than BERT, 2x slower than Logistic Regression\")"
        ]
      ]
    },
    {
