          "python",
          "# Ablation: Does task-specific pretraining help?\n\nresults_ablation = {\n    \"Baseline (general BERT)\": 0.87,\n    \"+ Fine-tune on domain\": 0.89,\n    \"+ Add auxiliary task\": 0.91,\n    \"+ Ensemble 3 models\": 0.92,\n}\n\nimprovement_per_component = {}\nprior = 0.87\nfor component, score in results_ablation.items():\n    improvement = score - prior\n    improvement_per_component[component] = improvement\n    print(f\"{component:35} {score:.3f} (+{improvement:.3f})\")\n    prior = score\n\n# Identify which components are worth the cost\nprint(\"\\nWorth the cost?\")\nprint(\"- Domain fine-tuning: +2% (worth it, ~10% compute overhead)\")\nprint(\"- Auxiliary task: +2% (worth it, no runtime overhead)\")\nprint(\"- Ensembling: +1% (marginal, triples inference cost)\")"
        ]
