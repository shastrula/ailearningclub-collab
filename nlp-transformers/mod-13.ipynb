        [
          "python",
          "from sklearn.metrics import (\n    accuracy_score, precision_score, recall_score, f1_score,\n    confusion_matrix, classification_report\n)\nimport numpy as np\n\n# Example predictions\ny_true = [1, 0, 1, 1, 0, 0, 1, 0, 1, 1]\ny_pred = [1, 0, 1, 0, 0, 1, 1, 0, 1, 1]\n\n# Basic metrics\naccuracy = accuracy_score(y_true, y_pred)  # (TP+TN) / Total = 8/10 = 0.80\nprecision = precision_score(y_true, y_pred)  # TP / (TP+FP) = 4/5 = 0.80\nrecall = recall_score(y_true, y_pred)  # TP / (TP+FN) = 4/5 = 0.80\nf1 = f1_score(y_true, y_pred)  # Harmonic mean: 2*(P*R)/(P+R) = 0.80\n\nprint(f\"Accuracy:  {accuracy:.3f}\")  # 0.800\nprint(f\"Precision: {precision:.3f}\")  # 0.800\nprint(f\"Recall:    {recall:.3f}\")    # 0.800\nprint(f\"F1 Score:  {f1:.3f}\")        # 0.800\n\n# Confusion matrix\ncm = confusion_matrix(y_true, y_pred)\nprint(f\"\\nConfusion Matrix:\\n{cm}\")\n# [[3 1]   <- True Negatives=3, False Positives=1\n#  [1 4]]  <- False Negatives=1, True Positives=4\n\n# Detailed report\nprint(classification_report(y_true, y_pred, target_names=[\"No Disease\", \"Disease\"]))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
