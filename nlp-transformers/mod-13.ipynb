      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nfrom transformers import AutoTokenizer, AutoModelForCausalLM\nimport math\n\nmodel_name = \"gpt2\"\ntokenizer = AutoTokenizer.from_pretrained(model_name)\nmodel = AutoModelForCausalLM.from_pretrained(model_name)\n\n# Test text\ntest_text = \"The quick brown fox jumps over the lazy dog. \" * 10\n\n# Tokenize\nencodings = tokenizer(test_text, return_tensors=\"pt\")\ninput_ids = encodings[\"input_ids\"]\n\n# Compute loss on test data\nmax_length = model.config.n_positions\nstride = 512\n\nnlls = []\nfor i in range(0, input_ids.size(1) - 1, stride):\n    begin_loc = max(i + stride - max_length, 0)\n    end_loc = min(i + stride, input_ids.size(1))\n    \n    trg_len = end_loc - i\n    input_ids_chunk = input_ids[:, begin_loc:end_loc]\n    \n    with torch.no_grad():\n        outputs = model(input_ids_chunk, labels=input_ids_chunk)\n        loss = outputs.loss\n    \n    nlls.append(loss)\n\n# Perplexity = exp(average loss)\nppl = torch.exp(torch.tensor(nlls).mean())\nprint(f\"Perplexity: {ppl:.2f}\")"
        ]
      ]
    },
    {
