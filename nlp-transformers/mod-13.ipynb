        [
          "python",
          "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\nimport json\nfrom datetime import datetime\n\nclass EvaluationPipeline:\n    def __init__(self, model, test_set):\n        self.model = model\n        self.test_set = test_set\n        self.results = []\n    \n    def evaluate(self):\n        \"\"\"Full evaluation on test set\"\"\"\n        y_true, y_pred = [], []\n        \n        for sample in self.test_set:\n            pred = self.model.predict(sample[\"text\"])\n            y_pred.append(pred)\n            y_true.append(sample[\"label\"])\n        \n        # Compute metrics\n        metrics = {\n            \"timestamp\": datetime.now().isoformat(),\n            \"accuracy\": accuracy_score(y_true, y_pred),\n            \"precision\": precision_score(y_true, y_pred, average=\"weighted\", zero_division=0),\n            \"recall\": recall_score(y_true, y_pred, average=\"weighted\", zero_division=0),\n            \"f1\": f1_score(y_true, y_pred, average=\"weighted\", zero_division=0),\n            \"samples\": len(y_true),\n        }\n        \n        self.results.append(metrics)\n        return metrics\n    \n    def detect_degradation(self, threshold=0.05):\n        \"\"\"Alert if metrics drop by > threshold\"\"\"\n        if len(self.results) < 2:\n            return None\n        \n        current = self.results[-1]\n        previous = self.results[-2]\n        \n        f1_drop = previous[\"f1\"] - current[\"f1\"]\n        if f1_drop > threshold:\n            print(f\"\u26a0\ufe0f  Alert: F1 dropped {f1_drop:.3f} (threshold: {threshold})\")\n            return True\n        \n        return False\n    \n    def save_report(self, filepath):\n        \"\"\"Persist metrics for analysis\"\"\"\n        with open(filepath, \"w\") as f:\n            json.dump(self.results, f, indent=2)\n\n# Usage\npipeline = EvaluationPipeline(model, test_set)\nmetrics = pipeline.evaluate()\npipeline.detect_degradation(threshold=0.03)\npipeline.save_report(\"eval_metrics.json\")"
        ]
      ]
    },
