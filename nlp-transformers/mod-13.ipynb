      "source": [
        [
          "python",
          "import matplotlib.pyplot as plt\nimport numpy as np\nfrom sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay\n\n# Multi-class example: Intent classification (5 classes)\ny_true = [0, 1, 2, 3, 4, 0, 1, 2, 0, 1, 3, 3, 2, 4, 0]\ny_pred = [0, 1, 2, 3, 4, 0, 1, 2, 0, 0, 3, 3, 2, 2, 0]\n\ncm = confusion_matrix(y_true, y_pred)\n\n# Plot\ndisp = ConfusionMatrixDisplay(cm, display_labels=[\"greeting\", \"goodbye\", \"help\", \"info\", \"error\"])\ndisp.plot(cmap=\"Blues\", values_format=\"d\")\nplt.title(\"Intent Classification Confusion Matrix\")\nplt.tight_layout()\nplt.savefig(\"confusion_matrix.png\")\nplt.close()\n\n# Manual interpretation\nprint(\"Diagonal elements = correct predictions per class\")\nprint(\"Off-diagonal = common mistakes\")\nprint(f\"Model confuses 'info' (class 3) with 'error' (class 4): {cm[3, 4]} times\")\n\n# Class-wise metrics\nfrom sklearn.metrics import precision_recall_fscore_support\n\nprecision, recall, f1, support = precision_recall_fscore_support(y_true, y_pred)\nfor i, class_name in enumerate([\"greeting\", \"goodbye\", \"help\", \"info\", \"error\"]):\n    print(f\"{class_name}: P={precision[i]:.2f}, R={recall[i]:.2f}, F1={f1[i]:.2f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
