        [
          "python",
          "# Pattern 1: Error analysis\u2014understand failure modes\nfrom collections import Counter\n\ndef analyze_errors(predictions, labels, texts, label_names):\n    \"\"\"Deep dive into model failures\"\"\"\n    errors = []\n    \n    for pred, label, text in zip(predictions, labels, texts):\n        if pred != label:\n            errors.append({\n                \"text\": text,\n                \"predicted\": label_names[pred],\n                \"actual\": label_names[label],\n            })\n    \n    # Categorize errors\n    error_patterns = Counter()\n    for error in errors:\n        if \"company\" in error[\"text\"].lower():\n            error_patterns[\"missed_company_mention\"] += 1\n        elif len(error[\"text\"]) > 500:\n            error_patterns[\"long_text\"] += 1\n        else:\n            error_patterns[\"other\"] += 1\n    \n    print(f\"Total errors: {len(errors)}/{len(labels)}\")\n    for pattern, count in error_patterns.most_common():\n        print(f\"  {pattern}: {count}\")\n    \n    return errors, error_patterns\n\n# Pattern 2: Confidence calibration\u2014are confident predictions correct?\ndef calibration_analysis(predictions, probabilities, labels, n_bins=10):\n    \"\"\"Check if model confidence matches actual accuracy\"\"\"\n    bins = [[] for _ in range(n_bins)]\n    \n    for pred_prob, label in zip(probabilities, labels):\n        bin_idx = int(pred_prob * (n_bins - 1))\n        bins[bin_idx].append(label)\n    \n    print(\"Confidence vs Accuracy:\")\n    for i, bin_data in enumerate(bins):\n        if not bin_data:\n            continue\n        confidence = (i + 0.5) / n_bins\n        accuracy = sum(bin_data) / len(bin_data)  # Accuracy in this confidence bin\n        print(f\"  {confidence:.1%} confidence \u2192 {accuracy:.1%} accuracy\")\n    \n    # Well-calibrated model: confidence \u2248 accuracy\n\n# Pattern 3: Performance on rare classes\ndef rare_class_analysis(predictions, labels, class_names, min_samples=10):\n    \"\"\"Ensure model performs on minority classes\"\"\"\n    class_counts = Counter(labels)\n    \n    for class_id, count in class_counts.items():\n        if count < min_samples:\n            class_mask = labels == class_id\n            class_acc = (predictions[class_mask] == labels[class_mask]).mean()\n            print(f\"Class '{class_names[class_id]}': {count} samples, {class_acc:.1%} accuracy\")"
        ]
      ]
