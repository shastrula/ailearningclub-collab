          "python",
          "from rouge_score import rouge_scorer\n\nscorer = rouge_scorer.RougeScorer(['rouge1', 'rougeL'], use_stemmer=True)\n\n# Reference summary\nreference = \"The cat sat on the mat and looked out the window.\"\n\n# Model summary\nhypothesis = \"The cat was on the mat and looked outside.\"\n\nscores = scorer.score(reference, hypothesis)\nprint(f\"ROUGE-1 (unigram): {scores['rouge1'].fmeasure:.3f}\")\nprint(f\"ROUGE-L (longest subsequence): {scores['rougeL'].fmeasure:.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
