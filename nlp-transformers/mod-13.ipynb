      "source": [
        [
          "python",
          "# Macro: Unweighted average across classes (all classes equally important)\nf1_macro = f1_score(y_true, y_pred, average=\"macro\")\n\n# Weighted: Average weighted by class frequency (larger classes weighted more)\nf1_weighted = f1_score(y_true, y_pred, average=\"weighted\")\n\n# Imbalanced classes: Weighted F1 is more representative\nprint(f\"F1 (macro): {f1_macro:.3f}\")    # Treats all classes equally\nprint(f\"F1 (weighted): {f1_weighted:.3f}\")  # Weights by prevalence"
        ]
      ]
    },
    {
