          "python",
          "from nltk.translate.bleu_score import sentence_bleu, corpus_bleu\nimport nltk\nnltk.download(\"punkt\")\n\n# Reference (ground truth)\nreference = [\n    [\"the\", \"cat\", \"sat\", \"on\", \"the\", \"mat\"],\n]\n\n# Hypothesis (model output)\nhypothesis = [\"the\", \"cat\", \"is\", \"on\", \"the\", \"mat\"]\n\n# Sentence BLEU\nscore = sentence_bleu(reference, hypothesis, weights=(0.25, 0.25, 0.25, 0.25))\nprint(f\"BLEU Score: {score:.3f}\")  # Range: 0-1, higher is better\n\n# Multi-reference (multiple valid translations)\nreferences = [\n    [[\"the\", \"cat\", \"sat\", \"on\", \"the\", \"mat\"]],\n    [[\"a\", \"cat\", \"is\", \"sitting\", \"on\", \"the\", \"mat\"]],\n]\nhypothesis = [\"the\", \"cat\", \"is\", \"on\", \"the\", \"mat\"]\nscore = sentence_bleu(references[0], hypothesis)"
        ]
      ]
