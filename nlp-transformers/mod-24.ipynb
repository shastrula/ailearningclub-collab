          "python",
          "import time\nimport queue\nfrom concurrent.futures import ThreadPoolExecutor\nimport numpy as np\n\nclass DynamicBatcher:\n    def __init__(self, process_fn, batch_size=32, timeout_ms=10):\n        self.process_fn = process_fn\n        self.batch_size = batch_size\n        self.timeout = timeout_ms / 1000\n        self.queue = queue.Queue()\n        self.results = {}\n        self.executor = ThreadPoolExecutor(max_workers=1)\n        self._start_worker()\n    \n    def _start_worker(self):\n        \"\"\"Background worker processing batches.\"\"\"\n        def worker():\n            while True:\n                batch_items = []\n                deadline = time.time() + self.timeout\n                \n                # Collect batch with timeout\n                while len(batch_items) < self.batch_size:\n                    remaining = deadline - time.time()\n                    timeout = max(0.001, remaining)\n                    try:\n                        req = self.queue.get(timeout=timeout)\n                        batch_items.append(req)\n                        \n                        # If batch filled, process immediately\n                        if len(batch_items) >= self.batch_size:\n                            break\n                    except queue.Empty:\n                        if len(batch_items) > 0:\n                            break\n                        continue\n                \n                if batch_items:\n                    request_ids, inputs = zip(*batch_items)\n                    outputs = self.process_fn(list(inputs))\n                    \n                    for req_id, output in zip(request_ids, outputs):\n                        self.results[req_id] = output\n        \n        self.executor.submit(worker)\n    \n    def infer(self, request_id, input_data):\n        \"\"\"Submit request and wait for result.\"\"\"\n        self.queue.put((request_id, input_data))\n        \n        # Wait for result (with timeout)\n        start = time.time()\n        while request_id not in self.results:\n            if time.time() - start > 1.0:\n                raise TimeoutError(\"Inference timeout\")\n            time.sleep(0.001)\n        \n        return self.results.pop(request_id)\n\n# Mock inference function\ndef batch_inference(texts):\n    # Simulate GPU inference\n    time.sleep(0.05)  # Base latency\n    return [f\"result_{t}\" for t in texts]\n\n# Benchmark\nbatcher = DynamicBatcher(batch_inference, batch_size=32, timeout_ms=10)\n\n# Simulate 100 requests with variable arrival\nlatencies = []\nfor i in range(100):\n    start = time.time()\n    result = batcher.infer(f\"req_{i}\", f\"input_{i}\")\n    latency = (time.time() - start) * 1000\n    latencies.append(latency)\n    time.sleep(np.random.exponential(0.01))  # Variable arrival\n\nprint(f\"Latency p50: {np.percentile(latencies, 50):.1f}ms\")\nprint(f\"Latency p99: {np.percentile(latencies, 99):.1f}ms\")\nprint(f\"Throughput: {len(latencies) / sum(latencies) * 1000:.0f} req/sec\")\n\n# Output (typical):\n# Latency p50: 52ms (batch fills quickly)\n# Latency p99: 62ms (occasional timeout)\n# Throughput: 1923 req/sec (with batch_size=32)"
        ]
      ]
