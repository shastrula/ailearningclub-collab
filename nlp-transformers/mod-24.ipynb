          "python",
          "import torch\nfrom torch import nn\nfrom torch.nn import functional as F\n\nclass DistillationLoss(nn.Module):\n    def __init__(self, temperature=4.0):\n        super().__init__()\n        self.temperature = temperature\n        \n    def forward(self, student_logits, teacher_logits, labels):\n        # Soft targets: teacher predictions with temperature scaling\n        teacher_probs = F.softmax(teacher_logits / self.temperature, dim=-1)\n        student_logprobs = F.log_softmax(student_logits / self.temperature, dim=-1)\n        \n        # Distillation loss: KL divergence between soft targets\n        kl_loss = F.kl_div(student_logprobs, teacher_probs, reduction='batchmean')\n        \n        # Hard loss: student on true labels (optional, often not needed)\n        # hard_loss = F.cross_entropy(student_logits, labels)\n        \n        # Combine: distillation dominates (alpha=0.9)\n        return kl_loss  # or: 0.9 * kl_loss + 0.1 * hard_loss\n\n# Training loop\nteacher_model = AutoModelForSequenceClassification.from_pretrained(\"bert-base-uncased\")\nstudent_model = AutoModelForSequenceClassification.from_pretrained(\n    \"distilbert-base-uncased\"  # 40% smaller\n)\n\ndistill_loss_fn = DistillationLoss(temperature=4.0)\noptimizer = torch.optim.Adam(student_model.parameters(), lr=2e-5)\n\nfor batch in train_loader:\n    inputs = {k: v.to(device) for k, v in batch.items() if k != 'labels'}\n    labels = batch['labels'].to(device)\n    \n    # Teacher (no grad)\n    with torch.no_grad():\n        teacher_logits = teacher_model(**inputs).logits\n    \n    # Student\n    student_logits = student_model(**inputs).logits\n    loss = distill_loss_fn(student_logits, teacher_logits, labels)\n    \n    optimizer.zero_grad()\n    loss.backward()\n    optimizer.step()\n\n# Result: 40% smaller, 2x faster, 95% of original accuracy"
        ]
      ]
    },
