          "python",
          "# Export model to ONNX for CPU inference\nfrom transformers.onnx import export\nfrom optimum.onnxruntime import ORTModelForSequenceClassification\n\n# Convert to ONNX (one-time)\nmodel_name = \"bert-base-uncased\"\nonnx_model = ORTModelForSequenceClassification.from_pretrained(\n    model_name,\n    from_transformers=True,\n    export=True\n)\nonnx_model.save_pretrained(f\"{model_name}-onnx\")\n\n# Inference (CPU, 10x faster than PyTorch on CPU)\nonnx_model = ORTModelForSequenceClassification.from_pretrained(\n    f\"{model_name}-onnx\"\n)\ninputs = tokenizer(\"This is great!\", return_tensors=\"pt\")\noutputs = onnx_model(**inputs)\n\n# Typical latency: 50ms on CPU vs 5ms on GPU\n# Cost: $0.0001/hour CPU (always-on) vs $0.001/hour GPU (burstable)"
        ]
