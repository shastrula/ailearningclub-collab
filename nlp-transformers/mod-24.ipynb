          "python",
          "import asyncio\nimport queue\nimport time\nfrom transformers import AutoModelForSequenceClassification, AutoTokenizer\n\nclass AsyncInferenceServer:\n    def __init__(self, model_name, batch_size=32, timeout_ms=100):\n        self.model = AutoModelForSequenceClassification.from_pretrained(model_name)\n        self.tokenizer = AutoTokenizer.from_pretrained(model_name)\n        self.model.cuda()\n        self.model.eval()\n        \n        self.batch_size = batch_size\n        self.timeout_ms = timeout_ms / 1000\n        self.queue = queue.Queue()\n        self.results = {}\n        \n    async def infer_batch(self):\n        \"\"\"Process batches from queue periodically.\"\"\"\n        while True:\n            batch_items = []\n            deadline = time.time() + self.timeout_ms\n            \n            # Collect batch\n            while len(batch_items) < self.batch_size and time.time() < deadline:\n                try:\n                    request_id, text = self.queue.get(timeout=0.01)\n                    batch_items.append((request_id, text))\n                except queue.Empty:\n                    continue\n            \n            if batch_items:\n                request_ids, texts = zip(*batch_items)\n                \n                # Batch inference\n                inputs = self.tokenizer(texts, return_tensors=\"pt\", padding=True).to(\"cuda\")\n                with torch.no_grad():\n                    logits = self.model(**inputs).logits\n                \n                # Store results\n                for req_id, logit in zip(request_ids, logits):\n                    self.results[req_id] = logit.cpu()\n            \n            await asyncio.sleep(0.001)  # Brief sleep to avoid busy loop\n    \n    async def predict(self, request_id, text):\n        \"\"\"Queue prediction and wait for result.\"\"\"\n        self.queue.put((request_id, text))\n        \n        # Wait for result (timeout after 1 second)\n        start = time.time()\n        while request_id not in self.results:\n            if time.time() - start > 1.0:\n                raise TimeoutError(f\"Request {request_id} timed out\")\n            await asyncio.sleep(0.001)\n        \n        return self.results.pop(request_id)\n\n# Server latency: ~50ms per request (batches of 32)\n# Without batching: ~10ms per request (but can't handle 100 concurrent)"
        ]
      ]
    },
