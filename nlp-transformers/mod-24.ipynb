          "python",
          "from transformers import AutoModelForCausalLM, GenerationConfig\n\n# Standard generation (recomputes all attention)\nmodel = AutoModelForCausalLM.from_pretrained(\"gpt2\")\ntokenizer = AutoTokenizer.from_pretrained(\"gpt2\")\n\n# Generation with automatic KV cache\nmodel.eval()\nwith torch.no_grad():\n    inputs = tokenizer(\"Once upon a time\", return_tensors=\"pt\")\n    outputs = model.generate(\n        **inputs,\n        max_length=100,\n        # KV cache automatically used (PyTorch 2.0+)\n        use_cache=True  # Enabled by default\n    )\n\n# For quantized KV cache (inference-only):\n# Use vLLM or TensorRT backends that support int8 KV cache\n# Typical speedup: 2-3x for long sequences\n\nprint(tokenizer.decode(outputs[0]))"
        ]
