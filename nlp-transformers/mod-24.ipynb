          "python",
          "import torch\nfrom transformers import AutoModelForCausalLM, AutoTokenizer\nfrom transformization import quantize_dynamic\n\n# Load model\nmodel = AutoModelForCausalLM.from_pretrained(\"gpt2\")\n\n# Dynamic quantization (int8)\nquantized_model = torch.quantization.quantize_dynamic(\n    model,\n    {torch.nn.Linear},  # Quantize Linear layers\n    dtype=torch.qint8\n)\n\n# Model size reduction\noriginal_size = sum(p.numel() for p in model.parameters()) * 4 / (1024**3)  # GB\nquantized_size = sum(p.numel() for p in quantized_model.parameters()) * 1 / (1024**3)  # GB\n\nprint(f\"Original: {original_size:.2f}GB \u2192 Quantized: {quantized_size:.2f}GB\")\n\n# Inference (5-10x faster on CPU, 2-3x on GPU)\ntokenizer = AutoTokenizer.from_pretrained(\"gpt2\")\ninputs = tokenizer(\"Hello\", return_tensors=\"pt\")\nwith torch.no_grad():\n    output = quantized_model.generate(**inputs, max_length=20)"
        ]
