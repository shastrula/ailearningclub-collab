          "python",
          "import torch\nimport torch.amp\n\n# Mixed precision training\nmodel = AutoModelForSequenceClassification.from_pretrained(\"bert-base-uncased\")\nscaler = torch.cuda.amp.GradScaler()\noptimizer = torch.optim.AdamW(model.parameters())\n\nfor batch in train_loader:\n    with torch.autocast(device_type=\"cuda\", dtype=torch.float16):\n        outputs = model(**batch)\n        loss = outputs.loss\n    \n    scaler.scale(loss).backward()\n    scaler.step(optimizer)\n    scaler.update()\n\n# Memory usage: ~12GB instead of 24GB (float16 for activations)\n# Speed: 1.5-2x faster on modern GPUs (Tensor Cores)\n# Accuracy: typically identical or within 0.1%\n\n# Attention head pruning (remove redundant heads)\n# Average 12-head BERT down to 8 heads, 30% speedup, <1% accuracy loss\nnum_heads_to_remove = 4\nhead_mask = torch.ones(12, 64)\nhead_mask[:num_heads_to_remove] = 0  # Disable first 4 heads\n\noutputs = model(**inputs, head_mask=head_mask)\n# Model learns that removed heads were redundant; remaining heads compensate"
