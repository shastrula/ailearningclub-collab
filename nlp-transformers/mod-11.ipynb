          "python",
          "from datasets import concatenate_datasets, load_dataset\n\n# Combine multiple datasets\nwikitext = load_dataset(\"wikitext\", \"wikitext-2\", split=\"train\")\nbookcorpus = load_dataset(\"bookcorpus\", split=\"train\")  # If available\nc4_sample = load_dataset(\"c4\", \"en\", split=\"train\", streaming=True)\n\n# Weighted sampling (prioritize some sources)\nweights = {\n    \"wikitext\": 0.3,  # 30% of batches from WikiText\n    \"bookcorpus\": 0.5,  # 50% from BookCorpus\n    \"c4\": 0.2,  # 20% from C4 (streaming)\n}\n\nclass MultiSourceDataloader:\n    def __init__(self, sources, weights):\n        self.sources = sources\n        self.weights = weights\n        self.iterators = {name: iter(ds) for name, ds in sources.items()}\n    \n    def __iter__(self):\n        import random\n        while True:\n            source_name = random.choices(\n                list(self.weights.keys()),\n                weights=list(self.weights.values())\n            )[0]\n            \n            try:\n                yield next(self.iterators[source_name])\n            except StopIteration:\n                # Reset iterator\n                self.iterators[source_name] = iter(self.sources[source_name])\n                yield next(self.iterators[source_name])\n\nsources = {\n    \"wikitext\": wikitext.take(10000),\n    \"bookcorpus\": bookcorpus.take(10000),\n}\nmulti_loader = MultiSourceDataloader(sources, {\"wikitext\": 0.3, \"bookcorpus\": 0.7})\n\nfor i, sample in enumerate(multi_loader):\n    if i >= 1000:\n        break\n    # Train on mixed samples"
