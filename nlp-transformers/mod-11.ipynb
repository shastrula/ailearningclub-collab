          "python",
          "from datasets import load_dataset\nfrom transformers import AutoTokenizer, DataCollatorForLanguageModeling\nfrom torch.utils.data import DataLoader\n\n# 1. Load with streaming for single-pass training\ndataset = load_dataset(\n    \"wikitext\",\n    \"wikitext-2\",\n    split=\"train\",\n    streaming=True\n)\n\ntokenizer = AutoTokenizer.from_pretrained(\"gpt2\")\n\n# 2. Tokenize in batches with multiprocessing\ndef tokenize_batch(examples):\n    tokens = tokenizer(examples[\"text\"], truncation=True, max_length=512)\n    return tokens\n\ntokenized = dataset.map(tokenize_batch, batched=True)\n\n# 3. Use specialized collator (MLM for BERT, CLM for GPT)\ncollator = DataCollatorForLanguageModeling(tokenizer, mlm=False)\n\n# 4. Create DataLoader with prefetching\ndataloader = DataLoader(\n    tokenized,\n    batch_size=64,\n    collate_fn=collator,\n    num_workers=8,  # Parallel I/O\n    pin_memory=True  # Transfer CPU\u2194GPU faster\n)\n\n# 5. Training loop with streaming\nimport itertools\n\nfor epoch in range(3):\n    for batch_idx, batch in enumerate(dataloader):\n        if batch_idx >= 1000:  # Limit epoch size for streaming\n            break\n        # Training step here\n        pass"
        ]
      ]
