          "python",
          "import time\nimport statistics\n\n# Profile a typical training loop to identify bottlenecks\nclass PerformanceProfiler:\n    def __init__(self):\n        self.timings = {}\n    \n    def profile_dataloader(self, dataloader, num_batches=100):\n        \"\"\"Measure where time goes in data loading\"\"\"\n        load_times = []\n        gpu_times = []\n        \n        for i, batch in enumerate(dataloader):\n            batch_start = time.time()\n            \n            # Loading time\n            load_end = time.time()\n            load_times.append(load_end - batch_start)\n            \n            # GPU transfer (simulated)\n            batch_device = {k: v.cuda() for k, v in batch.items()}\n            gpu_times.append(time.time() - load_end)\n            \n            if i >= num_batches:\n                break\n        \n        print(f\"Loading: {statistics.mean(load_times)*1000:.1f}ms avg\")\n        print(f\"GPU transfer: {statistics.mean(gpu_times)*1000:.1f}ms avg\")\n        \n        return {\n            \"load_ms\": statistics.mean(load_times) * 1000,\n            \"gpu_ms\": statistics.mean(gpu_times) * 1000,\n        }\n\n# Real example: Common patterns\npatterns = {\n    \"Small dataset (<1GB)\": {\n        \"load\": 2.0,\n        \"tokenize\": 15.0,\n        \"gpu_transfer\": 5.0,\n    },\n    \"Medium dataset (10-100GB)\": {\n        \"load\": 5.0,\n        \"tokenize\": 40.0,\n        \"gpu_transfer\": 8.0,\n    },\n    \"Large dataset (>500GB)\": {\n        \"load\": 0.5,  # Streaming\u2014no load\n        \"tokenize\": 80.0,\n        \"gpu_transfer\": 2.0,\n    },\n}\n\nfor scenario, timing in patterns.items():\n    total = sum(timing.values())\n    print(f\"\\n{scenario}:\")\n    for component, ms in sorted(timing.items(), key=lambda x: x[1], reverse=True):\n        pct = 100 * ms / total\n        print(f\"  {component:15} {ms:5.1f}ms ({pct:5.1f}%)\")"
        ]
      ]
