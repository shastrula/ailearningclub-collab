          "python",
          "import pyarrow.parquet as pq\nfrom datasets import Dataset\nimport numpy as np\n\n# Create a Parquet file from structured data\ndata = {\n    \"text\": [\"sample 1\", \"sample 2\", \"sample 3\"] * 1000,\n    \"label\": [0, 1, 0] * 1000\n}\ndataset = Dataset.from_dict(data)\ndataset.to_parquet(\"data/samples.parquet\")\n\n# Memory-map the Parquet file\nparquet_file = pq.ParquetFile(\"data/samples.parquet\")\nprint(f\"Schema: {parquet_file.schema}\")\nprint(f\"Num rows: {parquet_file.metadata.num_rows}\")\n\n# Read specific row range without loading entire file\ntable = parquet_file.read_row_group(0)  # First row group\nprint(f\"Loaded: {len(table)} rows\")\n\n# Load back as HuggingFace dataset\nloaded = Dataset.from_parquet(\"data/samples.parquet\")\n\n# Index any sample instantly\u2014disk I/O only for accessed rows\nsample_5000 = loaded[5000]\nprint(f\"Accessed row 5000: {sample_5000}\")"
