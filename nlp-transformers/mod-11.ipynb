          "python",
          "from datasets import load_dataset\nimport statistics\n\ndataset = load_dataset(\"wikitext\", \"wikitext-2\", split=\"train\", streaming=True)\n\n# Sample and analyze\nlengths = []\nfor i, sample in enumerate(dataset):\n    if i >= 10000:  # Sample 10k\n        break\n    lengths.append(len(sample[\"text\"].split()))\n\n# Statistics\nprint(f\"Median length: {statistics.median(lengths)}\")\nprint(f\"Mean length: {statistics.mean(lengths):.0f}\")\nprint(f\"Stdev: {statistics.stdev(lengths):.0f}\")\nprint(f\"Min: {min(lengths)}, Max: {max(lengths)}\")\n\n# Check for anomalies\noutliers = [l for l in lengths if l > 50000]\nprint(f\"Suspiciously long sequences (>50k): {len(outliers)}\")\n\n# Look for patterns\nfor i, sample in enumerate(dataset.take(5)):\n    if len(sample[\"text\"]) > 10000:\n        print(f\"Sample {i} is very long ({len(sample['text'])} chars)\")\n        print(f\"Preview: {sample['text'][:100]}...\")"
        ]
