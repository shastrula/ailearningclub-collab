          "python",
          "from datasets import load_dataset\n\n# Stream directly from remote source\u2014no download required\ndataset = load_dataset(\n    \"wikitext\",\n    \"wikitext-2\",\n    split=\"train\",\n    streaming=True  # Key: stream mode\n)\n\n# Iterate through data\u2014memory usage stays constant\nfor sample in dataset:\n    tokens = sample[\"text\"][:100]  # Process small chunks\n    print(f\"Processed: {len(tokens)} tokens\")\n    if len(tokens) > 10000:\n        break\n\n# Apply transformations without materializing full dataset\ndef tokenize(example):\n    return {\"tokens\": example[\"text\"].split()}\n\nmapped = dataset.map(tokenize)\n\n# Chain operations\u2014all lazy until iteration\nfiltered = mapped.filter(lambda x: len(x[\"tokens\"]) > 10)\n\nfor sample in filtered.take(100):  # Only fetch first 100\n    print(f\"Tokens: {len(sample['tokens'])}\")"
        ]
      ]
