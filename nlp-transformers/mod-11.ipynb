          "python",
          "from torch.utils.data import DistributedSampler, DataLoader\nfrom datasets import load_dataset\nimport torch.distributed as dist\n\n# Initialize distributed training\ndist.init_process_group(backend=\"nccl\")\n\n# Load dataset\ndataset = load_dataset(\"wikitext\", \"wikitext-2\", split=\"train\")\n\n# Create distributed sampler (rank=process ID, world_size=total processes)\nsampler = DistributedSampler(\n    dataset,\n    num_replicas=dist.get_world_size(),\n    rank=dist.get_rank(),\n    shuffle=True,\n    seed=42\n)\n\n# DataLoader uses sampler\ndataloader = DataLoader(\n    dataset,\n    batch_size=32,\n    sampler=sampler,\n    num_workers=4\n)\n\n# Training loop\nfor epoch in range(3):\n    sampler.set_epoch(epoch)  # Important: shuffle differs per epoch\n    for batch in dataloader:\n        # Each GPU process receives different subset of data\n        pass"
