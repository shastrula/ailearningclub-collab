          "python",
          "from datasets import load_dataset\n\n# Filter massive datasets efficiently\ndataset = load_dataset(\"c4\", \"en\", split=\"train\", streaming=True)\n\n# Keep only English with 50+ words\nfiltered = dataset.filter(\n    lambda x: len(x[\"text\"].split()) > 50,\n    num_proc=4  # Parallel filtering\n)\n\n# Shuffle with fixed buffer\nshuffled = filtered.shuffle(buffer_size=1000, seed=42)\n\n# Sample for development\nsampled = shuffled.take(10000)  # First 10k samples\n\n# Chain all transformations\npipeline = (\n    load_dataset(\"wikitext\", \"wikitext-2\", split=\"train\", streaming=True)\n    .filter(lambda x: len(x[\"text\"]) > 100)\n    .map(lambda x: {\"text\": x[\"text\"].lower()})\n    .take(50000)\n)\n\n# Materialize if small enough\nmaterialized = pipeline.to_dict()\nprint(f\"Loaded {len(materialized['text'])} samples\")"
