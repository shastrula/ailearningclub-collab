        [
          "python",
          "# Using Flash Attention 2 via Hugging Face\nfrom transformers import AutoModelForCausalLM, AutoTokenizer\n\nmodel = AutoModelForCausalLM.from_pretrained(\n    \"meta-llama/Llama-2-7b\",\n    torch_dtype=\"auto\",\n    device_map=\"auto\",\n    attn_implementation=\"flash_attention_2\"  # Use Flash Attention\n)\n\ntokenizer = AutoTokenizer.from_pretrained(\"meta-llama/Llama-2-7b\")\ninputs = tokenizer(\"Hello, my name is\", return_tensors=\"pt\")\n\n# Generates with Flash Attention (faster, lower memory)\nwith torch.no_grad():\n    outputs = model.generate(**inputs, max_length=50)\n\nprint(tokenizer.decode(outputs[0]))\n\n# Speed improvement: ~2-3x faster on long sequences (>1K tokens)\n# Memory improvement: enable longer sequences or larger batches"
        ]
      ]
    },
