          "python",
          "# DeepSpeed training configuration (config.json)\n# {\n#   \"train_batch_size\": 256,\n#   \"gradient_accumulation_steps\": 4,\n#   \"optimizer\": {\n#     \"type\": \"Adam\",\n#     \"params\": {\"lr\": 1e-4}\n#   },\n#   \"zero_optimization\": {\n#     \"stage\": 3,\n#     \"offload_optimizer\": {\"device\": \"cpu\"},\n#     \"offload_param\": {\"device\": \"cpu\"}\n#   },\n#   \"activation_checkpointing\": {\n#     \"partition_activations\": true,\n#     \"cpu_checkpointing\": true\n#   },\n#   \"fp16\": {\"enabled\": true}\n# }\n\nfrom deepspeed import initialize, get_optimizer\nimport deepspeed\n\nmodel = nn.Transformer(d_model=512, nhead=8, num_layers=24)\nmodel_engine, optimizer, _, _ = deepspeed.initialize(\n    model=model,\n    config=\"config.json\"\n)\n\nfor batch in train_loader:\n    outputs = model_engine(batch)\n    loss = outputs.loss\n    model_engine.backward(loss)\n    model_engine.step()\n\n# Handles all distributed training, memory optimization, etc.\n# Launch: deepspeed --num_gpus=8 script.py"
        ]
      ]
