      "source": [
        [
          "python",
          "import torch.utils.checkpoint as checkpoint\n\nclass CheckpointedTransformer(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.embedding = nn.Embedding(10000, 512)\n        self.layers = nn.ModuleList([nn.TransformerEncoderLayer(\n            d_model=512, nhead=8, dim_feedforward=2048\n        ) for _ in range(24)])\n        \n    def forward(self, input_ids, use_checkpointing=True):\n        x = self.embedding(input_ids)  # Not checkpointed (small)\n        \n        for layer in self.layers:\n            if use_checkpointing:\n                # Recompute during backward, save memory\n                x = checkpoint.checkpoint(layer, x, use_reentrant=False)\n            else:\n                # Standard forward (uses more memory)\n                x = layer(x)\n        \n        return x\n\nmodel = CheckpointedTransformer()\ninput_ids = torch.randint(0, 10000, (8, 512))\n\n# With checkpointing: ~12GB memory, ~2x slower backward\n# Without checkpointing: ~45GB memory, standard speed\noutput = model(input_ids, use_checkpointing=True)"
        ]
      ]
    },
    {
