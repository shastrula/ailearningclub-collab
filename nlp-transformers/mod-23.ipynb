      "source": [
        "# Nlp Transformers - mod-23\n\n",
        "**Course:** nlp-transformers\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport torch.nn as nn\nfrom torch.nn.parallel import DistributedDataParallel as DDP\nfrom torch.utils.data.distributed import DistributedSampler\nimport torch.distributed as dist\n\n# Initialize distributed process group (in each process)\ndist.init_process_group(backend=\"nccl\")  # NCCL for GPU, Gloo for CPU\nrank = dist.get_rank()\nworld_size = dist.get_world_size()\ndevice = torch.device(f\"cuda:{rank}\")\n\n# Create model and move to GPU\nmodel = nn.Transformer(d_model=512, nhead=8, num_layers=12)\nmodel.to(device)\n\n# Wrap with DDP\nmodel = DDP(model, device_ids=[rank], output_device=rank)\n\n# Distributed sampler ensures no data overlap between processes\ntrain_dataset = torch.utils.data.TensorDataset(torch.randn(1000, 512))\nsampler = DistributedSampler(\n    train_dataset,\n    num_replicas=world_size,\n    rank=rank,\n    shuffle=True,\n    seed=42\n)\n\ntrain_loader = torch.utils.data.DataLoader(\n    train_dataset,\n    batch_size=32,\n    sampler=sampler  # Use sampler, not shuffle\n)\n\n# Training loop (standard, with synchronization automatic)\noptimizer = torch.optim.Adam(model.parameters())\ncriterion = nn.MSELoss()\n\nfor epoch in range(3):\n    for batch_idx, (data,) in enumerate(train_loader):\n        data = data.to(device)\n        target = torch.randn(32, 10).to(device)\n        \n        optimizer.zero_grad()\n        output = model(data)\n        loss = criterion(output, target)\n        loss.backward()  # Gradients synchronized automatically\n        optimizer.step()\n        \n        if batch_idx % 10 == 0 and rank == 0:\n            print(f\"Epoch {epoch}, Batch {batch_idx}, Loss: {loss.item():.4f}\")\n\n# Cleanup\ndist.destroy_process_group()\n\n# Launch with: torchrun --nproc_per_node=8 script.py"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nfrom torch.distributed.fsdp import FullyShardedDataParallel as FSDP\nfrom torch.distributed.fsdp.wrap import size_based_auto_wrap_policy\nimport functools\n\ntorch.cuda.set_device(rank)\ndevice = torch.device(f\"cuda:{rank}\")\n\n# Create model\nmodel = nn.Transformer(d_model=512, nhead=8, num_layers=24)  # Large model\n\n# Wrap with FSDP (parameters sharded across devices)\nauto_wrap_policy = functools.partial(\n    size_based_auto_wrap_policy,\n    min_num_params=10_000_000  # Wrap submodules >10M params\n)\n\nmodel = FSDP(\n    model,\n    auto_wrap_policy=auto_wrap_policy,\n    device_id=rank\n)\n\n# Training loop (same as DDP, but uses 8x less memory)\noptimizer = torch.optim.Adam(model.parameters(), lr=1e-4)\n\nfor batch in train_loader:\n    data = batch[0].to(device)\n    optimizer.zero_grad()\n    output = model(data)\n    loss = output.sum()  # Dummy loss\n    loss.backward()\n    optimizer.step()\n\n# Per-GPU memory: ~3GB instead of 24GB\n# Training speed: ~15-20% slower than DDP due to communication"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Megatron pipeline parallelism (simplified illustration)\nfrom torch import nn\n\nclass PipelineParallel(nn.Module):\n    def __init__(self, layers, world_size, rank):\n        super().__init__()\n        self.layers = layers\n        self.world_size = world_size\n        self.rank = rank\n        self.device = torch.device(f\"cuda:{rank}\")\n        \n    def forward(self, x, num_microbatches=4):\n        microbatch_size = x.shape[0] // num_microbatches\n        outputs = []\n        \n        for mb_idx in range(num_microbatches):\n            # Get microbatch\n            mb_start = mb_idx * microbatch_size\n            mb_end = (mb_idx + 1) * microbatch_size\n            microbatch = x[mb_start:mb_end]\n            \n            # Forward through layers on this device\n            for layer in self.layers:\n                microbatch = layer(microbatch)\n            \n            # Send to next device\n            if self.rank < self.world_size - 1:\n                next_rank = self.rank + 1\n                torch.distributed.send(microbatch, next_rank)\n            else:\n                outputs.append(microbatch)\n            \n            # Receive from previous device\n            if self.rank > 0 and mb_idx < num_microbatches - 1:\n                prev_rank = self.rank - 1\n                next_input = torch.zeros_like(microbatch)\n                torch.distributed.recv(next_input, prev_rank)\n                microbatch = next_input\n        \n        if outputs:\n            return torch.cat(outputs, dim=0)\n        return None\n\n# Distribute transformer layers across 4 GPUs\ntransformer = nn.Transformer(d_model=512, nhead=8, num_layers=24)\nlayers_per_gpu = [transformer.encoder.layers[i:i+6] for i in range(0, 24, 6)]\nmodel = PipelineParallel(layers_per_gpu[rank], world_size=4, rank=rank)"
        ]
      ]
    },
    {
