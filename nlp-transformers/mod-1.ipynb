      "source": [
        [
          "python",
          "text = \"Natural language processing is fascinating!\"\nwords = text.split()\nprint(words)\n# ['Natural', 'language', 'processing', 'is', 'fascinating!']"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import AutoTokenizer\n\ntokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\ntokens = tokenizer.tokenize(\"Natural language processing is fascinating!\")\nprint(tokens)\n# ['natural', 'language', 'processing', 'is', 'fascinating', '!']\n\n# Convert tokens to IDs\nids = tokenizer.convert_tokens_to_ids(tokens)\nprint(ids)\n# [3087, 2653, 3228, 2003, 7840, 999]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import pipeline\n\nsentiment_pipeline = pipeline(\"sentiment-analysis\")\nresult = sentiment_pipeline(\"I absolutely love this course!\")\nprint(result)\n# [{'label': 'POSITIVE', 'score': 0.9998}]\n\nresults = sentiment_pipeline([\n    \"This is terrible\",\n    \"The weather is nice\",\n    \"I'm not sure about this\"\n])\nfor text, pred in zip([\"terrible\", \"nice\", \"unsure\"], results):\n    print(f\"{text}: {pred['label']} ({pred['score']:.4f})\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import pipeline\n\nner = pipeline(\"ner\", aggregation_strategy=\"simple\")\ntext = \"Apple was founded by Steve Jobs and Steve Wozniak in Los Altos.\"\nentities = ner(text)\nfor entity in entities:\n    print(f\"{entity['word']}: {entity['entity_group']}\")\n# Apple: ORG\n# Steve Jobs: PER\n# Steve Wozniak: PER\n# Los Altos: LOC"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.feature_extraction.text import TfidfVectorizer\n\ndocuments = [\n    \"natural language processing is amazing\",\n    \"machine learning and deep learning\",\n    \"transformers and attention mechanisms\"\n]\n\nvectorizer = TfidfVectorizer()\ntfidf_matrix = vectorizer.fit_transform(documents)\n\n# Get feature names and scores for first document\nfeature_names = vectorizer.get_feature_names_out()\nscores = tfidf_matrix[0].toarray()[0]\n\nfor name, score in zip(feature_names, scores):\n    if score > 0:\n        print(f\"{name}: {score:.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from gensim.models import Word2Vec\n\nsentences = [\n    \"the king is a male ruler\".split(),\n    \"the queen is a female ruler\".split(),\n    \"prince is a male heir\".split(),\n]\n\nmodel = Word2Vec(sentences, min_count=1, vector_size=50)\nprint(model.wv['king'])  # 50-dimensional vector\n\n# Find similar words\nprint(model.wv.most_similar('king', topn=3))\n# [('queen', 0.87), ('prince', 0.73), ...]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import nltk\nfrom nltk.tokenize import word_tokenize, sent_tokenize\nfrom nltk.corpus import stopwords\n\nnltk.download('punkt')\nnltk.download('stopwords')\n\ntext = \"NLP is powerful. It enables amazing applications.\"\n\n# Sentence and word tokenization\nsentences = sent_tokenize(text)\nwords = word_tokenize(text)\n\n# Remove stopwords\nstop_words = set(stopwords.words('english'))\nfiltered = [w for w in words if w.lower() not in stop_words]\n\nprint(f\"Sentences: {sentences}\")\nprint(f\"Filtered words: {filtered}\")"
        ]
      ]
    }
