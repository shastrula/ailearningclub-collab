      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import pipeline, AutoTokenizer, AutoModelForTokenClassification\nimport torch\n\n# Load clinical NER model (specialized BERT for healthcare)\nmodel_name = \"Clinical-BERT-ner\"  # or fine-tuned BioBERT\ntokenizer = AutoTokenizer.from_pretrained(\"emilyalsentzer/clinicalBERT\")\nmodel = AutoModelForTokenClassification.from_pretrained(\n    \"emilyalsentzer/clinicalBERT\"\n)\n\n# Initialize NER pipeline\nner_pipeline = pipeline(\n    \"token-classification\",\n    model=model,\n    tokenizer=tokenizer,\n    aggregation_strategy=\"simple\"\n)\n\n# Clinical note example\nclinical_note = \"\"\"\nPatient presents with Type 2 Diabetes Mellitus. Started on Metformin 500mg BID.\nHistory of hypertension treated with Lisinopril. Chest X-ray shows no acute findings.\nReferred to cardiology for stress test evaluation.\n\"\"\"\n\n# Extract entities\nentities = ner_pipeline(clinical_note)\nfor entity in entities:\n    print(f\"{entity['word']}: {entity['entity_group']} (score: {entity['score']:.2f})\")\n\n# Output:\n# Type 2 Diabetes Mellitus: DIAGNOSIS (score: 0.96)\n# Metformin: MEDICATION (score: 0.94)\n# 500mg: DOSAGE (score: 0.92)\n# BID: FREQUENCY (score: 0.89)\n# Lisinopril: MEDICATION (score: 0.95)\n# cardiology: PROCEDURE (score: 0.87)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import pipeline\n\n# Load financial sentiment model\nfinbert = pipeline(\n    \"sentiment-analysis\",\n    model=\"ProsusAI/finbert\",\n    device=0  # GPU device\n)\n\n# Financial news samples\nearnings_examples = [\n    \"Our Q3 revenue exceeded analyst expectations by 15%.\",\n    \"Supply chain disruptions reduced profitability quarter-over-quarter.\",\n    \"We project 8% YoY growth and maintain our dividend.\",\n    \"Unexpected write-downs forced us to restate earnings.\"\n]\n\nfor text in earnings_examples:\n    result = finbert(text, truncation=True)\n    sentiment = result[0]\n    print(f\"Text: {text[:50]}...\")\n    print(f\"Sentiment: {sentiment['label']} ({sentiment['score']:.3f})\\n\")\n\n# Output:\n# Text: Our Q3 revenue exceeded analyst expectations by 15%.\n# Sentiment: Positive (0.987)\n#\n# Text: Supply chain disruptions reduced profitability q-o-q.\n# Sentiment: Negative (0.956)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sentence_transformers import SentenceTransformer, util\nimport torch\n\n# Load semantic search model\nmodel = SentenceTransformer('all-MiniLM-L6-v2')\n\n# Product catalog (embeddings cached at indexing time)\nproducts = [\n    {\"id\": 1, \"name\": \"Stainless Steel Water Bottle\", \"description\": \"Keeps drinks cold for 24 hours\"},\n    {\"id\": 2, \"name\": \"Hydration Jug\", \"description\": \"Large capacity container for outdoor activities\"},\n    {\"id\": 3, \"name\": \"Coffee Mug\", \"description\": \"Ceramic cup for hot beverages\"},\n    {\"id\": 4, \"name\": \"Insulated Tumbler\", \"description\": \"Thermos-like vessel for temperature retention\"}\n]\n\n# Pre-compute embeddings (done once during indexing)\nproduct_texts = [f\"{p['name']} {p['description']}\" for p in products]\nproduct_embeddings = model.encode(product_texts, convert_to_tensor=True)\n\n# Customer query\nquery = \"container that keeps water cold\"\nquery_embedding = model.encode(query, convert_to_tensor=True)\n\n# Semantic search\nhits = util.semantic_search(query_embedding, product_embeddings, top_k=2)\nfor hit in hits[0]:\n    product = products[hit['corpus_id']]\n    print(f\"Score: {hit['score']:.3f} - {product['name']}\")\n\n# Output:\n# Score: 0.756 - Stainless Steel Water Bottle\n# Score: 0.624 - Insulated Tumbler"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import pipeline\n\n# Intent classification\nintent_classifier = pipeline(\n    \"zero-shot-classification\",\n    model=\"facebook/bart-large-mnli\"\n)\n\n# Define support intents\nintents = [\n    \"refund_request\",\n    \"password_reset\",\n    \"shipping_status\",\n    \"product_return\",\n    \"billing_inquiry\"\n]\n\n# Customer messages\nmessages = [\n    \"I want to return my order from last week\",\n    \"How do I reset my password?\",\n    \"Where is my package? Order #12345\",\n    \"Why was I charged twice?\"\n]\n\nfor msg in messages:\n    result = intent_classifier(msg, intents, multi_class=False)\n    print(f\"Message: {msg}\")\n    print(f\"Intent: {result['labels'][0]} (confidence: {result['scores'][0]:.3f})\\n\")\n\n# Output:\n# Message: I want to return my order from last week\n# Intent: product_return (confidence: 0.94)\n#\n# Message: How do I reset my password?\n# Intent: password_reset (confidence: 0.97)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sentence_transformers import SentenceTransformer\nimport numpy as np\n\nmodel = SentenceTransformer('all-mpnet-base-v2')\n\n# Content corpus\narticles = [\n    {\"id\": 1, \"title\": \"Getting Started with PyTorch\", \"text\": \"Learn deep learning fundamentals...\"},\n    {\"id\": 2, \"title\": \"Advanced Python Decorators\", \"text\": \"Master functional programming patterns...\"},\n    {\"id\": 3, \"title\": \"Machine Learning in Production\", \"text\": \"Deploy models at scale...\"},\n    {\"id\": 4, \"title\": \"Building REST APIs with FastAPI\", \"text\": \"Create high-performance web services...\"}\n]\n\n# User profile (from reading history)\nuser_history = [\n    \"I recently learned PyTorch basics\",\n    \"I'm interested in deploying ML models\",\n    \"Web APIs are important for my work\"\n]\n\n# Encode user profile\nuser_text = \" \".join(user_history)\nuser_embedding = model.encode(user_text)\n\n# Encode articles\narticle_texts = [a[\"text\"] for a in articles]\narticle_embeddings = model.encode(article_texts)\n\n# Compute similarity scores\nsimilarities = np.dot(article_embeddings, user_embedding) / (\n    np.linalg.norm(article_embeddings, axis=1) * np.linalg.norm(user_embedding)\n)\n\n# Rank articles\nranked = sorted(zip(articles, similarities), key=lambda x: x[1], reverse=True)\nprint(\"Recommended articles:\")\nfor article, score in ranked[:2]:\n    print(f\"- {article['title']} (relevance: {score:.3f})\")\n\n# Output:\n# Recommended articles:\n# - Machine Learning in Production (relevance: 0.612)\n# - Building REST APIs with FastAPI (relevance: 0.587)"
        ]
      ]
    }
