          "python",
          "from transformers import AutoTokenizer\n\ntokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n\ntext = \"John Smith works at OpenAI in California\"\nencoding = tokenizer(\n    text,\n    return_offsets_mapping=True,\n    padding=True\n)\n\nprint(\"Tokens:\", tokenizer.convert_ids_to_tokens(encoding['input_ids']))\nprint(\"\\nCharacter offsets (start, end) for each token:\")\nfor token_id, (start, end) in zip(\n    encoding['input_ids'],\n    encoding['offset_mapping']\n):\n    token = tokenizer.convert_ids_to_tokens(token_id)\n    if start > 0:  # Skip [CLS]\n        char_span = text[start:end]\n        print(f\"Token: {token:15} | Span: ({start:2}, {end:2}) | Chars: '{char_span}'\")"
        ]
