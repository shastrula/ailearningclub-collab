          "python",
          "from tokenizers import Tokenizer\nfrom tokenizers.models import BPE\nfrom tokenizers.trainers import BpeTrainer\nfrom tokenizers.normalizers import Lowercase, NFD, StripAccents\nfrom tokenizers.pre_tokenizers import ByteLevel\n\n# Multilingual tokenizer using BPE\nmulti_tokenizer = Tokenizer(BPE())\nmulti_tokenizer.pre_tokenizer = ByteLevel()\n\n# Add normalization for accent handling\nmulti_tokenizer.normalizer = NFD()\n\n# Train on concatenated multilingual data\nfiles = [\n    \"data/english.txt\",\n    \"data/spanish.txt\",\n    \"data/french.txt\",\n    \"data/chinese.txt\",\n    \"data/arabic.txt\"\n]\n\ntrainer = BpeTrainer(\n    vocab_size=50000,\n    special_tokens=[\"[UNK]\", \"[CLS]\", \"[SEP]\", \"[PAD]\", \"[MASK]\"],\n    min_frequency=2\n)\n\nmulti_tokenizer.train(files, trainer)\n\n# Test on multilingual text\nmultilingual_samples = [\n    \"Hello world\",\n    \"Hola mundo\",\n    \"Bonjour le monde\",\n    \"\u4f60\u597d\u4e16\u754c\",\n    \"\u0645\u0631\u062d\u0628\u0627 \u0628\u0627\u0644\u0639\u0627\u0644\u0645\"\n]\n\nfor text in multilingual_samples:\n    tokens = multi_tokenizer.encode(text).tokens\n    print(f\"{text}: {len(tokens)} tokens - {tokens}\")"
        ]
      ]
    },
