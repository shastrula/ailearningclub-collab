          "python",
          "from tokenizers import Tokenizer\nfrom tokenizers.models import BPE\nfrom tokenizers.trainers import BpeTrainer\nfrom tokenizers.pre_tokenizers import ByteLevel\nfrom tokenizers.decoders import ByteLevel as ByteLevelDecoder\n\n# BPE tokenizer for code (better handling of special characters)\ncode_tokenizer = Tokenizer(BPE())\ncode_tokenizer.pre_tokenizer = ByteLevel()\ncode_tokenizer.decoder = ByteLevelDecoder()\n\n# Train on code corpus\ncode_trainer = BpeTrainer(\n    vocab_size=50000,\n    special_tokens=[\"[UNK]\", \"[CLS]\", \"[SEP]\", \"[PAD]\", \"[MASK]\"],\n    min_frequency=2\n)\n\n# Assuming code samples are in code_corpus.txt\ncode_tokenizer.train([\"code_corpus.txt\"], code_trainer)\n\n# Compare: generic vs domain-specific tokenizer\ntest_code = \"def calculate_fibonacci(n): return n if n <= 1 else fib(n-1) + fib(n-2)\"\n\nfrom transformers import AutoTokenizer\ngeneric_tokenizer = AutoTokenizer.from_pretrained(\"gpt2\")\ngeneric_tokens = generic_tokenizer.tokenize(test_code)\n\ncode_tokens = code_tokenizer.encode(test_code).tokens\n\nprint(f\"Generic tokenizer: {len(generic_tokens)} tokens\")\nprint(f\"Tokens: {generic_tokens[:15]}\")\nprint(f\"\\nDomain tokenizer: {len(code_tokens)} tokens\")\nprint(f\"Tokens: {code_tokens[:15]}\")"
        ]
      ]
    },
