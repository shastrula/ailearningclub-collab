          "python",
          "from transformers import AutoTokenizer\n\ntokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n\n# Add custom special tokens\nspecial_tokens_dict = {\n    'additional_special_tokens': [\n        '[ORGANIZATION]',\n        '[PERSON]',\n        '[LOCATION]',\n        '[DATE]',\n        '[MONEY]'\n    ]\n}\n\nnum_added_tokens = tokenizer.add_special_tokens(special_tokens_dict)\nprint(f\"Added {num_added_tokens} special tokens\")\n\n# You must resize model embeddings when adding tokens\n# This is crucial\u2014don't skip this step!\nmodel.resize_token_embeddings(len(tokenizer))\n\n# Test usage\ntext = \"[PERSON] John Smith [DATE] 2024-06-14\"\ntokens = tokenizer.tokenize(text)\nprint(f\"\\nTokens with custom special tokens:\")\nprint(tokens)\n\n# Get token IDs for the new special tokens\norg_id = tokenizer.convert_tokens_to_ids('[ORGANIZATION]')\nperson_id = tokenizer.convert_tokens_to_ids('[PERSON]')\nprint(f\"\\n[ORGANIZATION] ID: {org_id}\")\nprint(f\"[PERSON] ID: {person_id}\")"
