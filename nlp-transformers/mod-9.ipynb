          "python",
          "from transformers import AutoTokenizer\nimport collections\n\ntokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n\n# Get vocabulary size\nvocab_size = len(tokenizer)\nprint(f\"Vocabulary size: {vocab_size}\")\n\n# Get special tokens\nprint(f\"\\nSpecial tokens:\")\nprint(f\"  [CLS]: {tokenizer.cls_token_id}\")\nprint(f\"  [SEP]: {tokenizer.sep_token_id}\")\nprint(f\"  [PAD]: {tokenizer.pad_token_id}\")\nprint(f\"  [UNK]: {tokenizer.unk_token_id}\")\nprint(f\"  [MASK]: {tokenizer.mask_token_id}\")\n\n# Sample vocabulary\nprint(f\"\\nFirst 20 tokens in vocabulary:\")\nvocab = tokenizer.get_vocab()\nfor token_id in range(20):\n    token = tokenizer.convert_ids_to_tokens(token_id)\n    print(f\"  {token_id}: {token}\")\n\n# Analyze token distribution in your dataset\nfrom collections import Counter\n\ndef analyze_tokenization(texts, tokenizer):\n    \"\"\"Analyze token frequency distribution\"\"\"\n    all_tokens = []\n    all_chars = []\n    seq_lengths = []\n    \n    for text in texts:\n        tokens = tokenizer.tokenize(text)\n        all_tokens.extend(tokens)\n        all_chars.extend(list(text))\n        seq_lengths.append(len(tokens))\n    \n    token_freq = Counter(all_tokens)\n    \n    print(f\"\\nTokenization statistics:\")\n    print(f\"  Total tokens: {len(all_tokens)}\")\n    print(f\"  Unique tokens: {len(token_freq)}\")\n    print(f\"  Average sequence length: {sum(seq_lengths)/len(seq_lengths):.1f}\")\n    print(f\"  Max sequence length: {max(seq_lengths)}\")\n    print(f\"  Compression ratio: {len(all_chars) / len(all_tokens):.2f}x\")\n    \n    print(f\"\\nMost common tokens:\")\n    for token, count in token_freq.most_common(10):\n        print(f\"  {token}: {count}\")\n\n# Example\nsample_texts = [\n    \"The quick brown fox jumps over the lazy dog\",\n    \"Natural language processing is fascinating\",\n    \"Tokenization is a fundamental NLP task\"\n] * 10\n\nanalyze_tokenization(sample_texts, tokenizer)"
        ]
      ]
