          "python",
          "from transformers import AutoModelForCausalLM, AutoTokenizer\nimport torch\n\n# Load model and tokenizer\nmodel = AutoModelForCausalLM.from_pretrained(\"gpt2\")\ntokenizer = AutoTokenizer.from_pretrained(\"gpt2\")\n\nprint(f\"Initial model vocab size: {model.config.vocab_size}\")\nprint(f\"Initial tokenizer vocab size: {len(tokenizer)}\")\n\n# Add new special tokens\ntokenizer.add_special_tokens({\n    'additional_special_tokens': ['[DOMAIN]', '[ENTITY]', '[INTENT]']\n})\n\n# Resize embeddings to match new tokenizer\nmodel.resize_token_embeddings(len(tokenizer))\n\nprint(f\"\\nAfter adding tokens:\")\nprint(f\"Model vocab size: {model.config.vocab_size}\")\nprint(f\"Tokenizer vocab size: {len(tokenizer)}\")\n\n# Save updated tokenizer and model\ntokenizer.save_pretrained(\"./custom_tokenizer_model\")\nmodel.save_pretrained(\"./custom_tokenizer_model\")\n\n# Load later\nloaded_tokenizer = AutoTokenizer.from_pretrained(\"./custom_tokenizer_model\")\nloaded_model = AutoModelForCausalLM.from_pretrained(\"./custom_tokenizer_model\")"
