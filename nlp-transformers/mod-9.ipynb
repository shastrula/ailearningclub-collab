          "python",
          "from transformers import AutoTokenizer\n\n# Fast tokenizer (Rust-based)\nfast_tokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\nprint(f\"Tokenizer class: {fast_tokenizer.__class__.__name__}\")\n# Output: BertTokenizerFast (Fast version)\n\n# Some tokenizers also have slow (Python) versions\nslow_tokenizer = AutoTokenizer.from_pretrained(\n    \"bert-base-uncased\",\n    use_fast=False\n)\nprint(f\"Tokenizer class: {slow_tokenizer.__class__.__name__}\")\n# Output: BertTokenizer (Slow version)\n\n# Benchmark comparison\nimport time\n\ntext = \"The quick brown fox jumps over the lazy dog\" * 100\niterations = 1000\n\n# Fast tokenizer\nstart = time.time()\nfor _ in range(iterations):\n    fast_tokenizer.tokenize(text)\nfast_time = time.time() - start\n\n# Slow tokenizer\nstart = time.time()\nfor _ in range(iterations):\n    slow_tokenizer.tokenize(text)\nslow_time = time.time() - start\n\nprint(f\"\\nFast tokenizer: {fast_time:.3f}s\")\nprint(f\"Slow tokenizer: {slow_time:.3f}s\")\nprint(f\"Speedup: {slow_time/fast_time:.1f}x faster\")"
        ]
      ]
    },
