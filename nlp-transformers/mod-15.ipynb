          "python",
          "class DataConsentManager:\n    \"\"\"Track user consent for data usage\"\"\"\n    \n    def __init__(self):\n        self.consent_log = {}\n    \n    def request_consent(self, user_id: str, purposes: list) -> bool:\n        \"\"\"\n        Request explicit consent for data usage\n        Purposes: [\"training\", \"evaluation\", \"logging\", \"sharing\"]\n        \"\"\"\n        print(f\"User {user_id}: Requesting consent for:\")\n        for purpose in purposes:\n            print(f\"  - {purpose}\")\n        \n        # In real system: present UI, wait for user response\n        self.consent_log[user_id] = {\n            \"purposes\": purposes,\n            \"timestamp\": datetime.now().isoformat(),\n            \"status\": \"granted\",  # Would be from user interaction\n        }\n        return True\n    \n    def can_use_data(self, user_id: str, purpose: str) -> bool:\n        \"\"\"Check if we have consent for this purpose\"\"\"\n        if user_id not in self.consent_log:\n            return False\n        \n        consent = self.consent_log[user_id]\n        return purpose in consent[\"purposes\"]\n    \n    def withdraw_consent(self, user_id: str):\n        \"\"\"User right to be forgotten\"\"\"\n        if user_id in self.consent_log:\n            del self.consent_log[user_id]\n            print(f\"Deleted data for user {user_id}\")\n\n# Usage\nconsent_mgr = DataConsentManager()\nconsent_mgr.request_consent(\"user123\", [\"training\", \"evaluation\"])\nprint(f\"Can train: {consent_mgr.can_use_data('user123', 'training')}\")\nprint(f\"Can share: {consent_mgr.can_use_data('user123', 'sharing')}\")\nconsent_mgr.withdraw_consent(\"user123\")"
        ]
      ]
