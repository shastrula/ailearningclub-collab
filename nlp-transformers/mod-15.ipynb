      "source": [
        [
          "python",
          "from transformers import AutoTokenizer, AutoModelForMaskedLM\nimport torch\n\n# Load a model that may contain bias\nmodel_name = \"bert-base-uncased\"\ntokenizer = AutoTokenizer.from_pretrained(model_name)\nmodel = AutoModelForMaskedLM.from_pretrained(model_name)\n\n# Test 1: Stereotypical associations (Word Embeddings Association Test - WEAT)\ndef compute_bias_score(positive_words: list, negative_words: list, \n                       target_a: list, target_b: list):\n    \"\"\"\n    WEAT concept: \n    Do attributes (positive/negative words) associate more with target_a or target_b?\n    Higher score = target_a more associated with positive words\n    \"\"\"\n    \n    def get_embedding(word):\n        \"\"\"Get subword token embeddings\"\"\"\n        inputs = tokenizer.encode(word, return_tensors=\"pt\")\n        with torch.no_grad():\n            outputs = model(inputs, output_hidden_states=True)\n        return outputs.hidden_states[-1].mean(dim=1).squeeze().numpy()\n    \n    def cosine_similarity(a, b):\n        \"\"\"Compute cosine similarity\"\"\"\n        return (a @ b) / (np.linalg.norm(a) * np.linalg.norm(b) + 1e-8)\n    \n    # Embed all words\n    pos_embs = [get_embedding(w) for w in positive_words]\n    neg_embs = [get_embedding(w) for w in negative_words]\n    a_embs = [get_embedding(w) for w in target_a]\n    b_embs = [get_embedding(w) for w in target_b]\n    \n    # Compute bias: (avg sim to A pos - avg sim to A neg) - (avg sim to B pos - avg sim to B neg)\n    a_pos_sim = sum(cosine_similarity(a, p) for a in a_embs for p in pos_embs)\n    a_neg_sim = sum(cosine_similarity(a, n) for a in a_embs for n in neg_embs)\n    b_pos_sim = sum(cosine_similarity(b, p) for b in b_embs for p in pos_embs)\n    b_neg_sim = sum(cosine_similarity(b, n) for b in b_embs for n in neg_embs)\n    \n    score = (a_pos_sim - a_neg_sim) - (b_pos_sim - b_neg_sim)\n    return score\n\nimport numpy as np\n\npositive = [\"good\", \"excellent\", \"wonderful\"]\nnegative = [\"bad\", \"awful\", \"terrible\"]\nmale_words = [\"he\", \"man\", \"king\"]\nfemale_words = [\"she\", \"woman\", \"queen\"]\n\nscore = compute_bias_score(positive, negative, male_words, female_words)\nprint(f\"Gender bias score (positive\u2192higher=male bias): {score:.3f}\")\n# Negative score indicates female bias, positive indicates male bias\n\n# Test 2: Occupational stereotypes\noccupations_gender = {\n    \"programmer\": [\"male\", \"female\"],\n    \"nurse\": [\"female\", \"male\"],\n    \"ceo\": [\"male\", \"female\"],\n}\n\n# Check if model associates occupations with genders\nfor occupation, genders in occupations_gender.items():\n    target_a, target_b = genders\n    bias_score = compute_bias_score([\"male\"], [\"female\"], [occupation], [occupation])\n    print(f\"Occupation '{occupation}': bias score {bias_score:.3f}\")"
        ]
      ]
