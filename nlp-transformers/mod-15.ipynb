          "python",
          "def estimate_training_energy(\n    num_parameters: int,\n    training_duration_hours: float,\n    gpu_power_watts: float = 400,  # V100 default\n    num_gpus: int = 8,\n    efficiency_factor: float = 0.3  # 30% GPU utilization typical\n) -> dict:\n    \"\"\"Estimate energy consumption for training\"\"\"\n    \n    # Total power draw\n    total_power = gpu_power_watts * num_gpus / efficiency_factor\n    \n    # Energy = Power * Time\n    energy_kwh = (total_power / 1000) * training_duration_hours\n    \n    # CO2 emissions (US average: 0.39 kg CO2/kWh)\n    co2_kg = energy_kwh * 0.39\n    \n    # Cost (US average: $0.12/kWh)\n    cost_usd = energy_kwh * 0.12\n    \n    # Equivalents\n    flights_transatlantic = energy_kwh / 900  # ~900 kWh per flight\n    car_miles = energy_kwh / 0.25  # ~0.25 kWh per mile\n    \n    return {\n        \"energy_kwh\": energy_kwh,\n        \"co2_kg\": co2_kg,\n        \"cost_usd\": cost_usd,\n        \"flights_equivalent\": flights_transatlantic,\n        \"car_miles_equivalent\": car_miles,\n    }\n\n# Example: Training BERT-large (340M params, 3 days on 8x V100)\nimpact = estimate_training_energy(\n    num_parameters=340e6,\n    training_duration_hours=72,\n    num_gpus=8,\n)\n\nprint(\"Training impact:\")\nfor key, value in impact.items():\n    if key == \"energy_kwh\":\n        print(f\"  {key}: {value:,.0f} kWh\")\n    elif key == \"co2_kg\":\n        print(f\"  {key}: {value:,.0f} kg CO2 ({value/1000:.1f} metric tons)\")\n    elif key == \"cost_usd\":\n        print(f\"  {key}: ${value:,.0f}\")\n    elif \"equivalent\" in key:\n        print(f\"  {key}: {value:.1f}\")\n\n# Mitigation strategies\nstrategies = {\n    \"Model distillation\": \"Train smaller student model from large teacher\",\n    \"Pre-trained reuse\": \"Fine-tune existing models instead of training from scratch\",\n    \"Energy-efficient hardware\": \"TPUs/newer GPUs have 2-3x better efficiency\",\n    \"Mixed precision\": \"Use float16 instead of float32 (2x reduction)\",\n    \"Green energy\": \"Train on renewable-powered data centers\",\n}\n\nprint(\"\\nMitigation strategies:\")\nfor strategy, description in strategies.items():\n    print(f\"  {strategy}: {description}\")"
        ]
      ]
