          "python",
          "from dataclasses import dataclass\nfrom datetime import datetime\n\n@dataclass\nclass ModelCard:\n    \"\"\"Document model purpose, performance, limitations, and fairness\"\"\"\n    \n    model_name: str\n    model_version: str\n    creation_date: str\n    intended_use: str\n    training_data_description: str\n    known_limitations: list\n    fairness_metrics: dict\n    performance_metrics: dict\n    \n    def generate_report(self) -> str:\n        \"\"\"Generate human-readable model card\"\"\"\n        report = f\"\"\"\n# Model Card: {self.model_name} v{self.model_version}\n\n## Intended Use\n{self.intended_use}\n\n## Training Data\n{self.training_data_description}\n\n## Performance\n\"\"\"\n        for metric, value in self.performance_metrics.items():\n            report += f\"- {metric}: {value}\\n\"\n        \n        report += \"\\n## Fairness Assessment\\n\"\n        for group, metrics in self.fairness_metrics.items():\n            report += f\"- {group}: {metrics}\\n\"\n        \n        report += \"\\n## Known Limitations\\n\"\n        for limitation in self.known_limitations:\n            report += f\"- {limitation}\\n\"\n        \n        return report\n\n# Example usage\ncard = ModelCard(\n    model_name=\"Toxicity Detector\",\n    model_version=\"2.1\",\n    creation_date=datetime.now().isoformat(),\n    intended_use=\"Detect toxic comments in user-generated content for moderation\",\n    training_data_description=\"100M comments from Reddit (2010-2020)\",\n    known_limitations=[\n        \"Performs worse on slang and colloquial language\",\n        \"May not detect context-dependent toxicity\",\n        \"Gender bias detected: 5% lower accuracy on female-authored comments\",\n        \"Limited to English text\",\n    ],\n    fairness_metrics={\n        \"Gender gap (demographic parity)\": \"8%\",\n        \"Racial gap (equal opportunity)\": \"12%\",\n    },\n    performance_metrics={\n        \"Accuracy\": 0.92,\n        \"Precision\": 0.88,\n        \"Recall\": 0.85,\n    }\n)\n\nprint(card.generate_report())"
        ]
      ]
    },
