        [
          "python",
          "from transformers import pipeline\n\n# Few-shot learning with GPT-2 via prompt engineering\ngenerator = pipeline(\"text-generation\", model=\"gpt2\")\n\ndef few_shot_sentiment_classifier(text, examples=None):\n    \"\"\"Classify sentiment using few-shot prompting.\"\"\"\n    \n    if examples is None:\n        examples = [\n            (\"This movie was great!\", \"positive\"),\n            (\"I hated this film\", \"negative\"),\n            (\"It was okay, nothing special\", \"neutral\")\n        ]\n    \n    # Construct prompt with examples\n    prompt = \"Classify the sentiment of the text.\\n\\n\"\n    \n    for example_text, example_label in examples:\n        prompt += f\"Text: {example_text}\\nSentiment: {example_label}\\n\\n\"\n    \n    prompt += f\"Text: {text}\\nSentiment:\"\n    \n    # Generate completion\n    try:\n        output = generator(\n            prompt,\n            max_length=len(prompt.split()) + 5,\n            num_return_sequences=1,\n            temperature=0.1\n        )\n        completion = output[0][\"generated_text\"][len(prompt):]\n        return completion.strip().split()[0].lower()\n    except:\n        return \"neutral\"  # Fallback\n\n# Test few-shot classification\ntest_texts = [\n    \"This book was phenomenal\",\n    \"Absolutely terrible experience\",\n    \"It was fine, average product\"\n]\n\nprint(\"Few-Shot Sentiment Classification:\\n\")\nfor text in test_texts:\n    sentiment = few_shot_sentiment_classifier(text)\n    print(f\"Text: {text}\")\n    print(f\"Sentiment: {sentiment}\\n\")"
        ]
      ]
    },
