          "python",
          "from transformers import AutoTokenizer, AutoModelForSeq2SeqLM\nimport numpy as np\n\n# Simplified RAG example\nknowledge_base = {\n    \"einstein_nobel\": \"Einstein received the 1921 Nobel Prize in Physics 'for services to Theoretical Physics, and especially for the discovery of the law of the photoelectric effect'\",\n    \"newton_laws\": \"Newton's laws of motion are three fundamental laws of mechanics\",\n    \"quantum_mechanics\": \"Quantum mechanics is the branch of physics dealing with the behavior of matter and light on atomic and subatomic scales\"\n}\n\ndef retrieve_relevant_context(query, knowledge_base):\n    \"\"\"Simple retrieval: find best matching knowledge base entry.\"\"\"\n    \n    query_terms = set(query.lower().split())\n    best_key = None\n    best_score = 0\n    \n    for key, content in knowledge_base.items():\n        content_terms = set(content.lower().split())\n        overlap = len(query_terms & content_terms)\n        if overlap > best_score:\n            best_score = overlap\n            best_key = key\n    \n    return knowledge_base[best_key] if best_key else \"\"\n\ndef generate_answer_with_context(query):\n    \"\"\"Generate answer using retrieved context.\"\"\"\n    \n    context = retrieve_relevant_context(query, knowledge_base)\n    \n    prompt = f\"\"\"Based on the following context, answer the question.\n\nContext: {context}\n\nQuestion: {query}\n\nAnswer:\"\"\"\n    \n    print(f\"Query: {query}\")\n    print(f\"Retrieved context: {context[:100]}...\")\n    print(f\"Answer would be generated conditioned on this context.\\n\")\n\n# Test RAG\nqueries = [\n    \"What did Einstein win the Nobel Prize for?\",\n    \"Explain Newton's laws\",\n    \"What is quantum mechanics?\"\n]\n\nfor q in queries:\n    generate_answer_with_context(q)"
        ]
      ]
    },
    {
