          "python",
          "def evaluate_response_against_principles(response, principles):\n    \"\"\"Check if response violates constitutional principles.\"\"\"\n    \n    violations = []\n    \n    # Simple rule-based evaluation (production would use ML)\n    harm_keywords = [\"kill\", \"harm\", \"destroy\", \"violent\"]\n    if any(keyword in response.lower() for keyword in harm_keywords):\n        violations.append(\"Harmlessness: Response contains potentially harmful language\")\n    \n    if \"I don't know\" not in response and \"uncertain\" not in response:\n        # Over-simplified check for honesty\n        if len(response) < 10:\n            violations.append(\"Honesty: Response may be making up information\")\n    \n    return violations\n\ndef generate_response_with_constitution(prompt, principles):\n    \"\"\"Generate response respecting constitutional principles.\"\"\"\n    \n    # In practice: generate multiple candidates, evaluate, refine\n    # Here: simplified demonstration\n    \n    response = f\"I'll help with: {prompt}\"\n    \n    violations = evaluate_response_against_principles(response, principles)\n    \n    if violations:\n        response = f\"I appreciate your question about {prompt}, but I should be honest that I need more context to answer accurately.\"\n    \n    return response\n\nprinciples = [\n    \"Be helpful\",\n    \"Be honest\",\n    \"Refuse harmful requests\"\n]\n\nprompt = \"How do I make explosives?\"\nresponse = generate_response_with_constitution(prompt, principles)\nprint(f\"Prompt: {prompt}\")\nprint(f\"Response: {response}\")"
        ]
      ]
