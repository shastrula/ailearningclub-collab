      "source": [
        [
          "python",
          "from transformers import CLIPProcessor, CLIPModel\nfrom PIL import Image\nimport requests\n\n# Load CLIP model (trained on 400M image-text pairs)\nmodel = CLIPModel.from_pretrained(\"openai/clip-vit-base-patch32\")\nprocessor = CLIPProcessor.from_pretrained(\"openai/clip-vit-base-patch32\")\n\n# Image-text retrieval example\nimage_urls = [\n    \"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/Cat03.jpg/1200px-Cat03.jpg\",\n    \"https://upload.wikimedia.org/wikipedia/commons/thumb/2/26/YellowLabradorLooking_new.jpg/1200px-YellowLabradorLooking_new.jpg\"\n]\n\ntexts = [\"A dog\", \"A cat\", \"A bird flying\"]\n\ntry:\n    # Download images\n    images = [Image.open(requests.get(url, stream=True).raw) for url in image_urls[:1]]\nexcept:\n    # Fallback: create synthetic test case\n    print(\"Using demonstration mode (image download skipped)\")\n    images = None\n\nif images:\n    # Encode images and texts\n    inputs = processor(text=texts, images=images, return_tensors=\"pt\", padding=True)\n    \n    with torch.no_grad():\n        outputs = model(**inputs)\n        logits_per_image = outputs.logits_per_image\n        probs = logits_per_image.softmax(dim=1)\n    \n    print(\"Image-Text Matching Scores:\")\n    for img_idx, img_probs in enumerate(probs):\n        print(f\"\\nImage {img_idx + 1}:\")\n        for text_idx, score in enumerate(img_probs):\n            print(f\"  '{texts[text_idx]}': {score:.3f}\")\nelse:\n    print(\"CLIP enables zero-shot image classification and image-text matching\")\n    print(\"Common applications:\")\n    print(\"- Search images by natural language description\")\n    print(\"- Generate alt-text automatically\")\n    print(\"- Content recommendation across images and text\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import AutoTokenizer, AutoModelForSequenceClassification\nimport time\n\n# Standard BERT (full attention)\nbert_model = AutoModelForSequenceClassification.from_pretrained(\n    \"bert-base-uncased\", \n    num_labels=2\n)\nbert_tokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n\n# Efficient variant: DistilBERT (40% smaller, 60% faster)\ndistil_model = AutoModelForSequenceClassification.from_pretrained(\n    \"distilbert-base-uncased\",\n    num_labels=2\n)\ndistil_tokenizer = AutoTokenizer.from_pretrained(\"distilbert-base-uncased\")\n\ndef benchmark_inference(model, tokenizer, text, name):\n    \"\"\"Measure inference latency and model size.\"\"\"\n    \n    # Measure size\n    param_count = model.num_parameters()\n    \n    # Measure speed\n    inputs = tokenizer(text, return_tensors=\"pt\", max_length=512, truncation=True)\n    \n    start = time.time()\n    for _ in range(10):\n        with torch.no_grad():\n            outputs = model(**inputs)\n    elapsed = (time.time() - start) / 10\n    \n    print(f\"{name}:\")\n    print(f\"  Parameters: {param_count / 1e6:.1f}M\")\n    print(f\"  Latency: {elapsed * 1000:.1f}ms\")\n    print()\n\n# Test both models\nsample_text = \"This movie was absolutely fantastic! I loved every minute of it.\"\n\nbenchmark_inference(bert_model, bert_tokenizer, sample_text, \"BERT\")\nbenchmark_inference(distil_model, distil_tokenizer, sample_text, \"DistilBERT\")\n\n# Production guidance\nprint(\"Efficiency Trade-offs:\")\nprint(\"- DistilBERT: 60% faster, 40% smaller, ~2% accuracy loss\")\nprint(\"- Quantization (int8): 4x smaller, similar speed improvement\")\nprint(\"- Pruning: Gradually remove unimportant weights\")\nprint(\"- Mobile models (MobileBERT): Designed for edge devices\")"
        ]
      ]
    },
    {
