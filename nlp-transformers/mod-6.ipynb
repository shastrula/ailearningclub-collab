      "source": [
        "# Nlp Transformers - mod-6\n\n",
        "**Course:** nlp-transformers\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import AutoTokenizer\n\n# Load BERT tokenizer (uses WordPiece)\ntokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n\ntext = \"The quick brown fox jumps over the lazy dog\"\ntokens = tokenizer.tokenize(text)\nprint(\"Tokens:\", tokens)\n# Output: ['the', 'quick', 'brown', 'fox', 'jumps', 'over', 'the', 'lazy', 'dog']\n\n# With rare word\ntext_rare = \"The tokenizer is handling antihistamines correctly\"\ntokens_rare = tokenizer.tokenize(text_rare)\nprint(\"Tokens:\", tokens_rare)\n# Output: ['the', 'tokenizer', 'is', 'handling', 'anti', '##histamines', 'correctly']\n\n# Get token IDs (what the model actually processes)\ntoken_ids = tokenizer.convert_tokens_to_ids(tokens)\nprint(\"Token IDs:\", token_ids)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import GPT2Tokenizer\n\n# Load GPT2 tokenizer (uses BPE)\ntokenizer_gpt = GPT2Tokenizer.from_pretrained(\"gpt2\")\n\ntext = \"The GPT-2 tokenizer uses byte-pair encoding\"\ntokens_gpt = tokenizer_gpt.tokenize(text)\nprint(\"GPT-2 Tokens:\", tokens_gpt)\n# Output: ['The', '\u0120GP', 'T', '-', '2', '\u0120tokenizer', '\u0120uses', '\u0120byte', '-', 'pair', '\u0120encoding']\n\n# Encode to IDs\nencoded = tokenizer_gpt.encode(text)\nprint(\"Encoded:\", encoded)\n\n# Decode back to text\ndecoded = tokenizer_gpt.decode(encoded)\nprint(\"Decoded:\", decoded)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import AutoTokenizer\n\n# Load T5 tokenizer (uses SentencePiece)\ntokenizer_t5 = AutoTokenizer.from_pretrained(\"t5-small\")\n\ntext = \"SentencePiece handles punctuation,symbols&numbers123\"\ntokens_t5 = tokenizer_t5.tokenize(text)\nprint(\"T5/SentencePiece Tokens:\", tokens_t5)\n# Output: ['\u2581Sentence', 'Piece', '\u2581handles', '\u2581punctuation', ',', 'symbols', '&', 'numbers', '123']\n\n# The \u2581 symbol represents space in SentencePiece\nencoded_t5 = tokenizer_t5.encode(text)\nprint(\"Encoded:\", encoded_t5)\n\n# Decode\ndecoded_t5 = tokenizer_t5.decode(encoded_t5)\nprint(\"Decoded:\", decoded_t5)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import AutoTokenizer\n\ntokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n\n# Understanding special tokens\nprint(\"Special tokens:\")\nprint(f\"[CLS] ID: {tokenizer.cls_token_id}, Token: {tokenizer.cls_token}\")\nprint(f\"[SEP] ID: {tokenizer.sep_token_id}, Token: {tokenizer.sep_token}\")\nprint(f\"[PAD] ID: {tokenizer.pad_token_id}, Token: {tokenizer.pad_token}\")\nprint(f\"[UNK] ID: {tokenizer.unk_token_id}, Token: {tokenizer.unk_token}\")\nprint(f\"[MASK] ID: {tokenizer.mask_token_id}, Token: {tokenizer.mask_token}\")\n\n# Single sentence encoding\ntext = \"BERT handles special tokens\"\nencoded_single = tokenizer.encode(text, add_special_tokens=True)\ntokens_single = tokenizer.convert_ids_to_tokens(encoded_single)\nprint(\"\\nSingle sentence:\", tokens_single)\n# Output: ['[CLS]', 'bert', 'handles', 'special', 'tokens', '[SEP]']\n\n# Sentence pair encoding\ntext1 = \"This is sentence one\"\ntext2 = \"This is sentence two\"\nencoded_pair = tokenizer.encode_plus(text1, text2, add_special_tokens=True)\ntokens_pair = tokenizer.convert_ids_to_tokens(encoded_pair['input_ids'])\nprint(\"Sentence pair:\", tokens_pair)\n# Output: ['[CLS]', 'this', 'is', 'sentence', 'one', '[SEP]', 'this', 'is', 'sentence', 'two', '[SEP]']\n\n# Padding example\nsequences = tokenizer.batch_encode_plus(\n    [\"Short\", \"This is a much longer sentence\"],\n    padding=True,\n    add_special_tokens=True,\n    return_tensors=\"pt\"\n)\nprint(\"\\nPadded input IDs:\")\nprint(sequences['input_ids'])\nprint(\"Attention mask:\", sequences['attention_mask'])"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
