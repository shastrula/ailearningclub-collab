        [
          "python",
          "from transformers import AutoTokenizer\n\ntokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n\n# Out-of-vocabulary handling\noov_texts = [\n    \"The antidisestablishmentarianism debate continues\",\n    \"Pseudopseudohypoparathyroidism is a real medical term\",\n    \"Floccinaucinilicilification means estimating as worthless\"\n]\n\nfor text in oov_texts:\n    tokens = tokenizer.tokenize(text)\n    print(f\"Text: {text}\")\n    print(f\"Tokens: {tokens}\")\n    print()\n\n# Custom vocabulary with limited size\n# This demonstrates what happens with smaller vocab\ntext_complex = \"The telecommunications infrastructure needs modernization\"\ntokens = tokenizer.tokenize(text_complex)\nprint(f\"Standard tokenizer: {tokens}\")\n\n# No [UNK] tokens appear because subword tokenization covers everything"
        ]
      ]
    },
    {
      "cell_type": "code",
