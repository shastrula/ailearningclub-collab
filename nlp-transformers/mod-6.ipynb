        [
          "python",
          "from transformers import AutoTokenizer\nimport torch\n\ntokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n\n# Variable length sequences\ntexts = [\n    \"Short text\",\n    \"This is a much longer text that requires attention masking\",\n    \"Medium length\"\n]\n\n# Batch encode with padding\nencoded = tokenizer.batch_encode_plus(\n    texts,\n    padding=True,\n    truncation=True,\n    max_length=20,\n    add_special_tokens=True,\n    return_tensors=\"pt\"\n)\n\nprint(\"Input IDs shape:\", encoded['input_ids'].shape)\nprint(\"Attention mask shape:\", encoded['attention_mask'].shape)\nprint(\"\\nAttention mask:\")\nprint(encoded['attention_mask'])\n# The 0s mark padding positions that should be ignored\n\n# When passed to model:\n# model(input_ids=encoded['input_ids'], attention_mask=encoded['attention_mask'])\n# The model will ignore positions where mask=0"
        ]
      ]
    },
