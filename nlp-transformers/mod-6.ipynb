      "source": [
        [
          "python",
          "from transformers import AutoTokenizer\n\ntokenizers = {\n    \"BERT (WordPiece)\": AutoTokenizer.from_pretrained(\"bert-base-uncased\"),\n    \"GPT-2 (BPE)\": AutoTokenizer.from_pretrained(\"gpt2\"),\n    \"T5 (SentencePiece)\": AutoTokenizer.from_pretrained(\"t5-small\")\n}\n\n# Test texts\ntest_texts = [\n    \"The quick brown fox\",\n    \"Internationalization\",\n    \"Email: test@example.com\",\n    \"Numbers: 12345 and dates: 2024-06-14\"\n]\n\nfor text in test_texts:\n    print(f\"\\nText: {text}\")\n    print(\"-\" * 60)\n    for name, tokenizer in tokenizers.items():\n        tokens = tokenizer.tokenize(text)\n        token_count = len(tokens)\n        print(f\"{name:20} | Count: {token_count:3} | Tokens: {tokens}\")"
        ]
      ]
    }
