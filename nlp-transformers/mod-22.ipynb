        [
          "python",
          "from peft import PrefixTuningConfig, get_peft_model\nfrom transformers import AutoModelForSequenceClassification\n\nmodel = AutoModelForSequenceClassification.from_pretrained(\n    \"bert-base-uncased\", num_labels=3\n)\n\n# Prefix tuning configuration\nprefix_config = PrefixTuningConfig(\n    num_virtual_tokens=20,      # prefix length\n    task_type=\"SEQ_CLS\"\n)\n\nmodel = get_peft_model(model, prefix_config)\nprint(\"Trainable parameters:\", sum(p.numel() for p in model.parameters() if p.requires_grad))\n# Output: ~20 * 768 = 15,360 parameters\n\n# Adapter approach (alternative)\nfrom peft import AdapterConfig\n\nadapter_config = AdapterConfig(\n    reduction_factor=16,\n    adapter_type=\"bottleneck\"\n)\n\n# Add adapter to model\nmodel.add_adapter(\"sentiment_task\", adapter_config)\nmodel.train_adapter(\"sentiment_task\")  # Only train this adapter\nprint(f\"Adapter parameters: {sum(p.numel() for p in model.get_adapter('sentiment_task').parameters())}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nfrom torch import nn\nfrom transformers import AutoModel\n\nclass MultiTaskBERT(nn.Module):\n    def __init__(self, model_name, num_tasks):\n        super().__init__()\n        self.encoder = AutoModel.from_pretrained(model_name)\n        self.dropout = nn.Dropout(0.1)\n        \n        # Task-specific heads\n        self.sentiment_head = nn.Linear(768, 2)    # binary classification\n        self.toxicity_head = nn.Linear(768, 2)     # binary classification\n        self.intent_head = nn.Linear(768, 5)       # 5 intents\n        \n    def forward(self, input_ids, attention_mask):\n        # Shared encoder\n        pooled = self.encoder(input_ids, attention_mask).pooler_output\n        pooled = self.dropout(pooled)\n        \n        # Task-specific outputs\n        sentiment_logits = self.sentiment_head(pooled)\n        toxicity_logits = self.toxicity_head(pooled)\n        intent_logits = self.intent_head(pooled)\n        \n        return {\n            \"sentiment\": sentiment_logits,\n            \"toxicity\": toxicity_logits,\n            \"intent\": intent_logits\n        }\n\nmodel = MultiTaskBERT(\"bert-base-uncased\", num_tasks=3)\n\n# Training step with multiple tasks\ntexts = [\"This is great!\", \"You're terrible!\"]\nsentiment_labels = torch.tensor([1, 0])\ntoxicity_labels = torch.tensor([0, 1])\nintent_labels = torch.tensor([2, 1])\n\n# Encode\nfrom transformers import AutoTokenizer\ntokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\ninputs = tokenizer(texts, return_tensors=\"pt\", padding=True)\n\n# Forward pass\noutputs = model(**inputs)\n\n# Compute loss for each task and combine\nloss_fn = nn.CrossEntropyLoss()\nloss = (\n    loss_fn(outputs[\"sentiment\"], sentiment_labels) +\n    loss_fn(outputs[\"toxicity\"], toxicity_labels) +\n    loss_fn(outputs[\"intent\"], intent_labels)\n) / 3\n\nprint(f\"Combined loss: {loss.item():.4f}\")"
        ]
      ]
    },
