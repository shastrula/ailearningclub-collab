          "python",
          "import torch\nfrom torch import nn\n\ndef compute_fisher_matrix(model, dataloader, device):\n    \"\"\"Compute Fisher information matrix for important parameters.\"\"\"\n    fisher = {name: torch.zeros_like(p) for name, p in model.named_parameters()}\n    \n    for batch in dataloader:\n        model.zero_grad()\n        outputs = model(**batch)\n        loss = outputs.loss\n        loss.backward()\n        \n        for name, p in model.named_parameters():\n            if p.grad is not None:\n                fisher[name] += p.grad ** 2 / len(dataloader)\n    \n    return fisher\n\ndef ewc_loss(model, fisher, weight=0.4, previous_params=None):\n    \"\"\"Compute EWC regularization loss.\"\"\"\n    if previous_params is None:\n        return 0\n    \n    loss = 0\n    for name, p in model.named_parameters():\n        if name in fisher:\n            loss += (fisher[name] * (p - previous_params[name]) ** 2).sum()\n    \n    return weight * loss\n\n# Training on Task A\nmodel = AutoModelForSequenceClassification.from_pretrained(\"bert-base-uncased\")\n# ... train on task_a_dataloader ...\ntask_a_params = {name: p.detach().clone() for name, p in model.named_parameters()}\n\n# Compute importance\n# fisher_matrix = compute_fisher_matrix(model, task_a_dataloader, device)\n\n# Later: Fine-tune on Task B with EWC\n# During training on task_b:\n# loss_b = model_loss(task_b_batch)\n# loss_ewc = ewc_loss(model, fisher_matrix, previous_params=task_a_params)\n# total_loss = loss_b + loss_ewc\n# total_loss.backward()"
        ]
