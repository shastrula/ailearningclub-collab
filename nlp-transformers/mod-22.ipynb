          "python",
          "from torch.nn import functional as F\nimport torch\n\nclass DomainAdaptationModel(nn.Module):\n    def __init__(self, encoder, task_head, domain_head):\n        super().__init__()\n        self.encoder = encoder  # Shared feature extractor\n        self.task_head = task_head  # Task classifier\n        self.domain_head = domain_head  # Domain classifier (adversarial)\n        \n    def forward(self, x, domain_labels=None, alpha=1.0):\n        # Extract features\n        features = self.encoder(x)\n        \n        # Task prediction\n        task_logits = self.task_head(features)\n        \n        # Domain prediction (used for adversarial loss)\n        domain_logits = self.domain_head(features)\n        \n        losses = {}\n        if domain_labels is not None:\n            # Task loss\n            task_loss = F.cross_entropy(task_logits, domain_labels)\n            \n            # Adversarial domain loss (minimize to make features domain-invariant)\n            domain_loss = F.cross_entropy(domain_logits, domain_labels)\n            \n            # Total: maximize task accuracy while minimizing domain predictability\n            losses[\"task\"] = task_loss\n            losses[\"domain\"] = domain_loss\n            losses[\"total\"] = task_loss - alpha * domain_loss  # negative domain loss\n        \n        return task_logits, losses if domain_labels is not None else None\n\n# During training:\n# Alternate between:\n# 1. Minimize task loss (supervised on source data)\n# 2. Minimize adversarial domain loss (fool domain classifier on both source/target)"
        ]
