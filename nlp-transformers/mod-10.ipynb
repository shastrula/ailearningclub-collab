          "python",
          "import torch\nimport torch.nn.utils.prune as prune\nfrom transformers import AutoModelForSequenceClassification\n\nmodel = AutoModelForSequenceClassification.from_pretrained(\"bert-base-uncased\")\n\n# Unstructured pruning: remove 30% of weights from all linear layers\nparameters_to_prune = []\nfor name, module in model.named_modules():\n    if isinstance(module, torch.nn.Linear):\n        parameters_to_prune.append((module, 'weight'))\n\n# Apply magnitude pruning\nfor module, name in parameters_to_prune:\n    prune.l1_unstructured(module, name=name, amount=0.3)\n\n# Make pruning permanent (remove zero weights)\nfor module, name in parameters_to_prune:\n    prune.remove(module, name=name)\n\n# Count remaining non-zero parameters\ntotal_params = sum(p.numel() for p in model.parameters())\nnonzero_params = sum(p.count_nonzero().item() for p in model.parameters())\nsparsity = 100 * (1 - nonzero_params / total_params)\nprint(f\"Model sparsity: {sparsity:.1f}%\")\nprint(f\"Remaining parameters: {nonzero_params:,} / {total_params:,}\")\n\n# Fine-tune the pruned model\n# Pruning typically requires fine-tuning to recover accuracy\ntrainer = Trainer(\n    model=model,\n    args=training_args,\n    train_dataset=train_dataset,\n    eval_dataset=eval_dataset,\n)\ntrainer.train()"
        ]
