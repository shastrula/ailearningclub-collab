          "python",
          "import torch\nfrom torch.utils.checkpoint import checkpoint\nimport time\n\nmodel = AutoModelForSequenceClassification.from_pretrained(\"bert-base-uncased\")\ndevice = torch.device(\"cuda\")\nmodel.to(device)\n\n# Profile original model\ndef profile_model(model, batch_size=32, seq_len=128, iterations=100):\n    model.eval()\n    \n    # Warmup\n    dummy = {\n        'input_ids': torch.randint(0, 30522, (batch_size, seq_len)).to(device),\n        'attention_mask': torch.ones((batch_size, seq_len)).to(device),\n    }\n    with torch.no_grad():\n        for _ in range(10):\n            model(**dummy)\n    \n    # Memory measurement\n    torch.cuda.reset_peak_memory_stats()\n    with torch.no_grad():\n        model(**dummy)\n    memory_used = torch.cuda.max_memory_allocated() / 1e9\n    \n    # Throughput measurement\n    torch.cuda.synchronize()\n    start = time.time()\n    with torch.no_grad():\n        for _ in range(iterations):\n            model(**dummy)\n    torch.cuda.synchronize()\n    elapsed = time.time() - start\n    \n    throughput = (iterations * batch_size) / elapsed\n    \n    return {\n        'memory_gb': memory_used,\n        'throughput_samples_per_sec': throughput,\n        'latency_ms': (elapsed / iterations) * 1000\n    }\n\n# Original model\noriginal_stats = profile_model(model)\nprint(\"Original model:\")\nprint(f\"  Memory: {original_stats['memory_gb']:.2f} GB\")\nprint(f\"  Throughput: {original_stats['throughput_samples_per_sec']:.1f} samples/sec\")\nprint(f\"  Latency: {original_stats['latency_ms']:.1f} ms/batch\")\n\n# Optimized model (after quantization)\nquantized_model = torch.quantization.quantize_dynamic(\n    model,\n    {torch.nn.Linear},\n    dtype=torch.qint8\n)\nquantized_stats = profile_model(quantized_model)\nprint(\"\\nQuantized model:\")\nprint(f\"  Memory: {quantized_stats['memory_gb']:.2f} GB ({original_stats['memory_gb']/quantized_stats['memory_gb']:.1f}x reduction)\")\nprint(f\"  Throughput: {quantized_stats['throughput_samples_per_sec']:.1f} samples/sec ({quantized_stats['throughput_samples_per_sec']/original_stats['throughput_samples_per_sec']:.1f}x speedup)\")\nprint(f\"  Latency: {quantized_stats['latency_ms']:.1f} ms/batch\")"
        ]
