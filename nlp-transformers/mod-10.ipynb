          "python",
          "import torch\nfrom transformers import AutoModelForSequenceClassification\n\n# Load pre-trained model\nmodel = AutoModelForSequenceClassification.from_pretrained(\"bert-base-uncased\")\n\n# Dynamic quantization\nquantized_model = torch.quantization.quantize_dynamic(\n    model,\n    {torch.nn.Linear},  # Quantize linear layers\n    dtype=torch.qint8\n)\n\n# Check size reduction\nimport os\n\noriginal_size = sum(\n    os.path.getsize(f\"pretrained_model/{f}\") \n    for f in os.listdir(\"pretrained_model\") \n    if f.endswith('.bin')\n)\n\ntorch.save(quantized_model.state_dict(), \"quantized_model.pt\")\nquantized_size = os.path.getsize(\"quantized_model.pt\")\n\nprint(f\"Original model size: {original_size / 1e6:.1f} MB\")\nprint(f\"Quantized model size: {quantized_size / 1e6:.1f} MB\")\nprint(f\"Compression ratio: {original_size / quantized_size:.2f}x\")\n\n# Benchmark inference speed\nimport time\n\nmodel.eval()\nquantized_model.eval()\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nmodel.to(device)\nquantized_model.to(device)\n\ntest_input = {\n    'input_ids': torch.randint(0, 30522, (32, 128)),  # BERT vocab size\n    'attention_mask': torch.ones((32, 128))\n}\ntest_input = {k: v.to(device) for k, v in test_input.items()}\n\n# Time original model\nwith torch.no_grad():\n    start = time.time()\n    for _ in range(100):\n        model(**test_input)\n    original_time = time.time() - start\n\n# Time quantized model\nwith torch.no_grad():\n    start = time.time()\n    for _ in range(100):\n        quantized_model(**test_input)\n    quantized_time = time.time() - start\n\nprint(f\"\\nInference time (100 batches):\")\nprint(f\"Original: {original_time:.2f}s\")\nprint(f\"Quantized: {quantized_time:.2f}s\")\nprint(f\"Speedup: {original_time / quantized_time:.2f}x\")"
        ]
      ]
