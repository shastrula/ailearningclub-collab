          "python",
          "import torch\n\ndef predict_sentiment(text, model, tokenizer, device, id2label=None):\n    \"\"\"Make a prediction on new text\"\"\"\n    model.eval()\n    \n    # Tokenize input\n    inputs = tokenizer(\n        text,\n        truncation=True,\n        max_length=512,\n        return_tensors=\"pt\",\n        padding=True\n    )\n    inputs = {k: v.to(device) for k, v in inputs.items()}\n    \n    # Get predictions\n    with torch.no_grad():\n        outputs = model(**inputs)\n        logits = outputs.logits\n    \n    # Get class and confidence\n    class_id = torch.argmax(logits, dim=-1).item()\n    confidence = torch.softmax(logits, dim=-1).max().item()\n    \n    class_name = id2label[class_id] if id2label else class_id\n    \n    return {\n        \"text\": text,\n        \"predicted_class\": class_name,\n        \"confidence\": confidence,\n        \"all_probabilities\": torch.softmax(logits, dim=-1)[0].cpu().numpy()\n    }\n\n# Example usage\nid2label = {0: \"negative\", 1: \"positive\"}\ntest_texts = [\n    \"This movie was absolutely amazing!\",\n    \"Terrible waste of time, very disappointed\",\n    \"It was okay, nothing special\"\n]\n\nfor text in test_texts:\n    result = predict_sentiment(text, model, tokenizer, device, id2label)\n    print(f\"Text: {result['text']}\")\n    print(f\"Prediction: {result['predicted_class']}\")\n    print(f\"Confidence: {result['confidence']:.4f}\\n\")"
        ]
      ]
    }
