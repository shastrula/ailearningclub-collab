          "python",
          "from fastapi import FastAPI\nfrom pydantic import BaseModel\nimport uvicorn\n\napp = FastAPI()\n\n# Load model\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nmodel = AutoModelForSequenceClassification.from_pretrained(\n    \"distilbert-base-uncased\",\n    num_labels=5\n)\n# Load LoRA weights\nmodel = PeftModel.from_pretrained(model, \"model_lora/checkpoint\")\nmodel.to(device)\nmodel.eval()\n\ntokenizer = AutoTokenizer.from_pretrained(\"distilbert-base-uncased\")\n\nclass SupportMessage(BaseModel):\n    message: str\n    customer_id: str\n\nclass ClassificationResponse(BaseModel):\n    customer_id: str\n    intent: str\n    confidence: float\n    should_auto_respond: bool\n    response: str = \"\"\n\nINTENT_RESPONSES = {\n    \"password_reset\": \"You can reset your password by clicking 'Forgot Password' on the login page.\",\n    \"shipping_status\": \"Check your order status at ailearningclub.com/orders. Tracking: {order_id}\",\n    \"refund_request\": \"Refund requests require agent review. An agent will contact you within 2 hours.\",\n    \"billing_inquiry\": \"Please check your invoice email. Contact support@ailearningclub.com for questions.\",\n    \"product_return\": \"Returns accepted within 30 days. Visit the returns portal to initiate.\"\n}\n\nCONFIDENCE_THRESHOLD = 0.85\n\n@app.post(\"/classify\", response_model=ClassificationResponse)\nasync def classify_message(msg: SupportMessage):\n    # Tokenize\n    inputs = tokenizer(\n        msg.message,\n        return_tensors=\"pt\",\n        truncation=True,\n        max_length=128,\n        padding=True\n    ).to(device)\n    \n    # Predict\n    with torch.no_grad():\n        outputs = model(**inputs)\n        logits = outputs.logits\n    \n    pred_id = torch.argmax(logits, dim=-1).item()\n    confidence = torch.softmax(logits, dim=-1).max().item()\n    intent = id_to_intent[pred_id]\n    \n    # Decision logic\n    should_auto_respond = confidence >= CONFIDENCE_THRESHOLD\n    response = INTENT_RESPONSES.get(intent, \"\") if should_auto_respond else \"\"\n    \n    return ClassificationResponse(\n        customer_id=msg.customer_id,\n        intent=intent,\n        confidence=round(confidence, 4),\n        should_auto_respond=should_auto_respond,\n        response=response\n    )\n\n@app.get(\"/health\")\ndef health_check():\n    return {\"status\": \"ok\"}\n\n# Launch: uvicorn script:app --host 0.0.0.0 --port 8000 --workers 4"
        ]
      ]
