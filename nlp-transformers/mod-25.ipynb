          "python",
          "from sklearn.metrics import classification_report, confusion_matrix\nimport matplotlib.pyplot as plt\n\n# Test set evaluation\nmodel.eval()\npredictions = []\ntrue_labels = []\nconfidences = []\n\nwith torch.no_grad():\n    for input_ids, attention_mask, labels in DataLoader(\n        prepare_dataset(test_data), batch_size=32\n    ):\n        input_ids = input_ids.to(device)\n        attention_mask = attention_mask.to(device)\n        \n        outputs = model(input_ids=input_ids, attention_mask=attention_mask)\n        logits = outputs.logits\n        \n        preds = torch.argmax(logits, dim=-1)\n        confs = torch.softmax(logits, dim=-1).max(dim=-1).values\n        \n        predictions.extend(preds.cpu().numpy())\n        confidences.extend(confs.cpu().numpy())\n        true_labels.extend(labels.numpy())\n\npredictions = np.array(predictions)\ntrue_labels = np.array(true_labels)\nconfidences = np.array(confidences)\n\n# Per-intent metrics\nprint(\"\\nPer-Intent Performance:\")\nprint(classification_report(\n    true_labels,\n    predictions,\n    target_names=[id_to_intent[i] for i in range(5)],\n    digits=4\n))\n\n# Output:\n#                    precision    recall  f1-score\n# refund_request        0.9231    0.9143    0.9187\n# password_reset        0.9167    0.9259    0.9213\n# shipping_status       0.9355    0.9268    0.9311\n# billing_inquiry       0.8889    0.9000    0.8944\n# product_return        0.8970    0.8889    0.8929\n\n# Confidence analysis\nprint(\"\\nConfidence distribution by correctness:\")\ncorrect_mask = predictions == true_labels\nprint(f\"Mean confidence (correct): {confidences[correct_mask].mean():.4f}\")\nprint(f\"Mean confidence (incorrect): {confidences[~correct_mask].mean():.4f}\")\n\n# Choose threshold where false positives are acceptable\nthreshold = 0.85\nfp_mask = (confidences >= threshold) & (predictions != true_labels)\nfp_rate = fp_mask.sum() / (predictions != true_labels).sum()\nprint(f\"\\nFalse positive rate at threshold {threshold}: {fp_rate:.4f}\")"
        ]
      ]
