          "python",
          "from prometheus_client import Counter, Histogram, start_http_server\nimport time\n\n# Metrics\nrequest_count = Counter(\n    'support_requests_total',\n    'Total requests',\n    ['intent']\n)\nprediction_confidence = Histogram(\n    'prediction_confidence',\n    'Confidence distribution'\n)\nauto_response_rate = Counter(\n    'auto_responses_total',\n    'Auto-responded requests',\n    ['intent', 'outcome']  # outcome: success, escalated\n)\ninference_latency = Histogram(\n    'inference_latency_seconds',\n    'Inference latency'\n)\n\n# In classification endpoint\nstart_time = time.time()\noutputs = model(**inputs)\nlatency = time.time() - start_time\n\ninference_latency.observe(latency)\nrequest_count.labels(intent=intent).inc()\nprediction_confidence.observe(confidence)\n\nif should_auto_respond:\n    # Track auto-response (later: check if escalated by agent)\n    auto_response_rate.labels(intent=intent, outcome='success').inc()\n\n# Deploy with traffic split\n# 95% \u2192 Old system (human agents only)\n#  5% \u2192 New system (classification + auto-response)\n#\n# Monitor for 2 weeks, check:\n# - Auto-response accuracy vs agent decisions\n# - Customer satisfaction (CSAT) scores\n# - Agent time saved\n# - False positive rate\n#\n# If metrics OK, increase to 25%, then 100%"
        ]
