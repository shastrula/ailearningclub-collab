          "python",
          "# Monitoring example\nfrom prometheus_client import Counter, Gauge, Histogram, push_to_gateway\n\n# Track per-intent accuracy\nintent_accuracy = Gauge(\n    'intent_accuracy_per_class',\n    'Accuracy per intent class',\n    ['intent']\n)\n\n# Track business metrics\nauto_response_cost_saved = Counter(\n    'auto_response_cost_saved_dollars',\n    'Cost saved by auto-responses'\n)\n\n# Track system health\nmodel_inference_latency = Histogram(\n    'model_inference_latency_ms',\n    'Inference latency in milliseconds'\n)\n\n# During inference\nstart = time.time()\nprediction = classify(message)\nlatency = (time.time() - start) * 1000\n\nmodel_inference_latency.observe(latency)\n\n# Periodically push metrics to monitoring system\npush_to_gateway(\n    'monitoring.internal:9091',\n    job='support-classifier',\n    registry=REGISTRY\n)"
