          "python",
          "# Model versioning system\nimport json\nfrom datetime import datetime\n\nclass ModelVersionManager:\n    def __init__(self, models_dir=\"models\"):\n        self.models_dir = models_dir\n        self.manifest_file = f\"{models_dir}/manifest.json\"\n        self.load_manifest()\n    \n    def load_manifest(self):\n        \"\"\"Load version history.\"\"\"\n        try:\n            with open(self.manifest_file) as f:\n                self.manifest = json.load(f)\n        except FileNotFoundError:\n            self.manifest = {\n                \"current_version\": None,\n                \"versions\": {}\n            }\n    \n    def register_model(self, model_path, metrics):\n        \"\"\"Register new trained model.\"\"\"\n        version = len(self.manifest[\"versions\"]) + 1\n        self.manifest[\"versions\"][version] = {\n            \"path\": model_path,\n            \"timestamp\": datetime.now().isoformat(),\n            \"metrics\": metrics,\n            \"status\": \"candidate\"  # candidate, testing, production, deprecated\n        }\n        self.save_manifest()\n        return version\n    \n    def promote_version(self, version):\n        \"\"\"Promote version to production.\"\"\"\n        old_version = self.manifest[\"current_version\"]\n        self.manifest[\"current_version\"] = version\n        self.manifest[\"versions\"][version][\"status\"] = \"production\"\n        if old_version:\n            self.manifest[\"versions\"][old_version][\"status\"] = \"deprecated\"\n        self.save_manifest()\n    \n    def rollback_version(self):\n        \"\"\"Rollback to previous production version.\"\"\"\n        current = self.manifest[\"current_version\"]\n        # Find most recent non-current production version\n        versions = sorted(\n            [v for v in self.manifest[\"versions\"] \n             if v < current],\n            reverse=True\n        )\n        if versions:\n            self.promote_version(versions[0])\n            return versions[0]\n        return None\n    \n    def save_manifest(self):\n        with open(self.manifest_file, \"w\") as f:\n            json.dump(self.manifest, f, indent=2)\n\n# Usage\nversioner = ModelVersionManager()\nv5_path = \"models/v5_checkpoint\"\nversioner.register_model(v5_path, {\n    \"accuracy\": 0.9245,\n    \"f1_macro\": 0.9231,\n    \"inference_latency_ms\": 45\n})\n# After A/B test validates v5: versioner.promote_version(5)\n# If issues: versioner.rollback_version()"
        ]
