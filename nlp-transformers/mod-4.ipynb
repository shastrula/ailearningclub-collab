          "python",
          "# Different return formats\ninputs = tokenizer(text, return_tensors=\"pt\")      # PyTorch tensors\ninputs = tokenizer(text, return_tensors=\"tf\")      # TensorFlow tensors\ninputs = tokenizer(text, return_tensors=\"np\")      # NumPy arrays"
