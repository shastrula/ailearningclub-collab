      "source": [
        [
          "python",
          "from transformers import pipeline\nimport torch\n\n# Batch processing with pipeline\nsentiment = pipeline(\"sentiment-analysis\", device=0)\n\ntexts = [\n    \"I absolutely love this!\",\n    \"This is terrible\",\n    \"It's okay, nothing special\",\n    \"Best purchase ever!\",\n    \"Worst experience of my life\"\n]\n\n# Process entire batch at once\nresults = sentiment(texts, batch_size=2)\n\nfor text, result in zip(texts, results):\n    print(f\"{text:30} \u2192 {result['label']:8} ({result['score']:.4f})\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "tokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\nmodel = AutoModelForSequenceClassification.from_pretrained(\"bert-base-uncased\")\n\ntexts = [\"Great movie!\", \"Terrible book\", \"Amazing experience\"]\n\n# Tokenize batch\ninputs = tokenizer(texts, padding=True, truncation=True, return_tensors=\"pt\")\n\n# Inference\nwith torch.no_grad():\n    outputs = model(**inputs)\n\nlogits = outputs.logits\npredictions = torch.softmax(logits, dim=-1)\n\nfor text, pred in zip(texts, predictions):\n    print(f\"{text:20} \u2192 Positive: {pred[1]:.4f}, Negative: {pred[0]:.4f}\")"
        ]
      ]
