      "source": [
        [
          "python",
          "from transformers import AutoModelForSequenceClassification\n\n# Load different BERT variants\nmodels_to_try = [\n    \"bert-base-uncased\",\n    \"distilbert-base-uncased\",\n    \"roberta-base\",\n    \"albert-base-v2\"\n]\n\nfor model_name in models_to_try:\n    model = AutoModelForSequenceClassification.from_pretrained(model_name)\n    param_count = sum(p.numel() for p in model.parameters())\n    print(f\"{model_name:25} - Parameters: {param_count:,}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import pipeline, AutoTokenizer, AutoModelForSequenceClassification\nimport torch\n\n# Simple approach: use pre-fine-tuned model\nsentiment_pipe = pipeline(\n    \"sentiment-analysis\",\n    model=\"distilbert-base-uncased-finetuned-sst-2-english\"\n)\n\nreviews = [\n    \"This product is amazing! Highly recommend.\",\n    \"Terrible quality. Broke after one day.\",\n    \"It's okay, nothing special.\",\n]\n\nresults = sentiment_pipe(reviews)\nfor review, result in zip(reviews, results):\n    print(f\"'{review}'\")\n    print(f\"  \u2192 {result['label']} ({result['score']:.4f})\\n\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.metrics.pairwise import cosine_similarity\n\n# Get sentence embeddings\nsentences = [\n    \"I love this movie\",\n    \"This film is great\",\n    \"The weather is nice today\"\n]\n\nembeddings = []\nfor sentence in sentences:\n    inputs = tokenizer(sentence, return_tensors=\"pt\")\n    with torch.no_grad():\n        outputs = model(**inputs)\n    # Use [CLS] token representation\n    embedding = outputs.pooler_output\n    embeddings.append(embedding.squeeze().numpy())\n\n# Compute similarity\nsimilarity = cosine_similarity([embeddings[0]], [embeddings[1], embeddings[2]])\nprint(f\"Similarity to 'I love this movie':\")\nprint(f\"  'This film is great': {similarity[0][0]:.4f}\")\nprint(f\"  'Weather is nice': {similarity[0][1]:.4f}\")"
        ]
      ]
    }
