      "source": [
        "# Nlp Transformers - mod-3\n\n",
        "**Course:** nlp-transformers\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import AutoTokenizer, AutoModel\nimport torch\n\n# Load BERT\ntokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\nmodel = AutoModel.from_pretrained(\"bert-base-uncased\")\n\n# Tokenize and get representations\ntext = \"The quick brown fox jumps over the lazy dog\"\ninputs = tokenizer(text, return_tensors=\"pt\", padding=True, truncation=True)\n\n# Get BERT output\nwith torch.no_grad():\n    outputs = model(**inputs)\n\n# Last hidden state: [batch_size, seq_len, hidden_size]\nlast_hidden_state = outputs.last_hidden_state\nprint(f\"Output shape: {last_hidden_state.shape}\")  # [1, 11, 768]\n\n# Pooled output: [batch_size, hidden_size]\n# Representation of [CLS] token, used for classification\npooled_output = outputs.pooler_output\nprint(f\"Pooled shape: {pooled_output.shape}\")  # [1, 768]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Example: How MLM pre-training works\nfrom transformers import pipeline\n\nfill_mask = pipeline(\"fill-mask\", model=\"bert-base-uncased\")\n\nmasked_text = \"The cat [MASK] on the mat\"\npredictions = fill_mask(masked_text)\n\nfor pred in predictions[:3]:\n    print(f\"{pred['token_str']:10} - confidence: {pred['score']:.4f}\")\n# sat        - confidence: 0.8234\n# sits       - confidence: 0.1012\n# lay        - confidence: 0.0234"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "input_ids = torch.tensor([[101, 1996, 4251, 102]])  # [CLS] the cat [SEP]\ntoken_type_ids = torch.tensor([[0, 0, 0, 0]])\nposition_ids = torch.tensor([[0, 1, 2, 3]])\n\n# Embeddings are combined\n# token_embedding + segment_embedding + position_embedding"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import AutoModelForSequenceClassification, TrainingArguments, Trainer\nfrom datasets import load_dataset\n\n# Load pre-trained BERT\nmodel = AutoModelForSequenceClassification.from_pretrained(\n    \"bert-base-uncased\",\n    num_labels=2  # Binary classification\n)\n\n# Load dataset\ndataset = load_dataset(\"imdb\")\n\n# Tokenize\ntokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\ndef tokenize_function(examples):\n    return tokenizer(examples[\"text\"], padding=\"max_length\", truncation=True)\n\ntokenized_datasets = dataset.map(tokenize_function, batched=True)\n\n# Fine-tune\ntraining_args = TrainingArguments(\n    output_dir=\"./results\",\n    num_train_epochs=3,\n    per_device_train_batch_size=16,\n    learning_rate=2e-5,\n)\n\ntrainer = Trainer(\n    model=model,\n    args=training_args,\n    train_dataset=tokenized_datasets[\"train\"],\n    eval_dataset=tokenized_datasets[\"test\"],\n)\n\ntrainer.train()"
        ]
      ]
    },
    {
      "cell_type": "code",
