          "python",
          "import time\nfrom collections import defaultdict\n\nclass PipelineMonitor:\n    \"\"\"Track pipeline performance metrics.\"\"\"\n    \n    def __init__(self):\n        self.latencies = []\n        self.predictions = defaultdict(int)\n        self.errors = 0\n        self.start_time = time.time()\n    \n    def record_prediction(self, prediction: str, latency_ms: float):\n        \"\"\"Record successful prediction.\"\"\"\n        self.latencies.append(latency_ms)\n        self.predictions[prediction] += 1\n    \n    def record_error(self):\n        \"\"\"Record error.\"\"\"\n        self.errors += 1\n    \n    def get_metrics(self) -> Dict:\n        \"\"\"Compute performance metrics.\"\"\"\n        \n        if not self.latencies:\n            return {}\n        \n        latencies_sorted = sorted(self.latencies)\n        n = len(latencies_sorted)\n        \n        elapsed_seconds = time.time() - self.start_time\n        total_requests = n + self.errors\n        \n        return {\n            \"throughput_rps\": total_requests / elapsed_seconds,\n            \"latency_ms\": {\n                \"mean\": sum(self.latencies) / n,\n                \"p50\": latencies_sorted[n // 2],\n                \"p95\": latencies_sorted[int(n * 0.95)],\n                \"p99\": latencies_sorted[int(n * 0.99)]\n            },\n            \"error_rate\": self.errors / total_requests if total_requests > 0 else 0,\n            \"predictions\": dict(self.predictions),\n            \"total_requests\": total_requests\n        }\n\n# Simulate pipeline monitoring\nmonitor = PipelineMonitor()\n\nfor i in range(100):\n    latency = 15 + (i % 20)  # Simulate variable latency\n    prediction = \"positive\" if i % 3 == 0 else \"negative\"\n    \n    monitor.record_prediction(prediction, latency)\n    if i % 20 == 0:\n        monitor.record_error()\n\nmetrics = monitor.get_metrics()\nprint(\"Pipeline Metrics:\")\nprint(f\"  Throughput: {metrics['throughput_rps']:.2f} req/s\")\nprint(f\"  Latency (ms):\")\nprint(f\"    Mean: {metrics['latency_ms']['mean']:.1f}\")\nprint(f\"    P95: {metrics['latency_ms']['p95']:.1f}\")\nprint(f\"    P99: {metrics['latency_ms']['p99']:.1f}\")\nprint(f\"  Error rate: {metrics['error_rate']:.2%}\")\nprint(f\"  Total requests: {metrics['total_requests']}\")"
        ]
      ]
