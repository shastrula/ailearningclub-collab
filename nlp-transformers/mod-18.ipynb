          "python",
          "import spacy\nfrom transformers import pipeline as hf_pipeline\nfrom spacy.language import Language\n\n# Load spaCy model\nnlp = spacy.load(\"en_core_web_sm\")\n\n# Register custom transformer component\n@Language.component(\"transformer_sentiment\")\ndef transformer_sentiment(doc):\n    \"\"\"Add transformer-based sentiment to spaCy doc.\"\"\"\n    \n    # Use transformer for sentence-level sentiment\n    sentiment_pipe = hf_pipeline(\"sentiment-analysis\")\n    \n    for sent in doc.sents:\n        try:\n            result = sentiment_pipe(sent.text)[0]\n            sent._.sentiment = result[\"label\"]\n            sent._.sentiment_score = result[\"score\"]\n        except Exception as e:\n            sent._.sentiment = \"neutral\"\n            sent._.sentiment_score = 0.0\n    \n    return doc\n\n# Add custom attributes\nif not spacy.util.has_attr(spacy.tokens.Span, \"sentiment\"):\n    spacy.tokens.Span.set_extension(\"sentiment\", default=None)\n    spacy.tokens.Span.set_extension(\"sentiment_score\", default=0.0)\n\n# Create combined pipeline\nnlp.add_pipe(\"transformer_sentiment\", last=True)\n\ndef analyze_text_with_spacy_transformers(text: str) -> Dict:\n    \"\"\"Analyze text using spaCy + transformers.\"\"\"\n    \n    doc = nlp(text)\n    \n    analysis = {\n        \"text\": text,\n        \"entities\": [],\n        \"sentences\": []\n    }\n    \n    # Extract entities using spaCy\n    for ent in doc.ents:\n        analysis[\"entities\"].append({\n            \"text\": ent.text,\n            \"label\": ent.label_,\n            \"start\": ent.start_char,\n            \"end\": ent.end_char\n        })\n    \n    # Extract sentences with transformer sentiment\n    for sent in doc.sents:\n        sent_data = {\n            \"text\": sent.text,\n            \"sentiment\": getattr(sent._, \"sentiment\", \"unknown\"),\n            \"sentiment_score\": getattr(sent._, \"sentiment_score\", 0.0),\n            \"tokens\": []\n        }\n        \n        for token in sent:\n            sent_data[\"tokens\"].append({\n                \"text\": token.text,\n                \"pos\": token.pos_,\n                \"dep\": token.dep_\n            })\n        \n        analysis[\"sentences\"].append(sent_data)\n    \n    return analysis\n\n# Test integration\ntext = \"Apple is looking at acquiring UK startup for $1 billion. The company is excited about this deal.\"\nresult = analyze_text_with_spacy_transformers(text)\n\nprint(\"spaCy + Transformers Analysis:\")\nprint(f\"\\nText: {result['text']}\\n\")\nprint(\"Entities:\")\nfor ent in result['entities']:\n    print(f\"  {ent['text']}: {ent['label']}\")\nprint(f\"\\nSentences: {len(result['sentences'])}\")"
        ]
      ]
