      "source": [
        [
          "python",
          "import torch\nfrom torch.utils.data import Dataset, DataLoader\nimport numpy as np\n\nclass TextDataset(Dataset):\n    \"\"\"Simple text dataset for transformer training\"\"\"\n    def __init__(self, text_path, tokenizer, seq_length=256):\n        with open(text_path, 'r', encoding='utf-8') as f:\n            self.text = f.read()\n        \n        # Tokenize entire text\n        self.token_ids = tokenizer.encode(self.text, add_special_tokens=False)\n        self.seq_length = seq_length\n        \n    def __len__(self):\n        # Number of non-overlapping windows\n        return (len(self.token_ids) - self.seq_length) // 1\n    \n    def __getitem__(self, idx):\n        start_idx = idx\n        end_idx = start_idx + self.seq_length\n        \n        # Input is tokens 0 to seq_length-1, target is tokens 1 to seq_length\n        input_ids = self.token_ids[start_idx:end_idx]\n        target_ids = self.token_ids[start_idx + 1:end_idx + 1]\n        \n        return {\n            'input_ids': torch.tensor(input_ids, dtype=torch.long),\n            'target_ids': torch.tensor(target_ids, dtype=torch.long)\n        }\n\n# Usage\nfrom transformers import AutoTokenizer\ntokenizer = AutoTokenizer.from_pretrained(\"gpt2\")\ndataset = TextDataset(\"data/corpus.txt\", tokenizer, seq_length=256)"
        ]
      ]
    },
    {
