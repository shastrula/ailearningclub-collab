          "python",
          "import numpy as np\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import accuracy_score\n\n# Scenario: Sentiment classifier trained on product reviews, deployed on tweets\n# Training domain: Formal product reviews (mostly positive or 1-5 stars)\nX_train_formal = np.random.randn(1000, 10) + np.array([1, 0.5, -0.3] + [0]*7)\ny_train = (X_train_formal[:, 0] > 1).astype(int)\n\n# Deployment domain: Tweets (casual, sarcasm, slang)\nX_test_tweets = np.random.randn(200, 10) + np.array([-1, -0.8, 0.5] + [0]*7)\ny_test = (X_test_tweets[:, 0] > 0).astype(int)\n\n# Model trained on formal reviews\nmodel = LogisticRegression()\nmodel.fit(X_train_formal, y_train)\n\ntrain_acc = accuracy_score(y_train, model.predict(X_train_formal))\ntest_acc = accuracy_score(y_test, model.predict(X_test_tweets))\n\nprint(f\"Train accuracy (formal): {train_acc:.3f}\")\nprint(f\"Test accuracy (tweets): {test_acc:.3f}\")  # Much lower due to domain shift\n\n# Mitigation: Transfer learning / Fine-tuning on target domain\nX_target_sample = np.random.randn(100, 10) + np.array([-1, -0.8, 0.5] + [0]*7)\ny_target_sample = (X_target_sample[:, 0] > 0).astype(int)\n\n# Fine-tune on target domain\nmodel_finetuned = LogisticRegression(warm_start=True)\nmodel_finetuned.fit(X_target_sample, y_target_sample)\n\ntest_acc_finetuned = accuracy_score(y_test, model_finetuned.predict(X_test_tweets))\nprint(f\"Fine-tuned test accuracy: {test_acc_finetuned:.3f}\")  # Improved"
        ]
      ]
    },
