          "python",
          "import json\nfrom datetime import datetime, timedelta\n\nclass ModelMonitor:\n    def __init__(self, model_id, alert_threshold=0.05):\n        self.model_id = model_id\n        self.alert_threshold = alert_threshold\n        self.history = []\n    \n    def log_batch_performance(self, predictions, labels):\n        \"\"\"Log performance on batch of predictions\"\"\"\n        f1 = f1_score(labels, predictions, average=\"weighted\")\n        \n        entry = {\n            \"timestamp\": datetime.now().isoformat(),\n            \"f1\": f1,\n            \"accuracy\": accuracy_score(labels, predictions),\n        }\n        self.history.append(entry)\n    \n    def detect_drift(self):\n        \"\"\"Alert if performance degrades\"\"\"\n        if len(self.history) < 2:\n            return None\n        \n        # Compare performance over last 7 days\n        now = datetime.now()\n        one_week_ago = now - timedelta(days=7)\n        \n        old_scores = [e[\"f1\"] for e in self.history \n                     if datetime.fromisoformat(e[\"timestamp\"]) < one_week_ago]\n        new_scores = [e[\"f1\"] for e in self.history \n                     if datetime.fromisoformat(e[\"timestamp\"]) >= one_week_ago]\n        \n        if not old_scores or not new_scores:\n            return None\n        \n        old_avg = sum(old_scores) / len(old_scores)\n        new_avg = sum(new_scores) / len(new_scores)\n        degradation = old_avg - new_avg\n        \n        if degradation > self.alert_threshold:\n            print(f\"\ud83d\udea8 Alert: Performance degraded {degradation:.1%}\")\n            print(f\"   Old: {old_avg:.3f}, New: {new_avg:.3f}\")\n            print(\"   Recommend: Retrain, investigate data shift, or rollback\")\n            return True\n        \n        return False\n\n# Usage\nmonitor = ModelMonitor(\"text-classifier-v2\")\n\n# Log performance daily\nfor day in range(365):\n    # Predict on day's data\n    predictions = model.predict(day_data)\n    labels = day_labels\n    monitor.log_batch_performance(predictions, labels)\n    \n    # Weekly check\n    if day % 7 == 0:\n        monitor.detect_drift()"
