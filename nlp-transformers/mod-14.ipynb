          "python",
          "import re\nimport unicodedata\nfrom textacy.preprocessing import normalize\n\ndef clean_noisy_text(text):\n    \"\"\"Handle common noise in raw text\"\"\"\n    \n    # 1. Remove HTML tags\n    text = re.sub(r'<[^>]+>', '', text)\n    \n    # 2. Remove URLs\n    text = re.sub(r'http\\S+|www\\S+', '', text)\n    \n    # 3. Remove email addresses\n    text = re.sub(r'\\S+@\\S+', '', text)\n    \n    # 4. Normalize unicode (accents, etc.)\n    text = unicodedata.normalize('NFKD', text)\n    \n    # 5. Remove extra whitespace\n    text = re.sub(r'\\s+', ' ', text).strip()\n    \n    # 6. Convert to lowercase (optional\u2014may lose info)\n    text = text.lower()\n    \n    return text\n\n# Test on messy inputs\nsamples = [\n    \"<p>Check this out: https://example.com \ud83d\ude00 AMAZING!!</p>\",\n    \"helo wrld (typo)\",\n    \"caf\u00e9 r\u00e9sum\u00e9 na\u00efve (accents)\",\n    \"ur so awsum!!!  (slang, extra spaces)\",\n]\n\nfor sample in samples:\n    cleaned = clean_noisy_text(sample)\n    print(f\"Original: {sample}\")\n    print(f\"Cleaned:  {cleaned}\\n\")\n\n# Handling typos with fuzzy matching\nfrom difflib import SequenceMatcher\nfrom typing import Dict\n\ndef detect_misspellings(text: str, vocabulary: list, threshold=0.8) -> Dict:\n    \"\"\"Find likely misspellings\"\"\"\n    tokens = text.lower().split()\n    corrections = {}\n    \n    for token in tokens:\n        if token not in vocabulary:\n            # Find closest match in vocabulary\n            matches = [(word, SequenceMatcher(None, token, word).ratio()) \n                      for word in vocabulary]\n            best_match, score = max(matches, key=lambda x: x[1])\n            \n            if score >= threshold:\n                corrections[token] = best_match\n    \n    return corrections\n\nvocab = [\"hello\", \"world\", \"python\", \"transformer\"]\ntext = \"helo wrld pyton\"\ntypos = detect_misspellings(text, vocab, threshold=0.75)\nprint(f\"Likely typos: {typos}\")"
        ]
      ]
