          "python",
          "from transformers import AutoTokenizer, AutoModelForSequenceClassification\nimport torch\n\n# Issue 1: Tokenizer mismatch\ntokenizer_en = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n\ntexts = [\n    \"This is English\",\n    \"Ceci est du fran\u00e7ais\",  # French\n    \"\u8fd9\u662f\u4e2d\u6587\",  # Chinese\n    \"\u0647\u0630\u0627 \u0639\u0631\u0628\u064a\",  # Arabic\n]\n\nprint(\"Tokenizing in English model:\")\nfor text in texts:\n    tokens = tokenizer_en.tokenize(text)\n    print(f\"{text[:20]:20} \u2192 {len(tokens)} tokens\")\n\n# Solution: Multilingual model\ntokenizer_multi = AutoTokenizer.from_pretrained(\"bert-base-multilingual-uncased\")\n\nprint(\"\\nTokenizing with multilingual model:\")\nfor text in texts:\n    tokens = tokenizer_multi.tokenize(text)\n    print(f\"{text[:20]:20} \u2192 {len(tokens)} tokens\")\n\n# Issue 2: Resource disparity (data availability per language)\nlanguage_data = {\n    \"English\": 1000000,\n    \"French\": 100000,\n    \"Japanese\": 50000,\n    \"Tamil\": 10000,\n    \"Lao\": 100,  # Low-resource\n}\n\nfor lang, samples in language_data.items():\n    print(f\"{lang:15} {samples:10,} samples\")\n\n# Mitigation for low-resource: Cross-lingual transfer\n# Train on high-resource language, transfer to low-resource"
        ]
