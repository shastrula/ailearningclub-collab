          "python",
          "import hashlib\nfrom difflib import SequenceMatcher\n\n# Low-resource strategy: Data augmentation\ndef augment_text(text: str, methods=[\"backtranslate\", \"paraphrase\", \"synonym\"]):\n    \"\"\"Generate synthetic training data\"\"\"\n    augmented = []\n    \n    # Method 1: Back-translation (EN \u2192 FR \u2192 EN)\n    # Requires translation model\u2014simplified here\n    augmented.append(f\"[backtranslated] {text}\")\n    \n    # Method 2: Synonym replacement\n    synonyms = {\"good\": \"great\", \"bad\": \"terrible\", \"movie\": \"film\"}\n    paraphrased = text\n    for word, synonym in synonyms.items():\n        paraphrased = paraphrased.replace(word, synonym)\n    augmented.append(paraphrased)\n    \n    # Method 3: Random insertion, deletion, swap\n    words = text.split()\n    if len(words) > 2:\n        # Swap two words\n        import random\n        idx1, idx2 = random.sample(range(len(words)), 2)\n        words[idx1], words[idx2] = words[idx2], words[idx1]\n    augmented.append(\" \".join(words))\n    \n    return augmented\n\ntext = \"This is a good movie\"\naugmented_examples = augment_text(text)\nfor ex in augmented_examples:\n    print(f\"  {ex}\")\n\n# Data privacy: Anonymization\ndef anonymize_pii(text: str) -> str:\n    \"\"\"Remove personally identifiable information\"\"\"\n    import re\n    \n    # Email patterns\n    text = re.sub(r'\\S+@\\S+', '[EMAIL]', text)\n    \n    # Phone patterns (US)\n    text = re.sub(r'\\b\\d{3}[-.]?\\d{3}[-.]?\\d{4}\\b', '[PHONE]', text)\n    \n    # Credit card patterns\n    text = re.sub(r'\\b\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}\\b', '[CC]', text)\n    \n    # Names (hard\u2014requires NER)\n    # text = apply_ner_anonymization(text)\n    \n    return text\n\nexamples = [\n    \"Contact john.doe@email.com or call 555-123-4567\",\n    \"Card: 4532-1234-5678-9010\",\n]\n\nfor ex in examples:\n    print(f\"Original:    {ex}\")\n    print(f\"Anonymized:  {anonymize_pii(ex)}\\n\")\n\n# Differential privacy: Add noise to protect individuals\ndef differentially_private_histogram(data: list, sensitivity: float, epsilon: float):\n    \"\"\"Create privacy-preserving histogram\"\"\"\n    import numpy as np\n    \n    # Laplace noise scale\n    scale = sensitivity / epsilon\n    noise = np.random.laplace(0, scale, size=len(np.unique(data)))\n    \n    hist, bins = np.histogram(data, bins=10)\n    private_hist = np.clip(hist + noise, 0, None)  # Clip to non-negative\n    \n    return private_hist\n\ndata = np.random.normal(0, 1, 1000)\nprivate = differentially_private_histogram(data.tolist(), sensitivity=1.0, epsilon=0.1)\nprint(f\"Differentially private histogram: {private}\")"
        ]
      ]
