    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "\"\"\"verify_setup.py - Comprehensive environment verification\"\"\"\n\nimport sys\nimport torch\nfrom transformers import AutoTokenizer, AutoModel\nfrom datasets import load_dataset\n\nprint(\"=\" * 50)\nprint(\"NLP ENVIRONMENT VERIFICATION\")\nprint(\"=\" * 50)\n\n# Python version\nprint(f\"\\n\u2713 Python version: {sys.version}\")\n\n# PyTorch\nprint(f\"\u2713 PyTorch version: {torch.__version__}\")\nprint(f\"\u2713 CUDA available: {torch.cuda.is_available()}\")\n\nif torch.cuda.is_available():\n    print(f\"\u2713 GPU: {torch.cuda.get_device_name(0)}\")\n    print(f\"\u2713 GPU VRAM: {torch.cuda.get_device_properties(0).total_memory / 1e9:.2f} GB\")\nelse:\n    print(\"  (Running on CPU - inference will be slow, training impractical)\")\n\n# Test tensor operations\nx = torch.randn(3, 3)\nif torch.cuda.is_available():\n    x = x.cuda()\nprint(f\"\u2713 Tensor operations work on: {x.device}\")\n\n# Transformers\ntry:\n    from transformers import __version__ as trans_version\n    print(f\"\u2713 Transformers version: {trans_version}\")\n    \n    # Load model (first run downloads ~400 MB)\n    print(\"  Loading BERT model (first run will download ~400 MB)...\")\n    tokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n    model = AutoModel.from_pretrained(\"bert-base-uncased\")\n    \n    if torch.cuda.is_available():\n        model = model.cuda()\n    \n    print(f\"\u2713 BERT model loaded, parameters: {model.num_parameters():,}\")\n    \n    # Test inference\n    inputs = tokenizer(\"Hello, how are you?\", return_tensors=\"pt\")\n    if torch.cuda.is_available():\n        inputs = {k: v.cuda() for k, v in inputs.items()}\n    \n    with torch.no_grad():\n        outputs = model(**inputs)\n    \n    print(f\"\u2713 Inference successful, output shape: {outputs.last_hidden_state.shape}\")\nexcept Exception as e:\n    print(f\"\u2717 Error: {e}\")\n    sys.exit(1)\n\n# Datasets\ntry:\n    print(\"\u2713 Datasets version: from datasets import version\")\n    dataset = load_dataset(\"imdb\", split=\"train[:10]\")\n    print(f\"\u2713 Dataset loaded, size: {len(dataset)} samples\")\nexcept Exception as e:\n    print(f\"\u2717 Dataset error: {e}\")\n\nprint(\"\\n\" + \"=\" * 50)\nprint(\"SETUP COMPLETE - Ready to start coding!\")\nprint(\"=\" * 50)"
        ]
