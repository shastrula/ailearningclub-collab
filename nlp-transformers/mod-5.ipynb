          "python",
          "# 1. Reduce batch size\nbatch_size = 8  # instead of 32\n\n# 2. Use mixed precision\nfrom torch.cuda.amp import autocast\n\n# 3. Clear cache\ntorch.cuda.empty_cache()\n\n# 4. Use smaller model\nmodel = AutoModel.from_pretrained(\"distilbert-base-uncased\")  # 40% smaller"
