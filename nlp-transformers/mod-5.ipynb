          "accumulation_steps = 4\n\nfor i, batch in enumerate(dataloader):\n    outputs = model(**batch)\n    loss = criterion(outputs, batch['labels'])\n    loss.backward()\n    \n    if (i + 1) % accumulation_steps == 0:\n        optimizer.step()\n        optimizer.zero_grad()"
