          "python",
          "import torch\nimport tracemalloc\n\n# Monitor GPU memory\ntorch.cuda.reset_peak_memory_stats()\n\n# Your model here\nmodel = AutoModel.from_pretrained(\"bert-large-uncased\").cuda()\ninputs = tokenizer(\"Example text\", return_tensors=\"pt\", max_length=512).to(\"cuda\")\n\nwith torch.no_grad():\n    outputs = model(**inputs)\n\n# Check memory\nprint(f\"Peak VRAM used: {torch.cuda.max_memory_allocated() / 1e9:.2f} GB\")\nprint(f\"Current VRAM: {torch.cuda.memory_allocated() / 1e9:.2f} GB\")"
