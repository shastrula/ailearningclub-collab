      "source": [
        [
          "python",
          "import torch\nimport gc\nfrom transformers import AutoTokenizer, AutoModelForSequenceClassification\n\ndef diagnose_oom_issue():\n    \"\"\"Diagnose and fix OOM issues.\"\"\"\n    \n    print(\"OOM Diagnosis Steps:\\n\")\n    \n    # Step 1: Check available memory\n    if torch.cuda.is_available():\n        total_memory = torch.cuda.get_device_properties(0).total_memory / 1e9\n        allocated = torch.cuda.memory_allocated() / 1e9\n        reserved = torch.cuda.memory_reserved() / 1e9\n        \n        print(f\"1. GPU Memory Status:\")\n        print(f\"   Total: {total_memory:.1f} GB\")\n        print(f\"   Allocated: {allocated:.1f} GB\")\n        print(f\"   Reserved: {reserved:.1f} GB\")\n        print(f\"   Available: {total_memory - reserved:.1f} GB\\n\")\n    \n    # Step 2: Profile model memory\n    model_name = \"bert-base-uncased\"\n    tokenizer = AutoTokenizer.from_pretrained(model_name)\n    model = AutoModelForSequenceClassification.from_pretrained(model_name)\n    \n    # Move to GPU\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    model.to(device)\n    \n    model_params = model.num_parameters()\n    # Rough estimate: 4 bytes per parameter for float32\n    model_size_gb = (model_params * 4) / 1e9\n    \n    print(f\"2. Model Memory Profile:\")\n    print(f\"   Parameters: {model_params:,}\")\n    print(f\"   Estimated size (float32): {model_size_gb:.1f} GB\")\n    print(f\"   With optimizer state (\u00d73): {model_size_gb * 3:.1f} GB\\n\")\n    \n    # Step 3: Test batch size\n    print(f\"3. Recommended Batch Sizes:\")\n    \n    batch_sizes = [8, 16, 32]\n    for batch_size in batch_sizes:\n        try:\n            inputs = tokenizer(\n                [\"Test sentence\"] * batch_size,\n                return_tensors=\"pt\",\n                padding=True,\n                truncation=True\n            )\n            inputs = {k: v.to(device) for k, v in inputs.items()}\n            \n            # Forward pass\n            outputs = model(**inputs)\n            \n            if torch.cuda.is_available():\n                allocated = torch.cuda.memory_allocated() / 1e9\n                print(f\"   Batch size {batch_size}: {allocated:.2f} GB \u2713\")\n            else:\n                print(f\"   Batch size {batch_size}: OK \u2713\")\n            \n            # Cleanup\n            del inputs, outputs\n            gc.collect()\n            if torch.cuda.is_available():\n                torch.cuda.empty_cache()\n                \n        except RuntimeError as e:\n            print(f\"   Batch size {batch_size}: FAILED \u2717\")\n            print(f\"   Error: {str(e)[:50]}...\")\n    \n    print(\"\\n4. OOM Solutions (in order of preference):\")\n    print(\"   a) Reduce batch size (easiest)\")\n    print(\"   b) Use gradient accumulation (process multiple mini-batches)\")\n    print(\"   c) Use mixed precision (float16) to halve memory\")\n    print(\"   d) Use model quantization (int8)\")\n    print(\"   e) Use a smaller model variant\")\n\ndiagnose_oom_issue()"
        ]
      ]
    },
