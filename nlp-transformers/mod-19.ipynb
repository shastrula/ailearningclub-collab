          "python",
          "from torch.utils.tensorboard import SummaryWriter\n\ndef setup_tensorboard_monitoring():\n    \"\"\"Initialize TensorBoard for training visualization.\"\"\"\n    \n    writer = SummaryWriter(\"runs/nlp_training\")\n    \n    # Log scalars (loss, accuracy)\n    for step in range(100):\n        loss = 0.5 - (step * 0.004)  # Simulated decreasing loss\n        writer.add_scalar(\"Loss/train\", loss, step)\n        writer.add_scalar(\"Accuracy/train\", 0.7 + (step * 0.003), step)\n    \n    # Log histograms (weight distributions)\n    weights = torch.randn(1000)\n    writer.add_histogram(\"Model/layer1_weights\", weights, 0)\n    \n    # Log embeddings\n    embeddings = torch.randn(100, 50)\n    writer.add_embedding(embeddings)\n    \n    writer.close()\n    \n    print(\"TensorBoard run saved. Launch with:\")\n    print(\"  tensorboard --logdir=runs\")\n\nprint(\"\\nTensorBoard Visualization Features:\")\nprint(\"  1. Scalars: Loss, accuracy, learning rate over time\")\nprint(\"  2. Histograms: Weight and gradient distributions\")\nprint(\"  3. Distributions: Embedding space visualization\")\nprint(\"  4. Text: Log predictions and error analysis\")\nprint(\"  5. Graphs: Model architecture\")\nprint(\"  6. Profile: Identify performance bottlenecks\")"
        ]
