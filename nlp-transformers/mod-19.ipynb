          "python",
          "import numpy as np\nimport torch\nimport random\n\ndef set_seed(seed: int = 42):\n    \"\"\"Set all random seeds for reproducibility.\"\"\"\n    \n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed_all(seed)\n    \n    # Ensure deterministic behavior\n    torch.backends.cudnn.deterministic = True\n    torch.backends.cudnn.benchmark = False\n\ndef create_reproducible_training_config():\n    \"\"\"Configuration for reproducible training runs.\"\"\"\n    \n    return {\n        \"seed\": 42,\n        \"torch_seed\": 42,\n        \"cuda_seed\": 42,\n        \"np_seed\": 42,\n        \"deterministic\": True,\n        \"cudnn_deterministic\": True,\n        \"cudnn_benchmark\": False,\n        \"note\": \"Use set_seed(42) before training\"\n    }\n\ndef debug_training_variance(model, train_loader, num_runs: int = 3):\n    \"\"\"Run multiple training iterations to measure variance.\"\"\"\n    \n    results = []\n    \n    for run in range(num_runs):\n        set_seed(42 + run)  # Different seed each run\n        \n        # Single batch forward pass\n        batch = next(iter(train_loader))\n        \n        # Measure output variance across runs\n        output = model(**batch)\n        loss = output.loss.item()\n        \n        results.append(loss)\n        print(f\"Run {run + 1}: Loss = {loss:.4f}\")\n    \n    variance = np.var(results)\n    print(f\"\\nVariance across {num_runs} runs: {variance:.6f}\")\n    print(f\"If variance > 1e-5, there's non-deterministic behavior\")\n    \n    return results\n\nprint(\"\\nReproducibility Checklist:\")\nprint(\"  \u2713 Set all random seeds (Python, NumPy, PyTorch, CUDA)\")\nprint(\"  \u2713 Use deterministic algorithms\")\nprint(\"  \u2713 Version all dependencies (requirements.txt)\")\nprint(\"  \u2713 Log environment (GPU, CUDA, PyTorch versions)\")\nprint(\"  \u2713 Record exact hyperparameters\")\nprint(\"  \u2713 Save training logs and model snapshots\")\nprint(\"  \u2713 Version control training scripts\")\nprint(\"  \u2713 Document data preprocessing steps\")"
        ]
      ]
    },
