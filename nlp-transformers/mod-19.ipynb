          "python",
          "def diagnose_tokenizer_mismatch():\n    \"\"\"Identify tokenizer inconsistencies.\"\"\"\n    \n    print(\"\\nTokenizer Mismatch Diagnosis:\\n\")\n    \n    from transformers import AutoTokenizer\n    \n    # Load two tokenizer instances\n    tokenizer1 = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n    tokenizer2 = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n    \n    test_sentence = \"The quick brown fox jumps over the lazy dog.\"\n    \n    tokens1 = tokenizer1.tokenize(test_sentence)\n    tokens2 = tokenizer2.tokenize(test_sentence)\n    \n    print(f\"Input: {test_sentence}\\n\")\n    print(f\"Tokenizer 1: {tokens1}\")\n    print(f\"Tokenizer 2: {tokens2}\")\n    print(f\"Match: {tokens1 == tokens2}\\n\")\n    \n    # Check for version differences\n    print(\"Tokenizer Configuration:\")\n    print(f\"  Vocab size: {len(tokenizer1.vocab)}\")\n    print(f\"  Padding token: {tokenizer1.pad_token}\")\n    print(f\"  Unknown token: {tokenizer1.unk_token}\")\n    print(f\"  Lower case: {tokenizer1.do_lower_case}\\n\")\n    \n    # Encoding comparison\n    encoded1 = tokenizer1.encode(test_sentence)\n    encoded2 = tokenizer2.encode(test_sentence)\n    \n    print(f\"Encoded 1: {encoded1}\")\n    print(f\"Encoded 2: {encoded2}\")\n    print(f\"Encoding match: {encoded1 == encoded2}\\n\")\n    \n    # Best practice recommendation\n    print(\"Best Practices to Avoid Mismatch:\")\n    print(\"  1. Version control tokenizer files alongside model\")\n    print(\"  2. Save tokenizer with model: model.save_pretrained('./model')\")\n    print(\"  3. Load with: tokenizer = AutoTokenizer.from_pretrained('./model')\")\n    print(\"  4. Add tokenizer config to production container\")\n    print(\"  5. Test inference with exact training tokenizer\")\n\ndiagnose_tokenizer_mismatch()"
        ]
      ]
    },
