          "python",
          "def detect_and_fix_gradient_issues():\n    \"\"\"Detect and fix gradient problems.\"\"\"\n    \n    print(\"\\nGradient Issue Diagnosis:\\n\")\n    \n    # Common fixes\n    solutions = {\n        \"gradient_clip\": {\n            \"description\": \"Clip gradients to prevent explosion\",\n            \"code\": \"torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\",\n            \"when\": \"When gradients exceed threshold\"\n        },\n        \"lower_lr\": {\n            \"description\": \"Reduce learning rate\",\n            \"code\": \"optimizer = torch.optim.Adam(model.parameters(), lr=1e-5)\",\n            \"when\": \"When loss becomes NaN with standard learning rate\"\n        },\n        \"mixed_precision\": {\n            \"description\": \"Use automatic mixed precision for numerical stability\",\n            \"code\": \"from torch.cuda.amp import autocast; with autocast(): loss = model()\",\n            \"when\": \"When float32 causes instability\"\n        },\n        \"weight_init\": {\n            \"description\": \"Proper weight initialization\",\n            \"code\": \"model.apply(lambda m: init_weights(m) if isinstance(m, nn.Linear) else None)\",\n            \"when\": \"When architecture-specific initialization needed\"\n        }\n    }\n    \n    for key, fix in solutions.items():\n        print(f\"Solution: {fix['description']}\")\n        print(f\"  When: {fix['when']}\")\n        print(f\"  Code: {fix['code']}\\n\")\n\ndetect_and_fix_gradient_issues()"
        ]
      ]
    },
    {
