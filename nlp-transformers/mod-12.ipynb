          "python",
          "# Latency-optimized: Single request, minimal batching\n@app.post(\"/predict-fast\")\nasync def predict_fast(text: str):\n    inputs = tokenizer(text, return_tensors=\"pt\").to(device)\n    with torch.no_grad():\n        output = model(**inputs)\n    return {\"prediction\": int(torch.argmax(output.logits).item())}\n\n# Throughput-optimized: Batch accumulation\n@app.post(\"/predict-batch\")\nasync def predict_batch(texts: List[str]):\n    inputs = tokenizer(texts, padding=True, return_tensors=\"pt\").to(device)\n    with torch.no_grad():\n        outputs = model(**inputs)\n    return {\"predictions\": torch.argmax(outputs.logits, dim=-1).tolist()}"
        ]
