          "python",
          "import random\n\nclass ModelRouter:\n    def __init__(self, primary_model, canary_model, canary_percentage=10):\n        self.primary = primary_model\n        self.canary = canary_model\n        self.canary_percentage = canary_percentage\n    \n    def predict(self, text: str):\n        \"\"\"Route request to canary or primary\"\"\"\n        if random.random() < self.canary_percentage / 100:\n            model_used = \"canary\"\n            prediction = self.canary.predict(text)\n        else:\n            model_used = \"primary\"\n            prediction = self.primary.predict(text)\n        \n        # Log which model was used for metrics comparison\n        logger.info({\n            \"text\": text[:50],\n            \"model\": model_used,\n            \"prediction\": prediction,\n        })\n        \n        return prediction\n\n# Usage: Start with 5% canary, gradually increase\nrouter = ModelRouter(primary_model, canary_model, canary_percentage=5)\n\n# After monitoring shows no issues, increase to 50%\n# router.canary_percentage = 50\n\n# If issues found, roll back\n# router = ModelRouter(primary_model, primary_model)"
        ]
