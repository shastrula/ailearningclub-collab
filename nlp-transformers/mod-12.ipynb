          "python",
          "from fastapi import FastAPI\nimport torch\n\napp = FastAPI()\n\n@app.on_event(\"startup\")\nasync def load_model():\n    \"\"\"Load model at container start, before accepting traffic\"\"\"\n    global model, tokenizer\n    \n    tokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n    model = AutoModelForSequenceClassification.from_pretrained(\"bert-base-uncased\")\n    model.to(\"cuda\").eval()\n    \n    # Warm-up: Run dummy inference to compile GPU kernels\n    dummy_input = tokenizer(\"warm up\", return_tensors=\"pt\").to(\"cuda\")\n    with torch.no_grad():\n        _ = model(**dummy_input)\n    \n    print(\"Model loaded and warm!\")\n\n@app.get(\"/ready\")\nasync def ready():\n    \"\"\"Health check for Kubernetes\"\"\"\n    try:\n        return {\"ready\": model is not None}\n    except NameError:\n        return {\"ready\": False}"
        ]
      ]
