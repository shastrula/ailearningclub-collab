          "python",
          "# Load balancing across multiple replicas\nfrom fastapi import FastAPI, Request\nimport asyncio\n\napp = FastAPI()\nreplicas = []  # List of model replicas\n\ndef load_balance_request(request_queue):\n    \"\"\"Distribute requests across replicas\"\"\"\n    available_replica = min(replicas, key=lambda r: r.queue_size)\n    available_replica.queue_size += 1\n    return available_replica\n\nclass ModelReplica:\n    def __init__(self, model_id, max_batch_size=32):\n        self.model_id = model_id\n        self.model = load_model(model_id)\n        self.queue_size = 0\n        self.max_batch_size = max_batch_size\n    \n    async def predict(self, text: str):\n        \"\"\"Process prediction\"\"\"\n        self.queue_size += 1\n        try:\n            result = self.model.predict(text)\n            return result\n        finally:\n            self.queue_size -= 1\n\n# Initialize 3 replicas\nfor i in range(3):\n    replicas.append(ModelReplica(f\"text-classifier-{i}\"))\n\n@app.post(\"/predict\")\nasync def predict(text: str):\n    replica = load_balance_request(replicas)\n    return await replica.predict(text)"
        ]
