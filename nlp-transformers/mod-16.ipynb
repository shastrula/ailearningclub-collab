        [
          "python",
          "from transformers import pipeline\nfrom typing import List, Dict\n\n# Load multiple moderation classifiers\ntoxic_classifier = pipeline(\n    \"text-classification\",\n    model=\"michellejieli/NSFW_text_classifier\",\n    truncation=True\n)\n\n# Define moderation thresholds\nTHRESHOLDS = {\n    \"toxic\": 0.7,\n    \"hate_speech\": 0.8,\n    \"misinformation\": 0.75\n}\n\ndef moderate_content(text: str) -> Dict:\n    \"\"\"Comprehensive content moderation analysis.\"\"\"\n    \n    results = {\n        \"text\": text,\n        \"violations\": [],\n        \"action\": \"approve\",\n        \"confidence\": 1.0\n    }\n    \n    # Check for toxicity\n    toxicity = toxic_classifier(text[:512])[0]  # Truncate for model limits\n    \n    if toxicity['score'] > THRESHOLDS[\"toxic\"]:\n        results[\"violations\"].append({\n            \"type\": \"toxicity\",\n            \"confidence\": toxicity['score'],\n            \"action\": \"flag_for_review\"\n        })\n    \n    # Simple misinformation detection (rule-based for demo)\n    if \"covid vaccine contains microchips\" in text.lower():\n        results[\"violations\"].append({\n            \"type\": \"misinformation\",\n            \"confidence\": 0.95,\n            \"action\": \"remove_and_warn_user\"\n        })\n    \n    # Determine final action\n    if results[\"violations\"]:\n        results[\"action\"] = \"remove\" if any(\n            v[\"action\"] == \"remove_and_warn_user\" for v in results[\"violations\"]\n        ) else \"flag_for_review\"\n        results[\"confidence\"] = max(\n            v[\"confidence\"] for v in results[\"violations\"]\n        )\n    \n    return results\n\n# Test moderation\ntest_posts = [\n    \"Just finished my morning jog, feeling great!\",\n    \"I hate all people from that country\",\n    \"5G towers spread covid particles\"\n]\n\nfor post in test_posts:\n    moderation = moderate_content(post)\n    print(f\"Post: {post}\")\n    print(f\"Action: {moderation['action']}\")\n    if moderation['violations']:\n        for v in moderation['violations']:\n            print(f\"  - {v['type']}: {v['confidence']:.3f}\")\n    print()"
        ]
      ]
    },
    {
