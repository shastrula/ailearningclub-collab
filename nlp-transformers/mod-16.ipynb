        [
          "python",
          "from transformers import pipeline\nimport numpy as np\n\n# Intent classifier for customer support\nintent_classifier = pipeline(\n    \"zero-shot-classification\",\n    model=\"facebook/bart-large-mnli\"\n)\n\n# Define intents and fallback handling\nintents = [\n    \"refund request\",\n    \"technical support\",\n    \"billing inquiry\",\n    \"account access\",\n    \"product information\"\n]\n\ndef classify_intent(user_message, confidence_threshold=0.7):\n    \"\"\"Classify customer intent with confidence threshold.\"\"\"\n    result = intent_classifier(\n        user_message,\n        intents,\n        multi_class=False\n    )\n    \n    # Return None if confidence below threshold (out-of-distribution)\n    if result['scores'][0] < confidence_threshold:\n        return None, result['scores'][0]\n    \n    return result['labels'][0], result['scores'][0]\n\n# Test with various inputs\ntest_messages = [\n    \"I want my money back immediately\",\n    \"The app keeps crashing on my phone\",\n    \"When will my order arrive?\"\n]\n\nfor msg in test_messages:\n    intent, confidence = classify_intent(msg)\n    print(f\"Message: {msg}\")\n    print(f\"Intent: {intent}, Confidence: {confidence:.3f}\\n\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import AutoTokenizer, AutoModelForSeq2SeqLM\n\n# Load a response generation model\nmodel_name = \"google/flan-t5-base\"\ntokenizer = AutoTokenizer.from_pretrained(model_name)\nmodel = AutoModelForSeq2SeqLM.from_pretrained(model_name)\n\ndef generate_response(user_intent, user_message, context=\"\"):\n    \"\"\"Generate response given intent and message.\"\"\"\n    \n    # Create task-specific prompt\n    prompt = f\"\"\"Intent: {user_intent}\nCustomer message: {user_message}\nContext: {context}\n\nGenerate a professional, helpful response:\"\"\"\n    \n    inputs = tokenizer(prompt, return_tensors=\"pt\", max_length=512, truncation=True)\n    \n    # Generate with constrained decoding\n    outputs = model.generate(\n        inputs[\"input_ids\"],\n        max_length=150,\n        num_beams=4,\n        temperature=0.7,\n        do_sample=True,\n        top_p=0.9,\n        early_stopping=True\n    )\n    \n    response = tokenizer.decode(outputs[0], skip_special_tokens=True)\n    return response\n\n# Test response generation\nintent = \"refund request\"\nmessage = \"I received the wrong item in my order\"\nresponse = generate_response(intent, message)\nprint(f\"Generated response:\\n{response}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sentence_transformers import SentenceTransformer\nfrom sklearn.metrics.pairwise import cosine_similarity\nimport numpy as np\n\n# Load pre-trained dense retrieval model\nmodel = SentenceTransformer('all-mpnet-base-v2')\n\n# Sample documents (typically millions in production)\ndocuments = [\n    \"Effective team management requires clear communication and trust.\",\n    \"Leadership best practices include delegation and feedback.\",\n    \"Managing remote teams presents unique synchronization challenges.\",\n    \"Data preprocessing is the most time-consuming ML pipeline step.\",\n    \"Python is the dominant language for machine learning.\",\n]\n\n# Encode all documents (done once, stored in vector database)\ndoc_embeddings = model.encode(documents)\n\ndef search(query, k=3):\n    \"\"\"Retrieve top-k documents using dense retrieval.\"\"\"\n    \n    # Encode query\n    query_embedding = model.encode(query)\n    \n    # Compute similarity scores\n    similarities = cosine_similarity([query_embedding], doc_embeddings)[0]\n    \n    # Get top-k indices\n    top_indices = np.argsort(similarities)[::-1][:k]\n    \n    # Return results with scores\n    results = [\n        {\n            \"document\": documents[idx],\n            \"relevance_score\": float(similarities[idx])\n        }\n        for idx in top_indices\n    ]\n    \n    return results\n\n# Test search\nquery = \"what are management strategies?\"\nresults = search(query)\n\nprint(f\"Query: {query}\\n\")\nfor i, result in enumerate(results, 1):\n    print(f\"{i}. {result['document']}\")\n    print(f\"   Relevance: {result['relevance_score']:.3f}\\n\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
