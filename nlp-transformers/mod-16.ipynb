          "python",
          "from transformers import AutoTokenizer, AutoModelForSequenceClassification\nimport torch\n\n# Load contract clause classifier\nmodel_name = \"nlpaueb/legal-bert-base-uncased\"\ntokenizer = AutoTokenizer.from_pretrained(model_name)\nmodel = AutoModelForSequenceClassification.from_pretrained(model_name)\n\n# Define clause types\nCLAUSE_TYPES = {\n    0: \"Payment Terms\",\n    1: \"Termination\",\n    2: \"Confidentiality\",\n    3: \"Liability Limitation\",\n    4: \"Governing Law\",\n    5: \"General\"\n}\n\ndef classify_clause(clause_text: str) -> tuple:\n    \"\"\"Classify contract clause type.\"\"\"\n    \n    inputs = tokenizer(\n        clause_text,\n        return_tensors=\"pt\",\n        max_length=512,\n        truncation=True,\n        padding=True\n    )\n    \n    with torch.no_grad():\n        outputs = model(**inputs)\n        logits = outputs.logits\n        probabilities = torch.softmax(logits, dim=-1)[0]\n        predicted_class = torch.argmax(logits, dim=-1).item()\n    \n    return CLAUSE_TYPES[predicted_class], probabilities[predicted_class].item()\n\ndef analyze_contract(contract_text: str, clause_delimiter: str = \"\\n\\n\") -> list:\n    \"\"\"Analyze contract by classifying all clauses.\"\"\"\n    \n    clauses = contract_text.split(clause_delimiter)\n    analysis = []\n    \n    for i, clause in enumerate(clauses):\n        if len(clause.strip()) > 50:  # Skip very short text\n            clause_type, confidence = classify_clause(clause)\n            analysis.append({\n                \"clause_number\": i + 1,\n                \"type\": clause_type,\n                \"confidence\": confidence,\n                \"preview\": clause[:100] + \"...\" if len(clause) > 100 else clause\n            })\n    \n    return analysis\n\n# Test contract analysis\ncontract_sample = \"\"\"\nThe Client shall pay the Vendor 50,000 USD within 30 days of invoice.\n\nEither party may terminate this agreement with 30 days written notice.\n\nThe Vendor agrees to maintain confidentiality of all Client proprietary information.\n\nNeither party shall be liable for indirect or consequential damages.\n\"\"\"\n\nanalysis = analyze_contract(contract_sample)\nprint(\"Contract Analysis Results:\\n\")\nfor item in analysis:\n    print(f\"Clause {item['clause_number']}: {item['type']} ({item['confidence']:.2%})\")\n    print(f\"  {item['preview']}\\n\")"
        ]
      ]
    }
