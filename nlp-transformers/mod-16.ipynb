        [
          "python",
          "import spacy\nfrom spacy.tokens import Span\n\n# Load biomedical NER model\nnlp = spacy.load(\"en_core_sci_sm\")  # Requires: pip install scispacy\n\ndef extract_clinical_entities(clinical_note: str) -> Dict:\n    \"\"\"Extract medical entities from clinical note.\"\"\"\n    \n    doc = nlp(clinical_note)\n    \n    extracted = {\n        \"symptoms\": [],\n        \"medications\": [],\n        \"procedures\": [],\n        \"diagnoses\": [],\n        \"dates\": [],\n        \"raw_text\": clinical_note\n    }\n    \n    # Extract entities by type\n    for ent in doc.ents:\n        if ent.label_ == \"CLINICAL_EVENT\":\n            extracted[\"symptoms\"].append(ent.text)\n        elif ent.label_ == \"MEDICATION\":\n            extracted[\"medications\"].append(ent.text)\n        elif ent.label_ == \"PROCEDURE\":\n            extracted[\"procedures\"].append(ent.text)\n        elif ent.label_ == \"DIAGNOSIS\":\n            extracted[\"diagnoses\"].append(ent.text)\n        elif ent.label_ == \"DATE\":\n            extracted[\"dates\"].append(ent.text)\n    \n    return extracted\n\n# Test clinical NER\nclinical_note = \"\"\"Patient presents with severe migraine headaches persisting for 2 weeks. \nStarted on ibuprofen 400mg twice daily. Previous CT scan was normal. \nReferred to neurology for specialist evaluation.\"\"\"\n\nentities = extract_clinical_entities(clinical_note)\nprint(\"Extracted Clinical Information:\")\nfor entity_type, values in entities.items():\n    if entity_type != \"raw_text\" and values:\n        print(f\"  {entity_type}: {values}\")"
        ]
      ]
    },
