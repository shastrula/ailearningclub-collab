        [
          "python",
          "import mlflow\nimport mlflow.sklearn\nfrom sklearn.metrics import accuracy_score\nimport json\n\ndef setup_mlflow_experiment(experiment_name: str):\n    \"\"\"Initialize MLflow experiment for team tracking.\"\"\"\n    \n    # Set tracking server (local or remote)\n    mlflow.set_tracking_uri(\"http://localhost:5000\")\n    \n    # Create or get experiment\n    experiment = mlflow.get_experiment_by_name(experiment_name)\n    if experiment is None:\n        exp_id = mlflow.create_experiment(experiment_name)\n        experiment = mlflow.get_experiment(exp_id)\n    \n    print(f\"MLflow Experiment: {experiment.name}\")\n    print(f\"  ID: {experiment.experiment_id}\")\n    print(f\"  Artifact Location: {experiment.artifact_location}\")\n    \n    return experiment\n\ndef run_tracked_training_experiment(\n    model_name: str,\n    learning_rate: float,\n    batch_size: int,\n    epochs: int\n):\n    \"\"\"Run training with MLflow tracking.\"\"\"\n    \n    with mlflow.start_run(run_name=f\"{model_name}-lr{learning_rate}\"):\n        \n        # Log hyperparameters\n        mlflow.log_params({\n            \"model\": model_name,\n            \"learning_rate\": learning_rate,\n            \"batch_size\": batch_size,\n            \"epochs\": epochs\n        })\n        \n        # Simulate training\n        print(f\"\\nTraining {model_name}...\")\n        training_results = []\n        \n        for epoch in range(epochs):\n            # Simulated metrics\n            loss = 0.5 - (epoch * 0.1)\n            accuracy = 0.7 + (epoch * 0.08)\n            \n            # Log metrics at each epoch\n            mlflow.log_metrics({\n                \"loss\": loss,\n                \"accuracy\": accuracy,\n                \"epoch\": epoch\n            }, step=epoch)\n            \n            training_results.append({\n                \"epoch\": epoch,\n                \"loss\": loss,\n                \"accuracy\": accuracy\n            })\n            \n            print(f\"  Epoch {epoch + 1}: Loss={loss:.4f}, Accuracy={accuracy:.4f}\")\n        \n        # Log final metrics\n        final_metrics = {\n            \"final_accuracy\": accuracy,\n            \"final_loss\": loss\n        }\n        mlflow.log_metrics(final_metrics)\n        \n        # Log artifacts\n        results_file = \"training_results.json\"\n        with open(results_file, \"w\") as f:\n            json.dump(training_results, f)\n        mlflow.log_artifact(results_file)\n        \n        # Log model\n        mlflow.log_dict({\"model_config\": {\n            \"type\": model_name,\n            \"learning_rate\": learning_rate\n        }}, \"model_config.json\")\n        \n        print(f\"  Run logged to MLflow\")\n\n# Setup and run experiments\nexperiment = setup_mlflow_experiment(\"nlp-experiments\")\n\n# Team members run different configurations\nconfigurations = [\n    (\"bert-base\", 2e-5, 16, 3),\n    (\"bert-base\", 1e-5, 32, 4),\n    (\"roberta-base\", 2e-5, 16, 3)\n]\n\nprint(\"\\nTeam Experiment Runs:\")\nfor model, lr, bs, epochs in configurations:\n    run_tracked_training_experiment(model, lr, bs, epochs)\n\nprint(\"\\nMLflow Benefits:\")\nprint(\"  1. Compare experiments side-by-side\")\nprint(\"  2. Track all hyperparameters and metrics\")\nprint(\"  3. Store artifacts (models, plots, logs)\")\nprint(\"  4. Share results across team\")\nprint(\"  5. Reproduce any run's exact configuration\")"
        ]
      ]
