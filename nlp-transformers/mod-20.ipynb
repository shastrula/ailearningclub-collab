          "python",
          "class MLCodeReviewChecklist:\n    \"\"\"Checklist for reviewing ML code changes.\"\"\"\n    \n    def __init__(self):\n        self.items = {\n            \"reproducibility\": [\n                \"Are random seeds set?\",\n                \"Are hyperparameters documented?\",\n                \"Is the training data version specified?\",\n                \"Can the exact environment be reproduced (requirements.txt)?\",\n                \"Are results logged to experiment tracking?\"\n            ],\n            \"correctness\": [\n                \"Is the model architecture correct?\",\n                \"Are preprocessing steps consistent with training?\",\n                \"Is evaluation on correct data (no leakage)?\",\n                \"Are metrics computed correctly?\",\n                \"Are edge cases handled?\"\n            ],\n            \"model_performance\": [\n                \"Does accuracy meet target?\",\n                \"Are precision/recall acceptable for use case?\",\n                \"Does performance degrade on different data distributions?\",\n                \"Is model interpretability considered?\",\n                \"Are error cases analyzed?\"\n            ],\n            \"production_readiness\": [\n                \"Is inference latency acceptable?\",\n                \"Does model fit in deployment environment?\",\n                \"Are API contracts clear?\",\n                \"Is error handling robust?\",\n                \"Are monitoring metrics defined?\"\n            ],\n            \"governance\": [\n                \"Is there documentation?\",\n                \"Are changes tracked in git?\",\n                \"Is there a changelog entry?\",\n                \"Are stakeholders aware of model changes?\",\n                \"Is this backwards compatible?\"\n            ]\n        }\n    \n    def review(self, change_description: str) -> Dict:\n        \"\"\"Generate review checklist for a code change.\"\"\"\n        \n        review = {\n            \"change\": change_description,\n            \"checklist\": self.items,\n            \"must_pass\": [\"correctness\", \"reproducibility\"],\n            \"should_pass\": [\"model_performance\", \"production_readiness\"],\n            \"nice_to_have\": [\"governance\"]\n        }\n        \n        return review\n    \n    def print_checklist(self):\n        \"\"\"Print review checklist.\"\"\"\n        \n        print(\"ML Code Review Checklist\\n\")\n        \n        for category, items in self.items.items():\n            print(f\"{category.upper()}:\")\n            for item in items:\n                print(f\"  \u2610 {item}\")\n            print()\n\n# Example review\nreviewer = MLCodeReviewChecklist()\nreviewer.print_checklist()\n\n# Example PR review outcome\npr_review = {\n    \"pr_number\": 123,\n    \"author\": \"alice@company.com\",\n    \"change\": \"Improve sentiment classifier accuracy\",\n    \"status\": \"APPROVED\",\n    \"comments\": [\n        {\n            \"file\": \"train.py\",\n            \"line\": 45,\n            \"comment\": \"Good: Added seed setting for reproducibility \u2713\"\n        },\n        {\n            \"file\": \"evaluate.py\",\n            \"line\": 78,\n            \"comment\": \"Question: Why evaluate on full test set? Should use stratified split?\"\n        },\n        {\n            \"file\": \"README.md\",\n            \"line\": 12,\n            \"comment\": \"Please document new hyperparameters and model performance\"\n        }\n    ]\n}\n\nprint(\"\\nExample PR Review:\")\nprint(f\"PR #{pr_review['pr_number']}: {pr_review['change']}\")\nprint(f\"Author: {pr_review['author']}\")\nprint(f\"Status: {pr_review['status']}\")\nprint(\"\\nComments:\")\nfor comment in pr_review['comments']:\n    print(f\"  {comment['file']}:{comment['line']}\")\n    print(f\"    {comment['comment']}\")"
        ]
      ]
