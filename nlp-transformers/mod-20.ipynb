        [
          "python",
          "# Git LFS configuration for model files\n# .gitattributes - commit this file to repository\n# *.bin filter=lfs diff=lfs merge=lfs -text\n# *.pt filter=lfs diff=lfs merge=lfs -text\n# *.pth filter=lfs diff=lfs merge=lfs -text\n\nimport os\nimport json\nfrom datetime import datetime\nfrom typing import Dict\n\ndef create_model_metadata_file(\n    model_name: str,\n    model_path: str,\n    training_config: Dict,\n    performance_metrics: Dict,\n    git_commit: str,\n    author: str\n) -> str:\n    \"\"\"Create metadata file for model versioning.\"\"\"\n    \n    metadata = {\n        \"model_name\": model_name,\n        \"timestamp\": datetime.now().isoformat(),\n        \"git_commit\": git_commit,\n        \"author\": author,\n        \"model_path\": model_path,\n        \"training_config\": training_config,\n        \"performance_metrics\": performance_metrics,\n        \"dependencies\": {\n            \"torch\": \"2.0.0\",\n            \"transformers\": \"4.30.0\",\n            \"numpy\": \"1.24.0\"\n        }\n    }\n    \n    metadata_path = f\"{model_path}/metadata.json\"\n    with open(metadata_path, \"w\") as f:\n        json.dump(metadata, f, indent=2)\n    \n    print(f\"Created model metadata: {metadata_path}\")\n    return metadata_path\n\ndef document_model_lineage(\n    model_name: str,\n    parent_model: str = None,\n    training_data_version: str = None,\n    modifications: list = None\n) -> Dict:\n    \"\"\"Track model lineage for reproducibility.\"\"\"\n    \n    lineage = {\n        \"model\": model_name,\n        \"parent_model\": parent_model,\n        \"training_data_version\": training_data_version,\n        \"modifications\": modifications or [],\n        \"created_at\": datetime.now().isoformat(),\n        \"model_family\": \"sentiment-classifier\"\n    }\n    \n    print(f\"\\nModel Lineage:\")\n    print(f\"  Name: {lineage['model']}\")\n    print(f\"  Parent: {lineage['parent_model']}\")\n    print(f\"  Data version: {lineage['training_data_version']}\")\n    \n    if modifications:\n        print(f\"  Modifications:\")\n        for mod in modifications:\n            print(f\"    - {mod}\")\n    \n    return lineage\n\n# Example usage\nconfig = {\n    \"model_type\": \"bert-base\",\n    \"learning_rate\": 2e-5,\n    \"batch_size\": 16,\n    \"epochs\": 3,\n    \"warmup_steps\": 500\n}\n\nmetrics = {\n    \"accuracy\": 0.92,\n    \"precision\": 0.89,\n    \"recall\": 0.91,\n    \"f1_score\": 0.90\n}\n\nmetadata = create_model_metadata_file(\n    model_name=\"sentiment-v2.1\",\n    model_path=\"./models/sentiment-v2.1\",\n    training_config=config,\n    performance_metrics=metrics,\n    git_commit=\"abc1234def5678\",\n    author=\"alice@company.com\"\n)\n\nlineage = document_model_lineage(\n    model_name=\"sentiment-v2.1\",\n    parent_model=\"sentiment-v2.0\",\n    training_data_version=\"dataset-2024-01-15\",\n    modifications=[\n        \"Added data augmentation (backtranslation)\",\n        \"Increased training epochs from 2 to 3\",\n        \"Applied early stopping with patience=2\"\n    ]\n)"
        ]
      ]
