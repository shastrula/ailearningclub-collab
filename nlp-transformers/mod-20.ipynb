          "python",
          "from enum import Enum\nfrom typing import Optional\nfrom datetime import datetime\n\nclass ModelStage(Enum):\n    \"\"\"Model lifecycle stages.\"\"\"\n    DEVELOPMENT = \"development\"\n    STAGING = \"staging\"\n    PRODUCTION = \"production\"\n    ARCHIVED = \"archived\"\n\nclass ModelRegistry:\n    \"\"\"Simplified model registry implementation.\"\"\"\n    \n    def __init__(self):\n        self.models = {}\n    \n    def register_model(\n        self,\n        name: str,\n        version: int,\n        model_path: str,\n        metrics: dict,\n        author: str,\n        stage: ModelStage = ModelStage.DEVELOPMENT\n    ) -> Dict:\n        \"\"\"Register a new model version.\"\"\"\n        \n        model_id = f\"{name}_{version}\"\n        \n        model_record = {\n            \"id\": model_id,\n            \"name\": name,\n            \"version\": version,\n            \"model_path\": model_path,\n            \"metrics\": metrics,\n            \"author\": author,\n            \"stage\": stage.value,\n            \"registered_at\": datetime.now().isoformat(),\n            \"deployed_at\": None,\n            \"replicas\": 0\n        }\n        \n        self.models[model_id] = model_record\n        print(f\"\u2713 Registered {model_id}\")\n        return model_record\n    \n    def promote_model(\n        self,\n        model_id: str,\n        new_stage: ModelStage\n    ) -> bool:\n        \"\"\"Move model through lifecycle stages.\"\"\"\n        \n        if model_id not in self.models:\n            print(f\"\u2717 Model {model_id} not found\")\n            return False\n        \n        model = self.models[model_id]\n        old_stage = model[\"stage\"]\n        model[\"stage\"] = new_stage.value\n        \n        if new_stage == ModelStage.PRODUCTION:\n            model[\"deployed_at\"] = datetime.now().isoformat()\n        \n        print(f\"\u2713 Promoted {model_id}: {old_stage} \u2192 {new_stage.value}\")\n        return True\n    \n    def get_production_model(self, name: str) -> Optional[Dict]:\n        \"\"\"Get the current production model for a given name.\"\"\"\n        \n        for model_id, model in self.models.items():\n            if model[\"name\"] == name and model[\"stage\"] == \"production\":\n                return model\n        \n        return None\n    \n    def get_model_versions(self, name: str) -> list:\n        \"\"\"Get all versions of a model.\"\"\"\n        \n        versions = [\n            model for model in self.models.values()\n            if model[\"name\"] == name\n        ]\n        \n        return sorted(versions, key=lambda m: m[\"version\"], reverse=True)\n\n# Example: Team managing model lifecycle\nregistry = ModelRegistry()\n\n# Data scientist trains new model\nv1 = registry.register_model(\n    name=\"sentiment-classifier\",\n    version=1,\n    model_path=\"s3://models/sentiment-v1\",\n    metrics={\"accuracy\": 0.89, \"f1\": 0.87},\n    author=\"alice@company.com\"\n)\n\n# Promote to staging for testing\nregistry.promote_model(\"sentiment-classifier_1\", ModelStage.STAGING)\n\n# Run tests in staging environment\nprint(\"\\nRunning staging tests...\")\nprint(\"  \u2713 Accuracy on test set: 0.89\")\nprint(\"  \u2713 Latency <50ms: True\")\nprint(\"  \u2713 Memory footprint: 2.1GB\")\n\n# Promote to production after testing\nregistry.promote_model(\"sentiment-classifier_1\", ModelStage.PRODUCTION)\n\n# Get current production model\nprod_model = registry.get_production_model(\"sentiment-classifier\")\nprint(f\"\\nProduction Model: {prod_model['name']} v{prod_model['version']}\")\n\n# Train new improved model\nv2 = registry.register_model(\n    name=\"sentiment-classifier\",\n    version=2,\n    model_path=\"s3://models/sentiment-v2\",\n    metrics={\"accuracy\": 0.92, \"f1\": 0.91},\n    author=\"bob@company.com\"\n)\n\n# View all versions\nprint(\"\\nAll versions of sentiment-classifier:\")\nversions = registry.get_model_versions(\"sentiment-classifier\")\nfor v in versions:\n    print(f\"  v{v['version']}: {v['stage']} ({v['metrics']})\")"
        ]
      ]
