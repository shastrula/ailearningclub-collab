          "python",
          "import numpy as np\nimport pandas as pd\n\n# Data preparation pipeline for ML\ndef prepare_data(df):\n    \"\"\"Common data preprocessing steps.\"\"\"\n    # 1. Handle missing values\n    df = df.fillna(df.median(numeric_only=True))\n    \n    # 2. Remove duplicates\n    df = df.drop_duplicates()\n    \n    # 3. Feature engineering\n    if 'date' in df.columns:\n        df['day_of_week'] = pd.to_datetime(df['date']).dt.dayofweek\n    \n    return df\n\n# Create sample dataset\nnp.random.seed(42)\ndf = pd.DataFrame({\n    'feature_1': np.random.randn(100),\n    'feature_2': np.random.uniform(0, 10, 100),\n    'category': np.random.choice(['A', 'B', 'C'], 100),\n    'target': np.random.randint(0, 2, 100)\n})\n\n# Add some missing values\ndf.loc[5:10, 'feature_1'] = np.nan\n\nprint(f\"Before: {df.isnull().sum().sum()} missing values\")\ndf = prepare_data(df)\nprint(f\"After: {df.isnull().sum().sum()} missing values\")\nprint(f\"Shape: {df.shape}\")\nprint(f\"\\nTarget distribution: {df['target'].value_counts().to_dict()}\")"
        ]
      ]
    }
