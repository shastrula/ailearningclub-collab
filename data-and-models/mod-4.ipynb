          "python",
          "from transformers import pipeline\n\n# Classify sentiment\nclassifier = pipeline('sentiment-analysis', model='distilbert-base-uncased-finetuned-sst-2-english')\nresults = classifier([\"Great movie!\", \"Terrible experience\", \"It was okay\"])\nfor result in results:\n    print(result)\n\n# Generate questions from text (using different models)\nqa_generator = pipeline('question-generation', model='valhalla/t5-base-qg-hl')\n\n# Extract key information\nextractor = pipeline('token-classification', model='dbmdz/bert-large-cased-finetuned-conll03-english')\nresult = extractor(\"John works at Google in Mountain View.\")\nprint(result)\n\n# Translate (multilingual)\ntranslator = pipeline('translation_en_to_de')\nresult = translator(\"Good morning!\")\nprint(result)"
