          "python",
          "from transformers import AutoTokenizer\n\ntokenizer = AutoTokenizer.from_pretrained('bert-base-uncased')\n\n# Tokenize text\ntext = \"HuggingFace is awesome!\"\ntokens = tokenizer(text)\n\nprint(tokens['input_ids'])   # [101, 17662, 3231, 2003, 8361, 999, 102]\nprint(tokens['attention_mask'])  # [1, 1, 1, 1, 1, 1, 1]\n\n# Decode back to text\ndecoded = tokenizer.decode(tokens['input_ids'])\nprint(decoded)  # \"[CLS] huggingface is awesome! [SEP]\"\n\n# Batch processing\ntexts = [\"Hello\", \"HuggingFace is great\", \"Tokenizers are useful\"]\nbatch = tokenizer(texts, padding=True, truncation=True, return_tensors='pt')\n\nprint(batch['input_ids'].shape)  # (3, max_length)"
