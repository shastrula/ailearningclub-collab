          "python",
          "from pyspark.sql import SparkSession\nfrom pyspark.sql.functions import col, mean, count\nimport numpy as np\nimport pandas as pd\n\n# Create Spark session\nspark = SparkSession.builder.appName(\"BigDataExample\").getOrCreate()\n\n# Read from CSV or Parquet\ndf_spark = spark.read.csv('large_file.csv', header=True, inferSchema=True)\n\n# Show schema\ndf_spark.printSchema()\n\n# DataFrame operations\nresult = (df_spark\n          .groupBy('category')\n          .agg(mean('value').alias('avg_value'),\n               count('*').alias('count')))\n\nresult.show()\n\n# SQL queries (Spark SQL)\ndf_spark.createOrReplaceTempView(\"data\")\nsql_result = spark.sql(\"\"\"\n    SELECT category, AVG(value) as avg_value, COUNT(*) as count\n    FROM data\n    GROUP BY category\n\"\"\")\n\nsql_result.show()\n\n# Write to Parquet (efficient, columnar format)\nresult.write.mode(\"overwrite\").parquet(\"output_spark.parquet\")\n\n# Window functions for time-series\nfrom pyspark.sql.window import Window\nfrom pyspark.sql.functions import row_number\n\ndf_spark['date'] = df_spark['date'].cast('timestamp')\nwindow_spec = Window.partitionBy('category').orderBy('date')\n\ndf_with_row_num = df_spark.withColumn(\n    'row_num', \n    row_number().over(window_spec)\n)\n\nspark.stop()"
        ]
      ]
