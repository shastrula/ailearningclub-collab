          "python",
          "import polars as pl\nimport pandas as pd\nimport numpy as np\n\n# Create sample data\nnp.random.seed(42)\ndata = {\n    'date': pd.date_range('2020-01-01', periods=100000, freq='1H'),\n    'value': np.random.randn(100000),\n    'category': np.random.choice(['A', 'B', 'C', 'D'], 100000)\n}\n\n# Polars from dictionary\ndf_polars = pl.DataFrame(data)\n\n# Show data\nprint(df_polars.head())\n\n# Group operations (similar to pandas but faster)\nresult = (df_polars\n          .group_by('category')\n          .agg(pl.col('value').mean().alias('mean_value'),\n               pl.col('value').std().alias('std_value')))\n\nprint(result)\n\n# Lazy evaluation (builds query plan before execution)\nlazy_df = df_polars.lazy()\n\nlazy_result = (lazy_df\n               .filter(pl.col('value') > 0)\n               .group_by('category')\n               .agg(pl.col('value').mean())\n               .collect())  # Collect to execute\n\nprint(lazy_result)\n\n# Write to Parquet\ndf_polars.write_parquet('polars_output.parquet')\n\n# Read back\ndf_read = pl.read_parquet('polars_output.parquet')\nprint(f\"Read {len(df_read)} rows\")\n\n# String operations (optimized in Polars)\ndf_polars_str = df_polars.with_columns([\n    pl.col('category').cast(pl.String).alias('cat_string')\n])\n\nprint(df_polars_str.head())"
        ]
