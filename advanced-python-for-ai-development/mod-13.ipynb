          "python",
          "import pandas as pd\nimport dask.dataframe as dd\nimport polars as pl\nimport time\n\n# Create test data\ndata = {\n    'x': range(1000000),\n    'y': range(1000000, 2000000),\n    'z': ['A', 'B', 'C'] * (1000000 // 3)\n}\n\n# Pandas\ndf_pd = pd.DataFrame(data)\nstart = time.time()\nresult_pd = df_pd.groupby('z')['x'].sum()\nprint(f\"Pandas: {time.time() - start:.3f}s\")\n\n# Dask\ndf_dask = dd.from_pandas(df_pd, npartitions=4)\nstart = time.time()\nresult_dask = df_dask.groupby('z')['x'].sum().compute()\nprint(f\"Dask: {time.time() - start:.3f}s\")\n\n# Polars\ndf_polars = pl.DataFrame(data)\nstart = time.time()\nresult_polars = df_polars.group_by('z').agg(pl.col('x').sum())\nprint(f\"Polars: {time.time() - start:.3f}s\")"
