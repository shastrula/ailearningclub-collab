          "python",
          "import dask.dataframe as dd\nimport pandas as pd\nimport numpy as np\n\n# Create large CSV (or use existing)\n# For demo, create sample data\ndata = {\n    'date': pd.date_range('2020-01-01', periods=1000000, freq='1H'),\n    'value': np.random.randn(1000000),\n    'category': np.random.choice(['A', 'B', 'C', 'D'], 1000000)\n}\ndf = pd.DataFrame(data)\ndf.to_csv('large_file.csv', index=False)\n\n# Read with Dask (lazy, not immediate)\ndask_df = dd.read_csv('large_file.csv', blocksize=50e6)  # 50MB chunks\nprint(f\"Dask dataframe: {dask_df}\")\n\n# Pandas-like operations (still lazy)\nresult = (dask_df\n          .groupby('category')['value']\n          .mean())\n\n# Compute when ready (parallelize)\nprint(result.compute())\n\n# More complex example: time-based aggregation\ndask_df['date'] = dd.to_datetime(dask_df['date'])\nhourly_avg = (dask_df\n              .set_index('date')\n              .resample('1D')['value']\n              .mean())\n\nprint(hourly_avg.compute().head())\n\n# Write results back to disk in parallel\ndask_df.to_parquet('output_*.parquet', engine='pyarrow')"
        ]
