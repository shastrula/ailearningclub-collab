          "python",
          "import pandas as pd\nimport numpy as np\n\ndef process_large_file_chunked(filepath, chunk_size=10000):\n    \"\"\"Process large CSV in chunks\"\"\"\n    aggregates = []\n    \n    # Read in chunks\n    for chunk in pd.read_csv(filepath, chunksize=chunk_size):\n        # Process chunk in memory\n        processed = chunk[chunk['value'] > 0].groupby('category')['value'].mean()\n        aggregates.append(processed)\n    \n    # Combine results\n    final_result = pd.concat(aggregates, axis=1).mean(axis=1)\n    return final_result\n\n# Example with streaming\ndef stream_process_csv(filepath):\n    \"\"\"Process CSV line-by-line without loading entire file\"\"\"\n    totals = {}\n    counts = {}\n    \n    for chunk in pd.read_csv(filepath, chunksize=1000):\n        for _, row in chunk.iterrows():\n            cat = row['category']\n            if cat not in totals:\n                totals[cat] = 0\n                counts[cat] = 0\n            \n            totals[cat] += row['value']\n            counts[cat] += 1\n    \n    # Compute averages\n    return {cat: totals[cat] / counts[cat] for cat in totals}\n\n# results = process_large_file_chunked('large_file.csv')\n# print(results)"
        ]
      ]
