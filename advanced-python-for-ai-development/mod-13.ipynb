          "python",
          "import numpy as np\nimport pandas as pd\nfrom memory_profiler import profile\nimport tracemalloc\n\n@profile  # Decorator adds memory tracking\ndef process_data_inefficient():\n    \"\"\"Inefficient: creates copies\"\"\"\n    data = np.random.randn(1000000, 100)\n    data2 = data * 2  # Copy!\n    data3 = data2 + 1  # Another copy!\n    return data3.sum()\n\n@profile\ndef process_data_efficient():\n    \"\"\"Efficient: in-place operations\"\"\"\n    data = np.random.randn(1000000, 100)\n    data *= 2  # In-place\n    data += 1  # In-place\n    return data.sum()\n\n# Manual memory tracking\ntracemalloc.start()\n\n# Do something\ndf = pd.DataFrame(np.random.randn(1000000, 50))\ngroupby_result = df.groupby(df.index // 1000).sum()\n\ncurrent, peak = tracemalloc.get_traced_memory()\nprint(f\"Current memory: {current / 1e6:.1f}MB, Peak: {peak / 1e6:.1f}MB\")\n\n# Find what consumed memory\ntop_stats = tracemalloc.take_snapshot().statistics('lineno')\nfor stat in top_stats[:3]:\n    print(stat)"
