          "python",
          "class SerializableMixin:\n    \"\"\"Mixin to add serialization capability.\"\"\"\n    def to_dict(self):\n        return {k: v for k, v in self.__dict__.items() if not k.startswith('_')}\n    \n    def to_json(self):\n        import json\n        return json.dumps(self.to_dict())\n    \n    @classmethod\n    def from_dict(cls, data):\n        instance = cls.__new__(cls)\n        instance.__dict__.update(data)\n        return instance\n\n\nclass LoggingMixin:\n    \"\"\"Mixin to add logging capability.\"\"\"\n    def log(self, message):\n        print(f\"[{self.__class__.__name__}] {message}\")\n\n\nclass CacheableMixin:\n    \"\"\"Mixin to add caching capability.\"\"\"\n    def __init__(self):\n        self._cache = {}\n    \n    def get_cached(self, key):\n        return self._cache.get(key)\n    \n    def set_cached(self, key, value):\n        self._cache[key] = value\n\n\n# Combine mixins with model classes\nclass CachedLoggedModel(SerializableMixin, LoggingMixin, CacheableMixin):\n    def __init__(self, name):\n        super().__init__()\n        self.name = name\n    \n    def train(self, data):\n        self.log(f\"Training model: {self.name}\")\n        result = self._complex_training(data)\n        self.set_cached('last_result', result)\n        return result\n    \n    def _complex_training(self, data):\n        return \"trained\"\n\nmodel = CachedLoggedModel(\"MyModel\")\nmodel.train([1, 2, 3])\nmodel.log(\"Training complete\")\nprint(model.to_json())"
        ]
