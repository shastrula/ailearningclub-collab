          "python",
          "class NeuralNetwork:\n    def __init__(self, layers, learning_rate=0.001):\n        self.layers = layers\n        self.learning_rate = learning_rate\n        self.weights = None\n        self.biases = None\n    \n    def initialize_parameters(self):\n        \"\"\"Initialize network weights using He initialization.\"\"\"\n        import numpy as np\n        self.weights = [np.random.randn(self.layers[i], self.layers[i+1]) * \n                        np.sqrt(2.0 / self.layers[i]) \n                        for i in range(len(self.layers) - 1)]\n        self.biases = [np.zeros((1, self.layers[i+1])) \n                       for i in range(len(self.layers) - 1)]\n    \n    def forward(self, X):\n        \"\"\"Forward pass through the network.\"\"\"\n        A = X\n        for W, b in zip(self.weights, self.biases):\n            Z = np.dot(A, W) + b\n            A = np.maximum(0, Z)  # ReLU activation\n        return A\n    \n    def get_config(self):\n        \"\"\"Return model configuration as dictionary.\"\"\"\n        return {\n            'layers': self.layers,\n            'learning_rate': self.learning_rate\n        }\n\n# Usage\nnn = NeuralNetwork([784, 128, 64, 10])\nnn.initialize_parameters()\nprint(f\"Network initialized with {len(nn.layers)} layers\")"
        ]
      ]
    },
