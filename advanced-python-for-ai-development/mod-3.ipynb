          "python",
          "class TrainingCallback:\n    \"\"\"Base callback class.\"\"\"\n    def on_epoch_start(self, epoch): pass\n    def on_epoch_end(self, epoch, loss): pass\n    def on_training_end(self, total_epochs): pass\n\n\nclass EarlyStoppingCallback(TrainingCallback):\n    def __init__(self, patience=5, min_delta=0.001):\n        self.patience = patience\n        self.min_delta = min_delta\n        self.best_loss = float('inf')\n        self.wait_count = 0\n    \n    def on_epoch_end(self, epoch, loss):\n        if loss < self.best_loss - self.min_delta:\n            self.best_loss = loss\n            self.wait_count = 0\n        else:\n            self.wait_count += 1\n        if self.wait_count >= self.patience:\n            print(f\"Early stopping at epoch {epoch}\")\n            return False\n        return True\n\n\nclass LoggingCallback(TrainingCallback):\n    def on_epoch_end(self, epoch, loss):\n        if epoch % 10 == 0:\n            print(f\"Epoch {epoch}: Loss = {loss:.4f}\")\n\n\nclass Trainer:\n    \"\"\"Model trainer with callback support.\"\"\"\n    def __init__(self):\n        self.callbacks = []\n    \n    def add_callback(self, callback):\n        self.callbacks.append(callback)\n    \n    def train(self, model, X, y, epochs=100):\n        for epoch in range(epochs):\n            for cb in self.callbacks:\n                cb.on_epoch_start(epoch)\n            \n            # Simulate training\n            loss = 1.0 / (1 + epoch * 0.01)\n            \n            for cb in self.callbacks:\n                cb.on_epoch_end(epoch, loss)\n        \n        for cb in self.callbacks:\n            cb.on_training_end(epochs)"
        ]
      ]
