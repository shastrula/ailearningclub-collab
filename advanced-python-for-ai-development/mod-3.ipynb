          "python",
          "class ModelEvaluation:\n    def __init__(self, true_positives, false_positives, false_negatives):\n        self.tp = true_positives\n        self.fp = false_positives\n        self.fn = false_negatives\n    \n    @property\n    def precision(self):\n        \"\"\"Precision = TP / (TP + FP)\"\"\"\n        if self.tp + self.fp == 0:\n            return 0\n        return self.tp / (self.tp + self.fp)\n    \n    @property\n    def recall(self):\n        \"\"\"Recall = TP / (TP + FN)\"\"\"\n        if self.tp + self.fn == 0:\n            return 0\n        return self.tp / (self.tp + self.fn)\n    \n    @property\n    def f1_score(self):\n        \"\"\"F1 = 2 * (precision * recall) / (precision + recall)\"\"\"\n        if self.precision + self.recall == 0:\n            return 0\n        return 2 * (self.precision * self.recall) / (self.precision + self.recall)\n    \n    @property\n    def summary(self):\n        return {\n            'precision': round(self.precision, 4),\n            'recall': round(self.recall, 4),\n            'f1': round(self.f1_score, 4)\n        }\n\n\neval_model = ModelEvaluation(90, 10, 5)\nprint(f\"Precision: {eval_model.precision:.4f}\")\nprint(f\"F1 Score: {eval_model.f1_score:.4f}\")\nprint(eval_model.summary)"
        ]
