          "python",
          "class ModelFactory:\n    \"\"\"Factory for creating different model instances.\"\"\"\n    _models = {}\n    \n    @classmethod\n    def register(cls, name, model_class):\n        cls._models[name] = model_class\n    \n    @classmethod\n    def create(cls, name, **kwargs):\n        if name not in cls._models:\n            raise ValueError(f\"Unknown model: {name}\")\n        return cls._models[name](**kwargs)\n\n\n# Register models\nModelFactory.register('linear', LinearRegression)\nModelFactory.register('logistic', LogisticRegression)\n\n# Create models\nmodel1 = ModelFactory.create('linear', regularization=0.01)\nmodel2 = ModelFactory.create('logistic', learning_rate=0.05)"
        ]
