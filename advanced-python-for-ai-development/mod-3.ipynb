          "python",
          "from abc import ABC, abstractmethod\nimport numpy as np\n\nclass BaseModel(ABC):\n    \"\"\"Abstract base class for all ML models.\"\"\"\n    def __init__(self, name):\n        self.name = name\n        self.is_fitted = False\n    \n    @abstractmethod\n    def fit(self, X, y):\n        pass\n    \n    @abstractmethod\n    def predict(self, X):\n        pass\n    \n    def get_model_info(self):\n        return f\"Model: {self.name}, Fitted: {self.is_fitted}\"\n\n\nclass LinearRegression(BaseModel):\n    \"\"\"Linear regression model using normal equation.\"\"\"\n    def __init__(self, regularization=0.0):\n        super().__init__(\"LinearRegression\")\n        self.regularization = regularization\n        self.coefficients = None\n        self.intercept = None\n    \n    def fit(self, X, y):\n        \"\"\"Fit using closed-form solution.\"\"\"\n        X_with_intercept = np.column_stack([np.ones(X.shape[0]), X])\n        reg_term = self.regularization * np.eye(X_with_intercept.shape[1])\n        self.coefficients = np.linalg.inv(\n            X_with_intercept.T @ X_with_intercept + reg_term\n        ) @ X_with_intercept.T @ y\n        self.intercept = self.coefficients[0]\n        self.is_fitted = True\n        return self\n    \n    def predict(self, X):\n        \"\"\"Generate predictions.\"\"\"\n        if not self.is_fitted:\n            raise ValueError(\"Model must be fitted before prediction\")\n        X_with_intercept = np.column_stack([np.ones(X.shape[0]), X])\n        return X_with_intercept @ self.coefficients\n\n\nclass LogisticRegression(BaseModel):\n    \"\"\"Logistic regression for binary classification.\"\"\"\n    def __init__(self, learning_rate=0.01, iterations=1000):\n        super().__init__(\"LogisticRegression\")\n        self.learning_rate = learning_rate\n        self.iterations = iterations\n        self.weights = None\n    \n    def fit(self, X, y):\n        \"\"\"SGD-based fitting.\"\"\"\n        self.weights = np.zeros(X.shape[1])\n        for _ in range(self.iterations):\n            predictions = 1 / (1 + np.exp(-X @ self.weights))\n            errors = predictions - y\n            self.weights -= self.learning_rate * (X.T @ errors) / len(y)\n        self.is_fitted = True\n        return self\n    \n    def predict(self, X):\n        \"\"\"Predict binary labels.\"\"\"\n        if not self.is_fitted:\n            raise ValueError(\"Model must be fitted before prediction\")\n        probabilities = 1 / (1 + np.exp(-X @ self.weights))\n        return (probabilities > 0.5).astype(int)\n\n\n# Usage\nmodels = [\n    LinearRegression(regularization=0.01),\n    LogisticRegression(learning_rate=0.1)\n]\n\nfor model in models:\n    print(model.get_model_info())"
        ]
      ]
    },
