          "python",
          "class ModelEvaluator:\n    \"\"\"Evaluates any model implementing fit/predict interface.\"\"\"\n    def __init__(self, model):\n        self.model = model\n    \n    def cross_validate(self, X, y, folds=5):\n        \"\"\"Simple k-fold cross-validation.\"\"\"\n        fold_size = len(X) // folds\n        scores = []\n        for i in range(folds):\n            test_start = i * fold_size\n            test_end = test_start + fold_size if i < folds - 1 else len(X)\n            \n            X_test = X[test_start:test_end]\n            y_test = y[test_start:test_end]\n            X_train = np.vstack([X[:test_start], X[test_end:]])\n            y_train = np.hstack([y[:test_start], y[test_end:]])\n            \n            self.model.fit(X_train, y_train)\n            predictions = self.model.predict(X_test)\n            accuracy = np.mean(predictions == y_test)\n            scores.append(accuracy)\n        \n        return {\n            'mean_accuracy': np.mean(scores),\n            'std_dev': np.std(scores),\n            'fold_scores': scores\n        }\n\n# Works with ANY model having fit/predict\nevaluator = ModelEvaluator(LinearRegression())\n# evaluator = ModelEvaluator(LogisticRegression())  # Same code works!"
        ]
      ]
