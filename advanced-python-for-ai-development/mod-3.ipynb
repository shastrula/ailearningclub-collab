          "python",
          "class SingletonMeta(type):\n    \"\"\"Metaclass that creates singleton classes.\"\"\"\n    _instances = {}\n    \n    def __call__(cls, *args, **kwargs):\n        if cls not in cls._instances:\n            cls._instances[cls] = super().__call__(*args, **kwargs)\n        return cls._instances[cls]\n\n\nclass GPUManager(metaclass=SingletonMeta):\n    \"\"\"Only one GPU manager can exist.\"\"\"\n    def __init__(self):\n        self.devices = []\n        print(\"Initializing GPU Manager\")\n    \n    def list_devices(self):\n        return self.devices\n\n\nclass ValidationMeta(type):\n    \"\"\"Metaclass that enforces method signatures.\"\"\"\n    def __new__(mcs, name, bases, namespace):\n        for attr_name, attr in namespace.items():\n            if callable(attr) and not attr_name.startswith('_'):\n                # Wrap methods to add validation\n                original_method = attr\n                def validated_method(self, *args, **kwargs):\n                    print(f\"Validating call to {attr_name}\")\n                    return original_method(self, *args, **kwargs)\n                namespace[attr_name] = validated_method\n        \n        return super().__new__(mcs, name, bases, namespace)\n\n\n# Usage\nmanager1 = GPUManager()\nmanager2 = GPUManager()\nprint(f\"Same instance: {manager1 is manager2}\")  # True"
        ]
      ]
