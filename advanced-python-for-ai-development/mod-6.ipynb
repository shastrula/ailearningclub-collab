          "python",
          "from bs4 import BeautifulSoup\nimport requests\nfrom typing import List, Dict\n\n# Fetch and parse HTML\nurl = 'https://example.com/products'\nresponse = requests.get(url)\nsoup = BeautifulSoup(response.content, 'html.parser')\n\n# Basic navigation\ntitle = soup.title.string                    # Get page title\nall_links = soup.find_all('a')              # All links\nfirst_paragraph = soup.find('p')            # First paragraph\ndiv_with_id = soup.find('div', id='main')   # By ID\ndiv_with_class = soup.find('div', class_='container')  # By class\n\n# Select by CSS selector (more flexible)\nproducts = soup.select('div.product')       # All divs with class 'product'\nprices = soup.select('span.price')          # All price spans\nbutton = soup.select_one('button#submit')   # First matching button\n\n# Extract text and attributes\nfor link in soup.find_all('a'):\n    href = link.get('href')                 # Get attribute value\n    text = link.get_text(strip=True)        # Get text content\n    print(f\"{text}: {href}\")\n\n# Navigate the tree\nparent = soup.find('span').parent           # Parent element\nsiblings = soup.find('p').next_siblings     # Following siblings\nchildren = soup.find('div').children        # Child elements\n\n# Recursively extract nested data\nclass ProductScraper:\n    def __init__(self, base_url: str):\n        self.base_url = base_url\n    \n    def scrape_products(self) -> List[Dict]:\n        \"\"\"Scrape product information.\"\"\"\n        response = requests.get(self.base_url)\n        soup = BeautifulSoup(response.content, 'html.parser')\n        \n        products = []\n        for product_div in soup.select('div.product-card'):\n            product = {\n                'name': product_div.select_one('h2.product-name').get_text(strip=True),\n                'price': float(\n                    product_div.select_one('span.price').get_text(strip=True).replace('$', '')\n                ),\n                'rating': float(\n                    product_div.select_one('span.rating').get_text(strip=True)\n                ),\n                'url': product_div.select_one('a.product-link')['href'],\n                'description': product_div.select_one('p.description').get_text(strip=True)\n            }\n            products.append(product)\n        \n        return products"
        ]
      ]
    },
