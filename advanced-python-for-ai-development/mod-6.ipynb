          "python",
          "from selenium import webdriver\nfrom selenium.webdriver.common.by import By\nfrom selenium.webdriver.support.ui import WebDriverWait\nfrom selenium.webdriver.support import expected_conditions as EC\n\nclass JavaScriptScraper:\n    def __init__(self):\n        self.driver = webdriver.Chrome()\n    \n    def scrape_dynamic_page(self, url: str) -> Dict:\n        \"\"\"Scrape content loaded by JavaScript.\"\"\"\n        self.driver.get(url)\n        \n        # Wait for element to load (up to 10 seconds)\n        wait = WebDriverWait(self.driver, 10)\n        element = wait.until(\n            EC.presence_of_element_located((By.CLASS_NAME, 'dynamic-content'))\n        )\n        \n        # JavaScript is now rendered, parse with BeautifulSoup\n        soup = BeautifulSoup(self.driver.page_source, 'html.parser')\n        \n        return {\n            'title': soup.find('h1').get_text(strip=True),\n            'content': soup.find('div', class_='dynamic-content').get_text(strip=True)\n        }\n    \n    def interact_and_scrape(self, url: str) -> List[Dict]:\n        \"\"\"Click button, fill form, then scrape.\"\"\"\n        self.driver.get(url)\n        wait = WebDriverWait(self.driver, 10)\n        \n        # Click button to load more content\n        load_more_btn = wait.until(\n            EC.element_to_be_clickable((By.ID, 'load-more'))\n        )\n        load_more_btn.click()\n        \n        # Wait for new content\n        wait.until(\n            EC.presence_of_all_elements_located((By.CLASS_NAME, 'new-item'))\n        )\n        \n        # Parse loaded content\n        soup = BeautifulSoup(self.driver.page_source, 'html.parser')\n        items = []\n        for item in soup.select('div.new-item'):\n            items.append({\n                'title': item.select_one('h3').get_text(strip=True),\n                'data': item.select_one('p').get_text(strip=True)\n            })\n        \n        return items\n    \n    def close(self):\n        self.driver.quit()\n\n\n# Playwright alternative (faster, more modern)\nfrom playwright.sync_api import sync_playwright\n\ndef scrape_with_playwright(url: str) -> List[Dict]:\n    \"\"\"Scrape using Playwright.\"\"\"\n    with sync_playwright() as p:\n        browser = p.chromium.launch()\n        page = browser.new_page()\n        page.goto(url)\n        \n        # Wait for dynamic content\n        page.wait_for_selector('div.dynamic-content')\n        \n        # Extract content\n        content = page.content()\n        soup = BeautifulSoup(content, 'html.parser')\n        \n        items = []\n        for item in soup.select('div.item'):\n            items.append({\n                'text': item.get_text(strip=True)\n            })\n        \n        browser.close()\n        return items"
        ]
      ]
    },
