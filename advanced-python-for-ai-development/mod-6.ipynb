          "python",
          "class DataExtractor:\n    @staticmethod\n    def safe_extract(soup, selector: str, attribute: str = None, default=None):\n        \"\"\"Extract data safely with fallback.\"\"\"\n        try:\n            element = soup.select_one(selector)\n            if element is None:\n                return default\n            \n            if attribute:\n                return element.get(attribute, default)\n            else:\n                return element.get_text(strip=True)\n        except Exception as e:\n            print(f\"Extraction error: {e}\")\n            return default\n    \n    @staticmethod\n    def extract_number(text: str, default: float = 0.0) -> float:\n        \"\"\"Extract first number from text.\"\"\"\n        import re\n        match = re.search(r'[\\d.]+', text.replace(',', ''))\n        return float(match.group()) if match else default\n    \n    @staticmethod\n    def extract_date(text: str) -> str:\n        \"\"\"Extract and normalize date.\"\"\"\n        import re\n        # Common date formats: Jan 15, 2024 or 2024-01-15\n        date_match = re.search(r'(\\w+\\s+\\d+,?\\s+\\d{4}|\\d{4}-\\d{2}-\\d{2})', text)\n        return date_match.group() if date_match else 'Unknown'\n\n\nclass ProductExtractor:\n    def __init__(self, soup):\n        self.soup = soup\n        self.extractor = DataExtractor()\n    \n    def extract_products(self) -> List[Dict]:\n        \"\"\"Extract products with error handling.\"\"\"\n        products = []\n        \n        for product_elem in self.soup.select('div.product'):\n            try:\n                product = {\n                    'name': self.extractor.safe_extract(\n                        product_elem, 'h2.name', default='Unknown'\n                    ),\n                    'price': self.extractor.extract_number(\n                        self.extractor.safe_extract(\n                            product_elem, 'span.price', default='0'\n                        )\n                    ),\n                    'rating': self.extractor.extract_number(\n                        self.extractor.safe_extract(\n                            product_elem, 'span.rating', default='0'\n                        )\n                    ),\n                    'url': self.extractor.safe_extract(\n                        product_elem, 'a', 'href', default='#'\n                    ),\n                    'in_stock': self._check_in_stock(product_elem)\n                }\n                products.append(product)\n            except Exception as e:\n                print(f\"Error extracting product: {e}\")\n                continue\n        \n        return products\n    \n    def _check_in_stock(self, element) -> bool:\n        \"\"\"Check if product is in stock.\"\"\"\n        stock_text = self.extractor.safe_extract(\n            element, 'span.stock', default='Out of Stock'\n        ).lower()\n        return 'in stock' in stock_text"
        ]
      ]
    },
