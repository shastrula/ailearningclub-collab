          "python",
          "import time\nimport requests\nfrom urllib.parse import urljoin, urlparse\nfrom datetime import datetime\n\nclass EthicalScraper:\n    def __init__(self, base_url: str, delay_seconds: float = 1.0):\n        self.base_url = base_url\n        self.delay_seconds = delay_seconds\n        self.last_request_time = 0\n        self.user_agent = (\n            'Mozilla/5.0 (Windows NT 10.0; Win64; x64) '\n            'AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0'\n        )\n    \n    def check_robots_txt(self) -> bool:\n        \"\"\"Check if scraping is allowed.\"\"\"\n        domain = urlparse(self.base_url).netloc\n        robots_url = f'https://{domain}/robots.txt'\n        \n        try:\n            response = requests.get(robots_url, timeout=5)\n            if response.status_code == 200:\n                disallowed = []\n                for line in response.text.split('\\n'):\n                    if line.startswith('Disallow:'):\n                        disallowed.append(line.split(':', 1)[1].strip())\n                \n                # Check if scraping is disallowed\n                if any(d == '/' for d in disallowed):\n                    print(f\"Warning: {domain} disallows all robots\")\n                    return False\n        except:\n            pass\n        \n        return True\n    \n    def get_crawl_delay(self) -> float:\n        \"\"\"Get crawl delay from robots.txt.\"\"\"\n        domain = urlparse(self.base_url).netloc\n        robots_url = f'https://{domain}/robots.txt'\n        \n        try:\n            response = requests.get(robots_url, timeout=5)\n            for line in response.text.split('\\n'):\n                if line.startswith('Crawl-delay:'):\n                    return float(line.split(':', 1)[1].strip())\n        except:\n            pass\n        \n        return self.delay_seconds\n    \n    def scrape_with_rate_limit(self, url: str) -> requests.Response:\n        \"\"\"Make request with respectful rate limiting.\"\"\"\n        # Check if enough time has passed\n        elapsed = time.time() - self.last_request_time\n        if elapsed < self.delay_seconds:\n            time.sleep(self.delay_seconds - elapsed)\n        \n        # Make request with user agent\n        headers = {'User-Agent': self.user_agent}\n        response = requests.get(url, headers=headers, timeout=10)\n        \n        self.last_request_time = time.time()\n        return response\n    \n    def scrape_multiple(self, urls: List[str]) -> List[Dict]:\n        \"\"\"Scrape multiple URLs respectfully.\"\"\"\n        if not self.check_robots_txt():\n            print(\"Scraping disallowed by robots.txt\")\n            return []\n        \n        results = []\n        for url in urls:\n            try:\n                response = self.scrape_with_rate_limit(url)\n                soup = BeautifulSoup(response.content, 'html.parser')\n                results.append({\n                    'url': url,\n                    'title': soup.title.string,\n                    'timestamp': datetime.now().isoformat()\n                })\n            except Exception as e:\n                print(f\"Error scraping {url}: {e}\")\n        \n        return results"
        ]
      ]
    },
