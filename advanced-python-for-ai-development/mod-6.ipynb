          "python",
          "import chardet\n\nclass RobustCharacterScraper:\n    @staticmethod\n    def detect_and_decode(response):\n        \"\"\"Detect encoding and decode properly.\"\"\"\n        # Try to detect encoding\n        detected = chardet.detect(response.content)\n        encoding = detected['encoding']\n        \n        try:\n            return response.content.decode(encoding)\n        except:\n            # Fallback to UTF-8 with error handling\n            return response.content.decode('utf-8', errors='replace')\n    \n    @staticmethod\n    def scrape_multilingual_content(url):\n        \"\"\"Scrape and handle multiple languages.\"\"\"\n        response = requests.get(url)\n        html_content = RobustCharacterScraper.detect_and_decode(response)\n        soup = BeautifulSoup(html_content, 'html.parser')\n        \n        content = {}\n        \n        # Extract by language\n        for lang_section in soup.find_all('section', attrs={'lang': True}):\n            lang = lang_section.get('lang')\n            text = lang_section.get_text(strip=True)\n            content[lang] = text\n        \n        return content\n    \n    @staticmethod\n    def normalize_unicode(text):\n        \"\"\"Normalize Unicode for consistent comparison.\"\"\"\n        import unicodedata\n        return unicodedata.normalize('NFKD', text)\n\n\n# Usage\nscraper = RobustCharacterScraper()\nmultilingual = scraper.scrape_multilingual_content('https://example.com/multilingual')"
        ]
      ]
    },
