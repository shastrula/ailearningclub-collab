          "python",
          "from celery import Celery\nfrom datetime import timedelta\n\napp = Celery('scraper_tasks')\n\nclass DistributedScraper:\n    @staticmethod\n    @app.task(bind=True, max_retries=3)\n    def scrape_url_task(self, url):\n        \"\"\"Task for distributed scraping.\"\"\"\n        try:\n            response = requests.get(url, timeout=10)\n            soup = BeautifulSoup(response.content, 'html.parser')\n            \n            data = {\n                'url': url,\n                'title': soup.title.string,\n                'content': soup.get_text()[:1000],\n                'links': [a.get('href') for a in soup.find_all('a')]\n            }\n            \n            return data\n        \n        except Exception as exc:\n            # Retry with exponential backoff\n            retry_in = 2 ** self.request.retries\n            raise self.retry(exc=exc, countdown=retry_in)\n    \n    @staticmethod\n    def scrape_urls_distributed(urls):\n        \"\"\"Scrape multiple URLs using task queue.\"\"\"\n        tasks = [DistributedScraper.scrape_url_task.delay(url) for url in urls]\n        results = [task.get() for task in tasks]\n        return results\n\n\n# Schedule periodic scraping\n@app.task\ndef periodic_scrape():\n    \"\"\"Scrape at regular intervals.\"\"\"\n    urls = ['https://example1.com', 'https://example2.com']\n    DistributedScraper.scrape_urls_distributed(urls)\n\n# In Celery beat configuration:\n# periodic_scrape.apply_async(countdown=60)"
        ]
      ]
    },
