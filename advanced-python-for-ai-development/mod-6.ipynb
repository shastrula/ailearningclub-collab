          "python",
          "# Element selectors\ndiv = soup.select('div')                    # All divs\np = soup.select('p')                        # All paragraphs\n\n# Class selectors\nhighlighted = soup.select('.highlight')     # All with class 'highlight'\nboxes = soup.select('div.box')              # Divs with class 'box'\n\n# ID selectors\nheader = soup.select('#header')             # Element with id 'header'\nnav = soup.select('nav#main-nav')           # Nav with id 'main-nav'\n\n# Attribute selectors\nexternal_links = soup.select('a[target=\"_blank\"]')  # Links opening in new tab\nrequired_fields = soup.select('input[required]')     # Required inputs\nimages = soup.select('img[alt]')            # Images with alt text\n\n# Pseudo-selectors\nfirst_child = soup.select('li:first-child')  # First list item\nlast_child = soup.select('li:last-child')    # Last list item\nnth_child = soup.select('tr:nth-child(2n)')  # Even rows\n\n# Combinators\nchildren = soup.select('div > p')           # Direct p children of div\ndescendants = soup.select('div p')          # Any p inside div\nadjacent = soup.select('h2 + p')            # p immediately after h2\nsiblings = soup.select('h2 ~ p')            # All p siblings after h2\n\n# Complex selectors\ncomplex_sel = soup.select('article.featured > div.content > p:first-child')"
