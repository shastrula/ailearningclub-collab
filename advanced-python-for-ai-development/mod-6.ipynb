          "python",
          "from selenium.webdriver.chrome.options import Options\nfrom selenium.webdriver.support.ui import Select\nimport time\n\nclass AdvancedJavaScriptScraper:\n    def __init__(self, headless=True):\n        options = Options()\n        if headless:\n            options.add_argument('--headless')\n        options.add_argument('--no-sandbox')\n        options.add_argument('--disable-dev-shm-usage')\n        self.driver = webdriver.Chrome(options=options)\n    \n    def scrape_spa_application(self, url):\n        \"\"\"Scrape single-page application (React, Vue, Angular).\"\"\"\n        self.driver.get(url)\n        \n        # Wait for JavaScript framework to render\n        WebDriverWait(self.driver, 10).until(\n            lambda d: d.execute_script(\"return document.readyState\") == \"complete\"\n        )\n        \n        # Additional wait for specific elements\n        WebDriverWait(self.driver, 10).until(\n            EC.presence_of_all_elements_located((By.CLASS_NAME, 'data-loaded'))\n        )\n        \n        # Extract rendered content\n        soup = BeautifulSoup(self.driver.page_source, 'html.parser')\n        return soup\n    \n    def scrape_infinite_scroll(self, url, scroll_height=5):\n        \"\"\"Handle infinite scroll pagination.\"\"\"\n        self.driver.get(url)\n        items = []\n        \n        for i in range(scroll_height):\n            # Scroll to bottom\n            self.driver.execute_script(\"window.scrollTo(0, document.body.scrollHeight);\")\n            \n            # Wait for new content\n            time.sleep(2)\n            \n            # Extract items\n            soup = BeautifulSoup(self.driver.page_source, 'html.parser')\n            new_items = soup.select('div.item')\n            \n            if len(new_items) == len(items):\n                break  # No new content loaded\n            \n            items = new_items\n        \n        return items\n    \n    def fill_and_submit_form(self, url, form_data):\n        \"\"\"Fill form fields and submit.\"\"\"\n        self.driver.get(url)\n        \n        # Fill text inputs\n        for field_id, value in form_data.items():\n            element = WebDriverWait(self.driver, 10).until(\n                EC.presence_of_element_located((By.ID, field_id))\n            )\n            element.send_keys(value)\n        \n        # Select dropdown\n        select_element = Select(self.driver.find_element(By.NAME, 'category'))\n        select_element.select_by_value('electronics')\n        \n        # Click submit\n        submit_btn = self.driver.find_element(By.CSS_SELECTOR, 'button[type=\"submit\"]')\n        submit_btn.click()\n        \n        # Wait for results\n        WebDriverWait(self.driver, 10).until(\n            EC.presence_of_element_located((By.CLASS_NAME, 'results'))\n        )\n        \n        soup = BeautifulSoup(self.driver.page_source, 'html.parser')\n        return soup.select('div.result-item')\n    \n    def execute_javascript_extraction(self, url, js_code):\n        \"\"\"Execute custom JavaScript for complex extraction.\"\"\"\n        self.driver.get(url)\n        \n        # Execute JavaScript that returns data\n        result = self.driver.execute_script(js_code)\n        return result\n    \n    def close(self):\n        self.driver.quit()\n\n\n# Example JavaScript extraction\njs_code = \"\"\"\nreturn document.querySelectorAll('.product').map(el => ({\n    name: el.querySelector('.title').textContent,\n    price: parseFloat(el.querySelector('.price').textContent),\n    reviews: el.querySelectorAll('.review').length\n}));\n\"\"\""
        ]
