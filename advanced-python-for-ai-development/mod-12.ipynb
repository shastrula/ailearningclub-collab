          "python",
          "import gymnasium as gym\nimport numpy as np\n\n# Load a standard environment\nenv = gym.make(\"CartPole-v1\", render_mode=\"human\")\n\n# Get environment information\nprint(f\"Observation space: {env.observation_space}\")\nprint(f\"Action space: {env.action_space}\")\nprint(f\"Observation shape: {env.observation_space.shape}\")\nprint(f\"Number of actions: {env.action_space.n}\")\n\n# Episode: sequence of steps until terminal state\nobservation, info = env.reset(seed=42)\nprint(f\"Initial observation: {observation}\")\n\ntotal_reward = 0\nfor step in range(500):\n    # Random action\n    action = env.action_space.sample()\n    \n    # Take action and receive feedback\n    observation, reward, terminated, truncated, info = env.step(action)\n    total_reward += reward\n    \n    # Episode ends if terminated (lost) or truncated (max steps)\n    if terminated or truncated:\n        print(f\"Episode ended after {step + 1} steps, total reward: {total_reward}\")\n        break\n\nenv.close()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import gymnasium as gym\nimport numpy as np\n\nclass QLearningAgent:\n    def __init__(self, state_size, action_size, learning_rate=0.1, discount=0.99, epsilon=0.1):\n        self.state_size = state_size\n        self.action_size = action_size\n        self.lr = learning_rate\n        self.gamma = discount\n        self.epsilon = epsilon\n        \n        # Q-table: state \u2192 action values\n        self.q_table = np.zeros((state_size, action_size))\n    \n    def discretize_state(self, observation):\n        \"\"\"Convert continuous observation to discrete state\"\"\"\n        # For CartPole: 4 continuous values \u2192 1 discrete state\n        # Simplified discretization (in practice, use better binning)\n        state = (observation[0] + 2.4) / 4.8 * 10\n        state = int(np.clip(state, 0, 9))\n        return state\n    \n    def select_action(self, state, training=True):\n        \"\"\"Epsilon-greedy action selection\"\"\"\n        if training and np.random.random() < self.epsilon:\n            return np.random.randint(self.action_size)  # Explore\n        return np.argmax(self.q_table[state])  # Exploit\n    \n    def update(self, state, action, reward, next_state, done):\n        \"\"\"Q-learning update\"\"\"\n        current_q = self.q_table[state, action]\n        max_next_q = np.max(self.q_table[next_state]) if not done else 0\n        \n        # Update Q-value toward target\n        target = reward + self.gamma * max_next_q\n        self.q_table[state, action] += self.lr * (target - current_q)\n\n# Train Q-learning agent\nenv = gym.make(\"CartPole-v1\")\nagent = QLearningAgent(state_size=10, action_size=2)\n\nepisodes = 100\nfor episode in range(episodes):\n    observation, _ = env.reset()\n    state = agent.discretize_state(observation)\n    total_reward = 0\n    \n    for step in range(500):\n        action = agent.select_action(state, training=True)\n        observation, reward, terminated, truncated, _ = env.step(action)\n        next_state = agent.discretize_state(observation)\n        \n        agent.update(state, action, reward, next_state, terminated or truncated)\n        \n        state = next_state\n        total_reward += reward\n        \n        if terminated or truncated:\n            break\n    \n    if (episode + 1) % 20 == 0:\n        print(f\"Episode {episode + 1}, Reward: {total_reward}\")\n\nenv.close()"
        ]
      ]
