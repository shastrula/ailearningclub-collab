          "python",
          "import gymnasium as gym\nimport numpy as np\n\nclass RewardShaper:\n    \"\"\"Modify environment rewards to accelerate learning\"\"\"\n    \n    def __init__(self, env):\n        self.env = env\n        self.phi_prev = 0  # Previous potential\n    \n    def shape_reward(self, observation, reward, done):\n        \"\"\"\n        Potential-based reward shaping:\n        r'(s,a,s') = r(s,a,s') + \u03b3*\u03c6(s') - \u03c6(s)\n        \"\"\"\n        # Define potential function \u03a6(state) for CartPole\n        # Reward progress toward keeping pole upright\n        x, x_dot, theta, theta_dot = observation\n        \n        # Potential based on angle from vertical (theta=0 is goal)\n        phi_curr = -abs(theta)  # Negative angle magnitude\n        \n        # Shaped reward = original + discounted future potential - current potential\n        shaped = reward + 0.99 * phi_curr - self.phi_prev\n        self.phi_prev = phi_curr\n        \n        if done:\n            self.phi_prev = 0  # Reset for next episode\n        \n        return shaped\n\n# Example: compare learning with and without reward shaping\nenv = gym.make(\"CartPole-v1\")\nshaper = RewardShaper(env)\n\nobservation, _ = env.reset()\nfor step in range(100):\n    action = env.action_space.sample()\n    observation, reward, terminated, truncated, _ = env.step(action)\n    \n    shaped_reward = shaper.shape_reward(observation, reward, terminated or truncated)\n    \n    if step < 5:\n        print(f\"Step {step}: original={reward}, shaped={shaped_reward:.3f}\")\n    \n    if terminated or truncated:\n        break\n\nenv.close()"
        ]
