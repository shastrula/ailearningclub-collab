          "python",
          "import gymnasium as gym\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport numpy as np\n\nclass PolicyGradientAgent(nn.Module):\n    def __init__(self, state_size, action_size):\n        super().__init__()\n        self.fc1 = nn.Linear(state_size, 128)\n        self.fc2 = nn.Linear(128, action_size)\n    \n    def forward(self, state):\n        x = torch.relu(self.fc1(state))\n        action_logits = self.fc2(x)\n        return torch.softmax(action_logits, dim=-1)\n\nclass PGTrainer:\n    def __init__(self, agent, learning_rate=0.01, gamma=0.99):\n        self.agent = agent\n        self.optimizer = optim.Adam(agent.parameters(), lr=learning_rate)\n        self.gamma = gamma\n    \n    def compute_returns(self, rewards):\n        \"\"\"Compute discounted cumulative rewards\"\"\"\n        returns = []\n        cumulative = 0\n        for r in reversed(rewards):\n            cumulative = r + self.gamma * cumulative\n            returns.insert(0, cumulative)\n        return torch.tensor(returns, dtype=torch.float32)\n    \n    def train_episode(self, env):\n        observation, _ = env.reset()\n        states, actions, rewards = [], [], []\n        \n        # Collect episode trajectory\n        for step in range(500):\n            state = torch.tensor(observation, dtype=torch.float32)\n            \n            # Sample action from policy\n            with torch.no_grad():\n                action_probs = self.agent(state)\n            \n            action = np.random.choice(len(action_probs), p=action_probs.numpy())\n            observation, reward, terminated, truncated, _ = env.step(action)\n            \n            states.append(state)\n            actions.append(action)\n            rewards.append(reward)\n            \n            if terminated or truncated:\n                break\n        \n        # Compute returns and update policy\n        returns = self.compute_returns(rewards)\n        states_tensor = torch.stack(states)\n        \n        # Compute policy gradient\n        action_probs = self.agent(states_tensor)\n        action_log_probs = torch.log(action_probs[range(len(actions)), actions] + 1e-8)\n        \n        # Policy gradient: maximize expected return\n        loss = -(action_log_probs * (returns - returns.mean())).mean()\n        \n        self.optimizer.zero_grad()\n        loss.backward()\n        self.optimizer.step()\n        \n        return sum(rewards)\n\n# Train policy gradient agent\nenv = gym.make(\"CartPole-v1\")\nagent = PolicyGradientAgent(state_size=4, action_size=2)\ntrainer = PGTrainer(agent)\n\nfor episode in range(50):\n    total_reward = trainer.train_episode(env)\n    if (episode + 1) % 10 == 0:\n        print(f\"Episode {episode + 1}, Reward: {total_reward}\")\n\nenv.close()"
        ]
      ]
