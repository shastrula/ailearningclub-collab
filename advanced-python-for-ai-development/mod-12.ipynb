          "python",
          "import gymnasium as gym\nimport matplotlib.pyplot as plt\nimport numpy as np\n\nclass TrainingMonitor:\n    def __init__(self, window_size=100):\n        self.rewards = []\n        self.window_size = window_size\n    \n    def record_episode(self, reward):\n        self.rewards.append(reward)\n    \n    def plot_progress(self):\n        \"\"\"Plot training progress with moving average\"\"\"\n        fig, ax = plt.subplots(figsize=(10, 5))\n        \n        # Individual episode rewards\n        ax.plot(self.rewards, alpha=0.3, label='Episode Reward')\n        \n        # Moving average\n        if len(self.rewards) >= self.window_size:\n            moving_avg = np.convolve(\n                self.rewards, \n                np.ones(self.window_size) / self.window_size,\n                mode='valid'\n            )\n            ax.plot(moving_avg, label=f'{self.window_size}-Episode Average', linewidth=2)\n        \n        ax.set_xlabel('Episode')\n        ax.set_ylabel('Reward')\n        ax.set_title('Training Progress')\n        ax.legend()\n        ax.grid(True, alpha=0.3)\n        plt.show()\n    \n    def get_average_reward(self, last_n=100):\n        \"\"\"Get average reward over last N episodes\"\"\"\n        return np.mean(self.rewards[-last_n:])\n\n# Simulate training\nmonitor = TrainingMonitor()\n\n# Simulate learning curve (in practice, from actual training)\nfor episode in range(200):\n    # Simulated reward increases over time\n    reward = 50 + episode * 0.5 + np.random.randn() * 20\n    monitor.record_episode(reward)\n\nprint(f\"Average reward (last 50 episodes): {monitor.get_average_reward(50):.1f}\")\nmonitor.plot_progress()"
        ]
      ]
