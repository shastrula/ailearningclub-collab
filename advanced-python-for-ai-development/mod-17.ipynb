      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Advanced Python For Ai Development - mod-17\n\n",
        "**Course:** advanced-python-for-ai-development\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create feature branch from main\ngit checkout -b feature/add-model-evaluation\n\n# Edit files\necho \"def evaluate_model(model, X_test, y_test):\" >> eval.py\n\n# Commit changes\ngit add eval.py\ngit commit -m \"feat: add model evaluation function\"\n\n# Push to remote\ngit push -u origin feature/add-model-evaluation\n\n# Create pull request on GitHub/GitLab\n# After review and approval:\ngit checkout main\ngit pull origin main\ngit merge --no-ff feature/add-model-evaluation\ngit push origin main\n\n# Delete feature branch\ngit branch -d feature/add-model-evaluation\ngit push origin --delete feature/add-model-evaluation"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Initialize gitflow\ngit flow init\n\n# Create feature from develop\ngit flow feature start model-optimization\n# Creates: feature/model-optimization from develop\n\n# Complete feature (merge back to develop, delete branch)\ngit flow feature finish model-optimization\n\n# Create release branch (from develop)\ngit flow release start 1.2.0\n# Creates: release/1.2.0\n\n# Finish release (merge to main and develop, tag as 1.2.0)\ngit flow release finish 1.2.0\n\n# Hotfix for production bug\ngit flow hotfix start 1.2.1\ngit flow hotfix finish 1.2.1\n# Merges to main, tags as 1.2.1, merges back to develop"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Two developers edit different functions\n# main: function A() and function B()\n# feature: function A() modified, function C() added\n\n# Merge feature into main\ngit checkout main\ngit merge feature\n\n# If no conflicts: fast-forward or creates merge commit\n# If conflicts: edit files, resolve, commit\n\n# Example conflict in evaluate.py:\n<<<<<<< HEAD (main)\ndef evaluate_model(model, X_test, y_test):\n    return accuracy_score(y_test, model.predict(X_test))\n=======\ndef evaluate_model(model, X_test, y_test, threshold=0.5):\n    predictions = (model.predict_proba(X_test)[:, 1] > threshold).astype(int)\n    return accuracy_score(y_test, predictions)\n>>>>>>> feature\n\n# Resolve: keep both, edit to your preferred version\ndef evaluate_model(model, X_test, y_test, threshold=0.5):\n    predictions = (model.predict_proba(X_test)[:, 1] > threshold).astype(int)\n    return accuracy_score(y_test, predictions)\n\ngit add evaluate.py\ngit commit -m \"Merge feature: add threshold parameter\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Rebasing rewrites commit history\u2014use on branches, never on main\ngit checkout feature\ngit rebase main\n\n# This replays feature commits on top of main's latest commit\n# Result: clean, linear history\n\n# If conflicts occur during rebase:\n# 1. Fix conflicts in files\ngit add .\n# 2. Continue rebase\ngit rebase --continue\n\n# To abort rebase if it goes wrong:\ngit rebase --abort"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Feature branch has 20 messy commits:\n# - WIP: add model\n# - fix typo\n# - oops, wrong import\n# - fix evaluation metric\n# - ...\n\ngit checkout main\ngit merge --squash feature/model-training\n# Squashes all feature commits into single staged commit\n\ngit commit -m \"feat: add model training pipeline\"\n# Main now has one clean commit instead of 20\n\ngit push origin main"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Install Git LFS\n# macOS: brew install git-lfs\n# After install: git lfs install\n\n# Track large files\ngit lfs track \"*.pkl\"\ngit lfs track \"*.h5\"\ngit lfs track \"data/train/*.csv\"\n\n# This updates .gitattributes\ncat .gitattributes\n# *.pkl filter=lfs diff=lfs merge=lfs -text\n# *.h5 filter=lfs diff=lfs merge=lfs -text\n\n# Now git add/commit large files normally\ngit add model.pkl\ngit add training_data.csv\ngit commit -m \"Add trained model and dataset\"\n\n# Git LFS handles storage; your repo stays small\ngit push origin main\n\n# Collaborators fetch LFS files automatically on clone/pull\ngit clone repo  # Gets metadata pointers + LFS files"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# See LFS-tracked files\ngit lfs ls-files\n\n# See repo size\ndu -sh .git  # Without LFS: might be 500MB+\n             # With LFS: typically <50MB"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Install pre-commit framework\npip install pre-commit\n\n# Create .pre-commit-config.yaml\ncat > .pre-commit-config.yaml << 'EOF'\nrepos:\n  - repo: https://github.com/pre-commit/pre-commit-hooks\n    rev: v4.1.0\n    hooks:\n      - id: trailing-whitespace\n      - id: end-of-file-fixer\n      - id: check-yaml\n      - id: detect-private-key\n  \n  - repo: https://github.com/psf/black\n    rev: 22.3.0\n    hooks:\n      - id: black\n  \n  - repo: https://github.com/PyCQA/flake8\n    rev: 4.0.1\n    hooks:\n      - id: flake8\n  \n  - repo: https://github.com/PyCQA/pylint\n    rev: pylint-2.13.5\n    hooks:\n      - id: pylint\n        additional_dependencies: ['pandas', 'numpy']\nEOF\n\n# Install hooks\npre-commit install\n\n# Now, on every commit, hooks run:\ngit add model.py\ngit commit -m \"Add model code\"\n# Hooks run: check trailing whitespace, format with black, lint with flake8\n# If any hook fails, commit is blocked until fixed"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Developer A: creates branch, makes changes\ngit checkout -b feature/improve-preprocessing\n# ... edit preprocessing.py, train.py ...\ngit push -u origin feature/improve-preprocessing\n\n# Creates pull request on GitHub\n# In PR description:\n# - What changed (preprocessing pipeline optimization)\n# - Why (reduced training time by 30%)\n# - Testing (ran test suite locally, all pass)\n# - Related issues (#42)\n\n# Developer B: reviews code\n# On GitHub: \"Looks good, but could you add docstring to normalize_features()?\"\n\n# Developer A: makes requested changes\n# git add preprocessing.py && git commit -m \"Add docstring to normalize_features\"\n# git push origin feature/improve-preprocessing\n\n# Approval: Developer B approves\n# Merge: auto-merged to main, branch deleted"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Exploratory work doesn't go to main; use feature branches\ngit checkout -b experiment/neural-net-v2\n# ... train new architecture for days ...\ngit push origin experiment/neural-net-v2\n\n# If successful: create PR, review, merge\n# If unsuccessful: delete without merging\ngit branch -D experiment/neural-net-v2\ngit push origin --delete experiment/neural-net-v2"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# On GitHub: Settings \u2192 Branches \u2192 Branch Protection Rules\n# For \"main\" branch:\n- Require pull request reviews before merging (2 reviewers)\n- Require status checks to pass (CI/CD must pass)\n- Require branches to be up to date before merging\n- Dismiss stale PR approvals when new commits pushed\n\n# Now, no one can directly push to main\ngit push origin main\n# error: [remote rejected] main (protected branch hook declined)\n\n# Must go through PR, reviews, and CI/CD checks"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# You're on feature/model-v2, but need to switch to hotfix urgently\n# Without committing, save work:\ngit stash\n\n# Switch branches (now clean)\ngit checkout main\ngit checkout -b hotfix/critical-bug\n\n# Fix bug, commit, push\ngit add .\ngit commit -m \"fix: critical inference bug\"\ngit push\n\n# Back to feature work\ngit checkout feature/model-v2\ngit stash pop  # Restores your stashed changes\n\n# If stash conflicts with main changes:\ngit stash pop  # Shows conflicts\n# Resolve conflicts manually\ngit add .\ngit commit -m \"Resolve stash conflicts\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# You have commit abc123 on feature/old-model that you want on main\n# Without merging entire branch:\ngit checkout main\ngit cherry-pick abc123\n\n# Applies just that commit to main\n# Useful for: backporting fixes, applying selective changes\n\n# Cherry-pick range of commits:\ngit cherry-pick abc123..def456"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Tag a release version\ngit tag -a v1.2.0 -m \"Release version 1.2.0\"\ngit push origin v1.2.0\n\n# Clients clone specific versions:\ngit clone --depth 1 --branch v1.2.0 https://github.com/repo.git\n\n# List tags\ngit tag -l\n\n# Delete tag (if mistake)\ngit tag -d v1.2.0\ngit push origin :v1.2.0  # Delete from remote"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Best practice: strip notebook output before committing\n# Add to .gitattributes\n*.ipynb filter=nbstripout\n\n# Install nbstripout\npip install nbstripout\nnbstripout --install  # Install Git filter\n\n# Now, notebooks are stored without output (smaller, cleaner diffs)\n# But you see output locally"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create experiment branch\ngit checkout -b exp/random-forest-tuning\n\n# Do work: train models, evaluate, log metrics\necho \"accuracy: 0.94, precision: 0.92, recall: 0.95\" > metrics.txt\ngit add metrics.txt\ngit commit -m \"exp: RF with max_depth=15, n_estimators=200\"\n\n# Push without merging to main\ngit push origin exp/random-forest-tuning\n\n# Later, review experiments:\ngit branch -r | grep exp/  # List all experiment branches\ngit diff main exp/random-forest-tuning  # Compare with main\n\n# Keep successful experiments, delete failed ones\ngit push origin --delete exp/failed-experiment"
        ]
      ]
    }
