          "import torch\nimport torchvision.models as models\n\n# ===== PyTorch: Export and Serve =====\nmodel = models.resnet18(pretrained=True)\nmodel.eval()\n\n# Export to TorchScript\nexample_input = torch.randn(1, 3, 224, 224)\ntraced_model = torch.jit.trace(model, example_input)\ntraced_model.save(\"model.pt\")\n\n# Load for inference\nloaded_model = torch.jit.load(\"model.pt\")\noutput = loaded_model(example_input)\n\n# ===== TensorFlow: SavedModel Format =====\nimport tensorflow as tf\n\nmodel_tf = tf.keras.applications.ResNet50(weights='imagenet')\nmodel_tf.save('model')  # Saves in SavedModel format\n\n# Load for inference\nloaded_tf_model = tf.keras.models.load_model('model')\nprediction = loaded_tf_model(tf.random.normal([1, 224, 224, 3]))"
