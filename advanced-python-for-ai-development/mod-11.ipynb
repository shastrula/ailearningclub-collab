          "python",
          "import torch\nimport torch.nn as nn\nimport tensorflow as tf\n\n# ===== Migration: PyTorch to TensorFlow =====\n# Original PyTorch model\nclass PyTorchModel(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.fc1 = nn.Linear(10, 64)\n        self.relu = nn.ReLU()\n        self.fc2 = nn.Linear(64, 1)\n    \n    def forward(self, x):\n        x = self.fc1(x)\n        x = self.relu(x)\n        x = self.fc2(x)\n        return x\n\n# Equivalent TensorFlow model\nclass TensorFlowModel(tf.keras.Model):\n    def __init__(self):\n        super().__init__()\n        self.fc1 = tf.keras.layers.Dense(64, activation='relu', input_shape=(10,))\n        self.fc2 = tf.keras.layers.Dense(1)\n    \n    def call(self, x):\n        x = self.fc1(x)\n        x = self.fc2(x)\n        return x\n\n# Both accept same input shape and produce same output shape\nx = torch.randn(32, 10)\npt_model = PyTorchModel()\npt_out = pt_model(x)\n\nx_tf = tf.random.normal([32, 10])\ntf_model = TensorFlowModel()\ntf_out = tf_model(x_tf)\n\nprint(f\"PyTorch output: {pt_out.shape}, TensorFlow output: {tf_out.shape}\")\n\n# ===== ONNX: Framework-Agnostic Format =====\n# Export PyTorch to ONNX\ndummy_input = torch.randn(1, 10)\ntorch.onnx.export(pt_model, dummy_input, \"model.onnx\",\n                 input_names=['input'], output_names=['output'],\n                 opset_version=11)\n\n# Load ONNX model in any framework supporting ONNX\n# (TensorFlow, ONNX Runtime, CoreML, etc.)"
