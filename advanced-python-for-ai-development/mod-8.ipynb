          "python",
          "class LearningRateScheduler:\n    @staticmethod\n    def exponential_decay(optimizer, epoch, initial_lr=0.1, decay_rate=0.96):\n        \"\"\"Exponential decay schedule.\"\"\"\n        new_lr = initial_lr * (decay_rate ** epoch)\n        for param_group in optimizer.param_groups:\n            param_group['lr'] = new_lr\n        return new_lr\n    \n    @staticmethod\n    def step_decay(optimizer, epoch, initial_lr=0.1, drop=0.5, epochs_drop=10):\n        \"\"\"Step-wise decay.\"\"\"\n        new_lr = initial_lr * (drop ** (epoch // epochs_drop))\n        for param_group in optimizer.param_groups:\n            param_group['lr'] = new_lr\n        return new_lr\n    \n    @staticmethod\n    def cosine_annealing(optimizer, epoch, initial_lr=0.1, total_epochs=100):\n        \"\"\"Cosine annealing schedule.\"\"\"\n        new_lr = initial_lr * (1 + np.cos(np.pi * epoch / total_epochs)) / 2\n        for param_group in optimizer.param_groups:\n            param_group['lr'] = new_lr\n        return new_lr\n\n\n# PyTorch built-in schedulers\nmodel = nn.Linear(10, 5)\noptimizer = torch.optim.SGD(model.parameters(), lr=0.1)\n\n# Step scheduler\nscheduler = torch.optim.lr_scheduler.StepLR(optimizer, step_size=10, gamma=0.1)\n\n# Cosine annealing\nscheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=100)\n\n# OneCycleLR (popular for finding good LR)\nscheduler = torch.optim.lr_scheduler.OneCycleLR(\n    optimizer, max_lr=0.1, steps_per_epoch=100, epochs=10\n)\n\nfor epoch in range(10):\n    for X_batch, y_batch in train_loader:\n        output = model(X_batch)\n        loss = loss_fn(output, y_batch)\n        optimizer.zero_grad()\n        loss.backward()\n        optimizer.step()\n        scheduler.step()"
        ]
      ]
