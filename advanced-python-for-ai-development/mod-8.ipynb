          "python",
          "class ProductionModel:\n    def __init__(self, model_path):\n        self.model_path = model_path\n        self.model = None\n        self.device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n        self.scaler = None\n    \n    def load_model(self):\n        \"\"\"Load model from disk.\"\"\"\n        self.model = torch.load(self.model_path)\n        self.model.to(self.device)\n        self.model.eval()\n    \n    def preprocess(self, X):\n        \"\"\"Preprocess input data.\"\"\"\n        if self.scaler is None:\n            self.scaler = StandardScaler()\n        \n        X_scaled = self.scaler.transform(X)\n        X_tensor = torch.tensor(X_scaled, dtype=torch.float32).to(self.device)\n        return X_tensor\n    \n    def predict(self, X, return_confidence=False):\n        \"\"\"Make predictions.\"\"\"\n        with torch.no_grad():\n            X_tensor = self.preprocess(X)\n            output = self.model(X_tensor)\n            \n            if return_confidence:\n                probs = F.softmax(output, dim=1)\n                predictions = probs.argmax(dim=1).cpu().numpy()\n                confidence = probs.max(dim=1)[0].cpu().numpy()\n                return predictions, confidence\n            else:\n                return output.argmax(dim=1).cpu().numpy()\n    \n    def batch_predict(self, X, batch_size=32):\n        \"\"\"Predict on large datasets efficiently.\"\"\"\n        predictions = []\n        for i in range(0, len(X), batch_size):\n            batch = X[i:i+batch_size]\n            batch_pred = self.predict(batch)\n            predictions.extend(batch_pred)\n        return np.array(predictions)\n\n\n# Usage\nprod_model = ProductionModel('model.pth')\nprod_model.load_model()\npredictions = prod_model.predict(X_test, return_confidence=True)"
