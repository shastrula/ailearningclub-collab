          "python",
          "# Gradient computation with autograd\nx = torch.tensor([2.0, 3.0], requires_grad=True)  # Enable gradient tracking\ny = x ** 2 + 2 * x + 1                          # Forward pass\nz = y.sum()                                      # Scalar loss\n\nz.backward()                                     # Backpropagation\nprint(f\"Gradients: {x.grad}\")                    # dz/dx = [2*x + 2] = [6.0, 8.0]\n\n# Manual gradient computation\nx.grad.zero_()                                   # Clear previous gradients\n\n# Custom function with gradients\ndef custom_loss(x):\n    return (x ** 2).sum()\n\nx = torch.tensor([1.0, 2.0, 3.0], requires_grad=True)\nloss = custom_loss(x)\nloss.backward()\nprint(f\"Gradients: {x.grad}\")                    # [2.0, 4.0, 6.0]\n\n# Gradient accumulation\nfor i in range(3):\n    x.grad.zero_()  # Clear gradients\n    y = (x ** 2).sum()\n    y.backward()\n    print(f\"Iteration {i}: gradients = {x.grad}\")\n\n# Detaching tensors (stop gradient flow)\nx = torch.tensor([1.0, 2.0], requires_grad=True)\ny = x ** 2\nz = y.detach()                                   # z doesn't track gradients\nw = z + 1\nw.sum().backward()                              # Backprop only to x (not from z)\nprint(f\"x.grad: {x.grad}\")                      # None, because z is detached\n\n# Gradient clipping (prevent exploding gradients)\ngradients = torch.randn(5, requires_grad=True)\nloss = (gradients ** 2).sum()\nloss.backward()\n\ntorch.nn.utils.clip_grad_norm_(gradients, max_norm=1.0)\nprint(f\"Clipped gradients: {gradients.grad}\")"
        ]
