          "python",
          "class RegularizationTechniques(nn.Module):\n    def __init__(self, input_size, hidden_size):\n        super().__init__()\n        self.fc1 = nn.Linear(input_size, hidden_size)\n        self.fc2 = nn.Linear(hidden_size, hidden_size)\n        self.fc3 = nn.Linear(hidden_size, 10)\n        \n        # Regularization layers\n        self.dropout1 = nn.Dropout(p=0.3)\n        self.dropout2 = nn.Dropout(p=0.2)\n        self.batch_norm1 = nn.BatchNorm1d(hidden_size)\n        self.batch_norm2 = nn.BatchNorm1d(hidden_size)\n        self.relu = nn.ReLU()\n    \n    def forward(self, x):\n        x = self.fc1(x)\n        x = self.batch_norm1(x)\n        x = self.relu(x)\n        x = self.dropout1(x)\n        \n        x = self.fc2(x)\n        x = self.batch_norm2(x)\n        x = self.relu(x)\n        x = self.dropout2(x)\n        \n        x = self.fc3(x)\n        return x\n\n\nclass L1L2Regularization:\n    \"\"\"L1 and L2 weight regularization.\"\"\"\n    def __init__(self, model, l1_weight=0.0, l2_weight=0.001):\n        self.model = model\n        self.l1_weight = l1_weight\n        self.l2_weight = l2_weight\n    \n    def compute_loss(self, output, target, loss_fn):\n        main_loss = loss_fn(output, target)\n        \n        # L2 regularization (weight decay)\n        l2_loss = 0\n        for param in self.model.parameters():\n            l2_loss += torch.norm(param, 2)\n        \n        # L1 regularization\n        l1_loss = 0\n        for param in self.model.parameters():\n            l1_loss += torch.norm(param, 1)\n        \n        total_loss = main_loss + self.l1_weight * l1_loss + self.l2_weight * l2_loss\n        return total_loss\n\n\n# Using regularization in training\nmodel = RegularizationTechniques(784, 256)\noptimizer = torch.optim.Adam(model.parameters(), lr=0.001, weight_decay=0.0001)  # L2 via weight_decay\nloss_fn = nn.CrossEntropyLoss()\n\n# Training with regularization\nfor epoch in range(10):\n    for X_batch, y_batch in train_loader:\n        output = model(X_batch)\n        loss = loss_fn(output, y_batch)\n        optimizer.zero_grad()\n        loss.backward()\n        optimizer.step()"
        ]
