          "python",
          "import torch\nimport torch.nn as nn\nimport numpy as np\n\n# Create tensors\nt1 = torch.tensor([1, 2, 3])                    # From list\nt2 = torch.zeros(3, 4)                          # Zeros\nt3 = torch.ones(2, 3, 4)                        # Ones\nt4 = torch.randn(5, 5)                          # Normal distribution\nt5 = torch.arange(0, 10, 2)                     # Range\nt6 = torch.linspace(0, 1, 10)                   # Linearly spaced\n\n# Tensor operations\na = torch.tensor([1.0, 2.0, 3.0])\nb = torch.tensor([4.0, 5.0, 6.0])\n\nc = a + b                                        # Element-wise addition\nd = a * b                                        # Element-wise multiplication\ne = torch.matmul(a.reshape(1, -1), b.reshape(-1, 1))  # Matrix multiplication\nf = torch.sum(a)                                 # Sum\ng = torch.mean(a)                                # Mean\n\n# Tensor properties\nprint(f\"Shape: {a.shape}\")\nprint(f\"Data type: {a.dtype}\")\nprint(f\"Device: {a.device}\")\n\n# Reshaping and indexing\nmatrix = torch.randn(3, 4)\nreshaped = matrix.reshape(2, 6)                 # Reshape\nflattened = matrix.flatten()                     # Flatten\ntransposed = matrix.T                            # Transpose\n\n# Indexing\nfirst_row = matrix[0, :]                        # First row\ncol_slice = matrix[:, 1:3]                      # Columns 1-2\nselected = matrix[matrix > 0]                   # Elements > 0\n\n# Convert between NumPy and PyTorch\nnp_array = np.array([1, 2, 3])\ntorch_tensor = torch.from_numpy(np_array)\nback_to_numpy = torch_tensor.numpy()\n\n# GPU acceleration\nif torch.cuda.is_available():\n    gpu_tensor = a.cuda()                       # Move to GPU\n    gpu_tensor = a.to('cuda')                   # Alternative\n    cpu_tensor = gpu_tensor.cpu()               # Move back to CPU"
