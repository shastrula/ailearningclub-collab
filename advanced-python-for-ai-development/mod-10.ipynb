        [
          "python",
          "import cv2\nimport threading\nfrom queue import Queue\n\nclass VideoProcessor:\n    def __init__(self, video_path, detect_model):\n        self.cap = cv2.VideoCapture(video_path)\n        self.detect_model = detect_model\n        self.frame_queue = Queue(maxsize=30)\n        self.result_queue = Queue()\n    \n    def read_frames(self):\n        \"\"\"Read frames in separate thread\"\"\"\n        while True:\n            ret, frame = self.cap.read()\n            if not ret:\n                break\n            \n            if not self.frame_queue.full():\n                self.frame_queue.put(frame)\n    \n    def process_frames(self):\n        \"\"\"Detect objects in frames\"\"\"\n        while True:\n            if self.frame_queue.empty():\n                continue\n            \n            frame = self.frame_queue.get()\n            detections = self.detect_model(frame)  # Your detection model\n            self.result_queue.put((frame, detections))\n    \n    def run(self):\n        \"\"\"Run processing with threading\"\"\"\n        reader_thread = threading.Thread(target=self.read_frames, daemon=True)\n        processor_thread = threading.Thread(target=self.process_frames, daemon=True)\n        \n        reader_thread.start()\n        processor_thread.start()\n        \n        fps_counter = 0\n        while True:\n            if self.result_queue.empty():\n                continue\n            \n            frame, detections = self.result_queue.get()\n            \n            # Draw detections on frame\n            for det in detections:\n                x, y, w, h = det['bbox']\n                cv2.rectangle(frame, (x, y), (x + w, y + h), (0, 255, 0), 2)\n            \n            fps_counter += 1\n            cv2.putText(frame, f\"FPS: {fps_counter}\", (10, 30),\n                       cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)\n            \n            cv2.imshow(\"Detection\", frame)\n            if cv2.waitKey(1) & 0xFF == ord('q'):\n                break\n        \n        self.cap.release()\n        cv2.destroyAllWindows()"
        ]
      ]
    }
