        [
          "python",
          "import cv2\nimport albumentations as A\nimport numpy as np\nfrom matplotlib import pyplot as plt\n\n# Create augmentation pipeline\ntransform = A.Compose([\n    A.HorizontalFlip(p=0.5),\n    A.Rotate(limit=30, p=0.7),\n    A.RandomBrightnessContrast(brightness_limit=0.2, contrast_limit=0.2, p=0.5),\n    A.GaussNoise(p=0.3),\n    A.Blur(blur_limit=3, p=0.3),\n    A.Affine(scale=(0.8, 1.2), p=0.5),\n    A.Perspective(scale=(0.05, 0.1), p=0.3),\n], bbox_params=A.BboxParams(format='pascal_voc', label_fields=['class_labels']))\n\n# Load image\nimg = cv2.imread(\"photo.jpg\")\nimg_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n\n# Example bounding box (x_min, y_min, x_max, y_max) and class label\nbboxes = [[100, 100, 300, 300]]\nclass_labels = [0]  # Class ID\n\n# Apply augmentation multiple times\nfig, axes = plt.subplots(2, 3, figsize=(15, 10))\naxes = axes.flatten()\n\nfor idx in range(6):\n    augmented = transform(image=img_rgb, bboxes=bboxes, class_labels=class_labels)\n    aug_img = augmented['image']\n    \n    axes[idx].imshow(aug_img)\n    axes[idx].set_title(f\"Augmentation {idx + 1}\")\n    axes[idx].axis('off')\n\nplt.tight_layout()\nplt.show()\n\n# In practice, apply to entire dataset during training\ndef augment_dataset(image_paths, output_dir, augmentations_per_image=5):\n    for img_path in image_paths:\n        img = cv2.imread(img_path)\n        img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n        \n        for aug_idx in range(augmentations_per_image):\n            augmented = transform(image=img_rgb, bboxes=bboxes, class_labels=class_labels)\n            aug_img_bgr = cv2.cvtColor(augmented['image'], cv2.COLOR_RGB2BGR)\n            \n            output_path = f\"{output_dir}/aug_{aug_idx}_{img_path.split('/')[-1]}\"\n            cv2.imwrite(output_path, aug_img_bgr)"
        ]
      ]
    },
