          "python",
          "import cv2\nimport numpy as np\nfrom matplotlib import pyplot as plt\n\n# Load an image (returns BGR format, not RGB)\nimg = cv2.imread(\"photo.jpg\")\nprint(f\"Image shape: {img.shape}\")  # (height, width, 3) for color\n\n# Convert BGR to RGB for display\nimg_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n\n# Convert to grayscale\ngray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n\n# Display images\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\naxes[0].imshow(img_rgb)\naxes[0].set_title(\"Color Image\")\naxes[1].imshow(gray, cmap='gray')\naxes[1].set_title(\"Grayscale\")\nplt.show()\n\n# Basic image transformations\nresized = cv2.resize(img, (300, 300))  # Resize to 300x300\nblurred = cv2.GaussianBlur(img, (5, 5), 0)  # Gaussian blur\nrotated = cv2.rotate(img, cv2.ROTATE_90_CLOCKWISE)  # Rotate 90 degrees\n\n# Pixel value manipulation\nbright = cv2.convertScaleAbs(img, alpha=1.5, beta=50)  # Increase brightness"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import cv2\nimport numpy as np\n\nimg = cv2.imread(\"photo.jpg\")\ngray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n\n# Canny edge detection\nedges = cv2.Canny(gray, threshold1=100, threshold2=200)\n\n# Find contours from edge map\ncontours, hierarchy = cv2.findContours(edges, cv2.RETR_TREE, cv2.CHAIN_APPROX_SIMPLE)\n\nprint(f\"Found {len(contours)} contours\")\n\n# Draw all contours on a copy of the image\ncontour_img = img.copy()\ncv2.drawContours(contour_img, contours, -1, (0, 255, 0), 2)\n\n# Analyze individual contours\nfor i, contour in enumerate(contours[:5]):  # First 5 contours\n    area = cv2.contourArea(contour)\n    perimeter = cv2.arcLength(contour, True)\n    \n    # Approximate contour shape\n    epsilon = 0.02 * perimeter\n    approx = cv2.approxPolyDP(contour, epsilon, True)\n    \n    print(f\"Contour {i}: area={area:.1f}, vertices={len(approx)}\")\n    \n    # Draw bounding rectangle\n    x, y, w, h = cv2.boundingRect(contour)\n    cv2.rectangle(contour_img, (x, y), (x + w, y + h), (255, 0, 0), 2)\n\ncv2.imshow(\"Contours\", contour_img)\ncv2.waitKey(0)\ncv2.destroyAllWindows()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
