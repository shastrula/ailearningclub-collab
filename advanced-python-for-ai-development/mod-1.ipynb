          "python",
          "from collections import Counter\n\n# Analyzing class distribution in imbalanced datasets\nlabels = [0, 0, 0, 0, 0, 1, 1, 2, 2, 2]\nlabel_counts = Counter(labels)\n\nprint(label_counts)  # Counter({0: 5, 2: 3, 1: 2})\nprint(label_counts.most_common(2))  # [(0, 5), (2, 3)]\n\n# Detecting class imbalance for model training\ntotal = sum(label_counts.values())\nfor label, count in label_counts.items():\n    percentage = (count / total) * 100\n    print(f\"Class {label}: {percentage:.1f}%\")\n\n# Computing class weights for imbalanced datasets\nclass_weights = {label: total/count for label, count in label_counts.items()}"
        ]
      ]
