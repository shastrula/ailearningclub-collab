        [
          "python",
          "from collections import deque\nimport time\n\n# Lists are slow for queue operations\nregular_list = list(range(10))\nstart = time.time()\nfor _ in range(1000000):\n    regular_list.pop(0)  # O(n) operation\n    regular_list.append(0)\nlist_time = time.time() - start\n\n# Deques are optimized\nqueue = deque(range(10))\nstart = time.time()\nfor _ in range(1000000):\n    queue.popleft()  # O(1) operation\n    queue.append(0)\ndeque_time = time.time() - start\n\nprint(f\"List: {list_time:.2f}s, Deque: {deque_time:.2f}s\")\n# Deques are typically 100x faster for queue operations"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def batch_generator(data, batch_size=32):\n    \"\"\"Memory-efficient batch generator for ML training.\n    \n    Instead of loading entire dataset into memory, this yields\n    batches one at a time. For a 10GB dataset with 100MB RAM,\n    this is the only approach that works.\n    \"\"\"\n    for i in range(0, len(data), batch_size):\n        yield data[i:i+batch_size]\n\n# Usage in ML training loop\ndef train_model(model, data, labels, batch_size=32):\n    for batch_data, batch_labels in zip(\n        batch_generator(data, batch_size),\n        batch_generator(labels, batch_size)\n    ):\n        # Process batch\n        predictions = model.forward(batch_data)\n        loss = compute_loss(predictions, batch_labels)\n        model.backward(loss)\n        # Memory never exceeds batch_size * sample_size"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from collections import defaultdict\n\n# Without defaultdict - verbose and error-prone\nword_counts = {}\nfor word in document.split():\n    if word not in word_counts:\n        word_counts[word] = 0\n    word_counts[word] += 1\n\n# With defaultdict - clean and efficient\nword_counts = defaultdict(int)\nfor word in document.split():\n    word_counts[word] += 1  # No KeyError\n\n# This pattern appears everywhere in ML feature engineering\n# When building sparse feature matrices, defaultdicts prevent errors\nfeature_counts = defaultdict(lambda: defaultdict(int))\nfor sample_id, features in enumerate(feature_list):\n    for feature_name, feature_value in features.items():\n        feature_counts[sample_id][feature_name] = feature_value"
        ]
      ]
    },
    {
