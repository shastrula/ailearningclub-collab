        [
          "python",
          "class DataBatchIterator:\n    \"\"\"Custom iterator for ML datasets with shuffling and augmentation.\"\"\"\n    def __init__(self, data, labels, batch_size=32, shuffle=True):\n        self.data = data\n        self.labels = labels\n        self.batch_size = batch_size\n        self.shuffle = shuffle\n        self.indices = np.arange(len(data))\n        self.current = 0\n        \n    def __iter__(self):\n        if self.shuffle:\n            np.random.shuffle(self.indices)\n        self.current = 0\n        return self\n        \n    def __next__(self):\n        if self.current >= len(self.data):\n            raise StopIteration\n        \n        batch_indices = self.indices[self.current:self.current+self.batch_size]\n        batch_data = self.data[batch_indices]\n        batch_labels = self.labels[batch_indices]\n        self.current += self.batch_size\n        \n        return batch_data, batch_labels\n\n# Usage\niterator = DataBatchIterator(train_data, train_labels, batch_size=64)\nfor batch_data, batch_labels in iterator:\n    model.train_on_batch(batch_data, batch_labels)"
        ]
      ]
