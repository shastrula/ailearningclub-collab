          "from dataclasses import dataclass\nimport os\n\n@dataclass\nclass Config:\n    db_host: str = os.getenv(\"DB_HOST\", \"localhost\")\n    db_port: int = int(os.getenv(\"DB_PORT\", \"5432\"))\n    batch_size: int = int(os.getenv(\"BATCH_SIZE\", \"32\"))\n    debug: bool = os.getenv(\"DEBUG\", \"false\").lower() == \"true\"\n\nconfig = Config()"
