          "python",
          "import spacy\nfrom spacy import displacy\n\n# Load the English model\nnlp = spacy.load(\"en_core_web_sm\")\n\n# Process a sentence\ntext = \"Apple CEO Tim Cook announced a partnership with Microsoft in Redmond.\"\ndoc = nlp(text)\n\n# Explore tokens and their attributes\nfor token in doc:\n    print(f\"{token.text:12} | POS: {token.pos_:6} | DEP: {token.dep_:8} | LEMMA: {token.lemma_}\")\n\n# Named Entity Recognition (NER)\nprint(\"\\nNamed Entities:\")\nfor ent in doc.ents:\n    print(f\"{ent.text:20} \u2192 {ent.label_:10}\")\n\n# Dependency visualization (returns HTML)\ndisplacy.serve(doc, style=\"dep\", port=5000)  # Visit http://localhost:5000"
        ]
      ]
