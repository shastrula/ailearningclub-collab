          "python",
          "import spacy\n\nnlp = spacy.load(\"en_core_web_sm\")\ntext = \"John gave Mary a gift on her birthday\"\ndoc = nlp(text)\n\n# Traverse dependency tree\nfor token in doc:\n    print(f\"{token.text:10} \u2192 head: {token.head.text:10} | dep: {token.dep_:6}\")\n\n# Extract subject-verb-object relationships\ndef extract_svo(doc):\n    verbs = [token for token in doc if token.pos_ == \"VERB\"]\n    results = []\n    \n    for verb in verbs:\n        subject = [token for token in verb.lefts if token.dep_ == \"nsubj\"]\n        obj = [token for token in verb.rights if token.dep_ in (\"dobj\", \"attr\")]\n        \n        if subject and obj:\n            results.append({\n                \"subject\": subject[0].text,\n                \"verb\": verb.text,\n                \"object\": obj[0].text\n            })\n    \n    return results\n\ntriples = extract_svo(doc)\nfor triple in triples:\n    print(f\"{triple['subject']} {triple['verb']} {triple['object']}\")"
        ]
      ]
    },
