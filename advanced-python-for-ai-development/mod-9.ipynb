        [
          "python",
          "import spacy\nfrom typing import List, Dict\nimport time\n\nclass ProductionNLPPipeline:\n    def __init__(self, model_name: str = \"en_core_web_sm\"):\n        self.nlp = spacy.load(model_name)\n        self.cache = {}\n    \n    def process_batch(self, texts: List[str], batch_size: int = 50):\n        \"\"\"Process many texts efficiently using nlp.pipe()\"\"\"\n        results = []\n        start = time.time()\n        \n        # Use nlp.pipe() for batch processing - much faster than individual docs\n        for doc in self.nlp.pipe(texts, batch_size=batch_size, disable=[\"parser\"]):\n            results.append({\n                \"text\": doc.text,\n                \"entities\": [(ent.text, ent.label_) for ent in doc.ents],\n                \"tokens\": [token.text for token in doc]\n            })\n        \n        elapsed = time.time() - start\n        print(f\"Processed {len(texts)} texts in {elapsed:.2f}s\")\n        return results\n    \n    def extract_entities(self, text: str) -> Dict:\n        \"\"\"Extract and categorize entities\"\"\"\n        # Check cache\n        if text in self.cache:\n            return self.cache[text]\n        \n        doc = self.nlp(text)\n        entities_by_type = {}\n        \n        for ent in doc.ents:\n            if ent.label_ not in entities_by_type:\n                entities_by_type[ent.label_] = []\n            entities_by_type[ent.label_].append(ent.text)\n        \n        result = {\"text\": text, \"entities\": entities_by_type}\n        self.cache[text] = result\n        return result\n\n# Usage\npipeline = ProductionNLPPipeline()\ntexts = [\n    \"Apple CEO Tim Cook visited Microsoft headquarters in Seattle\",\n    \"Google announced a partnership with OpenAI in San Francisco\",\n]\nbatch_results = pipeline.process_batch(texts)\nfor result in batch_results:\n    print(result)"
        ]
      ]
    }
