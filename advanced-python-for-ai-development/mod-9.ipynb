        [
          "python",
          "import logging\nfrom functools import wraps\n\nlogger = logging.getLogger(__name__)\n\ndef production_ready(func):\n    \"\"\"Production-grade function wrapper with logging and error handling.\"\"\"\n    @wraps(func)\n    def wrapper(*args, **kwargs):\n        try:\n            logger.debug(f\"Starting {func.__name__}\")\n            result = func(*args, **kwargs)\n            logger.debug(f\"Completed {func.__name__}\")\n            return result\n        except Exception as e:\n            logger.error(f\"Error in {func.__name__}: {e}\", exc_info=True)\n            raise\n    return wrapper\n\n@production_ready\ndef process_batch(batch):\n    return [x * 2 for x in batch]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from contextlib import contextmanager\n\n@contextmanager\ndef database_connection(host, port):\n    \"\"\"Safely manage database connections.\"\"\"\n    conn = connect(host, port)\n    try:\n        yield conn\n    finally:\n        conn.close()\n\n# Usage\nwith database_connection(\"localhost\", 5432) as db:\n    results = db.query(\"SELECT * FROM users\")\n    # Connection automatically closed here"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\ndef vectorized_operation(data):\n    \"\"\"Use NumPy for vectorized operations (100x faster than loops).\"\"\"\n    # Slow: loop in Python\n    # result = [x**2 for x in data]\n    \n    # Fast: vectorized with NumPy\n    return (np.array(data) ** 2).tolist()\n\n# For 1M elements: 0.1s vs 10s"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def robust_api_call(url, retries=3):\n    \"\"\"Call API with automatic retries and error handling.\"\"\"\n    for attempt in range(retries):\n        try:\n            response = requests.get(url, timeout=5)\n            response.raise_for_status()\n            return response.json()\n        except requests.ConnectionError:\n            if attempt == retries - 1:\n                raise\n            time.sleep(2 ** attempt)  # Exponential backoff"
        ]
      ]
    },
