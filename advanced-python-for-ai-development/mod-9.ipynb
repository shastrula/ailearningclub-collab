        [
          "python",
          "import spacy\nfrom spacy.training import Example\nfrom spacy.util import minibatch, compounding\n\n# Create a blank English model\nnlp = spacy.blank(\"en\")\n\n# Add NER component\nner = nlp.add_pipe(\"ner\", last=True)\nner.add_label(\"PRODUCT\")\nner.add_label(\"COMPANY\")\n\n# Training data format: (text, {\"entities\": [(start, end, label), ...]})\nTRAIN_DATA = [\n    (\"iPhone 14 Pro is made by Apple\", {\"entities\": [(0, 12, \"PRODUCT\"), (26, 31, \"COMPANY\")]}),\n    (\"Google Pixel 7 competes with Apple iPhone\", {\"entities\": [(0, 6, \"COMPANY\"), (7, 18, \"PRODUCT\"), (34, 39, \"COMPANY\"), (40, 45, \"PRODUCT\")]}),\n    (\"Microsoft released Windows 11 last year\", {\"entities\": [(0, 9, \"COMPANY\"), (20, 29, \"PRODUCT\")]}),\n]\n\n# Initialize optimizer\noptimizer = nlp.create_optimizer()\n\n# Train for 10 iterations\nfor iteration in range(10):\n    losses = {}\n    examples = [Example.from_dict(nlp.make_doc(text), annot) for text, annot in TRAIN_DATA]\n    \n    for batch in minibatch(examples, size=1):\n        nlp.update(batch, sgd=optimizer, drop=0.5, losses=losses)\n    \n    print(f\"Iteration {iteration + 1}, Loss: {losses.get('ner', 0):.4f}\")\n\n# Test the model\ntest_text = \"Samsung Galaxy S24 is a great phone\"\ndoc = nlp(test_text)\nfor ent in doc.ents:\n    print(f\"{ent.text} \u2192 {ent.label_}\")"
        ]
      ]
