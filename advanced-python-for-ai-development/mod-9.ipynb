          "python",
          "import spacy\nfrom spacy.matcher import Matcher\n\nnlp = spacy.load(\"en_core_web_sm\")\nmatcher = Matcher(nlp.vocab)\n\n# Pattern 1: \"is a [NOUN]\" - captures \"is a X\" phrases\npattern1 = [\n    {\"LOWER\": \"is\"},\n    {\"LOWER\": \"a\"},\n    {\"POS\": \"NOUN\"}\n]\nmatcher.add(\"IS_A\", [pattern1])\n\n# Pattern 2: \"[PERSON] from [GPE]\" - person from location\npattern2 = [\n    {\"ENT_TYPE\": \"PERSON\"},\n    {\"LOWER\": \"from\"},\n    {\"ENT_TYPE\": \"GPE\"}\n]\nmatcher.add(\"FROM_LOCATION\", [pattern2])\n\n# Process text with matcher\ntext = \"\"\"\nAlice is a machine learning engineer. Bob is a data scientist from Germany. \nCharlie is a software developer from the UK.\n\"\"\"\n\ndoc = nlp(text)\nmatches = matcher(doc)\n\nfor match_id, start, end in matches:\n    span = doc[start:end]\n    label = nlp.vocab.strings[match_id]\n    print(f\"{label:20} \u2192 {span.text}\")"
        ]
      ]
