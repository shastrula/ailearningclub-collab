          "python",
          "import spacy\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.naive_bayes import MultinomialNB\nfrom sklearn.pipeline import Pipeline\n\n# For text similarity with spaCy's built-in word vectors\nnlp = spacy.load(\"en_core_web_md\")  # Medium model with word vectors\n\n# Text similarity using word vectors\ndoc1 = nlp(\"The cat sat on the mat\")\ndoc2 = nlp(\"A feline rested on the rug\")\ndoc3 = nlp(\"Artificial intelligence is advancing rapidly\")\n\nprint(f\"Similarity doc1-doc2: {doc1.similarity(doc2):.3f}\")  # High (similar meaning)\nprint(f\"Similarity doc1-doc3: {doc1.similarity(doc3):.3f}\")  # Low (different topics)\n\n# Word-level similarity\ntoken1 = nlp(\"cat\")[0]\ntoken2 = nlp(\"dog\")[0]\ntoken3 = nlp(\"computer\")[0]\n\nprint(f\"\\nWord similarity:\")\nprint(f\"cat - dog: {token1.similarity(token2):.3f}\")  # High (both animals)\nprint(f\"cat - computer: {token1.similarity(token3):.3f}\")  # Low (different concepts)\n\n# Text classification with TF-IDF + Naive Bayes\ntexts = [\n    (\"I love this product, amazing quality\", \"positive\"),\n    (\"This is terrible, do not buy\", \"negative\"),\n    (\"Average product, nothing special\", \"neutral\"),\n    (\"Outstanding! Highly recommended\", \"positive\"),\n]\n\nX_train = [text for text, _ in texts]\ny_train = [label for _, label in texts]\n\nclassifier = Pipeline([\n    (\"tfidf\", TfidfVectorizer(max_features=100)),\n    (\"nb\", MultinomialNB())\n])\n\nclassifier.fit(X_train, y_train)\n\n# Classify new text\nnew_texts = [\"I really enjoyed this\", \"Waste of money\"]\npredictions = classifier.predict(new_texts)\nfor text, pred in zip(new_texts, predictions):\n    print(f\"{text:30} \u2192 {pred}\")"
        ]
      ]
    },
