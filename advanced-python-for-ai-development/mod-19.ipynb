          "python",
          "# pip install shap\nimport shap\nfrom sklearn.ensemble import RandomForestClassifier\n\n# Train model\nX = np.random.randn(1000, 10)\ny = (X[:, 0] > 0).astype(int)\nmodel = RandomForestClassifier()\nmodel.fit(X, y)\n\n# SHAP: compute feature importance\nexplainer = shap.TreeExplainer(model)\nshap_values = explainer.shap_values(X)\n\n# For binary classification, shap_values is list of 2 arrays\n# shap_values[1] = importance for predicting positive class\n\n# Mean absolute SHAP values = average feature impact\nfeature_importance = np.mean(np.abs(shap_values[1]), axis=0)\nprint(f\"Feature 0 impact: {feature_importance[0]:.3f}\")\n\n# Explain single prediction\nsample = X[0:1]\nshap_vals = explainer.shap_values(sample)\nbase_value = explainer.expected_value[1]\n\n# Each feature contributes (positively or negatively) to prediction\nprint(f\"Base prediction: {base_value:.3f}\")\nprint(f\"Feature 0 contribution: {shap_vals[1][0, 0]:.3f}\")\nprint(f\"Final prediction: {model.predict_proba(sample)[0, 1]:.3f}\")\n\n# Visualization (in Jupyter):\n# shap.force_plot(explainer.expected_value[1], shap_values[1][0], X[0])"
        ]
