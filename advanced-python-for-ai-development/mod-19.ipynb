          "python",
          "# Responsible AI Audit Checklist\nchecklist = {\n    \"Data Quality\": {\n        \"Missing values\": \"Documented and imputed appropriately\",\n        \"Outliers\": \"Identified and handled (removed/capped)\",\n        \"Data leakage\": \"No test data mixed in training\",\n        \"Temporal splits\": \"If time-series, train/test temporally separated\"\n    },\n    \"Fairness\": {\n        \"Bias audit\": \"Checked approval rates across demographic groups\",\n        \"Disparate impact\": \"Disparity ratio > 0.8 for all groups\",\n        \"Equalized odds\": \"TPR/FPR similar across groups\",\n        \"Mitigation\": \"Addressed identified biases\"\n    },\n    \"Explainability\": {\n        \"SHAP values\": \"Top features explained for sample predictions\",\n        \"Feature importance\": \"High-impact features documented\",\n        \"User-facing explanations\": \"Non-technical users understand decisions\"\n    },\n    \"Performance\": {\n        \"Baseline comparison\": \"Outperforms simple baseline\",\n        \"Cross-validation\": \"Performance stable across folds\",\n        \"Production holdout\": \"Tested on data model hasn't seen\",\n        \"Adversarial examples\": \"Tested robustness to small perturbations\"\n    },\n    \"Monitoring\": {\n        \"Input drift\": \"Monitor feature distributions shift\",\n        \"Prediction drift\": \"Monitor model outputs shift\",\n        \"Performance metrics\": \"Accuracy/fairness tracked in production\",\n        \"Alert thresholds\": \"Defined for significant shifts\"\n    },\n    \"Documentation\": {\n        \"Model card\": \"Problem, data, performance, limitations documented\",\n        \"Training process\": \"Reproducible (seed, hyperparams, data version)\",\n        \"Known limitations\": \"When model is expected to fail\",\n        \"Governance\": \"Approval required for high-stakes decisions\"\n    }\n}\n\n# Check each item\ndef audit_model(model, X_test, y_test, protected_attributes):\n    \"\"\"Verify responsible AI practices.\"\"\"\n    report = {}\n    \n    # Data quality checks\n    report['missing_values'] = X_test.isnull().sum().sum()\n    \n    # Fairness checks\n    predictions = model.predict(X_test)\n    for attr in protected_attributes:\n        for group in protected_attributes[attr].unique():\n            mask = protected_attributes[attr] == group\n            group_accuracy = (predictions[mask] == y_test[mask]).mean()\n            report[f'{attr}_{group}_accuracy'] = group_accuracy\n    \n    # Performance checks\n    report['overall_accuracy'] = (predictions == y_test).mean()\n    \n    return report"
        ]
      ]
    },
