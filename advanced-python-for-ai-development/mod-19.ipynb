          "python",
          "# Differential Privacy: add noise to prevent individual identification\nimport numpy as np\n\ndef aggregate_with_differential_privacy(data, epsilon=0.1):\n    \"\"\"\n    Aggregate data while guaranteeing individual privacy.\n    epsilon controls privacy-utility tradeoff (lower = more private, noisier).\n    \"\"\"\n    aggregated = data.sum()\n    \n    # Laplace noise scaled by epsilon\n    noise = np.random.laplace(0, 1/epsilon, data.shape[1])\n    return aggregated + noise\n\n# Example: federated learning for healthcare\n# Hospital A trains model on its data (doesn't share)\n# Hospital B trains model on its data (doesn't share)\n# Central server aggregates model weights (doesn't see raw data)\n# Result: shared model improves all hospitals' predictions\n\ndef federated_average(models):\n    \"\"\"Average model weights without seeing data.\"\"\"\n    avg_weights = {}\n    num_models = len(models)\n    \n    for key in models[0].get_weights():\n        avg_weights[key] = sum(\n            model.get_weights()[key] / num_models \n            for model in models\n        )\n    \n    return avg_weights\n\n# Hospital A: train on sensitive data (never leaves hospital)\nmodel_a = train_on_hospital_data(data_a, labels_a)\n\n# Hospital B: train on sensitive data (never leaves hospital)\nmodel_b = train_on_hospital_data(data_b, labels_b)\n\n# Central aggregation\ncombined_model = create_federated_model(\n    federated_average([model_a, model_b])\n)\n# Combined model benefits from both hospitals without exposing data"
        ]
