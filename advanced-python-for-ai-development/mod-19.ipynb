        [
          "python",
          "import pandas as pd\nimport numpy as np\nfrom sklearn.metrics import confusion_matrix, recall_score\n\n# Loan approval dataset: approved/denied decisions\ndf = pd.DataFrame({\n    'age': np.random.randint(25, 70, 1000),\n    'income': np.random.randint(20000, 200000, 1000),\n    'gender': np.random.choice(['M', 'F'], 1000),\n    'approved': np.random.binomial(1, 0.7, 1000)\n})\n\n# Check: is approval rate equal across genders?\napproval_by_gender = df.groupby('gender')['approved'].agg(['sum', 'count', 'mean'])\nprint(approval_by_gender)\n#        sum  count  mean\n# F      327    500  0.654\n# M      495    500  0.990\n\n# Disparity ratio: ratio of approval rates\nfemale_approval = approval_by_gender.loc['F', 'mean']\nmale_approval = approval_by_gender.loc['M', 'mean']\ndisparity = female_approval / male_approval\nprint(f\"Disparity ratio: {disparity:.2f}\")  # 0.66\n\n# 80% rule: disparity < 0.8 is concerning\nif disparity < 0.8:\n    print(\"\u26a0\ufe0f  Significant disparity detected: females approved at 66% the rate of males\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# True Positive Rate (TPR) and False Positive Rate (FPR) should be equal across groups\n\npredictions = pd.DataFrame({\n    'gender': np.random.choice(['M', 'F'], 1000),\n    'y_true': np.random.binomial(1, 0.5, 1000),\n    'y_pred': np.random.binomial(1, 0.7, 1000)\n})\n\n# Calculate TPR and FPR per gender\nfor gender in ['M', 'F']:\n    subset = predictions[predictions['gender'] == gender]\n    \n    tn, fp, fn, tp = confusion_matrix(subset['y_true'], subset['y_pred']).ravel()\n    \n    tpr = tp / (tp + fn)  # True positive rate (sensitivity)\n    fpr = fp / (fp + tn)  # False positive rate\n    \n    print(f\"{gender}: TPR={tpr:.3f}, FPR={fpr:.3f}\")\n\n# Output:\n# M: TPR=0.712, FPR=0.284\n# F: TPR=0.695, FPR=0.312\n\n# If TPR/FPR differ significantly, model has different error rates by gender\n# Equalized odds: TPR_male \u2248 TPR_female, FPR_male \u2248 FPR_female"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Calibration: P(prediction correct | confidence) should be equal across groups\nfrom sklearn.calibration import calibration_curve\n\ncalibration_by_group = {}\nfor gender in ['M', 'F']:\n    subset = predictions[predictions['gender'] == gender]\n    prob_true, prob_pred = calibration_curve(\n        subset['y_true'], \n        subset['y_pred'],\n        n_bins=5\n    )\n    calibration_by_group[gender] = {\n        'prob_true': prob_true,\n        'prob_pred': prob_pred\n    }\n\n# If model says 80% confidence for males but only 60% for females\n# on same true event, it's poorly calibrated across groups\n\n# Mitigation strategies:\n# 1. Balanced data collection: oversample underrepresented groups\n# 2. Fairness-aware algorithms: constrain optimization to equalize metrics\n# 3. Threshold adjustment: use different prediction thresholds per group\n# 4. Post-processing: flip predictions to achieve fairness targets\n\n# Example: threshold adjustment\ndef predict_with_adjusted_thresholds(model, X_test, group_labels, thresholds):\n    \"\"\"Apply different thresholds per group.\"\"\"\n    predictions_proba = model.predict_proba(X_test)[:, 1]\n    predictions = np.zeros(len(X_test))\n    \n    for group in thresholds.keys():\n        mask = group_labels == group\n        predictions[mask] = (predictions_proba[mask] >= thresholds[group]).astype(int)\n    \n    return predictions\n\n# Thresholds chosen to achieve demographic parity\nthresholds = {'M': 0.5, 'F': 0.4}  # Lower threshold for underrepresented group\npredictions_fair = predict_with_adjusted_thresholds(model, X_test, groups, thresholds)"
        ]
      ]
    },
