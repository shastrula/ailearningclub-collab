          "python",
          "import numpy as np\nfrom sklearn.datasets import load_iris\nfrom sklearn.ensemble import RandomForestClassifier\n\n# Train model\nX, y = load_iris(return_X_y=True)\nmodel = RandomForestClassifier().fit(X, y)\n\ndef adversarial_attack(model, x, epsilon=0.1, num_iterations=20):\n    \"\"\"Generate adversarial example using FGSM-like attack.\"\"\"\n    x_adv = x.copy().astype(float)\n    \n    for _ in range(num_iterations):\n        # Estimate gradient via finite differences\n        gradient = np.zeros_like(x)\n        for i in range(len(x)):\n            x_plus = x_adv.copy()\n            x_plus[i] += 1e-4\n            x_minus = x_adv.copy()\n            x_minus[i] -= 1e-4\n            \n            loss_plus = model.predict_proba([x_plus])[0].max()\n            loss_minus = model.predict_proba([x_minus])[0].max()\n            gradient[i] = (loss_plus - loss_minus) / (2e-4)\n        \n        # Perturb in direction of gradient\n        x_adv += epsilon * np.sign(gradient) / num_iterations\n        # Clip to valid range\n        x_adv = np.clip(x_adv, X.min(), X.max())\n    \n    return x_adv\n\n# Test on legitimate example\nx_original = X[0:1]\npred_original = model.predict(x_original)[0]\nprint(f\"Original prediction: {pred_original}\")\n\n# Generate adversarial example\nx_adversarial = adversarial_attack(model, x_original[0], epsilon=0.5)\npred_adversarial = model.predict([x_adversarial])[0]\nprint(f\"Adversarial prediction: {pred_adversarial}\")\n\n# Check robustness\nif pred_original != pred_adversarial:\n    print(\"\u26a0\ufe0f  Model is vulnerable to adversarial examples\")\nelse:\n    print(\"\u2713 Model is robust\")\n\n# Defense: adversarial training\ndef train_robust_model(X_train, y_train, num_adversarial=5):\n    \"\"\"Train model with adversarial examples.\"\"\"\n    X_aug = X_train.copy()\n    y_aug = y_train.copy()\n    \n    # Generate adversarial training examples\n    temp_model = RandomForestClassifier().fit(X_train, y_train)\n    for _ in range(num_adversarial):\n        X_adv = np.array([\n            adversarial_attack(temp_model, x, epsilon=0.1)\n            for x in X_train\n        ])\n        X_aug = np.vstack([X_aug, X_adv])\n        y_aug = np.hstack([y_aug, y_train])\n    \n    # Train on augmented data\n    return RandomForestClassifier().fit(X_aug, y_aug)\n\nrobust_model = train_robust_model(X, y)\nprint(f\"Robust model prediction on adversarial: {robust_model.predict([x_adversarial])}\")"
        ]
      ]
