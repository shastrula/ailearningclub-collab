      "source": [
        [
          "python",
          "import time\n\n# Timing comparisons\ndf_large = pd.DataFrame({\n    'A': np.random.randn(1000000),\n    'B': np.random.randint(0, 100, 1000000),\n    'C': np.random.choice(['X', 'Y', 'Z'], 1000000)\n})\n\n# Method 1: Slow (iterrows)\nstart = time.time()\nfor idx, row in df_large.iterrows():\n    df_large.loc[idx, 'D'] = row['A'] * 2\nslow_time = time.time() - start\n\n# Method 2: Faster (vectorized)\nstart = time.time()\ndf_large['D'] = df_large['A'] * 2\nfast_time = time.time() - start\n\nprint(f\"Slow: {slow_time:.2f}s, Fast: {fast_time:.4f}s ({slow_time/fast_time:.0f}x faster)\")\n\n# Profile memory-intensive operation\nimport tracemalloc\n\ntracemalloc.start()\nresult = (df_large\n    .groupby('C')\n    .agg({'A': 'sum', 'B': 'mean'})\n)\ncurrent, peak = tracemalloc.get_traced_memory()\nprint(f\"Current: {current/1024**2:.2f} MB, Peak: {peak/1024**2:.2f} MB\")\ntracemalloc.stop()\n\n# Use query for filtering (sometimes faster)\ndf_filtered_loc = df_large[df_large['A'] > 0]  # Using []\ndf_filtered_query = df_large.query('A > 0')    # Using query\n\n# Caching repeated computations\ndf_cache = df_large.copy()\ngroup_means = df_cache.groupby('C')['A'].mean()\ndf_cache['centered_A'] = df_cache.groupby('C')['A'].transform(lambda x: x - group_means[x.name])"
        ]
      ]
    },
