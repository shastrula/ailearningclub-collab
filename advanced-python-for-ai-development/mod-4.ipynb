          "python",
          "df_text = pd.DataFrame({\n    'text': ['Hello World', 'Python Programming', 'Data Science'],\n    'tags': ['tag1, tag2', 'tag2, tag3', 'tag1, tag3']\n})\n\n# String methods\ndf_text['lower'] = df_text['text'].str.lower()\ndf_text['length'] = df_text['text'].str.len()\ndf_text['starts_with_p'] = df_text['text'].str.startswith('P')\n\n# Extract patterns\ndf_text['first_word'] = df_text['text'].str.extract(r'(\\w+)', expand=False)\ndf_text['has_number'] = df_text['text'].str.contains(r'\\d', regex=True)\n\n# Split and explode (normalize denormalized data)\ndf_exploded = df_text['tags'].str.split(', ', expand=False).explode()\n\n# Join operations\ndf_text['tags_normalized'] = df_text['tags'].str.replace(', ', '|')"
        ]
