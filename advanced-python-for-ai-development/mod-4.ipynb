    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Create sample data\ndf = pd.DataFrame({\n    'date': pd.date_range('2024-01-01', periods=100),\n    'category': np.random.choice(['A', 'B', 'C'], 100),\n    'sales': np.random.randint(50, 500, 100),\n    'cost': np.random.randint(20, 300, 100)\n})\n\n# Chained operations\nresult = (df\n    .assign(profit=df['sales'] - df['cost'])           # Add column\n    .query('profit > 100')                              # Filter rows\n    .groupby('category')\n    .agg({\n        'sales': 'sum',\n        'profit': ['sum', 'mean']\n    })\n    .round(2)\n    .sort_values(('profit', 'sum'), ascending=False)\n)\n\n# More complex chain with custom functions\nprocessed = (df\n    .copy()\n    .assign(\n        profit=lambda x: x['sales'] - x['cost'],\n        profit_margin=lambda x: (x['profit'] / x['sales']).round(3)\n    )\n    .query('profit_margin > 0.2')\n    .sort_values('profit_margin', ascending=False)\n    .head(10)\n)\n\n# Using pipe for custom functions\ndef calculate_metrics(data):\n    return data.assign(\n        roi=data['profit'] / data['cost'],\n        high_value=data['sales'] > 250\n    )\n\nfinal = df.pipe(calculate_metrics).head()"
        ]
      ]
