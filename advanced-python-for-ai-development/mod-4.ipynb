        [
          "python",
          "# Create data with missing values\ndf_missing = pd.DataFrame({\n    'A': [1, 2, np.nan, 4, 5],\n    'B': [5, np.nan, np.nan, 8, 9],\n    'C': [10, 20, 30, 40, 50]\n})\n\n# Fill missing with different strategies\ndf_missing['A_ffill'] = df_missing['A'].fillna(method='ffill')  # Forward fill\ndf_missing['A_bfill'] = df_missing['A'].fillna(method='bfill')  # Backward fill\ndf_missing['A_interpolate'] = df_missing['A'].interpolate()     # Linear interpolation\ndf_missing['A_group_mean'] = df_missing.groupby('C')['A'].transform(lambda x: x.fillna(x.mean()))\n\n# Drop rows/columns strategically\nsparse_cols = df_missing.isnull().sum() / len(df_missing) > 0.5  # >50% missing\ndf_cleaned = df_missing.drop(columns=df_missing.columns[sparse_cols])\n\n# Fill missing with model predictions\nfrom sklearn.impute import SimpleImputer, KNNImputer\n\nknn_imputer = KNNImputer(n_neighbors=3)\ndf_imputed = pd.DataFrame(\n    knn_imputer.fit_transform(df_missing),\n    columns=df_missing.columns\n)"
        ]
      ]
