          "python",
          "import pandas as pd\nimport numpy as np\n\n# Create DataFrame from dict\ndata = {\n    'user_id': [1, 2, 3, 4, 5],\n    'age': [25, 32, 28, 45, 35],\n    'score': [85.5, 92.0, 78.5, 88.0, 91.5],\n    'country': ['USA', 'Canada', 'USA', 'UK', 'Canada']\n}\ndf = pd.DataFrame(data)\n\n# Create from list of dicts\nrecords = [\n    {'name': 'Alice', 'salary': 70000},\n    {'name': 'Bob', 'salary': 75000},\n    {'name': 'Charlie', 'salary': 80000}\n]\ndf_salaries = pd.DataFrame(records)\n\n# Create from NumPy array with index/columns\narr = np.random.randn(100, 4)\ndf_random = pd.DataFrame(arr, columns=['A', 'B', 'C', 'D'])\n\n# Basic exploration\nprint(df.head())          # First 5 rows\nprint(df.info())          # Data types, memory usage\nprint(df.describe())      # Statistical summary\nprint(df.dtypes)          # Column types\nprint(df.shape)           # (rows, columns)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Create a larger dataset\ndf_sales = pd.DataFrame({\n    'date': pd.date_range('2024-01-01', periods=100),\n    'product': np.random.choice(['A', 'B', 'C'], 100),\n    'region': np.random.choice(['North', 'South', 'East', 'West'], 100),\n    'sales': np.random.randint(100, 1000, 100)\n})\n\n# Simple groupby\nsales_by_product = df_sales.groupby('product')['sales'].sum()\nprint(sales_by_product)\n\n# Multiple groupby\nsales_by_region_product = df_sales.groupby(['region', 'product'])['sales'].agg({\n    'sum': 'sum',\n    'mean': 'mean',\n    'count': 'count'\n})\n\n# Custom aggregation\nresult = df_sales.groupby('product').agg({\n    'sales': ['sum', 'mean', 'std', 'min', 'max'],\n    'date': 'count'  # Count of records per group\n}).rename(columns={'date': 'transactions'})\n\n# Transform: add result back to original dataframe\ndf_sales['product_avg_sales'] = df_sales.groupby('product')['sales'].transform('mean')\n\n# Filter: keep only groups with sales > 500\nlarge_sales = df_sales.groupby('product').filter(lambda x: x['sales'].sum() > 500)\n\n# Apply custom function\ndef sales_category(x):\n    total = x['sales'].sum()\n    if total > 5000:\n        return 'High'\n    elif total > 2000:\n        return 'Medium'\n    else:\n        return 'Low'\n\ndf_sales['product_category'] = df_sales.groupby('product').apply(sales_category).values"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Create two DataFrames to join\ndf_users = pd.DataFrame({\n    'user_id': [1, 2, 3, 4],\n    'name': ['Alice', 'Bob', 'Charlie', 'Diana'],\n    'age': [25, 32, 28, 35]\n})\n\ndf_purchases = pd.DataFrame({\n    'purchase_id': [101, 102, 103, 104, 105],\n    'user_id': [1, 1, 2, 3, 2],\n    'amount': [50, 75, 100, 25, 150],\n    'date': pd.date_range('2024-01-01', periods=5)\n})\n\n# INNER JOIN: Keep only matching rows\ninner_join = pd.merge(df_users, df_purchases, on='user_id', how='inner')\n\n# LEFT JOIN: Keep all from left DataFrame\nleft_join = pd.merge(df_users, df_purchases, on='user_id', how='left')\n\n# FULL OUTER JOIN: Keep all from both\nouter_join = pd.merge(df_users, df_purchases, on='user_id', how='outer')\n\n# Merge on different column names\ndf_orders = pd.DataFrame({\n    'order_id': [1, 2, 3],\n    'customer_id': [1, 2, 3],\n    'total': [100, 250, 75]\n})\nmerged = pd.merge(df_users, df_orders, left_on='user_id', right_on='customer_id')\n\n# Concatenate vertically (stacking)\ndf1 = pd.DataFrame({'A': [1, 2], 'B': [3, 4]})\ndf2 = pd.DataFrame({'A': [5, 6], 'B': [7, 8]})\nconcatenated = pd.concat([df1, df2], ignore_index=True)\n\n# Merge multiple DataFrames\ndf3 = df_users.merge(df_purchases, on='user_id').merge(df_orders, left_on='user_id', right_on='customer_id')"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
