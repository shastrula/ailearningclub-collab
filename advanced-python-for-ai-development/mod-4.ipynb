        [
          "python",
          "# Create large categorical dataset\ndf_large = pd.DataFrame({\n    'category': np.random.choice(['A', 'B', 'C', 'D', 'E'], 1000000),\n    'subcategory': np.random.choice(['Sub1', 'Sub2', 'Sub3', 'Sub4'], 1000000),\n    'value': np.random.randn(1000000)\n})\n\n# Memory usage before conversion\nprint(f\"Before: {df_large.memory_usage(deep=True).sum() / 1024**2:.2f} MB\")\n\n# Convert to categorical\ndf_large['category'] = df_large['category'].astype('category')\ndf_large['subcategory'] = df_large['subcategory'].astype('category')\n\n# Memory usage after conversion\nprint(f\"After: {df_large.memory_usage(deep=True).sum() / 1024**2:.2f} MB\")\n\n# Ordered categories with meaningful order\ndf_size = pd.DataFrame({'size': ['small', 'medium', 'large', 'small']})\ndf_size['size'] = pd.Categorical(\n    df_size['size'],\n    categories=['small', 'medium', 'large'],\n    ordered=True\n)\n\n# Now comparisons work\nprint(df_size['size'] > 'small')  # Meaningful comparison"
        ]
      ]
