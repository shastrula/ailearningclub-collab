        [
          "python",
          "# Self-join to find similar products\ndf_products = pd.DataFrame({\n    'id': [1, 2, 3, 4],\n    'category': ['A', 'A', 'B', 'B'],\n    'price': [10, 12, 20, 22]\n})\n\n# Find products in same category\nsame_category = df_products.merge(\n    df_products,\n    on='category',\n    suffixes=('', '_other')\n)\nsame_category = same_category[same_category['id'] < same_category['id_other']]  # Remove duplicates\n\n# Asof merge (nearest value)\ndf_trades = pd.DataFrame({\n    'time': pd.to_datetime(['10:00', '10:05', '10:10']),\n    'price': [100, 101, 99]\n}).set_index('time')\n\ndf_quotes = pd.DataFrame({\n    'time': pd.to_datetime(['10:01', '10:06', '10:11']),\n    'bid': [99.5, 100.5, 98.5]\n}).set_index('time')\n\n# Get price just before each quote\nresult = pd.merge_asof(\n    df_quotes.reset_index(),\n    df_trades.reset_index(),\n    on='time',\n    direction='backward'\n)\n\n# Merge on multiple keys with custom logic\ndf_left = pd.DataFrame({\n    'key1': [1, 1, 2],\n    'key2': ['A', 'B', 'A'],\n    'value_l': [10, 20, 30]\n})\n\ndf_right = pd.DataFrame({\n    'key1': [1, 2],\n    'key2': ['A', 'A'],\n    'value_r': [100, 200]\n})\n\nmerged = pd.merge(\n    df_left,\n    df_right,\n    on=['key1', 'key2'],\n    how='left'\n)"
        ]
