        [
          "python",
          "# Check memory usage\nprint(df.memory_usage(deep=True))\n\n# Convert data types to reduce memory\ndf['user_id'] = df['user_id'].astype('int32')        # int64 \u2192 int32\ndf['score'] = df['score'].astype('float32')          # float64 \u2192 float32\ndf['country'] = df['country'].astype('category')     # String \u2192 category\ndf['is_active'] = df['is_active'].astype('bool')     # Object \u2192 bool\n\n# Create memory-efficient DataFrame\ndf_optimized = pd.DataFrame({\n    'id': pd.array([1, 2, 3], dtype='int32'),\n    'category': pd.Categorical(['A', 'B', 'A']),\n    'value': pd.array([1.5, 2.5, 3.5], dtype='float32')\n})\n\n# Process in chunks (for very large files)\ndef process_large_file(filepath, chunksize=10000):\n    results = []\n    for chunk in pd.read_csv(filepath, chunksize=chunksize):\n        # Process each chunk\n        chunk['processed'] = chunk['value'] * 2\n        results.append(chunk)\n    return pd.concat(results, ignore_index=True)\n\n# Select relevant columns early (reduces memory)\ndf_subset = pd.read_csv('file.csv', usecols=['id', 'name', 'score'])\n\n# Delete unused DataFrames\ndel df_large"
        ]
