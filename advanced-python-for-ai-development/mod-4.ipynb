    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Complex time-based calculations\ndf_transactions = pd.DataFrame({\n    'date': pd.date_range('2024-01-01', periods=100),\n    'customer_id': np.random.choice([1, 2, 3, 4], 100),\n    'amount': np.random.randint(50, 500, 100)\n})\n\n# Customer lifetime value with exponential decay\ndf_transactions['days_ago'] = (df_transactions['date'].max() - df_transactions['date']).dt.days\ndf_transactions['recency_weight'] = np.exp(-df_transactions['days_ago'] / 30)  # Decay over 30 days\ndf_transactions['weighted_amount'] = df_transactions['amount'] * df_transactions['recency_weight']\n\nclv = (df_transactions\n    .groupby('customer_id')\n    .agg({\n        'amount': ['sum', 'mean', 'count'],\n        'weighted_amount': 'sum',\n        'date': ['min', 'max']\n    })\n    .round(2)\n)\n\n# Cumulative metrics per customer\ndf_transactions['cumulative_spend'] = (df_transactions\n    .sort_values('date')\n    .groupby('customer_id')['amount']\n    .cumsum()\n)\n\n# Rank within group\ndf_transactions['spend_rank'] = (df_transactions\n    .groupby('customer_id')['amount']\n    .rank(ascending=False)\n)\n\n# Percent of group total\ndf_transactions['pct_of_customer_spend'] = (df_transactions['amount'] / \n    df_transactions.groupby('customer_id')['amount'].transform('sum') * 100\n)"
        ]
      ]
    },
    {
