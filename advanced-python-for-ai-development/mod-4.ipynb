      "outputs": [],
      "source": [
        [
          "python",
          "# Create sample transaction data\ndf_transactions = pd.DataFrame({\n    'date': pd.date_range('2024-01-01', periods=200),\n    'category': np.random.choice(['Food', 'Transport', 'Entertainment', 'Utilities'], 200),\n    'store': np.random.choice(['Store A', 'Store B', 'Store C'], 200),\n    'amount': np.random.randint(10, 100, 200)\n})\n\n# Simple pivot table\npivot = pd.pivot_table(\n    df_transactions,\n    values='amount',\n    index='category',\n    columns='store',\n    aggfunc='sum'\n)\n\n# Multiple aggregations\npivot_multi = pd.pivot_table(\n    df_transactions,\n    values='amount',\n    index='category',\n    columns='store',\n    aggfunc=['sum', 'mean', 'count']\n)\n\n# Melt: unpivot wide to long format\ndf_wide = pd.DataFrame({\n    'id': [1, 2, 3],\n    'Q1_2024': [100, 150, 120],\n    'Q2_2024': [110, 160, 130],\n    'Q3_2024': [120, 170, 140]\n})\n\ndf_long = pd.melt(\n    df_wide,\n    id_vars=['id'],\n    value_vars=['Q1_2024', 'Q2_2024', 'Q3_2024'],\n    var_name='quarter',\n    value_name='revenue'\n)\n\n# Stack/unstack\ndf_stacked = pivot.stack()      # Convert columns to rows\ndf_unstacked = df_stacked.unstack()  # Convert back"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Create time series\ndates = pd.date_range('2024-01-01', periods=365, freq='D')\nts_data = pd.DataFrame({\n    'date': dates,\n    'value': np.random.randn(365).cumsum(),  # Random walk\n    'volume': np.random.randint(100, 1000, 365)\n})\nts_data.set_index('date', inplace=True)\n\n# Resampling (downsampling and upsampling)\ndaily = ts_data.resample('D').mean()          # Daily\nweekly = ts_data.resample('W').mean()         # Weekly\nmonthly = ts_data.resample('M').mean()        # Monthly\nquarterly = ts_data.resample('Q').mean()      # Quarterly\n\n# Upsampling with interpolation\nhourly = ts_data.resample('H').interpolate()\n\n# Rolling calculations (moving average, standard deviation)\nts_data['rolling_mean_7'] = ts_data['value'].rolling(window=7).mean()\nts_data['rolling_std_7'] = ts_data['value'].rolling(window=7).std()\nts_data['rolling_min'] = ts_data['value'].rolling(window=7).min()\nts_data['rolling_max'] = ts_data['value'].rolling(window=7).max()\n\n# Expanding calculations (cumulative from start)\nts_data['expanding_mean'] = ts_data['value'].expanding().mean()\nts_data['expanding_sum'] = ts_data['volume'].expanding().sum()\n\n# Lag and shift (previous values)\nts_data['prev_value'] = ts_data['value'].shift(1)\nts_data['value_change'] = ts_data['value'].diff()\nts_data['pct_change'] = ts_data['value'].pct_change()"
        ]
      ]
    },
