          "python",
          "# pip install langchain\nfrom langchain.agents import Tool, initialize_agent, AgentType\nfrom langchain.tools import DuckDuckGoSearchRun\nfrom langchain.chat_models import ChatOpenAI\nimport json\n\n# Define tools agent can use\nsearch = DuckDuckGoSearchRun()\n\ndef calculator(expression):\n    \"\"\"Evaluate mathematical expression.\"\"\"\n    try:\n        return str(eval(expression))\n    except:\n        return \"Error: Invalid expression\"\n\ndef get_stock_price(ticker):\n    \"\"\"Fetch stock price (mock).\"\"\"\n    prices = {\"AAPL\": 150.25, \"GOOGL\": 140.50, \"MSFT\": 380.00}\n    return str(prices.get(ticker, \"Symbol not found\"))\n\ntools = [\n    Tool(\n        name=\"Search\",\n        func=search.run,\n        description=\"Search the internet for information\"\n    ),\n    Tool(\n        name=\"Calculator\",\n        func=calculator,\n        description=\"Solve math problems\"\n    ),\n    Tool(\n        name=\"StockPrice\",\n        func=get_stock_price,\n        description=\"Get current stock price\"\n    )\n]\n\n# Initialize agent\nllm = ChatOpenAI(model_name=\"gpt-4\", temperature=0)\nagent = initialize_agent(\n    tools,\n    llm,\n    agent=AgentType.CHAT_ZERO_SHOT_REACT_DESCRIPTION,\n    verbose=True\n)\n\n# Agent decides which tools to use\nresponse = agent.run(\n    \"What's Apple's stock price? Multiply it by 2 and tell me the result.\"\n)\n# Agent: 1) Calls StockPrice(\"AAPL\"), gets 150.25\n#        2) Calls Calculator(\"150.25 * 2\"), gets 300.5\n#        3) Answers: \"Apple's stock price is $150.25. Doubled: $300.50\""
        ]
      ]
    },
