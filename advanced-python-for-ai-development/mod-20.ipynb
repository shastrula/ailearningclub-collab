          "python",
          "import tensorflow as tf\n\n# Quantization: reduce precision (float32 \u2192 int8)\n# Before: 100MB model\n# After: 25MB (4x smaller), near-identical accuracy\n\nconverter = tf.lite.TFLiteConverter.from_saved_model(\"model\")\nconverter.optimizations = [tf.lite.Optimize.DEFAULT]\nconverter.target_spec.supported_types = [tf.int8]\nquantized_model = converter.convert()\n\n# Pruning: remove unimportant weights\nimport tensorflow_model_optimization as tfmot\n\npruning_schedule = tfmot.sparsity.keras.PolynomialDecay(\n    initial_sparsity=0.0,\n    final_sparsity=0.5,  # Remove 50% of weights\n    begin_step=0,\n    end_step=1000\n)\n\nmodel_for_pruning = tfmot.sparsity.keras.prune_low_magnitude(\n    model,\n    pruning_schedule=pruning_schedule\n)\n\n# Knowledge Distillation: teach small model from large model\n# Large model (teacher): 500MB, 95% accuracy\n# Small model (student): 20MB, 93% accuracy (trained to mimic teacher)\n\ndef create_student_model():\n    return tf.keras.Sequential([\n        tf.keras.layers.Dense(32, activation='relu'),\n        tf.keras.layers.Dense(10)\n    ])\n\ndef distillation_loss(y_true, y_pred):\n    teacher_preds = teacher_model(X)\n    temperature = 4  # Controls softness of teacher predictions\n    return tf.keras.losses.KLDivergence()(\n        tf.nn.softmax(teacher_preds / temperature),\n        tf.nn.softmax(y_pred / temperature)\n    )\n\n# Train student to match teacher's outputs\nstudent = create_student_model()\nstudent.compile(loss=distillation_loss, optimizer='adam')\nstudent.fit(X_train, y_train)  # Student mimics teacher"
        ]
