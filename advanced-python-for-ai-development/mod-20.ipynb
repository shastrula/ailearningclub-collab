        [
          "python",
          "# pip install openai pillow\nfrom openai import OpenAI\nfrom PIL import Image\nimport base64\n\nclient = OpenAI()\n\ndef analyze_image_with_text(image_path, question):\n    \"\"\"Analyze image using GPT-4V.\"\"\"\n    \n    # Encode image to base64\n    with open(image_path, \"rb\") as img_file:\n        encoded_image = base64.b64encode(img_file.read()).decode(\"utf-8\")\n    \n    # Send to GPT-4V\n    response = client.chat.completions.create(\n        model=\"gpt-4-vision-preview\",\n        messages=[\n            {\n                \"role\": \"user\",\n                \"content\": [\n                    {\"type\": \"text\", \"text\": question},\n                    {\n                        \"type\": \"image_url\",\n                        \"image_url\": {\n                            \"url\": f\"data:image/jpeg;base64,{encoded_image}\"\n                        }\n                    }\n                ]\n            }\n        ]\n    )\n    \n    return response.choices[0].message.content\n\n# Analyze an image\nanswer = analyze_image_with_text(\n    \"chart.png\",\n    \"What trend does this chart show? Provide insights.\"\n)\nprint(answer)\n\n# Audio transcription and understanding\nfrom openai import OpenAI\n\nclient = OpenAI()\n\ndef transcribe_and_summarize(audio_file):\n    \"\"\"Transcribe audio, then summarize with GPT.\"\"\"\n    \n    # Transcribe\n    with open(audio_file, \"rb\") as audio:\n        transcript = client.audio.transcriptions.create(\n            model=\"whisper-1\",\n            file=audio\n        )\n    \n    # Summarize transcript with GPT\n    summary = client.chat.completions.create(\n        model=\"gpt-4\",\n        messages=[\n            {\n                \"role\": \"user\",\n                \"content\": f\"Summarize this in 3 sentences:\\n{transcript.text}\"\n            }\n        ]\n    )\n    \n    return {\n        \"transcript\": transcript.text,\n        \"summary\": summary.choices[0].message.content\n    }\n\nresult = transcribe_and_summarize(\"meeting.mp3\")\nprint(f\"Transcript: {result['transcript']}\")\nprint(f\"Summary: {result['summary']}\")"
        ]
      ]
