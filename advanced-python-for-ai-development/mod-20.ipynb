          "python",
          "# pip install openai\nimport openai\n\nopenai.api_key = \"sk-...\"  # Your API key\n\n# Simple completion\nresponse = openai.ChatCompletion.create(\n    model=\"gpt-4\",\n    messages=[\n        {\"role\": \"system\", \"content\": \"You are a data science assistant.\"},\n        {\"role\": \"user\", \"content\": \"Explain random forest models to a beginner.\"}\n    ],\n    temperature=0.7,\n    max_tokens=500\n)\n\nprint(response['choices'][0]['message']['content'])\n\n# Streaming response (real-time output)\nresponse = openai.ChatCompletion.create(\n    model=\"gpt-4\",\n    messages=[{\"role\": \"user\", \"content\": \"Write Python code for linear regression.\"}],\n    stream=True\n)\n\nfor chunk in response:\n    if 'content' in chunk['choices'][0]['delta']:\n        print(chunk['choices'][0]['delta']['content'], end='', flush=True)"
        ]
