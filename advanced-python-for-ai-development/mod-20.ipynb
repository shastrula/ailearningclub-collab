          "python",
          "# Pydantic V2: data validation (stricter, faster)\nfrom pydantic import BaseModel, ValidationError\n\nclass DataPoint(BaseModel):\n    x: float\n    y: float\n    label: str\n\n# Type-checked, validated\npoint = DataPoint(x=1.0, y=2.0, label=\"training\")\n# point = DataPoint(x=\"invalid\", ...) -> ValidationError\n\n# Polars: Pandas alternative (faster, cleaner API)\nimport polars as pl\n\ndf = pl.read_csv(\"data.csv\")\nresult = df.select(\n    pl.col(\"age\").mean().alias(\"avg_age\"),\n    pl.col(\"salary\").max().alias(\"max_salary\")\n)\n\n# Hugging Face Transformers: easy access to 100k+ models\nfrom transformers import pipeline\n\nclassifier = pipeline(\"text-classification\")\nresult = classifier(\"I love this movie!\")\n# {\"label\": \"POSITIVE\", \"score\": 0.9999}\n\n# Instructor: LLMs for structured data extraction\n# pip install instructor\nimport instructor\nfrom anthropic import Anthropic\n\nclient = instructor.from_anthropic(Anthropic())\n\nclass UserInfo(BaseModel):\n    name: str\n    age: int\n\nuser = client.messages.create(\n    model=\"claude-3-opus-20240229\",\n    max_tokens=1024,\n    messages=[{\"role\": \"user\", \"content\": \"My name is Alice, I'm 30.\"}],\n    response_model=UserInfo\n)\n# user.name = \"Alice\", user.age = 30 (structured, validated)"
