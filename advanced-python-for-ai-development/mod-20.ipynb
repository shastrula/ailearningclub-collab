          "python",
          "# Python 3.11+: 1.4x faster (optimizations in interpreter)\n# Python 3.12+: continues improvements (PEP 688, structural patterns)\n\n# Adaptive Specialization (3.11+): detects hot loops, optimizes\ndef hot_loop(n):\n    total = 0\n    for i in range(n):\n        total += i ** 2  # This loop gets optimized\n    return total\n\n# Much faster in 3.11+ than 3.10\n\n# For AI: use PyPy (faster for pure Python) or Rust bindings (NumPy/PyTorch)\n# Use mojo (Python subset) for extreme performance\n\n# Typing improvements for better optimization\nfrom typing import List\n\ndef process_numbers(numbers: List[int]) -> int:\n    \"\"\"Type hints enable compiler optimizations.\"\"\"\n    return sum(numbers)"
