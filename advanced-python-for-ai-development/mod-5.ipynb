          "python",
          "class BatchAPIClient:\n    def __init__(self, base_url, api_key, batch_size=100):\n        self.base_url = base_url\n        self.api_key = api_key\n        self.batch_size = batch_size\n    \n    def batch_create(self, items):\n        \"\"\"Create multiple items in batches.\"\"\"\n        results = []\n        headers = {'Authorization': f'Bearer {self.api_key}'}\n        \n        for i in range(0, len(items), self.batch_size):\n            batch = items[i:i + self.batch_size]\n            \n            payload = {'items': batch}\n            response = requests.post(\n                f'{self.base_url}/batch/create',\n                json=payload,\n                headers=headers\n            )\n            response.raise_for_status()\n            results.extend(response.json()['created'])\n        \n        return results\n    \n    def batch_delete(self, ids):\n        \"\"\"Delete multiple items in batches.\"\"\"\n        headers = {'Authorization': f'Bearer {self.api_key}'}\n        \n        for i in range(0, len(ids), self.batch_size):\n            batch_ids = ids[i:i + self.batch_size]\n            \n            response = requests.post(\n                f'{self.base_url}/batch/delete',\n                json={'ids': batch_ids},\n                headers=headers\n            )\n            response.raise_for_status()\n    \n    def batch_update(self, updates):\n        \"\"\"Update multiple items efficiently.\"\"\"\n        results = []\n        headers = {'Authorization': f'Bearer {self.api_key}'}\n        \n        for i in range(0, len(updates), self.batch_size):\n            batch = updates[i:i + self.batch_size]\n            \n            response = requests.patch(\n                f'{self.base_url}/batch/update',\n                json={'updates': batch},\n                headers=headers\n            )\n            response.raise_for_status()\n            results.extend(response.json()['updated'])\n        \n        return results\n\n\n# Usage\nclient = BatchAPIClient('https://api.example.com', 'api_key')\nnew_items = [{'name': f'Item {i}'} for i in range(250)]\ncreated = client.batch_create(new_items)  # Automatically batches into 3 requests"
        ]
      ]
    },
