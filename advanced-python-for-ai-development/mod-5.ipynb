          "python",
          "from flask import Flask, request\nimport hmac\nimport hashlib\n\napp = Flask(__name__)\n\nclass WebhookValidator:\n    def __init__(self, secret):\n        self.secret = secret.encode()\n    \n    def validate(self, payload, signature):\n        \"\"\"Verify webhook signature to ensure it's from the API provider.\"\"\"\n        computed_sig = hmac.new(\n            self.secret,\n            payload,\n            hashlib.sha256\n        ).hexdigest()\n        return hmac.compare_digest(computed_sig, signature)\n\n\nwebhook_validator = WebhookValidator('webhook_secret_key')\nevent_handlers = {}\n\n\ndef register_handler(event_type):\n    \"\"\"Decorator to register event handlers.\"\"\"\n    def decorator(func):\n        event_handlers[event_type] = func\n        return func\n    return decorator\n\n\n@register_handler('payment.completed')\ndef handle_payment_completed(event_data):\n    print(f\"Processing payment: {event_data}\")\n    # Update database, send confirmation, etc.\n\n\n@register_handler('subscription.canceled')\ndef handle_subscription_canceled(event_data):\n    print(f\"Processing cancellation: {event_data}\")\n    # Clean up resources, send goodbye email, etc.\n\n\n@app.route('/webhook', methods=['POST'])\ndef webhook():\n    payload = request.get_data()\n    signature = request.headers.get('X-Signature')\n    \n    if not webhook_validator.validate(payload, signature):\n        return {'error': 'Invalid signature'}, 401\n    \n    event = request.json\n    handler = event_handlers.get(event['type'])\n    \n    if handler:\n        try:\n            handler(event['data'])\n            return {'status': 'ok'}, 200\n        except Exception as e:\n            print(f\"Error handling event: {e}\")\n            return {'error': str(e)}, 500\n    \n    return {'status': 'unknown_event'}, 202"
        ]
      ]
    },
