          "python",
          "from unittest.mock import Mock, patch, MagicMock\n\nclass APIClientTester:\n    @staticmethod\n    def test_successful_request():\n        \"\"\"Test successful API request.\"\"\"\n        with patch('requests.get') as mock_get:\n            # Mock the response\n            mock_response = Mock()\n            mock_response.json.return_value = {'id': 1, 'name': 'Test'}\n            mock_response.status_code = 200\n            mock_get.return_value = mock_response\n            \n            # Call API client\n            client = WeatherAPIClient('https://api.example.com', 'key')\n            result = client.get('weather', params={'city': 'NYC'})\n            \n            # Assertions\n            assert result['id'] == 1\n            mock_get.assert_called_once()\n    \n    @staticmethod\n    def test_rate_limiting():\n        \"\"\"Test rate limiting handling.\"\"\"\n        with patch('requests.get') as mock_get:\n            # Mock rate limit response\n            mock_response = Mock()\n            mock_response.status_code = 429\n            mock_response.headers = {'Retry-After': '1'}\n            mock_get.side_effect = [mock_response, Mock(json=lambda: {'data': 'ok'})]\n            \n            # Should handle and retry\n            client = RateLimitedClient('https://api.example.com', 'key')\n            # Implementation should handle the 429 and retry\n    \n    @staticmethod\n    def test_error_handling():\n        \"\"\"Test error handling.\"\"\"\n        with patch('requests.get') as mock_get:\n            mock_get.side_effect = requests.ConnectionError(\"Connection failed\")\n            \n            client = WeatherAPIClient('https://api.example.com', 'key')\n            try:\n                client.get('weather')\n                assert False, \"Should have raised exception\"\n            except requests.ConnectionError:\n                pass  # Expected"
        ]
