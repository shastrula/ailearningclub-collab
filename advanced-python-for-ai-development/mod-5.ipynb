          "python",
          "import os\nfrom requests.auth import HTTPBasicAuth, HTTPDigestAuth\n\n# 1. API Key Authentication (in header)\napi_key = os.environ.get('API_KEY')\nheaders = {'Authorization': f'Bearer {api_key}'}\nresponse = requests.get('https://api.example.com/data', headers=headers)\n\n# 2. API Key in URL parameters\nparams = {'api_key': api_key}\nresponse = requests.get('https://api.example.com/data', params=params)\n\n# 3. Basic Authentication (username:password base64 encoded)\nresponse = requests.get(\n    'https://api.example.com/data',\n    auth=HTTPBasicAuth('username', 'password')\n)\n# Or simply:\nresponse = requests.get('https://api.example.com/data', auth=('username', 'password'))\n\n# 4. Digest Authentication (more secure than Basic)\nresponse = requests.get(\n    'https://api.example.com/data',\n    auth=HTTPDigestAuth('username', 'password')\n)\n\n# 5. OAuth 2.0 (token-based)\nclass OAuth2Handler:\n    def __init__(self, client_id, client_secret, token_url):\n        self.client_id = client_id\n        self.client_secret = client_secret\n        self.token_url = token_url\n        self.access_token = None\n    \n    def get_token(self):\n        \"\"\"Obtain access token.\"\"\"\n        payload = {\n            'grant_type': 'client_credentials',\n            'client_id': self.client_id,\n            'client_secret': self.client_secret\n        }\n        response = requests.post(self.token_url, data=payload)\n        self.access_token = response.json()['access_token']\n        return self.access_token\n    \n    def make_request(self, url, method='GET', **kwargs):\n        \"\"\"Make authenticated request.\"\"\"\n        if not self.access_token:\n            self.get_token()\n        \n        headers = kwargs.get('headers', {})\n        headers['Authorization'] = f'Bearer {self.access_token}'\n        kwargs['headers'] = headers\n        \n        response = requests.request(method, url, **kwargs)\n        \n        # Refresh token if expired\n        if response.status_code == 401:\n            self.get_token()\n            headers['Authorization'] = f'Bearer {self.access_token}'\n            response = requests.request(method, url, **kwargs)\n        \n        return response\n\n\n# Usage\noauth = OAuth2Handler(\n    client_id='your_client_id',\n    client_secret='your_client_secret',\n    token_url='https://auth.example.com/oauth/token'\n)\nresponse = oauth.make_request('https://api.example.com/data')"
        ]
      ]
