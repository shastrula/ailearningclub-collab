          "python",
          "class PaginatedAPIClient:\n    def __init__(self, base_url: str, api_key: str):\n        self.base_url = base_url\n        self.headers = {'Authorization': f'Bearer {api_key}'}\n    \n    def get_all_pages_offset(self, endpoint: str, per_page: int = 100) -> List[Dict]:\n        \"\"\"Offset/limit pagination.\"\"\"\n        all_data = []\n        offset = 0\n        \n        while True:\n            params = {'limit': per_page, 'offset': offset}\n            response = requests.get(\n                f'{self.base_url}/{endpoint}',\n                params=params,\n                headers=self.headers\n            )\n            response.raise_for_status()\n            \n            data = response.json()\n            if not data or len(data) == 0:\n                break\n            \n            all_data.extend(data)\n            offset += per_page\n        \n        return all_data\n    \n    def get_all_pages_cursor(self, endpoint: str, per_page: int = 100) -> List[Dict]:\n        \"\"\"Cursor-based pagination (more efficient).\"\"\"\n        all_data = []\n        cursor = None\n        \n        while True:\n            params = {'limit': per_page}\n            if cursor:\n                params['cursor'] = cursor\n            \n            response = requests.get(\n                f'{self.base_url}/{endpoint}',\n                params=params,\n                headers=self.headers\n            )\n            response.raise_for_status()\n            \n            result = response.json()\n            all_data.extend(result['data'])\n            \n            # Check if more pages exist\n            if 'next_cursor' not in result or not result['next_cursor']:\n                break\n            \n            cursor = result['next_cursor']\n        \n        return all_data\n    \n    def get_all_pages_link(self, endpoint: str) -> List[Dict]:\n        \"\"\"Link-based pagination (via Link header).\"\"\"\n        all_data = []\n        url = f'{self.base_url}/{endpoint}'\n        \n        while url:\n            response = requests.get(url, headers=self.headers)\n            response.raise_for_status()\n            \n            all_data.extend(response.json())\n            \n            # Extract next link from Link header\n            link_header = response.headers.get('Link', '')\n            url = None\n            if 'rel=\"next\"' in link_header:\n                # Parse next URL from Link header\n                parts = link_header.split(', ')\n                for part in parts:\n                    if 'rel=\"next\"' in part:\n                        url = part.split(';')[0].strip('<>')\n        \n        return all_data"
        ]
      ]
