          "python",
          "class ModelComparator:\n    @staticmethod\n    def compare_models(models, X_train, X_test, y_train, y_test):\n        \"\"\"Compare multiple models on same dataset.\"\"\"\n        results = []\n        \n        for name, model in models:\n            model.fit(X_train, y_train)\n            \n            y_pred = model.predict(X_test)\n            \n            results.append({\n                'model': name,\n                'accuracy': accuracy_score(y_test, y_pred),\n                'precision': precision_score(y_test, y_pred),\n                'recall': recall_score(y_test, y_pred),\n                'f1': f1_score(y_test, y_pred)\n            })\n        \n        return pd.DataFrame(results).sort_values('f1', ascending=False)\n    \n    @staticmethod\n    def ensemble_comparison(X_train, X_test, y_train, y_test):\n        \"\"\"Compare different ensemble strategies.\"\"\"\n        models = [\n            ('Random Forest', RandomForestClassifier(n_estimators=100)),\n            ('Gradient Boosting', GradientBoostingClassifier(n_estimators=100)),\n            ('Ada Boost', AdaBoostClassifier(n_estimators=100)),\n            ('Voting (Hard)', VotingClassifier(\n                estimators=[\n                    ('rf', RandomForestClassifier()),\n                    ('gb', GradientBoostingClassifier())\n                ]\n            ))\n        ]\n        \n        return ModelComparator.compare_models(models, X_train, X_test, y_train, y_test)\n\n\n# Usage\nfrom sklearn.ensemble import AdaBoostClassifier\nmodels = [\n    ('Logistic Regression', LogisticRegression()),\n    ('Random Forest', RandomForestClassifier()),\n    ('SVM', SVC())\n]\n\ncomparison = ModelComparator.compare_models(models, X_train, X_test, y_train, y_test)\nprint(comparison)"
