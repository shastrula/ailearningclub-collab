          "python",
          "import json\nfrom datetime import datetime\n\nclass MLExperiment:\n    def __init__(self, name, description):\n        self.name = name\n        self.description = description\n        self.timestamp = datetime.now().isoformat()\n        self.metadata = {}\n        self.metrics = {}\n        self.model_path = None\n    \n    def log_params(self, **params):\n        \"\"\"Log hyperparameters.\"\"\"\n        self.metadata['params'] = params\n    \n    def log_metrics(self, **metrics):\n        \"\"\"Log evaluation metrics.\"\"\"\n        self.metrics = metrics\n    \n    def save_experiment(self, filepath):\n        \"\"\"Save experiment results.\"\"\"\n        experiment_data = {\n            'name': self.name,\n            'description': self.description,\n            'timestamp': self.timestamp,\n            'metadata': self.metadata,\n            'metrics': self.metrics\n        }\n        \n        with open(filepath, 'w') as f:\n            json.dump(experiment_data, f, indent=2)\n    \n    @classmethod\n    def load_experiment(cls, filepath):\n        \"\"\"Load experiment results.\"\"\"\n        with open(filepath, 'r') as f:\n            data = json.load(f)\n        \n        exp = cls(data['name'], data['description'])\n        exp.timestamp = data['timestamp']\n        exp.metadata = data['metadata']\n        exp.metrics = data['metrics']\n        return exp\n\n\nclass MLExperimentTracker:\n    def __init__(self, experiments_dir='experiments'):\n        self.experiments_dir = experiments_dir\n        self.experiments = []\n    \n    def track_experiment(self, name, model, X_train, X_test, y_train, y_test, **params):\n        \"\"\"Track a complete experiment.\"\"\"\n        exp = MLExperiment(name, \"Tracked experiment\")\n        exp.log_params(**params)\n        \n        # Train model\n        model.fit(X_train, y_train)\n        \n        # Evaluate\n        y_pred = model.predict(X_test)\n        metrics = {\n            'accuracy': accuracy_score(y_test, y_pred),\n            'precision': precision_score(y_test, y_pred, average='weighted'),\n            'recall': recall_score(y_test, y_pred, average='weighted'),\n            'f1': f1_score(y_test, y_pred, average='weighted')\n        }\n        \n        exp.log_metrics(**metrics)\n        self.experiments.append(exp)\n        \n        return exp\n    \n    def get_best_experiment(self, metric='f1'):\n        \"\"\"Get best experiment by metric.\"\"\"\n        if not self.experiments:\n            return None\n        \n        best = max(self.experiments, key=lambda e: e.metrics.get(metric, 0))\n        return best\n\n\n# Usage\ntracker = MLExperimentTracker()\n\nfor lr in [0.001, 0.01, 0.1]:\n    for c in [0.1, 1, 10]:\n        model = LogisticRegression(C=c, max_iter=1000)\n        exp = tracker.track_experiment(\n            f\"lr_{lr}_c_{c}\",\n            model,\n            X_train, X_test, y_train, y_test,\n            learning_rate=lr,\n            C=c\n        )\n        print(f\"Experiment {exp.name}: F1 = {exp.metrics['f1']:.4f}\")\n\nbest_exp = tracker.get_best_experiment('f1')\nprint(f\"Best experiment: {best_exp.name}\")"
        ]
