          "python",
          "from sklearn.feature_selection import SelectKBest, f_classif, RFE, VarianceThreshold\nfrom sklearn.preprocessing import PolynomialFeatures\n\nclass FeatureEngineer:\n    @staticmethod\n    def variance_based_selection(X, threshold=0.01):\n        \"\"\"Remove low-variance features.\"\"\"\n        selector = VarianceThreshold(threshold=threshold)\n        X_selected = selector.fit_transform(X)\n        return X_selected, selector.get_feature_names_out()\n    \n    @staticmethod\n    def univariate_selection(X, y, k=10):\n        \"\"\"Select k best features using statistical tests.\"\"\"\n        selector = SelectKBest(score_func=f_classif, k=k)\n        X_selected = selector.fit_transform(X, y)\n        return X_selected, selector.get_feature_names_out()\n    \n    @staticmethod\n    def recursive_elimination(X, y, n_features=10):\n        \"\"\"Recursive feature elimination.\"\"\"\n        estimator = LogisticRegression(max_iter=1000)\n        rfe = RFE(estimator, n_features_to_select=n_features)\n        X_selected = rfe.fit_transform(X, y)\n        return X_selected, rfe.get_feature_names_out()\n    \n    @staticmethod\n    def create_polynomial_features(X, degree=2):\n        \"\"\"Create polynomial interaction features.\"\"\"\n        poly = PolynomialFeatures(degree=degree, include_bias=False)\n        X_poly = poly.fit_transform(X)\n        return X_poly, poly.get_feature_names_out()\n\n\n# Domain-specific feature engineering for ML\nclass MLDomainFeatures:\n    @staticmethod\n    def engineer_features(df):\n        \"\"\"Create domain-specific features.\"\"\"\n        df_engineered = df.copy()\n        \n        # Interactions\n        df_engineered['age_income_interaction'] = df['age'] * df['income'] / 1000\n        \n        # Polynomial features\n        df_engineered['age_squared'] = df['age'] ** 2\n        df_engineered['income_log'] = np.log1p(df['income'])\n        \n        # Ratios\n        df_engineered['debt_to_income'] = df['debt'] / (df['income'] + 1)\n        \n        # Binning\n        df_engineered['age_bin'] = pd.cut(df['age'], bins=[0, 25, 35, 50, 100])\n        \n        # Encoding\n        df_engineered['city_encoded'] = pd.factorize(df['city'])[0]\n        \n        return df_engineered"
        ]
      ]
