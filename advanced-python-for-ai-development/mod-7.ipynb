          "python",
          "from sklearn.base import BaseEstimator, TransformerMixin\n\nclass LogTransformer(BaseEstimator, TransformerMixin):\n    \"\"\"Apply log transformation to numeric features.\"\"\"\n    \n    def __init__(self, epsilon=1e-9):\n        self.epsilon = epsilon\n    \n    def fit(self, X, y=None):\n        return self\n    \n    def transform(self, X):\n        return np.log(X + self.epsilon)\n    \n    def get_feature_names_out(self, input_features=None):\n        return np.array([f'log_{f}' for f in input_features])\n\n\nclass PolynomialFeatures(BaseEstimator, TransformerMixin):\n    \"\"\"Create polynomial and interaction features.\"\"\"\n    \n    def __init__(self, degree=2):\n        self.degree = degree\n    \n    def fit(self, X, y=None):\n        return self\n    \n    def transform(self, X):\n        output = [X]\n        for d in range(2, self.degree + 1):\n            output.append(X ** d)\n        return np.column_stack(output)\n    \n    def get_feature_names_out(self, input_features=None):\n        names = []\n        for feat in input_features:\n            for d in range(1, self.degree + 1):\n                names.append(f'{feat}^{d}')\n        return np.array(names)\n\n\nclass RobustOutlierRemover(BaseEstimator, TransformerMixin):\n    \"\"\"Remove outliers using IQR method.\"\"\"\n    \n    def __init__(self, multiplier=1.5):\n        self.multiplier = multiplier\n        self.Q1_ = None\n        self.Q3_ = None\n        self.IQR_ = None\n    \n    def fit(self, X, y=None):\n        self.Q1_ = np.percentile(X, 25, axis=0)\n        self.Q3_ = np.percentile(X, 75, axis=0)\n        self.IQR_ = self.Q3_ - self.Q1_\n        return self\n    \n    def transform(self, X):\n        lower_bound = self.Q1_ - self.multiplier * self.IQR_\n        upper_bound = self.Q3_ + self.multiplier * self.IQR_\n        return np.clip(X, lower_bound, upper_bound)\n\n\n# Use custom transformers in pipeline\ncustom_pipeline = Pipeline(steps=[\n    ('outlier_removal', RobustOutlierRemover(multiplier=1.5)),\n    ('polynomial_features', PolynomialFeatures(degree=2)),\n    ('log_transform', LogTransformer()),\n    ('scaler', StandardScaler()),\n    ('classifier', LogisticRegression())\n])"
        ]
      ]
    },
