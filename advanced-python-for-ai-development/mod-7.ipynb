          "python",
          "from sklearn.model_selection import (\n    cross_val_score, cross_validate, StratifiedKFold,\n    LeaveOneOut, ShuffleSplit, TimeSeriesSplit\n)\n\n# K-Fold cross-validation\nkfold = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\ncv_scores = cross_val_score(\n    pipeline, X_train, y_train, cv=kfold, scoring='accuracy'\n)\nprint(f\"CV Accuracy: {cv_scores.mean():.4f} (+/- {cv_scores.std():.4f})\")\n\n# Multiple metrics\nscoring = {\n    'accuracy': 'accuracy',\n    'precision': 'precision',\n    'recall': 'recall',\n    'f1': 'f1'\n}\n\ncv_results = cross_validate(\n    pipeline, X_train, y_train, cv=kfold, scoring=scoring\n)\n\n# Leave-One-Out (expensive but thorough)\nloo = LeaveOneOut()\nloo_scores = cross_val_score(pipeline, X_train, y_train, cv=loo)\nprint(f\"LOO Accuracy: {loo_scores.mean():.4f}\")\n\n# Shuffle Split (random proportions)\nshuffle_split = ShuffleSplit(n_splits=10, test_size=0.2, random_state=42)\nshuffle_scores = cross_val_score(\n    pipeline, X_train, y_train, cv=shuffle_split\n)\n\n# Time Series Split (for temporal data)\ntscv = TimeSeriesSplit(n_splits=5)\nts_scores = cross_val_score(\n    pipeline, X_train, y_train, cv=tscv, scoring='accuracy'\n)\n\n# Custom cross-validation\nfrom sklearn.model_selection import cross_validate\n\nresults = cross_validate(\n    pipeline, X_train, y_train,\n    cv=5,\n    scoring={'acc': 'accuracy', 'prec': 'precision'},\n    return_train_score=True\n)\n\ntrain_acc = results['train_acc'].mean()\ntest_acc = results['test_acc'].mean()\nprint(f\"Train: {train_acc:.4f}, Test: {test_acc:.4f}\")"
        ]
