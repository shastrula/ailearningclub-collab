          "python",
          "class ModelMonitor:\n    def __init__(self, baseline_metrics):\n        self.baseline_metrics = baseline_metrics\n        self.current_metrics = {}\n        self.drift_detected = False\n    \n    def calculate_metrics(self, y_true, y_pred):\n        \"\"\"Calculate current metrics.\"\"\"\n        self.current_metrics = {\n            'accuracy': accuracy_score(y_true, y_pred),\n            'precision': precision_score(y_true, y_pred, average='weighted'),\n            'recall': recall_score(y_true, y_pred, average='weighted'),\n            'f1': f1_score(y_true, y_pred, average='weighted')\n        }\n        return self.current_metrics\n    \n    def detect_drift(self, threshold=0.05):\n        \"\"\"Detect performance drift.\"\"\"\n        for metric, baseline_value in self.baseline_metrics.items():\n            current_value = self.current_metrics.get(metric, 0)\n            drift = abs(baseline_value - current_value) / baseline_value\n            \n            if drift > threshold:\n                self.drift_detected = True\n                print(f\"Drift detected in {metric}: {baseline_value:.4f} \u2192 {current_value:.4f}\")\n        \n        return self.drift_detected\n    \n    def get_report(self):\n        \"\"\"Generate monitoring report.\"\"\"\n        report = {\n            'baseline': self.baseline_metrics,\n            'current': self.current_metrics,\n            'drift_detected': self.drift_detected\n        }\n        \n        for metric in self.baseline_metrics.keys():\n            baseline = self.baseline_metrics[metric]\n            current = self.current_metrics.get(metric, 0)\n            change_pct = ((current - baseline) / baseline) * 100\n            report[f'{metric}_change_pct'] = change_pct\n        \n        return report"
        ]
