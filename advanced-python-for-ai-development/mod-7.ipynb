          "python",
          "from sklearn.pipeline import FeatureUnion\nfrom sklearn.preprocessing import PolynomialFeatures as SklearnPolynomialFeatures\n\n# Create multiple feature engineering branches\n# Branch 1: Polynomial features\npoly_features = Pipeline(steps=[\n    ('poly', SklearnPolynomialFeatures(degree=2, include_bias=False))\n])\n\n# Branch 2: Log transformation\nlog_features = Pipeline(steps=[\n    ('log', LogTransformer())\n])\n\n# Branch 3: Scaling only\nscaled_features = Pipeline(steps=[\n    ('scaler', StandardScaler())\n])\n\n# Combine branches\nfeature_union = FeatureUnion(\n    transformer_list=[\n        ('poly', poly_features),\n        ('log', log_features),\n        ('scaled', scaled_features)\n    ],\n    weights=[1.0, 0.5, 1.0]  # Give poly features more weight\n)\n\n# Full pipeline with feature union\nml_pipeline = Pipeline(steps=[\n    ('features', feature_union),\n    ('classifier', LogisticRegression(max_iter=1000))\n])\n\nml_pipeline.fit(X_train, y_train)\ny_pred = ml_pipeline.predict(X_test)"
        ]
      ]
