          "python",
          "# 1. Layers: separate dependencies from code\n# Create layer: zip external libraries\n# bash build_layer.sh:\n# pip install -r requirements.txt -t python\n# zip -r layer.zip python\n# Upload to Lambda\n\n# 2. Smaller deployment packages\n# Exclude unnecessary files\n# Use pip --platform manylinux2014 for compiled packages\n\n# 3. Lambda SnapStart (Java/Python 3.13+)\n# Pre-warms container, ~1000x faster start\n\n# 4. Provisioned Concurrency: keep containers warm\naws lambda put-provisioned-concurrency-config \\\n  --function-name ml-predict \\\n  --provisioned-concurrent-executions 10\n\n# Cost-benefit: paying for 10 \"warm\" instances vs. occasional 1s cold start\n\n# 5. Code optimization: minimal imports\n# BAD: imports in handler (runs every cold start)\ndef lambda_handler(event, context):\n    import pandas as pd  # Slow!\n    import tensorflow as tf  # Very slow!\n    ...\n\n# GOOD: imports at module level (cached between invocations)\nimport pandas as pd\nimport tensorflow as tf\n\ndef lambda_handler(event, context):\n    ..."
