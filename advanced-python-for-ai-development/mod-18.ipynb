          "bash",
          "# Current (blue) environment running v1.0\n# Deploy v2.0 to new (green) environment\n# Test green thoroughly\n# Switch traffic from blue to green instantly\n# If issues: switch back immediately\n\n# With AWS ECS:\naws ecs update-service \\\n  --cluster ml-cluster \\\n  --service ml-api-service \\\n  --task-definition ml-api:2 \\\n  --force-new-deployment\n\n# Green deployment starts alongside blue\n# Traffic switch happens at load balancer\n# No downtime, instant rollback capability"
        ]
