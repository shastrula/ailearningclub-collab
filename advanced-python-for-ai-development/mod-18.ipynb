        [
          "bash",
          "# Deploy v2.0 to 5% of traffic, 95% to v1.0\n# Monitor v2.0 for errors, latency\n# If healthy: increase to 25%, then 50%, then 100%\n# If issues: rollback to v1.0\n\n# With AWS Lambda traffic shifting:\naws cloudformation update-stack \\\n  --stack-name ml-api \\\n  --template-body file://template.yaml \\\n  --parameters ParameterKey=TrafficPercent,ParameterValue=5\n\n# Monitor for 5 minutes\n# Manually update to 25%, monitor again\n# Automate with alarms: if error_rate > 1%, rollback"
        ]
      ]
