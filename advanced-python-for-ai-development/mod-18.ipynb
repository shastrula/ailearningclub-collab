          "python",
          "# Instrument application with CloudWatch\nimport logging\nimport time\nfrom datetime import datetime\n\nlogger = logging.getLogger()\nlogger.setLevel(logging.INFO)\n\nclass PerformanceMonitor:\n    def __init__(self):\n        self.metrics = {}\n    \n    def log_prediction(self, model_id, latency_ms, confidence):\n        \"\"\"Log prediction metrics for monitoring.\"\"\"\n        logger.info(json.dumps({\n            \"timestamp\": datetime.utcnow().isoformat(),\n            \"model_id\": model_id,\n            \"latency_ms\": latency_ms,\n            \"confidence\": confidence,\n            \"event\": \"prediction\"\n        }))\n    \n    def log_error(self, model_id, error_msg):\n        \"\"\"Log errors for alerting.\"\"\"\n        logger.error(json.dumps({\n            \"timestamp\": datetime.utcnow().isoformat(),\n            \"model_id\": model_id,\n            \"error\": error_msg,\n            \"event\": \"inference_error\"\n        }))\n\nmonitor = PerformanceMonitor()\n\n@app.post(\"/predict\")\ndef predict(input_data: PredictionInput):\n    start = time.time()\n    try:\n        prediction = model.predict(np.array([input_data.features]))[0]\n        confidence = model.predict_proba(np.array([input_data.features])).max()\n        \n        latency_ms = (time.time() - start) * 1000\n        monitor.log_prediction(\"model-v2\", latency_ms, confidence)\n        \n        return {\"prediction\": prediction, \"confidence\": confidence}\n    \n    except Exception as e:\n        monitor.log_error(\"model-v2\", str(e))\n        raise HTTPException(status_code=500, detail=\"Inference failed\")"
        ]
      ]
    },
