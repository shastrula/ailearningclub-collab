        [
          "hcl",
          "# main.tf - Deploy Lambda for ML inference\n\nterraform {\n  required_version = \">= 1.0\"\n  \n  backend \"s3\" {\n    bucket = \"terraform-state\"\n    key    = \"ml-api/terraform.tfstate\"\n    region = \"us-east-1\"\n  }\n}\n\nresource \"aws_lambda_function\" \"ml_inference\" {\n  function_name = \"ml-predict-${var.environment}\"\n  role           = aws_iam_role.lambda_role.arn\n  handler        = \"lambda_function.lambda_handler\"\n  runtime        = \"python3.11\"\n  timeout        = 60\n  memory_size    = 512\n  \n  filename      = data.archive_file.lambda_zip.output_path\n  source_code_hash = data.archive_file.lambda_zip.output_base64sha256\n  \n  layers = [aws_lambda_layer_version.dependencies.arn]\n  \n  environment {\n    variables = {\n      MODEL_PATH = \"s3://${aws_s3_bucket.models.id}/model-v2.pkl\"\n      LOG_LEVEL  = \"INFO\"\n    }\n  }\n}\n\nresource \"aws_cloudwatch_log_group\" \"lambda_logs\" {\n  name              = \"/aws/lambda/ml-predict-${var.environment}\"\n  retention_in_days = 7\n}\n\nresource \"aws_lambda_permission\" \"api_invoke\" {\n  statement_id  = \"AllowAPIGatewayInvoke\"\n  action        = \"lambda:InvokeFunction\"\n  function_name = aws_lambda_function.ml_inference.function_name\n  principal     = \"apigateway.amazonaws.com\"\n  source_arn    = \"${aws_api_gateway_rest_api.ml_api.execution_arn}/*/*\"\n}\n\n# Deploy: terraform plan, terraform apply\n# Version control: commit Terraform files to Git\n# Reproducible: disaster recovery via terraform apply"
        ]
      ]
