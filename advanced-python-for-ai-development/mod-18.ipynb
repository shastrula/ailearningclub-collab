      "outputs": [],
      "source": [
        [
          "dockerfile",
          "# Stage 1: build\nFROM python:3.11 as builder\nWORKDIR /app\nCOPY requirements.txt .\nRUN pip install --user --no-cache-dir -r requirements.txt\n\n# Stage 2: runtime (smaller)\nFROM python:3.11-slim\nWORKDIR /app\nCOPY --from=builder /root/.local /root/.local\nCOPY . .\n\nENV PATH=/root/.local/bin:$PATH\nCMD [\"python\", \"main.py\"]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# main.py\nfrom fastapi import FastAPI, HTTPException\nfrom pydantic import BaseModel\nimport pickle\nimport numpy as np\n\napp = FastAPI(title=\"ML Model API\", version=\"1.0\")\n\n# Load model once at startup\nmodel = None\n\n@app.on_event(\"startup\")\ndef load_model():\n    global model\n    with open(\"model.pkl\", \"rb\") as f:\n        model = pickle.load(f)\n\nclass PredictionInput(BaseModel):\n    features: list[float]\n\nclass PredictionOutput(BaseModel):\n    prediction: float\n    confidence: float\n\n@app.post(\"/predict\")\ndef predict(input_data: PredictionInput) -> PredictionOutput:\n    \"\"\"Predict using input features.\"\"\"\n    if model is None:\n        raise HTTPException(status_code=500, detail=\"Model not loaded\")\n    \n    X = np.array([input_data.features])\n    prediction = model.predict(X)[0]\n    confidence = model.predict_proba(X).max()\n    \n    return PredictionOutput(prediction=float(prediction), confidence=float(confidence))\n\n@app.get(\"/health\")\ndef health_check():\n    \"\"\"Health check endpoint for load balancer.\"\"\"\n    return {\"status\": \"healthy\"}\n\n# Run: uvicorn main:app --reload"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# flask_app.py\nfrom flask import Flask, request, jsonify\nimport pickle\n\napp = Flask(__name__)\nmodel = pickle.load(open(\"model.pkl\", \"rb\"))\n\n@app.route(\"/predict\", methods=[\"POST\"])\ndef predict():\n    data = request.get_json()\n    features = data.get(\"features\")\n    \n    if not features or len(features) != 5:\n        return jsonify({\"error\": \"Expected 5 features\"}), 400\n    \n    prediction = model.predict([features])[0]\n    return jsonify({\"prediction\": float(prediction)})\n\n@app.route(\"/health\", methods=[\"GET\"])\ndef health():\n    return jsonify({\"status\": \"healthy\"})\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=8000, debug=False)"
        ]
      ]
    },
    {
      "cell_type": "code",
