      "source": [
        [
          "python",
          "import numba\nimport numpy as np\n\n# Regular Python: slow loops\ndef sum_squares_python(data):\n    total = 0\n    for x in data:\n        total += x ** 2\n    return total\n\n# Numba JIT: compiled to machine code\n@numba.jit(nopython=True)\ndef sum_squares_numba(data):\n    total = 0\n    for x in data:\n        total += x ** 2\n    return total\n\ndata = np.arange(1000000, dtype=np.float64)\n\nimport time\n# Python: ~50ms\nstart = time.time()\nfor _ in range(100):\n    sum_squares_python(data)\nprint(f\"Python: {(time.time() - start) * 10:.1f}ms\")\n\n# Numba: ~0.5ms (100x faster after first compilation)\nstart = time.time()\nfor _ in range(100):\n    sum_squares_numba(data)\nprint(f\"Numba: {(time.time() - start) * 10:.1f}ms\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport time\n\n# Loop-based: slow\ndef matrix_multiply_loop(A, B):\n    n = A.shape[0]\n    C = np.zeros((n, n))\n    for i in range(n):\n        for j in range(n):\n            for k in range(n):\n                C[i, j] += A[i, k] * B[k, j]\n    return C\n\n# Vectorized: fast\ndef matrix_multiply_vectorized(A, B):\n    return A @ B\n\nA = np.random.randn(100, 100)\nB = np.random.randn(100, 100)\n\n# Loop: ~1 second\nstart = time.time()\nC1 = matrix_multiply_loop(A, B)\nprint(f\"Loop: {(time.time() - start) * 1000:.1f}ms\")\n\n# Vectorized: ~1ms (1000x faster)\nstart = time.time()\nC2 = matrix_multiply_vectorized(A, B)\nprint(f\"Vectorized: {(time.time() - start) * 1000:.1f}ms\")\n\n# Verify equivalence\nprint(f\"Results match: {np.allclose(C1, C2)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import time\n\n# O(n\u00b2): naive string matching\ndef find_substring_naive(text, pattern):\n    count = 0\n    for i in range(len(text)):\n        if text[i:i+len(pattern)] == pattern:\n            count += 1\n    return count\n\n# O(n): KMP algorithm (or use built-in)\ndef find_substring_efficient(text, pattern):\n    return text.count(pattern)\n\ntext = \"a\" * 100000 + \"ab\" + \"a\" * 100000\npattern = \"ab\"\n\n# Naive: ~100ms\nstart = time.time()\nfor _ in range(100):\n    find_substring_naive(text, pattern)\nprint(f\"Naive O(n\u00b2): {(time.time() - start) * 10:.1f}ms\")\n\n# Efficient: ~0.01ms\nstart = time.time()\nfor _ in range(100):\n    find_substring_efficient(text, pattern)\nprint(f\"Efficient O(n): {(time.time() - start) * 10:.1f}ms\")"
        ]
      ]
    },
    {
