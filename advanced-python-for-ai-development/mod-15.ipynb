          "python",
          "import numpy as np\nimport time\n\n# O(n): linear\u2014scales proportionally\ndef search_linear(arr, target):\n    for x in arr:\n        if x == target:\n            return True\n    return False\n\n# O(n log n): sorted search\u2014much faster for large n\ndef search_binary(arr, target):\n    arr_sorted = sorted(arr)\n    left, right = 0, len(arr_sorted)\n    while left < right:\n        mid = (left + right) // 2\n        if arr_sorted[mid] < target:\n            left = mid + 1\n        else:\n            right = mid\n    return left < len(arr_sorted) and arr_sorted[left] == target\n\n# O(n\u00b2): quadratic\u2014avoid for large n\ndef sort_bubble(arr):\n    arr = arr.copy()\n    for i in range(len(arr)):\n        for j in range(len(arr) - 1):\n            if arr[j] > arr[j + 1]:\n                arr[j], arr[j + 1] = arr[j + 1], arr[j]\n    return arr\n\n# O(n log n): efficient sorting\ndef sort_merge(arr):\n    if len(arr) <= 1:\n        return arr\n    mid = len(arr) // 2\n    left = sort_merge(arr[:mid])\n    right = sort_merge(arr[mid:])\n    \n    result = []\n    i = j = 0\n    while i < len(left) and j < len(right):\n        if left[i] <= right[j]:\n            result.append(left[i])\n            i += 1\n        else:\n            result.append(right[j])\n            j += 1\n    result.extend(left[i:])\n    result.extend(right[j:])\n    return result\n\n# Test scaling\nfor n in [1000, 10000, 100000]:\n    arr = np.random.randint(0, n, n)\n    \n    start = time.time()\n    sort_bubble(arr)\n    bubble_time = time.time() - start\n    \n    start = time.time()\n    sort_merge(arr)\n    merge_time = time.time() - start\n    \n    print(f\"n={n}: Bubble={bubble_time:.3f}s, Merge={merge_time:.3f}s, Ratio={bubble_time/merge_time:.0f}x\")"
        ]
      ]
