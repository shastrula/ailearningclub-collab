          "python",
          "import numpy as np\nimport time\n\n# Slow version: 15 seconds\ndef train_slow(X, y):\n    n_samples, n_features = X.shape\n    weights = np.zeros(n_features)\n    \n    for epoch in range(100):\n        for i in range(n_samples):\n            pred = sum(X[i, j] * weights[j] for j in range(n_features))\n            error = pred - y[i]\n            for j in range(n_features):\n                weights[j] -= 0.001 * error * X[i, j]\n    \n    return weights\n\n# Medium version: 2 seconds (vectorized loops)\ndef train_medium(X, y):\n    n_samples, n_features = X.shape\n    weights = np.zeros(n_features)\n    \n    for epoch in range(100):\n        predictions = X @ weights\n        errors = predictions - y\n        weights -= 0.001 * X.T @ errors\n    \n    return weights\n\n# Fast version: 0.1 seconds (NumPy @ operator)\ndef train_fast(X, y):\n    weights = np.zeros(X.shape[1])\n    \n    for epoch in range(100):\n        predictions = X @ weights\n        errors = predictions - y\n        weights -= 0.001 * X.T @ errors / len(y)\n    \n    return weights\n\nX = np.random.randn(10000, 100)  # 10k samples, 100 features\ny = np.random.binomial(1, 0.5, 10000)\n\nstart = time.time()\nw_slow = train_slow(X[:1000], y[:1000])  # Small sample for demo\nprint(f\"Slow: {(time.time() - start):.2f}s\")\n\nstart = time.time()\nw_medium = train_medium(X, y)\nprint(f\"Medium: {(time.time() - start):.2f}s\")\n\nstart = time.time()\nw_fast = train_fast(X, y)\nprint(f\"Fast: {(time.time() - start):.2f}s\")\n# Speedup: 150x via vectorization alone"
        ]
      ]
    },
