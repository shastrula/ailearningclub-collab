          "python",
          "import functools\nimport time\n\n# Without caching: recursive fibonacci is O(2^n)\ndef fib_slow(n):\n    if n <= 1:\n        return n\n    return fib_slow(n - 1) + fib_slow(n - 2)\n\n# With @lru_cache: O(n) due to memoization\n@functools.lru_cache(maxsize=None)\ndef fib_fast(n):\n    if n <= 1:\n        return n\n    return fib_fast(n - 1) + fib_fast(n - 2)\n\n# fib_slow(35) takes ~5 seconds\n# fib_fast(35) takes <1ms (same computation, cached results)\n\n# For ML models: cache expensive predictions\n@functools.lru_cache(maxsize=10000)\ndef predict_expensive_model(input_features):\n    # Simulate model inference\n    return sum(float(x) for x in input_features.split(\",\")) / 100\n\n# First call: slow\nresult = predict_expensive_model(\"0.1,0.2,0.3\")\n# Second call with same input: instant (from cache)\nresult = predict_expensive_model(\"0.1,0.2,0.3\")"
        ]
      ]
    },
