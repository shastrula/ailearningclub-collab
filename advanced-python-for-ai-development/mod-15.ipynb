          "python",
          "import numpy as np\n\n# Inefficient: Python list of floats (28 bytes per value)\ndata_list = [float(i) for i in range(1000000)]\n\n# Efficient: NumPy array (8 bytes per float64)\ndata_array = np.arange(1000000, dtype=np.float64)\n\nprint(f\"List size: {len(data_list) * 28 / 1e6:.1f} MB\")\nprint(f\"Array size: {data_array.nbytes / 1e6:.1f} MB\")\n# Output: List size: 28.0 MB, Array size: 7.6 MB"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
