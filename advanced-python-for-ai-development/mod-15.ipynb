        [
          "python",
          "# Memory-intensive: creates entire list\ndef load_batch_list(files):\n    batches = []\n    for file in files:\n        data = open(file).read()  # Simulate I/O\n        batches.append(data)\n    return batches\n\n# Memory-efficient: yields one at a time\ndef load_batch_generator(files):\n    for file in files:\n        data = open(file).read()\n        yield data\n\n# Usage:\nfor batch in load_batch_generator(large_file_list):\n    process_batch(batch)  # Only one batch in memory at a time"
        ]
      ]
    },
    {
