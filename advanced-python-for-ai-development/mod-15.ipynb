          "python",
          "import functools\nimport time\n\n# Cache database queries\n@functools.lru_cache(maxsize=1000)\ndef get_user_data(user_id):\n    # Expensive database query\n    time.sleep(0.01)\n    return {\"id\": user_id, \"name\": f\"User{user_id}\"}\n\n# First call: 10ms\nstart = time.time()\ndata = get_user_data(1)\nprint(f\"First call: {(time.time() - start)*1000:.1f}ms\")\n\n# Second call with same ID: <1ms (from cache)\nstart = time.time()\ndata = get_user_data(1)\nprint(f\"Second call: {(time.time() - start)*1000:.1f}ms\")\n\n# Cache invalidation (critical!)\n@functools.lru_cache(maxsize=100)\ndef expensive_model_predict(features):\n    # Simulate ML inference: 100ms\n    time.sleep(0.1)\n    return float(sum(float(x) for x in features.split(\",\")))\n\n# Problem: if model is retrained, cache has stale results\n# Solution: clear cache after model update\ndef retrain_model():\n    expensive_model_predict.cache_clear()\n    # ... training logic ..."
