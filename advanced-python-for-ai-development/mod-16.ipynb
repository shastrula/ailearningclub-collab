          "python",
          "from unittest.mock import Mock, patch\nimport requests\n\ndef get_weather(city):\n    \"\"\"Fetch weather from external API.\"\"\"\n    response = requests.get(f\"https://api.weather.com/{city}\")\n    return response.json()['temp']\n\ndef test_get_weather_mocked():\n    \"\"\"Mock the requests.get call.\"\"\"\n    with patch('requests.get') as mock_get:\n        # Configure mock to return a fake response\n        mock_response = Mock()\n        mock_response.json.return_value = {'temp': 75}\n        mock_get.return_value = mock_response\n        \n        # Test function that calls get_weather\n        temp = get_weather(\"NYC\")\n        \n        # Verify the call and result\n        mock_get.assert_called_once_with(\"https://api.weather.com/NYC\")\n        assert temp == 75\n\ndef test_get_weather_api_error():\n    \"\"\"Test error handling when API fails.\"\"\"\n    with patch('requests.get') as mock_get:\n        mock_get.side_effect = requests.ConnectionError(\"API down\")\n        \n        with pytest.raises(requests.ConnectionError):\n            get_weather(\"NYC\")"
