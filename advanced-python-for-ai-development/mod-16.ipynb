          "python",
          "import logging\nimport sys\n\n# Setup logging once, at module start\nlogging.basicConfig(\n    level=logging.INFO,\n    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',\n    handlers=[\n        logging.FileHandler('app.log'),  # Write to file\n        logging.StreamHandler(sys.stdout)  # Also print to console\n    ]\n)\n\nlogger = logging.getLogger(__name__)\n\nclass ModelTrainer:\n    def train(self, X, y, epochs=10):\n        logger.info(f\"Starting training on {X.shape[0]} samples\")\n        \n        for epoch in range(epochs):\n            loss = self._train_epoch(X, y)\n            logger.debug(f\"Epoch {epoch}: loss={loss:.4f}\")  # Debug level\n            \n            if loss < 0.01:\n                logger.info(\"Loss converged, stopping early\")\n                break\n        \n        logger.info(\"Training complete\")\n        return self\n    \n    def _train_epoch(self, X, y):\n        try:\n            # Training logic\n            return 0.1\n        except Exception as e:\n            logger.error(f\"Training failed: {e}\", exc_info=True)\n            raise\n\n# Usage:\ntrainer = ModelTrainer()\ntrainer.train(X, y)\n# Output written to app.log and console:\n# 2026-06-14 20:21:20 - root - INFO - Starting training on 1000 samples\n# 2026-06-14 20:21:21 - root - INFO - Training complete"
