          "def test_model_v2_vs_v1():\n    \"\"\"Test new model maintains performance of old model.\"\"\"\n    model_v1 = load_model(\"models/v1.pkl\")\n    model_v2 = load_model(\"models/v2.pkl\")\n    \n    # On holdout test set, v2 should match or exceed v1\n    acc_v1 = (model_v1.predict(X_test) == y_test).mean()\n    acc_v2 = (model_v2.predict(X_test) == y_test).mean()\n    \n    assert acc_v2 >= acc_v1 - 0.01, f\"v2 accuracy {acc_v2} < v1 {acc_v1}\"\n\ndef test_model_backward_compatibility():\n    \"\"\"Test model API hasn't changed.\"\"\"\n    # Old code should still work\n    predictions = model.predict(X_test)\n    assert hasattr(predictions, '__len__')\n    \n    # Probability interface still works\n    proba = model.predict_proba(X_test)\n    assert proba.shape == (len(X_test), n_classes)"
