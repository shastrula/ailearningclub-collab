          "# tests/test_model.py\n# Bad: all tests in one file\n# Good: organize by concern\n\n# Directory structure:\n# tests/\n#   conftest.py              (shared fixtures)\n#   test_data_loading.py     (data validation)\n#   test_preprocessing.py    (feature engineering)\n#   test_model.py            (model correctness)\n#   test_integration.py      (end-to-end)\n\n# conftest.py: shared fixtures across all tests\n@pytest.fixture(scope=\"session\")\ndef model():\n    \"\"\"Load model once per test session.\"\"\"\n    return load_trained_model()\n\n@pytest.fixture\ndef sample_data():\n    \"\"\"Fresh data for each test.\"\"\"\n    return load_test_data()\n\n# test_model.py: focused tests\ndef test_model_shape(model, sample_data):\n    \"\"\"Test output shape matches input.\"\"\"\n    predictions = model.predict(sample_data['X'])\n    assert predictions.shape[0] == sample_data['X'].shape[0]\n\ndef test_model_probabilities(model, sample_data):\n    \"\"\"Test probabilities are valid.\"\"\"\n    probs = model.predict_proba(sample_data['X'])\n    assert np.all(probs >= 0) and np.all(probs <= 1)\n    assert np.allclose(probs.sum(axis=1), 1.0)\n\ndef test_model_consistent(model, sample_data):\n    \"\"\"Test deterministic model (same input \u2192 same output).\"\"\"\n    pred1 = model.predict(sample_data['X'])\n    pred2 = model.predict(sample_data['X'])\n    assert np.array_equal(pred1, pred2)"
