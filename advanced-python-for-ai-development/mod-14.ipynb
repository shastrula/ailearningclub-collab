          "python",
          "import concurrent.futures\nimport time\nimport requests\nfrom functools import wraps\n\ndef timing_decorator(func):\n    @wraps(func)\n    def wrapper(*args, **kwargs):\n        start = time.time()\n        result = func(*args, **kwargs)\n        print(f\"{func.__name__} took {time.time() - start:.2f}s\")\n        return result\n    return wrapper\n\n# I/O-bound example: downloading files\ndef download_url(url):\n    \"\"\"Simulate network I/O\"\"\"\n    time.sleep(1)  # Simulates network latency\n    return f\"Downloaded {url}\"\n\nurls = [f\"http://example.com/{i}\" for i in range(5)]\n\n@timing_decorator\ndef sequential_io():\n    \"\"\"Sequential: 5 seconds\"\"\"\n    return [download_url(url) for url in urls]\n\n@timing_decorator\ndef threaded_io():\n    \"\"\"Threaded: ~1 second (concurrent I/O)\"\"\"\n    with concurrent.futures.ThreadPoolExecutor(max_workers=5) as executor:\n        return list(executor.map(download_url, urls))\n\nprint(sequential_io())\nprint(threaded_io())\n\n# CPU-bound example: compute-intensive work\ndef cpu_intensive_task(n):\n    \"\"\"Simulate CPU work\"\"\"\n    return sum(i * i for i in range(n))\n\ntasks = [10000000] * 4\n\n@timing_decorator\ndef sequential_cpu():\n    \"\"\"Sequential: CPU bound\"\"\"\n    return [cpu_intensive_task(n) for n in tasks]\n\n@timing_decorator\ndef threaded_cpu():\n    \"\"\"Threaded: Still slow (GIL blocks parallelism)\"\"\"\n    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as executor:\n        return list(executor.map(cpu_intensive_task, tasks))\n\n@timing_decorator\ndef multiprocess_cpu():\n    \"\"\"Multiprocess: True parallelism\"\"\"\n    with concurrent.futures.ProcessPoolExecutor(max_workers=4) as executor:\n        return list(executor.map(cpu_intensive_task, tasks))\n\nprint(sequential_cpu())\nprint(threaded_cpu())\nprint(multiprocess_cpu())"
        ]
      ]
    },
