          "python",
          "import asyncio\nimport aiohttp\nimport time\n\nasync def fetch_url_async(url: str, session: aiohttp.ClientSession) -> dict:\n    \"\"\"Async HTTP request\"\"\"\n    try:\n        async with session.get(url, timeout=5) as response:\n            return await response.json()\n    except Exception as e:\n        return {\"error\": str(e)}\n\nasync def batch_requests_async(urls: list) -> list:\n    \"\"\"Fetch multiple URLs concurrently with asyncio\"\"\"\n    async with aiohttp.ClientSession() as session:\n        tasks = [fetch_url_async(url, session) for url in urls]\n        results = await asyncio.gather(*tasks)\n    return results\n\n# Example\n# urls = [f\"https://api.example.com/data/{i}\" for i in range(100)]\n# results = asyncio.run(batch_requests_async(urls))\n\n# Asyncio for concurrent tasks (CPU-free waiting)\nasync def task_with_delay(task_id: int, delay: float) -> str:\n    \"\"\"Simulate async work\"\"\"\n    await asyncio.sleep(delay)\n    return f\"Task {task_id} completed\"\n\nasync def concurrent_tasks():\n    \"\"\"Run multiple async tasks concurrently\"\"\"\n    tasks = [task_with_delay(i, 1.0) for i in range(5)]\n    results = await asyncio.gather(*tasks)\n    return results\n\n# Sequential: 5 seconds\n# Concurrent: ~1 second\n# results = asyncio.run(concurrent_tasks())"
