          "python",
          "import concurrent.futures\nimport numpy as np\nfrom multiprocessing import cpu_count\n\ndef matrix_multiply(matrices):\n    \"\"\"CPU-intensive: multiply two matrices\"\"\"\n    A, B = matrices\n    return np.dot(A, B)\n\ndef parallel_matrix_operations(n_matrices=16):\n    \"\"\"Process many matrix multiplications in parallel\"\"\"\n    \n    # Generate tasks\n    matrices = [(np.random.randn(500, 500), np.random.randn(500, 500))\n                for _ in range(n_matrices)]\n    \n    # Process with ProcessPoolExecutor\n    with concurrent.futures.ProcessPoolExecutor(max_workers=cpu_count()) as executor:\n        # Submit all tasks\n        futures = [executor.submit(matrix_multiply, mat) for mat in matrices]\n        \n        # Collect results as they complete\n        results = []\n        for future in concurrent.futures.as_completed(futures):\n            try:\n                result = future.result(timeout=30)\n                results.append(result)\n            except Exception as e:\n                print(f\"Task failed: {e}\")\n    \n    return results\n\n# with progress tracking\ndef parallel_with_progress(tasks, max_workers=None):\n    \"\"\"Process tasks showing progress\"\"\"\n    if max_workers is None:\n        max_workers = cpu_count()\n    \n    completed = 0\n    total = len(tasks)\n    results = []\n    \n    with concurrent.futures.ProcessPoolExecutor(max_workers=max_workers) as executor:\n        futures = {executor.submit(cpu_intensive_task, task): task \n                  for task in tasks}\n        \n        for future in concurrent.futures.as_completed(futures):\n            try:\n                result = future.result()\n                results.append(result)\n                completed += 1\n                print(f\"Progress: {completed}/{total}\")\n            except Exception as e:\n                print(f\"Task failed: {e}\")\n    \n    return results\n\n# tasks = [10000000] * 8\n# results = parallel_with_progress(tasks)"
        ]
      ]
    },
