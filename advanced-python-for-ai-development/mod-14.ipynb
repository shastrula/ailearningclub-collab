          "python",
          "import ray\nimport numpy as np\n\n# Initialize Ray cluster\nray.init(ignore_reinit_error=True)\n\n# Remote function: executed on Ray worker\n@ray.remote\ndef compute_mean_distance(X):\n    \"\"\"Compute mean distance in dataset (CPU-bound)\"\"\"\n    distances = np.linalg.norm(X[:, None] - X[None, :], axis=2)\n    return distances.mean()\n\n@ray.remote\ndef compute_variance(data):\n    \"\"\"Compute variance\"\"\"\n    return np.var(data)\n\n# Ray Actor: stateful component\n@ray.remote\nclass DataAggregator:\n    def __init__(self):\n        self.data = []\n    \n    def add_data(self, x):\n        self.data.append(x)\n    \n    def get_stats(self):\n        data = np.array(self.data)\n        return {\n            \"mean\": data.mean(),\n            \"std\": data.std(),\n            \"count\": len(data)\n        }\n\n# Parallel task distribution\ndef distributed_analysis(num_partitions=4):\n    \"\"\"Process data in parallel across Ray cluster\"\"\"\n    \n    # Create data partitions\n    data_partitions = [np.random.randn(1000, 100) for _ in range(num_partitions)]\n    \n    # Submit tasks (returns object references, not results)\n    futures = [compute_mean_distance.remote(partition) \n              for partition in data_partitions]\n    \n    # Get results (waits for completion)\n    results = ray.get(futures)\n    \n    return results\n\n# Actor-based aggregation\ndef actor_based_workflow():\n    \"\"\"Use Ray actors for stateful operations\"\"\"\n    \n    # Create actor\n    aggregator = DataAggregator.remote()\n    \n    # Add data from multiple sources (can be in parallel)\n    for i in range(10):\n        data = np.random.randn(100)\n        aggregator.add_data.remote(data)  # Non-blocking\n    \n    # Get results when ready\n    stats = ray.get(aggregator.get_stats.remote())\n    \n    return stats\n\n# Hyperparameter tuning with Ray Tune\nfrom ray import tune\n\ndef train_model(config):\n    \"\"\"Training function for Tune\"\"\"\n    accuracy = config[\"learning_rate\"] * 0.1 + np.random.random() * 0.05\n    return {\"accuracy\": accuracy}\n\n# Tune finds best hyperparameters across many parallel trials\n# (requires more setup, simplified here)\n\n# Clean up\nray.shutdown()"
        ]
