          "# Define an MCP tool\nfrom mcp import Server, Tool\n\nserver = Server(\"my-tools\")\n\n@server.tool()\ndef calculate(expression: str) -> str:\n    \"\"\"Evaluate a math expression.\"\"\"\n    return str(eval(expression))\n\n# Tool is now available to AI assistants via MCP protocol"
