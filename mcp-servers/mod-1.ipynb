          "python",
          "class MCPServerWithResources(MCPServer):\n    def list_resources(self) -> list:\n        \"\"\"Return available resources\"\"\"\n        return [\n            {\n                \"uri\": \"file:///data/users.json\",\n                \"name\": \"users.json\",\n                \"description\": \"List of users\",\n                \"mimeType\": \"application/json\"\n            },\n            {\n                \"uri\": \"db://employees\",\n                \"name\": \"Employees Table\",\n                \"description\": \"Employee records from database\",\n                \"mimeType\": \"application/json\"\n            }\n        ]\n    \n    def read_resource(self, uri: str) -> str:\n        \"\"\"Read resource contents\"\"\"\n        if uri == \"file:///data/users.json\":\n            return json.dumps([\n                {\"id\": 1, \"name\": \"Alice\"},\n                {\"id\": 2, \"name\": \"Bob\"}\n            ])\n        elif uri == \"db://employees\":\n            return json.dumps([\n                {\"id\": 101, \"name\": \"John\", \"salary\": 50000},\n                {\"id\": 102, \"name\": \"Jane\", \"salary\": 55000}\n            ])\n        else:\n            return json.dumps({\"error\": \"Resource not found\"})\n    \n    def handle_request(self, request: dict) -> dict:\n        \"\"\"Extended to handle resources\"\"\"\n        method = request.get(\"method\")\n        params = request.get(\"params\", {})\n        \n        if method == \"resources/list\":\n            return {\"resources\": self.list_resources()}\n        \n        elif method == \"resources/read\":\n            uri = params.get(\"uri\")\n            content = self.read_resource(uri)\n            return {\"contents\": content}\n        \n        else:\n            return super().handle_request(request)"
        ]
      ]
    },
