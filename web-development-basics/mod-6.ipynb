          "javascript",
          "// String to object\nconst jsonString = '{\"name\": \"Bob\", \"age\": 30}';\nconst obj = JSON.parse(jsonString);\nconsole.log(obj.name);  // \"Bob\"\n\n// Object to string\nconst user = { name: \"Carol\", age: 25 };\nconst json = JSON.stringify(user);\nconsole.log(json);  // '{\"name\":\"Carol\",\"age\":25}'\n\n// Pretty print\nconst pretty = JSON.stringify(user, null, 2);\nconsole.log(pretty);"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "javascript",
          "// Basic GET request\nasync function fetchAllUsers() {\n    try {\n        const response = await fetch(\"https://api.example.com/users\");\n        \n        // Check if response is ok (status 200-299)\n        if (!response.ok) {\n            throw new Error(`HTTP Error: ${response.status}`);\n        }\n        \n        const users = await response.json();\n        console.log(users);\n    } catch (error) {\n        console.error(\"Error fetching users:\", error);\n    }\n}\n\n// GET with parameters\nasync function fetchUser(userId) {\n    const url = new URL(\"https://api.example.com/users\");\n    url.searchParams.append(\"id\", userId);\n    \n    const response = await fetch(url);\n    const user = await response.json();\n    return user;\n}\n\n// POST request (create)\nasync function createUser(userData) {\n    const response = await fetch(\"https://api.example.com/users\", {\n        method: \"POST\",\n        headers: {\n            \"Content-Type\": \"application/json\"\n        },\n        body: JSON.stringify(userData)\n    });\n    \n    if (!response.ok) throw new Error(\"Failed to create user\");\n    return await response.json();\n}\n\n// PUT request (replace)\nasync function updateUser(userId, userData) {\n    const response = await fetch(`https://api.example.com/users/${userId}`, {\n        method: \"PUT\",\n        headers: {\n            \"Content-Type\": \"application/json\"\n        },\n        body: JSON.stringify(userData)\n    });\n    \n    return await response.json();\n}\n\n// DELETE request\nasync function deleteUser(userId) {\n    const response = await fetch(`https://api.example.com/users/${userId}`, {\n        method: \"DELETE\"\n    });\n    \n    if (response.ok) {\n        console.log(\"User deleted\");\n    }\n}\n\n// Usage\ncreateUser({ name: \"Diana\", email: \"diana@example.com\" })\n    .then(user => console.log(\"Created:\", user))\n    .catch(error => console.error(\"Error:\", error));"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "javascript",
          "const express = require(\"express\");\nconst app = express();\n\n// Middleware\napp.use(express.json());  // Parse JSON request bodies\n\n// GET endpoint\napp.get(\"/\", (req, res) => {\n    res.send(\"Hello, World!\");\n});\n\n// GET with parameter\napp.get(\"/users/:id\", (req, res) => {\n    const userId = req.params.id;\n    res.json({ id: userId, name: \"User \" + userId });\n});\n\n// GET with query string\napp.get(\"/search\", (req, res) => {\n    const query = req.query.q;\n    res.json({ results: [query + \" result 1\", query + \" result 2\"] });\n});\n\n// POST endpoint\napp.post(\"/users\", (req, res) => {\n    const { name, email } = req.body;\n    \n    if (!name || !email) {\n        return res.status(400).json({ error: \"Name and email required\" });\n    }\n    \n    const newUser = { id: 1, name, email };\n    res.status(201).json(newUser);\n});\n\n// Error handling\napp.use((err, req, res, next) => {\n    console.error(err);\n    res.status(500).json({ error: \"Internal server error\" });\n});\n\n// Start server\nconst PORT = 3000;\napp.listen(PORT, () => {\n    console.log(`Server running on http://localhost:${PORT}`);\n});"
        ]
      ]
    },
