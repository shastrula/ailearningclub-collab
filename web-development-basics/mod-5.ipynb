        [
          "javascript",
          "const app = document.querySelector(\"#app\");\nconst links = document.querySelectorAll(\"nav a\");\n\nconst pages = {\n    home: \"<h1>Home</h1><p>Welcome to the home page.</p>\",\n    about: \"<h1>About</h1><p>Learn about us.</p>\",\n    contact: \"<h1>Contact</h1><form><input placeholder='Message'></form>\"\n};\n\nfunction navigate(page) {\n    app.innerHTML = pages[page] || pages.home;\n    history.pushState({ page }, \"\", `/${page}`);\n}\n\nlinks.forEach(link => {\n    link.addEventListener(\"click\", (event) => {\n        event.preventDefault();\n        const page = link.dataset.page || \"home\";\n        navigate(page);\n    });\n});\n\n// Handle browser back/forward\nwindow.addEventListener(\"popstate\", (event) => {\n    const page = event.state?.page || \"home\";\n    app.innerHTML = pages[page];\n});\n\n// Load initial page\nnavigate(\"home\");"
        ]
      ]
    },
