          "css",
          ".layout {\n    display: grid;\n    grid-template-columns: 200px 1fr 200px;\n    grid-template-areas:\n        \"header header header\"\n        \"sidebar main aside\"\n        \"footer footer footer\";\n    gap: 20px;\n}\n\nheader {\n    grid-area: header;\n}\n\nmain {\n    grid-area: main;\n}\n\n.sidebar {\n    grid-area: sidebar;\n}\n\naside {\n    grid-area: aside;\n}\n\nfooter {\n    grid-area: footer;\n}"
        ]
