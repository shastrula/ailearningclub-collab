          "/* Default styles for small screens */\n.container {\n    display: flex;\n    flex-direction: column;\n}\n\n/* For tablets and larger */\n@media (min-width: 768px) {\n    .container {\n        flex-direction: row;\n    }\n    \n    .sidebar {\n        width: 250px;\n    }\n}\n\n/* For large desktops */\n@media (min-width: 1024px) {\n    .container {\n        max-width: 1200px;\n        margin: 0 auto;\n    }\n}"
