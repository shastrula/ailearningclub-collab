      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Power of compound growth\ndef compound_growth(initial, rate, years):\n    return initial * (1 + rate) ** years\n\n# Compare growth rates over time\ninitial_gdp = 10000  # GDP per capita\n\nrates = [0.01, 0.02, 0.03, 0.05, 0.07]\nyears_list = [10, 25, 50, 100]\n\nprint(\"=== Compound Growth: GDP per Capita Starting at $10,000 ===\")\nprint(f\"\\n{'Rate':<8}\", end=\"\")\nfor y in years_list:\n    print(f\"{'After '+str(y)+'yr':<14}\", end=\"\")\nprint(f\"{'Doubling Time':<14}\")\nprint(\"-\" * 64)\n\nfor rate in rates:\n    print(f\"{rate*100:.0f}%{'':<5}\", end=\"\")\n    for y in years_list:\n        result = compound_growth(initial_gdp, rate, y)\n        print(f\"${result:>11,.0f}  \", end=\"\")\n    doubling = 72 / (rate * 100)\n    print(f\"{doubling:.0f} years\")\n\n# Real world comparison\nprint(f\"\\n=== Real-World Growth Divergence ===\")\n# South Korea vs Ghana: similar GDP per capita in 1960\nsk_1960, sk_growth = 1100, 0.06  # ~6% avg growth\nghana_1960, ghana_growth = 1200, 0.01  # ~1% avg growth\nyears = 60\n\nsk_2020 = compound_growth(sk_1960, sk_growth, years)\nghana_2020 = compound_growth(ghana_1960, ghana_growth, years)\n\nprint(f\"South Korea 1960: ${sk_1960:,} -> 2020: ${sk_2020:,.0f} ({sk_growth*100:.0f}% growth)\")\nprint(f\"Ghana 1960:       ${ghana_1960:,} -> 2020: ${ghana_2020:,.0f} ({ghana_growth*100:.0f}% growth)\")\nprint(f\"Ratio 1960: {sk_1960/ghana_1960:.1f}x -> Ratio 2020: {sk_2020/ghana_2020:.0f}x\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Solow Growth Model simulation\nalpha = 0.3  # Capital share\ndepreciation = 0.05\nsavings_rate = 0.20\npopulation_growth = 0.01\ntech_growth = 0.02\n\n# Steady state: s*f(k) = (delta + n + g)*k\n# s * k^alpha = (delta + n + g) * k\n# k^(alpha-1) = (delta + n + g) / s\n# k* = [s / (delta + n + g)]^(1/(1-alpha))\n\neffective_depreciation = depreciation + population_growth + tech_growth\nk_star = (savings_rate / effective_depreciation) ** (1 / (1 - alpha))\ny_star = k_star ** alpha\n\nprint(\"=== Solow Growth Model ===\")\nprint(f\"Parameters:\")\nprint(f\"  Capital share (alpha): {alpha}\")\nprint(f\"  Savings rate: {savings_rate*100:.0f}%\")\nprint(f\"  Depreciation: {depreciation*100:.0f}%\")\nprint(f\"  Population growth: {population_growth*100:.0f}%\")\nprint(f\"  Technology growth: {tech_growth*100:.0f}%\")\nprint(f\"\\nSteady State (per effective worker):\")\nprint(f\"  Capital: {k_star:.2f}\")\nprint(f\"  Output:  {y_star:.2f}\")\n\n# Compare different savings rates\nprint(f\"\\n=== Effect of Savings Rate on Steady State ===\")\nprint(f\"{'Savings Rate':<14} {'Capital/Worker':<16} {'Output/Worker':<15} {'Consumption':<12}\")\nprint(\"-\" * 57)\nfor s in [0.10, 0.15, 0.20, 0.25, 0.30, 0.40]:\n    k = (s / effective_depreciation) ** (1 / (1 - alpha))\n    y = k ** alpha\n    c = (1 - s) * y\n    print(f\"{s*100:.0f}%{'':<11} {k:<16.2f} {y:<15.2f} {c:<12.2f}\")"
        ]
      ]
    }
