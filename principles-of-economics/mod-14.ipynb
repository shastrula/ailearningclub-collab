      "source": [
        [
          "python",
          "import numpy as np\n\n# CPI calculation example\n# Market basket: 10 loaves bread, 5 gallons gas, 1 movie ticket, 50 kWh electricity\n\nbasket_quantities = {'bread': 10, 'gasoline': 5, 'movie': 1, 'electricity': 50}\n\nprices = {\n    2020: {'bread': 2.50, 'gasoline': 2.20, 'movie': 12.00, 'electricity': 0.13},\n    2021: {'bread': 2.65, 'gasoline': 3.00, 'movie': 12.50, 'electricity': 0.14},\n    2022: {'bread': 3.00, 'gasoline': 4.50, 'movie': 14.00, 'electricity': 0.16},\n    2023: {'bread': 3.10, 'gasoline': 3.80, 'movie': 15.00, 'electricity': 0.17},\n    2024: {'bread': 3.20, 'gasoline': 3.50, 'movie': 15.50, 'electricity': 0.17},\n}\n\nbase_year = 2020\n\ndef basket_cost(year_prices):\n    return sum(basket_quantities[item] * year_prices[item] for item in basket_quantities)\n\nbase_cost = basket_cost(prices[base_year])\n\nprint(\"=== CPI and Inflation Rate ===\")\nprint(f\"Base year: {base_year}, Base basket cost: ${base_cost:.2f}\")\nprint(f\"\\n{'Year':<6} {'Basket Cost':<13} {'CPI':<8} {'Inflation Rate':<15}\")\nprint(\"-\" * 42)\n\nprev_cpi = None\nfor year in sorted(prices.keys()):\n    cost = basket_cost(prices[year])\n    cpi = (cost / base_cost) * 100\n    if prev_cpi:\n        inflation = ((cpi - prev_cpi) / prev_cpi) * 100\n        print(f\"{year:<6} ${cost:<12.2f} {cpi:<8.1f} {inflation:<14.1f}%\")\n    else:\n        print(f\"{year:<6} ${cost:<12.2f} {cpi:<8.1f} {'---':<15}\")\n    prev_cpi = cpi"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
