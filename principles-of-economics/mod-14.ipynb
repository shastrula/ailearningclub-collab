      "source": [
        [
          "python",
          "# Real vs. nominal values: purchasing power over time\ndef real_value(nominal, inflation_rate, years):\n    \"\"\"Calculate real purchasing power after inflation.\"\"\"\n    return nominal / (1 + inflation_rate) ** years\n\nsalary_2024 = 60000\ninflation_rates = [0.02, 0.03, 0.05, 0.08]\n\nprint(\"=== Purchasing Power Erosion ===\")\nprint(f\"Nominal salary: ${salary_2024:,.0f} (unchanged)\")\nprint(f\"\\n{'Inflation':<12} {'After 5yr':<12} {'After 10yr':<12} {'After 20yr':<12} {'After 30yr'}\")\nprint(\"-\" * 60)\nfor rate in inflation_rates:\n    vals = [real_value(salary_2024, rate, y) for y in [5, 10, 20, 30]]\n    print(f\"{rate*100:.0f}%{'':<9} ${vals[0]:>9,.0f} ${vals[1]:>9,.0f} ${vals[2]:>9,.0f} ${vals[3]:>9,.0f}\")\n\n# Real interest rate\nprint(\"\\n=== Fisher Equation: Real Interest Rate ===\")\nprint(\"Real rate = Nominal rate - Inflation rate (approximate)\")\nnominal_rates = [0.05, 0.05, 0.05, 0.08, 0.10]\ninf_rates = [0.02, 0.03, 0.05, 0.06, 0.12]\nfor nom, inf in zip(nominal_rates, inf_rates):\n    real = nom - inf\n    print(f\"Nominal {nom*100:.0f}% - Inflation {inf*100:.0f}% = Real {real*100:.0f}%\"\n          f\" ({'positive' if real > 0 else 'NEGATIVE'})\")"
        ]
      ]
    }
