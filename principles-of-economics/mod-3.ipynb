        [
          "python",
          "# Revenue analysis across price points\ndef demand_quantity(price, a=200, b=10):\n    \"\"\"Linear demand: Q = a - b*P\"\"\"\n    return max(0, a - b * price)\n\nprices = np.arange(1, 21, 1)\nquantities = [demand_quantity(p) for p in prices]\nrevenues = [p * demand_quantity(p) for p in prices]\n\n# Find revenue-maximizing price\nmax_rev_idx = np.argmax(revenues)\nprint(\"=== Revenue Analysis ===\")\nprint(f\"Revenue-maximizing price: ${prices[max_rev_idx]}\")\nprint(f\"Quantity at max revenue: {quantities[max_rev_idx]}\")\nprint(f\"Maximum revenue: ${revenues[max_rev_idx]}\")\n\n# Show elasticity at different points\nprint(\"\\n=== Elasticity Along the Demand Curve ===\")\nfor i in range(0, len(prices)-1, 4):\n    ped = midpoint_elasticity(prices[i], prices[i+1],\n                              quantities[i], quantities[i+1])\n    print(f\"P=${prices[i]:2d}, Q={quantities[i]:3d}, \"\n          f\"Revenue=${revenues[i]:5d}, PED={ped:.2f} \"\n          f\"({'elastic' if abs(ped) > 1 else 'inelastic'})\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Cross-price and income elasticity examples\ndef cross_price_elasticity(qa1, qa2, pb1, pb2):\n    \"\"\"Cross-price elasticity using midpoint method.\"\"\"\n    pct_q = (qa2 - qa1) / ((qa2 + qa1) / 2) * 100\n    pct_p = (pb2 - pb1) / ((pb2 + pb1) / 2) * 100\n    return pct_q / pct_p\n\n# Butter and margarine (substitutes)\n# Butter price: $4 -> $5, Margarine demand: 1000 -> 1200\ncross_ped = cross_price_elasticity(1000, 1200, 4, 5)\nprint(f\"Butter-Margarine cross elasticity: {cross_ped:.2f} (substitutes)\")\n\n# Cars and gasoline (complements)\n# Car prices: $30K -> $35K, Gasoline demand: 500 -> 470 gallons/month\ncross_ped2 = cross_price_elasticity(500, 470, 30000, 35000)\nprint(f\"Cars-Gasoline cross elasticity: {cross_ped2:.2f} (complements)\")\n\n# Income elasticity\ndef income_elasticity(q1, q2, income1, income2):\n    pct_q = (q2 - q1) / ((q2 + q1) / 2) * 100\n    pct_i = (income2 - income1) / ((income2 + income1) / 2) * 100\n    return pct_q / pct_i\n\n# Restaurant meals when income rises from $50K to $60K\n# Meals per month: 4 -> 6\ninc_elas = income_elasticity(4, 6, 50000, 60000)\nprint(f\"\\nRestaurant meals income elasticity: {inc_elas:.2f} (luxury)\")\n\n# Rice when income rises from $50K to $60K\n# Rice consumption: 20 -> 18 kg/month\ninc_elas2 = income_elasticity(20, 18, 50000, 60000)\nprint(f\"Rice income elasticity: {inc_elas2:.2f} (inferior good)\")"
        ]
      ]
    }
