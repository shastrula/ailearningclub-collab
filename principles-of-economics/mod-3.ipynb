      "source": [
        [
          "python",
          "import numpy as np\n\n# Calculating price elasticity of demand using midpoint method\ndef midpoint_elasticity(p1, p2, q1, q2):\n    \"\"\"Calculate PED using the midpoint (arc) method for consistency.\"\"\"\n    pct_change_q = (q2 - q1) / ((q2 + q1) / 2) * 100\n    pct_change_p = (p2 - p1) / ((p2 + p1) / 2) * 100\n    return pct_change_q / pct_change_p\n\n# Example: Coffee shop raises latte price from $4 to $5\n# Daily sales drop from 200 to 160\nped_latte = midpoint_elasticity(4, 5, 200, 160)\nprint(f\"Latte PED: {ped_latte:.2f}\")\nprint(f\"Demand is {'elastic' if abs(ped_latte) > 1 else 'inelastic'}\")\n\n# Example: Electricity rate rises from $0.12 to $0.14 per kWh\n# Monthly usage drops from 1000 to 960 kWh\nped_electricity = midpoint_elasticity(0.12, 0.14, 1000, 960)\nprint(f\"\\nElectricity PED: {ped_electricity:.2f}\")\nprint(f\"Demand is {'elastic' if abs(ped_electricity) > 1 else 'inelastic'}\")\n\n# Example: Streaming service raises price from $10 to $15\n# Subscribers drop from 1M to 600K\nped_streaming = midpoint_elasticity(10, 15, 1000000, 600000)\nprint(f\"\\nStreaming PED: {ped_streaming:.2f}\")\nprint(f\"Demand is {'elastic' if abs(ped_streaming) > 1 else 'inelastic'}\")"
        ]
      ]
    },
    {
