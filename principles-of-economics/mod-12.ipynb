          "python",
          "# Free-rider problem simulation\nimport numpy as np\n\nnum_households = 100\nvalue_per_household = 20\ncost = 1500\ncontribution_rate = 0.15  # Only 15% contribute voluntarily\n\ntotal_value = num_households * value_per_household\nvoluntary_contributions = num_households * contribution_rate * value_per_household\n\nprint(\"=== Free-Rider Problem: Fireworks Display ===\")\nprint(f\"Households: {num_households}\")\nprint(f\"Value per household: ${value_per_household}\")\nprint(f\"Total social value: ${total_value}\")\nprint(f\"Cost of display: ${cost}\")\nprint(f\"Net social benefit: ${total_value - cost}\")\nprint(f\"\\nWith voluntary contributions ({contribution_rate*100:.0f}% contribute):\")\nprint(f\"Total raised: ${voluntary_contributions:.0f}\")\nprint(f\"Sufficient? {'Yes' if voluntary_contributions >= cost else 'No'}\")\nprint(f\"Shortfall: ${max(0, cost - voluntary_contributions):.0f}\")\n\n# Government solution: tax each household\ntax_per_household = cost / num_households\nnet_benefit_per_household = value_per_household - tax_per_household\nprint(f\"\\nGovernment tax solution:\")\nprint(f\"Tax per household: ${tax_per_household:.2f}\")\nprint(f\"Net benefit per household: ${net_benefit_per_household:.2f}\")\nprint(f\"Everyone better off? {net_benefit_per_household > 0}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
