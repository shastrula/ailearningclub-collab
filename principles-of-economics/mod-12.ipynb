      "source": [
        [
          "python",
          "# Tragedy of the Commons: Fishery model\n# Each fisherman decides how many boats to send\n# More boats = more fish per fisherman initially, but stock depletes\n\ndef fish_per_boat(total_boats, fish_stock=1000):\n    \"\"\"Fish caught per boat decreases as more boats enter.\"\"\"\n    if total_boats == 0:\n        return 0\n    catch_rate = fish_stock / (total_boats + 50)  # Decreasing returns\n    return catch_rate\n\ndef total_catch(total_boats):\n    return total_boats * fish_per_boat(total_boats)\n\ncost_per_boat = 8  # Cost of sending one boat\nprice_per_fish = 1\n\n# Private optimum for each fisherman (ignoring depletion)\n# vs. social optimum (maximizing total catch minus costs)\nprint(\"=== Tragedy of the Commons: Fishery ===\")\nprint(f\"{'Boats':<8} {'Fish/Boat':<12} {'Total Catch':<13} {'Revenue':<10} {'Total Cost':<11} {'Profit':<8}\")\nprint(\"-\" * 62)\n\nmax_profit_boats = 0\nmax_profit = 0\nfor boats in range(10, 200, 10):\n    fpb = fish_per_boat(boats)\n    tc = total_catch(boats)\n    revenue = tc * price_per_fish\n    cost = boats * cost_per_boat\n    profit = revenue - cost\n    if profit > max_profit:\n        max_profit = profit\n        max_profit_boats = boats\n    print(f\"{boats:<8} {fpb:<12.1f} {tc:<13.0f} ${revenue:<9.0f} ${cost:<10.0f} ${profit:<7.0f}\")\n\n# Open access: boats enter until profit per boat = 0\n# fish_per_boat * price = cost_per_boat\n# 1000/(boats+50) = 8 -> boats = 75\nopen_access_boats = (1000 / cost_per_boat) - 50\nprint(f\"\\nSocially optimal boats: {max_profit_boats}\")\nprint(f\"Open access boats (zero profit): {open_access_boats:.0f}\")\nprint(f\"Overexploitation: {open_access_boats - max_profit_boats:.0f} excess boats\")"
        ]
      ]
    }
