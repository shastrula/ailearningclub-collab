      "source": [
        [
          "python",
          "import numpy as np\n\n# Linear supply and demand model\n# Demand: Qd = 100 - 2P\n# Supply: Qs = -20 + 3P\n\ndef demand(price):\n    return 100 - 2 * price\n\ndef supply(price):\n    return -20 + 3 * price\n\n# Find equilibrium: set Qd = Qs\n# 100 - 2P = -20 + 3P\n# 120 = 5P\nequilibrium_price = 120 / 5\nequilibrium_quantity = demand(equilibrium_price)\n\nprint(f\"Equilibrium price: ${equilibrium_price:.2f}\")\nprint(f\"Equilibrium quantity: {equilibrium_quantity:.0f} units\")\n\n# Demonstrate surplus and shortage\nhigh_price = 30\nprint(f\"\\nAt price ${high_price}:\")\nprint(f\"  Quantity demanded: {demand(high_price)}\")\nprint(f\"  Quantity supplied: {supply(high_price)}\")\nprint(f\"  Surplus: {supply(high_price) - demand(high_price)} units\")\n\nlow_price = 15\nprint(f\"\\nAt price ${low_price}:\")\nprint(f\"  Quantity demanded: {demand(low_price)}\")\nprint(f\"  Quantity supplied: {supply(low_price)}\")\nprint(f\"  Shortage: {demand(low_price) - supply(low_price)} units\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Modeling a demand shift\ndef demand_original(price):\n    return 100 - 2 * price\n\ndef demand_shifted(price):\n    return 130 - 2 * price  # Demand increased by 30 at every price\n\ndef supply(price):\n    return -20 + 3 * price\n\n# Original equilibrium\neq_price_1 = 120 / 5  # (100+20)/5\neq_qty_1 = demand_original(eq_price_1)\n\n# New equilibrium after demand shift\n# 130 - 2P = -20 + 3P \u2192 150 = 5P\neq_price_2 = 150 / 5\neq_qty_2 = demand_shifted(eq_price_2)\n\nprint(\"=== Demand Shift Analysis ===\")\nprint(f\"Original equilibrium: P=${eq_price_1:.2f}, Q={eq_qty_1:.0f}\")\nprint(f\"New equilibrium:      P=${eq_price_2:.2f}, Q={eq_qty_2:.0f}\")\nprint(f\"Price change:         +${eq_price_2 - eq_price_1:.2f}\")\nprint(f\"Quantity change:      +{eq_qty_2 - eq_qty_1:.0f} units\")"
        ]
      ]
    }
