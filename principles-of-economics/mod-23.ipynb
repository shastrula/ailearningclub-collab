      "source": [
        [
          "python",
          "# Policy impact simulation: progressive taxation and transfers\ndef after_tax_income(gross_income, brackets):\n    \"\"\"Calculate after-tax income with progressive brackets.\"\"\"\n    tax = 0\n    remaining = gross_income\n    prev_limit = 0\n    for limit, rate in brackets:\n        taxable = min(remaining, limit - prev_limit)\n        tax += taxable * rate\n        remaining -= taxable\n        prev_limit = limit\n        if remaining <= 0:\n            break\n    return gross_income - tax\n\nus_brackets = [\n    (11000, 0.10),\n    (44725, 0.12),\n    (95375, 0.22),\n    (182100, 0.24),\n    (231250, 0.32),\n    (578125, 0.35),\n    (float('inf'), 0.37),\n]\n\nincomes = [15000, 30000, 50000, 75000, 100000, 200000, 500000, 1000000]\n\nprint(\"=== Progressive Tax Impact ===\")\nprint(f\"{'Gross Income':<14} {'After Tax':<12} {'Effective Rate':<16} {'Tax Paid':<10}\")\nprint(\"-\" * 52)\nfor inc in incomes:\n    after = after_tax_income(inc, us_brackets)\n    effective_rate = (inc - after) / inc * 100\n    tax_paid = inc - after\n    print(f\"${inc:>10,}   ${after:>9,.0f}   {effective_rate:>6.1f}%          ${tax_paid:>8,.0f}\")"
        ]
      ]
    }
