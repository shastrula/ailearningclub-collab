      "source": [
        [
          "python",
          "import numpy as np\n\n# Gini coefficient calculation\ndef gini_coefficient(incomes):\n    \"\"\"Calculate Gini coefficient from a list of incomes.\"\"\"\n    sorted_incomes = sorted(incomes)\n    n = len(sorted_incomes)\n    cumulative = np.cumsum(sorted_incomes)\n    total = cumulative[-1]\n    # Gini = (2 * sum of i*x_i) / (n * sum of x_i) - (n+1)/n\n    gini = (2 * sum((i+1) * x for i, x in enumerate(sorted_incomes))) / (n * total) - (n + 1) / n\n    return gini\n\n# Income distributions for different countries (representative samples)\ncountries = {\n    'Sweden': [25000, 30000, 35000, 40000, 42000, 45000, 48000, 52000, 58000, 70000],\n    'United States': [12000, 20000, 28000, 35000, 45000, 55000, 70000, 90000, 130000, 300000],\n    'Brazil': [3000, 5000, 8000, 12000, 18000, 25000, 40000, 60000, 100000, 400000],\n    'South Africa': [1000, 2000, 4000, 7000, 12000, 20000, 35000, 60000, 120000, 500000],\n}\n\nprint(\"=== Income Inequality Comparison ===\")\nprint(f\"{'Country':<15} {'Gini':<8} {'Top 10%/Bottom 10%':<20} {'Median':<10}\")\nprint(\"-\" * 53)\nfor country, incomes in countries.items():\n    gini = gini_coefficient(incomes)\n    ratio = incomes[-1] / incomes[0]\n    median = sorted(incomes)[len(incomes)//2]\n    print(f\"{country:<15} {gini:<8.3f} {ratio:<20.0f}x ${median:>8,}\")\n\n# US income distribution over time\nprint(f\"\\n=== US Income Share by Quintile ===\")\nus_shares = {\n    1980: [4.3, 10.3, 16.9, 24.9, 43.7],\n    2000: [3.6, 8.9, 14.8, 23.0, 49.8],\n    2020: [3.0, 8.1, 13.8, 22.6, 52.5],\n}\nprint(f\"{'Year':<6} {'Bottom 20%':<12} {'2nd':<8} {'3rd':<8} {'4th':<8} {'Top 20%':<10}\")\nprint(\"-\" * 52)\nfor year, shares in us_shares.items():\n    print(f\"{year:<6} {shares[0]:<12.1f} {shares[1]:<8.1f} {shares[2]:<8.1f} {shares[3]:<8.1f} {shares[4]:<10.1f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
