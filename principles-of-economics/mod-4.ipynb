      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Diminishing marginal utility example\ndef total_utility(quantity, a=10, b=0.5):\n    \"\"\"Utility function: U = a * Q^b (concave, diminishing MU)\"\"\"\n    return a * (quantity ** b)\n\ndef marginal_utility(quantity, a=10, b=0.5):\n    \"\"\"MU = dU/dQ = a * b * Q^(b-1)\"\"\"\n    if quantity <= 0:\n        return 0\n    return a * b * (quantity ** (b - 1))\n\nprint(\"=== Pizza Consumption ===\")\nprint(f\"{'Slices':<8} {'Total Utility':<15} {'Marginal Utility':<15}\")\nprint(\"-\" * 38)\nfor q in range(1, 9):\n    tu = total_utility(q)\n    mu = marginal_utility(q)\n    print(f\"{q:<8} {tu:<15.2f} {mu:<15.2f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Indifference curve and budget constraint analysis\n# Utility function: U(x, y) = x^0.5 * y^0.5 (Cobb-Douglas)\n\ndef utility(x, y):\n    return (x ** 0.5) * (y ** 0.5)\n\ndef mrs(x, y):\n    \"\"\"MRS = MUx/MUy = y/x for this utility function\"\"\"\n    if x == 0:\n        return float('inf')\n    return y / x\n\n# Budget: Px=4, Py=2, Income=100\npx, py, income = 4, 2, 100\n\n# Optimal choice for Cobb-Douglas: spend equal shares on each good\noptimal_x = income / (2 * px)\noptimal_y = income / (2 * py)\noptimal_utility = utility(optimal_x, optimal_y)\n\nprint(\"=== Consumer Optimal Choice ===\")\nprint(f\"Prices: Px=${px}, Py=${py}\")\nprint(f\"Income: ${income}\")\nprint(f\"Optimal bundle: X={optimal_x:.1f}, Y={optimal_y:.1f}\")\nprint(f\"Utility at optimum: {optimal_utility:.2f}\")\nprint(f\"MRS at optimum: {mrs(optimal_x, optimal_y):.2f}\")\nprint(f\"Price ratio (Px/Py): {px/py:.2f}\")\nprint(f\"MRS = Price ratio? {abs(mrs(optimal_x, optimal_y) - px/py) < 0.01}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Deriving demand curve from utility maximization\npy_fixed = 2\nincome_fixed = 100\nprices_x = [2, 3, 4, 5, 6, 8, 10, 12]\n\nprint(\"=== Derived Demand Curve ===\")\nprint(f\"{'Price of X':<12} {'Quantity X':<12} {'Quantity Y':<12} {'Utility':<10}\")\nprint(\"-\" * 46)\n\nfor px in prices_x:\n    x_star = income_fixed / (2 * px)\n    y_star = income_fixed / (2 * py_fixed)\n    u = utility(x_star, y_star)\n    print(f\"${px:<11} {x_star:<12.1f} {y_star:<12.1f} {u:<10.2f}\")"
        ]
      ]
    }
