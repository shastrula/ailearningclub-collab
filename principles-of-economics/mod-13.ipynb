      "outputs": [],
      "source": [
        [
          "python",
          "# GDP by expenditure approach - US approximate data (trillions)\ncomponents = {\n    'Consumption (C)': 17.5,\n    'Investment (I)': 4.6,\n    'Government (G)': 4.4,\n    'Net Exports (NX)': -0.8,\n}\n\ngdp = sum(components.values())\n\nprint(\"=== US GDP by Expenditure (Approximate, Trillions) ===\")\nprint(f\"{'Component':<25} {'Amount':<12} {'% of GDP':<10}\")\nprint(\"-\" * 47)\nfor component, value in components.items():\n    pct = (value / gdp) * 100\n    print(f\"{component:<25} ${value:<11.1f} {pct:<9.1f}%\")\nprint(f\"{'Total GDP':<25} ${gdp:<11.1f} {'100.0':<9}%\")\n\n# Value-added example: bread production\nprint(\"\\n=== Value-Added Approach: Bread ===\")\nstages = [\n    (\"Wheat farmer\", 0.50, 0.00),\n    (\"Miller (flour)\", 0.80, 0.50),\n    (\"Bakery (bread)\", 2.00, 0.80),\n    (\"Grocery store\", 2.50, 2.00),\n]\n\ntotal_value_added = 0\nprint(f\"{'Stage':<20} {'Revenue':<10} {'Inputs':<10} {'Value Added':<12}\")\nprint(\"-\" * 52)\nfor stage, revenue, inputs in stages:\n    va = revenue - inputs\n    total_value_added += va\n    print(f\"{stage:<20} ${revenue:<9.2f} ${inputs:<9.2f} ${va:<11.2f}\")\nprint(f\"\\n{'Total value added':<20} {'':<10} {'':<10} ${total_value_added:<11.2f}\")\nprint(f\"Final price of bread: ${stages[-1][1]:.2f}\")\nprint(f\"Value added = Final price: {abs(total_value_added - stages[-1][1]) < 0.01}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Nominal vs Real GDP calculation\n# Economy produces only two goods: apples and oranges\n\ndata = {\n    2022: {'apples': (100, 2.00), 'oranges': (200, 1.50)},  # (qty, price)\n    2023: {'apples': (110, 2.20), 'oranges': (210, 1.65)},\n    2024: {'apples': (115, 2.50), 'oranges': (220, 1.80)},\n}\n\nbase_year = 2022\nbase_prices = {good: data[base_year][good][1] for good in ['apples', 'oranges']}\n\nprint(\"=== Nominal vs. Real GDP ===\")\nprint(f\"Base year: {base_year}\")\nprint(f\"Base prices: Apples=${base_prices['apples']}, Oranges=${base_prices['oranges']}\")\nprint(f\"\\n{'Year':<6} {'Nominal GDP':<14} {'Real GDP':<12} {'GDP Deflator':<14} {'Real Growth':<12}\")\nprint(\"-\" * 58)\n\nprev_real = None\nfor year, goods in data.items():\n    nominal = sum(qty * price for qty, price in goods.values())\n    real = sum(qty * base_prices[good] for good, (qty, price) in goods.items())\n    deflator = (nominal / real) * 100\n    growth = f\"{((real/prev_real)-1)*100:.1f}%\" if prev_real else \"---\"\n    print(f\"{year:<6} ${nominal:<13.2f} ${real:<11.2f} {deflator:<14.1f} {growth:<12}\")\n    prev_real = real"
        ]
      ]
    }
