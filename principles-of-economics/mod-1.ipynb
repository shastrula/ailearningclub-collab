      "source": [
        [
          "python",
          "# Calculating opportunity cost for a simple decision\noptions = {\n    \"work_shift\": 100,      # dollars earned\n    \"freelance_project\": 80, # dollars earned\n    \"concert\": 50,           # subjective value in dollars\n    \"study\": 70              # estimated future value in dollars\n}\n\n# If you choose \"work_shift\", your opportunity cost is the next best alternative\nchosen = \"work_shift\"\nalternatives = {k: v for k, v in options.items() if k != chosen}\nopportunity_cost = max(alternatives.values())\n\nprint(f\"Choice: {chosen} (value: ${options[chosen]})\")\nprint(f\"Opportunity cost: ${opportunity_cost}\")\nprint(f\"Net benefit: ${options[chosen] - opportunity_cost}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Production Possibilities Frontier model\n# Maximum food = 100 units, Maximum computers = 80 units\n# PPF equation: (food/100)^2 + (computers/80)^2 = 1 (bowed outward)\n\nfood_max = 100\ncomputers_max = 80\n\n# Generate PPF points\ncomputers = np.linspace(0, computers_max, 50)\nfood = food_max * np.sqrt(1 - (computers / computers_max)**2)\n\n# Calculate opportunity cost at different points\n# Moving from 20 to 30 computers vs 60 to 70 computers\ndef food_at_computers(c):\n    return food_max * np.sqrt(1 - (c / computers_max)**2)\n\noc_low = food_at_computers(20) - food_at_computers(30)\noc_high = food_at_computers(60) - food_at_computers(70)\n\nprint(f\"Opportunity cost of computers 20->30: {oc_low:.1f} units of food\")\nprint(f\"Opportunity cost of computers 60->70: {oc_high:.1f} units of food\")\nprint(f\"Increasing opportunity cost: {oc_high > oc_low}\")"
        ]
      ]
    }
