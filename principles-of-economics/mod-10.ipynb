      "source": [
        [
          "python",
          "# Human capital returns model\ndef lifetime_earnings(education_years, starting_age=18, retirement_age=65):\n    \"\"\"Estimate lifetime earnings based on education level.\"\"\"\n    work_start = starting_age + education_years\n    work_years = retirement_age - work_start\n    \n    # Base wage increases with education (diminishing returns)\n    base_wage = 30000 * (1 + 0.1 * education_years)\n    \n    # Annual growth rate\n    growth_rate = 0.02 + 0.005 * min(education_years, 8)\n    \n    total = 0\n    # Cost of education (foregone earnings + tuition)\n    tuition_per_year = 15000 if education_years > 4 else 8000\n    education_cost = sum(tuition_per_year + 30000 for _ in range(max(0, education_years - 0)))\n    \n    for year in range(work_years):\n        annual_wage = base_wage * (1 + growth_rate) ** year\n        total += annual_wage\n    \n    return total, education_cost, work_years\n\nscenarios = [\n    (\"High School\", 0),\n    (\"Associate's\", 2),\n    (\"Bachelor's\", 4),\n    (\"Master's\", 6),\n    (\"Doctorate/MD\", 10),\n]\n\nprint(\"=== Human Capital Returns ===\")\nprint(f\"{'Education':<15} {'Work Years':<12} {'Lifetime Earnings':<20} {'Annual Avg':<12}\")\nprint(\"-\" * 59)\nfor name, years in scenarios:\n    earnings, cost, work_yrs = lifetime_earnings(years)\n    avg = earnings / work_yrs if work_yrs > 0 else 0\n    print(f\"{name:<15} {work_yrs:<12} ${earnings:>14,.0f}   ${avg:>9,.0f}\")"
        ]
      ]
    }
