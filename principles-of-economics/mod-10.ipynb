      "source": [
        [
          "python",
          "import numpy as np\n\n# Labor demand based on marginal revenue product\n# Production: Q = 20L - 0.5L^2 (diminishing returns)\n# Product price: $10 per unit (competitive product market)\n\nprice = 10\nwage = 50\n\ndef marginal_product(labor):\n    \"\"\"MP_L = 20 - L\"\"\"\n    return 20 - labor\n\ndef mrp(labor):\n    \"\"\"MRP_L = MP_L * Price\"\"\"\n    return marginal_product(labor) * price\n\n# Optimal hiring: MRP = W -> (20 - L)*10 = 50 -> L = 15\noptimal_labor = 20 - wage / price\n\nprint(\"=== Labor Demand Schedule ===\")\nprint(f\"Product price: ${price}, Wage: ${wage}/hr\")\nprint(f\"\\n{'Workers':<10} {'MP_L':<8} {'MRP_L':<10} {'Hire?':<8}\")\nprint(\"-\" * 36)\nfor l in range(1, 21, 2):\n    mp = marginal_product(l)\n    mrp_val = mrp(l)\n    hire = \"Yes\" if mrp_val >= wage else \"No\"\n    print(f\"{l:<10} {mp:<8.1f} ${mrp_val:<9.0f} {hire}\")\n\nprint(f\"\\nOptimal employment: {optimal_labor:.0f} workers\")\nprint(f\"At L={optimal_labor:.0f}: MRP = ${mrp(optimal_labor):.0f} = Wage = ${wage}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
