      "source": [
        [
          "python",
          "import numpy as np\n\n# Monetary policy transmission mechanism simulation\n# Fed lowers federal funds rate -> affects broader economy\n\ndef monetary_transmission(fed_funds_change):\n    \"\"\"Simulate how a change in fed funds rate propagates.\"\"\"\n    # Rough multipliers based on empirical estimates\n    mortgage_rate_change = fed_funds_change * 0.7\n    corporate_bond_change = fed_funds_change * 0.6\n    \n    # Investment response (inverse relationship with rates)\n    investment_change_pct = -fed_funds_change * 2.0\n    \n    # Consumption response (through wealth and borrowing)\n    consumption_change_pct = -fed_funds_change * 0.5\n    \n    # Exchange rate (lower rates weaken currency)\n    exchange_rate_change = fed_funds_change * 3.0  # % appreciation\n    \n    # Net exports (weaker currency helps exports)\n    net_exports_change_pct = -fed_funds_change * 1.0\n    \n    # Total GDP impact (rough)\n    gdp_impact = (investment_change_pct * 0.18 + \n                  consumption_change_pct * 0.68 + \n                  net_exports_change_pct * 0.03)\n    \n    return {\n        'mortgage_rate': mortgage_rate_change,\n        'corporate_rate': corporate_bond_change,\n        'investment': investment_change_pct,\n        'consumption': consumption_change_pct,\n        'exchange_rate': exchange_rate_change,\n        'net_exports': net_exports_change_pct,\n        'gdp_impact': gdp_impact,\n    }\n\n# Scenario: Fed cuts rates by 1 percentage point\ncut = -1.0\nresults = monetary_transmission(cut)\n\nprint(f\"=== Monetary Policy Transmission ===\")\nprint(f\"Fed funds rate change: {cut:+.1f} percentage points\")\nprint(f\"\\n--- Interest Rate Channel ---\")\nprint(f\"  Mortgage rates:     {results['mortgage_rate']:+.2f}pp\")\nprint(f\"  Corporate rates:    {results['corporate_rate']:+.2f}pp\")\nprint(f\"\\n--- Real Economy Effects ---\")\nprint(f\"  Investment:         {results['investment']:+.1f}%\")\nprint(f\"  Consumption:        {results['consumption']:+.1f}%\")\nprint(f\"  Exchange rate:      {results['exchange_rate']:+.1f}% (depreciation)\")\nprint(f\"  Net exports:        {results['net_exports']:+.1f}%\")\nprint(f\"\\n--- Overall Impact ---\")\nprint(f\"  GDP effect:         {results['gdp_impact']:+.2f}% (with 12-18 month lag)\")"
        ]
      ]
    },
    {
