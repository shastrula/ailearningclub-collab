          "python",
          "# Taylor Rule calculation\ndef taylor_rule(inflation, output_gap, r_star=2.0, target_inflation=2.0):\n    \"\"\"Calculate recommended federal funds rate.\"\"\"\n    rate = r_star + inflation + 0.5 * (inflation - target_inflation) + 0.5 * output_gap\n    return rate\n\nscenarios = [\n    (\"Normal economy\", 2.0, 0.0),\n    (\"Overheating\", 4.0, 2.0),\n    (\"Mild recession\", 1.5, -2.0),\n    (\"Severe recession\", 0.5, -5.0),\n    (\"Stagflation\", 5.0, -2.0),\n    (\"Post-pandemic (2022)\", 7.0, 1.0),\n]\n\nprint(\"=== Taylor Rule Recommendations ===\")\nprint(f\"Neutral real rate (r*) = 2.0%, Inflation target = 2.0%\")\nprint(f\"\\n{'Scenario':<25} {'Inflation':<11} {'Output Gap':<12} {'Taylor Rate':<12}\")\nprint(\"-\" * 60)\nfor name, inf, gap in scenarios:\n    rate = taylor_rule(inf, gap)\n    print(f\"{name:<25} {inf:<11.1f}% {gap:<+11.1f}% {rate:<11.1f}%\")"
        ]
      ]
    }
