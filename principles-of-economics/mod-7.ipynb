      "source": [
        "# Principles Of Economics - mod-7\n\n",
        "**Course:** principles-of-economics\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Monopoly profit maximization\n# Demand: P = 100 - 2Q\n# MC = 20 + Q\n# MR = 100 - 4Q\n\ndef demand_price(q):\n    return 100 - 2 * q\n\ndef marginal_revenue(q):\n    return 100 - 4 * q\n\ndef marginal_cost(q):\n    return 20 + q\n\ndef total_revenue(q):\n    return demand_price(q) * q\n\ndef total_cost(q):\n    return 20 * q + 0.5 * q ** 2 + 100  # FC = 100\n\ndef profit(q):\n    return total_revenue(q) - total_cost(q)\n\n# Optimal: MR = MC -> 100 - 4Q = 20 + Q -> 80 = 5Q -> Q = 16\noptimal_q = 80 / 5\noptimal_p = demand_price(optimal_q)\nmax_profit = profit(optimal_q)\n\nprint(\"=== Monopoly Profit Maximization ===\")\nprint(f\"Optimal quantity: {optimal_q:.0f} units\")\nprint(f\"Price charged: ${optimal_p:.0f}\")\nprint(f\"Marginal cost at Q*: ${marginal_cost(optimal_q):.0f}\")\nprint(f\"Markup over MC: ${optimal_p - marginal_cost(optimal_q):.0f}\")\nprint(f\"Total revenue: ${total_revenue(optimal_q):.0f}\")\nprint(f\"Total cost: ${total_cost(optimal_q):.0f}\")\nprint(f\"Economic profit: ${max_profit:.0f}\")\n\n# Compare with competitive outcome (P = MC)\n# 100 - 2Q = 20 + Q -> 80 = 3Q -> Q = 26.67\ncompetitive_q = 80 / 3\ncompetitive_p = demand_price(competitive_q)\nprint(f\"\\n=== Competitive Benchmark ===\")\nprint(f\"Competitive quantity: {competitive_q:.1f} units\")\nprint(f\"Competitive price: ${competitive_p:.1f}\")\nprint(f\"Monopoly produces {competitive_q - optimal_q:.1f} fewer units\")\nprint(f\"Monopoly charges ${optimal_p - competitive_p:.1f} more\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Deadweight loss calculation\n# DWL = 0.5 * (P_m - MC_m) * (Q_c - Q_m)\n# But more precisely, it's the area between demand and MC from Q_m to Q_c\n\n# Numerical integration of DWL\ndwl = 0\nsteps = 1000\nq_range = np.linspace(optimal_q, competitive_q, steps)\nfor i in range(len(q_range) - 1):\n    q = (q_range[i] + q_range[i+1]) / 2\n    dq = q_range[i+1] - q_range[i]\n    dwl += (demand_price(q) - marginal_cost(q)) * dq\n\n# Consumer surplus under monopoly vs competition\ncs_monopoly = 0.5 * (100 - optimal_p) * optimal_q\ncs_competitive = 0.5 * (100 - competitive_p) * competitive_q\n\nprint(\"=== Welfare Analysis ===\")\nprint(f\"Deadweight loss: ${dwl:.2f}\")\nprint(f\"Consumer surplus (monopoly): ${cs_monopoly:.0f}\")\nprint(f\"Consumer surplus (competition): ${cs_competitive:.0f}\")\nprint(f\"Transfer from consumers to monopolist: ${cs_competitive - cs_monopoly - dwl:.0f}\")"
        ]
      ]
    }
