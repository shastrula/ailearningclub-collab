      "source": [
        "# Principles Of Economics - mod-11\n\n",
        "**Course:** principles-of-economics\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Negative externality: pollution from production\n# Private MC: PMC = 10 + 0.5Q\n# External cost: EC = 0.3Q (pollution damage per unit)\n# Social MC: SMC = PMC + EC = 10 + 0.8Q\n# Demand: P = 50 - 0.5Q\n\ndef private_mc(q):\n    return 10 + 0.5 * q\n\ndef external_cost(q):\n    return 0.3 * q\n\ndef social_mc(q):\n    return private_mc(q) + external_cost(q)\n\ndef demand_price(q):\n    return 50 - 0.5 * q\n\n# Market equilibrium (ignoring externality): P = PMC\n# 50 - 0.5Q = 10 + 0.5Q -> 40 = Q\nmarket_q = 40\nmarket_p = demand_price(market_q)\n\n# Socially optimal: P = SMC\n# 50 - 0.5Q = 10 + 0.8Q -> 40 = 1.3Q -> Q = 30.77\nsocial_q = 40 / 1.3\nsocial_p = demand_price(social_q)\n\n# Deadweight loss from overproduction\ndwl = 0.5 * (social_mc(market_q) - demand_price(market_q)) * (market_q - social_q)\n\nprint(\"=== Negative Externality Analysis ===\")\nprint(f\"Market equilibrium: Q={market_q:.1f}, P=${market_p:.2f}\")\nprint(f\"Socially optimal:  Q={social_q:.1f}, P=${social_p:.2f}\")\nprint(f\"Overproduction: {market_q - social_q:.1f} units\")\nprint(f\"Deadweight loss: ${abs(dwl):.2f}\")\nprint(f\"\\nOptimal Pigouvian tax: ${external_cost(social_q):.2f} per unit\")\nprint(f\"(Equal to external cost at socially optimal quantity)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Policy comparison: tax vs. cap-and-trade\n# Both achieve the same reduction, different mechanisms\n\ntarget_reduction = market_q - social_q  # Units to reduce\ntax_per_unit = external_cost(social_q)\n\n# Revenue from Pigouvian tax\ntax_revenue = tax_per_unit * social_q\n\n# Cap-and-trade: government issues permits = social_q\npermits_issued = social_q\n# Permit price equals the tax in equilibrium\npermit_price = tax_per_unit\n\nprint(\"=== Policy Comparison ===\")\nprint(f\"\\nPigouvian Tax:\")\nprint(f\"  Tax rate: ${tax_per_unit:.2f} per unit\")\nprint(f\"  Output after tax: {social_q:.1f} units\")\nprint(f\"  Government revenue: ${tax_revenue:.2f}\")\nprint(f\"  Emission reduction: {target_reduction:.1f} units\")\n\nprint(f\"\\nCap-and-Trade:\")\nprint(f\"  Permits issued: {permits_issued:.1f}\")\nprint(f\"  Market permit price: ${permit_price:.2f}\")\nprint(f\"  Revenue (if auctioned): ${permit_price * permits_issued:.2f}\")\nprint(f\"  Emission reduction: {target_reduction:.1f} units\")\n\nprint(f\"\\nBoth achieve the socially optimal outcome\")\nprint(f\"Tax provides price certainty; Cap provides quantity certainty\")"
        ]
      ]
    }
