      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Production function demonstrating diminishing returns\ndef production(labor):\n    \"\"\"Short-run production function with fixed capital.\"\"\"\n    return max(0, 10 * labor - 0.5 * labor ** 2)\n\ndef marginal_product(labor):\n    \"\"\"MP_L = dQ/dL = 10 - L\"\"\"\n    return 10 - labor\n\ndef average_product(labor):\n    \"\"\"AP_L = Q/L = 10 - 0.5L\"\"\"\n    if labor == 0:\n        return 0\n    return production(labor) / labor\n\nprint(\"=== Production with Diminishing Returns ===\")\nprint(f\"{'Workers':<10} {'Total Output':<14} {'Marginal Product':<18} {'Average Product':<16}\")\nprint(\"-\" * 58)\nfor l in range(1, 12):\n    tp = production(l)\n    mp = marginal_product(l)\n    ap = average_product(l)\n    print(f\"{l:<10} {tp:<14.1f} {mp:<18.1f} {ap:<16.1f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Short-run cost analysis\nfixed_cost = 1000\n\ndef variable_cost(q):\n    return 5 * q + 0.1 * q ** 2\n\ndef total_cost(q):\n    return fixed_cost + variable_cost(q)\n\ndef marginal_cost(q):\n    return 5 + 0.2 * q\n\ndef average_total_cost(q):\n    if q == 0:\n        return float('inf')\n    return total_cost(q) / q\n\nprint(\"=== Short-Run Cost Structure ===\")\nprint(f\"{'Q':<6} {'TC':<10} {'VC':<10} {'ATC':<10} {'AVC':<10} {'MC':<8}\")\nprint(\"-\" * 54)\nfor q in range(10, 110, 10):\n    tc = total_cost(q)\n    vc = variable_cost(q)\n    atc = average_total_cost(q)\n    avc = vc / q\n    mc = marginal_cost(q)\n    print(f\"{q:<6} ${tc:<9.0f} ${vc:<9.0f} ${atc:<9.2f} ${avc:<9.2f} ${mc:<7.2f}\")\n\n# Find minimum ATC: Q = sqrt(FC/0.1)\nmin_atc_q = (fixed_cost / 0.1) ** 0.5\nprint(f\"\\nMinimum ATC at Q = {min_atc_q:.0f}, ATC = ${average_total_cost(min_atc_q):.2f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Long-run cost minimization\nw, r = 20, 40\ntarget_output = 100\na, b = 0.6, 0.4\n\nratio = (b / a) * (w / r)\nL_star = target_output / (ratio ** b)\nK_star = ratio * L_star\nmin_cost = w * L_star + r * K_star\n\nprint(\"=== Long-Run Cost Minimization ===\")\nprint(f\"Target output: {target_output} units\")\nprint(f\"Wage: ${w}/hr, Capital rental: ${r}/hr\")\nprint(f\"Optimal labor: {L_star:.2f} hours\")\nprint(f\"Optimal capital: {K_star:.2f} hours\")\nprint(f\"Minimum cost: ${min_cost:.2f}\")"
        ]
      ]
    }
