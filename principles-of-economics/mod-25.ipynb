      "source": [
        [
          "python",
          "import numpy as np\n\n# Innovation investment model: R&D spending and returns\ndef innovation_returns(rd_spending, appropriability=0.3, spillover_rate=0.7):\n    \"\"\"\n    Model private and social returns to R&D.\n    appropriability: fraction of benefits captured by innovator\n    spillover_rate: fraction that spills over to society\n    \"\"\"\n    # Diminishing returns to R&D\n    total_social_value = 100 * (rd_spending ** 0.5)\n    private_return = total_social_value * appropriability\n    social_spillover = total_social_value * spillover_rate\n    \n    return {\n        'total_social_value': total_social_value,\n        'private_return': private_return,\n        'social_spillover': social_spillover,\n        'private_roi': (private_return - rd_spending) / rd_spending * 100,\n        'social_roi': (total_social_value - rd_spending) / rd_spending * 100,\n    }\n\nprint(\"=== R&D Investment: Private vs. Social Returns ===\")\nprint(f\"Appropriability: 30% (innovator captures 30% of value)\")\nprint(f\"\\n{'R&D Spend':<11} {'Social Value':<14} {'Private Return':<15} {'Private ROI':<12} {'Social ROI'}\")\nprint(\"-\" * 64)\nfor spend in [10, 25, 50, 100, 200, 400]:\n    r = innovation_returns(spend)\n    print(f\"${spend:<10} ${r['total_social_value']:<13.0f} ${r['private_return']:<14.0f} \"\n          f\"{r['private_roi']:<11.0f}% {r['social_roi']:<.0f}%\")\n\n# Private optimal: where private marginal return = marginal cost\n# Social optimal: where social marginal return = marginal cost\n# Gap = underinvestment in R&D\nprint(f\"\\nPrivate firm stops investing when private ROI approaches 0%\")\nprint(f\"Social optimum continues much further (social ROI > 0 at higher levels)\")\nprint(f\"Result: market produces LESS innovation than socially optimal\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
