        [
          "python",
          "# Network effects and market tipping\ndef network_value(users, n_total=1000):\n    \"\"\"Metcalfe's Law: value proportional to n^2 connections.\"\"\"\n    return users * (users - 1) / 2  # Number of possible connections\n\ndef platform_adoption(periods=20, initial_users_a=100, initial_users_b=80, n_total=1000):\n    \"\"\"Simulate two competing platforms with network effects.\"\"\"\n    users_a = initial_users_a\n    users_b = initial_users_b\n    remaining = n_total - users_a - users_b\n    \n    results = []\n    for t in range(periods):\n        # New users choose based on relative network value\n        value_a = network_value(users_a)\n        value_b = network_value(users_b)\n        total_value = value_a + value_b\n        \n        if total_value > 0 and remaining > 0:\n            new_users = min(50, remaining)  # 50 new users per period\n            share_a = value_a / total_value\n            join_a = int(new_users * share_a)\n            join_b = new_users - join_a\n            users_a += join_a\n            users_b += join_b\n            remaining -= new_users\n        \n        results.append((t, users_a, users_b, remaining))\n    \n    return results\n\nresults = platform_adoption()\nprint(\"=== Platform Competition with Network Effects ===\")\nprint(f\"Starting: Platform A = 100 users, Platform B = 80 users, Market = 1000\")\nprint(f\"\\n{'Period':<8} {'Platform A':<12} {'Platform B':<12} {'Remaining':<10} {'A Share'}\")\nprint(\"-\" * 52)\nfor t, a, b, r in results[::2]:\n    share = a / (a + b) * 100\n    print(f\"{t:<8} {a:<12} {b:<12} {r:<10} {share:.0f}%\")\n\nprint(f\"\\nSmall initial advantage compounds into market dominance\")"
        ]
      ]
    }
