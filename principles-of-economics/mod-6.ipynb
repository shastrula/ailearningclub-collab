      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Profit maximization for a competitive firm\nmarket_price = 20  # Firm takes this as given\n\ndef total_cost(q):\n    \"\"\"TC = 50 + 2Q + 0.1Q^2 (fixed cost = 50)\"\"\"\n    return 50 + 2 * q + 0.1 * q ** 2\n\ndef marginal_cost(q):\n    \"\"\"MC = dTC/dQ = 2 + 0.2Q\"\"\"\n    return 2 + 0.2 * q\n\ndef profit(q):\n    return market_price * q - total_cost(q)\n\n# Optimal output: P = MC -> 20 = 2 + 0.2Q -> Q = 90\noptimal_q = (market_price - 2) / 0.2\nmax_profit = profit(optimal_q)\n\nprint(\"=== Competitive Firm Profit Maximization ===\")\nprint(f\"Market price: ${market_price}\")\nprint(f\"Optimal quantity: {optimal_q:.0f} units\")\nprint(f\"Total revenue: ${market_price * optimal_q:.0f}\")\nprint(f\"Total cost: ${total_cost(optimal_q):.0f}\")\nprint(f\"Economic profit: ${max_profit:.0f}\")\n\nprint(f\"\\n{'Q':<6} {'TR':<8} {'TC':<8} {'Profit':<8} {'MC':<6} {'P=MR':<6}\")\nprint(\"-\" * 42)\nfor q in range(0, 120, 15):\n    tr = market_price * q\n    tc = total_cost(q)\n    pi = tr - tc\n    mc = marginal_cost(q)\n    print(f\"{q:<6} ${tr:<7.0f} ${tc:<7.0f} ${pi:<7.0f} ${mc:<5.1f} ${market_price}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Long-run adjustment process\nfixed_cost = 50\ndef atc(q):\n    return (50 + 2*q + 0.1*q**2) / q\n\ndef min_atc():\n    # ATC = 50/Q + 2 + 0.1Q, min where dATC/dQ = 0\n    # -50/Q^2 + 0.1 = 0 -> Q = sqrt(500)\n    q_min = (50 / 0.1) ** 0.5\n    return q_min, atc(q_min)\n\nq_efficient, min_cost = min_atc()\nprint(\"=== Long-Run Equilibrium ===\")\nprint(f\"Efficient scale: {q_efficient:.1f} units\")\nprint(f\"Minimum ATC (long-run price): ${min_cost:.2f}\")\nprint(f\"Economic profit in long run: $0\")\nprint(f\"\\nAt this price, each firm produces {q_efficient:.1f} units\")\nprint(f\"Firms enter/exit until market clears at P = ${min_cost:.2f}\")"
        ]
      ]
    }
