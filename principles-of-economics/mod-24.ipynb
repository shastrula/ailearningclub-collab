          "python",
          "import numpy as np\n\n# Prospect Theory value function\ndef prospect_value(x, alpha=0.88, beta=0.88, lambda_loss=2.25):\n    \"\"\"\n    Kahneman-Tversky value function.\n    Gains: v(x) = x^alpha\n    Losses: v(x) = -lambda * |x|^beta\n    \"\"\"\n    if x >= 0:\n        return x ** alpha\n    else:\n        return -lambda_loss * (abs(x) ** beta)\n\n# Compare psychological value of gains vs losses\noutcomes = [-500, -200, -100, -50, 0, 50, 100, 200, 500]\nprint(\"=== Prospect Theory Value Function ===\")\nprint(f\"{'Outcome':<10} {'Psychological Value':<20} {'Ratio to |mirror|':<18}\")\nprint(\"-\" * 48)\nfor x in outcomes:\n    v = prospect_value(x)\n    if x > 0:\n        mirror_v = prospect_value(-x)\n        ratio = abs(v / mirror_v)\n        print(f\"${x:<9} {v:<20.2f} {ratio:<18.2f}\")\n    elif x < 0:\n        mirror_v = prospect_value(-x)\n        ratio = abs(v / mirror_v)\n        print(f\"${x:<9} {v:<20.2f} {ratio:<18.2f}\")\n    else:\n        print(f\"${x:<9} {v:<20.2f} {'---':<18}\")\n\nprint(f\"\\nLoss aversion ratio: ~2.25x (losses hurt 2.25x more than gains please)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
