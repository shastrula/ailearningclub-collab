      "source": [
        [
          "python",
          "# Overconfidence simulation: Stock trading\n# Overconfident traders trade too much, reducing returns through fees\n\ndef simulate_trading(years=20, overconfident=False):\n    \"\"\"Simulate investment returns with and without overconfidence.\"\"\"\n    annual_market_return = 0.08\n    annual_volatility = 0.15\n    trading_cost_per_trade = 0.001  # 0.1% per trade\n    \n    # Overconfident traders trade 50x more than patient investors\n    trades_per_year = 100 if overconfident else 2\n    annual_trading_cost = trades_per_year * trading_cost_per_trade\n    \n    # Overconfident traders also pick worse stocks (overestimate their ability)\n    stock_picking_penalty = 0.02 if overconfident else 0\n    \n    net_return = annual_market_return - annual_trading_cost - stock_picking_penalty\n    portfolio = 10000\n    for _ in range(years):\n        portfolio *= (1 + net_return)\n    \n    return portfolio\n\npatient_result = simulate_trading(overconfident=False)\noverconfident_result = simulate_trading(overconfident=True)\n\nprint(\"=== Overconfidence Cost: 20-Year Investment Simulation ===\")\nprint(f\"Initial investment: $10,000\")\nprint(f\"Market return: 8% annually\")\nprint(f\"\\n{'Investor Type':<20} {'Trades/Year':<14} {'Final Value':<14} {'Annualized':<12}\")\nprint(\"-\" * 60)\nprint(f\"{'Patient':<20} {'2':<14} ${patient_result:>11,.0f}  {((patient_result/10000)**(1/20)-1)*100:.1f}%\")\nprint(f\"{'Overconfident':<20} {'100':<14} ${overconfident_result:>11,.0f}  {((overconfident_result/10000)**(1/20)-1)*100:.1f}%\")\nprint(f\"\\nCost of overconfidence: ${patient_result - overconfident_result:,.0f}\")"
        ]
      ]
    }
