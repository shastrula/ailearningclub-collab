    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# US Federal Budget (approximate, billions)\nrevenue_sources = {\n    'Individual income tax': 2200,\n    'Payroll taxes': 1500,\n    'Corporate income tax': 400,\n    'Excise taxes': 100,\n    'Other': 300,\n}\n\nspending_categories = {\n    'Social Security': 1400,\n    'Medicare/Medicaid': 1600,\n    'Defense': 800,\n    'Interest on debt': 900,\n    'Other mandatory': 600,\n    'Discretionary (non-defense)': 900,\n}\n\ntotal_revenue = sum(revenue_sources.values())\ntotal_spending = sum(spending_categories.values())\ndeficit = total_spending - total_revenue\n\nprint(\"=== Federal Budget Overview (Approximate, Billions) ===\")\nprint(f\"\\n--- Revenue: ${total_revenue:,.0f}B ---\")\nfor source, amount in revenue_sources.items():\n    pct = amount / total_revenue * 100\n    print(f\"  {source:<25} ${amount:>6,}B ({pct:.0f}%)\")\n\nprint(f\"\\n--- Spending: ${total_spending:,.0f}B ---\")\nfor cat, amount in spending_categories.items():\n    pct = amount / total_spending * 100\n    print(f\"  {cat:<25} ${amount:>6,}B ({pct:.0f}%)\")\n\nprint(f\"\\n--- Bottom Line ---\")\nprint(f\"  Deficit: ${deficit:,.0f}B\")\nprint(f\"  Deficit as % of GDP (~$28T): {deficit/28000*100:.1f}%\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Multiplier effect simulation\nmpc = 0.75  # Marginal propensity to consume\ninitial_spending = 100  # $100 billion government spending\n\nmultiplier = 1 / (1 - mpc)\ntotal_effect = initial_spending * multiplier\n\nprint(f\"=== Spending Multiplier ===\")\nprint(f\"MPC = {mpc}, MPS = {1-mpc}\")\nprint(f\"Multiplier = {multiplier:.2f}\")\nprint(f\"Initial spending: ${initial_spending}B\")\nprint(f\"Total GDP effect: ${total_effect:.0f}B\")\n\n# Round-by-round spending\nprint(f\"\\n{'Round':<8} {'New Spending':<15} {'Cumulative':<12}\")\nprint(\"-\" * 35)\ncumulative = 0\nspending = initial_spending\nfor i in range(1, 11):\n    cumulative += spending\n    print(f\"{i:<8} ${spending:<14.1f} ${cumulative:<11.1f}B\")\n    spending *= mpc\n\nprint(f\"...      ...\")\nprint(f\"{'Total':<8} {'':<15} ${total_effect:<11.0f}B\")"
        ]
      ]
    }
