          "python",
          "# Comparative advantage example\n# Hours needed to produce 1 unit:\n#                   Wine    Cloth\n# Portugal          80      90\n# England          120     100\n\nproduction = {\n    'Portugal': {'wine': 80, 'cloth': 90},   # hours per unit\n    'England':  {'wine': 120, 'cloth': 100},\n}\n\nprint(\"=== Absolute vs. Comparative Advantage ===\")\nprint(f\"\\nHours to produce 1 unit:\")\nprint(f\"{'Country':<12} {'Wine':<8} {'Cloth':<8}\")\nprint(\"-\" * 28)\nfor country, goods in production.items():\n    print(f\"{country:<12} {goods['wine']:<8} {goods['cloth']:<8}\")\n\n# Opportunity costs\nprint(f\"\\nOpportunity costs:\")\nprint(f\"{'Country':<12} {'1 Wine (in cloth)':<20} {'1 Cloth (in wine)':<20}\")\nprint(\"-\" * 52)\nfor country, goods in production.items():\n    wine_oc = goods['wine'] / goods['cloth']  # cloth given up per wine\n    cloth_oc = goods['cloth'] / goods['wine']  # wine given up per cloth\n    print(f\"{country:<12} {wine_oc:<20.2f} {cloth_oc:<20.2f}\")\n\n# Portugal: 1 wine costs 80/90 = 0.89 cloth (lower OC for wine)\n# England:  1 wine costs 120/100 = 1.20 cloth\n# Portugal has CA in wine (lower OC)\n# England has CA in cloth (OC = 100/120 = 0.83 wine, vs Portugal's 90/80 = 1.13)\n\nport_wine_oc = production['Portugal']['wine'] / production['Portugal']['cloth']\neng_wine_oc = production['England']['wine'] / production['England']['cloth']\nport_cloth_oc = production['Portugal']['cloth'] / production['Portugal']['wine']\neng_cloth_oc = production['England']['cloth'] / production['England']['wine']\n\nprint(f\"\\nComparative advantage:\")\nprint(f\"  Portugal specializes in: Wine (OC={port_wine_oc:.2f} < {eng_wine_oc:.2f})\")\nprint(f\"  England specializes in:  Cloth (OC={eng_cloth_oc:.2f} < {port_cloth_oc:.2f})\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Gains from trade demonstration\n# Before trade: each country divides 1000 labor hours equally\ntotal_hours = 1000\n\n# Autarky (no trade): each allocates 500 hours to each good\nport_wine_autarky = 500 / production['Portugal']['wine']\nport_cloth_autarky = 500 / production['Portugal']['cloth']\neng_wine_autarky = 500 / production['England']['wine']\neng_cloth_autarky = 500 / production['England']['cloth']\n\nprint(\"=== Without Trade (Autarky) ===\")\nprint(f\"{'Country':<12} {'Wine':<10} {'Cloth':<10}\")\nprint(\"-\" * 32)\nprint(f\"{'Portugal':<12} {port_wine_autarky:<10.2f} {port_cloth_autarky:<10.2f}\")\nprint(f\"{'England':<12} {eng_wine_autarky:<10.2f} {eng_cloth_autarky:<10.2f}\")\ntotal_wine_autarky = port_wine_autarky + eng_wine_autarky\ntotal_cloth_autarky = port_cloth_autarky + eng_cloth_autarky\nprint(f\"{'World Total':<12} {total_wine_autarky:<10.2f} {total_cloth_autarky:<10.2f}\")\n\n# With specialization: Portugal focuses on wine, England on cloth\nport_wine_spec = 800 / production['Portugal']['wine']  # 800 hrs wine\nport_cloth_spec = 200 / production['Portugal']['cloth']  # 200 hrs cloth\neng_wine_spec = 200 / production['England']['wine']     # 200 hrs wine\neng_cloth_spec = 800 / production['England']['cloth']   # 800 hrs cloth\n\nprint(f\"\\n=== With Specialization ===\")\nprint(f\"{'Country':<12} {'Wine':<10} {'Cloth':<10}\")\nprint(\"-\" * 32)\nprint(f\"{'Portugal':<12} {port_wine_spec:<10.2f} {port_cloth_spec:<10.2f}\")\nprint(f\"{'England':<12} {eng_wine_spec:<10.2f} {eng_cloth_spec:<10.2f}\")\ntotal_wine_spec = port_wine_spec + eng_wine_spec\ntotal_cloth_spec = port_cloth_spec + eng_cloth_spec\nprint(f\"{'World Total':<12} {total_wine_spec:<10.2f} {total_cloth_spec:<10.2f}\")\n\nprint(f\"\\n=== Gains from Specialization ===\")\nprint(f\"Extra wine produced: {total_wine_spec - total_wine_autarky:.2f}\")\nprint(f\"Extra cloth produced: {total_cloth_spec - total_cloth_autarky:.2f}\")\nprint(f\"Trade makes both nations better off by expanding total production\")"
        ]
      ]
    }
