      "source": [
        [
          "python",
          "# Cournot duopoly model\n# Market demand: P = 100 - Q (where Q = q1 + q2)\n# Both firms have MC = 10\n\na, mc = 100, 10\n\n# Cournot equilibrium for symmetric firms:\n# q1* = q2* = (a - mc) / 3\ncournot_q = (a - mc) / 3\ncournot_total_q = 2 * cournot_q\ncournot_price = a - cournot_total_q\ncournot_profit = (cournot_price - mc) * cournot_q\n\n# Monopoly outcome (collusion)\nmonopoly_q = (a - mc) / 2  # Total output\nmonopoly_price = a - monopoly_q\nmonopoly_profit_each = (monopoly_price - mc) * (monopoly_q / 2)\n\n# Competitive outcome\ncompetitive_q = a - mc  # Total output\ncompetitive_price = mc\n\nprint(\"=== Cournot Duopoly vs. Alternatives ===\")\nprint(f\"\\n{'Outcome':<15} {'Total Q':<10} {'Price':<8} {'Profit/Firm':<12}\")\nprint(\"-\" * 45)\nprint(f\"{'Monopoly':<15} {monopoly_q:<10.1f} ${monopoly_price:<7.1f} ${monopoly_profit_each:<11.1f}\")\nprint(f\"{'Cournot':<15} {cournot_total_q:<10.1f} ${cournot_price:<7.1f} ${cournot_profit:<11.1f}\")\nprint(f\"{'Competitive':<15} {competitive_q:<10.1f} ${competitive_price:<7.1f} ${'0':<11}\")\n\nprint(f\"\\nCournot produces MORE than monopoly but LESS than competition\")\nprint(f\"Cournot price is LOWER than monopoly but HIGHER than competition\")"
        ]
      ]
    }
