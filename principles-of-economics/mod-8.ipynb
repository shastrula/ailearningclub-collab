      "source": [
        [
          "python",
          "import numpy as np\n\n# Prisoner's Dilemma payoff analysis\npayoffs = {\n    ('High', 'High'): (10, 10),\n    ('High', 'Low'): (2, 12),\n    ('Low', 'High'): (12, 2),\n    ('Low', 'Low'): (5, 5)\n}\n\nprint(\"=== Prisoner's Dilemma: Pricing Game ===\")\nprint(f\"{'Strategy':<20} {'Firm A Profit':<15} {'Firm B Profit':<15} {'Total':<10}\")\nprint(\"-\" * 60)\nfor (sa, sb), (pa, pb) in payoffs.items():\n    print(f\"A:{sa:<6} B:{sb:<6}    ${pa}M{'':<10} ${pb}M{'':<10} ${pa+pb}M\")\n\n# Find dominant strategies\nprint(\"\\n=== Dominant Strategy Analysis ===\")\n# Firm A's best response to B playing High\na_vs_b_high = {'High': payoffs[('High','High')][0], 'Low': payoffs[('Low','High')][0]}\nprint(f\"If B plays High: A prefers {'Low' if a_vs_b_high['Low'] > a_vs_b_high['High'] else 'High'}\")\nprint(f\"  High -> ${a_vs_b_high['High']}M, Low -> ${a_vs_b_high['Low']}M\")\n\n# Firm A's best response to B playing Low\na_vs_b_low = {'High': payoffs[('High','Low')][0], 'Low': payoffs[('Low','Low')][0]}\nprint(f\"If B plays Low: A prefers {'Low' if a_vs_b_low['Low'] > a_vs_b_low['High'] else 'High'}\")\nprint(f\"  High -> ${a_vs_b_low['High']}M, Low -> ${a_vs_b_low['Low']}M\")\n\nprint(f\"\\nNash Equilibrium: (Low, Low) -> ($5M, $5M)\")\nprint(f\"Cooperative optimum: (High, High) -> ($10M, $10M)\")\nprint(f\"Efficiency loss from non-cooperation: ${10+10-5-5}M total\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
