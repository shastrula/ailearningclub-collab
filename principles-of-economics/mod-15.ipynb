          "python",
          "# US labor market statistics (approximate)\npopulation_16plus = 265_000_000\nemployed = 161_000_000\nunemployed = 6_500_000\nnot_in_labor_force = population_16plus - employed - unemployed\n\nlabor_force = employed + unemployed\nunemployment_rate = (unemployed / labor_force) * 100\nparticipation_rate = (labor_force / population_16plus) * 100\nemployment_pop_ratio = (employed / population_16plus) * 100\n\nprint(\"=== US Labor Market (Approximate) ===\")\nprint(f\"Working-age population (16+): {population_16plus:>14,}\")\nprint(f\"Employed:                     {employed:>14,}\")\nprint(f\"Unemployed:                   {unemployed:>14,}\")\nprint(f\"Not in labor force:           {not_in_labor_force:>14,}\")\nprint(f\"Labor force:                  {labor_force:>14,}\")\nprint(f\"\\nUnemployment rate:            {unemployment_rate:>13.1f}%\")\nprint(f\"Participation rate:           {participation_rate:>13.1f}%\")\nprint(f\"Employment-population ratio:  {employment_pop_ratio:>13.1f}%\")\n\n# Alternative measures (U-1 through U-6)\ndiscouraged = 500_000\nmarginally_attached = 1_500_000\npart_time_economic = 4_000_000\n\nu3 = unemployment_rate\nu5 = ((unemployed + marginally_attached) / (labor_force + marginally_attached)) * 100\nu6 = ((unemployed + marginally_attached + part_time_economic) / \n      (labor_force + marginally_attached)) * 100\n\nprint(f\"\\n=== Alternative Measures ===\")\nprint(f\"U-3 (official):              {u3:.1f}%\")\nprint(f\"U-5 (+ marginally attached): {u5:.1f}%\")\nprint(f\"U-6 (+ part-time for econ):  {u6:.1f}%\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Okun's Law: relationship between unemployment and GDP\n# Rule of thumb: 1% above natural rate = 2% below potential GDP\n\nnatural_rate = 4.5\npotential_gdp = 25_000  # billions\n\nscenarios = [\n    (\"Boom\", 3.5),\n    (\"Full employment\", 4.5),\n    (\"Mild recession\", 6.0),\n    (\"Severe recession\", 9.0),\n    (\"Depression\", 12.0),\n]\n\nprint(\"=== Okun's Law: Unemployment and GDP Gap ===\")\nprint(f\"Natural rate: {natural_rate}%, Potential GDP: ${potential_gdp:,}B\")\nprint(f\"\\n{'Scenario':<20} {'Unemp Rate':<12} {'GDP Gap':<10} {'Actual GDP':<12} {'Lost Output'}\")\nprint(\"-\" * 66)\nfor name, rate in scenarios:\n    gap_pct = -2 * (rate - natural_rate)  # Okun's coefficient ~2\n    actual_gdp = potential_gdp * (1 + gap_pct/100)\n    lost = potential_gdp - actual_gdp\n    print(f\"{name:<20} {rate:<12.1f}% {gap_pct:<9.1f}% ${actual_gdp:<11,.0f} ${lost:>10,.0f}B\")"
        ]
      ]
    }
