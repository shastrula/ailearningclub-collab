          "python",
          "import numpy as np\n\n# Exchange rate calculations\nusd_per_eur = 1.10  # 1 EUR costs $1.10\nusd_per_gbp = 1.27  # 1 GBP costs $1.27\nusd_per_jpy = 0.0067  # 1 JPY costs $0.0067\n\nprint(\"=== Exchange Rates (USD base) ===\")\nprint(f\"EUR/USD: {usd_per_eur:.4f} (1 Euro = ${usd_per_eur})\")\nprint(f\"GBP/USD: {usd_per_gbp:.4f} (1 Pound = ${usd_per_gbp})\")\nprint(f\"JPY/USD: {usd_per_jpy:.4f} (1 Yen = ${usd_per_jpy})\")\nprint(f\"USD/JPY: {1/usd_per_jpy:.1f} (1 Dollar = {1/usd_per_jpy:.1f} Yen)\")\n\n# Real exchange rate example\nus_price_level = 100  # index\njapan_price_level = 95\nnominal_rate = 150  # yen per dollar\n\nreal_rate = nominal_rate * (us_price_level / japan_price_level)\nprint(f\"\\n=== Real Exchange Rate ===\")\nprint(f\"Nominal (yen/$): {nominal_rate}\")\nprint(f\"US price level: {us_price_level}\")\nprint(f\"Japan price level: {japan_price_level}\")\nprint(f\"Real rate (yen/$): {real_rate:.1f}\")\nprint(f\"US goods are {'expensive' if real_rate > nominal_rate else 'cheap'} relative to nominal rate\")\n\n# Purchasing Power Parity example\nus_big_mac = 5.50\njapan_big_mac_yen = 450\nppp_rate = japan_big_mac_yen / us_big_mac\nprint(f\"\\n=== Big Mac PPP ===\")\nprint(f\"US Big Mac: ${us_big_mac}\")\nprint(f\"Japan Big Mac: {japan_big_mac_yen} yen\")\nprint(f\"PPP exchange rate: {ppp_rate:.1f} yen/dollar\")\nprint(f\"Actual rate: {nominal_rate} yen/dollar\")\nprint(f\"Yen {'undervalued' if nominal_rate > ppp_rate else 'overvalued'} by {abs(nominal_rate-ppp_rate)/ppp_rate*100:.0f}%\")"
        ]
      ]
    },
    {
