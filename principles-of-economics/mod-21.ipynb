        [
          "python",
          "# Balance of Payments example (US, approximate, billions)\ncurrent_account = {\n    'Goods exports': 1800,\n    'Goods imports': -2800,\n    'Services exports': 900,\n    'Services imports': -600,\n    'Income receipts': 1200,\n    'Income payments': -1000,\n    'Transfers': -150,\n}\n\nca_balance = sum(current_account.values())\n\ncapital_account = {\n    'Foreign investment in US (inflow)': 1200,\n    'US investment abroad (outflow)': -700,\n    'Portfolio and other flows': 200,\n}\n\nka_balance = sum(capital_account.values())\nstatistical_discrepancy = -(ca_balance + ka_balance)\n\nprint(\"=== US Balance of Payments (Approximate, $Billions) ===\")\nprint(f\"\\n--- Current Account ---\")\nfor item, val in current_account.items():\n    print(f\"  {item:<30} ${val:>8,.0f}B\")\nprint(f\"  {'CURRENT ACCOUNT BALANCE':<30} ${ca_balance:>8,.0f}B\")\n\nprint(f\"\\n--- Capital/Financial Account ---\")\nfor item, val in capital_account.items():\n    print(f\"  {item:<35} ${val:>8,.0f}B\")\nprint(f\"  {'CAPITAL ACCOUNT BALANCE':<35} ${ka_balance:>8,.0f}B\")\n\nprint(f\"\\n--- Summary ---\")\nprint(f\"  Statistical discrepancy: ${statistical_discrepancy:,.0f}B\")\nprint(f\"  CA + KA + discrepancy = ${ca_balance + ka_balance + statistical_discrepancy:.0f}\")\nprint(f\"\\n  The US runs a current account deficit financed by capital inflows\")\nprint(f\"  (foreigners invest more in the US than Americans invest abroad)\")"
        ]
      ]
    }
