          "python",
          "# US Money supply (approximate, trillions)\nmoney_supply = {\n    'Currency in circulation': 2.3,\n    'Demand deposits': 5.2,\n    'Other checkable deposits': 0.9,\n}\nm1 = sum(money_supply.values())\n\nm2_additions = {\n    'Savings deposits': 8.5,\n    'Small time deposits': 0.3,\n    'Money market funds': 1.2,\n}\nm2 = m1 + sum(m2_additions.values())\n\nprint(\"=== Money Supply Measures ===\")\nprint(f\"\\n--- M1: ${m1:.1f} Trillion ---\")\nfor item, val in money_supply.items():\n    print(f\"  {item:<30} ${val:.1f}T\")\n\nprint(f\"\\n--- M2: ${m2:.1f} Trillion ---\")\nprint(f\"  M1                            ${m1:.1f}T\")\nfor item, val in m2_additions.items():\n    print(f\"  + {item:<28} ${val:.1f}T\")\n\nprint(f\"\\nM2/M1 ratio: {m2/m1:.1f}x\")\nprint(f\"Most 'money' is digital deposits, not physical currency\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Money creation through fractional reserve banking\nreserve_ratio = 0.10\ninitial_deposit = 1000\n\ntheoretical_multiplier = 1 / reserve_ratio\nmax_money_created = initial_deposit * theoretical_multiplier\n\nprint(f\"=== Money Creation Process ===\")\nprint(f\"Reserve ratio: {reserve_ratio*100:.0f}%\")\nprint(f\"Initial deposit: ${initial_deposit:,.0f}\")\nprint(f\"Theoretical multiplier: {theoretical_multiplier:.0f}\")\nprint(f\"Maximum money created: ${max_money_created:,.0f}\")\n\nprint(f\"\\n{'Round':<7} {'Deposit':<12} {'Reserves':<10} {'Loans':<10} {'Cumulative $'}\")\nprint(\"-\" * 52)\ndeposit = initial_deposit\ncumulative = 0\nfor i in range(1, 11):\n    reserves = deposit * reserve_ratio\n    loans = deposit * (1 - reserve_ratio)\n    cumulative += deposit\n    print(f\"{i:<7} ${deposit:<11,.0f} ${reserves:<9,.0f} ${loans:<9,.0f} ${cumulative:>10,.0f}\")\n    deposit = loans\n\nprint(f\"...\")\nprint(f\"{'Total':<7} {'':<12} {'':<10} {'':<10} ${max_money_created:>10,.0f}\")\n\n# More realistic multiplier with excess reserves and cash drain\nexcess_reserve_ratio = 0.05\ncash_drain_ratio = 0.10\nrealistic_multiplier = 1 / (reserve_ratio + excess_reserve_ratio + cash_drain_ratio)\nrealistic_money = initial_deposit * realistic_multiplier\nprint(f\"\\n=== Realistic Multiplier ===\")\nprint(f\"With {excess_reserve_ratio*100:.0f}% excess reserves and {cash_drain_ratio*100:.0f}% cash drain:\")\nprint(f\"Multiplier: {realistic_multiplier:.1f}\")\nprint(f\"Money created: ${realistic_money:,.0f}\")"
        ]
      ]
    }
  ],
