      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Monopolistic competition - short run with economic profit\n# Firm-specific demand: P = 50 - 0.5Q\n# MR = 50 - Q\n# MC = 10 + 0.2Q\n# FC = 200\n\ndef demand_price(q):\n    return 50 - 0.5 * q\n\ndef marginal_revenue(q):\n    return 50 - q\n\ndef marginal_cost(q):\n    return 10 + 0.2 * q\n\ndef total_cost(q):\n    return 200 + 10 * q + 0.1 * q ** 2\n\ndef atc(q):\n    return total_cost(q) / q if q > 0 else float('inf')\n\n# MR = MC: 50 - Q = 10 + 0.2Q -> 40 = 1.2Q -> Q = 33.33\noptimal_q = 40 / 1.2\noptimal_p = demand_price(optimal_q)\nprofit = optimal_p * optimal_q - total_cost(optimal_q)\n\nprint(\"=== Short-Run Equilibrium (Positive Profit) ===\")\nprint(f\"Quantity: {optimal_q:.1f}\")\nprint(f\"Price: ${optimal_p:.2f}\")\nprint(f\"ATC: ${atc(optimal_q):.2f}\")\nprint(f\"Economic profit: ${profit:.2f}\")\nprint(f\"Profit per unit: ${optimal_p - atc(optimal_q):.2f}\")\nprint(f\"\\nThis profit attracts new entrants...\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Long-run equilibrium: demand tangent to ATC\n# New demand after entry: P = 35 - 0.5Q (shifted left)\n# MR = 35 - Q\n# Same costs: TC = 200 + 10Q + 0.1Q^2\n\ndef demand_lr(q):\n    return 35 - 0.5 * q\n\ndef mr_lr(q):\n    return 35 - q\n\n# MR = MC: 35 - Q = 10 + 0.2Q -> 25 = 1.2Q -> Q = 20.83\nq_lr = 25 / 1.2\np_lr = demand_lr(q_lr)\natc_lr = atc(q_lr)\nprofit_lr = p_lr * q_lr - total_cost(q_lr)\n\nprint(\"=== Long-Run Equilibrium (Zero Profit) ===\")\nprint(f\"Quantity: {q_lr:.1f}\")\nprint(f\"Price: ${p_lr:.2f}\")\nprint(f\"ATC: ${atc_lr:.2f}\")\nprint(f\"Economic profit: ${profit_lr:.2f}\")\nprint(f\"Price = ATC: {abs(p_lr - atc_lr) < 0.5}\")\n\n# Compare to efficient scale\n# Min ATC: dATC/dQ = 0 -> -200/Q^2 + 0.1 = 0 -> Q = sqrt(2000)\nq_efficient = (200 / 0.1) ** 0.5\nprint(f\"\\nEfficient scale (min ATC): Q = {q_efficient:.1f}\")\nprint(f\"Firm produces at Q = {q_lr:.1f} (below efficient scale)\")\nprint(f\"Excess capacity: {q_efficient - q_lr:.1f} units\")"
        ]
      ]
    }
