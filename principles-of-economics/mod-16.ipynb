          "python",
          "import numpy as np\n\n# AD-AS Model simulation\n# AD: Y = 1000 - 50P + demand_shock\n# SRAS: Y = 500 + 30P + supply_shock\n# LRAS: Y = 800 (potential output)\n\npotential_output = 800\n\ndef aggregate_demand(price_level, shock=0):\n    return 1000 - 50 * price_level + shock\n\ndef short_run_as(price_level, shock=0):\n    return 500 + 30 * price_level + shock\n\n# Equilibrium: AD = SRAS\n# 1000 - 50P = 500 + 30P -> 500 = 80P -> P = 6.25\neq_price = 500 / 80\neq_output = aggregate_demand(eq_price)\n\nprint(\"=== AD-AS Equilibrium ===\")\nprint(f\"Potential output (LRAS): {potential_output}\")\nprint(f\"Equilibrium price level: {eq_price:.2f}\")\nprint(f\"Equilibrium output: {eq_output:.0f}\")\nprint(f\"Output gap: {eq_output - potential_output:.0f} ({'above' if eq_output > potential_output else 'below'} potential)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Scenario analysis using AD-AS model\n\ndef find_equilibrium(ad_shock=0, as_shock=0):\n    \"\"\"Find where AD = SRAS with given shocks.\"\"\"\n    # 1000 - 50P + ad_shock = 500 + 30P + as_shock\n    # (500 + ad_shock - as_shock) = 80P\n    price = (500 + ad_shock - as_shock) / 80\n    output = aggregate_demand(price, ad_shock)\n    return price, output\n\nscenarios = [\n    (\"Baseline\", 0, 0),\n    (\"Demand boom (+200)\", 200, 0),\n    (\"Recession (AD -200)\", -200, 0),\n    (\"Oil shock (SRAS -150)\", 0, -150),\n    (\"Tech improvement (SRAS +100)\", 0, 100),\n    (\"Stagflation (AD-100, SRAS-100)\", -100, -100),\n]\n\nprint(\"=== Economic Shock Analysis ===\")\nprint(f\"{'Scenario':<30} {'Price':<8} {'Output':<8} {'Gap':<8} {'Diagnosis'}\")\nprint(\"-\" * 72)\nfor name, ad_s, as_s in scenarios:\n    p, y = find_equilibrium(ad_s, as_s)\n    gap = y - potential_output\n    if gap > 20:\n        diag = \"Inflationary gap\"\n    elif gap < -20:\n        diag = \"Recessionary gap\"\n    else:\n        diag = \"Near potential\"\n    print(f\"{name:<30} {p:<8.2f} {y:<8.0f} {gap:<+8.0f} {diag}\")"
        ]
      ]
    }
