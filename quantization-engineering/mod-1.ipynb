          "python",
          "def evaluate_quantization_tradeoff(model, x_test, y_test):\n    \"\"\"Compare accuracy across precision levels\"\"\"\n    \n    # Original accuracy\n    original_acc = model.evaluate(x_test, y_test, verbose=0)[1]\n    \n    results = {'FP32': original_acc}\n    \n    # FP16\n    fp16_model = convert_to_fp16(model)\n    results['FP16'] = fp16_model.evaluate(x_test, y_test, verbose=0)[1]\n    \n    # INT8\n    int8_model = quantize_to_int8(model, x_test)\n    results['INT8'] = int8_model.evaluate(x_test, y_test, verbose=0)[1]\n    \n    # INT4\n    int4_model = quantize_to_int4(model, x_test)\n    results['INT4'] = int4_model.evaluate(x_test, y_test, verbose=0)[1]\n    \n    return results\n\naccuracy_tradeoffs = evaluate_quantization_tradeoff(model, x_test, y_test)\n\nfor precision, accuracy in accuracy_tradeoffs.items():\n    loss = (accuracy_tradeoffs['FP32'] - accuracy) * 100\n    print(f\"{precision}: {accuracy:.4f} ({loss:.2f}% loss)\")"
        ]
      ]
