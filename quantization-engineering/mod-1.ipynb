      "source": [
        [
          "python",
          "# Quantize a model to 4-bit with bitsandbytes\nfrom transformers import AutoModelForCausalLM, BitsAndBytesConfig\n\nquant_config = BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_compute_dtype=\"float16\")\nmodel = AutoModelForCausalLM.from_pretrained(\"mistralai/Mistral-7B-v0.1\",\n    quantization_config=quant_config, device_map=\"auto\")\nprint(f\"Model loaded in ~4GB instead of ~14GB\")"
        ]
      ]
    }
  ],
