      "source": [
        "# Quantization Engineering - mod-1\n\n",
        "**Course:** quantization-engineering\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Demonstrate quantization\nfp32_value = np.array([0.5, -0.2, 1.5, -1.0], dtype=np.float32)\n\n# Naive INT8: scale to fit range\nint8_value = np.clip(fp32_value * 127, -128, 127).astype(np.int8)\nreconstructed = int8_value.astype(np.float32) / 127\n\nprint(f\"Original: {fp32_value}\")\nprint(f\"INT8: {int8_value}\")\nprint(f\"Reconstructed: {reconstructed}\")\nprint(f\"Error: {np.abs(fp32_value - reconstructed)}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "quantized_value = round((value - min_value) / scale) + zero_point\n\nwhere scale = (max_value - min_value) / (quantized_max - quantized_min)\n      zero_point = -min_value / scale (rounded)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def quantize_linear(values, num_bits=8):\n    \"\"\"Quantize values to num_bits integers\"\"\"\n    min_val = np.min(values)\n    max_val = np.max(values)\n    \n    quantized_min = -(2 ** (num_bits - 1))  # -128 for int8\n    quantized_max = 2 ** (num_bits - 1) - 1  # 127 for int8\n    \n    scale = (max_val - min_val) / (quantized_max - quantized_min)\n    zero_point = -min_val / scale\n    zero_point = np.round(zero_point)\n    \n    # Quantize\n    quantized = np.round((values - min_val) / scale) + zero_point\n    quantized = np.clip(quantized, quantized_min, quantized_max)\n    \n    # Dequantize (reconstruct)\n    dequantized = (quantized - zero_point) * scale + min_val\n    \n    return quantized, dequantized, scale, zero_point\n\n# Example\nweights = np.random.randn(1000)\nquantized, dequantized, scale, zero_point = quantize_linear(weights)\n\nerror = np.mean(np.abs(weights - dequantized))\nprint(f\"Mean quantization error: {error:.6f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import tensorflow as tf\n\n# Post-training quantization\nconverter = tf.lite.TFLiteConverter.from_saved_model('model_path')\nconverter.optimizations = [tf.lite.Optimize.DEFAULT]\n\n# Calibration data\ndef representative_dataset():\n    for _ in range(100):\n        data = np.random.rand(1, 224, 224, 3).astype(np.float32)\n        yield [data]\n\nconverter.representative_dataset = representative_dataset\n\n# Full integer quantization (weights and activations)\nconverter.target_spec.supported_ops = [\n    tf.lite.OpsSet.TFLITE_BUILTINS_INT8\n]\nconverter.inference_input_type = tf.int8\nconverter.inference_output_type = tf.int8\n\nquantized_tflite = converter.convert()\n\nwith open('model_quantized.tflite', 'wb') as f:\n    f.write(quantized_tflite)"
        ]
      ]
    },
    {
