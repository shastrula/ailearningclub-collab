      "source": [
        [
          "python",
          "class MixedPrecisionModel(tf.keras.Model):\n    def __init__(self):\n        super().__init__()\n        # Early layers are sensitive to quantization\n        self.dense1 = tf.keras.layers.Dense(128, activation='relu')\n        \n        # Middle layers can be INT8\n        self.dense2 = tf.keras.layers.Dense(128, activation='relu')\n        self.quantizer = tf.keras.layers.Quantization()\n        \n        # Output layer stays FP32\n        self.dense3 = tf.keras.layers.Dense(10, activation='softmax')\n    \n    def call(self, x):\n        x = self.dense1(x)  # FP32\n        x = self.dense2(x)  # FP32\n        x = self.quantizer(x)  # Quantize to INT8\n        x = self.dense3(x)  # FP32\n        return x"
        ]
      ]
    },
