      "outputs": [],
      "source": [
        [
          "python",
          "# Prompt engineering techniques\ndef create_prompt(task, context=\"\", examples=None):\n    \"\"\"Build a structured prompt with best practices.\"\"\"\n    prompt_parts = []\n    \n    # System context\n    prompt_parts.append(f\"You are an expert assistant. {context}\")\n    \n    # Few-shot examples\n    if examples:\n        prompt_parts.append(\"\\nExamples:\")\n        for inp, out in examples:\n            prompt_parts.append(f\"Input: {inp}\\nOutput: {out}\")\n    \n    # Task\n    prompt_parts.append(f\"\\nTask: {task}\")\n    prompt_parts.append(\"\\nProvide a clear, concise response.\")\n    \n    return \"\\n\".join(prompt_parts)\n\n# Example: sentiment analysis prompt\nprompt = create_prompt(\n    task=\"Classify the sentiment of: 'This product exceeded my expectations!'\",\n    context=\"You specialize in sentiment analysis.\",\n    examples=[\n        (\"I love this!\", \"Positive\"),\n        (\"Terrible experience.\", \"Negative\"),\n    ]\n)\nprint(prompt)"
        ]
      ]
    }
  ],
