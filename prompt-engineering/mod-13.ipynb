        "# Prompt Engineering - mod-13\n\n",
        "**Course:** prompt-engineering\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "eval_set = [\n    {\"input\": \"I love this!\", \"expected\": \"positive\"},\n    {\"input\": \"Worst ever.\", \"expected\": \"negative\"},\n    {\"input\": \"It arrived Tuesday.\", \"expected\": \"neutral\"},\n    {\"input\": \"Great quality but overpriced.\", \"expected\": \"mixed\"},\n    {\"input\": \"\", \"expected\": \"neutral\"},  # edge case\n]\n\ndef evaluate(prompt_template, eval_set):\n    correct = 0\n    for case in eval_set:\n        result = ask(prompt_template.format(text=case[\"input\"])).strip().lower()\n        if case[\"expected\"] in result:\n            correct += 1\n        else:\n            print(f\"  FAIL: '{case['input']}' -> '{result}' (expected '{case['expected']}')\")\n    print(f\"Accuracy: {correct}/{len(eval_set)} = {correct/len(eval_set):.0%}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import random\n\nVARIANTS = {\n    \"v1\": \"Classify as positive/negative/neutral: {text}\",\n    \"v2\": '''Examples: \"Great!\"->positive, \"Bad\"->negative, \"OK\"->neutral\nNow classify: \"{text}\" ->'''\n}\n\ndef ab_test(text):\n    variant = random.choice(list(VARIANTS.keys()))\n    result = ask(VARIANTS[variant].format(text=text))\n    log(variant=variant, result=result)  # track for analysis\n    return result"
        ]
      ]
    }
