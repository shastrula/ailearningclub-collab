        [
          "python",
          "def regression_test(prompt_version, test_suite, baseline_scores):\n    \"\"\"\n    Test new prompt version against baseline performance.\n    Fails if performance degrades significantly.\n    \"\"\"\n    current_scores = []\n    \n    for test_case in test_suite:\n        response = model.generate(prompt=prompt_version + \"\\n\\n\" + test_case['input'])\n        score = evaluate_response(response, test_case['reference'])\n        current_scores.append(score)\n    \n    current_avg = sum(current_scores) / len(current_scores)\n    baseline_avg = sum(baseline_scores) / len(baseline_scores)\n    \n    regression_percent = ((baseline_avg - current_avg) / baseline_avg) * 100\n    \n    print(f\"Baseline: {baseline_avg:.4f}\")\n    print(f\"Current: {current_avg:.4f}\")\n    print(f\"Regression: {regression_percent:.1f}%\")\n    \n    if regression_percent > 5:  # Threshold: fail if >5% degradation\n        print(\"\u274c REGRESSION DETECTED: Performance degraded significantly\")\n        return False\n    elif regression_percent > 1:\n        print(\"\u26a0\ufe0f  Minor regression detected, review carefully\")\n        return True\n    else:\n        print(\"\u2713 No significant regression\")\n        return True"
        ]
      ]
    },
