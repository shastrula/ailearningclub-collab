        [
          "python",
          "def analyze_failures(test_cases, results, error_threshold=3.0):\n    \"\"\"Identify patterns in failed test cases.\"\"\"\n    failures = []\n    \n    for test_case, result in zip(test_cases, results):\n        if result['score'] < error_threshold:\n            failures.append({\n                'input': test_case['input'],\n                'response': result['response'],\n                'expected': test_case['reference'],\n                'score': result['score'],\n                'error_type': classify_error(result, test_case)\n            })\n    \n    # Categorize errors\n    error_categories = {}\n    for failure in failures:\n        error_type = failure['error_type']\n        error_categories[error_type] = error_categories.get(error_type, 0) + 1\n    \n    print(f\"Total failures: {len(failures)}\")\n    print(\"Error breakdown:\")\n    for error_type, count in error_categories.items():\n        print(f\"  {error_type}: {count}\")\n    \n    return failures\n\n# Common error types to classify:\n# - Hallucination: Model invents information not in source\n# - Omission: Important information missing\n# - Inaccuracy: Incorrect interpretation of source\n# - Irrelevance: Answer doesn't address question\n# - Length: Output too long/short"
        ]
      ]
