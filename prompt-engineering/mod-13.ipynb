          "python",
          "import json\n\ndef version_prompt(prompt_text, version, changes, metrics):\n    \"\"\"Save prompt with metadata.\"\"\"\n    prompt_metadata = {\n        'version': version,\n        'timestamp': datetime.now().isoformat(),\n        'prompt': prompt_text,\n        'changes': changes,\n        'metrics': {\n            'accuracy': metrics['accuracy'],\n            'clarity': metrics['clarity'],\n            'completeness': metrics['completeness']\n        },\n        'notes': 'Any evaluation notes'\n    }\n    \n    # Save to file\n    filename = f'prompts/summarization_v{version}.json'\n    with open(filename, 'w') as f:\n        json.dump(prompt_metadata, f, indent=2)\n    \n    return filename\n\n# Usage:\nversion_prompt(\n    prompt_text=\"\"\"You are a summary expert. Summarize concisely...\"\"\",\n    version=2,\n    changes=[\n        'Added \"concisely\" to emphasize brevity',\n        'Removed instruction about preserving examples'\n    ],\n    metrics={'accuracy': 0.92, 'clarity': 0.88, 'completeness': 0.85}\n)"
        ]
      ]
    },
    {
