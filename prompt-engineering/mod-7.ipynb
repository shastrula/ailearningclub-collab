      "source": [
        "# Prompt Engineering - mod-7\n\n",
        "**Course:** prompt-engineering\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def classify_email(text, categories):\n    prompt = f'''Classify this email into one of: {\", \".join(categories)}\n    \nEmail: \"\"\"{text}\"\"\"\n\nReturn ONLY the category name.'''\n    return ask(prompt)\n\nresult = classify_email(\n    \"Your order #4521 has shipped\",\n    [\"shipping\", \"billing\", \"support\", \"spam\"]\n)  # -> \"shipping\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from jinja2 import Template\n\ntpl = Template('''You are a {{role}} assistant.\n{% if context %}Context: {{context}}{% endif %}\n\nTask: {{task}}\n\n{% if constraints %}\nRules:\n{% for c in constraints %}- {{c}}\n{% endfor %}{% endif %}''')\n\nprompt = tpl.render(\n    role=\"customer support\",\n    context=\"Customer waiting 5 days for delivery\",\n    task=\"Write an apology with a solution\",\n    constraints=[\"Max 3 sentences\", \"Offer 10% discount\", \"Be empathetic\"]\n)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# prompts.yaml\nclassify_v2:\n  model: gpt-4o-mini\n  temperature: 0.1\n  system: \"Output ONE word only.\"\n  template: \"Classify sentiment of: {text}\\nOptions: positive, negative, neutral\"\n  version: 2\n  updated: 2025-06-14"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import yaml\nPROMPTS = yaml.safe_load(open(\"prompts.yaml\"))\n\ndef run_prompt(name, **kwargs):\n    cfg = PROMPTS[name]\n    return ask(cfg[\"template\"].format(**kwargs), model=cfg[\"model\"])"
        ]
      ]
    }
  ],
