      "source": [
        [
          "python",
          "from openai import OpenAI\nimport json\n\nclient = OpenAI()\n\nresponse = client.chat.completions.create(\n    model=\"gpt-4o-mini\",\n    messages=[{\"role\": \"user\", \"content\": '''Extract from this email and return ONLY valid JSON:\nEmail: \"Hi, the Q3 meeting is moved to Thursday 3pm. Bring regional numbers. - Sarah (VP Sales)\"\nFormat: {\"sender\": str, \"role\": str, \"topic\": str, \"time\": str, \"action\": str}'''}],\n    response_format={\"type\": \"json_object\"}  # guarantees valid JSON\n)\ndata = json.loads(response.choices[0].message.content)\nprint(data[\"sender\"])  # \"Sarah\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from pydantic import BaseModel\nfrom openai import OpenAI\n\nclass ContactInfo(BaseModel):\n    name: str\n    email: str | None\n    phone: str | None\n    company: str | None\n\nclient = OpenAI()\nresponse = client.beta.chat.completions.parse(\n    model=\"gpt-4o-mini\",\n    messages=[\n        {\"role\": \"system\", \"content\": \"Extract contact information.\"},\n        {\"role\": \"user\", \"content\": \"Call Jake at 555-0123. He works at Acme Corp. jake@acme.com\"}\n    ],\n    response_format=ContactInfo\n)\ncontact = response.choices[0].message.parsed\nprint(f\"{contact.name} at {contact.company}\")"
        ]
      ]
    },
