        "# Prompt Engineering - mod-15\n\n",
        "**Course:** prompt-engineering\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import hashlib, json, redis\ncache = redis.Redis()\n\ndef cached_ask(prompt, model=\"gpt-4o-mini\", ttl=3600):\n    key = hashlib.md5(f\"{model}:{prompt}\".encode()).hexdigest()\n    cached = cache.get(key)\n    if cached:\n        return json.loads(cached)\n    \n    response = client.chat.completions.create(\n        model=model, messages=[{\"role\": \"user\", \"content\": prompt}])\n    result = response.choices[0].message.content\n    cache.setex(key, ttl, json.dumps(result))\n    return result"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def smart_route(prompt):\n    '''Route to cheapest model that handles the task.'''\n    if len(prompt) < 200 and \"classify\" in prompt.lower():\n        return \"gpt-4o-mini\"   # $0.15/1M tokens\n    elif \"analyze\" in prompt.lower() or len(prompt) > 2000:\n        return \"gpt-4o\"        # $2.50/1M tokens\n    return \"gpt-4o-mini\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "async def ask_with_fallback(prompt):\n    for model in [\"gpt-4o-mini\", \"claude-sonnet-4-20250514\", \"gpt-4o\"]:\n        try:\n            return await ask_async(prompt, model=model)\n        except Exception as e:\n            print(f\"{model} failed: {e}\")\n    return \"Service unavailable.\""
        ]
      ]
    },
    {
