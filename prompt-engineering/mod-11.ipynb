      "source": [
        "# Prompt Engineering - mod-11\n\n",
        "**Course:** prompt-engineering\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "messages = [\n    {\"role\": \"system\", \"content\": \"You are a Python tutor.\"},\n    {\"role\": \"user\", \"content\": \"What is a decorator?\"},\n    {\"role\": \"assistant\", \"content\": \"A decorator wraps a function to add behavior...\"},\n    {\"role\": \"user\", \"content\": \"Show me an example\"},  # knows we mean decorators\n]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def trim_context(messages, max_chars=12000):\n    system = [m for m in messages if m[\"role\"] == \"system\"]\n    history = [m for m in messages if m[\"role\"] != \"system\"]\n    \n    # Keep recent messages within budget\n    total = sum(len(m[\"content\"]) for m in system)\n    kept = []\n    for msg in reversed(history):\n        total += len(msg[\"content\"])\n        if total > max_chars:\n            break\n        kept.insert(0, msg)\n    return system + kept"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def summarize_old_messages(messages):\n    old = messages[1:-4]  # keep system + last 4\n    if not old:\n        return messages\n    \n    summary = ask(\"Summarize this conversation in 2 sentences, keeping key facts:\\n\" +\n                  \"\\n\".join(f\"{m['role']}: {m['content']}\" for m in old))\n    \n    return [messages[0],\n            {\"role\": \"system\", \"content\": f\"Previous context: {summary}\"},\n            *messages[-4:]]"
        ]
      ]
    }
  ],
