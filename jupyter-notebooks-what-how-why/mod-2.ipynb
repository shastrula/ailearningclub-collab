  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Jupyter Notebooks What How Why - mod-2\n\n",
        "**Course:** jupyter-notebooks-what-how-why\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "pip install jupyterlab"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "conda install jupyterlab"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# pip approach\npython -m venv jupyter_env\nsource jupyter_env/bin/activate\npip install jupyterlab ipython numpy pandas scikit-learn\n\n# conda approach\nconda create -n jupyter_env jupyterlab ipython numpy pandas scikit-learn\nconda activate jupyter_env\n\n# Both approaches work; conda is more robust for complex dependencies"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Start JupyterLab (recommended)\njupyter lab\n\n# Or classic notebook\njupyter notebook"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "jupyter lab --port 8889"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# On remote server\njupyter lab --ip 0.0.0.0 --port 8888\n\n# On local machine, SSH tunnel to remote\n# ssh -L 8888:localhost:8888 remote_user@remote_server\n# Then open http://localhost:8888 in your browser"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "pip install jupyter_contrib_nbextensions\njupyter contrib nbextension install --user"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Example: code that benefits from Autopep8 formatting\nx=1\ny=2\nz=x+y\nresult=[i**2 for i in range(10) if i%2==0]\n# After Autopep8: automatically becomes clean"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Generate default configuration\njupyter lab --generate-config\n\n# Edit configuration\nnano ~/.jupyter/jupyter_lab_config.py"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# ~/.jupyter/jupyter_lab_config.py\n\n# Default port\nc.ServerApp.port = 8888\n\n# Auto-open browser (or disable)\nc.ServerApp.open_browser = False\n\n# Allow root access (risky, not recommended)\nc.ServerApp.allow_root = False\n\n# Token/password (for security)\nc.ServerApp.token = 'your_secure_token'"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "pip install jupyterlab-dracula-theme\n# Then enable via Settings \u2192 Theme"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Python kernel (default, already installed)\npython -m ipykernel install --user\n\n# R kernel\n# First, install R, then in R:\n# install.packages('IRkernel')\n# IRkernel::installspec()\n\n# Julia kernel\n# First, install Julia, then in Julia:\n# using Pkg\n# Pkg.add(\"IJulia\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# List installed kernels\njupyter kernelspec list\n\n# Remove a kernel\njupyter kernelspec remove python3\n\n# Install a kernel for a specific environment\nsource my_env/bin/activate\npython -m ipykernel install --user --name my_env --display-name \"Python (my_env)\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Detect which kernel is running\nimport sys\nprint(f\"Python executable: {sys.executable}\")\nprint(f\"Kernel location: {sys.prefix}\")\n# This tells you which environment is being used"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "pip install jupyter_contrib_nbextensions\njupyter contrib nbextension install --user\n# Then open http://localhost:8888/nbextensions"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Some JupyterLab extensions via npm\n# jupyter labextension install @jupyter-widgets/jupyterlab-manager\n\n# Others via pip (easier)\npip install jupyterlab-git\npip install jupyterlab-code-formatter"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "pip install nbdime\nnbdime config-git --enable\n# Improves git diffs for notebooks"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "my_project/\n\u251c\u2500\u2500 notebooks/\n\u2502   \u251c\u2500\u2500 01_data_exploration.ipynb\n\u2502   \u251c\u2500\u2500 02_model_training.ipynb\n\u2502   \u2514\u2500\u2500 03_evaluation.ipynb\n\u251c\u2500\u2500 data/\n\u2502   \u251c\u2500\u2500 raw/\n\u2502   \u2514\u2500\u2500 processed/\n\u251c\u2500\u2500 scripts/\n\u2502   \u2514\u2500\u2500 preprocessing.py\n\u251c\u2500\u2500 models/\n\u2502   \u2514\u2500\u2500 trained_model.pkl\n\u2514\u2500\u2500 requirements.txt"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# In notebook\nimport sys\nsys.path.insert(0, '../scripts')\nfrom preprocessing import clean_data\n\ndata = clean_data(raw_data)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Convert notebook to HTML\njupyter nbconvert notebook.ipynb --to html\n\n# Convert to PDF\njupyter nbconvert notebook.ipynb --to pdf\n\n# Convert to Markdown\njupyter nbconvert notebook.ipynb --to markdown"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create project directory\nmkdir my_ml_project\ncd my_ml_project\n\n# Create virtual environment\npython -m venv env\nsource env/bin/activate  # or `env\\Scripts\\activate` on Windows\n\n# Install essential packages\npip install jupyterlab ipython numpy pandas scikit-learn matplotlib seaborn\npip install jupyter_contrib_nbextensions\npip install nbdime\n\n# Install Jupyter extensions\njupyter contrib nbextension install --user\nnbdime config-git --enable\n\n# Create project structure\nmkdir -p notebooks data/raw data/processed scripts models output\n\n# Launch JupyterLab\njupyter lab"
        ]
      ]
    }
