      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Demonstrate kernel state persistence\nx = 5\nprint(f\"x is {x}\")\n\n# In a separate cell:\n# y = x * 2\n# print(f\"y is {y}\")  # This works\u2014x persists from the first cell\n\n# Timing cell execution\nimport time\n%time result = sum(range(1000000))\n\n# Display kernel/Python info\nimport sys\nimport os\nprint(f\"Python: {sys.version}\")\nprint(f\"Kernel: {sys.executable}\")\nprint(f\"Current directory: {os.getcwd()}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Code cell example: data analysis\nimport pandas as pd\nimport numpy as np\n\ndata = pd.DataFrame({\n    'group': ['A', 'B', 'A', 'B', 'A'],\n    'value': [10, 20, 15, 25, 12]\n})\n\nresult = data.groupby('group')['value'].mean()\nprint(result)\n\n# Next cell (markdown):\n# ## Analysis Results\n# The mean values are:\n# - Group A: 12.33\n# - Group B: 22.50"
        ]
      ]
    },
