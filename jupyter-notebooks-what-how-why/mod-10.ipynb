      "source": [
        [
          "python",
          "# Jupyter Notebook productivity tips\n\n# Magic commands (run in Jupyter)\n# %timeit sum(range(1000))       # Time a line\n# %%timeit                        # Time a cell\n# %who                            # List variables\n# %history                        # Command history\n# %matplotlib inline              # Show plots inline\n\n# Rich display\nfrom IPython.display import display, HTML, Markdown\n\n# Display formatted content\ndisplay(Markdown(\"## Hello from **Markdown**!\"))\ndisplay(HTML(\"<b style='color:blue'>Styled HTML output</b>\"))\n\n# Progress bar for long operations\nfrom tqdm.notebook import tqdm\nimport time\n\nresults = []\nfor i in tqdm(range(100), desc=\"Processing\"):\n    time.sleep(0.01)  # simulate work\n    results.append(i ** 2)\n\nprint(f\"Processed {len(results)} items\")\n\n# Cell execution info\nimport datetime\nprint(f\"Cell executed at: {datetime.datetime.now().strftime('%H:%M:%S')}\")"
        ]
      ]
    }
