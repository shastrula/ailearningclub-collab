{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Git Github - mod-3\n\n",
        "**Course:** git-github\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "mkdir my-project && cd my-project\ngit init\n# Initialized empty Git repository in .../my-project/.git/"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git clone https://github.com/user/repo.git\ngit clone git@github.com:user/repo.git   # via SSH"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git status"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "On branch main\nNo commits yet\nUntracked files:\n  (use \"git add <file>...\" to include in what will be committed)\n        app.py\n        README.md"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git status -s\n# ?? app.py        (untracked)\n# A  README.md     (staged, added)\n#  M config.yml    (modified, not staged)\n# M  main.py       (modified and staged)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Stage a specific file\ngit add app.py\n\n# Stage multiple files\ngit add app.py README.md\n\n# Stage everything changed in the current directory and below\ngit add .\n\n# Stage all changes in the whole repo (including deletions)\ngit add -A\n\n# Interactively choose hunks within a file\ngit add -p"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git commit -m \"Add user login endpoint\"\n\n# Stage all tracked, modified files AND commit in one step\ngit commit -am \"Fix null pointer in parser\"\n\n# Open your editor to write a longer, multi-line message\ngit commit"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Add rate limiting to the login endpoint\n\nLogin was vulnerable to brute-force attempts. This adds a\ntoken-bucket limiter of 5 attempts per minute per IP.\n\nCloses #142"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Unstaged changes (working dir vs staging)\ngit diff\n\n# Staged changes (staging vs last commit)\ngit diff --staged     # (or --cached)\n\n# Everything since last commit\ngit diff HEAD"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git log                          # full history\ngit log --oneline                # one line per commit\ngit log --oneline --graph --all  # visual branch graph\ngit log -p                       # show the diff of each commit\ngit log --stat                   # files changed per commit\ngit log --author=\"Ada\"           # filter by author\ngit log --since=\"2 weeks ago\"    # filter by date\ngit log -- path/to/file.py       # history of one file"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Remove a file from the working dir AND stage the removal\ngit rm old_file.py\n\n# Stop tracking a file but keep it on disk\ngit rm --cached secrets.env\n\n# Move / rename (Git detects renames automatically too)\ngit mv old_name.py new_name.py"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Unstage a file (keep the changes)\ngit restore --staged app.py       # modern\ngit reset HEAD app.py             # older syntax\n\n# Discard changes in the working directory (DANGER: unrecoverable)\ngit restore app.py                # modern\ngit checkout -- app.py            # older syntax\n\n# Amend the most recent commit (fix message or add forgotten files)\ngit commit --amend"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git init\necho \"# My Project\" > README.md\ngit add README.md\ngit commit -m \"Initial commit\"\n\necho \"print('hello')\" > app.py\ngit status              # app.py is untracked\ngit add app.py\ngit commit -m \"Add hello world script\"\n\ngit log --oneline       # see your two commits"
        ]
      ]
    }
  ],
