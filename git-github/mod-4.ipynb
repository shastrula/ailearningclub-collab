{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Git Github - mod-4\n\n",
        "**Course:** git-github\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "main\n          |\n  A \u2190 B \u2190 C\n          |\n     feature-login   (new branch points to the same commit C)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create a branch\ngit branch feature-login\n\n# Switch to it\ngit switch feature-login       # modern\ngit checkout feature-login     # older syntax\n\n# Create AND switch in one step\ngit switch -c feature-login    # modern\ngit checkout -b feature-login  # older syntax\n\n# List branches (* marks current)\ngit branch\ngit branch -a                  # include remote branches"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git switch -c feature-login\n# ... edit files ...\ngit add .\ngit commit -m \"Add login form\"\n# ... more edits ...\ngit commit -am \"Validate credentials\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "A \u2190 B \u2190 C          (main)\n           \\\n            D \u2190 E    (feature-login, HEAD)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git switch main\ngit merge feature-login"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Before:  A \u2190 B \u2190 C (main) \u2190 D \u2190 E (feature)\nAfter:   A \u2190 B \u2190 C \u2190 D \u2190 E (main, feature)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "A \u2190 B \u2190 C \u2190 F        (main got commit F)\n           \\      \\\n            D \u2190 E \u2190 M   (M = merge commit)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git merge feature-login\n# Creates merge commit M automatically (opens editor for message)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git merge feature-login\n# CONFLICT (content): Merge conflict in app.py\n# Automatic merge failed; fix conflicts and then commit the result."
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "<<<<<<< HEAD\ntimeout = 30        # your current branch's version\n=======\ntimeout = 60        # the incoming branch's version\n>>>>>>> feature-login"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# See which files are conflicted\ngit status\n\n# Abort the merge and go back to before it started\ngit merge --abort\n\n# Use a visual merge tool\ngit mergetool"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Delete a merged branch\ngit branch -d feature-login\n\n# Force-delete an unmerged branch (loses its unique commits)\ngit branch -D experiment"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git switch feature-login\ngit rebase main"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Before:  A \u2190 B \u2190 C \u2190 F      (main)\n              \\\n               D \u2190 E         (feature)\n\nAfter:   A \u2190 B \u2190 C \u2190 F \u2190 D' \u2190 E'   (feature, replayed on top of main)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git rebase -i HEAD~3"
        ]
      ]
    }
  ],
