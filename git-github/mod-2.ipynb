{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Git Github - mod-2\n\n",
        "**Course:** git-github\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Option 1: Homebrew (recommended)\nbrew install git\n\n# Option 2: Xcode Command Line Tools\nxcode-select --install\n\n# Verify\ngit --version"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Verify in Git Bash or PowerShell\ngit --version"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Debian / Ubuntu\nsudo apt update && sudo apt install git\n\n# Fedora\nsudo dnf install git\n\n# Arch\nsudo pacman -S git\n\n# Verify\ngit --version"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git config --global user.name \"Ada Lovelace\"\ngit config --global user.email \"ada@example.com\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git config --global init.defaultBranch main"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# VS Code (wait for the window to close before continuing)\ngit config --global core.editor \"code --wait\"\n\n# Vim\ngit config --global core.editor \"vim\"\n\n# Nano\ngit config --global core.editor \"nano\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# macOS / Linux\ngit config --global core.autocrlf input\n\n# Windows\ngit config --global core.autocrlf true"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# List all settings and where they come from\ngit config --list --show-origin\n\n# Check a single value\ngit config user.name\n\n# Edit the global config directly\ngit config --global --edit"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git config --global alias.st status\ngit config --global alias.co checkout\ngit config --global alias.br branch\ngit config --global alias.ci commit\ngit config --global alias.last \"log -1 HEAD\"\ngit config --global alias.lg \"log --oneline --graph --decorate --all\"\n\n# Now you can run:\ngit st        # instead of git status\ngit lg        # a pretty commit graph"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Generate a modern Ed25519 key\nssh-keygen -t ed25519 -C \"ada@example.com\"\n# Press Enter to accept the default location (~/.ssh/id_ed25519)\n# Optionally set a passphrase\n\n# Start the ssh-agent and add your key\neval \"$(ssh-agent -s)\"\nssh-add ~/.ssh/id_ed25519\n\n# Copy the PUBLIC key to add to your host\ncat ~/.ssh/id_ed25519.pub"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "ssh -T git@github.com    # GitHub\nssh -T git@gitlab.com    # GitLab\nssh -T git@bitbucket.org # Bitbucket"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# SSH-based signing (simplest, reuses your SSH key)\ngit config --global gpg.format ssh\ngit config --global user.signingkey ~/.ssh/id_ed25519.pub\ngit config --global commit.gpgsign true"
        ]
      ]
    }
  ],
