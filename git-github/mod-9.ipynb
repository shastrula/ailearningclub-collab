{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Git Github - mod-9\n\n",
        "**Course:** git-github\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Discard changes to a tracked file (unrecoverable!)\ngit restore app.py\n\n# Discard ALL unstaged changes\ngit restore .\n\n# Unstage a file but keep the edits\ngit restore --staged app.py\n\n# Remove untracked files/dirs (dry run first!)\ngit clean -n        # preview what would be deleted\ngit clean -fd       # actually delete untracked files and dirs"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Fix the message, or add a forgotten file to the previous commit\ngit add forgotten_file.py\ngit commit --amend -m \"Correct message\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Undo last commit, keep the changes staged\ngit reset --soft HEAD~1\n\n# Undo last commit, keep changes but unstaged (default)\ngit reset HEAD~1\n\n# Nuke last commit AND its changes \u2014 irreversible for uncommitted work\ngit reset --hard HEAD~1"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Undo a specific commit by adding an inverse commit\ngit revert a1b2c3d\n\n# Revert a merge commit (specify the mainline parent)\ngit revert -m 1 <merge-commit>"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git reflog\n# a1b2c3d HEAD@{0}: reset: moving to HEAD~1\n# e4f5g6h HEAD@{1}: commit: The work I thought I lost\n# ...\n\n# Recover: point a branch back at the lost commit\ngit reset --hard e4f5g6h\n# or create a new branch from it\ngit branch recovered e4f5g6h"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git rebase -i HEAD~4"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "pick a1b2c3d Add feature\nsquash e4f5g6h Fix typo\nsquash 7h8i9j0 Fix another typo\nreword k1l2m3n Update docs"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git cherry-pick a1b2c3d"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Modern tool (install git-filter-repo)\ngit filter-repo --path secrets.env --invert-paths"
        ]
      ]
    }
  ],
