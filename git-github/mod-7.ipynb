        [
          "bash",
          "# On the server: create a bare repo (no working directory)\ngit init --bare /srv/git/myproject.git\n\n# On your machine: add it as a remote and push\ngit remote add origin user@server.example.com:/srv/git/myproject.git\ngit push -u origin main"
        ]
