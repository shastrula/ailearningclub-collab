          "bash",
          "git remote add origin  git@github.com:you/repo.git\ngit remote add gitlab  git@gitlab.com:you/repo.git\n\ngit push origin main\ngit push gitlab main\n\n# Or configure one remote to push to multiple URLs:\ngit remote set-url --add --push origin git@github.com:you/repo.git\ngit remote set-url --add --push origin git@gitlab.com:you/repo.git\n# Now a single `git push origin main` pushes to both"
