      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Install: brew install gh  (or see cli.github.com)\ngh auth login\n\n# Create a PR from your current branch\ngh pr create --title \"Add search\" --body \"Implements #142\"\n\n# List, view, check out, and merge PRs\ngh pr list\ngh pr view 15\ngh pr checkout 15\ngh pr merge 15 --squash\n\n# Create an issue\ngh issue create --title \"Login is slow\" --body \"Takes 5s\""
        ]
      ]
    },
