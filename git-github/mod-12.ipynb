{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Git Github - mod-12\n\n",
        "**Course:** git-github\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create the feature branch from where you are (keeps the commits)\ngit branch feature/x\n\n# Move main back to before those commits\ngit switch main\ngit reset --hard origin/main   # or HEAD~N\n\n# Your work is safe on feature/x\ngit switch feature/x"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Safe for shared history \u2014 adds an inverse commit\ngit revert <bad-commit-sha>\ngit push"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git rebase -i origin/main\n# mark commits as squash/fixup/reword, save\ngit push --force-with-lease    # safe force on YOUR feature branch"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git pull --rebase\n# CONFLICT in app.py\n# 1. Open app.py, resolve between <<<<<<< and >>>>>>> markers\n# 2. Stage the resolved file\ngit add app.py\n# 3. Continue the rebase\ngit rebase --continue\n# (or bail out entirely)\ngit rebase --abort"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git reflog                      # find the branch tip commit\ngit branch recovered <sha>      # recreate it"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# 1. Remove from all history\ngit filter-repo --path .env --invert-paths\n# 2. Force-push the rewritten history (coordinate with team!)\ngit push --force\n# 3. ROTATE the secret immediately \u2014 assume it's compromised"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git cherry-pick <fix-commit-sha>"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git bisect start\ngit bisect bad\ngit bisect good v2.1.0\ngit bisect run pytest      # auto-finds the culprit\ngit bisect reset"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Morning: sync\ngit switch main && git pull --rebase\n\n# Start a task\ngit switch -c feature/JIRA-231-export-csv\n\n# Work in small, meaningful commits\ngit add -p\ngit commit -m \"feat: add CSV export service\"\ngit commit -m \"test: cover CSV export edge cases\"\n\n# Keep current with main\ngit fetch origin && git rebase origin/main\n\n# Share\ngit push -u origin feature/JIRA-231-export-csv\ngh pr create --fill\n\n# After review + green CI: squash-merge on the host\n# Clean up\ngit switch main && git pull --rebase\ngit branch -d feature/JIRA-231-export-csv"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Setup:     git init | git clone <url> | git config\n# Stage:     git add <f> | git add -p | git restore --staged <f>\n# Commit:    git commit -m | git commit --amend\n# Inspect:   git status | git diff | git log --oneline --graph\n# Branch:    git switch -c <b> | git merge <b> | git rebase <b>\n# Remote:    git push -u origin <b> | git pull --rebase | git fetch\n# Undo:      git restore <f> | git reset --soft/mixed/hard | git revert <sha>\n# Rescue:    git reflog | git stash | git cherry-pick <sha>\n# Find:      git bisect | git blame | git log -S \"text\""
        ]
      ]
    }
  ],
