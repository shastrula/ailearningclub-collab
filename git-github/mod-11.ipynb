{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Git Github - mod-11\n\n",
        "**Course:** git-github\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Stash tracked changes (working dir + staging)\ngit stash\n\n# Stash including untracked files\ngit stash -u\n\n# Give it a name for clarity\ngit stash push -m \"half-done search feature\"\n\n# List stashes\ngit stash list\n# stash@{0}: On main: half-done search feature\n\n# Reapply the latest stash and remove it from the list\ngit stash pop\n\n# Reapply but keep it in the list\ngit stash apply\n\n# Apply a specific stash\ngit stash apply stash@{1}\n\n# Delete stashes\ngit stash drop stash@{0}\ngit stash clear          # remove all"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git bisect start\ngit bisect bad                 # current commit is broken\ngit bisect good v1.0.0         # this old version worked\n\n# Git checks out a commit halfway between. Test it, then:\ngit bisect good                # if this commit is fine\ngit bisect bad                 # if this commit is broken\n\n# Repeat until Git reports the first bad commit, then:\ngit bisect reset               # return to your original HEAD"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git bisect start HEAD v1.0.0\ngit bisect run ./test.sh       # Git runs it at each step automatically"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Create a new worktree for a hotfix\ngit worktree add ../myproject-hotfix hotfix/urgent\n\n# Now ../myproject-hotfix has that branch checked out;\n# your main directory stays on its branch untouched.\n\ngit worktree list\ngit worktree remove ../myproject-hotfix"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# .git/hooks/pre-commit  (must be executable)\n#!/bin/bash\n# Block commits that fail linting\nnpm run lint || { echo \"Lint failed \u2014 commit aborted\"; exit 1; }"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "chmod +x .git/hooks/pre-commit"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "yaml",
          "# .pre-commit-config.yaml\nrepos:\n  - repo: https://github.com/pre-commit/pre-commit-hooks\n    rev: v4.6.0\n    hooks:\n      - id: trailing-whitespace\n      - id: end-of-file-fixer\n      - id: check-added-large-files"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Who last changed each line, and in which commit?\ngit blame app.py\n\n# Search history for when a string was added/removed\ngit log -S \"functionName\" --oneline\n\n# Search commit messages\ngit log --grep=\"bugfix\"\n\n# Show a file as it existed at a past commit\ngit show v1.0.0:src/app.py"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git submodule add https://github.com/org/lib.git libs/lib\ngit commit -m \"Add lib submodule\"\n\n# When cloning a repo with submodules\ngit clone --recurse-submodules <url>\n\n# Update submodules to their latest committed refs\ngit submodule update --remote"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git commit --fixup=<sha>        # mark a fix for later autosquash\ngit rebase -i --autosquash      # auto-arrange fixups\ngit switch -                    # jump back to previous branch\ngit restore --source=HEAD~2 f   # restore a file from 2 commits ago\ngit diff main...feature         # changes on feature since it diverged"
        ]
      ]
    }
  ],
