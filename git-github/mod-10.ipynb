{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Git Github - mod-10\n\n",
        "**Course:** git-github\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "gitignore",
          "# Dependencies\nnode_modules/\nvenv/\n__pycache__/\n*.pyc\n\n# Build artifacts\ndist/\nbuild/\n*.egg-info/\n\n# Environment & secrets\n.env\n.env.*\ncredentials.json\n*.pem\n\n# Data & models (use DVC/S3/LFS instead)\ndata/\n*.csv\n*.parquet\n*.pkl\n*.pt\n\n# OS & editors\n.DS_Store\nThumbs.db\n.idea/\n.vscode/\n\n# Logs\n*.log\n\n# Allow-list exception: track this one file even though *.log is ignored\n!important.log"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git config --global core.excludesfile ~/.gitignore_global\necho \".DS_Store\" >> ~/.gitignore_global"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Stop tracking it but keep it on disk\ngit rm --cached .env\necho \".env\" >> .gitignore\ngit commit -m \"Stop tracking .env\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Install and initialize (once per machine)\ngit lfs install\n\n# Track large file types\ngit lfs track \"*.psd\"\ngit lfs track \"*.pt\"\ngit lfs track \"*.zip\"\n\n# This updates .gitattributes \u2014 commit it\ngit add .gitattributes\ngit add model.pt\ngit commit -m \"Add model via LFS\"\ngit push"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "gitattributes",
          "# Normalize line endings\n* text=auto\n\n# Treat these as binary (no diff/merge)\n*.png binary\n*.pdf binary\n\n# Mark generated files so they don't clutter diffs / language stats\npackage-lock.json linguist-generated=true\ndist/* linguist-vendored"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Clean up remote-tracking refs for branches deleted on the server\ngit fetch --prune\n\n# Compress and clean the local object database\ngit gc --aggressive"
        ]
      ]
    }
  ],
