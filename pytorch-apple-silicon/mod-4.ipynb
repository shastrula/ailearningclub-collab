        [
          "python",
          "import torch\nimport torch.nn as nn\n\ndevice = torch.device(\"mps\" if torch.backends.mps.is_available() else \"cpu\")\n\n# Note: Real distributed training on MPS not yet supported,\n# but you can simulate data parallelism across CPU/MPS\n\ndef simulate_data_parallel():\n    model = nn.Linear(100, 10).to(device)\n    optimizer = torch.optim.Adam(model.parameters())\n    \n    batch_size = 64\n    # Simulate 2 workers worth of data\n    batch_1 = (torch.randn(batch_size//2, 100), torch.randint(0, 10, (batch_size//2,)))\n    batch_2 = (torch.randn(batch_size//2, 100), torch.randint(0, 10, (batch_size//2,)))\n    \n    total_loss = 0\n    for batch_x, batch_y in [batch_1, batch_2]:\n        batch_x, batch_y = batch_x.to(device), batch_y.to(device)\n        output = model(batch_x)\n        loss = nn.CrossEntropyLoss()(output, batch_y)\n        loss.backward()\n        total_loss += loss.item()\n    \n    optimizer.step()\n    optimizer.zero_grad()\n    print(f\"Average loss: {total_loss/2:.4f}\")\n\nsimulate_data_parallel()"
        ]
      ]
    }
