      "source": [
        "# Pytorch Apple Silicon - mod-3\n\n",
        "**Course:** pytorch-apple-silicon\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport torch.nn as nn\n\ndevice = torch.device(\"mps\" if torch.backends.mps.is_available() else \"cpu\")\n\n# Create model\nmodel = nn.Sequential(\n    nn.Linear(100, 50),\n    nn.ReLU(),\n    nn.Linear(50, 10)\n).to(device)\n\n# For production, use float32 on MPS (int8 quantization not well-supported yet)\nmodel.eval()\ntorch.save(model.state_dict(), \"model.pt\")\n\n# Export to TorchScript for faster inference\nexample_input = torch.randn(1, 100, device=device)\ntraced_model = torch.jit.trace(model, example_input)\ntraced_model.save(\"model_traced.pt\")\n\n# Load and use\nloaded_model = torch.jit.load(\"model_traced.pt\")\noutput = loaded_model(example_input)\nprint(f\"TorchScript output: {output}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport torch.nn as nn\nfrom typing import List\n\ndevice = torch.device(\"mps\" if torch.backends.mps.is_available() else \"cpu\")\nmodel = nn.Linear(100, 10).to(device)\nmodel.eval()\n\ndef batch_predict(inputs: List[torch.Tensor], batch_size: int = 32) -> torch.Tensor:\n    \"\"\"Efficient batch inference.\"\"\"\n    all_outputs = []\n    \n    with torch.no_grad():\n        for i in range(0, len(inputs), batch_size):\n            batch = torch.stack(inputs[i:i+batch_size])\n            batch = batch.to(device)\n            output = model(batch)\n            all_outputs.append(output.cpu())\n    \n    return torch.cat(all_outputs, dim=0)\n\n# Test\ntest_inputs = [torch.randn(100) for _ in range(256)]\npredictions = batch_predict(test_inputs, batch_size=32)\nprint(f\"Predictions shape: {predictions.shape}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport torch.nn as nn\n\ndevice = torch.device(\"mps\" if torch.backends.mps.is_available() else \"cpu\")\n\nclass StreamingModel(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.fc1 = nn.Linear(100, 100)\n        self.fc2 = nn.Linear(100, 100)\n    \n    def forward(self, x):\n        residual = x\n        x = torch.relu(self.fc1(x))\n        x = self.fc2(x)\n        return x + residual\n\nmodel = StreamingModel().to(device)\nmodel.eval()\n\n# Single-sample inference (streaming scenario)\nwith torch.no_grad():\n    for i in range(10):\n        x = torch.randn(1, 100, device=device)\n        output = model(x)\n        print(f\"Step {i}: output norm = {output.norm().item():.4f}\")"
        ]
      ]
    },
    {
