          "python",
          "import torch\nimport torch.nn as nn\nimport time\n\ndevice = torch.device(\"mps\" if torch.backends.mps.is_available() else \"cpu\")\n\nclass PerformanceMonitor:\n    def __init__(self):\n        self.timings = []\n    \n    def measure(self, func, name: str, iterations: int = 10):\n        times = []\n        for _ in range(iterations):\n            start = time.perf_counter()\n            func()\n            end = time.perf_counter()\n            times.append(end - start)\n        \n        avg_time = sum(times) / len(times)\n        print(f\"{name}: {avg_time*1000:.2f}ms (min: {min(times)*1000:.2f}ms, max: {max(times)*1000:.2f}ms)\")\n        return avg_time\n\nmodel = nn.Linear(1000, 100).to(device)\nmodel.eval()\n\nmonitor = PerformanceMonitor()\n\ndef inference():\n    x = torch.randn(1, 1000, device=device)\n    with torch.no_grad():\n        return model(x)\n\nmonitor.measure(inference, \"Inference\", iterations=100)"
        ]
      ]
