        [
          "python",
          "import torch\nimport torch.nn as nn\nfrom functools import lru_cache\n\ndevice = torch.device(\"mps\" if torch.backends.mps.is_available() else \"cpu\")\n\nclass CachedModel(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.embedding = nn.Embedding(1000, 100)\n        self.fc = nn.Linear(100, 10)\n    \n    def forward(self, x):\n        return self.fc(self.embedding(x))\n\nmodel = CachedModel().to(device)\nmodel.eval()\n\n# Cache embedding lookups\nembedding_cache = {}\n\ndef cached_forward(x):\n    x_int = x.item() if x.dim() == 0 else tuple(x.tolist())\n    if x_int not in embedding_cache:\n        embedding_cache[x_int] = model.embedding(x)\n    return model.fc(embedding_cache[x_int])\n\nwith torch.no_grad():\n    x = torch.tensor([42], device=device)\n    output = cached_forward(x)\n    print(f\"Cached output: {output}\")"
        ]
      ]
    },
