      "source": [
        "# Pytorch Apple Silicon - mod-5\n\n",
        "**Course:** pytorch-apple-silicon\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport os\n\n# Enable MPS fallback for unsupported operations\nos.environ[\"PYTORCH_ENABLE_MPS_FALLBACK\"] = \"1\"\n\ndevice = torch.device(\"mps\" if torch.backends.mps.is_available() else \"cpu\")\n\n# Handle potential issues\ntry:\n    # Some operations might not be supported on MPS\n    x = torch.randn(10, 10, device=device)\n    y = torch.randn(10, 10, device=device)\n    \n    # This might fall back to CPU if not supported\n    result = torch.cross(x, y)\nexcept RuntimeError as e:\n    print(f\"Operation error: {e}\")\n    print(\"Falling back to CPU\")\n    x, y = x.cpu(), y.cpu()\n    result = torch.cross(x, y)\n\nprint(f\"Result shape: {result.shape}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport gc\nimport tracemalloc\n\ndevice = torch.device(\"mps\" if torch.backends.mps.is_available() else \"cpu\")\ntracemalloc.start()\n\n# Train loop with potential memory leaks\nmodel = torch.nn.Linear(100, 10).to(device)\n\nfor iteration in range(100):\n    x = torch.randn(32, 100, device=device)\n    y = model(x)\n    \n    # Bad: keeping outputs in list (memory leak)\n    # outputs.append(y)\n    \n    # Good: delete explicitly\n    del x, y\n    \n    if iteration % 10 == 0:\n        current, peak = tracemalloc.get_traced_memory()\n        print(f\"Iteration {iteration}: Current = {current / 1024 / 1024:.1f}MB, Peak = {peak / 1024 / 1024:.1f}MB\")\n        gc.collect()\n\ntracemalloc.stop()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport torch.nn as nn\nimport numpy as np\n\ndevice = torch.device(\"mps\" if torch.backends.mps.is_available() else \"cpu\")\n\ndef check_numerical_stability(model, input_tensor):\n    \"\"\"Check for NaN, Inf, and gradient issues.\"\"\"\n    input_tensor = input_tensor.to(device)\n    \n    # Forward pass\n    output = model(input_tensor)\n    \n    # Check for NaN/Inf\n    if torch.isnan(output).any():\n        print(\"WARNING: NaN in output\")\n    if torch.isinf(output).any():\n        print(\"WARNING: Inf in output\")\n    \n    # Check weight statistics\n    for name, param in model.named_parameters():\n        if param.data.abs().max() > 1e6:\n            print(f\"WARNING: Large weights in {name}: max = {param.data.abs().max():.2e}\")\n    \n    return output\n\nmodel = nn.Linear(10, 10).to(device)\nx = torch.randn(1, 10)\noutput = check_numerical_stability(model, x)"
        ]
      ]
