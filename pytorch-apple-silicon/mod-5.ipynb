          "python",
          "import torch\nimport torch.nn as nn\n\nclass ModelValidator:\n    def __init__(self, model, device):\n        self.model = model\n        self.device = device\n    \n    def validate_forward_pass(self, input_size):\n        \"\"\"Test forward pass works.\"\"\"\n        x = torch.randn(*input_size, device=self.device)\n        try:\n            output = self.model(x)\n            print(f\"\u2713 Forward pass OK, output shape: {output.shape}\")\n            return True\n        except Exception as e:\n            print(f\"\u2717 Forward pass failed: {e}\")\n            return False\n    \n    def validate_backward_pass(self, input_size, output_size):\n        \"\"\"Test backward pass works.\"\"\"\n        x = torch.randn(*input_size, device=self.device, requires_grad=True)\n        try:\n            output = self.model(x)\n            loss = output.sum()\n            loss.backward()\n            print(f\"\u2713 Backward pass OK\")\n            return True\n        except Exception as e:\n            print(f\"\u2717 Backward pass failed: {e}\")\n            return False\n    \n    def validate_device_placement(self):\n        \"\"\"Verify all params on correct device.\"\"\"\n        for name, param in self.model.named_parameters():\n            if param.device != self.device:\n                print(f\"\u2717 {name} on {param.device}, expected {self.device}\")\n                return False\n        print(f\"\u2713 All parameters on {self.device}\")\n        return True\n\n# Test suite\nmodel = nn.Sequential(\n    nn.Linear(100, 50),\n    nn.ReLU(),\n    nn.Linear(50, 10)\n).to(torch.device(\"mps\" if torch.backends.mps.is_available() else \"cpu\"))\n\nvalidator = ModelValidator(model, torch.device(\"mps\" if torch.backends.mps.is_available() else \"cpu\"))\nvalidator.validate_device_placement()\nvalidator.validate_forward_pass((1, 100))\nvalidator.validate_backward_pass((32, 100), (32, 10))"
        ]
      ]
    }
