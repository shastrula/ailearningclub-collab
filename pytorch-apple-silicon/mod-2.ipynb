          "python",
          "import torch\nimport torch.nn as nn\n\ndevice = torch.device(\"mps\" if torch.backends.mps.is_available() else \"cpu\")\n\n# Note: PyTorch distributed training doesn't support MPS yet\n# But you can prepare your model architecture for future multi-GPU\n\nclass DistributionReadyModel(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.backbone = nn.Sequential(\n            nn.Linear(100, 50),\n            nn.ReLU(),\n            nn.Linear(50, 25)\n        )\n        self.head = nn.Linear(25, 10)\n    \n    def forward(self, x):\n        return self.head(self.backbone(x))\n\nmodel = DistributionReadyModel().to(device)\n\n# Can be wrapped with DistributedDataParallel later\n# ddp_model = nn.parallel.DistributedDataParallel(model)\n\nx = torch.randn(32, 100, device=device)\noutput = model(x)\nprint(f\"Output: {output.shape}\")"
        ]
