          "python",
          "import torch\nimport torch.nn as nn\nimport unittest\n\nclass TestModelTraining(unittest.TestCase):\n    def setUp(self):\n        self.device = torch.device(\"mps\" if torch.backends.mps.is_available() else \"cpu\")\n        self.model = nn.Linear(10, 5).to(self.device)\n    \n    def test_forward_pass(self):\n        x = torch.randn(1, 10, device=self.device)\n        output = self.model(x)\n        self.assertEqual(output.shape, (1, 5))\n    \n    def test_backward_pass(self):\n        x = torch.randn(1, 10, device=self.device, requires_grad=True)\n        output = self.model(x)\n        loss = output.sum()\n        loss.backward()\n        self.assertIsNotNone(x.grad)\n    \n    def test_training_step(self):\n        optimizer = torch.optim.SGD(self.model.parameters(), lr=0.01)\n        x = torch.randn(32, 10, device=self.device)\n        y = torch.randn(32, 5, device=self.device)\n        \n        initial_params = [p.clone() for p in self.model.parameters()]\n        \n        optimizer.zero_grad()\n        output = self.model(x)\n        loss = nn.MSELoss()(output, y)\n        loss.backward()\n        optimizer.step()\n        \n        for p_init, p_new in zip(initial_params, self.model.parameters()):\n            self.assertFalse(torch.allclose(p_init, p_new))\n    \n    def test_device_placement(self):\n        for param in self.model.parameters():\n            self.assertEqual(param.device, self.device)\n\nif __name__ == '__main__':\n    unittest.main()"
        ]
