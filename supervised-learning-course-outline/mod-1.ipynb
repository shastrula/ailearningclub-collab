          "python",
          "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\nfrom sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\nimport numpy as np\n\n# Classification Metrics\ny_true = [0, 1, 1, 0, 1]\ny_pred = [0, 1, 0, 0, 1]\n\naccuracy = accuracy_score(y_true, y_pred)  # (correct predictions) / total\nprecision = precision_score(y_true, y_pred)  # (true positives) / (predicted positives)\nrecall = recall_score(y_true, y_pred)  # (true positives) / (actual positives)\nf1 = f1_score(y_true, y_pred)  # Harmonic mean of precision and recall\n\nprint(f\"Accuracy: {accuracy:.2f}\")    # 0.80\nprint(f\"Precision: {precision:.2f}\")  # 1.00 (no false positives)\nprint(f\"Recall: {recall:.2f}\")        # 0.67 (missed one positive)\nprint(f\"F1: {f1:.2f}\")                # 0.80\n\n# Regression Metrics\ny_true = [100, 200, 300, 400, 500]\ny_pred = [110, 190, 310, 390, 520]\n\nmae = mean_absolute_error(y_true, y_pred)    # Average absolute error\nrmse = np.sqrt(mean_squared_error(y_true, y_pred))  # Root mean squared error\nr2 = r2_score(y_true, y_pred)  # How well predictions fit (0-1)\n\nprint(f\"MAE: {mae:.2f}\")        # Average prediction error\nprint(f\"RMSE: {rmse:.2f}\")      # Penalizes large errors\nprint(f\"R\u00b2: {r2:.2f}\")          # Proportion of variance explained"
