          "python",
          "# Install: pip install shap lime\n\nimport shap\nimport lime\nimport lime.lime_tabular\nfrom sklearn.ensemble import RandomForestClassifier\nimport numpy as np\n\nX = np.random.randn(200, 5)\ny = (X[:, 0] + X[:, 2] > 0).astype(int)\n\nX_train, X_test = X[:150], X[150:]\ny_train, y_test = y[:150], y[150:]\n\nmodel = RandomForestClassifier(random_state=42)\nmodel.fit(X_train, y_train)\n\n# SHAP: SHapley Additive exPlanations\nexplainer = shap.TreeExplainer(model)\nshap_values = explainer.shap_values(X_test)\n\n# Force plot for a single prediction\nshap.force_plot(explainer.expected_value[1], shap_values[1][0], X_test[0])\n\n# Summary plot (feature importance across all predictions)\nshap.summary_plot(shap_values[1], X_test)\n\n# LIME: Local Interpretable Model-agnostic Explanations\nlime_explainer = lime.lime_tabular.LimeTabularExplainer(\n    X_train,\n    feature_names=[f'Feature {i}' for i in range(5)],\n    class_names=['Class 0', 'Class 1'],\n    mode='classification'\n)\n\n# Explain a single prediction\nexp = lime_explainer.explain_instance(\n    X_test[0],\n    model.predict_proba,\n    num_features=5\n)\n\nexp.show_in_notebook()  # In Jupyter\nprint(exp.as_list())    # Text version"
        ]
      ]
