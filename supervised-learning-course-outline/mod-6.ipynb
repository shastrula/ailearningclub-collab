          "python",
          "import pandas as pd\nimport numpy as np\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import accuracy_score\n\n# Synthetic loan approval dataset with protected attribute (gender)\nnp.random.seed(42)\nn = 1000\n\ndata = {\n    'income': np.random.normal(50000, 20000, n),\n    'credit_score': np.random.normal(700, 50, n),\n    'gender': np.random.choice(['M', 'F'], n),\n    'age': np.random.normal(40, 15, n)\n}\n\n# Create biased labels (favors males)\ndf = pd.DataFrame(data)\ndf['approved'] = (\n    (df['income'] > 40000) & \n    (df['credit_score'] > 650) &\n    ((df['gender'] == 'M') & np.random.rand(n) > 0.2 |  # 80% approval for males\n     (df['gender'] == 'F') & np.random.rand(n) > 0.5)    # 50% approval for females\n).astype(int)\n\n# Train model\nX = df[['income', 'credit_score']].values\ny = df['approved'].values\n\nmodel = LogisticRegression()\nmodel.fit(X, y)\n\n# Check for bias\nfor gender in ['M', 'F']:\n    mask = df['gender'] == gender\n    approval_rate = model.predict(X[mask]).mean()\n    print(f\"{gender}: {approval_rate:.1%} approval rate\")\n\n# Mitigation: Fair learning with protected attributes\n# Install: pip install fairlearn\n\nfrom fairlearn.linear_model import LogisticRegression as FairLogisticRegression\nfrom fairlearn.metrics import MetricFrame\n\n# Fair logistic regression (mitigates gender bias)\nfair_model = FairLogisticRegression(unfairness_loss_type='demographic_parity')\nfair_model.fit(X, y, sensitive_features=df['gender'])\n\n# Evaluate fairness\nfor gender in ['M', 'F']:\n    mask = df['gender'] == gender\n    fair_approval = fair_model.predict(X[mask]).mean()\n    print(f\"Fair {gender}: {fair_approval:.1%} approval rate\")"
