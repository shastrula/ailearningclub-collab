          "python",
          "from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier, VotingClassifier\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.svm import SVC\nfrom sklearn.metrics import accuracy_score\nimport numpy as np\n\nX = np.random.randn(200, 10)\ny = (X[:, 0] + X[:, 1] > 0).astype(int)\n\nX_train, X_test = X[:150], X[150:]\ny_train, y_test = y[:150], y[150:]\n\n# Voting Ensemble (combine predictions via voting)\nvoting_clf = VotingClassifier(\n    estimators=[\n        ('lr', LogisticRegression(random_state=42)),\n        ('svm', SVC(random_state=42, probability=True)),\n        ('rf', RandomForestClassifier(random_state=42))\n    ],\n    voting='soft'  # Use probabilities instead of hard voting\n)\n\nvoting_clf.fit(X_train, y_train)\nprint(f\"Voting accuracy: {voting_clf.score(X_test, y_test):.3f}\")\n\n# Stacking Ensemble (use predictions as features for meta-model)\nfrom sklearn.ensemble import StackingClassifier\n\nstacking_clf = StackingClassifier(\n    estimators=[\n        ('lr', LogisticRegression(random_state=42)),\n        ('svm', SVC(random_state=42, probability=True)),\n        ('rf', RandomForestClassifier(random_state=42))\n    ],\n    final_estimator=LogisticRegression()  # Meta-learner\n)\n\nstacking_clf.fit(X_train, y_train)\nprint(f\"Stacking accuracy: {stacking_clf.score(X_test, y_test):.3f}\")\n\n# Bagging (Bootstrap Aggregating)\n# Random Forest is a bagging ensemble of decision trees\nrf = RandomForestClassifier(n_estimators=100, random_state=42)\nrf.fit(X_train, y_train)\nprint(f\"Random Forest accuracy: {rf.score(X_test, y_test):.3f}\")\n\n# Boosting (Sequential ensemble that corrects previous errors)\ngb = GradientBoostingClassifier(n_estimators=100, random_state=42)\ngb.fit(X_train, y_train)\nprint(f\"Gradient Boosting accuracy: {gb.score(X_test, y_test):.3f}\")"
        ]
      ]
