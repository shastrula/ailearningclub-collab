          "python",
          "from sklearn.preprocessing import StandardScaler\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.decomposition import PCA\nimport numpy as np\n\n# Scenario: Trained on disease X, now adapt for disease Y (similar but different)\n\n# Source task: Pretrained on large labeled dataset\nX_source = np.random.randn(1000, 50)  # 50 medical features\ny_source = (X_source[:, :10].sum(axis=1) > 0).astype(int)\n\n# Pretrain feature extractor (learns general patterns)\nscaler = StandardScaler()\nX_source_scaled = scaler.fit_transform(X_source)\n\npca = PCA(n_components=20)  # Dimensionality reduction\nX_source_encoded = pca.fit_transform(X_source_scaled)\n\n# Train classifier on encoded features\nsource_model = LogisticRegression()\nsource_model.fit(X_source_encoded, y_source)\n\n# Target task: Limited labeled data for related disease\nX_target = np.random.randn(100, 50)  # Only 100 samples\ny_target = (X_target[:, :10].sum(axis=1) > 0.5).astype(int)\n\n# Transfer learning: Reuse feature extractor\nX_target_scaled = scaler.transform(X_target)\nX_target_encoded = pca.transform(X_target_scaled)\n\n# Fine-tune on target task\ntarget_model = LogisticRegression()\ntarget_model.fit(X_target_encoded, y_target)\n\ntarget_score = target_model.score(X_target_encoded, y_target)\nprint(f\"Transfer learning accuracy: {target_score:.3f}\")\n\n# Compare to training from scratch with limited data\ntarget_from_scratch = LogisticRegression()\ntarget_from_scratch.fit(X_target_scaled, y_target)\nscratch_score = target_from_scratch.score(X_target_scaled, y_target)\nprint(f\"Scratch accuracy: {scratch_score:.3f}\")\nprint(f\"Transfer learning advantage: {(target_score - scratch_score)*100:.1f}%\")"
        ]
      ]
    },
