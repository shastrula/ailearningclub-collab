          "python",
          "import json\nfrom datetime import datetime\nimport hashlib\n\nclass ModelRegistry:\n    \"\"\"Manage model versions and metadata\"\"\"\n    \n    def __init__(self, registry_path='model_registry.json'):\n        self.registry_path = registry_path\n        self.models = {}\n    \n    def register_model(self, name, model_path, metadata):\n        \"\"\"Register a new model version\"\"\"\n        # Compute hash of model file\n        with open(model_path, 'rb') as f:\n            model_hash = hashlib.md5(f.read()).hexdigest()\n        \n        version = {\n            'path': model_path,\n            'hash': model_hash,\n            'timestamp': datetime.now().isoformat(),\n            'metadata': metadata,\n            'status': 'registered'  # or 'staging', 'production', 'archived'\n        }\n        \n        if name not in self.models:\n            self.models[name] = []\n        \n        self.models[name].append(version)\n        self._save_registry()\n        print(f\"Registered {name} v{len(self.models[name])}\")\n    \n    def get_production_model(self, name):\n        \"\"\"Get current production model\"\"\"\n        if name not in self.models:\n            return None\n        \n        for model in self.models[name]:\n            if model['status'] == 'production':\n                return model\n        \n        return None\n    \n    def promote_to_production(self, name, version):\n        \"\"\"Promote a model version to production\"\"\"\n        if name not in self.models or version > len(self.models[name]):\n            print(\"Model version not found\")\n            return\n        \n        # Demote current production\n        for model in self.models[name]:\n            if model['status'] == 'production':\n                model['status'] = 'archived'\n        \n        # Promote new model\n        self.models[name][version - 1]['status'] = 'production'\n        self._save_registry()\n        print(f\"Promoted {name} v{version} to production\")\n    \n    def _save_registry(self):\n        with open(self.registry_path, 'w') as f:\n            json.dump(self.models, f, indent=2)\n\n# Usage\nregistry = ModelRegistry()\nregistry.register_model('loan_classifier', 'model_v1.pkl', {\n    'accuracy': 0.92,\n    'algorithm': 'RandomForest',\n    'features': 5\n})\nregistry.promote_to_production('loan_classifier', 1)"
        ]
