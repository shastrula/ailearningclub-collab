          "python",
          "# Install: pip install auto-sklearn\n\nfrom autosklearn.classification import AutoSklearnClassifier\nimport numpy as np\n\nX = np.random.randn(200, 10)\ny = (X[:, 0] > 0).astype(int)\n\nX_train, X_test = X[:150], X[150:]\ny_train, y_test = y[:150], y[150:]\n\n# Auto-sklearn searches for best pipeline\nautoml = AutoSklearnClassifier(\n    time_left_for_this_task=120,  # 2 minutes\n    per_run_time_limit=30\n)\n\nautoml.fit(X_train, y_train)\nautoml_score = automl.score(X_test, y_test)\nprint(f\"AutoML accuracy: {automl_score:.3f}\")\n\n# Inspect best pipeline\nprint(f\"Best model: {automl.best_estimator_}\")\n\n# Alternative: TPOT (Tree-based Pipeline Optimization Tool)\n# from tpot import TPOTClassifier\n# tpot = TPOTClassifier(generations=5, population_size=50, random_state=42)\n# tpot.fit(X_train, y_train)\n# print(f\"TPOT accuracy: {tpot.score(X_test, y_test):.3f}\")"
