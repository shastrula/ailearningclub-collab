          "python",
          "from sklearn.model_selection import cross_val_score, StratifiedKFold\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.ensemble import RandomForestClassifier\nimport numpy as np\n\n# Generate data\nX = np.random.randn(100, 5)\ny = (X[:, 0] > 0).astype(int)\n\n# Strategy 1: Hold-Out Validation (simple, wastes data)\nfrom sklearn.model_selection import train_test_split\nX_train, X_val, y_train, y_val = train_test_split(X, y, test_size=0.2)\nmodel = LogisticRegression()\nmodel.fit(X_train, y_train)\nscore = model.score(X_val, y_val)\nprint(f\"Hold-Out Validation: {score:.3f}\")\n\n# Strategy 2: K-Fold Cross-Validation (better use of data)\nmodel = LogisticRegression()\nscores = cross_val_score(model, X, y, cv=5)  # 5-fold\nprint(f\"5-Fold CV: {scores.mean():.3f} (+/- {scores.std():.3f})\")\n\n# Strategy 3: Stratified K-Fold (for imbalanced data)\nskf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\nscores = cross_val_score(LogisticRegression(), X, y, cv=skf)\nprint(f\"Stratified 5-Fold CV: {scores.mean():.3f}\")\n\n# Strategy 4: TimeSeriesSplit (for time series data)\nfrom sklearn.model_selection import TimeSeriesSplit\ntscv = TimeSeriesSplit(n_splits=5)\n# Creates train/test splits respecting temporal order"
