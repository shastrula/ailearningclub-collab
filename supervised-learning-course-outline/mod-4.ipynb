    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.metrics import (accuracy_score, precision_score, recall_score, f1_score,\n                             confusion_matrix, roc_auc_score, roc_curve, auc)\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Example predictions\ny_true = [0, 0, 1, 1, 1, 0, 1, 0, 1, 1]\ny_pred = [0, 1, 1, 1, 1, 0, 0, 0, 1, 1]\n\n# Confusion Matrix\ntn, fp, fn, tp = confusion_matrix(y_true, y_pred).ravel()\nprint(f\"True Negatives: {tn}, False Positives: {fp}\")\nprint(f\"False Negatives: {fn}, True Positives: {tp}\")\n\n# Accuracy: (TP + TN) / Total (overall correctness)\naccuracy = accuracy_score(y_true, y_pred)\nprint(f\"Accuracy: {accuracy:.3f}\")  # 0.8\n\n# Precision: TP / (TP + FP) (of predicted positive, how many correct?)\nprecision = precision_score(y_true, y_pred)\nprint(f\"Precision: {precision:.3f}\")  # Relevant when false positives are costly\n\n# Recall: TP / (TP + FN) (of actual positive, how many found?)\nrecall = recall_score(y_true, y_pred)\nprint(f\"Recall: {recall:.3f}\")  # Relevant when false negatives are costly\n\n# F1 Score: Harmonic mean of precision and recall\nf1 = f1_score(y_true, y_pred)\nprint(f\"F1: {f1:.3f}\")  # Balanced metric for imbalanced data\n\n# ROC-AUC: Area under receiver operating characteristic curve (0-1, higher is better)\ny_pred_proba = [0.1, 0.6, 0.8, 0.9, 0.7, 0.2, 0.3, 0.1, 0.95, 0.85]\nauc_score = roc_auc_score(y_true, y_pred_proba)\nprint(f\"ROC-AUC: {auc_score:.3f}\")\n\n# When to use each:\n# - Accuracy: Balanced dataset, equal costs\n# - Precision: Minimize false positives (spam detection)\n# - Recall: Minimize false negatives (disease detection)\n# - F1: Imbalanced dataset, need balance\n# - ROC-AUC: Threshold-independent evaluation"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\nimport numpy as np\n\ny_true = [100, 200, 300, 400, 500]\ny_pred = [110, 190, 310, 390, 520]\n\n# Mean Absolute Error: Average absolute prediction error\nmae = mean_absolute_error(y_true, y_pred)\nprint(f\"MAE: {mae:.2f}\")  # 14.0, same units as target\n\n# Mean Squared Error: Average squared error (penalizes large errors)\nmse = mean_squared_error(y_true, y_pred)\nprint(f\"MSE: {mse:.2f}\")\n\n# Root Mean Squared Error: Square root of MSE (same units as target)\nrmse = np.sqrt(mse)\nprint(f\"RMSE: {rmse:.2f}\")\n\n# R\u00b2 Score: Proportion of variance explained (0-1, higher is better)\nr2 = r2_score(y_true, y_pred)\nprint(f\"R\u00b2: {r2:.3f}\")\n\n# Mean Absolute Percentage Error (MAPE): Relative error\nmape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100\nprint(f\"MAPE: {mape:.2f}%\")\n\n# When to use each:\n# - MAE: Interpretable, robust to outliers\n# - RMSE: Standard, penalizes outliers, same units as target\n# - R\u00b2: Proportion of variance explained\n# - MAPE: When you want relative error (%)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.model_selection import GridSearchCV, cross_val_score\nfrom sklearn.svm import SVC\nfrom sklearn.ensemble import RandomForestClassifier\nimport numpy as np\n\n# Generate data\nX = np.random.randn(200, 10)\ny = (X[:, 0] + X[:, 1] > 0).astype(int)\n\n# SVM hyperparameter grid\nparam_grid_svm = {\n    'C': [0.1, 1, 10, 100],\n    'kernel': ['linear', 'rbf', 'poly'],\n    'gamma': ['scale', 'auto']\n}\n\ngrid_search = GridSearchCV(\n    SVC(),\n    param_grid_svm,\n    cv=5,\n    scoring='f1',  # Optimize for F1 instead of accuracy\n    n_jobs=-1\n)\n\ngrid_search.fit(X, y)\nprint(f\"Best params: {grid_search.best_params_}\")\nprint(f\"Best CV score: {grid_search.best_score_:.3f}\")\n\n# Access results as DataFrame\nresults_df = pd.DataFrame(grid_search.cv_results_)\nprint(results_df[['param_C', 'param_kernel', 'mean_test_score', 'std_test_score']].head(10))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.model_selection import cross_val_score, StratifiedKFold\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import accuracy_score, f1_score, roc_auc_score\nimport numpy as np\n\nX = np.random.randn(200, 10)\ny = (X[:, 0] > 0).astype(int)\n\n# K-Fold (standard, order-dependent)\ncv_accuracy = cross_val_score(LogisticRegression(), X, y, cv=5, scoring='accuracy')\nprint(f\"Accuracy: {cv_accuracy.mean():.3f} (+/- {cv_accuracy.std():.3f})\")\n\n# Stratified K-Fold (maintains class distribution)\nskf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\ncv_f1 = cross_val_score(LogisticRegression(), X, y, cv=skf, scoring='f1')\nprint(f\"F1: {cv_f1.mean():.3f} (+/- {cv_f1.std():.3f})\")\n\n# ROC-AUC\ncv_auc = cross_val_score(LogisticRegression(), X, y, cv=5, scoring='roc_auc')\nprint(f\"ROC-AUC: {cv_auc.mean():.3f} (+/- {cv_auc.std():.3f})\")\n\n# Time Series Split (for time series data)\nfrom sklearn.model_selection import TimeSeriesSplit\ntscv = TimeSeriesSplit(n_splits=5)\ncv_ts = cross_val_score(LogisticRegression(), X, y, cv=tscv, scoring='accuracy')\nprint(f\"Time Series CV: {cv_ts.mean():.3f}\")"
        ]
      ]
    },
