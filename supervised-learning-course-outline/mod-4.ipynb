          "python",
          "from sklearn.tree import DecisionTreeClassifier\nfrom sklearn.ensemble import RandomForestClassifier\nimport numpy as np\n\nX = np.random.randn(200, 10)\ny = (X[:, 0] > 0).astype(int)\n\nX_train = X[:150]\nX_test = X[150:]\ny_train = y[:150]\ny_test = y[150:]\n\n# Model with increasing complexity\ndepths = [1, 3, 5, 10, 20]\ntrain_scores = []\ntest_scores = []\n\nfor depth in depths:\n    model = DecisionTreeClassifier(max_depth=depth, random_state=42)\n    model.fit(X_train, y_train)\n    \n    train_score = model.score(X_train, y_train)\n    test_score = model.score(X_test, y_test)\n    \n    train_scores.append(train_score)\n    test_scores.append(test_score)\n    \n    print(f\"Depth {depth}: Train={train_score:.3f}, Test={test_score:.3f}, Gap={train_score-test_score:.3f}\")\n\n# Interpretation:\n# - If both low: underfitting (model too simple)\n# - If train high, test low: overfitting (model too complex)\n# - If both high and similar: good fit (model complexity just right)"
        ]
      ]
    },
    {
      "cell_type": "code",
