          "python",
          "import pandas as pd\nfrom datetime import datetime, timedelta\nimport json\n\nclass ModelRetrainingManager:\n    def __init__(self, accuracy_threshold=0.85, drift_threshold=0.1):\n        self.accuracy_threshold = accuracy_threshold\n        self.drift_threshold = drift_threshold\n        self.last_retrain = datetime.now()\n        self.performance_history = []\n    \n    def check_retraining_needed(self, current_accuracy, feature_drift):\n        \"\"\"Determine if retraining is needed\"\"\"\n        reasons = []\n        \n        # Check accuracy threshold\n        if current_accuracy < self.accuracy_threshold:\n            reasons.append(f\"Accuracy dropped below threshold ({current_accuracy:.3f})\")\n        \n        # Check data drift\n        if feature_drift > self.drift_threshold:\n            reasons.append(f\"Significant data drift detected ({feature_drift:.3f})\")\n        \n        # Check time since last retrain\n        days_since_retrain = (datetime.now() - self.last_retrain).days\n        if days_since_retrain > 30:\n            reasons.append(f\"30 days since last retrain ({days_since_retrain} days)\")\n        \n        return len(reasons) > 0, reasons\n    \n    def log_performance(self, accuracy, drift):\n        \"\"\"Log performance metrics\"\"\"\n        self.performance_history.append({\n            'timestamp': datetime.now().isoformat(),\n            'accuracy': accuracy,\n            'drift': drift\n        })\n    \n    def should_retrain(self, current_accuracy, feature_drift):\n        \"\"\"Check all criteria\"\"\"\n        needed, reasons = self.check_retraining_needed(current_accuracy, feature_drift)\n        \n        if needed:\n            print(\"\ud83d\udd04 Retraining triggered:\")\n            for reason in reasons:\n                print(f\"   - {reason}\")\n            self.last_retrain = datetime.now()\n            return True\n        \n        return False\n\n# Usage\nmanager = ModelRetrainingManager(accuracy_threshold=0.85, drift_threshold=0.1)\n\n# Simulate daily monitoring\naccuracies = [0.88, 0.87, 0.86, 0.82, 0.80, 0.78]  # Degrading\ndrifts = [0.02, 0.03, 0.05, 0.08, 0.12, 0.15]\n\nfor day, (acc, drift) in enumerate(zip(accuracies, drifts)):\n    print(f\"\\nDay {day}: Accuracy={acc:.3f}, Drift={drift:.3f}\")\n    manager.log_performance(acc, drift)\n    \n    if manager.should_retrain(acc, drift):\n        print(\"   \u2192 Scheduling retraining job\")"
        ]
      ]
