          "python",
          "import numpy as np\nimport pandas as pd\nfrom sklearn.linear_model import LogisticRegression\n\n# Original training distribution\nX_train = np.random.normal(0, 1, (1000, 5))\ny_train = (X_train[:, 0] > 0).astype(int)\n\nmodel = LogisticRegression()\nmodel.fit(X_train, y_train)\nbaseline_accuracy = model.score(X_train, y_train)\n\n# Track predictions over time\npredictions_log = []\naccuracies = []\nfeature_means = []\n\n# Simulate incoming data over time (with drift)\nfor day in range(10):\n    # Day 0-4: Original distribution\n    # Day 5+: Shifted distribution (concept drift)\n    shift = 0.5 if day >= 5 else 0\n    \n    X_day = np.random.normal(shift, 1, (100, 5))\n    y_day = (X_day[:, 0] > 0).astype(int)\n    \n    # Make predictions\n    y_pred = model.predict(X_day)\n    accuracy = (y_pred == y_day).mean()\n    \n    # Log metrics\n    accuracies.append(accuracy)\n    feature_means.append(X_day.mean())\n    \n    print(f\"Day {day}: Accuracy={accuracy:.3f}, Feature Mean={X_day.mean():.3f}\")\n    \n    # Alert if drift detected (accuracy drops significantly)\n    if accuracy < baseline_accuracy - 0.1:\n        print(f\"  \u26a0\ufe0f ALERT: Significant accuracy drop detected!\")\n\n# Visualization\nimport matplotlib.pyplot as plt\nplt.figure(figsize=(12, 5))\n\nplt.subplot(1, 2, 1)\nplt.plot(accuracies, marker='o')\nplt.axhline(baseline_accuracy, color='r', linestyle='--', label='Baseline')\nplt.xlabel('Day')\nplt.ylabel('Accuracy')\nplt.title('Model Accuracy Over Time')\nplt.legend()\n\nplt.subplot(1, 2, 2)\nplt.plot(feature_means, marker='o')\nplt.xlabel('Day')\nplt.ylabel('Feature Mean')\nplt.title('Data Drift Detection')\n\nplt.tight_layout()\nplt.show()"
        ]
