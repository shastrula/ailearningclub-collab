          "python",
          "from sklearn.pipeline import Pipeline\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.model_selection import train_test_split\nimport pandas as pd\n\ndf = pd.DataFrame({\n    'feature1': [1, 2, 3, 4, 5],\n    'feature2': [100, 200, 300, 400, 500],\n    'target': [0, 0, 1, 1, 1]\n})\n\nX = df[['feature1', 'feature2']]\ny = df['target']\n\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)\n\n# Define pipeline\npipeline = Pipeline([\n    ('scaler', StandardScaler()),\n    ('classifier', LogisticRegression())\n])\n\n# Fit (scales training data, trains on scaled data)\npipeline.fit(X_train, y_train)\n\n# Predict (scales test data, predicts on scaled data)\npredictions = pipeline.predict(X_test)\n\n# Access components\nprint(pipeline.named_steps['scaler'].mean_)  # Fitted scaler parameters\nprint(pipeline.named_steps['classifier'].coef_)  # Model weights"
