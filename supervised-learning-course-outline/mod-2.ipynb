          "python",
          "import pandas as pd\nimport numpy as np\n\ndf = pd.DataFrame({\n    'date': pd.date_range('2023-01-01', periods=10),\n    'price': [100, 105, 102, 110, 108, 115, 120, 118, 125, 130],\n    'quantity': [10, 12, 11, 15, 14, 18, 20, 19, 22, 25]\n})\n\n# Temporal features\ndf['month'] = df['date'].dt.month\ndf['day_of_week'] = df['date'].dt.dayofweek\ndf['is_weekend'] = df['day_of_week'].isin([5, 6]).astype(int)\n\n# Interaction features\ndf['revenue'] = df['price'] * df['quantity']\n\n# Polynomial features\ndf['price_squared'] = df['price'] ** 2\ndf['price_log'] = np.log(df['price'])\n\n# Rolling statistics (lag features for time series)\ndf['price_lag1'] = df['price'].shift(1)\ndf['price_ma3'] = df['price'].rolling(3).mean()\ndf['price_pct_change'] = df['price'].pct_change()\n\n# Binning continuous variables\ndf['price_category'] = pd.cut(df['price'], bins=3, labels=['low', 'medium', 'high'])\n\nprint(df)"
