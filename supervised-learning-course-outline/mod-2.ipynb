          "python",
          "import pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import StandardScaler, MinMaxScaler, RobustScaler\n\ndf = pd.DataFrame({\n    'age': [25, 30, 35, 40, 45],\n    'income': [50000, 60000, 75000, 80000, 100000],\n    'score': [0.5, 0.7, 0.8, 0.9, 0.95]\n})\n\n# Standardization: Mean=0, Std=1 (most common)\n# (x - mean) / std\nscaler = StandardScaler()\ndf_scaled = scaler.fit_transform(df)\nprint(df_scaled)  # Now has mean\u22480 and std\u22481\n\n# Normalization: Scale to [0, 1]\n# (x - min) / (max - min)\nscaler_minmax = MinMaxScaler()\ndf_normalized = scaler_minmax.fit_transform(df)\nprint(df_normalized)  # All values between 0 and 1\n\n# Robust scaling: Uses median and IQR (resistant to outliers)\nscaler_robust = RobustScaler()\ndf_robust = scaler_robust.fit_transform(df)\n\n# When to use each:\n# StandardScaler: Most algorithms (default)\n# MinMaxScaler: When you need bounded values [0, 1]\n# RobustScaler: When you have outliers\n\n# Important: Fit on training data, then transform test data\nX_train = df[:3]\nX_test = df[3:]\n\nscaler = StandardScaler()\nX_train_scaled = scaler.fit_transform(X_train)\nX_test_scaled = scaler.transform(X_test)  # Use fit scaler, don't fit again!"
        ]
