      "source": [
        [
          "python",
          "import pandas as pd\nimport numpy as np\nfrom sklearn.impute import SimpleImputer\n\ndf = pd.DataFrame({\n    'age': [25, np.nan, 35, 40, 22, np.nan],\n    'income': [50000, 75000, np.nan, 120000, 45000, 60000],\n    'education': ['HS', 'BA', 'HS', 'MA', 'BA', 'HS']\n})\n\n# Strategy 1: Remove rows with missing values (loses data)\ndf_dropped = df.dropna()\n\n# Strategy 2: Remove columns (if mostly missing)\ndf_dropped = df.dropna(thresh=len(df) * 0.5, axis=1)  # Keep columns with >50% non-missing\n\n# Strategy 3: Impute with mean (numeric)\nimputer_mean = SimpleImputer(strategy='mean')\ndf['age'] = imputer_mean.fit_transform(df[['age']])\n\n# Strategy 4: Impute with median (robust to outliers)\nimputer_median = SimpleImputer(strategy='median')\ndf['income'] = imputer_median.fit_transform(df[['income']])\n\n# Strategy 5: Forward fill (for time series)\ndf['value'].fillna(method='ffill', inplace=True)\n\n# Strategy 6: Backward fill\ndf['value'].fillna(method='bfill', inplace=True)\n\n# Strategy 7: Custom imputation\ndf['age'].fillna(df['age'].mean(), inplace=True)\n\nprint(df.isnull().sum())  # Verify no missing values remain"
        ]
