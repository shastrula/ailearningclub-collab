      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Example 1: y'' + 5y' + 6y = 0, y(0) = 2, y'(0) = 3\n# Exact: y = 9*e^(-2t) - 7*e^(-3t)\n\ndef system1(Y, t):\n    y, yp = Y\n    return [yp, -5*yp - 6*y]\n\nt = np.linspace(0, 3, 300)\nsol = odeint(system1, [2, 3], t)\ny_exact = 9*np.exp(-2*t) - 7*np.exp(-3*t)\n\nplt.figure(figsize=(10, 6))\nplt.plot(t, y_exact, 'b-', linewidth=2, label='Laplace method: 9e^(-2t) - 7e^(-3t)')\nplt.plot(t, sol[:, 0], 'r--', linewidth=2, label='Numerical (odeint)')\nplt.xlabel('t')\nplt.ylabel('y(t)')\nplt.title(\"Solving IVP via Laplace Transform\")\nplt.legend()\nplt.grid(True)\nplt.show()\n\nprint(f\"Max error: {np.max(np.abs(y_exact - sol[:, 0])):.2e}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# For y'' + 5y' + 6y = g(t), the transfer function is:\n# H(s) = 1/(s^2 + 5s + 6) = 1/((s+2)(s+3))\n# This relates input G(s) to output Y(s) (with zero ICs)\n\n# Frequency response: |H(i*omega)|\nomega = np.linspace(0, 10, 500)\ns = 1j * omega\nH = 1 / (s**2 + 5*s + 6)\n\nfig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8))\n\nax1.plot(omega, np.abs(H), 'b-', linewidth=2)\nax1.set_ylabel('|H(jw)|')\nax1.set_title('Transfer Function: H(s) = 1/(s\u00b2+5s+6)')\nax1.grid(True)\n\nax2.plot(omega, np.angle(H) * 180/np.pi, 'r-', linewidth=2)\nax2.set_xlabel('Frequency omega (rad/s)')\nax2.set_ylabel('Phase (degrees)')\nax2.grid(True)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# y'' + 4y = sin(3t) with different initial conditions\ndef system(Y, t):\n    return [Y[1], -4*Y[0] + np.sin(3*t)]\n\nt = np.linspace(0, 10, 500)\n\nplt.figure(figsize=(10, 6))\ninitial_conditions = [[0, 0], [1, 0], [0, 2], [1, -1]]\nfor y0, yp0 in initial_conditions:\n    sol = odeint(system, [y0, yp0], t)\n    plt.plot(t, sol[:, 0], linewidth=2, label=f'y(0)={y0}, y\\'(0)={yp0}')\n\nplt.xlabel('t')\nplt.ylabel('y(t)')\nplt.title(\"y'' + 4y = sin(3t): Effect of Initial Conditions\")\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    }
