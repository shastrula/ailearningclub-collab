      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Frequency response: amplitude vs driving frequency\nm = 1.0\nk = 100.0  # omega_0 = 10\nF0 = 1.0\nomega_0 = np.sqrt(k/m)\n\nomega_values = np.linspace(0.1, 20, 500)\n\nplt.figure(figsize=(10, 6))\nfor zeta in [0.05, 0.1, 0.2, 0.5, 1.0]:\n    c = 2 * zeta * np.sqrt(m*k)\n    X = F0 / np.sqrt((k - m*omega_values**2)**2 + (c*omega_values)**2)\n    M = X / (F0/k)  # magnification factor\n    plt.plot(omega_values/omega_0, M, linewidth=2, label=f'zeta = {zeta}')\n\nplt.xlabel('Frequency ratio (omega/omega_0)')\nplt.ylabel('Magnification factor M')\nplt.title('Resonance Curves for Forced Oscillator')\nplt.legend()\nplt.grid(True)\nplt.axvline(1, color='k', linestyle=':', alpha=0.5)\nplt.ylim(0, 12)\nplt.show()"
        ]
      ]
    },
    {
