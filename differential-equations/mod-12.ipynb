      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# m*x'' + c*x' + k*x = 0\nm = 1.0\nk = 4.0  # omega_0 = 2\nomega_0 = np.sqrt(k/m)\n\ndef spring_mass(Y, t, m, c, k):\n    x, v = Y\n    return [v, (-c*v - k*x) / m]\n\nt = np.linspace(0, 10, 1000)\nY0 = [1.0, 0.0]  # x(0) = 1, v(0) = 0\n\nplt.figure(figsize=(12, 8))\n\n# Underdamped (zeta = 0.2)\nc = 2 * 0.2 * np.sqrt(m*k)\nsol = odeint(spring_mass, Y0, t, args=(m, c, k))\nplt.plot(t, sol[:, 0], 'b-', linewidth=2, label=f'Underdamped (zeta=0.2)')\n\n# Critically damped (zeta = 1)\nc = 2 * np.sqrt(m*k)\nsol = odeint(spring_mass, Y0, t, args=(m, c, k))\nplt.plot(t, sol[:, 0], 'r-', linewidth=2, label=f'Critically damped (zeta=1)')\n\n# Overdamped (zeta = 2)\nc = 2 * 2.0 * np.sqrt(m*k)\nsol = odeint(spring_mass, Y0, t, args=(m, c, k))\nplt.plot(t, sol[:, 0], 'g-', linewidth=2, label=f'Overdamped (zeta=2)')\n\n# Undamped\nsol = odeint(spring_mass, Y0, t, args=(m, 0, k))\nplt.plot(t, sol[:, 0], 'k--', linewidth=1, label='Undamped')\n\nplt.xlabel('Time (s)')\nplt.ylabel('Displacement x(t)')\nplt.title('Spring-Mass System: Effect of Damping')\nplt.legend()\nplt.grid(True)\nplt.axhline(0, color='k', linewidth=0.5)\nplt.show()"
        ]
      ]
    },
    {
