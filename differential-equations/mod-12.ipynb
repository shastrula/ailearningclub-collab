      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Beating: driving frequency close to but not equal to natural frequency\n# x'' + 100x = cos(9.5t), omega_0 = 10, omega = 9.5\n\ndef forced_undamped(Y, t):\n    x, v = Y\n    return [v, -100*x + np.cos(9.5*t)]\n\nt = np.linspace(0, 40, 2000)\nsol = odeint(forced_undamped, [0, 0], t)\n\nplt.figure(figsize=(12, 5))\nplt.plot(t, sol[:, 0], 'b-', linewidth=1)\nplt.xlabel('Time (s)')\nplt.ylabel('Displacement')\nplt.title('Beat Phenomenon: omega_0 = 10, omega = 9.5')\nplt.grid(True)\nplt.show()"
        ]
      ]
    }
