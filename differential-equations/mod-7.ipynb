      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# y'' - y' - 6y = 0, y(0) = 2, y'(0) = 1\n# Convert to system: let y1 = y, y2 = y'\n# y1' = y2\n# y2' = y' + 6y = y2 + 6*y1\n\ndef second_order_system(Y, x):\n    y1, y2 = Y\n    dy1dx = y2\n    dy2dx = y2 + 6 * y1  # from y'' = y' + 6y\n    return [dy1dx, dy2dx]\n\nx = np.linspace(0, 1.5, 200)\nY0 = [2, 1]  # y(0) = 2, y'(0) = 1\nsol = odeint(second_order_system, Y0, x)\ny_numerical = sol[:, 0]\n\n# Exact solution\ny_exact = np.exp(3 * x) + np.exp(-2 * x)\n\nplt.figure(figsize=(10, 6))\nplt.plot(x, y_exact, 'b-', linewidth=2, label='Exact: e^(3x) + e^(-2x)')\nplt.plot(x, y_numerical, 'r--', linewidth=2, label='Numerical (odeint)')\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title(\"y'' - y' - 6y = 0, y(0) = 2, y'(0) = 1\")\nplt.legend()\nplt.grid(True)\nplt.show()\n\nprint(f\"Max error: {np.max(np.abs(y_exact - y_numerical)):.2e}\")"
        ]
      ]
    },
    {
