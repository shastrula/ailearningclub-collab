          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# y'' + 4y' + 13y = 0 -> damped oscillation\n# Solution: y = e^(-2x)[c1*cos(3x) + c2*sin(3x)]\n\ndef damped_system(Y, x):\n    y1, y2 = Y\n    dy1dx = y2\n    dy2dx = -4 * y2 - 13 * y1\n    return [dy1dx, dy2dx]\n\nx = np.linspace(0, 5, 500)\nY0 = [1, 0]  # y(0) = 1, y'(0) = 0\nsol = odeint(damped_system, Y0, x)\ny = sol[:, 0]\n\n# Envelope\nenvelope = np.exp(-2 * x)\n\nplt.figure(figsize=(10, 6))\nplt.plot(x, y, 'b-', linewidth=2, label='Solution')\nplt.plot(x, envelope, 'r--', alpha=0.7, label='Envelope: e^(-2x)')\nplt.plot(x, -envelope, 'r--', alpha=0.7)\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title(\"Damped Oscillation: y'' + 4y' + 13y = 0\")\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
