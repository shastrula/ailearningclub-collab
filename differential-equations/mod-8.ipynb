      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# y'' + b*y' + 4y = 0 with varying b (damping parameter)\n# Characteristic: r^2 + b*r + 4 = 0\n# Critical damping at b^2 = 16, so b = 4\n\ndef make_system(b):\n    def system(Y, x):\n        y1, y2 = Y\n        return [y2, -b * y2 - 4 * y1]\n    return system\n\nx = np.linspace(0, 8, 500)\nY0 = [1, 0]\n\nplt.figure(figsize=(12, 8))\nb_values = [0, 1, 2, 4, 6, 8]\nfor b in b_values:\n    sol = odeint(make_system(b), Y0, x)\n    D = b**2 - 16\n    root_type = \"undamped\" if b == 0 else (\"underdamped\" if D < 0 else (\"critical\" if D == 0 else \"overdamped\"))\n    plt.plot(x, sol[:, 0], linewidth=2, label=f'b={b} ({root_type})')\n\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title(\"Effect of Damping: y'' + b*y' + 4y = 0, y(0)=1, y'(0)=0\")\nplt.legend()\nplt.grid(True)\nplt.axhline(0, color='k', linewidth=0.5)\nplt.show()"
        ]
      ]
    },
    {
