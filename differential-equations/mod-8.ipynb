          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# y'' + 2y' + 10y = 0: alpha = -1, beta = 3\n# Period = 2*pi/3, frequency = 3/(2*pi)\n\ndef system(Y, x):\n    y1, y2 = Y\n    return [y2, -2*y2 - 10*y1]\n\nx = np.linspace(0, 10, 1000)\nsol = odeint(system, [2, 0], x)\ny = sol[:, 0]\n\n# Find zero crossings to estimate period\nzero_crossings = np.where(np.diff(np.sign(y)))[0]\nif len(zero_crossings) >= 4:\n    # Period = distance between every other zero crossing * 2\n    periods = np.diff(x[zero_crossings[::2]])\n    avg_period = np.mean(periods)\n    print(f\"Measured period: {avg_period:.4f}\")\n    print(f\"Theoretical period: {2*np.pi/3:.4f}\")\n\nplt.figure(figsize=(10, 6))\nplt.plot(x, y, 'b-', linewidth=2, label='Solution')\nenvelope = 2 * np.exp(-x) * np.sqrt(1 + (1/3)**2)\nplt.plot(x, envelope, 'r--', alpha=0.7, label='Envelope')\nplt.plot(x, -envelope, 'r--', alpha=0.7)\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title(\"Damped Oscillation: y'' + 2y' + 10y = 0\")\nplt.legend()\nplt.grid(True)\nplt.show()"
