        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Plot roots of r^2 + b*r + 4 = 0 as b varies\nb_values = np.linspace(0, 8, 100)\nplt.figure(figsize=(8, 8))\n\nreal_parts = []\nimag_parts = []\n\nfor b in b_values:\n    D = b**2 - 16\n    if D >= 0:\n        r1 = (-b + np.sqrt(D)) / 2\n        r2 = (-b - np.sqrt(D)) / 2\n        real_parts.extend([r1, r2])\n        imag_parts.extend([0, 0])\n    else:\n        alpha = -b / 2\n        beta = np.sqrt(-D) / 2\n        real_parts.extend([alpha, alpha])\n        imag_parts.extend([beta, -beta])\n\nplt.scatter(real_parts, imag_parts, c=np.repeat(b_values, 2), \n            cmap='viridis', s=10)\nplt.colorbar(label='Damping coefficient b')\nplt.xlabel('Real part')\nplt.ylabel('Imaginary part')\nplt.title('Root Locus: r\u00b2 + br + 4 = 0')\nplt.grid(True)\nplt.axhline(0, color='k', linewidth=0.5)\nplt.axvline(0, color='k', linewidth=0.5)\nplt.show()"
        ]
      ]
