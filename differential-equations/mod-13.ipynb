      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Response to suddenly applied DC voltage (step input)\n# L*q'' + R*q' + q/C = E_0 (constant for t > 0)\n\nL = 1.0\nC = 0.01\nE0 = 10.0\n\ndef rlc_step(Y, t, L, R, C, E0):\n    q, i = Y\n    dqdt = i\n    didt = (E0 - R*i - q/C) / L\n    return [dqdt, didt]\n\nt = np.linspace(0, 5, 500)\nY0 = [0.0, 0.0]\n\nplt.figure(figsize=(10, 6))\nfor R in [2, 5, 10, 20, 40]:\n    sol = odeint(rlc_step, Y0, t, args=(L, R, C, E0))\n    v_cap = sol[:, 0] / C  # voltage across capacitor\n    plt.plot(t, v_cap, linewidth=2, label=f'R = {R} ohms')\n\nplt.axhline(E0, color='k', linestyle=':', label='Steady state (E0)')\nplt.xlabel('Time (s)')\nplt.ylabel('Capacitor voltage (V)')\nplt.title('RLC Step Response: Voltage Across Capacitor')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    }
