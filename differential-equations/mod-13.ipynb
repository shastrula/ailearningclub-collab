      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# L*q'' + R*q' + (1/C)*q = 0\nL = 0.5   # Henry\nR = 4.0   # Ohms\nC = 0.02  # Farads\n\nomega_0 = 1/np.sqrt(L*C)\nzeta = R / (2*np.sqrt(L/C))\nprint(f\"Natural frequency: {omega_0:.2f} rad/s\")\nprint(f\"Damping ratio: {zeta:.3f}\")\nprint(f\"System is: {'underdamped' if zeta < 1 else 'overdamped'}\")\n\ndef rlc_free(Y, t, L, R, C):\n    q, i = Y  # q = charge, i = dq/dt = current\n    dqdt = i\n    didt = (-R*i - q/C) / L\n    return [dqdt, didt]\n\nt = np.linspace(0, 3, 500)\nY0 = [1.0, 0.0]  # q(0) = 1 C, i(0) = 0 A\nsol = odeint(rlc_free, Y0, t, args=(L, R, C))\n\nfig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8))\n\nax1.plot(t, sol[:, 0], 'b-', linewidth=2)\nax1.set_ylabel('Charge q(t) [Coulombs]')\nax1.set_title('Free RLC Circuit Response')\nax1.grid(True)\nax1.axhline(0, color='k', linewidth=0.5)\n\nax2.plot(t, sol[:, 1], 'r-', linewidth=2)\nax2.set_xlabel('Time (s)')\nax2.set_ylabel('Current i(t) [Amperes]')\nax2.grid(True)\nax2.axhline(0, color='k', linewidth=0.5)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Impedance and current amplitude vs frequency\nL = 0.1    # Henry\nC = 1e-4   # Farads (100 uF)\nE0 = 10    # Volts\nomega_0 = 1/np.sqrt(L*C)  # 316 rad/s\n\nomega = np.linspace(10, 700, 1000)\n\nfig, axes = plt.subplots(2, 1, figsize=(10, 8))\n\nfor R in [5, 10, 20, 50]:\n    Z = np.sqrt(R**2 + (omega*L - 1/(omega*C))**2)\n    I0 = E0 / Z\n    \n    axes[0].plot(omega, Z, linewidth=2, label=f'R = {R} ohms')\n    axes[1].plot(omega, I0, linewidth=2, label=f'R = {R} ohms')\n\naxes[0].axvline(omega_0, color='k', linestyle=':', alpha=0.5)\naxes[0].set_ylabel('Impedance Z (ohms)')\naxes[0].set_title('RLC Circuit Frequency Response')\naxes[0].legend()\naxes[0].grid(True)\n\naxes[1].axvline(omega_0, color='k', linestyle=':', alpha=0.5, label=f'omega_0 = {omega_0:.0f}')\naxes[1].set_xlabel('Angular frequency omega (rad/s)')\naxes[1].set_ylabel('Current amplitude I_0 (A)')\naxes[1].legend()\naxes[1].grid(True)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
