        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\nt = np.linspace(0, 5, 300)\ns = np.linspace(0.1, 5, 300)\n\nfig, axes = plt.subplots(3, 2, figsize=(12, 10))\n\n# Pair 1: e^(-t) <-> 1/(s+1)\naxes[0, 0].plot(t, np.exp(-t), 'b-', linewidth=2)\naxes[0, 0].set_title('f(t) = e^(-t)')\naxes[0, 0].set_xlabel('t')\naxes[0, 0].grid(True)\n\naxes[0, 1].plot(s, 1/(s+1), 'r-', linewidth=2)\naxes[0, 1].set_title('F(s) = 1/(s+1)')\naxes[0, 1].set_xlabel('s')\naxes[0, 1].grid(True)\n\n# Pair 2: sin(3t) <-> 3/(s^2+9)\naxes[1, 0].plot(t, np.sin(3*t), 'b-', linewidth=2)\naxes[1, 0].set_title('f(t) = sin(3t)')\naxes[1, 0].set_xlabel('t')\naxes[1, 0].grid(True)\n\naxes[1, 1].plot(s, 3/(s**2+9), 'r-', linewidth=2)\naxes[1, 1].set_title('F(s) = 3/(s\u00b2+9)')\naxes[1, 1].set_xlabel('s')\naxes[1, 1].grid(True)\n\n# Pair 3: t*e^(-2t) <-> 1/(s+2)^2\naxes[2, 0].plot(t, t*np.exp(-2*t), 'b-', linewidth=2)\naxes[2, 0].set_title('f(t) = t*e^(-2t)')\naxes[2, 0].set_xlabel('t')\naxes[2, 0].grid(True)\n\naxes[2, 1].plot(s, 1/(s+2)**2, 'r-', linewidth=2)\naxes[2, 1].set_title('F(s) = 1/(s+2)\u00b2')\naxes[2, 1].set_xlabel('s')\naxes[2, 1].grid(True)\n\nplt.suptitle('Laplace Transform Pairs: Time Domain vs s-Domain', fontsize=14)\nplt.tight_layout()\nplt.show()"
        ]
