      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import quad\nimport matplotlib.pyplot as plt\n\n# Verify L{sin(2t)} = 2/(s^2 + 4) numerically\n\ndef laplace_numerical(f, s, upper_limit=50):\n    \"\"\"Compute Laplace transform numerically.\"\"\"\n    integrand = lambda t: np.exp(-s*t) * f(t)\n    result, error = quad(integrand, 0, upper_limit)\n    return result\n\n# Test for several values of s\nf = lambda t: np.sin(2*t)\ns_values = np.linspace(0.5, 5, 20)\n\nF_numerical = [laplace_numerical(f, s) for s in s_values]\nF_exact = 2 / (s_values**2 + 4)\n\nplt.figure(figsize=(10, 6))\nplt.plot(s_values, F_exact, 'b-', linewidth=2, label='Exact: 2/(s\u00b2+4)')\nplt.plot(s_values, F_numerical, 'ro', markersize=8, label='Numerical integration')\nplt.xlabel('s')\nplt.ylabel('F(s)')\nplt.title('Laplace Transform of sin(2t): Verification')\nplt.legend()\nplt.grid(True)\nplt.show()\n\nprint(\"Max error:\", max(abs(np.array(F_numerical) - F_exact)))"
        ]
      ]
    },
    {
      "cell_type": "code",
