      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Nonlinear pendulum: theta'' + sin(theta) = 0 (g/L = 1)\ndef pendulum(Y, t):\n    theta, omega = Y\n    return [omega, -np.sin(theta)]\n\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))\n\n# Phase portrait\nfor E in np.linspace(0.1, 3.0, 15):\n    for sign in [1, -1]:\n        omega0 = sign * np.sqrt(2*E)\n        if abs(omega0) < 4:\n            t = np.linspace(0, 20, 1000)\n            sol = odeint(pendulum, [0, omega0], t)\n            ax1.plot(sol[:, 0], sol[:, 1], 'b-', linewidth=0.5, alpha=0.7)\n\n# Separatrix (energy = 2, passing through saddle)\nt = np.linspace(0.001, 20, 1000)\nsol = odeint(pendulum, [0.01, 2.0], t)\nax1.plot(sol[:, 0], sol[:, 1], 'r-', linewidth=2, label='Separatrix')\n\nax1.set_xlabel('theta')\nax1.set_ylabel('omega (angular velocity)')\nax1.set_title('Nonlinear Pendulum Phase Portrait')\nax1.set_xlim(-4, 4)\nax1.set_ylim(-4, 4)\nax1.grid(True, alpha=0.3)\nax1.legend()\n\n# Compare linear vs nonlinear for large angle\ntheta0_values = [0.1, 0.5, 1.0, 2.0, 3.0]\nfor theta0 in theta0_values:\n    t = np.linspace(0, 20, 1000)\n    sol = odeint(pendulum, [theta0, 0], t)\n    ax2.plot(t, sol[:, 0], linewidth=2, label=f'theta0 = {theta0:.1f}')\n\nax2.set_xlabel('Time')\nax2.set_ylabel('theta(t)')\nax2.set_title('Pendulum: Period Depends on Amplitude')\nax2.legend()\nax2.grid(True)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
