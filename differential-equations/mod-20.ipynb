          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Van der Pol oscillator: x'' - mu*(1-x^2)*x' + x = 0\nmu = 2.0\n\ndef vanderpol(Y, t):\n    x, y = Y\n    return [y, mu*(1 - x**2)*y - x]\n\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))\n\nt = np.linspace(0, 30, 3000)\n\n# Trajectories from inside and outside the limit cycle\nfor x0 in [0.1, 0.5, 4.0, -3.0]:\n    sol = odeint(vanderpol, [x0, 0], t)\n    ax1.plot(sol[:, 0], sol[:, 1], linewidth=1.5, label=f'x0={x0}')\n\nax1.set_xlabel('x')\nax1.set_ylabel('dx/dt')\nax1.set_title(f'Van der Pol Phase Portrait (mu={mu})')\nax1.legend()\nax1.grid(True)\n\n# Time series showing relaxation oscillation\nsol = odeint(vanderpol, [0.1, 0], t)\nax2.plot(t, sol[:, 0], 'b-', linewidth=2)\nax2.set_xlabel('Time')\nax2.set_ylabel('x(t)')\nax2.set_title(f'Van der Pol Time Series (mu={mu})')\nax2.grid(True)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
