        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Compare nonlinear pendulum with its linearization near theta = 0\ndef nonlinear(Y, t):\n    return [Y[1], -np.sin(Y[0])]\n\ndef linear(Y, t):\n    return [Y[1], -Y[0]]\n\nt = np.linspace(0, 20, 1000)\n\nplt.figure(figsize=(10, 6))\nfor theta0 in [0.1, 0.5, 1.0, 2.5]:\n    sol_nl = odeint(nonlinear, [theta0, 0], t)\n    sol_l = odeint(linear, [theta0, 0], t)\n    plt.plot(t, sol_nl[:, 0], 'b-', linewidth=2, alpha=0.7)\n    plt.plot(t, sol_l[:, 0], 'r--', linewidth=1.5, alpha=0.7)\n\nplt.plot([], [], 'b-', linewidth=2, label='Nonlinear (sin theta)')\nplt.plot([], [], 'r--', linewidth=1.5, label='Linear (theta)')\nplt.xlabel('Time')\nplt.ylabel('theta(t)')\nplt.title('Linearization Accuracy: Pendulum')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    }
