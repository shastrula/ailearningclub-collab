        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Measure global error vs step size\nf = lambda x, y: -2 * y\ny_exact_at_3 = np.exp(-6)  # y(3) for dy/dx = -2y, y(0) = 1\n\nh_values = [0.5, 0.25, 0.1, 0.05, 0.025, 0.01, 0.005]\nerrors = []\n\nfor h in h_values:\n    x, y = euler_method(f, 0, 1, 3, h)\n    error = abs(y[-1] - y_exact_at_3)\n    errors.append(error)\n\nplt.figure(figsize=(10, 6))\nplt.loglog(h_values, errors, 'bo-', linewidth=2, markersize=8, label='Measured error')\nplt.loglog(h_values, [h*0.5 for h in h_values], 'r--', linewidth=2, label='O(h) reference')\nplt.xlabel('Step size h')\nplt.ylabel('Global error |y_numerical - y_exact| at x=3')\nplt.title(\"Euler's Method: Error vs Step Size (First-Order Convergence)\")\nplt.legend()\nplt.grid(True)\nplt.show()\n\n# Verify first-order convergence\nfor i in range(1, len(errors)):\n    ratio = errors[i-1] / errors[i]\n    h_ratio = h_values[i-1] / h_values[i]\n    print(f\"h ratio: {h_ratio:.1f}, error ratio: {ratio:.2f} (expect ~{h_ratio:.1f} for O(h))\")"
        ]
      ]
