          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\ndef heun_method(f, x0, y0, x_end, h):\n    n_steps = int((x_end - x0) / h)\n    x = np.zeros(n_steps + 1)\n    y = np.zeros(n_steps + 1)\n    x[0], y[0] = x0, y0\n    \n    for i in range(n_steps):\n        k1 = f(x[i], y[i])\n        y_predict = y[i] + h * k1\n        k2 = f(x[i] + h, y_predict)\n        y[i+1] = y[i] + (h/2) * (k1 + k2)\n        x[i+1] = x[i] + h\n    \n    return x, y\n\nf = lambda x, y: -2*y + np.sin(x)\n# Compare Euler vs Heun\nh = 0.2\nx_e, y_e = euler_method(f, 0, 1, 5, h)\nx_h, y_h = heun_method(f, 0, 1, 5, h)\n\nfrom scipy.integrate import odeint\nx_ref = np.linspace(0, 5, 1000)\ny_ref = odeint(lambda y, x: -2*y + np.sin(x), 1, x_ref).flatten()\n\nplt.figure(figsize=(10, 6))\nplt.plot(x_ref, y_ref, 'k-', linewidth=2, label='Reference (odeint)')\nplt.plot(x_e, y_e, 'ro-', markersize=4, label=f'Euler (h={h})')\nplt.plot(x_h, y_h, 'bs-', markersize=4, label=f'Heun (h={h})')\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title(\"Euler vs Heun's Method\")\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
