          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\ndef euler_system(f, t0, y0, t_end, h):\n    \"\"\"Euler's method for systems.\"\"\"\n    n_steps = int((t_end - t0) / h)\n    t = np.zeros(n_steps + 1)\n    y = np.zeros((n_steps + 1, len(y0)))\n    t[0] = t0\n    y[0] = y0\n    \n    for i in range(n_steps):\n        y[i+1] = y[i] + h * np.array(f(t[i], y[i]))\n        t[i+1] = t[i] + h\n    \n    return t, y\n\n# Lotka-Volterra predator-prey\ndef predator_prey(t, Y):\n    x, y = Y\n    return [x*(1 - 0.5*y), y*(-0.75 + 0.25*x)]\n\nt, sol = euler_system(predator_prey, 0, [4.0, 2.0], 30, 0.01)\n\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))\nax1.plot(t, sol[:, 0], 'b-', label='Prey')\nax1.plot(t, sol[:, 1], 'r-', label='Predator')\nax1.set_xlabel('Time')\nax1.set_ylabel('Population')\nax1.set_title(\"Euler's Method: Predator-Prey System\")\nax1.legend()\nax1.grid(True)\n\nax2.plot(sol[:, 0], sol[:, 1], 'g-')\nax2.set_xlabel('Prey')\nax2.set_ylabel('Predator')\nax2.set_title('Phase Portrait')\nax2.grid(True)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
