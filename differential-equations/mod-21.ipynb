      "source": [
        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\ndef euler_method(f, x0, y0, x_end, h):\n    \"\"\"\n    Solve dy/dx = f(x, y) using Euler's method.\n    \n    Parameters:\n        f: function f(x, y) giving dy/dx\n        x0: initial x value\n        y0: initial y value\n        x_end: final x value\n        h: step size\n    \n    Returns:\n        x_values, y_values as numpy arrays\n    \"\"\"\n    n_steps = int((x_end - x0) / h)\n    x = np.zeros(n_steps + 1)\n    y = np.zeros(n_steps + 1)\n    x[0] = x0\n    y[0] = y0\n    \n    for i in range(n_steps):\n        y[i+1] = y[i] + h * f(x[i], y[i])\n        x[i+1] = x[i] + h\n    \n    return x, y\n\n# Example: dy/dx = -2y, y(0) = 1\n# Exact solution: y = e^(-2x)\nf = lambda x, y: -2 * y\n\nx_exact = np.linspace(0, 3, 300)\ny_exact = np.exp(-2 * x_exact)\n\nplt.figure(figsize=(10, 6))\nplt.plot(x_exact, y_exact, 'k-', linewidth=2, label='Exact: e^(-2x)')\n\nfor h in [0.5, 0.25, 0.1, 0.05]:\n    x_euler, y_euler = euler_method(f, 0, 1, 3, h)\n    plt.plot(x_euler, y_euler, 'o-', markersize=3, label=f'Euler h={h}')\n\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title(\"Euler's Method: dy/dx = -2y, y(0) = 1\")\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    },
