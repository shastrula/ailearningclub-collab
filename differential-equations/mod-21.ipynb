          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Stability demonstration: dy/dx = -20y, y(0) = 1\n# Stability requires h < 2/20 = 0.1\n\nf_stiff = lambda x, y: -20 * y\nx_exact = np.linspace(0, 1, 300)\ny_exact = np.exp(-20 * x_exact)\n\nplt.figure(figsize=(10, 6))\nplt.plot(x_exact, y_exact, 'k-', linewidth=2, label='Exact')\n\nfor h in [0.05, 0.09, 0.1, 0.11]:\n    x, y = euler_method(f_stiff, 0, 1, 1, h)\n    stable = \"stable\" if h < 0.1 else \"UNSTABLE\"\n    plt.plot(x, y, 'o-', markersize=4, label=f'h={h} ({stable})')\n\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title(\"Euler Stability: dy/dx = -20y (stability limit h < 0.1)\")\nplt.legend()\nplt.grid(True)\nplt.ylim(-2, 2)\nplt.show()"
        ]
      ]
