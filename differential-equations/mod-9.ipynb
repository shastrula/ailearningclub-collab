          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Find time to reach |y| < 0.01 for different damping values\n\ndef make_system(b):\n    def system(Y, x):\n        y1, y2 = Y\n        return [y2, -b * y2 - 9 * y1]\n    return system\n\nx = np.linspace(0, 10, 2000)\nY0 = [1, 0]\n\nb_values = np.linspace(1, 12, 50)\nsettling_times = []\n\nfor b in b_values:\n    sol = odeint(make_system(b), Y0, x)\n    y = sol[:, 0]\n    below_threshold = np.where(np.abs(y) < 0.01)[0]\n    if len(below_threshold) > 0:\n        # Check if it stays below\n        first_below = below_threshold[0]\n        if np.all(np.abs(y[first_below:]) < 0.01):\n            settling_times.append(x[first_below])\n        else:\n            settling_times.append(x[-1])\n    else:\n        settling_times.append(x[-1])\n\nplt.figure(figsize=(10, 6))\nplt.plot(b_values, settling_times, 'b-', linewidth=2)\nplt.axvline(6, color='r', linestyle='--', label='Critical damping (b=6)')\nplt.xlabel('Damping coefficient b')\nplt.ylabel('Settling time (|y| < 0.01)')\nplt.title('Settling Time vs Damping - Critical Damping is Optimal')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    }
