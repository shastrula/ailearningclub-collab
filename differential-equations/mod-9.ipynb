          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Compare underdamped, critically damped, and overdamped\n# y'' + b*y' + 9y = 0\n# Critical damping: b^2 = 36, so b = 6\n\ndef make_system(b):\n    def system(Y, x):\n        y1, y2 = Y\n        return [y2, -b * y2 - 9 * y1]\n    return system\n\nx = np.linspace(0, 5, 500)\nY0 = [1, 0]\n\nplt.figure(figsize=(10, 6))\n\n# Underdamped (b = 2)\nsol = odeint(make_system(2), Y0, x)\nplt.plot(x, sol[:, 0], 'b-', linewidth=2, label='Underdamped (b=2)')\n\n# Critically damped (b = 6, repeated root r = -3)\nsol = odeint(make_system(6), Y0, x)\nplt.plot(x, sol[:, 0], 'r-', linewidth=2, label='Critically damped (b=6)')\n\n# Exact critical: y = (1 + 3x)*e^(-3x)\ny_exact = (1 + 3*x) * np.exp(-3*x)\nplt.plot(x, y_exact, 'r--', linewidth=1, label='Exact: (1+3x)e^(-3x)')\n\n# Overdamped (b = 10)\nsol = odeint(make_system(10), Y0, x)\nplt.plot(x, sol[:, 0], 'g-', linewidth=2, label='Overdamped (b=10)')\n\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title(\"Critical Damping: y'' + by' + 9y = 0\")\nplt.legend()\nplt.grid(True)\nplt.axhline(0, color='k', linewidth=0.5)\nplt.show()"
        ]
