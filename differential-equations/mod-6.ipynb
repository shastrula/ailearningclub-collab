      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Two tanks in series, each 100 L\n# Inflow to Tank 1: 5 L/min at 1 kg/L\n# Tank 1 outflow goes to Tank 2, Tank 2 outflow leaves system\n\ndef two_tanks(Q, t):\n    Q1, Q2 = Q\n    V = 100  # volume of each tank\n    flow = 5  # flow rate L/min\n    c_in = 1  # inflow concentration kg/L\n    dQ1dt = flow * c_in - flow * Q1 / V\n    dQ2dt = flow * Q1 / V - flow * Q2 / V\n    return [dQ1dt, dQ2dt]\n\nt = np.linspace(0, 100, 500)\nQ0 = [0, 0]\nQ = odeint(two_tanks, Q0, t)\n\nplt.figure(figsize=(10, 6))\nplt.plot(t, Q[:, 0], 'b-', linewidth=2, label='Tank 1')\nplt.plot(t, Q[:, 1], 'r-', linewidth=2, label='Tank 2')\nplt.axhline(100, color='k', linestyle=':', label='Steady state = 100 kg')\nplt.xlabel('Time (minutes)')\nplt.ylabel('Salt (kg)')\nplt.title('Two Tanks in Series')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    }
