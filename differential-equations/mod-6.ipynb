    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Tank: 500 L, pure water initially\n# Inflow: 8 L/min at 0.05 kg/L, Outflow: 8 L/min\n\ndef mixing(Q, t):\n    rate_in = 8 * 0.05  # 0.4 kg/min\n    rate_out = 8 * Q / 500\n    return rate_in - rate_out\n\nt = np.linspace(0, 400, 500)\nQ0 = 0\nQ = odeint(mixing, Q0, t).flatten()\n\n# Exact solution\nQ_exact = 25 * (1 - np.exp(-0.016 * t))\n\nplt.figure(figsize=(10, 6))\nplt.plot(t, Q, 'b-', linewidth=2, label='Numerical')\nplt.plot(t, Q_exact, 'r--', linewidth=2, label='Exact: 25(1 - e^(-0.016t))')\nplt.axhline(25, color='g', linestyle=':', label='Steady state = 25 kg')\nplt.xlabel('Time (minutes)')\nplt.ylabel('Salt in tank (kg)')\nplt.title('Mixing Problem: Constant Volume Tank')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\ndef cooling(T, t, k, T_env):\n    return -k * (T - T_env)\n\nt = np.linspace(0, 60, 300)\nT_env = 20\nT0 = 90\nk = 0.0673\n\nT = odeint(cooling, T0, t, args=(k, T_env)).flatten()\nT_exact = T_env + (T0 - T_env) * np.exp(-k * t)\n\nplt.figure(figsize=(10, 6))\nplt.plot(t, T, 'b-', linewidth=2, label='Numerical')\nplt.plot(t, T_exact, 'r--', linewidth=2, label='Exact')\nplt.axhline(T_env, color='g', linestyle=':', label=f'Ambient = {T_env}C')\nplt.axhline(40, color='orange', linestyle=':', alpha=0.7)\nplt.xlabel('Time (minutes)')\nplt.ylabel('Temperature (C)')\nplt.title(\"Newton's Law of Cooling: Coffee Example\")\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
