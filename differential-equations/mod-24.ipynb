          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Heat equation: du/dt = d^2u/dx^2 on [0, 1]\n# IC: u(x,0) = x (ramp)\n# BC: u(0,t) = 0, u(1,t) = 0\n\nL = 1.0\nk = 1.0\nNx = 100\ndx = L / Nx\nx = np.linspace(0, L, Nx + 1)\n\n# Exact solution using Fourier series (N_terms)\ndef heat_exact(x, t, N_terms=50):\n    u = np.zeros_like(x)\n    for n in range(1, N_terms + 1):\n        Bn = 2 * (-1)**(n+1) / (n * np.pi)\n        u += Bn * np.sin(n * np.pi * x) * np.exp(-n**2 * np.pi**2 * k * t)\n    return u\n\nplt.figure(figsize=(12, 6))\ntimes = [0, 0.001, 0.005, 0.01, 0.05, 0.1, 0.5]\ncolors = plt.cm.plasma(np.linspace(0, 1, len(times)))\n\nfor t_val, color in zip(times, colors):\n    u = heat_exact(x, t_val)\n    plt.plot(x, u, '-', color=color, linewidth=2, label=f't = {t_val}')\n\nplt.xlabel('x')\nplt.ylabel('u(x, t)')\nplt.title('Heat Equation: Diffusion of Initial Ramp')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
