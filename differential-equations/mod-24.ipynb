        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Energy in wave equation is conserved; energy in heat equation dissipates\n\n# Wave energy: E = (1/2)*integral[u_t^2 + c^2*u_x^2]dx\n# Heat \"energy\" (L2 norm): ||u||^2 = integral[u^2]dx\n\nx = np.linspace(0, 1, 200)\ndx_val = x[1] - x[0]\nt_values = np.linspace(0, 1, 100)\n\nheat_energy = []\nwave_energy = []\n\nfor t in t_values:\n    # Heat solution energy (L2 norm squared)\n    u_heat = np.zeros_like(x)\n    for n in range(1, 20):\n        Bn = 2*(1 - (-1)**n)/(n*np.pi)\n        u_heat += Bn * np.sin(n*np.pi*x) * np.exp(-n**2*np.pi**2*t)\n    heat_energy.append(np.sum(u_heat**2) * dx_val)\n    \n    # Wave solution energy (L2 norm squared)\n    u_wave = np.zeros_like(x)\n    for n in range(1, 20):\n        An = 2*(1 - (-1)**n)/(n*np.pi)\n        u_wave += An * np.sin(n*np.pi*x) * np.cos(n*np.pi*t)\n    wave_energy.append(np.sum(u_wave**2) * dx_val)\n\nplt.figure(figsize=(10, 6))\nplt.plot(t_values, heat_energy, 'r-', linewidth=2, label='Heat equation (dissipates)')\nplt.plot(t_values, wave_energy, 'b-', linewidth=2, label='Wave equation (oscillates)')\nplt.xlabel('Time')\nplt.ylabel('||u||\u00b2 (L2 norm squared)')\nplt.title('Energy: Heat Dissipates, Wave Conserves')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
