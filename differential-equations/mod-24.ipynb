          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Same initial condition, different equations\n# Shows fundamental difference in behavior\n\nx = np.linspace(0, 1, 200)\n\ndef heat_solution(x, t, N=50):\n    u = np.zeros_like(x)\n    for n in range(1, N+1):\n        Bn = 2 * (1 - (-1)**n) / (n * np.pi)  # for IC = 1 (odd extension)\n        u += Bn * np.sin(n*np.pi*x) * np.exp(-n**2*np.pi**2*t)\n    return u\n\ndef wave_solution(x, t, N=50):\n    u = np.zeros_like(x)\n    for n in range(1, N+1):\n        An = 2 * (1 - (-1)**n) / (n * np.pi)\n        u += An * np.sin(n*np.pi*x) * np.cos(n*np.pi*t)\n    return u\n\nfig, axes = plt.subplots(2, 4, figsize=(16, 8))\ntimes = [0, 0.01, 0.05, 0.2]\n\nfor idx, t in enumerate(times):\n    axes[0, idx].plot(x, heat_solution(x, t), 'r-', linewidth=2)\n    axes[0, idx].set_title(f'Heat: t = {t}')\n    axes[0, idx].set_ylim(-0.5, 1.5)\n    axes[0, idx].grid(True)\n    \n    axes[1, idx].plot(x, wave_solution(x, t), 'b-', linewidth=2)\n    axes[1, idx].set_title(f'Wave: t = {t}')\n    axes[1, idx].set_ylim(-1.5, 1.5)\n    axes[1, idx].grid(True)\n\naxes[0, 0].set_ylabel('Heat equation')\naxes[1, 0].set_ylabel('Wave equation')\nplt.suptitle('Heat vs Wave: Same Initial Condition, Different Physics', fontsize=14)\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
