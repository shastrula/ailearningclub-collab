          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Wave equation: d^2u/dt^2 = c^2 * d^2u/dx^2\n# Using explicit finite differences\n# IC: u(x,0) = sin(pi*x) + 0.5*sin(3*pi*x), du/dt(x,0) = 0\n\nc = 1.0\nL = 1.0\nNx = 200\ndx = L / Nx\ndt = 0.4 * dx / c  # CFL condition: c*dt/dx <= 1\nr = (c * dt / dx)**2\n\nx = np.linspace(0, L, Nx + 1)\nt_end = 2.0\nNt = int(t_end / dt)\n\n# Initial conditions\nu_prev = np.sin(np.pi * x) + 0.5 * np.sin(3 * np.pi * x)\nu_prev[0] = u_prev[-1] = 0\n\n# First time step (using du/dt(x,0) = 0)\nu_curr = np.zeros(Nx + 1)\nfor i in range(1, Nx):\n    u_curr[i] = u_prev[i] + 0.5*r*(u_prev[i+1] - 2*u_prev[i] + u_prev[i-1])\nu_curr[0] = u_curr[-1] = 0\n\n# Store snapshots\nsnapshots = {0: u_prev.copy()}\nsave_steps = [int(0.25/dt), int(0.5/dt), int(0.75/dt), int(1.0/dt), int(1.5/dt)]\n\nfor n in range(1, Nt):\n    u_next = np.zeros(Nx + 1)\n    for i in range(1, Nx):\n        u_next[i] = 2*u_curr[i] - u_prev[i] + r*(u_curr[i+1] - 2*u_curr[i] + u_curr[i-1])\n    u_next[0] = u_next[-1] = 0\n    \n    u_prev = u_curr.copy()\n    u_curr = u_next.copy()\n    \n    if n in save_steps:\n        snapshots[n*dt] = u_curr.copy()\n\nplt.figure(figsize=(12, 6))\nfor t_val, u_snap in sorted(snapshots.items()):\n    plt.plot(x, u_snap, linewidth=2, label=f't = {t_val:.2f}')\n\nplt.xlabel('x')\nplt.ylabel('u(x, t)')\nplt.title('Wave Equation: Vibrating String')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
