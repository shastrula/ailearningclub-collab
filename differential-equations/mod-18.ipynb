      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nfrom scipy.linalg import expm, eig\nimport matplotlib.pyplot as plt\n\n# System: dx/dt = A*x\nA = np.array([[1, 4], [1, 1]])\n\n# Find eigenvalues and eigenvectors\neigenvalues, eigenvectors = eig(A)\nprint(\"Eigenvalues:\", eigenvalues)\nprint(\"Eigenvectors:\\n\", eigenvectors)\n\n# Solve numerically\ndef linear_system(x, t, A):\n    return A @ x\n\nt = np.linspace(0, 2, 200)\nx0 = np.array([1.0, 0.0])\nsol = odeint(linear_system, x0, t, args=(A,))\n\n# Solve via matrix exponential\nx_exact = np.array([expm(A*ti) @ x0 for ti in t])\n\nplt.figure(figsize=(10, 6))\nplt.plot(t, sol[:, 0], 'b-', linewidth=2, label='x1 (numerical)')\nplt.plot(t, sol[:, 1], 'r-', linewidth=2, label='x2 (numerical)')\nplt.plot(t, x_exact[:, 0], 'b--', linewidth=2, label='x1 (matrix exp)')\nplt.plot(t, x_exact[:, 1], 'r--', linewidth=2, label='x2 (matrix exp)')\nplt.xlabel('t')\nplt.ylabel('x(t)')\nplt.title('Linear System via Eigenvalues and Matrix Exponential')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    },
