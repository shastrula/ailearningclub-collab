      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# A = [[1, 4], [1, 1]], eigenvalues 3, -1\nA = np.array([[1, 4], [1, 1]])\n\ndef system(x, t):\n    return A @ x\n\n# Plot multiple trajectories\nplt.figure(figsize=(8, 8))\n\n# Initial conditions on a circle\nangles = np.linspace(0, 2*np.pi, 12, endpoint=False)\nfor theta in angles:\n    x0 = 2*np.array([np.cos(theta), np.sin(theta)])\n    t = np.linspace(0, 1.5, 200)\n    sol = odeint(system, x0, t)\n    plt.plot(sol[:, 0], sol[:, 1], 'b-', linewidth=1)\n    plt.arrow(sol[-2, 0], sol[-2, 1], sol[-1, 0]-sol[-2, 0], sol[-1, 1]-sol[-2, 1],\n              head_width=0.2, head_length=0.1, fc='b', ec='b')\n\n# Draw eigenvectors\nplt.quiver(0, 0, 2, 1, angles='xy', scale_units='xy', scale=1, color='r', width=0.02, label='v1 (lambda=3)')\nplt.quiver(0, 0, 2, -1, angles='xy', scale_units='xy', scale=1, color='g', width=0.02, label='v2 (lambda=-1)')\n\nplt.xlabel('x1')\nplt.ylabel('x2')\nplt.title('Phase Portrait: Saddle Point')\nplt.legend()\nplt.grid(True)\nplt.xlim(-5, 5)\nplt.ylim(-5, 5)\nplt.axis('equal')\nplt.show()"
        ]
      ]
    },
