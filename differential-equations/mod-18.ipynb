        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Different types of equilibria based on eigenvalue structure\ncases = {\n    'Stable Node\\n(lambda: -1, -3)': np.array([[-1, 0], [0, -3]]),\n    'Unstable Node\\n(lambda: 1, 2)': np.array([[1, 0], [0, 2]]),\n    'Saddle\\n(lambda: 1, -2)': np.array([[1, 0], [0, -2]]),\n    'Stable Spiral\\n(lambda: -0.5+/-2i)': np.array([[-0.5, 2], [-2, -0.5]]),\n    'Center\\n(lambda: +/-2i)': np.array([[0, 2], [-2, 0]]),\n    'Unstable Spiral\\n(lambda: 0.3+/-2i)': np.array([[0.3, 2], [-2, 0.3]])\n}\n\nfig, axes = plt.subplots(2, 3, figsize=(15, 10))\naxes = axes.flatten()\n\nfor idx, (title, A) in enumerate(cases.items()):\n    ax = axes[idx]\n    angles = np.linspace(0, 2*np.pi, 8, endpoint=False)\n    for theta in angles:\n        x0 = np.array([np.cos(theta), np.sin(theta)])\n        t = np.linspace(0, 5, 500)\n        sol = odeint(lambda x, t: A @ x, x0, t)\n        ax.plot(sol[:, 0], sol[:, 1], 'b-', linewidth=0.8)\n    ax.set_title(title, fontsize=10)\n    ax.set_xlim(-3, 3)\n    ax.set_ylim(-3, 3)\n    ax.grid(True, alpha=0.3)\n    ax.set_aspect('equal')\n    ax.plot(0, 0, 'ko', markersize=5)\n\nplt.suptitle('Classification of Equilibria by Eigenvalues', fontsize=14)\nplt.tight_layout()\nplt.show()"
        ]
      ]
    }
