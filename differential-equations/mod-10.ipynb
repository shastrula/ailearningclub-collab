      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# y'' - 3y' + 2y = 4x^2, y(0) = 0, y'(0) = 0\n# y_c = c1*e^x + c2*e^(2x), y_p = 2x^2 + 6x + 7\n\ndef non_homogeneous(Y, x):\n    y1, y2 = Y\n    return [y2, 3*y2 - 2*y1 + 4*x**2]\n\nx = np.linspace(0, 3, 300)\nY0 = [0, 0]\nsol = odeint(non_homogeneous, Y0, x)\ny_num = sol[:, 0]\n\n# Find exact solution with ICs\n# y = c1*e^x + c2*e^(2x) + 2x^2 + 6x + 7\n# y(0) = c1 + c2 + 7 = 0 -> c1 + c2 = -7\n# y'(0) = c1 + 2*c2 + 6 = 0 -> c1 + 2*c2 = -6\n# c2 = 1, c1 = -8\ny_exact = -8*np.exp(x) + np.exp(2*x) + 2*x**2 + 6*x + 7\n\nplt.figure(figsize=(10, 6))\nplt.plot(x, y_exact, 'b-', linewidth=2, label='Exact')\nplt.plot(x, y_num, 'r--', linewidth=2, label='Numerical')\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title(\"y'' - 3y' + 2y = 4x\u00b2, y(0)=0, y'(0)=0\")\nplt.legend()\nplt.grid(True)\nplt.show()\n\nprint(f\"Max error: {np.max(np.abs(y_exact - y_num)):.2e}\")"
        ]
      ]
    },
    {
