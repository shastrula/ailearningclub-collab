        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# y'' + 4y = cos(omega*x)\n# Natural frequency = 2. What happens as omega approaches 2?\n\ndef forced_oscillator(Y, x, omega):\n    y1, y2 = Y\n    return [y2, -4*y1 + np.cos(omega*x)]\n\nx = np.linspace(0, 30, 1000)\nY0 = [0, 0]\n\nplt.figure(figsize=(12, 8))\nfor omega in [1.0, 1.5, 1.8, 1.95, 2.0]:\n    sol = odeint(forced_oscillator, Y0, x, args=(omega,))\n    plt.plot(x, sol[:, 0], linewidth=1.5, label=f'omega = {omega}')\n\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title(\"Forced Oscillator y'' + 4y = cos(wx): Approaching Resonance\")\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    }
