        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint, cumulative_trapezoid\nimport matplotlib.pyplot as plt\n\n# General variation of parameters solver\n# y'' + P(x)*y' + Q(x)*y = g(x)\n\ndef variation_of_parameters(y1_func, y2_func, y1p_func, y2p_func, g_func, x_array):\n    \"\"\"Compute particular solution using variation of parameters.\"\"\"\n    y1 = y1_func(x_array)\n    y2 = y2_func(x_array)\n    y1p = y1p_func(x_array)\n    y2p = y2p_func(x_array)\n    g = g_func(x_array)\n    \n    W = y1 * y2p - y2 * y1p\n    \n    u1_prime = -y2 * g / W\n    u2_prime = y1 * g / W\n    \n    u1 = cumulative_trapezoid(u1_prime, x_array, initial=0)\n    u2 = cumulative_trapezoid(u2_prime, x_array, initial=0)\n    \n    y_p = u1 * y1 + u2 * y2\n    return y_p\n\n# Example: y'' + y = tan(x)\nx = np.linspace(0.01, 1.4, 300)\ny_p = variation_of_parameters(\n    lambda x: np.cos(x), lambda x: np.sin(x),\n    lambda x: -np.sin(x), lambda x: np.cos(x),\n    lambda x: np.tan(x), x\n)\n\nplt.figure(figsize=(10, 6))\nplt.plot(x, y_p, 'b-', linewidth=2, label='y_p (numerical integration)')\nplt.xlabel('x')\nplt.ylabel('y_p')\nplt.title(\"Particular solution of y'' + y = tan(x) via variation of parameters\")\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
