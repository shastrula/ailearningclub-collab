      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint, quad\nimport matplotlib.pyplot as plt\n\n# y'' + y = sec(x), y(0) = 0, y'(0) = 0\n\ndef system(Y, x):\n    y1, y2 = Y\n    g = 1.0 / np.cos(x) if abs(np.cos(x)) > 1e-10 else 0.0\n    return [y2, -y1 + g]\n\nx = np.linspace(0, 1.4, 300)  # stay away from x = pi/2\nY0 = [0, 0]\nsol = odeint(system, Y0, x)\ny_num = sol[:, 0]\n\n# Exact particular solution: cos(x)*ln|cos(x)| + x*sin(x)\n# With y(0) = 0: c1 + 0 = 0 -> but y_p(0) = cos(0)*ln(1) + 0 = 0, so c1 = 0\n# y'(0) = c2 + ..., need to compute y_p'(0)\n# y_p' = -sin(x)*ln|cos(x)| + cos(x)*(-sin(x)/cos(x)) + sin(x) + x*cos(x)\n#       = -sin(x)*ln|cos(x)| - sin(x) + sin(x) + x*cos(x)\n#       = -sin(x)*ln|cos(x)| + x*cos(x)\n# y_p'(0) = 0\n# So c2 = 0\n\ny_exact = np.cos(x) * np.log(np.abs(np.cos(x))) + x * np.sin(x)\n\nplt.figure(figsize=(10, 6))\nplt.plot(x, y_num, 'b-', linewidth=2, label='Numerical')\nplt.plot(x, y_exact, 'r--', linewidth=2, label='Exact (variation of parameters)')\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title(\"y'' + y = sec(x), solved by variation of parameters\")\nplt.legend()\nplt.grid(True)\nplt.show()\n\nprint(f\"Max error: {np.max(np.abs(y_exact - y_num)):.6f}\")"
        ]
      ]
    },
    {
