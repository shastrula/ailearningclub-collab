          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\ndef rk4_system(f, t0, y0, t_end, h):\n    \"\"\"RK4 for systems of ODEs.\"\"\"\n    n = int((t_end - t0) / h)\n    t = np.zeros(n + 1)\n    y = np.zeros((n + 1, len(y0)))\n    t[0] = t0\n    y[0] = np.array(y0)\n    \n    for i in range(n):\n        yi = y[i]\n        k1 = np.array(f(t[i], yi))\n        k2 = np.array(f(t[i] + h/2, yi + h/2*k1))\n        k3 = np.array(f(t[i] + h/2, yi + h/2*k2))\n        k4 = np.array(f(t[i] + h, yi + h*k3))\n        y[i+1] = yi + (h/6)*(k1 + 2*k2 + 2*k3 + k4)\n        t[i+1] = t[i] + h\n    \n    return t, y\n\n# Lorenz system (chaotic)\nsigma, rho, beta = 10, 28, 8/3\n\ndef lorenz(t, Y):\n    x, y, z = Y\n    return [sigma*(y - x), x*(rho - z) - y, x*y - beta*z]\n\nt, sol = rk4_system(lorenz, 0, [1, 1, 1], 50, 0.005)\n\nfig = plt.figure(figsize=(12, 5))\nax1 = fig.add_subplot(121, projection='3d')\nax1.plot(sol[:, 0], sol[:, 1], sol[:, 2], linewidth=0.5)\nax1.set_xlabel('x')\nax1.set_ylabel('y')\nax1.set_zlabel('z')\nax1.set_title('Lorenz Attractor (RK4)')\n\nax2 = fig.add_subplot(122)\nax2.plot(t[:5000], sol[:5000, 0], linewidth=0.5)\nax2.set_xlabel('Time')\nax2.set_ylabel('x(t)')\nax2.set_title('Lorenz x-component')\nax2.grid(True)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
