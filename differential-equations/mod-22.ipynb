          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\ndef rk4(f, x0, y0, x_end, h):\n    \"\"\"Classical 4th-order Runge-Kutta method.\"\"\"\n    n_steps = int((x_end - x0) / h)\n    x = np.zeros(n_steps + 1)\n    y = np.zeros(n_steps + 1)\n    x[0], y[0] = x0, y0\n    \n    for i in range(n_steps):\n        k1 = f(x[i], y[i])\n        k2 = f(x[i] + h/2, y[i] + h/2 * k1)\n        k3 = f(x[i] + h/2, y[i] + h/2 * k2)\n        k4 = f(x[i] + h, y[i] + h * k3)\n        y[i+1] = y[i] + (h/6) * (k1 + 2*k2 + 2*k3 + k4)\n        x[i+1] = x[i] + h\n    \n    return x, y\n\n# Test: dy/dx = -2y + sin(x), y(0) = 1\nf = lambda x, y: -2*y + np.sin(x)\n\n# Compare with exact (via high-precision odeint)\nfrom scipy.integrate import odeint\nx_ref = np.linspace(0, 5, 10000)\ny_ref = odeint(lambda y, x: -2*y + np.sin(x), 1, x_ref).flatten()\n\nplt.figure(figsize=(10, 6))\nplt.plot(x_ref, y_ref, 'k-', linewidth=2, label='Reference solution')\n\nfor h in [0.5, 0.25, 0.1]:\n    x_rk, y_rk = rk4(f, 0, 1, 5, h)\n    plt.plot(x_rk, y_rk, 'o-', markersize=4, label=f'RK4 h={h}')\n\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title('Classical RK4 Method')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
