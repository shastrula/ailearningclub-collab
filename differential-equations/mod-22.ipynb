          "python",
          "import numpy as np\nfrom scipy.integrate import solve_ivp\nimport matplotlib.pyplot as plt\n\n# solve_ivp uses adaptive RK45 by default\ndef system(t, Y):\n    x, y = Y\n    return [y, -np.sin(x) - 0.5*y]  # damped pendulum\n\nsol = solve_ivp(system, [0, 20], [2.0, 0.0], \n                method='RK45', max_step=0.1, dense_output=True)\n\nt = np.linspace(0, 20, 1000)\ny = sol.sol(t)\n\nplt.figure(figsize=(10, 6))\nplt.plot(t, y[0], 'b-', linewidth=2, label='theta(t)')\nplt.plot(t, y[1], 'r-', linewidth=2, label='omega(t)')\nplt.xlabel('Time')\nplt.ylabel('Value')\nplt.title('Damped Pendulum via solve_ivp (RK45)')\nplt.legend()\nplt.grid(True)\nplt.show()\n\nprint(f\"Number of function evaluations: {sol.nfev}\")\nprint(f\"Number of steps: {len(sol.t)}\")"
        ]
