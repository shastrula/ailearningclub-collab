          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\ndef rk45_adaptive(f, x0, y0, x_end, tol=1e-6):\n    \"\"\"Adaptive RK4(5) method (simplified Dormand-Prince style).\"\"\"\n    x_vals = [x0]\n    y_vals = [y0]\n    h = 0.1  # initial step\n    x, y = x0, y0\n    \n    while x < x_end:\n        if x + h > x_end:\n            h = x_end - x\n        \n        # RK4 step\n        k1 = f(x, y)\n        k2 = f(x + h/2, y + h/2*k1)\n        k3 = f(x + h/2, y + h/2*k2)\n        k4 = f(x + h, y + h*k3)\n        y_rk4 = y + (h/6)*(k1 + 2*k2 + 2*k3 + k4)\n        \n        # Two half-steps for error estimate\n        h2 = h/2\n        k1a = f(x, y)\n        k2a = f(x + h2/2, y + h2/2*k1a)\n        k3a = f(x + h2/2, y + h2/2*k2a)\n        k4a = f(x + h2, y + h2*k3a)\n        y_half = y + (h2/6)*(k1a + 2*k2a + 2*k3a + k4a)\n        \n        k1b = f(x + h2, y_half)\n        k2b = f(x + h2 + h2/2, y_half + h2/2*k1b)\n        k3b = f(x + h2 + h2/2, y_half + h2/2*k2b)\n        k4b = f(x + h, y_half + h2*k3b)\n        y_double = y_half + (h2/6)*(k1b + 2*k2b + 2*k3b + k4b)\n        \n        # Error estimate\n        err = abs(y_double - y_rk4)\n        \n        if err < tol or h < 1e-10:\n            x = x + h\n            y = y_double  # use more accurate value\n            x_vals.append(x)\n            y_vals.append(y)\n            if err < tol/10:\n                h = min(h * 2, 1.0)\n        else:\n            h = h * 0.5\n    \n    return np.array(x_vals), np.array(y_vals)\n\n# Problem with varying behavior: dy/dx = -50*(y - cos(x))\n# Solution changes rapidly, requiring adaptation\nf_stiff = lambda x, y: -50*(y - np.cos(x))\n\nx_adapt, y_adapt = rk45_adaptive(f_stiff, 0, 1, 5, tol=1e-6)\nx_exact = np.linspace(0, 5, 1000)\ny_exact = np.cos(x_exact) + (1 - 1)*np.exp(-50*x_exact)  # approximately cos(x)\n\nfig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8))\nax1.plot(x_adapt, y_adapt, 'b.-', markersize=4, label='Adaptive RK4')\nax1.plot(x_exact, np.cos(x_exact), 'r-', alpha=0.5, label='cos(x)')\nax1.set_ylabel('y')\nax1.set_title('Adaptive Step Size: Semi-Stiff Problem')\nax1.legend()\nax1.grid(True)\n\n# Show step sizes used\nsteps = np.diff(x_adapt)\nax2.plot(x_adapt[:-1], steps, 'g-', linewidth=2)\nax2.set_xlabel('x')\nax2.set_ylabel('Step size h')\nax2.set_title(f'Adaptive Steps ({len(x_adapt)} total points)')\nax2.grid(True)\n\nplt.tight_layout()\nplt.show()"
