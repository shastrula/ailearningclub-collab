          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\ndef euler(f, x0, y0, x_end, h):\n    n = int((x_end - x0) / h)\n    x = np.zeros(n + 1)\n    y = np.zeros(n + 1)\n    x[0], y[0] = x0, y0\n    for i in range(n):\n        y[i+1] = y[i] + h * f(x[i], y[i])\n        x[i+1] = x[i] + h\n    return x, y\n\ndef rk2_midpoint(f, x0, y0, x_end, h):\n    n = int((x_end - x0) / h)\n    x = np.zeros(n + 1)\n    y = np.zeros(n + 1)\n    x[0], y[0] = x0, y0\n    for i in range(n):\n        k1 = f(x[i], y[i])\n        k2 = f(x[i] + h/2, y[i] + h/2*k1)\n        y[i+1] = y[i] + h * k2\n        x[i+1] = x[i] + h\n    return x, y\n\n# Test problem: dy/dx = y*cos(x), y(0) = 1, exact: y = e^(sin(x))\nf = lambda x, y: y * np.cos(x)\ny_exact = lambda x: np.exp(np.sin(x))\n\nx_end = 5.0\nh_values = np.array([0.5, 0.25, 0.125, 0.0625, 0.03125, 0.015625])\nerrors_euler = []\nerrors_rk2 = []\nerrors_rk4 = []\n\nfor h in h_values:\n    _, y_e = euler(f, 0, 1, x_end, h)\n    _, y_r2 = rk2_midpoint(f, 0, 1, x_end, h)\n    _, y_r4 = rk4(f, 0, 1, x_end, h)\n    \n    errors_euler.append(abs(y_e[-1] - y_exact(x_end)))\n    errors_rk2.append(abs(y_r2[-1] - y_exact(x_end)))\n    errors_rk4.append(abs(y_r4[-1] - y_exact(x_end)))\n\nplt.figure(figsize=(10, 7))\nplt.loglog(h_values, errors_euler, 'ro-', linewidth=2, label='Euler O(h)')\nplt.loglog(h_values, errors_rk2, 'gs-', linewidth=2, label='RK2 O(h\u00b2)')\nplt.loglog(h_values, errors_rk4, 'b^-', linewidth=2, label='RK4 O(h\u2074)')\n\n# Reference lines\nplt.loglog(h_values, h_values*2, 'r--', alpha=0.5)\nplt.loglog(h_values, h_values**2*5, 'g--', alpha=0.5)\nplt.loglog(h_values, h_values**4*50, 'b--', alpha=0.5)\n\nplt.xlabel('Step size h')\nplt.ylabel('Global error at x = 5')\nplt.title('Convergence: Euler vs RK2 vs RK4')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
