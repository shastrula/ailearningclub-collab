      "source": [
        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Direction field for dy/dx = x - y\ndef f(x, y):\n    return x - y\n\nx_vals = np.linspace(-3, 3, 20)\ny_vals = np.linspace(-3, 3, 20)\nX, Y = np.meshgrid(x_vals, y_vals)\nU = np.ones_like(X)\nV = f(X, Y)\n\n# Normalize arrows for uniform length\nN = np.sqrt(U**2 + V**2)\nU = U / N\nV = V / N\n\nplt.figure(figsize=(8, 8))\nplt.quiver(X, Y, U, V, alpha=0.6)\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title(\"Direction Field for dy/dx = x - y\")\nplt.grid(True)\nplt.axhline(0, color='k', linewidth=0.5)\nplt.axvline(0, color='k', linewidth=0.5)\nplt.show()"
        ]
      ]
    }
