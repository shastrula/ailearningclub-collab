      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Example: Verify that y = e^(-2x) solves dy/dx + 2y = 0\nx = np.linspace(0, 3, 100)\ny_exact = np.exp(-2 * x)\n\n# Compute dy/dx numerically\ndydx_numerical = np.gradient(y_exact, x)\n\n# Check if dy/dx + 2y approximately equals 0\nresidual = dydx_numerical + 2 * y_exact\n\nprint(\"Max residual (should be near 0):\", np.max(np.abs(residual)))\n\n# Solve the ODE numerically using odeint\ndef ode_func(y, x):\n    return -2 * y\n\ny0 = 1.0  # initial condition y(0) = 1\ny_numerical = odeint(ode_func, y0, x).flatten()\n\n# Compare exact and numerical solutions\nprint(\"Max difference between exact and numerical:\", \n      np.max(np.abs(y_exact - y_numerical)))\n\n# Plot both solutions\nplt.figure(figsize=(8, 5))\nplt.plot(x, y_exact, 'b-', label='Exact: y = e^(-2x)')\nplt.plot(x, y_numerical, 'r--', label='Numerical (odeint)')\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title('Solution to dy/dx + 2y = 0, y(0) = 1')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    },
    {
