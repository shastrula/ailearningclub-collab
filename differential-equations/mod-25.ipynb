          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Compare discrete gradient descent vs continuous gradient flow\n# For quadratic loss: L(x) = x^2, grad = 2x\n# Gradient flow: dx/dt = -2x -> x(t) = x0*e^(-2t)\n# Gradient descent: x_{k+1} = x_k - eta*2*x_k = (1-2*eta)*x_k\n\nx0 = 3.0\nt = np.linspace(0, 3, 300)\nx_flow = x0 * np.exp(-2*t)\n\nplt.figure(figsize=(12, 5))\n\n# Left: gradient flow (always stable)\nplt.subplot(1, 2, 1)\nplt.plot(t, x_flow, 'b-', linewidth=2, label='Gradient flow')\nplt.xlabel('Time t')\nplt.ylabel('x(t)')\nplt.title('Continuous: Always Converges')\nplt.grid(True)\nplt.legend()\n\n# Right: gradient descent (stability depends on learning rate)\nplt.subplot(1, 2, 2)\nfor eta in [0.1, 0.3, 0.5, 0.8, 1.1]:\n    steps = 30\n    x = np.zeros(steps)\n    x[0] = x0\n    for k in range(steps - 1):\n        x[k+1] = x[k] - eta * 2 * x[k]\n    \n    stable = abs(1 - 2*eta) < 1\n    style = '-' if stable else '--'\n    plt.plot(range(steps), x, style, linewidth=2, \n             label=f'eta={eta} ({\"stable\" if stable else \"UNSTABLE\"})')\n\nplt.xlabel('Iteration k')\nplt.ylabel('x_k')\nplt.title('Discrete: Stability Requires eta < 1')\nplt.legend(fontsize=9)\nplt.grid(True)\nplt.ylim(-5, 5)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
