          "python",
          "import numpy as np\nfrom scipy.integrate import solve_ivp\nimport matplotlib.pyplot as plt\n\n# Gradient flow on a 2D loss landscape\n# L(x, y) = (x^2 + y^2) + 0.5*sin(3x)*sin(3y)  (bumpy bowl)\n\ndef loss(x, y):\n    return x**2 + y**2 + 0.5*np.sin(3*x)*np.sin(3*y)\n\ndef grad_loss(x, y):\n    dLdx = 2*x + 1.5*np.cos(3*x)*np.sin(3*y)\n    dLdy = 2*y + 1.5*np.sin(3*x)*np.cos(3*y)\n    return np.array([dLdx, dLdy])\n\n# Gradient flow ODE: d(theta)/dt = -grad(L)\ndef gradient_flow(t, theta):\n    x, y = theta\n    return -grad_loss(x, y)\n\n# Multiple starting points\nplt.figure(figsize=(10, 8))\n\n# Loss landscape\nxx = np.linspace(-2, 2, 200)\nyy = np.linspace(-2, 2, 200)\nX, Y = np.meshgrid(xx, yy)\nZ = loss(X, Y)\nplt.contour(X, Y, Z, levels=30, cmap='viridis', alpha=0.5)\nplt.colorbar(label='Loss L(x,y)')\n\n# Gradient flow trajectories\nstarts = [[-1.5, 1.5], [1.8, 0.5], [-0.5, -1.8], [1.5, -1.0], [-1.0, -0.5]]\nfor x0 in starts:\n    sol = solve_ivp(gradient_flow, [0, 5], x0, max_step=0.01, dense_output=True)\n    t_dense = np.linspace(0, 5, 500)\n    traj = sol.sol(t_dense)\n    plt.plot(traj[0], traj[1], 'r-', linewidth=1.5)\n    plt.plot(x0[0], x0[1], 'ro', markersize=8)\n    plt.plot(traj[0, -1], traj[1, -1], 'r*', markersize=15)\n\nplt.xlabel('theta_1')\nplt.ylabel('theta_2')\nplt.title('Gradient Flow on Loss Landscape')\nplt.grid(True, alpha=0.3)\nplt.show()"
        ]
      ]
