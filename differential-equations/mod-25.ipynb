          "python",
          "import numpy as np\nfrom scipy.integrate import solve_ivp\nimport matplotlib.pyplot as plt\n\n# Simulate a simple neural ODE layer\n# dh/dt = tanh(W*h + b) where W is a 2x2 matrix\n\n# Learned parameters (pretend these are trained)\nW = np.array([[0.5, -1.2], [1.0, 0.3]])\nb = np.array([0.1, -0.2])\n\ndef neural_ode_rhs(t, h):\n    \"\"\"Right-hand side of Neural ODE.\"\"\"\n    return np.tanh(W @ h + b)\n\n# Transform a grid of points through the Neural ODE\nn_grid = 20\nx_range = np.linspace(-2, 2, n_grid)\ny_range = np.linspace(-2, 2, n_grid)\n\nfig, axes = plt.subplots(1, 4, figsize=(16, 4))\nt_snapshots = [0, 0.5, 1.0, 2.0]\n\nfor ax_idx, T in enumerate(t_snapshots):\n    ax = axes[ax_idx]\n    for x0 in x_range:\n        points_x = []\n        points_y = []\n        for y0 in y_range:\n            if T == 0:\n                points_x.append(x0)\n                points_y.append(y0)\n            else:\n                sol = solve_ivp(neural_ode_rhs, [0, T], [x0, y0], max_step=0.1)\n                points_x.append(sol.y[0, -1])\n                points_y.append(sol.y[1, -1])\n        ax.plot(points_x, points_y, 'b-', linewidth=0.5, alpha=0.5)\n    \n    # Also plot horizontal lines\n    for y0 in y_range:\n        points_x = []\n        points_y = []\n        for x0 in x_range:\n            if T == 0:\n                points_x.append(x0)\n                points_y.append(y0)\n            else:\n                sol = solve_ivp(neural_ode_rhs, [0, T], [x0, y0], max_step=0.1)\n                points_x.append(sol.y[0, -1])\n                points_y.append(sol.y[1, -1])\n        ax.plot(points_x, points_y, 'r-', linewidth=0.5, alpha=0.5)\n    \n    ax.set_title(f't = {T}')\n    ax.set_xlim(-3, 3)\n    ax.set_ylim(-3, 3)\n    ax.grid(True, alpha=0.3)\n    ax.set_aspect('equal')\n\nplt.suptitle('Neural ODE: How it Deforms Space Over Time', fontsize=14)\nplt.tight_layout()\nplt.show()"
        ]
