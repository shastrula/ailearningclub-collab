          "python",
          "import numpy as np\nfrom scipy.integrate import solve_ivp\nimport matplotlib.pyplot as plt\n\n# Simple Neural ODE for spiral classification\n# dh/dt = f_theta(h), where f_theta is a simple parametric function\n\n# True data: points on two spirals\nnp.random.seed(42)\nn_points = 100\ntheta_spiral = np.linspace(0, 4*np.pi, n_points)\nr = theta_spiral / (4*np.pi)\n\n# Spiral 1 (class 0)\nx1 = r * np.cos(theta_spiral) + 0.05*np.random.randn(n_points)\ny1 = r * np.sin(theta_spiral) + 0.05*np.random.randn(n_points)\n\n# Spiral 2 (class 1)\nx2 = r * np.cos(theta_spiral + np.pi) + 0.05*np.random.randn(n_points)\ny2 = r * np.sin(theta_spiral + np.pi) + 0.05*np.random.randn(n_points)\n\n# Visualize data\nplt.figure(figsize=(8, 8))\nplt.scatter(x1, y1, c='blue', s=20, label='Class 0')\nplt.scatter(x2, y2, c='red', s=20, label='Class 1')\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title('Two Spirals Classification Problem')\nplt.legend()\nplt.grid(True)\nplt.axis('equal')\nplt.show()"
