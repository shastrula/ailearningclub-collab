      "source": [
        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Solve heat equation: du/dt = k * d^2u/dx^2\n# Domain: x in [0, 1], t in [0, 0.5]\n# BC: u(0,t) = 0, u(1,t) = 0\n# IC: u(x,0) = sin(pi*x)\n\nk = 1.0      # thermal diffusivity\nL = 1.0      # domain length\nNx = 50      # spatial grid points\nNt = 2000    # time steps\n\ndx = L / Nx\ndt = 0.5 / Nt\nr = k * dt / dx**2  # stability requires r <= 0.5\n\nprint(f\"dx = {dx:.4f}, dt = {dt:.6f}, r = k*dt/dx^2 = {r:.4f}\")\nprint(f\"Stability: {'STABLE' if r <= 0.5 else 'UNSTABLE'}\")\n\n# Initialize\nx = np.linspace(0, L, Nx + 1)\nu = np.sin(np.pi * x)\n\n# Store solution at selected times\nsave_times = [0, 0.01, 0.05, 0.1, 0.2, 0.5]\nsaved = {0: u.copy()}\n\n# Explicit finite difference (Forward Time, Central Space)\nfor n in range(1, Nt + 1):\n    u_new = u.copy()\n    for i in range(1, Nx):\n        u_new[i] = u[i] + r * (u[i+1] - 2*u[i] + u[i-1])\n    u_new[0] = 0  # BC\n    u_new[Nx] = 0  # BC\n    u = u_new\n    \n    t_current = n * dt\n    for st in save_times:\n        if abs(t_current - st) < dt/2 and st not in saved:\n            saved[st] = u.copy()\n\n# Plot\nplt.figure(figsize=(10, 6))\nfor t_val in sorted(saved.keys()):\n    # Exact solution for comparison\n    u_exact = np.sin(np.pi * x) * np.exp(-np.pi**2 * k * t_val)\n    plt.plot(x, saved[t_val], linewidth=2, label=f't = {t_val}')\n\nplt.xlabel('x')\nplt.ylabel('u(x,t)')\nplt.title('Heat Equation: Numerical Solution (Explicit FD)')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    },
