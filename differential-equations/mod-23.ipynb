          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Exact solution: u(x,t) = sin(pi*x) * e^(-pi^2*t)\nx = np.linspace(0, 1, 100)\nt_values = [0, 0.01, 0.05, 0.1, 0.2]\n\nplt.figure(figsize=(10, 6))\nfor t in t_values:\n    u_exact = np.sin(np.pi * x) * np.exp(-np.pi**2 * t)\n    plt.plot(x, u_exact, linewidth=2, label=f't = {t:.2f}')\n\nplt.xlabel('x')\nplt.ylabel('u(x, t)')\nplt.title('Heat Equation: Exact Solution u = sin(pi*x)e^(-pi\u00b2t)')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
