        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# 2D heat equation on a square [0,1] x [0,1]\n# du/dt = k*(d^2u/dx^2 + d^2u/dy^2)\n\nN = 50\nk = 0.01\ndx = 1.0 / N\ndt = dx**2 / (4*k)  # stability for 2D: r = k*dt/dx^2 <= 1/4\nr = k * dt / dx**2\n\n# Initial condition: hot spot in center\nx = np.linspace(0, 1, N+1)\ny = np.linspace(0, 1, N+1)\nX, Y = np.meshgrid(x, y)\nu = np.exp(-50*((X-0.5)**2 + (Y-0.5)**2))\nu[0, :] = u[-1, :] = u[:, 0] = u[:, -1] = 0  # BCs\n\n# Time evolution\nfig, axes = plt.subplots(1, 4, figsize=(16, 4))\ntimes = [0, 100, 500, 2000]\nu_current = u.copy()\n\nstep = 0\nplot_idx = 0\nfor target_step in times:\n    while step < target_step:\n        u_new = u_current.copy()\n        u_new[1:-1, 1:-1] = u_current[1:-1, 1:-1] + r * (\n            u_current[2:, 1:-1] + u_current[:-2, 1:-1] +\n            u_current[1:-1, 2:] + u_current[1:-1, :-2] -\n            4*u_current[1:-1, 1:-1]\n        )\n        u_current = u_new\n        step += 1\n    \n    axes[plot_idx].imshow(u_current, cmap='hot', origin='lower',\n                          extent=[0,1,0,1], vmin=0, vmax=1)\n    axes[plot_idx].set_title(f'Step {target_step}\\nt = {target_step*dt:.4f}')\n    axes[plot_idx].set_xlabel('x')\n    axes[plot_idx].set_ylabel('y')\n    plot_idx += 1\n\nplt.suptitle('2D Heat Equation: Diffusion of a Hot Spot', fontsize=14)\nplt.tight_layout()\nplt.show()"
        ]
      ]
    }
