    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Exact equation: (2xy + 3)dx + (x^2 + 4y)dy = 0\n# Solution: x^2*y + 3x + 2y^2 = C\n# Rewrite as dy/dx = -(2xy + 3)/(x^2 + 4y)\n\ndef exact_ode(y, x):\n    denominator = x**2 + 4*y\n    if abs(denominator) < 1e-10:\n        return 0.0\n    return -(2*x*y + 3) / denominator\n\nx = np.linspace(0, 3, 200)\ny0 = 1.0\ny_numerical = odeint(exact_ode, y0, x).flatten()\n\n# Verify: F(x,y) = x^2*y + 3x + 2y^2 should be constant\nF_values = x**2 * y_numerical + 3*x + 2*y_numerical**2\nF_initial = 0**2 * 1 + 3*0 + 2*1**2  # F(0,1) = 2\n\nplt.figure(figsize=(10, 5))\nplt.subplot(1, 2, 1)\nplt.plot(x, y_numerical, 'b-', linewidth=2)\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title('Solution curve')\nplt.grid(True)\n\nplt.subplot(1, 2, 2)\nplt.plot(x, F_values, 'r-', linewidth=2)\nplt.axhline(F_initial, color='g', linestyle='--', label=f'Expected C = {F_initial}')\nplt.xlabel('x')\nplt.ylabel('F(x,y)')\nplt.title('F(x,y) should be constant along solution')\nplt.legend()\nplt.grid(True)\nplt.tight_layout()\nplt.show()\n\nprint(f\"F(0,1) = {F_initial}\")\nprint(f\"Max deviation of F from constant: {np.max(np.abs(F_values - F_initial)):.6f}\")"
        ]
      ]
    },
