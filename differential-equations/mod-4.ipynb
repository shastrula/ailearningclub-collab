          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Plot level curves of F(x,y) = x^2*y + 3x + 2y^2\nx = np.linspace(-3, 3, 300)\ny = np.linspace(-3, 3, 300)\nX, Y = np.meshgrid(x, y)\nF = X**2 * Y + 3*X + 2*Y**2\n\nplt.figure(figsize=(8, 8))\nlevels = np.linspace(-10, 20, 25)\ncs = plt.contour(X, Y, F, levels=levels, cmap='viridis')\nplt.clabel(cs, inline=True, fontsize=8)\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title('Level curves of F(x,y) = x^2*y + 3x + 2y^2 = C')\nplt.grid(True, alpha=0.3)\nplt.axhline(0, color='k', linewidth=0.5)\nplt.axvline(0, color='k', linewidth=0.5)\nplt.show()"
        ]
