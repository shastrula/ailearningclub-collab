      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Example: dy/dx + 3y = 6, y(0) = 1\n# Exact solution: y = 2 - e^(-3x)\n\ndef linear_ode(y, x):\n    \"\"\"dy/dx = 6 - 3y\"\"\"\n    return 6 - 3 * y\n\nx = np.linspace(0, 3, 200)\ny0 = 1.0\ny_numerical = odeint(linear_ode, y0, x).flatten()\n\n# Exact solution\ny_exact = 2 - np.exp(-3 * x)\n\nplt.figure(figsize=(10, 6))\nplt.plot(x, y_exact, 'b-', linewidth=2, label='Exact: y = 2 - e^(-3x)')\nplt.plot(x, y_numerical, 'r--', linewidth=2, label='Numerical (odeint)')\nplt.axhline(2, color='g', linestyle=':', label='Steady state y = 2')\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title('Linear ODE: dy/dx + 3y = 6, y(0) = 1')\nplt.legend()\nplt.grid(True)\nplt.show()\n\nprint(f\"Max error: {np.max(np.abs(y_exact - y_numerical)):.2e}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
