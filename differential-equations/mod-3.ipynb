      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# dy/dx + (2/x)*y = x^3, general solution: y = x^4/6 + C/x^2\ndef variable_coeff_ode(y, x):\n    if abs(x) < 1e-10:\n        return 0.0\n    return x**3 - (2/x) * y\n\nx = np.linspace(0.1, 3, 200)\nplt.figure(figsize=(10, 6))\n\n# Plot family of solutions with different initial conditions\nfor y0 in [0.5, 1.0, 2.0, 4.0, 8.0]:\n    y = odeint(variable_coeff_ode, y0, x).flatten()\n    plt.plot(x, y, linewidth=2, label=f'y(0.1) = {y0}')\n\n# Particular solution (C=0): y = x^4/6\ny_particular = x**4 / 6\nplt.plot(x, y_particular, 'k--', linewidth=2, label='Particular: y = x\u2074/6')\n\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title(\"dy/dx + (2/x)y = x\u00b3 \u2014 Family of Solutions\")\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    }
