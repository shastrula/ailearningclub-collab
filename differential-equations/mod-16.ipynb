      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# y' + y = f(t) where f(t) = 1 for 0<=t<1, 0 for t>=1\ndef piecewise_system(y, t):\n    f = 1.0 if t < 1 else 0.0\n    return -y + f\n\nt = np.linspace(0, 6, 500)\nsol = odeint(piecewise_system, [0], t).flatten()\n\n# Exact\ny_exact = np.where(t < 1, 1 - np.exp(-t), (1 - np.exp(-1))*np.exp(-(t-1)))\n\nfig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 7))\n\n# Forcing function\nf_vals = np.where(t < 1, 1.0, 0.0)\nax1.plot(t, f_vals, 'g-', linewidth=2)\nax1.set_ylabel('f(t)')\nax1.set_title('Piecewise forcing function')\nax1.grid(True)\n\n# Response\nax2.plot(t, sol, 'b-', linewidth=2, label='Numerical')\nax2.plot(t, y_exact, 'r--', linewidth=2, label='Exact (Laplace)')\nax2.set_xlabel('t')\nax2.set_ylabel('y(t)')\nax2.set_title(\"Response: y' + y = f(t)\")\nax2.legend()\nax2.grid(True)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    }
