      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# y'' + 4y = u(t-2), y(0) = 0, y'(0) = 0\ndef step_response(Y, t):\n    y, yp = Y\n    forcing = 1.0 if t >= 2 else 0.0\n    return [yp, -4*y + forcing]\n\nt = np.linspace(0, 12, 1000)\nsol = odeint(step_response, [0, 0], t)\n\n# Exact solution\ny_exact = np.where(t >= 2, 0.25*(1 - np.cos(2*(t-2))), 0.0)\n\nplt.figure(figsize=(10, 6))\nplt.plot(t, sol[:, 0], 'b-', linewidth=2, label='Numerical')\nplt.plot(t, y_exact, 'r--', linewidth=2, label='Exact (Laplace)')\nplt.axvline(2, color='g', linestyle=':', alpha=0.7, label='Step at t=2')\nplt.xlabel('t')\nplt.ylabel('y(t)')\nplt.title(\"y'' + 4y = u(t-2): Step Response\")\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# y'' + 2y' + 5y = delta(t)\n# Approximate delta with narrow pulse: height 1/eps, width eps\neps = 0.01\n\ndef impulse_system(Y, t):\n    y, yp = Y\n    forcing = (1.0/eps) if t < eps else 0.0\n    return [yp, -2*yp - 5*y + forcing]\n\nt = np.linspace(0, 6, 1000)\nsol = odeint(impulse_system, [0, 0], t)\n\n# Exact impulse response\ny_exact = 0.5 * np.exp(-t) * np.sin(2*t)\n\nplt.figure(figsize=(10, 6))\nplt.plot(t, sol[:, 0], 'b-', linewidth=2, label='Numerical (pulse approx)')\nplt.plot(t, y_exact, 'r--', linewidth=2, label='Exact: (1/2)e^(-t)sin(2t)')\nplt.xlabel('t')\nplt.ylabel('y(t)')\nplt.title(\"Impulse Response: y'' + 2y' + 5y = delta(t)\")\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
