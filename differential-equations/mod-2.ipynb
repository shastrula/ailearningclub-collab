      "source": [
        "# Differential Equations - mod-2\n\n",
        "**Course:** differential-equations\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Example: dy/dx = x/y, y(0) = 2\n# Exact solution: y = sqrt(x^2 + 4)\n\ndef ode_separable(y, x):\n    \"\"\"Right-hand side of dy/dx = x/y\"\"\"\n    if abs(y) < 1e-10:\n        return 0.0\n    return x / y\n\n# Solve numerically\nx = np.linspace(0, 5, 200)\ny0 = 2.0\ny_numerical = odeint(ode_separable, y0, x).flatten()\n\n# Exact solution\ny_exact = np.sqrt(x**2 + 4)\n\n# Compare\nplt.figure(figsize=(10, 6))\nplt.plot(x, y_exact, 'b-', linewidth=2, label='Exact: y = sqrt(x\u00b2 + 4)')\nplt.plot(x, y_numerical, 'r--', linewidth=2, label='Numerical (odeint)')\nplt.xlabel('x')\nplt.ylabel('y')\nplt.title('Separable ODE: dy/dx = x/y, y(0) = 2')\nplt.legend()\nplt.grid(True)\nplt.show()\n\nprint(f\"Maximum error: {np.max(np.abs(y_exact - y_numerical)):.2e}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Logistic equation: dy/dt = r*y*(1 - y/K)\nr = 0.5   # growth rate\nK = 100   # carrying capacity\n\ndef logistic(y, t, r, K):\n    return r * y * (1 - y / K)\n\nt = np.linspace(0, 20, 300)\n\n# Multiple initial conditions\ny0_values = [5, 20, 50, 80, 120]\nplt.figure(figsize=(10, 6))\n\nfor y0 in y0_values:\n    y = odeint(logistic, y0, t, args=(r, K)).flatten()\n    plt.plot(t, y, linewidth=2, label=f'y(0) = {y0}')\n\nplt.axhline(K, color='k', linestyle=':', label=f'Carrying capacity K = {K}')\nplt.xlabel('Time t')\nplt.ylabel('Population y')\nplt.title(f'Logistic Growth (r={r}, K={K})')\nplt.legend()\nplt.grid(True)\nplt.ylim(0, 130)\nplt.show()"
        ]
      ]
    }
