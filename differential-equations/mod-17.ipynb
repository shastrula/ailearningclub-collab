        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# SIR model: Susceptible -> Infected -> Recovered\n# dS/dt = -beta*S*I\n# dI/dt = beta*S*I - gamma*I\n# dR/dt = gamma*I\n\nbeta = 0.3   # transmission rate\ngamma = 0.1  # recovery rate\nN = 1000     # total population\n\ndef sir_model(Y, t):\n    S, I, R = Y\n    dSdt = -beta * S * I / N\n    dIdt = beta * S * I / N - gamma * I\n    dRdt = gamma * I\n    return [dSdt, dIdt, dRdt]\n\nt = np.linspace(0, 100, 1000)\nY0 = [N - 1, 1, 0]  # One initial infected\nsol = odeint(sir_model, Y0, t)\n\nplt.figure(figsize=(10, 6))\nplt.plot(t, sol[:, 0], 'b-', linewidth=2, label='Susceptible')\nplt.plot(t, sol[:, 1], 'r-', linewidth=2, label='Infected')\nplt.plot(t, sol[:, 2], 'g-', linewidth=2, label='Recovered')\nplt.xlabel('Time (days)')\nplt.ylabel('Population')\nplt.title(f'SIR Epidemic Model (R0 = {beta/gamma:.1f})')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    }
