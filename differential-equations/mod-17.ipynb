      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Two masses connected by three springs\nm1, m2 = 1.0, 1.0\nk1, k2, k3 = 4.0, 2.0, 4.0\n\ndef coupled_springs(Y, t):\n    x1, v1, x2, v2 = Y\n    dx1dt = v1\n    dv1dt = (-(k1+k2)*x1 + k2*x2) / m1\n    dx2dt = v2\n    dv2dt = (k2*x1 - (k2+k3)*x2) / m2\n    return [dx1dt, dv1dt, dx2dt, dv2dt]\n\nt = np.linspace(0, 20, 1000)\n# Initial: mass 1 displaced, mass 2 at rest\nY0 = [1.0, 0.0, 0.0, 0.0]\nsol = odeint(coupled_springs, Y0, t)\n\nplt.figure(figsize=(10, 6))\nplt.plot(t, sol[:, 0], 'b-', linewidth=2, label='Mass 1')\nplt.plot(t, sol[:, 2], 'r-', linewidth=2, label='Mass 2')\nplt.xlabel('Time')\nplt.ylabel('Displacement')\nplt.title('Coupled Spring-Mass System')\nplt.legend()\nplt.grid(True)\nplt.show()"
        ]
      ]
    },
    {
