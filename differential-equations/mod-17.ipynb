      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Lotka-Volterra equations\nalpha = 1.0   # prey growth rate\nbeta = 0.5    # predation rate\ngamma = 0.75  # predator death rate\ndelta = 0.25  # predator growth from prey\n\ndef lotka_volterra(Y, t):\n    x, y = Y  # x = prey, y = predator\n    dxdt = alpha*x - beta*x*y\n    dydt = -gamma*y + delta*x*y\n    return [dxdt, dydt]\n\nt = np.linspace(0, 30, 1000)\nY0 = [4.0, 2.0]\nsol = odeint(lotka_volterra, Y0, t)\n\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))\n\n# Time series\nax1.plot(t, sol[:, 0], 'b-', linewidth=2, label='Prey')\nax1.plot(t, sol[:, 1], 'r-', linewidth=2, label='Predator')\nax1.set_xlabel('Time')\nax1.set_ylabel('Population')\nax1.set_title('Predator-Prey Dynamics')\nax1.legend()\nax1.grid(True)\n\n# Phase portrait\nax2.plot(sol[:, 0], sol[:, 1], 'g-', linewidth=2)\nax2.plot(sol[0, 0], sol[0, 1], 'ko', markersize=10, label='Start')\nax2.set_xlabel('Prey population')\nax2.set_ylabel('Predator population')\nax2.set_title('Phase Portrait')\nax2.legend()\nax2.grid(True)\n\nplt.tight_layout()\nplt.show()"
        ]
      ]
    },
    {
