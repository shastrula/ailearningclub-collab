      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\nhalf_life = 5730  # years for C-14\ndecay_constant = np.log(2) / half_life\n\ndef decay(N, t, lam):\n    return -lam * N\n\nt = np.linspace(0, 30000, 1000)\nN0 = 1.0\n\nN = odeint(decay, N0, t, args=(decay_constant,)).flatten()\n\nplt.figure(figsize=(10, 6))\nplt.plot(t, N, 'b-', linewidth=2, label='C-14 remaining fraction')\nplt.axhline(0.5, color='r', linestyle='--', alpha=0.5)\nplt.axvline(half_life, color='r', linestyle='--', alpha=0.5, label=f'Half-life = {half_life} yrs')\nplt.axhline(0.25, color='g', linestyle='--', alpha=0.5)\nplt.axvline(2*half_life, color='g', linestyle='--', alpha=0.5, label=f'Two half-lives')\nplt.xlabel('Time (years)')\nplt.ylabel('Fraction remaining')\nplt.title('Carbon-14 Radioactive Decay')\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.show()\n\n# Dating example\nfraction_remaining = 0.30\nage = -np.log(fraction_remaining) / decay_constant\nprint(f\"Artifact with {fraction_remaining*100}% C-14 is approx {age:.0f} years old\")"
        ]
      ]
    },
    {
