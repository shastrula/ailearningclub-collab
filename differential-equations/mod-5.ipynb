      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\nK = 1000\nP0 = 50\nt = np.linspace(0, 50, 300)\n\ndef logistic(P, t, r, K):\n    return r * P * (1 - P / K)\n\nplt.figure(figsize=(10, 6))\nfor r in [0.1, 0.2, 0.3, 0.5, 0.8]:\n    P = odeint(logistic, P0, t, args=(r, K)).flatten()\n    plt.plot(t, P, linewidth=2, label=f'r = {r}')\n\nplt.axhline(K, color='k', linestyle=':', label=f'K = {K}')\nplt.axhline(K/2, color='gray', linestyle=':', alpha=0.5, label='K/2 (inflection)')\nplt.xlabel('Time')\nplt.ylabel('Population')\nplt.title('Logistic Growth: Sensitivity to Growth Rate r')\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.show()"
        ]
      ]
    }
