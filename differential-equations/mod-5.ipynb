      "source": [
        "# Differential Equations - mod-5\n\n",
        "**Course:** differential-equations\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Parameters\nr = 0.231      # growth rate (per hour)\nK = 1e7        # carrying capacity\nP0 = 1000      # initial population\nH = 5e4        # harvest rate\n\nt = np.linspace(0, 60, 500)\n\ndef exponential(P, t, r):\n    return r * P\n\ndef logistic(P, t, r, K):\n    return r * P * (1 - P / K)\n\ndef logistic_harvest(P, t, r, K, H):\n    return r * P * (1 - P / K) - H\n\nP_exp = odeint(exponential, P0, t, args=(r,)).flatten()\nP_log = odeint(logistic, P0, t, args=(r, K)).flatten()\nP_har = odeint(logistic_harvest, P0, t, args=(r, K, H)).flatten()\n\nplt.figure(figsize=(12, 6))\nplt.semilogy(t, P_exp, 'r-', linewidth=2, label='Exponential')\nplt.semilogy(t, P_log, 'b-', linewidth=2, label='Logistic')\nplt.semilogy(t, np.maximum(P_har, 1), 'g-', linewidth=2, label=f'Logistic + Harvest')\nplt.axhline(K, color='k', linestyle=':', label=f'K = {K:.0e}')\nplt.xlabel('Time (hours)')\nplt.ylabel('Population (log scale)')\nplt.title('Comparison of Population Growth Models')\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
