      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# Competing species model\ndef competing_species(Y, t):\n    x, y = Y\n    dxdt = x * (3 - x - 2*y)\n    dydt = y * (2 - y - x)\n    return [dxdt, dydt]\n\n# Plot phase portrait\nfig, ax = plt.subplots(figsize=(10, 8))\n\n# Trajectories from various initial conditions\nfor x0 in np.linspace(0.1, 3.5, 8):\n    for y0 in np.linspace(0.1, 3.0, 8):\n        t = np.linspace(0, 20, 500)\n        sol = odeint(competing_species, [x0, y0], t)\n        ax.plot(sol[:, 0], sol[:, 1], 'b-', linewidth=0.5, alpha=0.6)\n\n# Nullclines\nx_vals = np.linspace(0, 3.5, 100)\nax.plot(x_vals, (3 - x_vals)/2, 'r-', linewidth=2, label='x-nullcline: 3-x-2y=0')\nax.plot(x_vals, 2 - x_vals, 'g-', linewidth=2, label='y-nullcline: 2-y-x=0')\n\n# Equilibrium points\neq_points = [(0,0), (3,0), (0,2), (1,1)]\nfor pt in eq_points:\n    ax.plot(pt[0], pt[1], 'ko', markersize=10)\n\nax.set_xlabel('Species x')\nax.set_ylabel('Species y')\nax.set_title('Competing Species Phase Portrait')\nax.legend()\nax.set_xlim(0, 3.5)\nax.set_ylim(0, 3)\nax.grid(True, alpha=0.3)\nplt.show()"
        ]
      ]
