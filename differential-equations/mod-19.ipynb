      "source": [
        [
          "python",
          "import numpy as np\nfrom scipy.integrate import odeint\nimport matplotlib.pyplot as plt\n\n# For the competing species, determine which equilibrium each IC converges to\ndef competing_species(Y, t):\n    x, y = Y\n    dxdt = x * (3 - x - 2*y)\n    dydt = y * (2 - y - x)\n    return [dxdt, dydt]\n\nN = 50\nx_range = np.linspace(0.01, 3.5, N)\ny_range = np.linspace(0.01, 3.0, N)\nbasin = np.zeros((N, N))\n\nfor i, x0 in enumerate(x_range):\n    for j, y0 in enumerate(y_range):\n        t = np.linspace(0, 50, 200)\n        sol = odeint(competing_species, [x0, y0], t)\n        final_x, final_y = sol[-1]\n        if final_x > 2.5 and final_y < 0.5:\n            basin[j, i] = 1  # Species x wins\n        elif final_y > 1.5 and final_x < 0.5:\n            basin[j, i] = 2  # Species y wins\n        else:\n            basin[j, i] = 0  # Other\n\nplt.figure(figsize=(10, 8))\nplt.contourf(x_range, y_range, basin, levels=[-0.5, 0.5, 1.5, 2.5], \n             colors=['gray', 'blue', 'red'], alpha=0.5)\nplt.xlabel('Initial x')\nplt.ylabel('Initial y')\nplt.title('Basins of Attraction: Which Species Wins?')\nplt.colorbar(label='Outcome (1=x wins, 2=y wins)')\nplt.grid(True, alpha=0.3)\nplt.show()"
        ]
      ]
    }
