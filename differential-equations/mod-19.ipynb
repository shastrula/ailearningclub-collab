        [
          "python",
          "import numpy as np\nimport matplotlib.pyplot as plt\n\n# Trace-Determinant diagram\nfig, ax = plt.subplots(figsize=(10, 8))\n\ntau = np.linspace(-5, 5, 1000)\n\n# Boundary: Delta = tau^2/4 (transition between node and spiral)\ndelta_boundary = tau**2 / 4\nax.plot(tau, delta_boundary, 'k--', linewidth=2, label='tau^2 = 4*Delta')\n\n# Fill regions\ntau_fill = np.linspace(-5, 5, 100)\nax.fill_between(tau_fill, 0, -5, alpha=0.2, color='red', label='Saddle (Delta < 0)')\nax.fill_between(tau_fill[tau_fill<0], tau_fill[tau_fill<0]**2/4, 10, alpha=0.2, color='blue', label='Stable spiral')\nax.fill_between(tau_fill[tau_fill>0], tau_fill[tau_fill>0]**2/4, 10, alpha=0.2, color='orange', label='Unstable spiral')\n\nax.axhline(0, color='k', linewidth=0.5)\nax.axvline(0, color='k', linewidth=0.5)\nax.set_xlabel('Trace (tau)')\nax.set_ylabel('Determinant (Delta)')\nax.set_title('Trace-Determinant Classification of Equilibria')\nax.legend(loc='upper left')\nax.set_xlim(-5, 5)\nax.set_ylim(-5, 8)\nax.grid(True, alpha=0.3)\nplt.show()"
        ]
      ]
    },
