          "python",
          "def free_variables(formula):\n    \"\"\"Compute the set of free variables in a formula\"\"\"\n    if isinstance(formula, Predicate):\n        result = set()\n        for arg in formula.args:\n            result |= free_vars_term(arg)\n        return result\n    elif isinstance(formula, NotFOL):\n        return free_variables(formula.operand)\n    elif isinstance(formula, (AndFOL, OrFOL, ImpliesFOL)):\n        return free_variables(formula.left) | free_variables(formula.right)\n    elif isinstance(formula, (ForAll, Exists)):\n        return free_variables(formula.formula) - {formula.variable}\n\ndef free_vars_term(term):\n    \"\"\"Get free variables in a term\"\"\"\n    if isinstance(term, Var):\n        return {term.name}\n    elif isinstance(term, Const):\n        return set()\n    elif isinstance(term, FuncApp):\n        result = set()\n        for arg in term.args:\n            result |= free_vars_term(arg)\n        return result\n\n# Example\nf = ForAll(\"x\", ImpliesFOL(\n    Predicate(\"P\", (Var(\"x\"), Var(\"y\"))),\n    Predicate(\"Q\", (Var(\"z\"),))\n))\nprint(f\"Free variables: {free_variables(f)}\")  # {'y', 'z'}"
        ]
