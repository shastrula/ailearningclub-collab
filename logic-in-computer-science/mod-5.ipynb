      "source": [
        [
          "python",
          "formula ::= predicate(term, ..., term)\n          | ~ formula\n          | formula ^ formula\n          | formula v formula\n          | formula -> formula\n          | forall variable. formula\n          | exists variable. formula"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from dataclasses import dataclass\nfrom typing import Union, List, Tuple\n\n# Terms\n@dataclass(frozen=True)\nclass Var:\n    name: str\n\n@dataclass(frozen=True)\nclass Const:\n    name: str\n\n@dataclass(frozen=True)\nclass FuncApp:\n    name: str\n    args: Tuple  # tuple of Terms\n\nTerm = Union[Var, Const, FuncApp]\n\n# Formulas\n@dataclass\nclass Predicate:\n    name: str\n    args: Tuple  # tuple of Terms\n\n@dataclass\nclass NotFOL:\n    operand: 'FOLFormula'\n\n@dataclass\nclass AndFOL:\n    left: 'FOLFormula'\n    right: 'FOLFormula'\n\n@dataclass\nclass OrFOL:\n    left: 'FOLFormula'\n    right: 'FOLFormula'\n\n@dataclass\nclass ImpliesFOL:\n    left: 'FOLFormula'\n    right: 'FOLFormula'\n\n@dataclass\nclass ForAll:\n    variable: str\n    formula: 'FOLFormula'\n\n@dataclass\nclass Exists:\n    variable: str\n    formula: 'FOLFormula'\n\nFOLFormula = Union[Predicate, NotFOL, AndFOL, OrFOL, ImpliesFOL, ForAll, Exists]\n\n# Example: forall x. (Human(x) -> Mortal(x))\nformula = ForAll(\"x\", ImpliesFOL(\n    Predicate(\"Human\", (Var(\"x\"),)),\n    Predicate(\"Mortal\", (Var(\"x\"),))\n))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "class Structure:\n    \"\"\"A first-order logic interpretation structure\"\"\"\n\n    def __init__(self, domain, constants, functions, predicates):\n        self.domain = domain          # Set of objects\n        self.constants = constants    # Dict: name -> element\n        self.functions = functions    # Dict: name -> callable\n        self.predicates = predicates  # Dict: name -> set of tuples\n\n    def evaluate_term(self, term, assignment):\n        \"\"\"Evaluate a term to get a domain element\"\"\"\n        if isinstance(term, Const):\n            return self.constants[term.name]\n        elif isinstance(term, Var):\n            return assignment[term.name]\n        elif isinstance(term, FuncApp):\n            args = tuple(self.evaluate_term(a, assignment) for a in term.args)\n            return self.functions[term.name](*args)\n\n    def satisfies(self, formula, assignment):\n        \"\"\"Check if structure satisfies formula under assignment\"\"\"\n        if isinstance(formula, Predicate):\n            args = tuple(self.evaluate_term(a, assignment) for a in formula.args)\n            return args in self.predicates[formula.name]\n        elif isinstance(formula, NotFOL):\n            return not self.satisfies(formula.operand, assignment)\n        elif isinstance(formula, AndFOL):\n            return (self.satisfies(formula.left, assignment) and\n                    self.satisfies(formula.right, assignment))\n        elif isinstance(formula, OrFOL):\n            return (self.satisfies(formula.left, assignment) or\n                    self.satisfies(formula.right, assignment))\n        elif isinstance(formula, ImpliesFOL):\n            return (not self.satisfies(formula.left, assignment) or\n                    self.satisfies(formula.right, assignment))\n        elif isinstance(formula, ForAll):\n            return all(\n                self.satisfies(formula.formula,\n                              {**assignment, formula.variable: d})\n                for d in self.domain\n            )\n        elif isinstance(formula, Exists):\n            return any(\n                self.satisfies(formula.formula,\n                              {**assignment, formula.variable: d})\n                for d in self.domain\n            )\n\n# Example: A small world with people\nworld = Structure(\n    domain={\"socrates\", \"plato\", \"aristotle\", \"zeus\"},\n    constants={\"s\": \"socrates\", \"p\": \"plato\"},\n    functions={\"teacher_of\": lambda x: {\"socrates\": \"plato\",\n                                         \"plato\": \"aristotle\"}.get(x, x)},\n    predicates={\n        \"Human\": {(\"socrates\",), (\"plato\",), (\"aristotle\",)},\n        \"Mortal\": {(\"socrates\",), (\"plato\",), (\"aristotle\",)},\n        \"God\": {(\"zeus\",)},\n    }\n)\n\n# Test: forall x. (Human(x) -> Mortal(x))\nformula = ForAll(\"x\", ImpliesFOL(\n    Predicate(\"Human\", (Var(\"x\"),)),\n    Predicate(\"Mortal\", (Var(\"x\"),))\n))\nprint(f\"All humans are mortal: {world.satisfies(formula, {})}\")  # True\n\n# Test: exists x. (God(x) ^ ~Mortal(x))\nformula2 = Exists(\"x\", AndFOL(\n    Predicate(\"God\", (Var(\"x\"),)),\n    NotFOL(Predicate(\"Mortal\", (Var(\"x\"),)))\n))\nprint(f\"Some god is immortal: {world.satisfies(formula2, {})}\")  # True"
        ]
      ]
    },
