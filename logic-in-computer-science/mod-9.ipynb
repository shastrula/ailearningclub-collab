          "python",
          "class LogicSystem:\n    \"\"\"Model a proof system and check soundness/completeness\"\"\"\n\n    def __init__(self, name):\n        self.name = name\n        self.axioms = set()\n        self.rules = []\n\n    def add_axiom(self, formula):\n        self.axioms.add(formula)\n\n    def is_provable(self, formula, assumptions=None):\n        \"\"\"Check if formula is provable (syntactic)\"\"\"\n        if assumptions is None:\n            assumptions = set()\n        # Simple forward-chaining prover\n        known = self.axioms | assumptions\n        changed = True\n        while changed:\n            changed = False\n            for rule in self.rules:\n                new = rule(known)\n                if new and new not in known:\n                    known.add(new)\n                    changed = True\n        return formula in known\n\n    def check_soundness(self, provable_formulas, valid_formulas):\n        \"\"\"Every provable formula must be valid\"\"\"\n        unsound = provable_formulas - valid_formulas\n        if unsound:\n            return False, f\"Unsound! Provable but invalid: {unsound}\"\n        return True, \"Sound: all provable formulas are valid\"\n\n    def check_completeness(self, provable_formulas, valid_formulas):\n        \"\"\"Every valid formula must be provable\"\"\"\n        incomplete = valid_formulas - provable_formulas\n        if incomplete:\n            return False, f\"Incomplete! Valid but unprovable: {incomplete}\"\n        return True, \"Complete: all valid formulas are provable\"\n\n# Example: A tiny propositional system\nsystem = LogicSystem(\"Mini-Prop\")\n\n# In a correct system, these should match\nprovable = {\"p->p\", \"p->(q->p)\", \"(p->q)->(p->r)->(p->q^r)\"}\nvalid = {\"p->p\", \"p->(q->p)\", \"(p->q)->(p->r)->(p->q^r)\"}\n\nsound, msg = system.check_soundness(provable, valid)\nprint(f\"Soundness: {msg}\")\n\ncomplete, msg = system.check_completeness(provable, valid)\nprint(f\"Completeness: {msg}\")"
        ]
      ]
