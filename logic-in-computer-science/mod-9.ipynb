          "python",
          "# Demonstrating soundness: verify that proof rules preserve truth\n\nimport itertools\n\ndef all_assignments(variables):\n    \"\"\"Generate all possible truth assignments\"\"\"\n    for values in itertools.product([False, True], repeat=len(variables)):\n        yield dict(zip(variables, values))\n\ndef is_valid_implication(premise_formulas, conclusion_formula, variables):\n    \"\"\"Check semantic validity: do premises entail conclusion?\"\"\"\n    for assignment in all_assignments(variables):\n        # If all premises are true...\n        all_premises_true = all(f(assignment) for f in premise_formulas)\n        if all_premises_true:\n            # ...conclusion must also be true\n            if not conclusion_formula(assignment):\n                return False\n    return True\n\n# Verify soundness of Modus Ponens: from (A -> B) and A, derive B\n# If A -> B is true and A is true, then B must be true\ndef verify_modus_ponens():\n    \"\"\"Verify that modus ponens preserves truth\"\"\"\n    variables = [\"A\", \"B\"]\n    for assignment in all_assignments(variables):\n        a_val = assignment[\"A\"]\n        b_val = assignment[\"B\"]\n        impl_val = (not a_val) or b_val  # A -> B\n\n        # If both premises hold, conclusion must hold\n        if impl_val and a_val:\n            assert b_val, f\"Modus ponens unsound for {assignment}!\"\n\n    print(\"Modus ponens verified sound!\")\n\nverify_modus_ponens()\n\n# Verify soundness of AND-Introduction\ndef verify_and_intro():\n    \"\"\"If A is true and B is true, then A ^ B is true\"\"\"\n    for assignment in all_assignments([\"A\", \"B\"]):\n        if assignment[\"A\"] and assignment[\"B\"]:\n            assert assignment[\"A\"] and assignment[\"B\"]\n    print(\"AND-Introduction verified sound!\")\n\nverify_and_intro()"
        ]
      ]
    },
    {
