        [
          "python",
          "# Demonstrating completeness for propositional logic\n# Any tautology can be proven - we demonstrate by constructing proofs from truth tables\n\ndef is_tautology(formula_fn, variables):\n    \"\"\"Check if a formula is a tautology (true in all assignments)\"\"\"\n    for assignment in all_assignments(variables):\n        if not formula_fn(assignment):\n            return False\n    return True\n\ndef construct_proof_from_truth_table(formula_fn, variables):\n    \"\"\"\n    For propositional logic, completeness is constructive:\n    Given any tautology, we can build a proof.\n\n    Strategy: Use the truth table to construct a DNF of all satisfying rows,\n    then show it equals True for tautologies.\n    \"\"\"\n    if not is_tautology(formula_fn, variables):\n        return \"Not a tautology - no proof exists (by soundness)\"\n\n    # For a tautology, every row of the truth table is True\n    # We can prove this by case analysis on each variable\n    proof_steps = []\n    proof_steps.append(f\"Formula is valid over variables {variables}\")\n    proof_steps.append(f\"Proof by exhaustive case analysis:\")\n\n    for assignment in all_assignments(variables):\n        case = \", \".join(f\"{v}={'T' if val else 'F'}\"\n                        for v, val in assignment.items())\n        proof_steps.append(f\"  Case [{case}]: formula evaluates to True\")\n\n    proof_steps.append(\"All cases verified. QED.\")\n    return \"\\n\".join(proof_steps)\n\n# Example: Prove p v ~p is a tautology\nresult = construct_proof_from_truth_table(\n    lambda a: a[\"p\"] or not a[\"p\"],\n    [\"p\"]\n)\nprint(result)"
        ]
      ]
