          "python",
          "# Implementing Prolog-style list operations\nprolog_lists = PrologInterpreter()\n\n# member(X, [X|_]).\n# member(X, [_|T]) :- member(X, T).\nprolog_lists.add_rule(\"member\", [\"X\", \"XL\"],\n                      [])  # This would need proper list support\n\n# In our simplified system, let's demonstrate the concept:\ndef prolog_member(element, lst):\n    \"\"\"Prolog-style member check using unification\"\"\"\n    if not lst:\n        return False\n    if lst[0] == element:\n        return True\n    return prolog_member(element, lst[1:])\n\ndef prolog_append(l1, l2):\n    \"\"\"append([], L, L). append([H|T], L, [H|R]) :- append(T, L, R).\"\"\"\n    if not l1:\n        return l2\n    return [l1[0]] + prolog_append(l1[1:], l2)\n\nprint(f\"member(b, [a,b,c]): {prolog_member('b', ['a','b','c'])}\")\nprint(f\"append([1,2], [3,4]): {prolog_append([1,2], [3,4])}\")"
        ]
