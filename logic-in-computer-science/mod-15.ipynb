      "source": [
        [
          "python",
          "from dataclasses import dataclass, field\nfrom typing import List, Dict, Optional, Tuple, Set\n\n@dataclass(frozen=True)\nclass Var:\n    name: str\n\n@dataclass(frozen=True)\nclass Atom:\n    name: str\n\n@dataclass(frozen=True)\nclass Compound:\n    functor: str\n    args: tuple\n\nTerm = object  # Union[Var, Atom, Compound]\n\n@dataclass\nclass Clause:\n    head: Compound\n    body: List[Compound] = field(default_factory=list)\n\nclass PrologInterpreter:\n    \"\"\"A minimal Prolog interpreter\"\"\"\n\n    def __init__(self):\n        self.clauses: List[Clause] = []\n        self.var_counter = 0\n\n    def add_fact(self, functor, *args):\n        \"\"\"Add a fact to the knowledge base\"\"\"\n        terms = [Atom(a) if isinstance(a, str) and a[0].islower() else Var(a)\n                 for a in args]\n        self.clauses.append(Clause(Compound(functor, tuple(terms))))\n\n    def add_rule(self, head_functor, head_args, body):\n        \"\"\"Add a rule: head :- body\"\"\"\n        head_terms = [Atom(a) if isinstance(a, str) and a[0].islower()\n                      else Var(a) for a in head_args]\n        head = Compound(head_functor, tuple(head_terms))\n\n        body_goals = []\n        for functor, args in body:\n            terms = [Atom(a) if isinstance(a, str) and a[0].islower()\n                     else Var(a) for a in args]\n            body_goals.append(Compound(functor, tuple(terms)))\n\n        self.clauses.append(Clause(head, body_goals))\n\n    def query(self, functor, *args):\n        \"\"\"Query the knowledge base\"\"\"\n        terms = [Atom(a) if isinstance(a, str) and a[0].islower()\n                 else Var(a) for a in args]\n        goal = Compound(functor, tuple(terms))\n        solutions = []\n        for subst in self.solve([goal], {}):\n            solutions.append(subst)\n        return solutions\n\n    def solve(self, goals, subst):\n        \"\"\"SLD resolution: solve a list of goals\"\"\"\n        if not goals:\n            yield subst\n            return\n\n        goal = self.apply_subst(goals[0], subst)\n        rest = goals[1:]\n\n        for clause in self.clauses:\n            # Rename variables in clause to avoid conflicts\n            renamed = self.rename_clause(clause)\n            # Try to unify goal with clause head\n            new_subst = self.unify(goal, renamed.head, dict(subst))\n            if new_subst is not None:\n                # Add clause body to goals\n                new_goals = renamed.body + rest\n                yield from self.solve(new_goals, new_subst)\n\n    def unify(self, t1, t2, subst):\n        \"\"\"Unification algorithm\"\"\"\n        t1 = self.apply_subst(t1, subst)\n        t2 = self.apply_subst(t2, subst)\n\n        if t1 == t2:\n            return subst\n\n        if isinstance(t1, Var):\n            if self.occurs_in(t1, t2):\n                return None\n            subst[t1.name] = t2\n            return subst\n\n        if isinstance(t2, Var):\n            if self.occurs_in(t2, t1):\n                return None\n            subst[t2.name] = t1\n            return subst\n\n        if isinstance(t1, Compound) and isinstance(t2, Compound):\n            if t1.functor != t2.functor or len(t1.args) != len(t2.args):\n                return None\n            for a1, a2 in zip(t1.args, t2.args):\n                subst = self.unify(a1, a2, subst)\n                if subst is None:\n                    return None\n            return subst\n\n        if isinstance(t1, Atom) and isinstance(t2, Atom):\n            return subst if t1.name == t2.name else None\n\n        return None\n\n    def occurs_in(self, var, term):\n        if isinstance(term, Var):\n            return var.name == term.name\n        if isinstance(term, Compound):\n            return any(self.occurs_in(var, arg) for arg in term.args)\n        return False\n\n    def apply_subst(self, term, subst):\n        if isinstance(term, Var):\n            if term.name in subst:\n                return self.apply_subst(subst[term.name], subst)\n            return term\n        if isinstance(term, Compound):\n            new_args = tuple(self.apply_subst(a, subst) for a in term.args)\n            return Compound(term.functor, new_args)\n        return term\n\n    def rename_clause(self, clause):\n        \"\"\"Rename variables to fresh ones\"\"\"\n        self.var_counter += 1\n        suffix = f\"_{self.var_counter}\"\n        mapping = {}\n\n        def rename_term(t):\n            if isinstance(t, Var):\n                if t.name not in mapping:\n                    mapping[t.name] = Var(t.name + suffix)\n                return mapping[t.name]\n            if isinstance(t, Compound):\n                return Compound(t.functor, tuple(rename_term(a) for a in t.args))\n            return t\n\n        new_head = rename_term(clause.head)\n        new_body = [rename_term(g) for g in clause.body]\n        return Clause(new_head, new_body)\n\n# Build a family knowledge base\nprolog = PrologInterpreter()\n\n# Facts\nprolog.add_fact(\"parent\", \"tom\", \"bob\")\nprolog.add_fact(\"parent\", \"tom\", \"liz\")\nprolog.add_fact(\"parent\", \"bob\", \"ann\")\nprolog.add_fact(\"parent\", \"bob\", \"pat\")\nprolog.add_fact(\"male\", \"tom\")\nprolog.add_fact(\"male\", \"bob\")\nprolog.add_fact(\"female\", \"liz\")\nprolog.add_fact(\"female\", \"ann\")\n\n# Rules\nprolog.add_rule(\"father\", [\"X\", \"Y\"],\n                [(\"parent\", [\"X\", \"Y\"]), (\"male\", [\"X\"])])\nprolog.add_rule(\"grandparent\", [\"X\", \"Z\"],\n                [(\"parent\", [\"X\", \"Y\"]), (\"parent\", [\"Y\", \"Z\"])])\n\n# Queries\nprint(\"Who is father of bob?\")\nresults = prolog.query(\"father\", \"X\", \"bob\")\nfor r in results:\n    print(f\"  X = {r.get('X', '?')}\")\n\nprint(\"\\nWho are tom's grandchildren?\")\nresults = prolog.query(\"grandparent\", \"tom\", \"X\")\nfor r in results:\n    val = r.get(\"X\", None)\n    if isinstance(val, Atom):\n        print(f\"  X = {val.name}\")"
        ]
