          "python",
          "def demonstrate_green_vs_red_cut():\n    \"\"\"Show the difference between green and red cuts\"\"\"\n    print(\"GREEN CUT (optimization only):\")\n    print(\"  factorial(0, 1) :- !.\")\n    print(\"  factorial(N, F) :- N1 is N-1, factorial(N1, F1), F is N*F1.\")\n    print(\"  -> Same results with or without !\")\n    print(\"  -> Cut just prevents useless backtracking into clause 2 when N=0\")\n    print()\n    print(\"RED CUT (changes meaning):\")\n    print(\"  classify(X, positive) :- X > 0, !.\")\n    print(\"  classify(X, negative) :- X < 0, !.\")\n    print(\"  classify(0, zero).\")\n    print(\"  -> Without cuts: classify(5, zero) would succeed (WRONG)\")\n    print(\"  -> With cuts: classify(5, zero) fails (CORRECT)\")\n    print(\"  -> The cuts are essential for correctness here\")\n\ndemonstrate_green_vs_red_cut()"
