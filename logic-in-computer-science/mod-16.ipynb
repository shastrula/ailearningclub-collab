          "python",
          "def negation_as_failure(engine, goal):\n    \"\"\"\n    Prolog's \\\\+ (not):\n    \\\\+ Goal succeeds if Goal has no proof.\n\n    Implementation: try to prove Goal.\n    If it succeeds -> \\\\+ Goal fails.\n    If it fails -> \\\\+ Goal succeeds.\n    \"\"\"\n    solutions = list(engine.solve([goal]))\n    if solutions:\n        return False  # Goal succeeded, so \\+ Goal fails\n    else:\n        return True   # Goal failed, so \\+ Goal succeeds\n\n# Example: closed world assumption\n# We only know certain facts. Anything not provable is assumed false.\nprint(\"Negation as Failure:\")\nprint(\"  Known: bird(tweety). bird(opus). penguin(opus).\")\nprint(\"  Rule: flies(X) :- bird(X), \\\\+ penguin(X).\")\nprint(\"  Query: flies(tweety)? -> YES (bird, not penguin)\")\nprint(\"  Query: flies(opus)? -> NO (penguin, so \\\\+ penguin fails)\")"
        ]
