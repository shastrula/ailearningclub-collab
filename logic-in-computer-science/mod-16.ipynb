          "python",
          "class BacktrackingEngine:\n    \"\"\"Demonstrates Prolog's backtracking search\"\"\"\n\n    def __init__(self):\n        self.clauses = {}\n        self.trace = []\n\n    def add_clauses(self, predicate, clauses):\n        \"\"\"Add clauses for a predicate (in order)\"\"\"\n        self.clauses[predicate] = clauses\n\n    def solve(self, goals, subst=None, depth=0):\n        \"\"\"Depth-first search with backtracking\"\"\"\n        if subst is None:\n            subst = {}\n\n        indent = \"  \" * depth\n        self.trace.append(f\"{indent}Solving: {goals} with {subst}\")\n\n        if not goals:\n            self.trace.append(f\"{indent}SUCCESS: {subst}\")\n            yield dict(subst)\n            return\n\n        goal = goals[0]\n        rest = goals[1:]\n        pred = goal[0]\n        args = goal[1:]\n\n        if pred not in self.clauses:\n            self.trace.append(f\"{indent}FAIL: no clauses for {pred}\")\n            return\n\n        for i, clause in enumerate(self.clauses[pred]):\n            head_args, body = clause\n            self.trace.append(f\"{indent}Trying clause {i+1} for {pred}\")\n\n            # Try to match\n            new_subst = self.match(args, head_args, dict(subst))\n            if new_subst is not None:\n                new_goals = body + rest\n                yield from self.solve(new_goals, new_subst, depth + 1)\n                self.trace.append(f\"{indent}Backtracking from clause {i+1}\")\n            else:\n                self.trace.append(f\"{indent}Clause {i+1} doesn't match\")\n\n    def match(self, args1, args2, subst):\n        \"\"\"Simple pattern matching (simplified unification)\"\"\"\n        if len(args1) != len(args2):\n            return None\n        for a1, a2 in zip(args1, args2):\n            a1_val = subst.get(a1, a1) if a1.startswith(\"?\") else a1\n            a2_val = subst.get(a2, a2) if a2.startswith(\"?\") else a2\n\n            if a1_val.startswith(\"?\"):\n                subst[a1_val] = a2_val\n            elif a2_val.startswith(\"?\"):\n                subst[a2_val] = a1_val\n            elif a1_val != a2_val:\n                return None\n        return subst\n\n# Example: Path finding with backtracking\nengine = BacktrackingEngine()\n\n# edge(a,b). edge(a,c). edge(b,d). edge(c,d). edge(c,e).\nengine.add_clauses(\"edge\", [\n    ([\"a\", \"b\"], []),\n    ([\"a\", \"c\"], []),\n    ([\"b\", \"d\"], []),\n    ([\"c\", \"d\"], []),\n    ([\"c\", \"e\"], []),\n])\n\n# path(X,Y) :- edge(X,Y).\n# path(X,Y) :- edge(X,Z), path(Z,Y).\nengine.add_clauses(\"path\", [\n    ([\"?X\", \"?Y\"], [(\"edge\", [\"?X\", \"?Y\"])]),\n    ([\"?X\", \"?Y\"], [(\"edge\", [\"?X\", \"?Z\"]), (\"path\", [\"?Z\", \"?Y\"])]),\n])\n\nprint(\"All paths from a to d:\")\nfor solution in engine.solve([(\"path\", [\"a\", \"?End\"])]):\n    print(f\"  End = {solution.get('?End', '?')}\")"
        ]
      ]
