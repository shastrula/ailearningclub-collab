          "python",
          "class PrologWithCut:\n    \"\"\"Prolog interpreter with cut support\"\"\"\n\n    def __init__(self):\n        self.clauses = {}\n\n    def add_clause(self, pred, head_args, body, has_cut=False, cut_position=None):\n        if pred not in self.clauses:\n            self.clauses[pred] = []\n        self.clauses[pred].append({\n            \"head\": head_args,\n            \"body\": body,\n            \"has_cut\": has_cut,\n            \"cut_position\": cut_position\n        })\n\n    def solve_with_cut(self, goals, subst=None):\n        \"\"\"Solve with cut support\"\"\"\n        if subst is None:\n            subst = {}\n        if not goals:\n            yield dict(subst)\n            return\n\n        goal = goals[0]\n        rest = goals[1:]\n        pred = goal[0]\n        args = goal[1:]\n\n        if pred not in self.clauses:\n            return\n\n        for clause in self.clauses[pred]:\n            new_subst = self.try_match(args, clause[\"head\"], dict(subst))\n            if new_subst is None:\n                continue\n\n            if clause[\"has_cut\"]:\n                # Execute body up to cut, then commit\n                pre_cut = clause[\"body\"][:clause[\"cut_position\"]]\n                post_cut = clause[\"body\"][clause[\"cut_position\"]:]\n\n                for s in self.solve_with_cut(pre_cut + post_cut + rest, new_subst):\n                    yield s\n                return  # CUT: don't try remaining clauses\n\n            else:\n                for s in self.solve_with_cut(clause[\"body\"] + rest, new_subst):\n                    yield s\n\n    def try_match(self, args1, args2, subst):\n        if len(args1) != len(args2):\n            return None\n        for a, b in zip(args1, args2):\n            av = subst.get(a, a) if a.startswith(\"?\") else a\n            bv = subst.get(b, b) if b.startswith(\"?\") else b\n            if av.startswith(\"?\"):\n                subst[av] = bv\n            elif bv.startswith(\"?\"):\n                subst[bv] = av\n            elif av != bv:\n                return None\n        return subst\n\n# Example: max/3 with cut\n# max(X, Y, X) :- X >= Y, !.\n# max(X, Y, Y).\n#\n# Without cut: max(5, 3, X) would give X=5 AND X=3\n# With cut: max(5, 3, X) gives only X=5\n\nprint(\"Demonstrating cut effect:\")\nprint()\nprint(\"Without cut:\")\nprint(\"  max(5, 3, X) -> X=5, X=3 (two solutions, second is WRONG)\")\nprint()\nprint(\"With cut:\")\nprint(\"  max(X, Y, X) :- X >= Y, !.\")\nprint(\"  max(X, Y, Y).\")\nprint(\"  max(5, 3, X) -> X=5 (only correct solution)\")"
        ]
      ]
