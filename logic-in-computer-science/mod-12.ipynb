      "source": [
        [
          "python",
          "from typing import Dict, Set, List, Tuple, Callable\n\nclass KripkeStructure:\n    \"\"\"A Kripke structure for model checking\"\"\"\n\n    def __init__(self):\n        self.states: Set[str] = set()\n        self.initial: Set[str] = set()\n        self.transitions: Dict[str, Set[str]] = {}\n        self.labels: Dict[str, Set[str]] = {}\n\n    def add_state(self, name: str, props: Set[str], is_initial=False):\n        self.states.add(name)\n        self.labels[name] = props\n        if name not in self.transitions:\n            self.transitions[name] = set()\n        if is_initial:\n            self.initial.add(name)\n\n    def add_transition(self, from_state: str, to_state: str):\n        if from_state not in self.transitions:\n            self.transitions[from_state] = set()\n        self.transitions[from_state].add(to_state)\n\n    def successors(self, state: str) -> Set[str]:\n        return self.transitions.get(state, set())\n\n    def predecessors(self, state: str) -> Set[str]:\n        return {s for s in self.states if state in self.transitions.get(s, set())}\n\n# Example: Mutual exclusion protocol\nmutex = KripkeStructure()\nmutex.add_state(\"nn\", {\"idle1\", \"idle2\"}, is_initial=True)\nmutex.add_state(\"tn\", {\"try1\", \"idle2\"})\nmutex.add_state(\"nt\", {\"idle1\", \"try2\"})\nmutex.add_state(\"tt\", {\"try1\", \"try2\"})\nmutex.add_state(\"cn\", {\"crit1\", \"idle2\"})\nmutex.add_state(\"nc\", {\"idle1\", \"crit2\"})\n\nmutex.add_transition(\"nn\", \"tn\")\nmutex.add_transition(\"nn\", \"nt\")\nmutex.add_transition(\"tn\", \"cn\")\nmutex.add_transition(\"tn\", \"tt\")\nmutex.add_transition(\"nt\", \"nc\")\nmutex.add_transition(\"nt\", \"tt\")\nmutex.add_transition(\"tt\", \"cn\")\nmutex.add_transition(\"tt\", \"nc\")\nmutex.add_transition(\"cn\", \"nn\")\nmutex.add_transition(\"nc\", \"nn\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def ctl_check(model: KripkeStructure, state: str, formula) -> bool:\n    \"\"\"Check if a CTL formula holds at a state in a Kripke structure\"\"\"\n\n    if isinstance(formula, str):\n        # Atomic proposition\n        return formula in model.labels.get(state, set())\n\n    op = formula[0]\n\n    if op == \"not\":\n        return not ctl_check(model, state, formula[1])\n\n    elif op == \"and\":\n        return (ctl_check(model, state, formula[1]) and\n                ctl_check(model, state, formula[2]))\n\n    elif op == \"or\":\n        return (ctl_check(model, state, formula[1]) or\n                ctl_check(model, state, formula[2]))\n\n    elif op == \"EX\":\n        return any(ctl_check(model, s, formula[1])\n                   for s in model.successors(state))\n\n    elif op == \"AX\":\n        succs = model.successors(state)\n        return len(succs) > 0 and all(\n            ctl_check(model, s, formula[1]) for s in succs)\n\n    elif op == \"EF\":\n        # Exists a path reaching phi - use reachability (BFS/DFS)\n        return state in compute_EF(model, formula[1])\n\n    elif op == \"AF\":\n        # All paths eventually reach phi\n        return state in compute_AF(model, formula[1])\n\n    elif op == \"EG\":\n        # Exists infinite path where phi always holds\n        return state in compute_EG(model, formula[1])\n\n    elif op == \"AG\":\n        # All paths always satisfy phi\n        return state in compute_AG(model, formula[1])\n\n    return False\n\ndef compute_EF(model: KripkeStructure, phi) -> Set[str]:\n    \"\"\"Compute set of states satisfying EF phi (fixpoint computation)\"\"\"\n    # EF phi = phi v EX(EF phi)  - least fixpoint\n    sat_phi = {s for s in model.states if ctl_check(model, s, phi)}\n    result = set(sat_phi)\n\n    changed = True\n    while changed:\n        changed = False\n        for s in model.states:\n            if s not in result:\n                # s satisfies EF phi if any successor is in result\n                if any(succ in result for succ in model.successors(s)):\n                    result.add(s)\n                    changed = True\n    return result\n\ndef compute_AF(model: KripkeStructure, phi) -> Set[str]:\n    \"\"\"Compute set of states satisfying AF phi\"\"\"\n    # AF phi = phi v AX(AF phi) - least fixpoint\n    sat_phi = {s for s in model.states if ctl_check(model, s, phi)}\n    result = set(sat_phi)\n\n    changed = True\n    while changed:\n        changed = False\n        for s in model.states:\n            if s not in result:\n                succs = model.successors(s)\n                if succs and all(succ in result for succ in succs):\n                    result.add(s)\n                    changed = True\n    return result\n\ndef compute_EG(model: KripkeStructure, phi) -> Set[str]:\n    \"\"\"Compute set of states satisfying EG phi\"\"\"\n    # EG phi = phi ^ EX(EG phi) - greatest fixpoint\n    sat_phi = {s for s in model.states if ctl_check(model, s, phi)}\n    result = set(sat_phi)\n\n    changed = True\n    while changed:\n        changed = False\n        for s in list(result):\n            # s must have at least one successor in result\n            if not any(succ in result for succ in model.successors(s)):\n                result.discard(s)\n                changed = True\n    return result\n\ndef compute_AG(model: KripkeStructure, phi) -> Set[str]:\n    \"\"\"Compute set of states satisfying AG phi\"\"\"\n    # AG phi = ~EF(~phi)\n    sat_not_phi = {s for s in model.states if not ctl_check(model, s, phi)}\n    ef_not_phi = set(sat_not_phi)\n\n    changed = True\n    while changed:\n        changed = False\n        for s in model.states:\n            if s not in ef_not_phi:\n                if any(succ in ef_not_phi for succ in model.successors(s)):\n                    ef_not_phi.add(s)\n                    changed = True\n\n    return model.states - ef_not_phi\n\n# Verify properties of mutual exclusion model\n# Safety: AG ~(crit1 ^ crit2) - never both in critical section\nprint(\"Checking mutex properties:\")\nag_safe = compute_AG(mutex, (\"and\", \"crit1\", \"crit2\"))\n# Should not include initial state if mutex is correct\nprint(f\"  AG(~both_critical): initial state safe = {'nn' not in compute_EF(mutex, ('and', 'crit1', 'crit2'))}\")"
        ]
