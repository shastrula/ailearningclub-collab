          "python",
          "def expressiveness_comparison():\n    \"\"\"Demonstrate CTL vs LTL expressiveness differences\"\"\"\n    examples = {\n        \"Both can express\": [\n            (\"G F p\", \"AG AF p\", \"Infinitely often p\"),\n            (\"G(p -> F q)\", \"AG(p -> AF q)\", \"Every p followed by q\"),\n        ],\n        \"LTL only (no CTL equivalent)\": [\n            (\"F G p\", None, \"Eventually always p\"),\n            (\"G(request -> F grant)\", None,\n             \"Fairness: every request eventually granted (path-based)\"),\n        ],\n        \"CTL only (no LTL equivalent)\": [\n            (None, \"AG EF safe\", \"Can always reach safety\"),\n            (None, \"AG(request -> EF grant)\", \"Every request CAN be granted\"),\n        ],\n    }\n\n    for category, props in examples.items():\n        print(f\"\\n{category}:\")\n        for ltl, ctl, desc in props:\n            ltl_str = f\"LTL: {ltl}\" if ltl else \"LTL: ---\"\n            ctl_str = f\"CTL: {ctl}\" if ctl else \"CTL: ---\"\n            print(f\"  {desc}\")\n            print(f\"    {ltl_str}\")\n            print(f\"    {ctl_str}\")\n\nexpressiveness_comparison()"
        ]
      ]
    }
