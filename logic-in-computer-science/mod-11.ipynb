          "python",
          "phi ::= p | ~phi | phi ^ phi | phi v phi | phi -> phi\n      | X phi | F phi | G phi | phi U psi | phi R psi"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from typing import List, Set\n\n# A trace is a list of sets of atomic propositions\nTrace = List[Set[str]]\n\ndef ltl_check(trace: Trace, formula, position: int = 0) -> bool:\n    \"\"\"Check if an LTL formula holds at a position in a finite trace\"\"\"\n    # For finite traces, we use finite-trace semantics\n\n    if position >= len(trace):\n        return False  # Past end of trace\n\n    if isinstance(formula, str):\n        # Atomic proposition\n        return formula in trace[position]\n\n    op = formula[0]\n\n    if op == \"not\":\n        return not ltl_check(trace, formula[1], position)\n\n    elif op == \"and\":\n        return (ltl_check(trace, formula[1], position) and\n                ltl_check(trace, formula[2], position))\n\n    elif op == \"or\":\n        return (ltl_check(trace, formula[1], position) or\n                ltl_check(trace, formula[2], position))\n\n    elif op == \"implies\":\n        return (not ltl_check(trace, formula[1], position) or\n                ltl_check(trace, formula[2], position))\n\n    elif op == \"X\":  # Next\n        return ltl_check(trace, formula[1], position + 1)\n\n    elif op == \"F\":  # Finally (eventually)\n        return any(ltl_check(trace, formula[1], j)\n                   for j in range(position, len(trace)))\n\n    elif op == \"G\":  # Globally (always)\n        return all(ltl_check(trace, formula[1], j)\n                   for j in range(position, len(trace)))\n\n    elif op == \"U\":  # Until\n        for j in range(position, len(trace)):\n            if ltl_check(trace, formula[2], j):\n                # psi holds at j, check phi holds for all k in [position, j)\n                if all(ltl_check(trace, formula[1], k)\n                       for k in range(position, j)):\n                    return True\n        return False\n\n    return False\n\n# Example trace: a traffic light system\n# States: {red}, {red,yellow}, {green}, {yellow}, {red}, ...\ntraffic_trace = [\n    {\"red\"},\n    {\"red\", \"yellow\"},\n    {\"green\"},\n    {\"green\"},\n    {\"yellow\"},\n    {\"red\"},\n    {\"red\", \"yellow\"},\n    {\"green\"},\n]\n\n# Property: \"green is eventually reached\"\nprint(f\"F green: {ltl_check(traffic_trace, ('F', 'green'))}\")  # True\n\n# Property: \"red holds until green\"\nprint(f\"red U green: {ltl_check(traffic_trace, ('U', 'red', 'green'))}\")  # True\n\n# Property: \"it is always the case that red is eventually followed by green\"\n# G(red -> F green)\nformula = (\"G\", (\"implies\", \"red\", (\"F\", \"green\")))\nprint(f\"G(red -> F green): {ltl_check(traffic_trace, formula)}\")  # True"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Specification pattern library\ndef safety_property(bad_state):\n    \"\"\"G(~bad_state) - bad thing never happens\"\"\"\n    return (\"G\", (\"not\", bad_state))\n\ndef liveness_property(trigger, response):\n    \"\"\"G(trigger -> F response) - trigger always leads to response\"\"\"\n    return (\"G\", (\"implies\", trigger, (\"F\", response)))\n\ndef precedence_property(first, second):\n    \"\"\"~second U first - first must happen before second\"\"\"\n    return (\"U\", (\"not\", second), first)\n\ndef absence_between(event, start, end):\n    \"\"\"G(start -> (~event U end)) - event doesn't occur between start and end\"\"\"\n    return (\"G\", (\"implies\", start, (\"U\", (\"not\", event), end)))\n\n# Verify patterns on a mutual exclusion trace\nmutex_trace = [\n    {\"idle_1\", \"idle_2\"},\n    {\"trying_1\", \"idle_2\"},\n    {\"critical_1\", \"idle_2\"},      # Process 1 in critical section\n    {\"idle_1\", \"trying_2\"},\n    {\"idle_1\", \"critical_2\"},      # Process 2 in critical section\n    {\"idle_1\", \"idle_2\"},\n]\n\n# Mutual exclusion: never both in critical section\nmutex_formula = safety_property(\"both_critical\")\nprint(f\"Mutual exclusion holds: {ltl_check(mutex_trace, mutex_formula)}\")\n\n# Starvation freedom: trying always leads to critical\nno_starve = liveness_property(\"trying_1\", \"critical_1\")\nprint(f\"No starvation (P1): {ltl_check(mutex_trace, no_starve)}\")"
        ]
      ]
    },
