          "python",
          "def ltl_to_automaton_intuition():\n    \"\"\"\n    Illustrate the LTL-to-automaton connection.\n    For G(p -> X q): \"whenever p holds, q holds at the next step\"\n    \"\"\"\n    print(\"LTL formula: G(p -> X q)\")\n    print(\"Equivalent Buchi automaton:\")\n    print()\n    print(\"  States: {s0 (accept)}\")\n    print(\"  Initial: s0\")\n    print(\"  Transitions:\")\n    print(\"    s0 --[~p]--> s0       (p doesn't hold, anything goes)\")\n    print(\"    s0 --[p ^ q in next]--> s0  (p holds, q must hold next)\")\n    print(\"    s0 --[p ^ ~q in next]--> REJECT\")\n    print()\n    print(\"  Accept: visit s0 infinitely often\")\n    print(\"  (This is a safety property, so single accepting state suffices)\")\n\nltl_to_automaton_intuition()"
        ]
      ]
