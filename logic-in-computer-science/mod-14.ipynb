          "python",
          "def symbolic_model_checking_example():\n    \"\"\"\n    Symbolic CTL model checking using BDDs\n\n    System: 2-bit counter (states 00, 01, 10, 11)\n    Variables: x1, x0 (current), x1', x0' (next)\n    Transition: increment mod 4\n\n    Property: AF(x1 ^ x0) - eventually reaches state 11\n    \"\"\"\n    print(\"Symbolic Model Checking Example: 2-bit counter\")\n    print()\n    print(\"State encoding: (x1, x0)\")\n    print(\"States: 00, 01, 10, 11\")\n    print(\"Transition: s' = (s + 1) mod 4\")\n    print()\n    print(\"Transition relation as BDD:\")\n    print(\"  T(x1,x0,x1',x0') = (x1' <-> x1 XOR (x0)) ^ (x0' <-> ~x0)\")\n    print()\n    print(\"Computing AF(x1 ^ x0):\")\n    print(\"  Iteration 0: Sat = {11}\")\n    print(\"  Iteration 1: Sat = {11, 10}  (10 -> 11)\")\n    print(\"  Iteration 2: Sat = {11, 10, 01}  (01 -> 10)\")\n    print(\"  Iteration 3: Sat = {11, 10, 01, 00}  (00 -> 01)\")\n    print(\"  Fixpoint reached: ALL states satisfy AF(x1 ^ x0)\")\n    print()\n    print(\"BDD sizes during computation: 3, 4, 4, 2 nodes\")\n    print(\"(Much smaller than enumerating 4 states explicitly)\")\n\nsymbolic_model_checking_example()"
        ]
