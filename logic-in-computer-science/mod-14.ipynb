        [
          "python",
          "class BDDNode:\n    \"\"\"A node in a Binary Decision Diagram\"\"\"\n\n    def __init__(self, var=None, low=None, high=None, value=None):\n        self.var = var        # Variable name (None for terminals)\n        self.low = low        # Edge for var = False\n        self.high = high      # Edge for var = True\n        self.value = value    # Terminal value (True/False)\n\n    def is_terminal(self):\n        return self.value is not None\n\n    def __repr__(self):\n        if self.is_terminal():\n            return f\"T({self.value})\"\n        return f\"N({self.var})\"\n\nclass BDD:\n    \"\"\"A simple BDD package with reduction\"\"\"\n\n    def __init__(self, var_order):\n        self.var_order = var_order  # List defining variable ordering\n        self.terminal_true = BDDNode(value=True)\n        self.terminal_false = BDDNode(value=False)\n        self.unique_table = {}  # (var, low_id, high_id) -> node\n\n    def mk_node(self, var, low, high):\n        \"\"\"Create a node with reduction rules applied\"\"\"\n        # Elimination rule: if low == high, skip this node\n        if low is high:\n            return low\n\n        # Merge rule: check if this node already exists\n        key = (var, id(low), id(high))\n        if key in self.unique_table:\n            return self.unique_table[key]\n\n        node = BDDNode(var=var, low=low, high=high)\n        self.unique_table[key] = node\n        return node\n\n    def build_from_truth_table(self, func):\n        \"\"\"Build BDD from a function (dict of assignments -> bool)\"\"\"\n        return self._build_recursive(func, 0)\n\n    def _build_recursive(self, func, var_idx):\n        if var_idx >= len(self.var_order):\n            # All variables assigned - return terminal\n            # func should be a single value at this point\n            if isinstance(func, bool):\n                return self.terminal_true if func else self.terminal_false\n            return self.terminal_false\n\n        var = self.var_order[var_idx]\n\n        # Restrict function to var=False and var=True\n        low_func = {k: v for k, v in func.items()\n                    if not k.get(var, False)} if isinstance(func, dict) else func\n        high_func = {k: v for k, v in func.items()\n                     if k.get(var, False)} if isinstance(func, dict) else func\n\n        low = self._build_recursive(low_func, var_idx + 1)\n        high = self._build_recursive(high_func, var_idx + 1)\n\n        return self.mk_node(var, low, high)\n\n    def evaluate(self, node, assignment):\n        \"\"\"Evaluate the BDD for a given variable assignment\"\"\"\n        if node.is_terminal():\n            return node.value\n\n        if assignment.get(node.var, False):\n            return self.evaluate(node.high, assignment)\n        else:\n            return self.evaluate(node.low, assignment)\n\n    def apply(self, op, node1, node2):\n        \"\"\"Apply a Boolean operation to two BDDs\"\"\"\n        # Terminal cases\n        if node1.is_terminal() and node2.is_terminal():\n            result = op(node1.value, node2.value)\n            return self.terminal_true if result else self.terminal_false\n\n        # Determine top variable\n        if node1.is_terminal():\n            top_var = node2.var\n        elif node2.is_terminal():\n            top_var = node1.var\n        else:\n            idx1 = self.var_order.index(node1.var)\n            idx2 = self.var_order.index(node2.var)\n            top_var = self.var_order[min(idx1, idx2)]\n\n        # Cofactor both BDDs with respect to top_var\n        if node1.is_terminal() or node1.var != top_var:\n            low1, high1 = node1, node1\n        else:\n            low1, high1 = node1.low, node1.high\n\n        if node2.is_terminal() or node2.var != top_var:\n            low2, high2 = node2, node2\n        else:\n            low2, high2 = node2.low, node2.high\n\n        # Recurse\n        low_result = self.apply(op, low1, low2)\n        high_result = self.apply(op, high1, high2)\n\n        return self.mk_node(top_var, low_result, high_result)\n\n    def count_nodes(self, node, visited=None):\n        \"\"\"Count nodes in a BDD (shows compression)\"\"\"\n        if visited is None:\n            visited = set()\n        if id(node) in visited:\n            return 0\n        visited.add(id(node))\n        if node.is_terminal():\n            return 1\n        return 1 + self.count_nodes(node.low, visited) + self.count_nodes(node.high, visited)\n\n# Example: Build BDD for (x1 ^ x2) v (x3 ^ x4)\nbdd = BDD([\"x1\", \"x2\", \"x3\", \"x4\"])\n\n# Create atomic BDDs for each variable\nx1 = bdd.mk_node(\"x1\", bdd.terminal_false, bdd.terminal_true)\nx2 = bdd.mk_node(\"x2\", bdd.terminal_false, bdd.terminal_true)\nx3 = bdd.mk_node(\"x3\", bdd.terminal_false, bdd.terminal_true)\nx4 = bdd.mk_node(\"x4\", bdd.terminal_false, bdd.terminal_true)\n\n# Build (x1 AND x2) OR (x3 AND x4)\nand_op = lambda a, b: a and b\nor_op = lambda a, b: a or b\n\nx1_and_x2 = bdd.apply(and_op, x1, x2)\nx3_and_x4 = bdd.apply(and_op, x3, x4)\nresult = bdd.apply(or_op, x1_and_x2, x3_and_x4)\n\n# Test\nprint(f\"f(T,T,F,F) = {bdd.evaluate(result, {'x1':True, 'x2':True, 'x3':False, 'x4':False})}\")\nprint(f\"f(F,F,T,T) = {bdd.evaluate(result, {'x1':False, 'x2':False, 'x3':True, 'x4':True})}\")\nprint(f\"f(T,F,F,T) = {bdd.evaluate(result, {'x1':True, 'x2':False, 'x3':False, 'x4':True})}\")\nprint(f\"BDD nodes: {bdd.count_nodes(result)}\")"
        ]
