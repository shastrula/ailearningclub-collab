          "python",
          "def demonstrate_ordering_impact():\n    \"\"\"Show how variable ordering affects BDD size\"\"\"\n    print(\"Function: (a ^ b) v (c ^ d)\")\n    print()\n    print(\"Ordering [a, b, c, d]:\")\n    print(\"  BDD structure: a -> b -> (T, c -> d -> T)\")\n    print(\"  Nodes: ~5\")\n    print()\n    print(\"Ordering [a, c, b, d]:\")\n    print(\"  BDD structure: larger (interleaved variables)\")\n    print(\"  Nodes: ~7\")\n    print()\n    print(\"For n-bit addition (2n inputs):\")\n    print(\"  Interleaved ordering (a0,b0,a1,b1,...): O(n) nodes\")\n    print(\"  Separated ordering (a0,a1,...,b0,b1,...): O(2^n) nodes\")\n\ndemonstrate_ordering_impact()"
