          "python",
          "from dataclasses import dataclass\nfrom typing import Union\n\n# Types = Propositions\n@dataclass(frozen=True)\nclass Atom:\n    name: str\n\n@dataclass(frozen=True)\nclass Arrow:\n    left: 'Prop'\n    right: 'Prop'\n\n@dataclass(frozen=True)\nclass Product:\n    left: 'Prop'\n    right: 'Prop'\n\n@dataclass(frozen=True)\nclass Sum:\n    left: 'Prop'\n    right: 'Prop'\n\n@dataclass(frozen=True)\nclass UnitType:\n    pass\n\n@dataclass(frozen=True)\nclass VoidType:\n    pass\n\nProp = Union[Atom, Arrow, Product, Sum, UnitType, VoidType]\n\n# Proof Terms = Programs\n@dataclass\nclass Var:\n    name: str\n\n@dataclass\nclass Lam:\n    \"\"\"Lambda abstraction = Implication Introduction\"\"\"\n    param: str\n    param_type: Prop\n    body: 'ProofTerm'\n\n@dataclass\nclass App:\n    \"\"\"Application = Implication Elimination (Modus Ponens)\"\"\"\n    func: 'ProofTerm'\n    arg: 'ProofTerm'\n\n@dataclass\nclass Pair:\n    \"\"\"Pair construction = Conjunction Introduction\"\"\"\n    fst: 'ProofTerm'\n    snd: 'ProofTerm'\n\n@dataclass\nclass Fst:\n    \"\"\"First projection = Conjunction Elimination Left\"\"\"\n    pair: 'ProofTerm'\n\n@dataclass\nclass Snd:\n    \"\"\"Second projection = Conjunction Elimination Right\"\"\"\n    pair: 'ProofTerm'\n\n@dataclass\nclass InL:\n    \"\"\"Left injection = Disjunction Introduction Left\"\"\"\n    value: 'ProofTerm'\n    right_type: Prop\n\n@dataclass\nclass InR:\n    \"\"\"Right injection = Disjunction Introduction Right\"\"\"\n    value: 'ProofTerm'\n    left_type: Prop\n\n@dataclass\nclass Case:\n    \"\"\"Case analysis = Disjunction Elimination\"\"\"\n    scrutinee: 'ProofTerm'\n    left_var: str\n    left_body: 'ProofTerm'\n    right_var: str\n    right_body: 'ProofTerm'\n\n@dataclass\nclass Unit:\n    \"\"\"Unit value = Truth Introduction\"\"\"\n    pass\n\n@dataclass\nclass Absurd:\n    \"\"\"Ex falso quodlibet = False Elimination\"\"\"\n    proof_of_void: 'ProofTerm'\n    result_type: Prop\n\nProofTerm = Union[Var, Lam, App, Pair, Fst, Snd, InL, InR, Case, Unit, Absurd]"
        ]
      ]
    },
    {
