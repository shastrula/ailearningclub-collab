          "python",
          "def proof_normalize(term: ProofTerm) -> ProofTerm:\n    \"\"\"Normalize a proof term = execute the program\"\"\"\n    if isinstance(term, App):\n        func = proof_normalize(term.func)\n        arg = proof_normalize(term.arg)\n        # Beta reduction: (\\x. body) arg --> body[x := arg]\n        if isinstance(func, Lam):\n            return proof_normalize(substitute_proof(func.body, func.param, arg))\n        return App(func, arg)\n\n    elif isinstance(term, Fst):\n        inner = proof_normalize(term.pair)\n        if isinstance(inner, Pair):\n            return inner.fst\n        return Fst(inner)\n\n    elif isinstance(term, Snd):\n        inner = proof_normalize(term.pair)\n        if isinstance(inner, Pair):\n            return inner.snd\n        return Snd(inner)\n\n    return term\n\ndef substitute_proof(term, var_name, replacement):\n    \"\"\"Substitute in proof terms\"\"\"\n    if isinstance(term, Var):\n        return replacement if term.name == var_name else term\n    elif isinstance(term, Lam):\n        if term.param == var_name:\n            return term\n        return Lam(term.param, term.param_type,\n                   substitute_proof(term.body, var_name, replacement))\n    elif isinstance(term, App):\n        return App(substitute_proof(term.func, var_name, replacement),\n                   substitute_proof(term.arg, var_name, replacement))\n    elif isinstance(term, Pair):\n        return Pair(substitute_proof(term.fst, var_name, replacement),\n                    substitute_proof(term.snd, var_name, replacement))\n    elif isinstance(term, Fst):\n        return Fst(substitute_proof(term.pair, var_name, replacement))\n    elif isinstance(term, Snd):\n        return Snd(substitute_proof(term.pair, var_name, replacement))\n    return term\n\n# Proof with a detour: prove B from A^B by pairing and projecting\n# Unnecessarily complex: Snd(Pair(x, y)) normalizes to y\ndetour = Lam(\"p\", Product(A, B),\n    Snd(Pair(Fst(Var(\"p\")), Snd(Var(\"p\")))))\n\nnormalized = proof_normalize(\n    App(detour, Pair(Var(\"a\"), Var(\"b\")))\n)\nprint(f\"Normalized proof: {normalized}\")"
        ]
