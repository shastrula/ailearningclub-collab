      "source": [
        [
          "python",
          "def type_check(term: ProofTerm, env: dict) -> Prop:\n    \"\"\"Type check = Proof check. Returns the proposition proved.\"\"\"\n\n    if isinstance(term, Var):\n        if term.name not in env:\n            raise TypeError(f\"Unbound hypothesis: {term.name}\")\n        return env[term.name]\n\n    elif isinstance(term, Lam):\n        # ->Introduction: assume param_type, prove body's type\n        new_env = {**env, term.param: term.param_type}\n        body_type = type_check(term.body, new_env)\n        return Arrow(term.param_type, body_type)\n\n    elif isinstance(term, App):\n        # ->Elimination (Modus Ponens): from A->B and A, get B\n        func_type = type_check(term.func, env)\n        arg_type = type_check(term.arg, env)\n        if not isinstance(func_type, Arrow):\n            raise TypeError(\"Expected implication/function\")\n        if func_type.left != arg_type:\n            raise TypeError(\"Modus ponens: hypothesis doesn't match\")\n        return func_type.right\n\n    elif isinstance(term, Pair):\n        # ^Introduction: prove A and B separately\n        left_type = type_check(term.fst, env)\n        right_type = type_check(term.snd, env)\n        return Product(left_type, right_type)\n\n    elif isinstance(term, Fst):\n        # ^Elimination Left: from A^B get A\n        pair_type = type_check(term.pair, env)\n        if not isinstance(pair_type, Product):\n            raise TypeError(\"Expected conjunction/product\")\n        return pair_type.left\n\n    elif isinstance(term, Snd):\n        # ^Elimination Right: from A^B get B\n        pair_type = type_check(term.pair, env)\n        if not isinstance(pair_type, Product):\n            raise TypeError(\"Expected conjunction/product\")\n        return pair_type.right\n\n    elif isinstance(term, InL):\n        # vIntroduction Left: from A, get A v B\n        left_type = type_check(term.value, env)\n        return Sum(left_type, term.right_type)\n\n    elif isinstance(term, InR):\n        # vIntroduction Right: from B, get A v B\n        right_type = type_check(term.value, env)\n        return Sum(term.left_type, right_type)\n\n    elif isinstance(term, Case):\n        # vElimination: case analysis\n        scrut_type = type_check(term.scrutinee, env)\n        if not isinstance(scrut_type, Sum):\n            raise TypeError(\"Expected disjunction/sum\")\n        left_env = {**env, term.left_var: scrut_type.left}\n        right_env = {**env, term.right_var: scrut_type.right}\n        left_result = type_check(term.left_body, left_env)\n        right_result = type_check(term.right_body, right_env)\n        if left_result != right_result:\n            raise TypeError(\"Case branches must have same type\")\n        return left_result\n\n    elif isinstance(term, Unit):\n        return UnitType()\n\n    elif isinstance(term, Absurd):\n        proof_type = type_check(term.proof_of_void, env)\n        if not isinstance(proof_type, VoidType):\n            raise TypeError(\"Expected proof of False/Void\")\n        return term.result_type\n\n    raise TypeError(f\"Unknown term: {term}\")\n\n# Example 1: Prove A -> A (identity)\n# Proof: assume A, return it\nA = Atom(\"A\")\nB = Atom(\"B\")\n\nidentity_proof = Lam(\"x\", A, Var(\"x\"))\nproved = type_check(identity_proof, {})\nprint(f\"Identity proves: {proved}\")  # A -> A\n\n# Example 2: Prove A -> B -> A (weakening / K combinator)\nweakening_proof = Lam(\"x\", A, Lam(\"y\", B, Var(\"x\")))\nproved = type_check(weakening_proof, {})\nprint(f\"Weakening proves: {proved}\")  # A -> (B -> A)\n\n# Example 3: Prove (A -> B -> C) -> (A -> B) -> A -> C (S combinator)\nC = Atom(\"C\")\ns_proof = Lam(\"f\", Arrow(A, Arrow(B, C)),\n    Lam(\"g\", Arrow(A, B),\n        Lam(\"x\", A,\n            App(App(Var(\"f\"), Var(\"x\")), App(Var(\"g\"), Var(\"x\"))))))\nproved = type_check(s_proof, {})\nprint(f\"S combinator proves: {proved}\")\n\n# Example 4: Prove A ^ B -> B ^ A (commutativity of conjunction)\ncomm_proof = Lam(\"p\", Product(A, B),\n    Pair(Snd(Var(\"p\")), Fst(Var(\"p\"))))\nproved = type_check(comm_proof, {})\nprint(f\"Commutativity proves: {proved}\")  # A^B -> B^A"
        ]
