        [
          "python",
          "from dataclasses import dataclass\nfrom typing import Union, Tuple, Dict, Optional\n\n@dataclass(frozen=True)\nclass Var:\n    name: str\n\n@dataclass(frozen=True)\nclass Const:\n    name: str\n\n@dataclass(frozen=True)\nclass Func:\n    name: str\n    args: Tuple\n\nTerm = Union[Var, Const, Func]\nSubstitution = Dict[str, Term]\n\ndef apply_substitution(term: Term, subst: Substitution) -> Term:\n    \"\"\"Apply a substitution to a term\"\"\"\n    if isinstance(term, Var):\n        if term.name in subst:\n            return apply_substitution(subst[term.name], subst)\n        return term\n    elif isinstance(term, Const):\n        return term\n    elif isinstance(term, Func):\n        new_args = tuple(apply_substitution(arg, subst) for arg in term.args)\n        return Func(term.name, new_args)\n\n# Example\nt = Func(\"f\", (Var(\"x\"), Func(\"g\", (Var(\"y\"),))))\nsigma = {\"x\": Const(\"a\"), \"y\": Var(\"z\")}\nresult = apply_substitution(t, sigma)\nprint(f\"f(x, g(y)) with {{x/a, y/z}} = {result}\")\n# Result: f(a, g(z))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def occurs_in(var_name: str, term: Term) -> bool:\n    \"\"\"Check if variable occurs in term (prevents infinite terms)\"\"\"\n    if isinstance(term, Var):\n        return term.name == var_name\n    elif isinstance(term, Const):\n        return False\n    elif isinstance(term, Func):\n        return any(occurs_in(var_name, arg) for arg in term.args)\n\ndef unify(t1: Term, t2: Term, subst: Optional[Substitution] = None) -> Optional[Substitution]:\n    \"\"\"Find the most general unifier of two terms\"\"\"\n    if subst is None:\n        subst = {}\n\n    # Apply current substitution\n    t1 = apply_substitution(t1, subst)\n    t2 = apply_substitution(t2, subst)\n\n    # Case 1: identical terms\n    if t1 == t2:\n        return subst\n\n    # Case 2: t1 is a variable\n    if isinstance(t1, Var):\n        if occurs_in(t1.name, t2):\n            return None  # Occurs check failure\n        return {**subst, t1.name: t2}\n\n    # Case 3: t2 is a variable\n    if isinstance(t2, Var):\n        if occurs_in(t2.name, t1):\n            return None  # Occurs check failure\n        return {**subst, t2.name: t1}\n\n    # Case 4: both are function applications\n    if isinstance(t1, Func) and isinstance(t2, Func):\n        if t1.name != t2.name or len(t1.args) != len(t2.args):\n            return None  # Different function symbols or arity\n        for a1, a2 in zip(t1.args, t2.args):\n            subst = unify(a1, a2, subst)\n            if subst is None:\n                return None\n        return subst\n\n    # Case 5: incompatible terms\n    return None\n\n# Examples\nprint(\"Unification examples:\")\nprint(unify(Var(\"x\"), Const(\"a\")))\n# {x: a}\n\nprint(unify(Func(\"f\", (Var(\"x\"), Const(\"b\"))),\n            Func(\"f\", (Const(\"a\"), Var(\"y\")))))\n# {x: a, y: b}\n\nprint(unify(Func(\"f\", (Var(\"x\"),)),\n            Func(\"g\", (Var(\"x\"),))))\n# None (different function symbols)\n\n# Occurs check\nprint(unify(Var(\"x\"), Func(\"f\", (Var(\"x\"),))))\n# None (x occurs in f(x))"
        ]
      ]
