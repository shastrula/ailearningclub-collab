        [
          "python",
          "def first_order_resolve(clause1, clause2):\n    \"\"\"Resolve two first-order clauses\"\"\"\n    resolvents = []\n    for lit1 in clause1:\n        for lit2 in clause2:\n            # Check if literals have complementary signs\n            if lit1[\"positive\"] != lit2[\"positive\"] and lit1[\"pred\"] == lit2[\"pred\"]:\n                # Try to unify the arguments\n                mgu = unify_args(lit1[\"args\"], lit2[\"args\"])\n                if mgu is not None:\n                    # Build resolvent\n                    new_clause = []\n                    for l in clause1:\n                        if l is not lit1:\n                            new_clause.append(apply_subst_to_literal(l, mgu))\n                    for l in clause2:\n                        if l is not lit2:\n                            new_clause.append(apply_subst_to_literal(l, mgu))\n                    resolvents.append(new_clause)\n    return resolvents\n\ndef unify_args(args1, args2):\n    \"\"\"Unify corresponding argument lists\"\"\"\n    subst = {}\n    for a1, a2 in zip(args1, args2):\n        subst = unify(a1, a2, subst)\n        if subst is None:\n            return None\n    return subst\n\ndef apply_subst_to_literal(lit, subst):\n    \"\"\"Apply substitution to all arguments in a literal\"\"\"\n    new_args = tuple(apply_substitution(a, subst) for a in lit[\"args\"])\n    return {\"pred\": lit[\"pred\"], \"positive\": lit[\"positive\"], \"args\": new_args}\n\n# Example: Resolve P(x,a) v Q(x) with ~P(b,y) v R(y)\nclause1 = [\n    {\"pred\": \"P\", \"positive\": True, \"args\": (Var(\"x\"), Const(\"a\"))},\n    {\"pred\": \"Q\", \"positive\": True, \"args\": (Var(\"x\"),)},\n]\nclause2 = [\n    {\"pred\": \"P\", \"positive\": False, \"args\": (Const(\"b\"), Var(\"y\"))},\n    {\"pred\": \"R\", \"positive\": True, \"args\": (Var(\"y\"),)},\n]\nresults = first_order_resolve(clause1, clause2)\nprint(f\"Resolvents: {results}\")\n# Result: [{Q(b), R(a)}]"
        ]
