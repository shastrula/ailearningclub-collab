          "python",
          "def resolve_propositional(clauses):\n    \"\"\"Apply resolution to find if a set of clauses is unsatisfiable\"\"\"\n    clauses = [frozenset(c) for c in clauses]\n    new = set()\n\n    while True:\n        pairs = [(clauses[i], clauses[j])\n                 for i in range(len(clauses))\n                 for j in range(i + 1, len(clauses))]\n\n        for ci, cj in pairs:\n            resolvents = resolve_pair(ci, cj)\n            if frozenset() in resolvents:\n                return True  # Empty clause derived - UNSAT\n            new.update(resolvents)\n\n        if new.issubset(set(clauses)):\n            return False  # No new clauses - SAT\n\n        for c in new:\n            if c not in clauses:\n                clauses.append(c)\n\ndef resolve_pair(c1, c2):\n    \"\"\"Find all resolvents of two clauses\"\"\"\n    resolvents = set()\n    for literal in c1:\n        complement = negate_literal(literal)\n        if complement in c2:\n            # Resolve on this literal\n            new_clause = (c1 - {literal}) | (c2 - {complement})\n            resolvents.add(frozenset(new_clause))\n    return resolvents\n\ndef negate_literal(literal):\n    \"\"\"Negate a literal: 'p' -> '~p', '~p' -> 'p'\"\"\"\n    if literal.startswith(\"~\"):\n        return literal[1:]\n    return \"~\" + literal\n\n# Example: Prove that {p -> q, q -> r} |= p -> r\n# Negate conclusion: p ^ ~r\n# Clauses: {~p v q}, {~q v r}, {p}, {~r}\nclauses = [\n    {\"~p\", \"q\"},    # p -> q\n    {\"~q\", \"r\"},    # q -> r\n    {\"p\"},          # p (from negated conclusion)\n    {\"~r\"},         # ~r (from negated conclusion)\n]\nresult = resolve_propositional(clauses)\nprint(f\"Proof by resolution: {result}\")  # True (UNSAT = valid)"
        ]
      ]
    },
    {
      "cell_type": "code",
