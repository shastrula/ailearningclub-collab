          "python",
          "from dataclasses import dataclass, field\nfrom typing import List, Set, Dict, Tuple, FrozenSet\n\n@dataclass(frozen=True)\nclass Term:\n    \"\"\"A term: either a constant, variable, or compound\"\"\"\n    functor: str\n    args: tuple = ()\n\n    def is_variable(self):\n        return len(self.args) == 0 and self.functor[0].isupper()\n\n    def is_ground(self):\n        if self.is_variable():\n            return False\n        return all(Term(a).is_ground() if isinstance(a, str)\n                   else a.is_ground() for a in self.args)\n\n    def __repr__(self):\n        if not self.args:\n            return self.functor\n        return f\"{self.functor}({', '.join(str(a) for a in self.args)})\"\n\n@dataclass\nclass DefiniteClause:\n    \"\"\"A definite clause: head :- body\"\"\"\n    head: Term\n    body: List[Term] = field(default_factory=list)\n\n    def is_fact(self):\n        return len(self.body) == 0\n\n    def __repr__(self):\n        if self.is_fact():\n            return f\"{self.head}.\"\n        body_str = \", \".join(str(b) for b in self.body)\n        return f\"{self.head} :- {body_str}.\"\n\n@dataclass\nclass DefiniteProgram:\n    \"\"\"A definite logic program (set of definite clauses)\"\"\"\n    clauses: List[DefiniteClause] = field(default_factory=list)\n\n    def facts(self):\n        return [c for c in self.clauses if c.is_fact()]\n\n    def rules(self):\n        return [c for c in self.clauses if not c.is_fact()]\n\n    def predicates(self):\n        return {c.head.functor for c in self.clauses}\n\n# Example program\nprogram = DefiniteProgram([\n    DefiniteClause(Term(\"parent\", (Term(\"tom\"), Term(\"bob\")))),\n    DefiniteClause(Term(\"parent\", (Term(\"tom\"), Term(\"liz\")))),\n    DefiniteClause(Term(\"parent\", (Term(\"bob\"), Term(\"ann\")))),\n    DefiniteClause(\n        Term(\"grandparent\", (Term(\"X\"), Term(\"Z\"))),\n        [Term(\"parent\", (Term(\"X\"), Term(\"Y\"))),\n         Term(\"parent\", (Term(\"Y\"), Term(\"Z\")))]\n    ),\n    DefiniteClause(\n        Term(\"ancestor\", (Term(\"X\"), Term(\"Y\"))),\n        [Term(\"parent\", (Term(\"X\"), Term(\"Y\")))]\n    ),\n    DefiniteClause(\n        Term(\"ancestor\", (Term(\"X\"), Term(\"Y\"))),\n        [Term(\"parent\", (Term(\"X\"), Term(\"Z\"))),\n         Term(\"ancestor\", (Term(\"Z\"), Term(\"Y\")))]\n    ),\n])\n\nprint(f\"Program has {len(program.facts())} facts and {len(program.rules())} rules\")\nprint(f\"Predicates: {program.predicates()}\")"
        ]
      ]
