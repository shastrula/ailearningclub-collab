          "python",
          "def herbrand_base(program):\n    \"\"\"Compute the Herbrand base for a function-free program\"\"\"\n    # Extract constants\n    constants = set()\n    predicates = {}  # name -> arity\n\n    for clause in program.clauses:\n        extract_constants(clause.head, constants, predicates)\n        for goal in clause.body:\n            extract_constants(goal, constants, predicates)\n\n    if not constants:\n        constants = {\"a\"}  # Need at least one constant\n\n    # Generate all ground atoms\n    base = set()\n    for pred, arity in predicates.items():\n        if arity == 0:\n            base.add(Term(pred))\n        else:\n            for combo in combinations_with_replacement(sorted(constants), arity):\n                for perm in set(permutations(combo)):\n                    args = tuple(Term(c) for c in perm)\n                    base.add(Term(pred, args))\n\n    return constants, base\n\ndef extract_constants(term, constants, predicates):\n    \"\"\"Extract constants and predicate info from a term\"\"\"\n    if not term.args:\n        if not term.is_variable():\n            constants.add(term.functor)\n    else:\n        predicates[term.functor] = len(term.args)\n        for arg in term.args:\n            if isinstance(arg, Term):\n                extract_constants(arg, constants, predicates)\n\nfrom itertools import combinations_with_replacement, permutations\n\n# For our family program (no function symbols)\nconstants, base = herbrand_base(program)\nprint(f\"Constants: {constants}\")\nprint(f\"Herbrand base size: {len(base)}\")"
        ]
      ]
