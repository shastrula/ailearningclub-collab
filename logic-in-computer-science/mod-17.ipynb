          "python",
          "def compute_stratification(dependencies):\n    \"\"\"Compute stratification of a logic program\"\"\"\n    # dependencies: list of (pred, dep_pred, is_negative)\n    predicates = set()\n    for p, d, _ in dependencies:\n        predicates.add(p)\n        predicates.add(d)\n\n    strata = {p: 0 for p in predicates}\n    changed = True\n    while changed:\n        changed = False\n        for pred, dep, is_negative in dependencies:\n            min_stratum = strata[dep] + (1 if is_negative else 0)\n            if strata[pred] < min_stratum:\n                strata[pred] = min_stratum\n                changed = True\n\n    return strata\n\n# Example: stratified program\ndeps = [\n    (\"flies\", \"bird\", False),       # flies depends positively on bird\n    (\"flies\", \"abnormal\", True),    # flies depends negatively on abnormal\n    (\"abnormal\", \"penguin\", False), # abnormal depends positively on penguin\n]\nstrata = compute_stratification(deps)\nprint(f\"Stratification: {strata}\")\n# penguin: 0, bird: 0, abnormal: 0, flies: 1"
        ]
      ]
