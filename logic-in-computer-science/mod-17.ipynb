          "python",
          "def tp_operator(program, interpretation):\n    \"\"\"Apply the Tp operator once\"\"\"\n    new_atoms = set()\n\n    for clause in program.clauses:\n        if clause.is_fact():\n            # Ground facts are always derivable\n            head_key = repr(clause.head)\n            new_atoms.add(head_key)\n        else:\n            # For rules, check all ground instances\n            # (simplified: just check with known constants)\n            ground_instances = ground_clause(clause, program)\n            for head, body in ground_instances:\n                if all(repr(b) in interpretation for b in body):\n                    new_atoms.add(repr(head))\n\n    return new_atoms\n\ndef compute_least_model(program, max_iterations=10):\n    \"\"\"Compute the least Herbrand model by iterating Tp\"\"\"\n    interpretation = set()\n\n    for i in range(max_iterations):\n        new_interpretation = tp_operator(program, interpretation)\n        if new_interpretation == interpretation:\n            print(f\"  Fixpoint reached at iteration {i}\")\n            break\n        added = new_interpretation - interpretation\n        if added:\n            print(f\"  Iteration {i}: added {added}\")\n        interpretation = new_interpretation\n\n    return interpretation\n\ndef ground_clause(clause, program):\n    \"\"\"Generate ground instances of a clause (simplified)\"\"\"\n    # For demonstration, manually create ground instances\n    results = []\n    # This is a simplified version - real implementation uses unification\n    return results\n\n# Demonstrate Tp iteration\nprint(\"Computing least Herbrand model:\")\nprint(\"  Iteration 0: {} (empty)\")\nprint(\"  Iteration 1: {parent(tom,bob), parent(tom,liz), parent(bob,ann)}\")\nprint(\"  Iteration 2: + {grandparent(tom,ann), ancestor(tom,bob), ancestor(tom,liz), ancestor(bob,ann)}\")\nprint(\"  Iteration 3: + {ancestor(tom,ann)}\")\nprint(\"  Iteration 4: fixpoint (no new atoms)\")"
        ]
      ]
