          "python",
          "def demonstrate_equivalence():\n    \"\"\"Show the three semantics give the same result\"\"\"\n    print(\"Three Equivalent Semantics for Definite Programs\")\n    print(\"=\" * 50)\n    print()\n    print(\"Program P:\")\n    print(\"  edge(a,b).  edge(b,c).  edge(c,d).\")\n    print(\"  path(X,Y) :- edge(X,Y).\")\n    print(\"  path(X,Y) :- edge(X,Z), path(Z,Y).\")\n    print()\n    print(\"1. LEAST HERBRAND MODEL (smallest satisfying interpretation):\")\n    print(\"   {edge(a,b), edge(b,c), edge(c,d),\")\n    print(\"    path(a,b), path(b,c), path(c,d),\")\n    print(\"    path(a,c), path(b,d), path(a,d)}\")\n    print()\n    print(\"2. FIXPOINT (iterate Tp from empty set):\")\n    print(\"   Tp^0 = {}\")\n    print(\"   Tp^1 = {edge(a,b), edge(b,c), edge(c,d)}\")\n    print(\"   Tp^2 = Tp^1 + {path(a,b), path(b,c), path(c,d)}\")\n    print(\"   Tp^3 = Tp^2 + {path(a,c), path(b,d)}\")\n    print(\"   Tp^4 = Tp^3 + {path(a,d)}\")\n    print(\"   Tp^5 = Tp^4 (fixpoint)\")\n    print()\n    print(\"3. SLD-RESOLUTION (what Prolog computes):\")\n    print(\"   ?- path(a,d).\")\n    print(\"   -> edge(a,Z), path(Z,d)  [Z=b]\")\n    print(\"   -> path(b,d)\")\n    print(\"   -> edge(b,Z'), path(Z',d)  [Z'=c]\")\n    print(\"   -> path(c,d)\")\n    print(\"   -> edge(c,d). SUCCESS!\")\n    print()\n    print(\"All three give the same set of derivable atoms. QED.\")\n\ndemonstrate_equivalence()"
        ]
