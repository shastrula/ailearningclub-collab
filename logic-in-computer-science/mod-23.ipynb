          "python",
          "# Three-valued logic truth tables\nclass ThreeValuedLogic:\n    \"\"\"Kleene's strong three-valued logic\"\"\"\n    T = 1.0   # True\n    F = 0.0   # False\n    U = 0.5   # Unknown\n\n    @staticmethod\n    def NOT(a):\n        return 1.0 - a\n\n    @staticmethod\n    def AND(a, b):\n        return min(a, b)\n\n    @staticmethod\n    def OR(a, b):\n        return max(a, b)\n\n    @staticmethod\n    def IMPLIES(a, b):\n        return max(1.0 - a, b)\n\n    @classmethod\n    def truth_table(cls, op_name, op_func):\n        values = [cls.F, cls.U, cls.T]\n        labels = {cls.F: \"F\", cls.U: \"U\", cls.T: \"T\"}\n        print(f\"\\n{op_name} truth table:\")\n        print(\"    | F   | U   | T\")\n        print(\"----+-----+-----+----\")\n        for a in values:\n            row = f\" {labels[a]}  |\"\n            for b in values:\n                result = op_func(a, b)\n                row += f\" {labels[result]}   |\"\n            print(row)\n\n# Print three-valued truth tables\ntvl = ThreeValuedLogic()\ntvl.truth_table(\"AND\", tvl.AND)\ntvl.truth_table(\"OR\", tvl.OR)\ntvl.truth_table(\"IMPLIES\", tvl.IMPLIES)\n\n# SQL NULL semantics example\nprint(\"\\nSQL NULL behavior:\")\nprint(f\"  NULL AND TRUE  = {tvl.AND(tvl.U, tvl.T)} (Unknown)\")\nprint(f\"  NULL AND FALSE = {tvl.AND(tvl.U, tvl.F)} (False)\")\nprint(f\"  NULL OR TRUE   = {tvl.OR(tvl.U, tvl.T)} (True)\")\nprint(f\"  NULL OR FALSE  = {tvl.OR(tvl.U, tvl.F)} (Unknown)\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
