          "python",
          "def linguistic_hedges():\n    \"\"\"Fuzzy modifiers for linguistic hedges\"\"\"\n    def very(mu):\n        \"\"\"'Very' concentrates the membership (squares it)\"\"\"\n        return lambda x: mu(x) ** 2\n\n    def somewhat(mu):\n        \"\"\"'Somewhat' dilates the membership (square root)\"\"\"\n        return lambda x: math.sqrt(mu(x))\n\n    print(\"Linguistic hedges (for 'tall' where tall(175cm) = 0.6):\")\n    base_value = 0.6\n    print(f\"  tall:           {base_value:.2f}\")\n    print(f\"  very tall:      {base_value ** 2:.2f}\")\n    print(f\"  somewhat tall:  {math.sqrt(base_value):.2f}\")\n    print(f\"  very very tall: {base_value ** 4:.2f}\")\n    print(f\"  not tall:       {1 - base_value:.2f}\")\n\nlinguistic_hedges()"
        ]
      ]
