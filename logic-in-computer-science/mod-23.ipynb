        [
          "python",
          "import math\n\nclass FuzzySet:\n    \"\"\"A fuzzy set defined by a membership function\"\"\"\n\n    def __init__(self, name, membership_func):\n        self.name = name\n        self.mu = membership_func\n\n    def membership(self, x):\n        return self.mu(x)\n\n    def complement(self):\n        return FuzzySet(f\"NOT_{self.name}\", lambda x: 1.0 - self.mu(x))\n\n    def union(self, other):\n        \"\"\"Fuzzy union (max)\"\"\"\n        return FuzzySet(f\"({self.name} OR {other.name})\",\n                        lambda x: max(self.mu(x), other.mu(x)))\n\n    def intersection(self, other):\n        \"\"\"Fuzzy intersection (min)\"\"\"\n        return FuzzySet(f\"({self.name} AND {other.name})\",\n                        lambda x: min(self.mu(x), other.mu(x)))\n\n# Define fuzzy sets for temperature\ndef triangular(a, b, c):\n    \"\"\"Triangular membership function: rises from a to b, falls from b to c\"\"\"\n    def mu(x):\n        if x <= a or x >= c:\n            return 0.0\n        elif x <= b:\n            return (x - a) / (b - a)\n        else:\n            return (c - x) / (c - b)\n    return mu\n\ndef trapezoidal(a, b, c, d):\n    \"\"\"Trapezoidal membership function\"\"\"\n    def mu(x):\n        if x <= a or x >= d:\n            return 0.0\n        elif x <= b:\n            return (x - a) / (b - a)\n        elif x <= c:\n            return 1.0\n        else:\n            return (d - x) / (d - c)\n    return mu\n\n# Temperature fuzzy sets\ncold = FuzzySet(\"cold\", trapezoidal(-10, 0, 5, 15))\nwarm = FuzzySet(\"warm\", triangular(10, 20, 30))\nhot = FuzzySet(\"hot\", trapezoidal(25, 35, 45, 55))\n\n# Check memberships\ntemperatures = [0, 10, 15, 20, 25, 30, 35, 40]\nprint(\"\\nTemperature membership degrees:\")\nprint(f\"{'Temp':>5} | {'Cold':>5} | {'Warm':>5} | {'Hot':>5}\")\nprint(\"-\" * 30)\nfor t in temperatures:\n    print(f\"{t:>5} | {cold.membership(t):>5.2f} | \"\n          f\"{warm.membership(t):>5.2f} | {hot.membership(t):>5.2f}\")"
        ]
      ]
    },
    {
