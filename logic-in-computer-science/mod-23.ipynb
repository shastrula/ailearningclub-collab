          "python",
          "class FuzzyInferenceSystem:\n    \"\"\"A Mamdani-style fuzzy inference system\"\"\"\n\n    def __init__(self):\n        self.rules = []\n        self.output_sets = {}\n\n    def add_rule(self, condition_func, output_set_name):\n        \"\"\"Add a fuzzy rule: IF condition THEN output_set\"\"\"\n        self.rules.append((condition_func, output_set_name))\n\n    def add_output_set(self, name, membership_func):\n        self.output_sets[name] = membership_func\n\n    def infer(self, inputs, output_range):\n        \"\"\"Perform fuzzy inference and defuzzification\"\"\"\n        # Step 1-2: Evaluate rules\n        rule_strengths = {}\n        for condition, output_name in self.rules:\n            strength = condition(inputs)\n            if output_name not in rule_strengths:\n                rule_strengths[output_name] = strength\n            else:\n                rule_strengths[output_name] = max(\n                    rule_strengths[output_name], strength)\n\n        # Step 3-4: Defuzzification (centroid method)\n        numerator = 0.0\n        denominator = 0.0\n        step = (output_range[1] - output_range[0]) / 100\n\n        x = output_range[0]\n        while x <= output_range[1]:\n            # Aggregated output membership\n            mu = 0.0\n            for output_name, strength in rule_strengths.items():\n                if output_name in self.output_sets:\n                    mu = max(mu, min(strength, self.output_sets[output_name](x)))\n            numerator += x * mu\n            denominator += mu\n            x += step\n\n        if denominator == 0:\n            return (output_range[0] + output_range[1]) / 2\n        return numerator / denominator\n\n# Example: Fuzzy temperature controller\n# Input: temperature (0-50), Output: fan speed (0-100)\nfis = FuzzyInferenceSystem()\n\n# Output fuzzy sets for fan speed\nfis.add_output_set(\"low\", trapezoidal(0, 0, 20, 40))\nfis.add_output_set(\"medium\", triangular(30, 50, 70))\nfis.add_output_set(\"high\", trapezoidal(60, 80, 100, 100))\n\n# Rules:\n# IF temperature is cold THEN fan speed is low\nfis.add_rule(lambda inp: cold.membership(inp[\"temp\"]), \"low\")\n# IF temperature is warm THEN fan speed is medium\nfis.add_rule(lambda inp: warm.membership(inp[\"temp\"]), \"medium\")\n# IF temperature is hot THEN fan speed is high\nfis.add_rule(lambda inp: hot.membership(inp[\"temp\"]), \"high\")\n\n# Test the controller\nprint(\"\\nFuzzy Temperature Controller:\")\nprint(f\"{'Temp':>5} | {'Fan Speed':>10}\")\nprint(\"-\" * 20)\nfor temp in [5, 10, 15, 20, 25, 30, 35]:\n    speed = fis.infer({\"temp\": temp}, (0, 100))\n    print(f\"{temp:>5} | {speed:>10.1f}\")"
        ]
