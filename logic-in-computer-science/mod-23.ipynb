        [
          "python",
          "class FuzzyOperators:\n    \"\"\"Different fuzzy logic operator families\"\"\"\n\n    @staticmethod\n    def zadeh_and(a, b):\n        return min(a, b)\n\n    @staticmethod\n    def zadeh_or(a, b):\n        return max(a, b)\n\n    @staticmethod\n    def product_and(a, b):\n        return a * b\n\n    @staticmethod\n    def product_or(a, b):\n        return a + b - a * b\n\n    @staticmethod\n    def lukasiewicz_and(a, b):\n        return max(0, a + b - 1)\n\n    @staticmethod\n    def lukasiewicz_or(a, b):\n        return min(1, a + b)\n\n# Compare operators\nprint(\"\\nComparing fuzzy AND operators (a=0.7, b=0.4):\")\na, b = 0.7, 0.4\nops = FuzzyOperators()\nprint(f\"  Zadeh (min):      {ops.zadeh_and(a, b):.2f}\")\nprint(f\"  Product:          {ops.product_and(a, b):.2f}\")\nprint(f\"  Lukasiewicz:      {ops.lukasiewicz_and(a, b):.2f}\")"
        ]
      ]
    },
