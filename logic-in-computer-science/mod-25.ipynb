          "python",
          "# Z3-style SMT solving (using a Python simulation)\n# In practice, you would use: from z3 import *\n\nclass SMTSolver:\n    \"\"\"Simplified SMT solver interface (simulating Z3)\"\"\"\n\n    def __init__(self):\n        self.constraints = []\n        self.variables = {}\n\n    def Int(self, name):\n        self.variables[name] = \"Int\"\n        return name\n\n    def Bool(self, name):\n        self.variables[name] = \"Bool\"\n        return name\n\n    def add(self, constraint):\n        self.constraints.append(constraint)\n\n    def check(self):\n        \"\"\"Check satisfiability (simplified - brute force for small problems)\"\"\"\n        # In real Z3, this uses DPLL(T) algorithm\n        return \"sat\"  # Simplified\n\n    def solve_linear(self, equations):\n        \"\"\"Solve a system of linear constraints\"\"\"\n        # Simulate Z3's arithmetic theory solver\n        print(\"Solving constraints:\")\n        for eq in equations:\n            print(f\"  {eq}\")\n        return \"sat\"\n\n# Example: Verify array bounds\ndef verify_array_bounds():\n    \"\"\"\n    Use SMT to verify that array accesses are within bounds.\n    Given: array of size n, index i\n    Prove: 0 <= i < n under given constraints\n    \"\"\"\n    print(\"SMT Verification: Array Bounds Check\")\n    print(\"=\" * 40)\n    print()\n    print(\"# Z3 Python API (actual code):\")\n    print(\"\"\"\nfrom z3 import *\n\nn = Int('n')\ni = Int('i')\n\ns = Solver()\n# Program constraints\ns.add(n == 10)\ns.add(i >= 0)\ns.add(i < n)\n\n# Try to find a violation (negate the safety condition)\ns.add(Or(i < 0, i >= n))\n\nresult = s.check()\nif result == unsat:\n    print(\"VERIFIED: array access always in bounds\")\nelse:\n    print(f\"VIOLATION: {s.model()}\")\n    \"\"\")\n    print()\n    print(\"Result: UNSAT (no violation possible)\")\n    print(\"The constraints guarantee safe array access!\")\n\nverify_array_bounds()\n\n# Example: Proving program equivalence\ndef verify_program_equivalence():\n    \"\"\"Verify two implementations compute the same result\"\"\"\n    print(\"\\nSMT Verification: Program Equivalence\")\n    print(\"=\" * 42)\n    print()\n    print(\"Program 1: result = (x + y) * (x - y)\")\n    print(\"Program 2: result = x*x - y*y\")\n    print()\n    print(\"# Z3 verification:\")\n    print(\"\"\"\nfrom z3 import *\n\nx, y = Ints('x y')\nprog1 = (x + y) * (x - y)\nprog2 = x*x - y*y\n\ns = Solver()\ns.add(prog1 != prog2)  # Try to find a counterexample\nresult = s.check()  # unsat -> programs are equivalent\n    \"\"\")\n    print()\n    print(\"Result: UNSAT (no counterexample exists)\")\n    print(\"Programs are equivalent for all integer inputs!\")\n\nverify_program_equivalence()"
        ]
      ]
