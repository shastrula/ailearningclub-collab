          "python",
          "import random\n\nclass PropertyTester:\n    \"\"\"Property-based testing inspired by QuickCheck/Hypothesis\"\"\"\n\n    def __init__(self, num_tests=100):\n        self.num_tests = num_tests\n\n    def for_all(self, generator, property_fn, name=\"property\"):\n        \"\"\"Test that property holds for all generated inputs\"\"\"\n        failures = []\n        for _ in range(self.num_tests):\n            value = generator()\n            try:\n                if not property_fn(value):\n                    failures.append(value)\n            except Exception as e:\n                failures.append((value, str(e)))\n\n        if failures:\n            # Shrink to find minimal counterexample\n            minimal = min(failures, key=lambda x: abs(x) if isinstance(x, int) else len(str(x)))\n            print(f\"  FAILED: {name}\")\n            print(f\"    Counterexample: {minimal}\")\n            return False\n        else:\n            print(f\"  PASSED: {name} ({self.num_tests} tests)\")\n            return True\n\ntester = PropertyTester(num_tests=1000)\n\n# Property: sorting is idempotent\ndef gen_list():\n    return [random.randint(-100, 100) for _ in range(random.randint(0, 20))]\n\ntester.for_all(\n    gen_list,\n    lambda xs: sorted(sorted(xs)) == sorted(xs),\n    \"sort is idempotent\"\n)\n\n# Property: reverse of reverse is identity\ntester.for_all(\n    gen_list,\n    lambda xs: list(reversed(list(reversed(xs)))) == xs,\n    \"reverse . reverse == id\"\n)\n\n# Property: sort preserves length\ntester.for_all(\n    gen_list,\n    lambda xs: len(sorted(xs)) == len(xs),\n    \"sort preserves length\"\n)"
        ]
