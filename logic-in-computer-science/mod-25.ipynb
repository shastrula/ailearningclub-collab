          "python",
          "def tla_plus_example():\n    \"\"\"Demonstrate TLA+ style specification\"\"\"\n    print(\"TLA+ Specification: Two-Phase Commit\")\n    print(\"=\" * 42)\n    print()\n    print(\"\"\"\n---- MODULE TwoPhaseCommit ----\nEXTENDS Integers, Sequences, FiniteSets\n\nCONSTANTS RM  \\\\* Set of resource managers\n\nVARIABLES\n    rmState,      \\\\* rmState[rm] in {\"working\",\"prepared\",\"committed\",\"aborted\"}\n    tmState,      \\\\* Transaction manager state\n    tmPrepared,   \\\\* Set of RMs that sent \"prepared\"\n    msgs          \\\\* Set of messages in transit\n\nInit ==\n    /\\\\ rmState = [rm \\\\in RM |-> \"working\"]\n    /\\\\ tmState = \"init\"\n    /\\\\ tmPrepared = {}\n    /\\\\ msgs = {}\n\nTMCommit ==\n    /\\\\ tmState = \"init\"\n    /\\\\ tmPrepared = RM       \\\\* All RMs prepared\n    /\\\\ tmState' = \"committed\"\n    /\\\\ msgs' = msgs \\\\cup {[type |-> \"Commit\"]}\n    /\\\\ UNCHANGED <<rmState, tmPrepared>>\n\nTMAbort ==\n    /\\\\ tmState = \"init\"\n    /\\\\ tmState' = \"aborted\"\n    /\\\\ msgs' = msgs \\\\cup {[type |-> \"Abort\"]}\n    /\\\\ UNCHANGED <<rmState, tmPrepared>>\n\n\\\\* Safety property: no RM commits while another aborts\nConsistency ==\n    \\\\A rm1, rm2 \\\\in RM:\n        ~(rmState[rm1] = \"committed\" /\\\\ rmState[rm2] = \"aborted\")\n====\n    \"\"\")\n    print(\"TLC model checker verifies Consistency for all reachable states\")\n    print(\"Used at Amazon for DynamoDB, S3, EBS protocols\")\n\ntla_plus_example()"
        ]
      ]
