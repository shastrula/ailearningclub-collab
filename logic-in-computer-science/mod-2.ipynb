          "python",
          "formula ::= atom\n          | ~ formula\n          | formula ^ formula\n          | formula v formula\n          | formula -> formula\n          | formula <-> formula\n          | ( formula )"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Representing propositional logic formulas as Python data structures\nfrom dataclasses import dataclass\nfrom typing import Union\n\n@dataclass\nclass Atom:\n    name: str\n\n@dataclass\nclass Not:\n    operand: 'Formula'\n\n@dataclass\nclass And:\n    left: 'Formula'\n    right: 'Formula'\n\n@dataclass\nclass Or:\n    left: 'Formula'\n    right: 'Formula'\n\n@dataclass\nclass Implies:\n    left: 'Formula'\n    right: 'Formula'\n\n@dataclass\nclass Iff:\n    left: 'Formula'\n    right: 'Formula'\n\nFormula = Union[Atom, Not, And, Or, Implies, Iff]\n\n# Example: (p ^ q) -> r\nformula = Implies(And(Atom(\"p\"), Atom(\"q\")), Atom(\"r\"))"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def evaluate(formula, assignment):\n    \"\"\"Evaluate a propositional formula under a truth assignment\"\"\"\n    if isinstance(formula, Atom):\n        return assignment[formula.name]\n    elif isinstance(formula, Not):\n        return not evaluate(formula.operand, assignment)\n    elif isinstance(formula, And):\n        return evaluate(formula.left, assignment) and evaluate(formula.right, assignment)\n    elif isinstance(formula, Or):\n        return evaluate(formula.left, assignment) or evaluate(formula.right, assignment)\n    elif isinstance(formula, Implies):\n        return not evaluate(formula.left, assignment) or evaluate(formula.right, assignment)\n    elif isinstance(formula, Iff):\n        return evaluate(formula.left, assignment) == evaluate(formula.right, assignment)\n\n# Test: (p ^ q) -> r\nformula = Implies(And(Atom(\"p\"), Atom(\"q\")), Atom(\"r\"))\nprint(evaluate(formula, {\"p\": True, \"q\": True, \"r\": False}))   # False\nprint(evaluate(formula, {\"p\": True, \"q\": False, \"r\": False}))  # True\nprint(evaluate(formula, {\"p\": True, \"q\": True, \"r\": True}))    # True"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import itertools\n\ndef get_variables(formula):\n    \"\"\"Extract all variable names from a formula\"\"\"\n    if isinstance(formula, Atom):\n        return {formula.name}\n    elif isinstance(formula, Not):\n        return get_variables(formula.operand)\n    else:\n        return get_variables(formula.left) | get_variables(formula.right)\n\ndef truth_table(formula):\n    \"\"\"Generate complete truth table for a formula\"\"\"\n    variables = sorted(get_variables(formula))\n    n = len(variables)\n\n    # Header\n    header = \" | \".join(variables) + \" | Result\"\n    print(header)\n    print(\"-\" * len(header))\n\n    # Rows\n    results = []\n    for values in itertools.product([False, True], repeat=n):\n        assignment = dict(zip(variables, values))\n        result = evaluate(formula, assignment)\n        results.append((assignment, result))\n        row = \" | \".join([\"T\" if v else \"F\" for v in values])\n        row += f\" | {'T' if result else 'F'}\"\n        print(row)\n\n    return results\n\n# Example: p -> (q v ~r)\nformula = Implies(Atom(\"p\"), Or(Atom(\"q\"), Not(Atom(\"r\"))))\nprint(\"Truth table for: p -> (q v ~r)\")\ntruth_table(formula)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def is_tautology(formula):\n    \"\"\"Check if a formula is true under all assignments\"\"\"\n    variables = sorted(get_variables(formula))\n    for values in itertools.product([False, True], repeat=len(variables)):\n        assignment = dict(zip(variables, values))\n        if not evaluate(formula, assignment):\n            return False\n    return True\n\ndef is_contradiction(formula):\n    \"\"\"Check if a formula is false under all assignments\"\"\"\n    return is_tautology(Not(formula))\n\ndef is_satisfiable(formula):\n    \"\"\"Check if there exists an assignment making the formula true\"\"\"\n    return not is_contradiction(formula)\n\ndef are_equivalent(f1, f2):\n    \"\"\"Check if two formulas are logically equivalent\"\"\"\n    return is_tautology(Iff(f1, f2))\n\n# Verify De Morgan's law: ~(p ^ q) == (~p v ~q)\nlhs = Not(And(Atom(\"p\"), Atom(\"q\")))\nrhs = Or(Not(Atom(\"p\")), Not(Atom(\"q\")))\nprint(f\"De Morgan's law holds: {are_equivalent(lhs, rhs)}\")  # True\n\n# Verify law of excluded middle is a tautology\nlem = Or(Atom(\"p\"), Not(Atom(\"p\")))\nprint(f\"p v ~p is a tautology: {is_tautology(lem)}\")  # True"
        ]
      ]
    }
