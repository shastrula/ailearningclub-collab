          "python",
          "def infer_example():\n    \"\"\"Simulate Infer-style analysis\"\"\"\n    print(\"Infer-style Bug Detection\")\n    print(\"=\" * 35)\n    print()\n    print(\"Code:\")\n    print(\"  void foo(int* p) {\")\n    print(\"    int* q = malloc(sizeof(int));\")\n    print(\"    if (p != NULL) {\")\n    print(\"      *q = *p;\")\n    print(\"      free(q);\")\n    print(\"    }\")\n    print(\"    // Bug: q leaks when p == NULL!\")\n    print(\"  }\")\n    print()\n    print(\"Separation logic analysis:\")\n    print(\"  Entry: {p -> _ * emp}\")\n    print(\"  After malloc: {p -> _ * q -> _}\")\n    print(\"  If p != NULL: free(q) -> {p -> _ * emp} OK\")\n    print(\"  If p == NULL: {emp * q -> _}\")\n    print(\"    LEAK: q -> _ is unreachable memory!\")\n    print()\n    print(\"Infer reports: MEMORY_LEAK at line 6\")\n\ninfer_example()"
        ]
      ]
