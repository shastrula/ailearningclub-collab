          "python",
          "{P} S {Q}\n-------------------  (Frame)\n{P * R} S {Q * R}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def frame_rule_example():\n    \"\"\"Demonstrate the frame rule for modular reasoning\"\"\"\n    print(\"Frame Rule: {P} S {Q} implies {P * R} S {Q * R}\")\n    print(\"=\" * 55)\n    print()\n    print(\"Example: Incrementing a cell\")\n    print(\"  Local spec: {x -> n} *x := *x + 1 {x -> n+1}\")\n    print()\n    print(\"  With frame (additional memory y -> m):\")\n    print(\"  {x -> n * y -> m} *x := *x + 1 {x -> n+1 * y -> m}\")\n    print()\n    print(\"  The frame rule guarantees y is unchanged because:\")\n    print(\"  1. x -> n and y -> m are in SEPARATE parts of the heap\")\n    print(\"  2. The command only modifies the x -> n part\")\n    print(\"  3. Therefore the y -> m part is preserved\")\n    print()\n    print(\"  Without separation logic, we would need to PROVE that\")\n    print(\"  x != y (non-aliasing) as an additional condition.\")\n    print()\n    print(\"Application: Verifying a linked list function\")\n    print(\"  Local spec: {list(x, xs)} rev(x) {list(ret, reverse(xs))}\")\n    print(\"  Framed: {list(x, xs) * list(y, ys)} rev(x)\")\n    print(\"          {list(ret, reverse(xs)) * list(y, ys)}\")\n    print(\"  The frame rule guarantees rev(x) doesn't corrupt list y!\")\n\nframe_rule_example()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def linked_list_assertion():\n    \"\"\"\n    Define linked list predicate using separation logic:\n\n    list(null, []) = emp\n    list(x, v::vs) = x -> (v, next) * list(next, vs)\n\n    This says: a list is either empty (emp) or a cell containing\n    the head value and a next pointer, SEPARATE from the rest of the list.\n    \"\"\"\n    # Simplified linked list in Python\n    class Node:\n        def __init__(self, val, next_addr=None):\n            self.val = val\n            self.next = next_addr\n\n    # Represent heap for list [1, 2, 3]\n    # addr 10 -> (1, 20), addr 20 -> (2, 30), addr 30 -> (3, None)\n    heap = {\n        10: (1, 20),\n        20: (2, 30),\n        30: (3, None),\n    }\n\n    print(\"Linked list [1, 2, 3] in separation logic:\")\n    print(\"  list(10, [1,2,3]) =\")\n    print(\"    10 -> (1, 20) * 20 -> (2, 30) * 30 -> (3, null)\")\n    print()\n    print(\"  This asserts all nodes are in SEPARATE memory!\")\n    print(\"  No two nodes share an address (no cycles by construction)\")\n    print()\n    print(\"Verification of list append:\")\n    print(\"  {list(x, xs) * list(y, ys)}\")\n    print(\"  append(x, y)\")\n    print(\"  {list(ret, xs ++ ys)}\")\n    print()\n    print(\"  Separating conjunction guarantees no sharing between\")\n    print(\"  the two input lists - essential for correctness!\")\n\nlinked_list_assertion()"
        ]
      ]
    },
