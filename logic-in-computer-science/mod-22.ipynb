    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def concurrent_separation_logic():\n    \"\"\"Demonstrate concurrent separation logic\"\"\"\n    print(\"Concurrent Separation Logic\")\n    print(\"=\" * 40)\n    print()\n    print(\"Thread 1: {x -> a} *x := *x + 1 {x -> a+1}\")\n    print(\"Thread 2: {y -> b} *y := *y + 1 {y -> b+1}\")\n    print()\n    print(\"Parallel composition (x and y are separate):\")\n    print(\"  {x -> a * y -> b}\")\n    print(\"  *x := *x + 1 || *y := *y + 1\")\n    print(\"  {x -> a+1 * y -> b+1}\")\n    print()\n    print(\"The separating conjunction GUARANTEES no data race!\")\n    print(\"If x == y, the precondition x -> a * y -> b would be\")\n    print(\"unsatisfiable, so the parallel rule doesn't apply.\")\n    print()\n    print(\"For shared resources, we use lock invariants:\")\n    print(\"  lock(l, R): lock l protects resource R\")\n    print(\"  acquire(l): gains access to R\")\n    print(\"  release(l): gives up R\")\n\nconcurrent_separation_logic()"
        ]
      ]
    },
    {
