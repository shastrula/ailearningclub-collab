    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# The aliasing problem\ndef aliasing_problem():\n    \"\"\"Demonstrate why classical Hoare logic fails with pointers\"\"\"\n    # In classical Hoare logic:\n    # {x == 1 and y == 1} x := x + 1 {x == 2 and y == 1}\n    # This is VALID because x and y are independent variables.\n\n    # But with pointers:\n    # {*p == 1 and *q == 1} *p := *p + 1 {*p == 2 and *q == 1}\n    # This is INVALID if p == q (aliasing)!\n\n    # Example:\n    heap = {\"addr_42\": 1}\n    p = \"addr_42\"\n    q = \"addr_42\"  # Aliased!\n\n    print(f\"Before: *p={heap[p]}, *q={heap[q]}\")\n    heap[p] = heap[p] + 1  # *p := *p + 1\n    print(f\"After:  *p={heap[p]}, *q={heap[q]}\")  # *q also changed!\n    print(\"Classical postcondition {*p==2 and *q==1} is VIOLATED!\")\n\naliasing_problem()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from dataclasses import dataclass\nfrom typing import Dict, Set, Optional, Tuple\n\n# A heap is a partial function from addresses to values\nHeap = Dict[int, int]\n\n@dataclass\nclass Emp:\n    \"\"\"Empty heap assertion\"\"\"\n    pass\n\n@dataclass\nclass PointsTo:\n    \"\"\"x -> v: address x maps to value v\"\"\"\n    addr: int\n    value: int\n\n@dataclass\nclass SepConj:\n    \"\"\"P * Q: P and Q hold on disjoint heap parts\"\"\"\n    left: 'HeapAssertion'\n    right: 'HeapAssertion'\n\n@dataclass\nclass Pure:\n    \"\"\"Pure assertion (doesn't talk about heap)\"\"\"\n    condition: bool\n\nHeapAssertion = object  # Union of above\n\ndef satisfies(heap: Heap, assertion) -> bool:\n    \"\"\"Check if a heap satisfies an assertion\"\"\"\n    if isinstance(assertion, Emp):\n        return len(heap) == 0\n\n    elif isinstance(assertion, PointsTo):\n        # Heap has EXACTLY one cell: addr -> value\n        return heap == {assertion.addr: assertion.value}\n\n    elif isinstance(assertion, Pure):\n        return assertion.condition and len(heap) == 0\n\n    elif isinstance(assertion, SepConj):\n        # Try all ways to split heap into two disjoint parts\n        for split in all_splits(heap):\n            h1, h2 = split\n            if satisfies(h1, assertion.left) and satisfies(h2, assertion.right):\n                return True\n        return False\n\n    return False\n\ndef all_splits(heap: Heap):\n    \"\"\"Generate all ways to split a heap into two disjoint parts\"\"\"\n    keys = list(heap.keys())\n    n = len(keys)\n    for mask in range(2**n):\n        h1 = {}\n        h2 = {}\n        for i, k in enumerate(keys):\n            if mask & (1 << i):\n                h1[k] = heap[k]\n            else:\n                h2[k] = heap[k]\n        yield h1, h2\n\n# Example: x -> 3 * y -> 7 means two separate cells\nheap = {100: 3, 200: 7}  # x=100, y=200\nassertion = SepConj(PointsTo(100, 3), PointsTo(200, 7))\nprint(f\"{{100:3, 200:7}} |= (100->3 * 200->7): {satisfies(heap, assertion)}\")\n\n# With aliasing (same address), separating conjunction fails\nheap_aliased = {100: 3}  # only one cell\nassertion_aliased = SepConj(PointsTo(100, 3), PointsTo(100, 7))\nprint(f\"{{100:3}} |= (100->3 * 100->7): {satisfies(heap_aliased, assertion_aliased)}\")\n# False! Cannot split one cell into two disjoint parts"
        ]
      ]
    },
