          "python",
          "def check_isomorphism(s1, s2, mapping):\n    \"\"\"Verify that a mapping is an isomorphism\"\"\"\n    # Check bijection\n    if set(mapping.keys()) != s1.domain:\n        return False\n    if set(mapping.values()) != s2.domain:\n        return False\n\n    # Check relations are preserved\n    for rel_name in s1.relations:\n        for tup in s1.relations[rel_name]:\n            mapped_tup = tuple(mapping[x] for x in tup)\n            if mapped_tup not in s2.relations.get(rel_name, set()):\n                return False\n\n    # Check inverse: relations in s2 must come from s1\n    inv_mapping = {v: k for k, v in mapping.items()}\n    for rel_name in s2.relations:\n        for tup in s2.relations[rel_name]:\n            mapped_tup = tuple(inv_mapping[x] for x in tup)\n            if mapped_tup not in s1.relations.get(rel_name, set()):\n                return False\n\n    return True\n\n# Two isomorphic graphs (same structure, different labels)\ng1 = FOStructure(\n    domain={\"a\", \"b\", \"c\"},\n    relations={\"Edge\": {(\"a\",\"b\"), (\"b\",\"c\"), (\"a\",\"c\")}}\n)\ng2 = FOStructure(\n    domain={1, 2, 3},\n    relations={\"Edge\": {(1,2), (2,3), (1,3)}}\n)\n\n# The mapping a->1, b->2, c->3 should be an isomorphism\nmapping = {\"a\": 1, \"b\": 2, \"c\": 3}\nprint(f\"Graphs are isomorphic: {check_isomorphism(g1, g2, mapping)}\")"
        ]
