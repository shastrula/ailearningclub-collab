          "python",
          "def show_definability_examples():\n    \"\"\"Demonstrate what is and isn't first-order definable\"\"\"\n    examples = [\n        {\n            \"property\": \"x is a leaf node (in a graph)\",\n            \"definable\": True,\n            \"formula\": \"exists! y. Edge(x,y)  [exactly one neighbor]\",\n        },\n        {\n            \"property\": \"Graph is connected\",\n            \"definable\": False,\n            \"reason\": \"Requires unbounded path length (transitive closure)\",\n        },\n        {\n            \"property\": \"Set is finite\",\n            \"definable\": False,\n            \"reason\": \"Lowenheim-Skolem: any FO theory with arbitrarily large finite models has infinite models\",\n        },\n        {\n            \"property\": \"x is even (in arithmetic with +)\",\n            \"definable\": True,\n            \"formula\": \"exists y. x = y + y\",\n        },\n    ]\n\n    for ex in examples:\n        status = \"DEFINABLE\" if ex[\"definable\"] else \"NOT DEFINABLE\"\n        print(f\"[{status}] {ex['property']}\")\n        if ex[\"definable\"]:\n            print(f\"  Formula: {ex['formula']}\")\n        else:\n            print(f\"  Reason: {ex['reason']}\")\n        print()\n\nshow_definability_examples()"
        ]
      ]
