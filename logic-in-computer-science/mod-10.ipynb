        [
          "python",
          "class FOStructure:\n    \"\"\"A first-order structure (interpretation)\"\"\"\n\n    def __init__(self, domain, constants=None, functions=None, relations=None):\n        self.domain = set(domain)\n        self.constants = constants or {}    # name -> element\n        self.functions = functions or {}    # name -> callable\n        self.relations = relations or {}    # name -> set of tuples\n\n    def satisfies_atomic(self, predicate_name, args):\n        \"\"\"Check if a ground atomic formula holds\"\"\"\n        return tuple(args) in self.relations.get(predicate_name, set())\n\n    def __repr__(self):\n        return (f\"Structure(domain={self.domain}, \"\n                f\"constants={self.constants}, \"\n                f\"relations={self.relations})\")\n\n# Example: A graph structure\ngraph = FOStructure(\n    domain={1, 2, 3, 4},\n    constants={\"a\": 1, \"b\": 4},\n    relations={\n        \"Edge\": {(1,2), (2,3), (3,4), (1,3)},\n        \"Node\": {(1,), (2,), (3,), (4,)},\n    }\n)\n\n# Example: Natural numbers with successor\nnat_structure = FOStructure(\n    domain=set(range(10)),  # finite approximation\n    constants={\"zero\": 0},\n    functions={\"succ\": lambda x: x + 1 if x < 9 else 9},\n    relations={\n        \"Even\": {(x,) for x in range(10) if x % 2 == 0},\n        \"LessThan\": {(x, y) for x in range(10) for y in range(10) if x < y},\n    }\n)"
        ]
      ]
    },
    {
