        [
          "python",
          "class Theory:\n    \"\"\"A first-order theory defined by axioms\"\"\"\n\n    def __init__(self, name, axioms=None):\n        self.name = name\n        self.axioms = axioms or []\n        self.models = []\n\n    def add_axiom(self, description, checker):\n        \"\"\"Add an axiom (as a description + a model-checking function)\"\"\"\n        self.axioms.append({\"description\": description, \"checker\": checker})\n\n    def is_model(self, structure):\n        \"\"\"Check if a structure satisfies all axioms\"\"\"\n        return all(axiom[\"checker\"](structure) for axiom in self.axioms)\n\n    def find_models(self, candidates):\n        \"\"\"Find all models among candidate structures\"\"\"\n        return [s for s in candidates if self.is_model(s)]\n\n# Theory of partial orders\npartial_order = Theory(\"Partial Order\")\n\n# Reflexivity: forall x. x <= x\npartial_order.add_axiom(\n    \"Reflexivity: forall x. Leq(x, x)\",\n    lambda s: all((x, x) in s.relations.get(\"Leq\", set()) for x in s.domain)\n)\n\n# Antisymmetry: forall x,y. (x <= y ^ y <= x) -> x = y\npartial_order.add_axiom(\n    \"Antisymmetry: forall x,y. (Leq(x,y) ^ Leq(y,x)) -> x=y\",\n    lambda s: all(\n        not ((x, y) in s.relations.get(\"Leq\", set()) and\n             (y, x) in s.relations.get(\"Leq\", set()))\n        or x == y\n        for x in s.domain for y in s.domain\n    )\n)\n\n# Transitivity: forall x,y,z. (x <= y ^ y <= z) -> x <= z\npartial_order.add_axiom(\n    \"Transitivity: forall x,y,z. (Leq(x,y) ^ Leq(y,z)) -> Leq(x,z)\",\n    lambda s: all(\n        not ((x, y) in s.relations.get(\"Leq\", set()) and\n             (y, z) in s.relations.get(\"Leq\", set()))\n        or (x, z) in s.relations.get(\"Leq\", set())\n        for x in s.domain for y in s.domain for z in s.domain\n    )\n)\n\n# Test: is {1,2,3} with <= a partial order?\nnumbers = FOStructure(\n    domain={1, 2, 3},\n    relations={\"Leq\": {(x, y) for x in [1,2,3] for y in [1,2,3] if x <= y}}\n)\nprint(f\"Numbers with <= is a partial order: {partial_order.is_model(numbers)}\")\n\n# Non-example: a non-transitive relation\nbad = FOStructure(\n    domain={1, 2, 3},\n    relations={\"Leq\": {(1,1), (2,2), (3,3), (1,2), (2,3)}}  # missing (1,3)\n)\nprint(f\"Missing transitivity: {partial_order.is_model(bad)}\")"
        ]
      ]
    },
