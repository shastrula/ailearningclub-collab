          "python",
          "def demonstrate_lowenheim_skolem():\n    \"\"\"\n    Illustration: A theory satisfied by all finite sets of size >= n\n    must also have an infinite model.\n\n    Theory T_n = \"there exist at least n distinct elements\"\n    T = union of all T_n\n\n    Every finite subset of T is satisfiable (just take a large enough\n    finite domain), so by compactness, T itself is satisfiable.\n    The model must be infinite.\n    \"\"\"\n    print(\"Lowenheim-Skolem illustration:\")\n    print()\n    print(\"Theory axioms:\")\n    for n in range(1, 6):\n        vars_list = [f\"x{i}\" for i in range(1, n+1)]\n        distincts = [f\"x{i} != x{j}\"\n                     for i in range(1, n+1)\n                     for j in range(i+1, n+1)]\n        axiom = f\"exists {', '.join(vars_list)}. ({' ^ '.join(distincts)})\"\n        print(f\"  A{n}: {axiom}\")\n    print(\"  ...\")\n    print()\n    print(\"Every finite subset of these axioms has a finite model.\")\n    print(\"By compactness, the full set has a model - which must be infinite.\")\n    print()\n    print(\"Consequence: cannot define 'finite' in first-order logic!\")\n\ndemonstrate_lowenheim_skolem()"
        ]
      ]
    },
