          "python",
          "def non_monotonic_example():\n    \"\"\"Demonstrate non-monotonic reasoning with defaults\"\"\"\n    class DefaultReasoner:\n        def __init__(self):\n            self.facts = set()\n            self.defaults = []  # (prerequisite, justification, conclusion)\n\n        def add_fact(self, fact):\n            self.facts.add(fact)\n\n        def add_default(self, prerequisite, justification, conclusion):\n            \"\"\"Default: prerequisite : justification / conclusion\"\"\"\n            self.defaults.append((prerequisite, justification, conclusion))\n\n        def reason(self):\n            \"\"\"Apply defaults (simplified - one extension)\"\"\"\n            conclusions = set(self.facts)\n            changed = True\n            while changed:\n                changed = False\n                for prereq, just, conc in self.defaults:\n                    if prereq in conclusions:\n                        # Check justification (not inconsistent)\n                        negated_just = f\"~{just}\" if not just.startswith(\"~\") else just[1:]\n                        if negated_just not in conclusions and conc not in conclusions:\n                            conclusions.add(conc)\n                            changed = True\n            return conclusions\n\n    reasoner = DefaultReasoner()\n    reasoner.add_fact(\"bird(tweety)\")\n    reasoner.add_fact(\"bird(opus)\")\n    reasoner.add_fact(\"penguin(opus)\")\n\n    # Default: bird(X) : flies(X) / flies(X)\n    # \"If X is a bird and it's consistent that X flies, conclude X flies\"\n    reasoner.add_default(\"bird(tweety)\", \"flies(tweety)\", \"flies(tweety)\")\n    reasoner.add_default(\"bird(opus)\", \"flies(opus)\", \"flies(opus)\")\n\n    # Exception: penguins don't fly\n    reasoner.add_fact(\"~flies(opus)\")  # Blocks the default for opus\n\n    conclusions = reasoner.reason()\n    print(\"Non-monotonic reasoning:\")\n    print(f\"  Conclusions: {sorted(conclusions)}\")\n    print(f\"  Tweety flies: {'flies(tweety)' in conclusions}\")\n    print(f\"  Opus flies: {'flies(opus)' in conclusions}\")\n\nnon_monotonic_example()"
        ]
