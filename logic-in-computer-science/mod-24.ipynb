          "python",
          "class FirstOrderKB:\n    \"\"\"A simplified first-order knowledge base\"\"\"\n\n    def __init__(self):\n        self.facts = set()       # Ground atoms: (\"pred\", (arg1, arg2, ...))\n        self.rules = []          # (conditions, conclusion_pred, var_mapping)\n\n    def add_fact(self, predicate: str, *args):\n        self.facts.add((predicate, args))\n\n    def add_rule(self, conditions, conclusion_pred, conclusion_args):\n        \"\"\"Add a universally quantified rule\"\"\"\n        self.rules.append((conditions, conclusion_pred, conclusion_args))\n\n    def query(self, predicate: str, *args) -> List[Dict]:\n        \"\"\"Query with variables (uppercase = variable)\"\"\"\n        results = []\n        for fact_pred, fact_args in self.facts:\n            if fact_pred == predicate:\n                binding = self.match(args, fact_args)\n                if binding is not None:\n                    results.append(binding)\n        return results\n\n    def match(self, pattern, ground):\n        \"\"\"Pattern match with variables\"\"\"\n        if len(pattern) != len(ground):\n            return None\n        binding = {}\n        for p, g in zip(pattern, ground):\n            if isinstance(p, str) and p[0].isupper():\n                if p in binding and binding[p] != g:\n                    return None\n                binding[p] = g\n            elif p != g:\n                return None\n        return binding\n\n    def forward_chain(self, max_iterations=10):\n        \"\"\"Apply rules to derive new facts\"\"\"\n        for _ in range(max_iterations):\n            new_facts = set()\n            for conditions, conc_pred, conc_args in self.rules:\n                # Find all satisfying assignments\n                for binding in self.find_bindings(conditions):\n                    # Apply binding to conclusion\n                    ground_args = tuple(\n                        binding.get(a, a) for a in conc_args)\n                    new_fact = (conc_pred, ground_args)\n                    if new_fact not in self.facts:\n                        new_facts.add(new_fact)\n\n            if not new_facts:\n                break\n            self.facts.update(new_facts)\n\n    def find_bindings(self, conditions):\n        \"\"\"Find all variable bindings satisfying conditions\"\"\"\n        if not conditions:\n            yield {}\n            return\n\n        first_pred, first_args = conditions[0]\n        rest = conditions[1:]\n\n        for fact_pred, fact_args in self.facts:\n            if fact_pred == first_pred:\n                binding = self.match(first_args, fact_args)\n                if binding is not None:\n                    for rest_binding in self.find_bindings_with(rest, binding):\n                        yield {**binding, **rest_binding}\n\n    def find_bindings_with(self, conditions, existing_binding):\n        \"\"\"Find bindings consistent with existing binding\"\"\"\n        if not conditions:\n            yield {}\n            return\n\n        first_pred, first_args = conditions[0]\n        rest = conditions[1:]\n\n        # Apply existing binding to first condition\n        ground_args = tuple(existing_binding.get(a, a) for a in first_args)\n\n        for fact_pred, fact_args in self.facts:\n            if fact_pred == first_pred:\n                binding = self.match(ground_args, fact_args)\n                if binding is not None:\n                    for rest_binding in self.find_bindings_with(rest, {**existing_binding, **binding}):\n                        yield {**binding, **rest_binding}\n\n# Example: Family relationships\nfamily_kb = FirstOrderKB()\nfamily_kb.add_fact(\"parent\", \"tom\", \"bob\")\nfamily_kb.add_fact(\"parent\", \"tom\", \"liz\")\nfamily_kb.add_fact(\"parent\", \"bob\", \"ann\")\nfamily_kb.add_fact(\"parent\", \"bob\", \"pat\")\nfamily_kb.add_fact(\"male\", \"tom\")\nfamily_kb.add_fact(\"male\", \"bob\")\nfamily_kb.add_fact(\"female\", \"liz\")\nfamily_kb.add_fact(\"female\", \"ann\")\n\n# Rule: parent(X,Y) ^ male(X) -> father(X,Y)\nfamily_kb.add_rule(\n    [(\"parent\", (\"X\", \"Y\")), (\"male\", (\"X\",))],\n    \"father\", (\"X\", \"Y\")\n)\n# Rule: parent(X,Y) ^ parent(Y,Z) -> grandparent(X,Z)\nfamily_kb.add_rule(\n    [(\"parent\", (\"X\", \"Y\")), (\"parent\", (\"Y\", \"Z\"))],\n    \"grandparent\", (\"X\", \"Z\")\n)\n\nfamily_kb.forward_chain()\nprint(\"\\nFamily KB after forward chaining:\")\nfor pred, args in sorted(family_kb.facts):\n    print(f\"  {pred}({', '.join(args)})\")"
        ]
