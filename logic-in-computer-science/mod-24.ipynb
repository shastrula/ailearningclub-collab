          "python",
          "from typing import Set, Dict, List, Tuple, Optional\nimport itertools\n\nclass PropositionalKB:\n    \"\"\"A propositional knowledge base with inference\"\"\"\n\n    def __init__(self):\n        self.clauses: List[Set[str]] = []  # CNF clauses\n        self.facts: Set[str] = set()\n\n    def tell(self, clause: Set[str]):\n        \"\"\"Add a clause to the knowledge base\"\"\"\n        self.clauses.append(clause)\n        # Unit clauses are immediate facts\n        if len(clause) == 1:\n            lit = next(iter(clause))\n            if not lit.startswith(\"~\"):\n                self.facts.add(lit)\n\n    def tell_fact(self, fact: str):\n        \"\"\"Add a ground fact\"\"\"\n        self.clauses.append({fact})\n        self.facts.add(fact)\n\n    def tell_rule(self, antecedents: List[str], consequent: str):\n        \"\"\"Add a rule: if all antecedents then consequent\"\"\"\n        # A ^ B -> C becomes ~A v ~B v C\n        clause = {f\"~{a}\" for a in antecedents} | {consequent}\n        self.clauses.append(clause)\n\n    def forward_chain(self) -> Set[str]:\n        \"\"\"Forward chaining: derive all consequences\"\"\"\n        inferred = set(self.facts)\n        changed = True\n\n        while changed:\n            changed = False\n            for clause in self.clauses:\n                # Check if all negative literals are satisfied\n                positive = {l for l in clause if not l.startswith(\"~\")}\n                negative = {l[1:] for l in clause if l.startswith(\"~\")}\n\n                # If all negatives are in inferred, one positive must hold\n                if negative.issubset(inferred):\n                    for p in positive:\n                        if p not in inferred:\n                            inferred.add(p)\n                            changed = True\n                            break\n\n        return inferred\n\n    def ask(self, query: str) -> bool:\n        \"\"\"Check if a query is entailed by the knowledge base\"\"\"\n        return query in self.forward_chain()\n\n# Example: Medical diagnosis knowledge base\nmedical_kb = PropositionalKB()\n\n# Facts about patient\nmedical_kb.tell_fact(\"fever\")\nmedical_kb.tell_fact(\"cough\")\nmedical_kb.tell_fact(\"fatigue\")\n\n# Rules\nmedical_kb.tell_rule([\"fever\", \"cough\"], \"possible_flu\")\nmedical_kb.tell_rule([\"fever\", \"rash\"], \"possible_measles\")\nmedical_kb.tell_rule([\"possible_flu\", \"fatigue\"], \"likely_flu\")\nmedical_kb.tell_rule([\"likely_flu\"], \"recommend_rest\")\nmedical_kb.tell_rule([\"likely_flu\"], \"recommend_fluids\")\n\n# Inference\ninferred = medical_kb.forward_chain()\nprint(\"Medical KB inferences:\")\nfor fact in sorted(inferred):\n    print(f\"  {fact}\")\n\nprint(f\"\\nAsk 'recommend_rest'? {medical_kb.ask('recommend_rest')}\")\nprint(f\"Ask 'possible_measles'? {medical_kb.ask('possible_measles')}\")"
        ]
      ]
    },
