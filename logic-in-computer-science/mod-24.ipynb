          "python",
          "class DescriptionLogicKB:\n    \"\"\"A simplified ALC description logic knowledge base\"\"\"\n\n    def __init__(self):\n        self.concepts = {}      # concept_name -> set of individuals\n        self.roles = {}         # role_name -> set of (ind1, ind2) pairs\n        self.subsumptions = []  # (sub_concept, super_concept)\n\n    def add_individual(self, individual, concept):\n        if concept not in self.concepts:\n            self.concepts[concept] = set()\n        self.concepts[concept].add(individual)\n\n    def add_role(self, subject, role, obj):\n        if role not in self.roles:\n            self.roles[role] = set()\n        self.roles[role].add((subject, obj))\n\n    def add_subsumption(self, sub, super_concept):\n        \"\"\"sub is a sub-concept of super\"\"\"\n        self.subsumptions.append((sub, super_concept))\n\n    def classify(self, individual):\n        \"\"\"Determine all concepts an individual belongs to\"\"\"\n        result = set()\n        for concept, members in self.concepts.items():\n            if individual in members:\n                result.add(concept)\n        # Apply subsumption hierarchy\n        changed = True\n        while changed:\n            changed = False\n            for sub, sup in self.subsumptions:\n                if sub in result and sup not in result:\n                    result.add(sup)\n                    changed = True\n        return result\n\n    def query_role(self, role, subject=None, obj=None):\n        \"\"\"Query role relationships\"\"\"\n        results = []\n        for s, o in self.roles.get(role, set()):\n            if (subject is None or s == subject) and (obj is None or o == obj):\n                results.append((s, o))\n        return results\n\n# University ontology\nonto = DescriptionLogicKB()\n\n# Concept hierarchy\nonto.add_subsumption(\"Professor\", \"Faculty\")\nonto.add_subsumption(\"Lecturer\", \"Faculty\")\nonto.add_subsumption(\"Faculty\", \"Person\")\nonto.add_subsumption(\"Student\", \"Person\")\nonto.add_subsumption(\"GradStudent\", \"Student\")\n\n# Individuals\nonto.add_individual(\"alice\", \"Professor\")\nonto.add_individual(\"bob\", \"GradStudent\")\nonto.add_individual(\"carol\", \"Lecturer\")\n\n# Roles\nonto.add_role(\"alice\", \"teaches\", \"cs101\")\nonto.add_role(\"alice\", \"advises\", \"bob\")\nonto.add_role(\"bob\", \"enrolledIn\", \"cs101\")\n\nprint(\"Ontology classification:\")\nprint(f\"  Alice is a: {onto.classify('alice')}\")\nprint(f\"  Bob is a: {onto.classify('bob')}\")\nprint(f\"  Who teaches cs101: {onto.query_role('teaches', obj='cs101')}\")"
        ]
