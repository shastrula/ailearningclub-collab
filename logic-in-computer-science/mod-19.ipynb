          "python",
          "e ::= x           (variable)\n    | \\x. e       (abstraction / function definition)\n    | e1 e2       (application / function call)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from dataclasses import dataclass\nfrom typing import Union, Set\n\n# Lambda calculus terms\n@dataclass\nclass LVar:\n    name: str\n\n@dataclass\nclass LAbs:\n    param: str\n    body: 'LTerm'\n\n@dataclass\nclass LApp:\n    func: 'LTerm'\n    arg: 'LTerm'\n\nLTerm = Union[LVar, LAbs, LApp]\n\ndef free_vars(term: LTerm) -> Set[str]:\n    \"\"\"Compute free variables of a term\"\"\"\n    if isinstance(term, LVar):\n        return {term.name}\n    elif isinstance(term, LAbs):\n        return free_vars(term.body) - {term.param}\n    elif isinstance(term, LApp):\n        return free_vars(term.func) | free_vars(term.arg)\n\ndef substitute(term: LTerm, var: str, replacement: LTerm) -> LTerm:\n    \"\"\"Substitute replacement for var in term (capture-avoiding)\"\"\"\n    if isinstance(term, LVar):\n        return replacement if term.name == var else term\n    elif isinstance(term, LAbs):\n        if term.param == var:\n            return term  # Variable is shadowed\n        if term.param in free_vars(replacement):\n            # Alpha-rename to avoid capture\n            fresh = term.param + \"'\"\n            new_body = substitute(term.body, term.param, LVar(fresh))\n            return LAbs(fresh, substitute(new_body, var, replacement))\n        return LAbs(term.param, substitute(term.body, var, replacement))\n    elif isinstance(term, LApp):\n        return LApp(substitute(term.func, var, replacement),\n                    substitute(term.arg, var, replacement))\n\ndef beta_reduce(term: LTerm) -> LTerm:\n    \"\"\"Perform one step of beta reduction (leftmost-outermost)\"\"\"\n    if isinstance(term, LApp) and isinstance(term.func, LAbs):\n        # Beta redex found: (\\x. body) arg --> body[x := arg]\n        return substitute(term.func.body, term.func.param, term.arg)\n    elif isinstance(term, LApp):\n        reduced_func = beta_reduce(term.func)\n        if reduced_func is not term.func:\n            return LApp(reduced_func, term.arg)\n        return LApp(term.func, beta_reduce(term.arg))\n    elif isinstance(term, LAbs):\n        return LAbs(term.param, beta_reduce(term.body))\n    return term\n\ndef to_string(term: LTerm) -> str:\n    \"\"\"Pretty-print a lambda term\"\"\"\n    if isinstance(term, LVar):\n        return term.name\n    elif isinstance(term, LAbs):\n        return f\"(\\\\{term.param}. {to_string(term.body)})\"\n    elif isinstance(term, LApp):\n        return f\"({to_string(term.func)} {to_string(term.arg)})\"\n\n# Example: (\\x. x) y --> y\nidentity_app = LApp(LAbs(\"x\", LVar(\"x\")), LVar(\"y\"))\nresult = beta_reduce(identity_app)\nprint(f\"{to_string(identity_app)} --> {to_string(result)}\")\n\n# Church numerals\nzero = LAbs(\"f\", LAbs(\"x\", LVar(\"x\")))\none = LAbs(\"f\", LAbs(\"x\", LApp(LVar(\"f\"), LVar(\"x\"))))\ntwo = LAbs(\"f\", LAbs(\"x\", LApp(LVar(\"f\"), LApp(LVar(\"f\"), LVar(\"x\")))))\nsucc = LAbs(\"n\", LAbs(\"f\", LAbs(\"x\",\n    LApp(LVar(\"f\"), LApp(LApp(LVar(\"n\"), LVar(\"f\")), LVar(\"x\"))))))\n\nprint(f\"0 = {to_string(zero)}\")\nprint(f\"1 = {to_string(one)}\")\nprint(f\"succ = {to_string(succ)}\")"
        ]
      ]
    },
