          "python",
          "class TypeInference:\n    \"\"\"Hindley-Milner type inference\"\"\"\n\n    def __init__(self):\n        self.counter = 0\n        self.constraints = []\n\n    def fresh_var(self):\n        self.counter += 1\n        return BaseType(f\"t{self.counter}\")\n\n    def infer(self, term, env):\n        \"\"\"Generate constraints and return the type\"\"\"\n        if isinstance(term, TVar):\n            if term.name in env:\n                return env[term.name]\n            raise TypeError(f\"Unbound: {term.name}\")\n\n        elif isinstance(term, TAbs):\n            param_type = term.param_type if term.param_type else self.fresh_var()\n            new_env = {**env, term.param: param_type}\n            body_type = self.infer(term.body, new_env)\n            return ArrowType(param_type, body_type)\n\n        elif isinstance(term, TApp):\n            func_type = self.infer(term.func, env)\n            arg_type = self.infer(term.arg, env)\n            result_type = self.fresh_var()\n            self.constraints.append((func_type, ArrowType(arg_type, result_type)))\n            return result_type\n\n    def solve_constraints(self):\n        \"\"\"Solve type constraints by unification\"\"\"\n        subst = {}\n        for (t1, t2) in self.constraints:\n            subst = self.unify(\n                self.apply_subst(t1, subst),\n                self.apply_subst(t2, subst),\n                subst\n            )\n            if subst is None:\n                raise TypeError(\"Type inference failed: constraints unsolvable\")\n        return subst\n\n    def unify(self, t1, t2, subst):\n        if t1 == t2:\n            return subst\n        if isinstance(t1, BaseType) and t1.name.startswith(\"t\"):\n            subst[t1.name] = t2\n            return subst\n        if isinstance(t2, BaseType) and t2.name.startswith(\"t\"):\n            subst[t2.name] = t1\n            return subst\n        if isinstance(t1, ArrowType) and isinstance(t2, ArrowType):\n            subst = self.unify(t1.param, t2.param, subst)\n            if subst is None:\n                return None\n            return self.unify(\n                self.apply_subst(t1.result, subst),\n                self.apply_subst(t2.result, subst),\n                subst\n            )\n        return None\n\n    def apply_subst(self, t, subst):\n        if isinstance(t, BaseType) and t.name in subst:\n            return self.apply_subst(subst[t.name], subst)\n        if isinstance(t, ArrowType):\n            return ArrowType(\n                self.apply_subst(t.param, subst),\n                self.apply_subst(t.result, subst)\n            )\n        return t\n\n# Infer type of: \\x. \\y. x\nti = TypeInference()\nterm = TAbs(\"x\", None, TAbs(\"y\", None, TVar(\"x\")))\ninferred = ti.infer(term, {})\nsubst = ti.solve_constraints()\nfinal_type = ti.apply_subst(inferred, subst)\nprint(f\"\\\\x. \\\\y. x : {type_to_string(final_type)}\")"
        ]
      ]
