          "python",
          "T ::= Base         (base types: Int, Bool, etc.)\n    | T1 -> T2     (function types)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "x : T in Gamma\n  ---------------  (Var)\n  Gamma |- x : T\n\n  Gamma, x : T1 |- e : T2\n  -------------------------  (Abs)\n  Gamma |- \\x:T1. e : T1 -> T2\n\n  Gamma |- e1 : T1 -> T2    Gamma |- e2 : T1\n  -------------------------------------------  (App)\n  Gamma |- e1 e2 : T2"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "@dataclass(frozen=True)\nclass BaseType:\n    name: str\n\n@dataclass(frozen=True)\nclass ArrowType:\n    param: 'Type'\n    result: 'Type'\n\nType = Union[BaseType, ArrowType]\n\n# Typed lambda terms\n@dataclass\nclass TVar:\n    name: str\n\n@dataclass\nclass TAbs:\n    param: str\n    param_type: Type\n    body: 'TypedTerm'\n\n@dataclass\nclass TApp:\n    func: 'TypedTerm'\n    arg: 'TypedTerm'\n\nTypedTerm = Union[TVar, TAbs, TApp]\n\n# Type environment\nTypeEnv = dict  # name -> Type\n\ndef type_check(term: TypedTerm, env: TypeEnv) -> Type:\n    \"\"\"Type check a simply-typed lambda term\"\"\"\n    if isinstance(term, TVar):\n        if term.name not in env:\n            raise TypeError(f\"Unbound variable: {term.name}\")\n        return env[term.name]\n\n    elif isinstance(term, TAbs):\n        # Extend environment with parameter type\n        new_env = {**env, term.param: term.param_type}\n        body_type = type_check(term.body, new_env)\n        return ArrowType(term.param_type, body_type)\n\n    elif isinstance(term, TApp):\n        func_type = type_check(term.func, env)\n        arg_type = type_check(term.arg, env)\n\n        if not isinstance(func_type, ArrowType):\n            raise TypeError(f\"Expected function type, got {func_type}\")\n        if func_type.param != arg_type:\n            raise TypeError(\n                f\"Type mismatch: expected {func_type.param}, got {arg_type}\")\n\n        return func_type.result\n\ndef type_to_string(t: Type) -> str:\n    if isinstance(t, BaseType):\n        return t.name\n    elif isinstance(t, ArrowType):\n        param_str = type_to_string(t.param)\n        if isinstance(t.param, ArrowType):\n            param_str = f\"({param_str})\"\n        return f\"{param_str} -> {type_to_string(t.result)}\"\n\n# Examples\nInt = BaseType(\"Int\")\nBool = BaseType(\"Bool\")\n\n# Identity function: \\x:Int. x  has type Int -> Int\nidentity = TAbs(\"x\", Int, TVar(\"x\"))\nt = type_check(identity, {})\nprint(f\"\\\\x:Int. x : {type_to_string(t)}\")\n\n# Composition: \\f:Int->Bool. \\g:Int->Int. \\x:Int. f (g x)\ncomposition = TAbs(\"f\", ArrowType(Int, Bool),\n    TAbs(\"g\", ArrowType(Int, Int),\n        TAbs(\"x\", Int,\n            TApp(TVar(\"f\"), TApp(TVar(\"g\"), TVar(\"x\"))))))\nt = type_check(composition, {})\nprint(f\"compose : {type_to_string(t)}\")\n\n# Type error: applying Int to Int\ntry:\n    bad_term = TApp(TVar(\"x\"), TVar(\"y\"))\n    type_check(bad_term, {\"x\": Int, \"y\": Int})\nexcept TypeError as e:\n    print(f\"Type error (expected): {e}\")"
        ]
      ]
