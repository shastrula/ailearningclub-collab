          "python",
          "def wp_examples():\n    \"\"\"Demonstrate weakest preconditions\"\"\"\n    examples = [\n        (\"x := x + 1\", \"x > 0\", \"x + 1 > 0, i.e., x > -1\"),\n        (\"x := y + z\", \"x == 10\", \"y + z == 10\"),\n        (\"if x > 0 then y:=x else y:=-x\", \"y >= 0\",\n         \"(x>0 -> x>=0) and (x<=0 -> -x>=0), i.e., True\"),\n    ]\n\n    print(\"Weakest Precondition Examples:\")\n    print(\"-\" * 50)\n    for stmt, post, wp_result in examples:\n        print(f\"  wp({stmt}, {post})\")\n        print(f\"  = {wp_result}\")\n        print()\n\nwp_examples()"
        ]
      ]
    },
    {
