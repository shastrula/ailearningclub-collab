          "python",
          "from dataclasses import dataclass\nfrom typing import Dict, Callable, Optional\n\n# Simple imperative language AST\n@dataclass\nclass Assign:\n    var: str\n    expr: str  # Expression as string for simplicity\n\n@dataclass\nclass Seq:\n    first: 'Stmt'\n    second: 'Stmt'\n\n@dataclass\nclass If:\n    condition: str\n    then_branch: 'Stmt'\n    else_branch: 'Stmt'\n\n@dataclass\nclass While:\n    condition: str\n    invariant: str  # Loop invariant annotation\n    body: 'Stmt'\n\n@dataclass\nclass Skip:\n    pass\n\nStmt = object  # Union of above\n\n@dataclass\nclass HoareTriple:\n    precondition: str\n    statement: Stmt\n    postcondition: str\n\n    def __repr__(self):\n        return f\"{{{self.precondition}}} S {{{self.postcondition}}}\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def assignment_axiom(var: str, expr: str, postcondition: str) -> str:\n    \"\"\"Compute the weakest precondition for an assignment\"\"\"\n    # Replace all occurrences of var in postcondition with expr\n    precondition = postcondition.replace(var, f\"({expr})\")\n    return precondition\n\n# Example: {?} x := x + 1 {x == 6}\npre = assignment_axiom(\"x\", \"x + 1\", \"x == 6\")\nprint(f\"Assignment: {{{pre}}} x := x + 1 {{x == 6}}\")\n# Output: {(x + 1) == 6} which simplifies to {x == 5}\n\n# Example: {?} y := x * x {y >= 0}\npre = assignment_axiom(\"y\", \"x * x\", \"y >= 0\")\nprint(f\"Assignment: {{{pre}}} y := x * x {{y >= 0}}\")\n# Output: {(x * x) >= 0} which is always true!"
        ]
      ]
    },
    {
