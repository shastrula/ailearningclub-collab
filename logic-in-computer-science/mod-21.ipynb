          "python",
          "def verify_loop_invariant_example():\n    \"\"\"\n    Program: Compute sum of 1..n\n    i := 0; s := 0;\n    while i < n do (i := i + 1; s := s + i)\n\n    Invariant: s == i*(i+1)/2 and 0 <= i <= n\n    \"\"\"\n    print(\"Program: sum of 1 to n\")\n    print(\"Invariant: s == i*(i+1)/2 and 0 <= i <= n\")\n    print()\n    print(\"Verification:\")\n    print(\"  1. ESTABLISHMENT: Initially i=0, s=0\")\n    print(\"     s == 0*(0+1)/2 = 0? YES\")\n    print(\"     0 <= 0 <= n? YES (given n >= 0)\")\n    print()\n    print(\"  2. MAINTENANCE: Assume I and i < n\")\n    print(\"     After i := i+1; s := s+i:\")\n    print(\"     s_new = s + i_new = i*(i+1)/2 + (i+1)\")\n    print(\"          = (i+1)*(i+2)/2 = i_new*(i_new+1)/2? YES\")\n    print(\"     0 <= i_new <= n? YES (since i < n, i+1 <= n)\")\n    print()\n    print(\"  3. POSTCONDITION: When i >= n (loop exits)\")\n    print(\"     From invariant: i <= n, and loop condition: i >= n\")\n    print(\"     Therefore i == n, so s == n*(n+1)/2\")\n    print()\n    print(\"  All VCs verified! Program is correct.\")\n\nverify_loop_invariant_example()"
        ]
      ]
    },
    {
