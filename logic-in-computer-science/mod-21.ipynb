          "python",
          "class HoareVerifier:\n    \"\"\"Weakest precondition calculus for Hoare logic verification\"\"\"\n\n    def wp(self, stmt, postcondition: str) -> str:\n        \"\"\"Compute weakest precondition\"\"\"\n        if isinstance(stmt, Skip):\n            return postcondition\n\n        elif isinstance(stmt, Assign):\n            return self.substitute(postcondition, stmt.var, stmt.expr)\n\n        elif isinstance(stmt, Seq):\n            # wp(S1; S2, Q) = wp(S1, wp(S2, Q))\n            mid = self.wp(stmt.second, postcondition)\n            return self.wp(stmt.first, mid)\n\n        elif isinstance(stmt, If):\n            # wp(if B then S1 else S2, Q) =\n            #   (B -> wp(S1, Q)) ^ (~B -> wp(S2, Q))\n            wp_then = self.wp(stmt.then_branch, postcondition)\n            wp_else = self.wp(stmt.else_branch, postcondition)\n            return (f\"(({stmt.condition}) -> ({wp_then})) and \"\n                    f\"(not ({stmt.condition}) -> ({wp_else}))\")\n\n        elif isinstance(stmt, While):\n            # For while loops, we need the invariant\n            # Verification conditions:\n            # 1. Precondition implies invariant (I)\n            # 2. {I ^ B} body {I}\n            # 3. I ^ ~B implies postcondition\n            return stmt.invariant  # WP is the invariant itself\n\n        return postcondition\n\n    def substitute(self, formula: str, var: str, expr: str) -> str:\n        \"\"\"Substitute expr for var in formula\"\"\"\n        return formula.replace(var, f\"({expr})\")\n\n    def generate_vcs(self, triple: HoareTriple) -> list:\n        \"\"\"Generate verification conditions for a Hoare triple\"\"\"\n        vcs = []\n\n        if isinstance(triple.statement, While):\n            loop = triple.statement\n            inv = loop.invariant\n\n            # VC1: Precondition implies invariant\n            vcs.append(f\"VC1: {triple.precondition} -> {inv}\")\n\n            # VC2: Invariant is preserved by loop body\n            body_wp = self.wp(loop.body, inv)\n            vcs.append(f\"VC2: ({inv} and {loop.condition}) -> {body_wp}\")\n\n            # VC3: Invariant and loop exit implies postcondition\n            vcs.append(f\"VC3: ({inv} and not ({loop.condition})) -> {triple.postcondition}\")\n\n        else:\n            # For non-loop statements: P -> wp(S, Q)\n            wp = self.wp(triple.statement, triple.postcondition)\n            vcs.append(f\"VC: {triple.precondition} -> {wp}\")\n\n        return vcs\n\n# Example 1: Swap using temp variable\n# {x == a and y == b} temp := x; x := y; y := temp {x == b and y == a}\nswap = Seq(\n    Assign(\"temp\", \"x\"),\n    Seq(Assign(\"x\", \"y\"), Assign(\"y\", \"temp\"))\n)\n\nverifier = HoareVerifier()\nwp = verifier.wp(swap, \"x == b and y == a\")\nprint(f\"Swap WP: {wp}\")\n# Should simplify to: y == b and x == a (which matches precondition)\n\n# Example 2: Factorial with loop invariant\n# {n >= 0}\n# i := 1; f := 1;\n# while i <= n do (f := f * i; i := i + 1)\n# {f == n!}\nprint(\"\\nFactorial verification conditions:\")\nfactorial_loop = While(\n    condition=\"i <= n\",\n    invariant=\"f == factorial(i-1) and i >= 1 and i <= n+1\",\n    body=Seq(Assign(\"f\", \"f * i\"), Assign(\"i\", \"i + 1\"))\n)\n\ntriple = HoareTriple(\n    precondition=\"n >= 0 and i == 1 and f == 1\",\n    statement=factorial_loop,\n    postcondition=\"f == factorial(n)\"\n)\n\nvcs = verifier.generate_vcs(triple)\nfor vc in vcs:\n    print(f\"  {vc}\")"
        ]
      ]
