          "python",
          "def total_correctness_example():\n    \"\"\"\n    Prove total correctness of Euclidean GCD:\n    [a > 0 and b > 0]\n    while b != 0 do (temp := b; b := a mod b; a := temp)\n    [a == gcd(a_0, b_0)]\n\n    Variant: b (decreases each iteration because a mod b < b)\n    \"\"\"\n    print(\"Total Correctness: Euclidean GCD\")\n    print()\n    print(\"Invariant: gcd(a, b) == gcd(a_0, b_0) and a >= 0 and b >= 0\")\n    print(\"Variant: b\")\n    print()\n    print(\"Termination proof:\")\n    print(\"  1. Variant is non-negative: b >= 0 (from invariant)\")\n    print(\"  2. Variant decreases: b_new = a mod b < b (property of mod)\")\n    print(\"  3. Therefore loop terminates in at most b_0 iterations\")\n    print()\n    print(\"Partial correctness:\")\n    print(\"  When b == 0: gcd(a, 0) == a == gcd(a_0, b_0)\")\n\ntotal_correctness_example()\n\ndef simulate_gcd(a, b):\n    \"\"\"Simulate GCD with variant tracking\"\"\"\n    print(f\"GCD({a}, {b}):\")\n    step = 0\n    while b != 0:\n        print(f\"  Step {step}: a={a}, b={b}, variant={b}\")\n        a, b = b, a % b\n        step += 1\n    print(f\"  Result: {a} (terminated in {step} steps)\")\n    return a\n\nsimulate_gcd(48, 18)"
        ]
      ]
