      "source": [
        [
          "python",
          "def eliminate_implications(formula):\n    \"\"\"Step 1-2: Remove -> and <-> connectives\"\"\"\n    if isinstance(formula, Atom):\n        return formula\n    elif isinstance(formula, Not):\n        return Not(eliminate_implications(formula.operand))\n    elif isinstance(formula, And):\n        return And(eliminate_implications(formula.left),\n                   eliminate_implications(formula.right))\n    elif isinstance(formula, Or):\n        return Or(eliminate_implications(formula.left),\n                  eliminate_implications(formula.right))\n    elif isinstance(formula, Implies):\n        # p -> q becomes ~p v q\n        return Or(Not(eliminate_implications(formula.left)),\n                  eliminate_implications(formula.right))\n    elif isinstance(formula, Iff):\n        # p <-> q becomes (p -> q) ^ (q -> p)\n        left = eliminate_implications(formula.left)\n        right = eliminate_implications(formula.right)\n        return And(Or(Not(left), right), Or(Not(right), left))\n\ndef push_negation(formula):\n    \"\"\"Step 3-4: Push negations to atoms using De Morgan's\"\"\"\n    if isinstance(formula, Atom):\n        return formula\n    elif isinstance(formula, Not):\n        inner = formula.operand\n        if isinstance(inner, Atom):\n            return formula  # ~p is already a literal\n        elif isinstance(inner, Not):\n            return push_negation(inner.operand)  # ~~A -> A\n        elif isinstance(inner, And):\n            # ~(A ^ B) -> ~A v ~B\n            return Or(push_negation(Not(inner.left)),\n                      push_negation(Not(inner.right)))\n        elif isinstance(inner, Or):\n            # ~(A v B) -> ~A ^ ~B\n            return And(push_negation(Not(inner.left)),\n                       push_negation(Not(inner.right)))\n        else:\n            return Not(push_negation(inner))\n    elif isinstance(formula, And):\n        return And(push_negation(formula.left), push_negation(formula.right))\n    elif isinstance(formula, Or):\n        return Or(push_negation(formula.left), push_negation(formula.right))\n    return formula\n\ndef distribute_or(formula):\n    \"\"\"Step 5: Distribute OR over AND to get CNF\"\"\"\n    if isinstance(formula, Atom) or isinstance(formula, Not):\n        return formula\n    elif isinstance(formula, And):\n        return And(distribute_or(formula.left), distribute_or(formula.right))\n    elif isinstance(formula, Or):\n        left = distribute_or(formula.left)\n        right = distribute_or(formula.right)\n        # A v (B ^ C) -> (A v B) ^ (A v C)\n        if isinstance(left, And):\n            return And(distribute_or(Or(left.left, right)),\n                       distribute_or(Or(left.right, right)))\n        elif isinstance(right, And):\n            return And(distribute_or(Or(left, right.left)),\n                       distribute_or(Or(left, right.right)))\n        return Or(left, right)\n    return formula\n\ndef to_cnf(formula):\n    \"\"\"Convert any propositional formula to CNF\"\"\"\n    step1 = eliminate_implications(formula)\n    step2 = push_negation(step1)\n    step3 = distribute_or(step2)\n    return step3\n\n# Example: Convert (p -> q) ^ (q -> r) to CNF\nformula = And(Implies(Atom(\"p\"), Atom(\"q\")), Implies(Atom(\"q\"), Atom(\"r\")))\ncnf = to_cnf(formula)\nprint(f\"CNF result: {cnf}\")\n# Result: (~p v q) ^ (~q v r) - already nice CNF!"
        ]
