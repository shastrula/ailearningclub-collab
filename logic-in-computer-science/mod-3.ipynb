          "python",
          "def formula_to_dimacs(clauses, var_map):\n    \"\"\"Convert CNF clauses to DIMACS format for SAT solvers\"\"\"\n    lines = []\n    lines.append(f\"p cnf {len(var_map)} {len(clauses)}\")\n    for clause in clauses:\n        literals = []\n        for lit in clause:\n            if lit.startswith(\"~\"):\n                literals.append(f\"-{var_map[lit[1:]]}\")\n            else:\n                literals.append(str(var_map[lit]))\n        lines.append(\" \".join(literals) + \" 0\")\n    return \"\\n\".join(lines)\n\n# Example: (p v q) ^ (~p v r) ^ (~q v ~r)\nvar_map = {\"p\": 1, \"q\": 2, \"r\": 3}\nclauses = [[\"p\", \"q\"], [\"~p\", \"r\"], [\"~q\", \"~r\"]]\nprint(formula_to_dimacs(clauses, var_map))"
        ]
