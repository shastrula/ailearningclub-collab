          "python",
          "def to_dnf_from_truth_table(variables, expression):\n    \"\"\"Generate DNF directly from truth table (sum of minterms)\"\"\"\n    n = len(variables)\n    minterms = []\n\n    for values in itertools.product([False, True], repeat=n):\n        assignment = dict(zip(variables, values))\n        if expression(assignment):\n            # Build minterm for this row\n            term = []\n            for var, val in zip(variables, values):\n                if val:\n                    term.append(var)\n                else:\n                    term.append(f\"~{var}\")\n            minterms.append(\" ^ \".join(term))\n\n    if not minterms:\n        return \"F (contradiction)\"\n    return \" v \".join(f\"({m})\" for m in minterms)\n\n# Example: XOR (p exclusive-or q)\nxor_dnf = to_dnf_from_truth_table(\n    [\"p\", \"q\"],\n    lambda a: a[\"p\"] != a[\"q\"]\n)\nprint(f\"XOR in DNF: {xor_dnf}\")\n# Output: (~p ^ q) v (p ^ ~q)"
        ]
