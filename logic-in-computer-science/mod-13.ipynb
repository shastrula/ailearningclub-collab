        [
          "python",
          "def find_counterexample(model, start, bad_states):\n    \"\"\"BFS to find shortest path from start to a bad state\"\"\"\n    visited = {start}\n    queue = deque([(start, [start])])\n\n    while queue:\n        state, path = queue.popleft()\n        if state in bad_states:\n            return path  # Counterexample found!\n\n        for succ in model.transitions.get(state, set()):\n            if succ not in visited:\n                visited.add(succ)\n                queue.append((succ, path + [succ]))\n\n    return None  # No counterexample - property holds\n\n# Find path to error in microwave model\ncex = find_counterexample(\n    type('M', (), {'transitions': transitions})(),\n    \"start\",\n    {\"error\"}\n)\nprint(f\"Counterexample to AG(~error): {' -> '.join(cex)}\")"
        ]
      ]
