      "source": [
        [
          "python",
          "from typing import Dict, Set, List, Tuple, Optional\nfrom collections import deque\n\nclass ModelChecker:\n    \"\"\"CTL Model Checker using state labeling\"\"\"\n\n    def __init__(self, states, transitions, labels):\n        self.states = states              # Set of state names\n        self.transitions = transitions    # Dict: state -> set of successors\n        self.labels = labels              # Dict: state -> set of atomic props\n\n    def check(self, formula, initial_states=None) -> Tuple[bool, Set[str]]:\n        \"\"\"Check if formula holds at initial states. Returns (result, sat_set)\"\"\"\n        sat = self.compute_sat(formula)\n        if initial_states:\n            holds = initial_states.issubset(sat)\n            return holds, sat\n        return True, sat\n\n    def compute_sat(self, formula) -> Set[str]:\n        \"\"\"Compute the set of states satisfying a formula\"\"\"\n        if isinstance(formula, str):\n            # Atomic proposition\n            return {s for s in self.states if formula in self.labels.get(s, set())}\n\n        op = formula[0]\n\n        if op == \"true\":\n            return set(self.states)\n        elif op == \"false\":\n            return set()\n        elif op == \"not\":\n            return self.states - self.compute_sat(formula[1])\n        elif op == \"and\":\n            return self.compute_sat(formula[1]) & self.compute_sat(formula[2])\n        elif op == \"or\":\n            return self.compute_sat(formula[1]) | self.compute_sat(formula[2])\n        elif op == \"EX\":\n            return self.sat_EX(formula[1])\n        elif op == \"AX\":\n            return self.sat_AX(formula[1])\n        elif op == \"EF\":\n            return self.sat_EF(formula[1])\n        elif op == \"AF\":\n            return self.sat_AF(formula[1])\n        elif op == \"EG\":\n            return self.sat_EG(formula[1])\n        elif op == \"AG\":\n            return self.sat_AG(formula[1])\n        elif op == \"EU\":\n            return self.sat_EU(formula[1], formula[2])\n        elif op == \"AU\":\n            return self.sat_AU(formula[1], formula[2])\n\n        return set()\n\n    def sat_EX(self, phi) -> Set[str]:\n        \"\"\"States with some successor satisfying phi\"\"\"\n        sat_phi = self.compute_sat(phi)\n        return {s for s in self.states\n                if any(t in sat_phi for t in self.transitions.get(s, set()))}\n\n    def sat_AX(self, phi) -> Set[str]:\n        \"\"\"States where all successors satisfy phi\"\"\"\n        sat_phi = self.compute_sat(phi)\n        return {s for s in self.states\n                if self.transitions.get(s, set())\n                and all(t in sat_phi for t in self.transitions.get(s, set()))}\n\n    def sat_EF(self, phi) -> Set[str]:\n        \"\"\"Backward reachability from phi states\"\"\"\n        result = self.compute_sat(phi)\n        queue = deque(result)\n        while queue:\n            s = queue.popleft()\n            for pred in self.predecessors(s):\n                if pred not in result:\n                    result.add(pred)\n                    queue.append(pred)\n        return result\n\n    def sat_AF(self, phi) -> Set[str]:\n        \"\"\"All paths eventually reach phi - backward computation\"\"\"\n        sat_phi = self.compute_sat(phi)\n        result = set(sat_phi)\n        # Count successors not yet in result\n        count = {s: len(self.transitions.get(s, set()) - result)\n                 for s in self.states}\n\n        queue = deque(result)\n        while queue:\n            s = queue.popleft()\n            for pred in self.predecessors(s):\n                if pred not in result:\n                    count[pred] -= 1\n                    if count[pred] == 0:\n                        result.add(pred)\n                        queue.append(pred)\n        return result\n\n    def sat_EG(self, phi) -> Set[str]:\n        \"\"\"Greatest fixpoint: phi ^ EX(EG phi)\"\"\"\n        result = self.compute_sat(phi)\n        changed = True\n        while changed:\n            changed = False\n            for s in list(result):\n                if not any(t in result for t in self.transitions.get(s, set())):\n                    result.discard(s)\n                    changed = True\n        return result\n\n    def sat_AG(self, phi) -> Set[str]:\n        \"\"\"AG phi = ~EF(~phi)\"\"\"\n        not_phi = self.states - self.compute_sat(phi)\n        ef_not_phi = set(not_phi)\n        queue = deque(not_phi)\n        while queue:\n            s = queue.popleft()\n            for pred in self.predecessors(s):\n                if pred not in ef_not_phi:\n                    ef_not_phi.add(pred)\n                    queue.append(pred)\n        return self.states - ef_not_phi\n\n    def sat_EU(self, phi, psi) -> Set[str]:\n        \"\"\"E[phi U psi]: backward from psi through phi states\"\"\"\n        sat_phi = self.compute_sat(phi)\n        sat_psi = self.compute_sat(psi)\n        result = set(sat_psi)\n        queue = deque(result)\n        while queue:\n            s = queue.popleft()\n            for pred in self.predecessors(s):\n                if pred not in result and pred in sat_phi:\n                    result.add(pred)\n                    queue.append(pred)\n        return result\n\n    def sat_AU(self, phi, psi) -> Set[str]:\n        \"\"\"A[phi U psi]: all paths through phi reach psi\"\"\"\n        sat_phi = self.compute_sat(phi)\n        sat_psi = self.compute_sat(psi)\n        result = set(sat_psi)\n        count = {}\n        for s in self.states:\n            count[s] = len(self.transitions.get(s, set()) - result)\n\n        queue = deque(result)\n        while queue:\n            s = queue.popleft()\n            for pred in self.predecessors(s):\n                if pred not in result and pred in sat_phi:\n                    count[pred] -= 1\n                    if count[pred] == 0:\n                        result.add(pred)\n                        queue.append(pred)\n        return result\n\n    def predecessors(self, state: str) -> Set[str]:\n        return {s for s in self.states if state in self.transitions.get(s, set())}\n\n# Example: Microwave oven model\nstates = {\"start\", \"cooking\", \"done\", \"error\"}\ntransitions = {\n    \"start\": {\"cooking\", \"error\"},\n    \"cooking\": {\"cooking\", \"done\", \"error\"},\n    \"done\": {\"start\"},\n    \"error\": {\"start\"},\n}\nlabels = {\n    \"start\": {\"idle\", \"safe\"},\n    \"cooking\": {\"heating\", \"safe\"},\n    \"done\": {\"finished\", \"safe\"},\n    \"error\": {\"alarm\"},\n}\n\nmc = ModelChecker(states, transitions, labels)\n\n# Check: AG safe (always safe) - should be False (error is not safe)\nholds, sat = mc.check((\"AG\", \"safe\"), {\"start\"})\nprint(f\"AG safe: {holds}, satisfying states: {sat}\")\n\n# Check: AF safe (eventually safe on all paths)\nholds, sat = mc.check((\"AF\", \"safe\"), {\"start\"})\nprint(f\"AF safe: {holds}\")\n\n# Check: AG(alarm -> EF idle) (can always recover from error)\nformula = (\"AG\", (\"or\", (\"not\", \"alarm\"), (\"EF\", \"idle\")))\nholds, sat = mc.check(formula, {\"start\"})\nprint(f\"AG(alarm -> EF idle): {holds}\")"
        ]
