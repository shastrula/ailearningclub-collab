      "source": [
        [
          "python",
          "# Logic is everywhere in programming - even simple conditionals are logical expressions\ndef is_eligible(age, has_id, is_member):\n    \"\"\"Eligibility check using logical operators\"\"\"\n    # This is propositional logic: (age >= 18) AND (has_id OR is_member)\n    return age >= 18 and (has_id or is_member)\n\n# Truth table generation for a simple proposition\ndef truth_table(variables, expression):\n    \"\"\"Generate a truth table for a logical expression\"\"\"\n    import itertools\n    n = len(variables)\n    print(\" | \".join(variables) + \" | Result\")\n    print(\"-\" * (6 * n + 10))\n    for values in itertools.product([False, True], repeat=n):\n        env = dict(zip(variables, values))\n        result = expression(env)\n        row = \" | \".join([\"T\" if v else \"F\" for v in values])\n        row += f\" | {'T' if result else 'F'}\"\n        print(row)\n\n# Example: p AND (q OR r)\ntruth_table(\n    [\"p\", \"q\", \"r\"],\n    lambda e: e[\"p\"] and (e[\"q\"] or e[\"r\"])\n)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Formal reasoning makes assumptions explicit\nclass LogicalArgument:\n    def __init__(self):\n        self.premises = []\n        self.conclusion = None\n\n    def add_premise(self, premise):\n        self.premises.append(premise)\n\n    def set_conclusion(self, conclusion):\n        self.conclusion = conclusion\n\n    def is_valid(self, interpretation):\n        \"\"\"An argument is valid if: whenever all premises are true,\n        the conclusion must also be true\"\"\"\n        all_premises_true = all(p(interpretation) for p in self.premises)\n        if all_premises_true:\n            return self.conclusion(interpretation)\n        return True  # Vacuously true if premises are false\n\n# Example: Modus Ponens\n# Premise 1: If it rains, the ground is wet (p -> q)\n# Premise 2: It rains (p)\n# Conclusion: The ground is wet (q)\narg = LogicalArgument()\narg.add_premise(lambda i: not i[\"rains\"] or i[\"wet\"])  # p -> q\narg.add_premise(lambda i: i[\"rains\"])                    # p\narg.set_conclusion(lambda i: i[\"wet\"])                   # q\n\n# Verify with all interpretations\ntest_cases = [\n    {\"rains\": True, \"wet\": True},\n    {\"rains\": True, \"wet\": False},\n    {\"rains\": False, \"wet\": True},\n    {\"rains\": False, \"wet\": False},\n]\n\nfor case in test_cases:\n    print(f\"{case} -> Valid: {arg.is_valid(case)}\")"
        ]
      ]
    }
