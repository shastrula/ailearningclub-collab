          "python",
          "from dataclasses import dataclass, field\nfrom typing import List, Set, Optional, Tuple\n\n@dataclass\nclass Sequent:\n    \"\"\"A sequent: left |- right\"\"\"\n    left: List[str]   # Antecedents (assumptions)\n    right: List[str]  # Succedents (conclusions)\n\n    def __str__(self):\n        l = \", \".join(self.left) if self.left else \"\"\n        r = \", \".join(self.right) if self.right else \"\"\n        return f\"{l} |- {r}\"\n\nclass SequentProver:\n    \"\"\"Automated proof search in propositional sequent calculus\"\"\"\n\n    def __init__(self):\n        self.proof_tree = []\n\n    def prove(self, sequent: Sequent, depth=0) -> bool:\n        \"\"\"Try to prove a sequent using backward proof search\"\"\"\n        indent = \"  \" * depth\n        self.proof_tree.append(f\"{indent}Goal: {sequent}\")\n\n        # Axiom: A |- A (check if any formula appears on both sides)\n        for formula in sequent.left:\n            if formula in sequent.right:\n                self.proof_tree.append(f\"{indent}  Axiom: {formula} |- {formula}\")\n                return True\n\n        # Try to decompose formulas on the right side\n        for i, formula in enumerate(sequent.right):\n            if \" ^ \" in formula:\n                # ^R: split conjunction into two subgoals\n                parts = self._split_binary(formula, \" ^ \")\n                if parts:\n                    a, b = parts\n                    right_without = sequent.right[:i] + sequent.right[i+1:]\n                    s1 = Sequent(sequent.left[:], right_without + [a])\n                    s2 = Sequent(sequent.left[:], right_without + [b])\n                    self.proof_tree.append(f\"{indent}  ^R on {formula}\")\n                    return self.prove(s1, depth+1) and self.prove(s2, depth+1)\n\n            if \" v \" in formula:\n                # vR: keep both disjuncts on the right\n                parts = self._split_binary(formula, \" v \")\n                if parts:\n                    a, b = parts\n                    right_without = sequent.right[:i] + sequent.right[i+1:]\n                    s = Sequent(sequent.left[:], right_without + [a, b])\n                    self.proof_tree.append(f\"{indent}  vR on {formula}\")\n                    return self.prove(s, depth+1)\n\n            if \" -> \" in formula:\n                # ->R: move antecedent to left\n                parts = self._split_binary(formula, \" -> \")\n                if parts:\n                    a, b = parts\n                    right_without = sequent.right[:i] + sequent.right[i+1:]\n                    s = Sequent(sequent.left[:] + [a], right_without + [b])\n                    self.proof_tree.append(f\"{indent}  ->R on {formula}\")\n                    return self.prove(s, depth+1)\n\n        # Try to decompose formulas on the left side\n        for i, formula in enumerate(sequent.left):\n            if \" ^ \" in formula:\n                # ^L: add both conjuncts to left\n                parts = self._split_binary(formula, \" ^ \")\n                if parts:\n                    a, b = parts\n                    left_without = sequent.left[:i] + sequent.left[i+1:]\n                    s = Sequent(left_without + [a, b], sequent.right[:])\n                    self.proof_tree.append(f\"{indent}  ^L on {formula}\")\n                    return self.prove(s, depth+1)\n\n            if \" v \" in formula:\n                # vL: case split\n                parts = self._split_binary(formula, \" v \")\n                if parts:\n                    a, b = parts\n                    left_without = sequent.left[:i] + sequent.left[i+1:]\n                    s1 = Sequent(left_without + [a], sequent.right[:])\n                    s2 = Sequent(left_without + [b], sequent.right[:])\n                    self.proof_tree.append(f\"{indent}  vL on {formula}\")\n                    return self.prove(s1, depth+1) and self.prove(s2, depth+1)\n\n        return False  # Cannot prove\n\n    def _split_binary(self, formula: str, op: str) -> Optional[Tuple[str, str]]:\n        \"\"\"Split a binary formula at the main connective\"\"\"\n        idx = formula.find(op)\n        if idx > 0:\n            return (formula[:idx], formula[idx+len(op):])\n        return None\n\n# Example: Prove |- (A -> B) -> (B -> C) -> (A -> C)\nprover = SequentProver()\nsequent = Sequent([], [\"A -> B -> B -> C -> A -> C\"])\n\n# Simpler example: Prove A ^ B |- B ^ A\nprover2 = SequentProver()\nsequent2 = Sequent([\"A ^ B\"], [\"B ^ A\"])\nresult = prover2.prove(sequent2)\nprint(f\"A ^ B |- B ^ A: {result}\")\nfor line in prover2.proof_tree:\n    print(line)"
        ]
