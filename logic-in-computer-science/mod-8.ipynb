          "python",
          "def demonstrate_cut_elimination():\n    \"\"\"\n    Example of cut elimination:\n\n    With cut (using lemma B):\n    Proof 1: A |- B (derive intermediate lemma)\n    Proof 2: B |- C (use lemma to get conclusion)\n    Cut: A |- C\n\n    Without cut (direct proof):\n    A |- C (prove directly without intermediate B)\n\n    The cut-free proof may be longer but has the subformula property.\n    \"\"\"\n    # Proof with cut\n    print(\"Proof WITH cut:\")\n    print(\"  1. A -> B |- A -> B  (axiom)\")\n    print(\"  2. B -> C |- B -> C  (axiom)\")\n    print(\"  3. A -> B, A |- B    (->L on 1)\")\n    print(\"  4. B -> C, B |- C    (->L on 2)\")\n    print(\"  5. A -> B, B -> C, A |- C  (Cut on B, using 3 and 4)\")\n    print()\n    print(\"Proof WITHOUT cut (cut-free):\")\n    print(\"  1. A -> B, B -> C, A |- A -> B, C  (weaken)\")\n    print(\"  2. A -> B, B -> C, A |- A, C       (identity)\")\n    print(\"  3. A -> B, B -> C, B |- B -> C, C  (weaken)\")\n    print(\"  4. A -> B, B -> C, B |- C          (->L)\")\n    print(\"  5. A -> B, B -> C, A |- C          (->L on A->B)\")\n\ndemonstrate_cut_elimination()"
        ]
