      "source": [
        [
          "python",
          "from dataclasses import dataclass\nfrom typing import Set, Optional\n\n# Proof terms (corresponding to proof trees)\n@dataclass\nclass Assumption:\n    \"\"\"An undischarged assumption\"\"\"\n    label: int\n    formula: str\n\n@dataclass\nclass AndIntro:\n    left_proof: 'Proof'\n    right_proof: 'Proof'\n\n@dataclass\nclass AndElimLeft:\n    proof: 'Proof'\n\n@dataclass\nclass AndElimRight:\n    proof: 'Proof'\n\n@dataclass\nclass ImpliesIntro:\n    assumption_label: int\n    body_proof: 'Proof'\n\n@dataclass\nclass ImpliesElim:\n    impl_proof: 'Proof'\n    arg_proof: 'Proof'\n\nProof = object  # Union of above types\n\nclass ProofChecker:\n    \"\"\"Simple natural deduction proof checker\"\"\"\n\n    def __init__(self):\n        self.assumptions = {}  # label -> formula\n\n    def check(self, proof, goal_formula: str) -> bool:\n        \"\"\"Verify that a proof establishes the goal\"\"\"\n        derived = self.derive(proof)\n        return derived == goal_formula\n\n    def derive(self, proof) -> Optional[str]:\n        \"\"\"Compute what formula a proof establishes\"\"\"\n        if isinstance(proof, Assumption):\n            return proof.formula\n\n        elif isinstance(proof, AndIntro):\n            left = self.derive(proof.left_proof)\n            right = self.derive(proof.right_proof)\n            if left and right:\n                return f\"({left} ^ {right})\"\n            return None\n\n        elif isinstance(proof, AndElimLeft):\n            formula = self.derive(proof.proof)\n            if formula and \" ^ \" in formula:\n                # Extract left conjunct\n                inner = formula[1:-1]  # Remove outer parens\n                parts = inner.split(\" ^ \", 1)\n                return parts[0]\n            return None\n\n        elif isinstance(proof, AndElimRight):\n            formula = self.derive(proof.proof)\n            if formula and \" ^ \" in formula:\n                inner = formula[1:-1]\n                parts = inner.split(\" ^ \", 1)\n                return parts[1]\n            return None\n\n        elif isinstance(proof, ImpliesIntro):\n            # The assumption being discharged\n            assumption_formula = f\"A{proof.assumption_label}\"\n            body = self.derive(proof.body_proof)\n            if body:\n                return f\"({assumption_formula} -> {body})\"\n            return None\n\n        elif isinstance(proof, ImpliesElim):\n            impl = self.derive(proof.impl_proof)\n            arg = self.derive(proof.arg_proof)\n            if impl and \" -> \" in impl:\n                inner = impl[1:-1]\n                parts = inner.split(\" -> \", 1)\n                if parts[0] == arg:\n                    return parts[1]\n            return None\n\n        return None\n\n# Example: Prove A ^ B |- B ^ A\nchecker = ProofChecker()\n\n# Proof: assume A^B, extract B, extract A, combine as B^A\nproof = AndIntro(\n    left_proof=AndElimRight(Assumption(1, \"(A ^ B)\")),\n    right_proof=AndElimLeft(Assumption(1, \"(A ^ B)\"))\n)\nresult = checker.derive(proof)\nprint(f\"Derived: {result}\")  # (B ^ A)"
        ]
      ]
