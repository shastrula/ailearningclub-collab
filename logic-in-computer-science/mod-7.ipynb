          "python",
          "# Intuitionistic vs classical: double negation elimination\n# In intuitionistic logic: ~~A does NOT imply A\n# We CAN prove: A -> ~~A (intuitionistically)\n\ndef double_neg_intro(a_proof):\n    \"\"\"Prove A -> ~~A (valid intuitionistically)\n    Assume A. To prove ~~A, assume ~A and derive contradiction.\n    We have A and ~A, giving False. So ~A -> False, which is ~~A.\"\"\"\n    pass  # This IS provable intuitionistically\n\ndef double_neg_elim(nna_proof):\n    \"\"\"Prove ~~A -> A (ONLY valid classically)\n    Cannot be done constructively - no way to extract A from ~~A\n    without knowing whether A or ~A holds.\"\"\"\n    pass  # Requires classical reasoning"
        ]
      ]
