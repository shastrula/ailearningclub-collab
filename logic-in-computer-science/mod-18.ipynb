          "python",
          "def demonstrate_strategies():\n    \"\"\"Show how strategies reduce the search space\"\"\"\n    print(\"Strategy comparison for proving:\")\n    print(\"  Axioms: A->B, B->C, C->D\")\n    print(\"  Goal: A->D\")\n    print()\n    print(\"Unrestricted resolution:\")\n    print(\"  Generates: ~A v B, ~B v C, ~C v D, A, ~D\")\n    print(\"  Possible derivations: many redundant (e.g., resolve B with itself)\")\n    print(\"  Clauses generated: ~20+\")\n    print()\n    print(\"Set-of-support (only use A or ~D in each resolution):\")\n    print(\"  Step 1: Resolve {A} with {~A v B} -> {B}\")\n    print(\"  Step 2: Resolve {B} with {~B v C} -> {C}\")\n    print(\"  Step 3: Resolve {C} with {~C v D} -> {D}\")\n    print(\"  Step 4: Resolve {D} with {~D} -> {} (empty clause!)\")\n    print(\"  Clauses generated: 4\")\n    print()\n    print(\"Reduction: 80% fewer clauses with set-of-support!\")\n\ndemonstrate_strategies()"
        ]
