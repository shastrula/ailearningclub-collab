          "python",
          "def paramodulation_example():\n    \"\"\"Demonstrate equality reasoning\"\"\"\n    print(\"Paramodulation example:\")\n    print()\n    print(\"Axioms:\")\n    print(\"  1. f(a) = b\")\n    print(\"  2. P(f(a))\")\n    print(\"Goal: P(b)\")\n    print()\n    print(\"Proof by paramodulation:\")\n    print(\"  From clause 2: P(f(a))\")\n    print(\"  From clause 1: f(a) = b\")\n    print(\"  Paramodulate 1 into 2: replace f(a) with b in P(f(a))\")\n    print(\"  Result: P(b)\")\n    print(\"  QED\")\n\nparamodulation_example()"
        ]
