        [
          "python",
          "from dataclasses import dataclass\nfrom typing import Optional, List, Dict, Set, Tuple\n\n@dataclass(frozen=True)\nclass Var:\n    name: str\n@dataclass(frozen=True)\nclass Const:\n    name: str\n@dataclass(frozen=True)\nclass Func:\n    name: str\n    args: tuple\n\nTerm = object\n\n@dataclass(frozen=True)\nclass Literal:\n    predicate: str\n    args: tuple\n    positive: bool\n\n    def complement(self):\n        return Literal(self.predicate, self.args, not self.positive)\n\n    def __repr__(self):\n        sign = \"\" if self.positive else \"~\"\n        args_str = \", \".join(str(a) for a in self.args)\n        return f\"{sign}{self.predicate}({args_str})\"\n\nClause = frozenset  # Set of Literals\n\nclass ResolutionProver:\n    \"\"\"First-order resolution theorem prover\"\"\"\n\n    def __init__(self):\n        self.clauses: List[Clause] = []\n        self.var_counter = 0\n\n    def add_clause(self, literals: List[Literal]):\n        self.clauses.append(frozenset(literals))\n\n    def prove(self, max_iterations=1000) -> Tuple[bool, List[str]]:\n        \"\"\"Try to derive the empty clause\"\"\"\n        proof_trace = []\n        known = set(self.clauses)\n        clauses_list = list(self.clauses)\n\n        for iteration in range(max_iterations):\n            new_clauses = set()\n\n            for i, c1 in enumerate(clauses_list):\n                for j, c2 in enumerate(clauses_list):\n                    if i >= j:\n                        continue\n                    resolvents = self.resolve(c1, c2)\n                    for resolvent in resolvents:\n                        if len(resolvent) == 0:\n                            proof_trace.append(\n                                f\"Empty clause derived from {c1} and {c2}\")\n                            return True, proof_trace\n                        if resolvent not in known:\n                            new_clauses.add(resolvent)\n\n            if not new_clauses:\n                return False, [\"No new clauses - cannot prove\"]\n\n            for c in new_clauses:\n                known.add(c)\n                clauses_list.append(c)\n                proof_trace.append(f\"Derived: {set(c)}\")\n\n        return False, [\"Max iterations reached\"]\n\n    def resolve(self, c1: Clause, c2: Clause) -> List[Clause]:\n        \"\"\"Find all resolvents of two clauses\"\"\"\n        # Rename variables in c2 to avoid conflicts\n        c2_renamed = self.rename_variables(c2)\n        resolvents = []\n\n        for lit1 in c1:\n            for lit2 in c2_renamed:\n                if (lit1.predicate == lit2.predicate and\n                    lit1.positive != lit2.positive):\n                    # Try to unify\n                    mgu = self.unify_args(lit1.args, lit2.args)\n                    if mgu is not None:\n                        # Build resolvent\n                        new_lits = set()\n                        for l in c1:\n                            if l is not lit1:\n                                new_lits.add(self.apply_subst_lit(l, mgu))\n                        for l in c2_renamed:\n                            if l is not lit2:\n                                new_lits.add(self.apply_subst_lit(l, mgu))\n                        resolvents.append(frozenset(new_lits))\n\n        return resolvents\n\n    def unify_args(self, args1, args2, subst=None):\n        if subst is None:\n            subst = {}\n        if len(args1) != len(args2):\n            return None\n        for a1, a2 in zip(args1, args2):\n            subst = self.unify_term(a1, a2, subst)\n            if subst is None:\n                return None\n        return subst\n\n    def unify_term(self, t1, t2, subst):\n        t1 = self.apply_subst_term(t1, subst)\n        t2 = self.apply_subst_term(t2, subst)\n\n        if t1 == t2:\n            return subst\n        if isinstance(t1, Var):\n            subst[t1.name] = t2\n            return subst\n        if isinstance(t2, Var):\n            subst[t2.name] = t1\n            return subst\n        if isinstance(t1, Func) and isinstance(t2, Func):\n            if t1.name != t2.name or len(t1.args) != len(t2.args):\n                return None\n            return self.unify_args(t1.args, t2.args, subst)\n        return None\n\n    def apply_subst_term(self, term, subst):\n        if isinstance(term, Var):\n            return subst.get(term.name, term)\n        if isinstance(term, Func):\n            new_args = tuple(self.apply_subst_term(a, subst) for a in term.args)\n            return Func(term.name, new_args)\n        return term\n\n    def apply_subst_lit(self, lit, subst):\n        new_args = tuple(self.apply_subst_term(a, subst) for a in lit.args)\n        return Literal(lit.predicate, new_args, lit.positive)\n\n    def rename_variables(self, clause):\n        self.var_counter += 1\n        suffix = f\"_{self.var_counter}\"\n        new_lits = set()\n        for lit in clause:\n            new_args = tuple(self.rename_term(a, suffix) for a in lit.args)\n            new_lits.add(Literal(lit.predicate, new_args, lit.positive))\n        return frozenset(new_lits)\n\n    def rename_term(self, term, suffix):\n        if isinstance(term, Var):\n            return Var(term.name + suffix)\n        if isinstance(term, Func):\n            new_args = tuple(self.rename_term(a, suffix) for a in term.args)\n            return Func(term.name, new_args)\n        return term\n\n# Example: Prove that Socrates is mortal\n# Axioms: Human(socrates), forall x. Human(x) -> Mortal(x)\n# Prove: Mortal(socrates)\nprover = ResolutionProver()\n\n# Human(socrates)\nprover.add_clause([Literal(\"Human\", (Const(\"socrates\"),), True)])\n\n# forall x. Human(x) -> Mortal(x)  ==  ~Human(x) v Mortal(x)\nprover.add_clause([\n    Literal(\"Human\", (Var(\"x\"),), False),\n    Literal(\"Mortal\", (Var(\"x\"),), True)\n])\n\n# Negation of goal: ~Mortal(socrates)\nprover.add_clause([Literal(\"Mortal\", (Const(\"socrates\"),), False)])\n\nproved, trace = prover.prove()\nprint(f\"Proved Mortal(socrates): {proved}\")\nfor step in trace:\n    print(f\"  {step}\")"
        ]
