          "python",
          "def prover_architecture():\n    \"\"\"Illustrate the given-clause algorithm\"\"\"\n    print(\"Given-Clause Algorithm (Otter/Vampire/E)\")\n    print(\"=\" * 45)\n    print()\n    print(\"Active = {}           (processed clauses)\")\n    print(\"Passive = {input}     (unprocessed clauses)\")\n    print()\n    print(\"LOOP:\")\n    print(\"  1. SELECT best clause G from Passive (heuristic)\")\n    print(\"  2. If G is empty clause: PROOF FOUND\")\n    print(\"  3. Move G to Active\")\n    print(\"  4. INFER: generate all resolvents of G with Active clauses\")\n    print(\"  5. SIMPLIFY: subsumption, demodulation, tautology deletion\")\n    print(\"  6. Add surviving new clauses to Passive\")\n    print(\"  7. GOTO 1\")\n    print()\n    print(\"Clause selection heuristics (compete in CASC):\")\n    print(\"  - Age (FIFO): fair but unfocused\")\n    print(\"  - Weight (smallest first): focused but may miss long proofs\")\n    print(\"  - Combined: alternate between strategies\")\n\nprover_architecture()"
        ]
