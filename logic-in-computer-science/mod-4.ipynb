        [
          "python",
          "import itertools\nfrom typing import List, Set, Tuple, Optional\n\n# A literal is represented as (variable_name, is_positive)\n# A clause is a set of literals\n# A CNF formula is a list of clauses\n\nLiteral = Tuple[str, bool]\nClause = Set[Literal]\nCNF = List[Clause]\n\ndef brute_force_sat(formula: CNF, variables: List[str]) -> Optional[dict]:\n    \"\"\"Brute force SAT solver - tries all 2^n assignments\"\"\"\n    for values in itertools.product([False, True], repeat=len(variables)):\n        assignment = dict(zip(variables, values))\n        if all(satisfies_clause(clause, assignment) for clause in formula):\n            return assignment\n    return None  # UNSAT\n\ndef satisfies_clause(clause: Clause, assignment: dict) -> bool:\n    \"\"\"A clause is satisfied if at least one literal is true\"\"\"\n    for var, is_positive in clause:\n        val = assignment[var]\n        if (is_positive and val) or (not is_positive and not val):\n            return True\n    return False\n\n# Example: (p v q) ^ (~p v r) ^ (~q v ~r)\nformula = [\n    {(\"p\", True), (\"q\", True)},       # p v q\n    {(\"p\", False), (\"r\", True)},       # ~p v r\n    {(\"q\", False), (\"r\", False)},      # ~q v ~r\n]\nresult = brute_force_sat(formula, [\"p\", \"q\", \"r\"])\nprint(f\"Solution: {result}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "def dpll(formula: CNF, assignment: dict = None) -> Optional[dict]:\n    \"\"\"DPLL SAT solver with unit propagation\"\"\"\n    if assignment is None:\n        assignment = {}\n\n    # Simplify formula with current assignment\n    formula = simplify(formula, assignment)\n\n    # Base cases\n    if formula is None:\n        return None  # Conflict detected (empty clause)\n    if len(formula) == 0:\n        return assignment  # All clauses satisfied\n\n    # Unit propagation\n    unit = find_unit_clause(formula)\n    if unit is not None:\n        var, is_positive = unit\n        new_assignment = dict(assignment)\n        new_assignment[var] = is_positive\n        return dpll(formula, new_assignment)\n\n    # Pure literal elimination\n    pure = find_pure_literal(formula)\n    if pure is not None:\n        var, is_positive = pure\n        new_assignment = dict(assignment)\n        new_assignment[var] = is_positive\n        return dpll(formula, new_assignment)\n\n    # Branching: pick an unassigned variable\n    var = pick_variable(formula, assignment)\n    if var is None:\n        return assignment\n\n    # Try True first\n    new_assignment = dict(assignment)\n    new_assignment[var] = True\n    result = dpll(formula, new_assignment)\n    if result is not None:\n        return result\n\n    # Try False\n    new_assignment = dict(assignment)\n    new_assignment[var] = False\n    return dpll(formula, new_assignment)\n\ndef simplify(formula: CNF, assignment: dict) -> Optional[CNF]:\n    \"\"\"Remove satisfied clauses and false literals\"\"\"\n    new_formula = []\n    for clause in formula:\n        satisfied = False\n        new_clause = set()\n        for var, is_positive in clause:\n            if var in assignment:\n                if assignment[var] == is_positive:\n                    satisfied = True\n                    break\n                # else: literal is false, skip it\n            else:\n                new_clause.add((var, is_positive))\n        if not satisfied:\n            if len(new_clause) == 0:\n                return None  # Empty clause = conflict\n            new_formula.append(new_clause)\n    return new_formula\n\ndef find_unit_clause(formula: CNF) -> Optional[Literal]:\n    \"\"\"Find a clause with exactly one literal\"\"\"\n    for clause in formula:\n        if len(clause) == 1:\n            return next(iter(clause))\n    return None\n\ndef find_pure_literal(formula: CNF) -> Optional[Literal]:\n    \"\"\"Find a variable that appears only positively or only negatively\"\"\"\n    pos_vars = set()\n    neg_vars = set()\n    for clause in formula:\n        for var, is_positive in clause:\n            if is_positive:\n                pos_vars.add(var)\n            else:\n                neg_vars.add(var)\n    # Pure positive\n    for var in pos_vars - neg_vars:\n        return (var, True)\n    # Pure negative\n    for var in neg_vars - pos_vars:\n        return (var, False)\n    return None\n\ndef pick_variable(formula: CNF, assignment: dict) -> Optional[str]:\n    \"\"\"Choose next variable to branch on\"\"\"\n    for clause in formula:\n        for var, _ in clause:\n            if var not in assignment:\n                return var\n    return None\n\n# Test DPLL solver\nformula = [\n    {(\"p\", True), (\"q\", True)},\n    {(\"p\", False), (\"r\", True)},\n    {(\"q\", False), (\"r\", False)},\n]\nresult = dpll(formula)\nprint(f\"DPLL solution: {result}\")"
        ]
      ]
