          "python",
          "def encode_n_queens(n: int) -> Tuple[CNF, List[str]]:\n    \"\"\"Encode N-Queens as a SAT problem\"\"\"\n    # Variable q_i_j means a queen is at row i, column j\n    def var(i, j):\n        return f\"q_{i}_{j}\"\n\n    clauses = []\n\n    # At least one queen per row\n    for i in range(n):\n        clauses.append({(var(i, j), True) for j in range(n)})\n\n    # At most one queen per row (pairwise exclusion)\n    for i in range(n):\n        for j1 in range(n):\n            for j2 in range(j1 + 1, n):\n                clauses.append({(var(i, j1), False), (var(i, j2), False)})\n\n    # At most one queen per column\n    for j in range(n):\n        for i1 in range(n):\n            for i2 in range(i1 + 1, n):\n                clauses.append({(var(i1, j), False), (var(i2, j), False)})\n\n    # At most one queen per diagonal\n    for i1 in range(n):\n        for j1 in range(n):\n            for i2 in range(i1 + 1, n):\n                for j2 in range(n):\n                    if abs(i1 - i2) == abs(j1 - j2):\n                        clauses.append({(var(i1, j1), False), (var(i2, j2), False)})\n\n    variables = [var(i, j) for i in range(n) for j in range(n)]\n    return clauses, variables\n\n# Encode 4-Queens\nclauses, variables = encode_n_queens(4)\nprint(f\"4-Queens encoding: {len(clauses)} clauses, {len(variables)} variables\")\nsolution = dpll(clauses)\nif solution:\n    print(\"Solution found:\")\n    for i in range(4):\n        row = \"\"\n        for j in range(4):\n            row += \"Q \" if solution.get(f\"q_{i}_{j}\", False) else \". \"\n        print(row)"
        ]
      ]
