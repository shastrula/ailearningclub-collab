      "source": [
        "# Local Llm Architecture - mod-1\n\n",
        "**Course:** local-llm-architecture\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Demonstrate model format differences\n# GGUF model via llama-cpp-python\nfrom llama_cpp import Llama\n\n# Download a GGUF model, then load\nllm = Llama(model_path=\"mistral-7b-instruct-v0.1.Q4_K_M.gguf\")\nresponse = llm(\"What is machine learning?\")\nprint(response['choices'][0]['text'])\n\n# GPTQ model via transformers\nfrom transformers import AutoModelForCausalLM, AutoTokenizer\n\nmodel_id = \"TheBloke/Mistral-7B-Instruct-v0.1-GPTQ\"\n# Requires auto_gptq installed\nmodel = AutoModelForCausalLM.from_pretrained(\n    model_id,\n    device_map=\"auto\",  # Auto-distribute across available GPUs\n    trust_remote_code=False,\n    revision=\"main\"\n)\ntokenizer = AutoTokenizer.from_pretrained(model_id, use_fast=True)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Check your hardware\nimport torch\nimport psutil\n\nprint(\"=== Hardware Check ===\")\nprint(f\"CPU Cores: {psutil.cpu_count()}\")\nprint(f\"RAM: {psutil.virtual_memory().total / 1e9:.1f} GB\")\n\nif torch.cuda.is_available():\n    print(f\"GPU: {torch.cuda.get_device_name(0)}\")\n    print(f\"GPU Memory: {torch.cuda.get_device_properties(0).total_memory / 1e9:.1f} GB\")\nelse:\n    print(\"No GPU detected\")\n\n# Estimate what you can run\n# 7B model quantized: ~4-6GB VRAM minimum\n# 13B model quantized: ~8-10GB VRAM minimum\n# 70B model quantized: ~30-50GB VRAM minimum"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Using Ollama for casual local LLM use\n# Command line: ollama pull mistral\n# Then: ollama run mistral\n\nimport requests\nimport json\n\ndef chat_local(prompt):\n    \"\"\"Query local Ollama instance\"\"\"\n    response = requests.post('http://localhost:11434/api/generate',\n        json={\n            \"model\": \"mistral\",\n            \"prompt\": prompt,\n            \"stream\": False\n        }\n    )\n    return response.json()['response']\n\nresult = chat_local(\"What is Python used for?\")\nprint(result)"
        ]
      ]
    }
