{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Local Llm Architecture - mod-3\n\n",
        "**Course:** local-llm-architecture\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "git clone https://github.com/ggerganov/llama.cpp.git\ncd llama.cpp"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# macOS prerequisites\nxcode-select --install\n\n# Linux (Ubuntu/Debian)\nsudo apt-get update\nsudo apt-get install build-essential cmake\n\n# Build llama.cpp\ncd llama.cpp\nmkdir build\ncd build\ncmake ..\ncmake --build . --config Release"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# CUDA support (NVIDIA GPUs)\ncmake .. -DLLAMA_CUDA=ON\n\n# Metal support (Apple Silicon / macOS)\ncmake .. -DLLAMA_METAL=ON\n\n# Then build\ncmake --build . --config Release"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Copy executable to a convenient location\ncp build/Release/main ~/bin/llama\n# Now you can run: llama [options]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Example: download Mistral 7B Instruct (4-bit quantized GGUF)\n# From Hugging Face, TheBloke's quantizations:\n# https://huggingface.co/TheBloke/Mistral-7B-Instruct-v0.1-GGUF\n\n# Using git lfs (large file support)\ngit clone https://huggingface.co/TheBloke/Mistral-7B-Instruct-v0.1-GGUF\ncd Mistral-7B-Instruct-v0.1-GGUF\n# Large files; this downloads several GB\n\n# Or use wget for specific files\nwget https://huggingface.co/TheBloke/Mistral-7B-Instruct-v0.1-GGUF/resolve/main/Mistral-7B-Instruct-v0.1.Q4_K_M.gguf"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Convert PyTorch model to GGUF\npython convert.py path/to/model --outfile model.gguf\n\n# The llama.cpp repo includes convert scripts for various formats\n# For newer models, convert-hf-to-gguf.py works with Hugging Face format"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Quantize your own model to Q4_K_M\n./build/Release/quantize path/to/model.gguf quantized.Q4_K_M.gguf Q4_K_M\n\n# Or other quantization methods\n# IQ4_XS (extreme small), IQ4_NL (no loss), Q5_K, Q6_K, Q8_0, etc."
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "./main -m model.gguf -n 256 -p \"Hello, how are you?\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Generate longer response\n./main -m mistral.gguf -n 512 -p \"Explain quantum computing\"\n\n# Use GPU acceleration (offload 40 layers to GPU)\n./main -m mistral.gguf -ngl 40 -n 256 -p \"What is AI?\"\n\n# Use more CPU threads\n./main -m mistral.gguf -t 8 -n 256 -p \"Tell a story\"\n\n# Interactive mode (continually read prompts)\n./main -m mistral.gguf -n 256 --interactive"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Creative writing (higher temperature, higher context)\n./main -m mistral.gguf -n 512 -c 2048 --temp 1.2 -p \"Write a short story about AI\"\n\n# Factual response (lower temperature, top-k limiting)\n./main -m mistral.gguf -n 256 --temp 0.1 --top-k 20 -p \"What is Python?\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "./main -m model.gguf --server --port 8000"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Via curl\ncurl http://localhost:8000/completion -d '{\n  \"prompt\": \"Hello, how are you?\",\n  \"n_predict\": 256\n}'\n\n# Via Python\nimport requests\n\nresponse = requests.post('http://localhost:8000/completion',\n    json={\n        \"prompt\": \"Explain machine learning\",\n        \"n_predict\": 256,\n        \"temperature\": 0.7\n    }\n)\nprint(response.json()['content'])"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Use local llama.cpp as OpenAI API drop-in replacement\nfrom openai import OpenAI\n\nclient = OpenAI(\n    api_key=\"sk-no-key-needed\",\n    base_url=\"http://localhost:8000/v1\"\n)\n\nresponse = client.chat.completions.create(\n    model=\"local-model\",\n    messages=[\n        {\"role\": \"system\", \"content\": \"You are a helpful assistant.\"},\n        {\"role\": \"user\", \"content\": \"What is Python?\"}\n    ],\n    temperature=0.7\n)\nprint(response.choices[0].message.content)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Offload 40 layers (of ~33 for a 7B model) = mostly GPU\n./main -m mistral.gguf -ngl 40\n\n# For 70B models with large GPU memory\n./main -m llama-70b.gguf -ngl 80"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Benchmark: compare CPU vs GPU on same model\n# CPU only\ntime ./main -m mistral.gguf -n 100 -p \"Hello\" 2>/dev/null\n\n# GPU with 40 layers offloaded\ntime ./main -m mistral.gguf -ngl 40 -n 100 -p \"Hello\" 2>/dev/null\n\n# GPU difference is dramatic"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# 1. Download a quantized model (skip if already have)\nwget https://huggingface.co/TheBloke/Mistral-7B-Instruct-v0.1-GGUF/resolve/main/Mistral-7B-Instruct-v0.1.Q4_K_M.gguf\n\n# 2. Build llama.cpp with GPU support\ngit clone https://github.com/ggerganov/llama.cpp.git\ncd llama.cpp\nmkdir build && cd build\ncmake .. -DLLAMA_CUDA=ON  # or -DLLAMA_METAL=ON for macOS\ncmake --build . --config Release\n\n# 3. Start server\n./build/Release/main -m ../Mistral-7B-Instruct-v0.1.Q4_K_M.gguf \\\n  --server --port 8000 -ngl 40\n\n# 4. Query from Python\npython3 << 'EOF'\nimport requests\nresponse = requests.post('http://localhost:8000/completion',\n    json={\"prompt\": \"What is AI?\", \"n_predict\": 100}\n)\nprint(response.json()['content'])\nEOF"
        ]
      ]
    }
  ],
