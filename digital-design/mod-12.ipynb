        "# Digital Design - mod-12\n\n",
        "**Course:** digital-design\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "A>B = A\u00b7B'\nA=B = A XNOR B = AB + A'B'  (equivalence)\nA<B = A'\u00b7B"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Algorithm:\n1. If A3 > B3: A > B (regardless of lower bits)\n2. If A3 < B3: A < B\n3. If A3 = B3: compare A2 with B2\n4. Continue until a difference is found or all bits match"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Let xi = Ai XNOR Bi  (equality of bit i)\n\nA=B: (A=B) = x3\u00b7x2\u00b7x1\u00b7x0\n\nA>B: (A>B) = A3\u00b7B3' + x3\u00b7A2\u00b7B2' + x3\u00b7x2\u00b7A1\u00b7B1' + x3\u00b7x2\u00b7x1\u00b7A0\u00b7B0'\n\nA<B: (A<B) = A3'\u00b7B3 + x3\u00b7A2'\u00b7B2 + x3\u00b7x2\u00b7A1'\u00b7B1 + x3\u00b7x2\u00b7x1\u00b7A0'\u00b7B0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "8-bit comparison using two 4-bit comparators:\n\nUpper comparator: compares A[7:4] with B[7:4]\n  Outputs: GT_upper, EQ_upper, LT_upper\n\nLower comparator: compares A[3:0] with B[3:0]\n  Cascade inputs: GT_in = GT_upper, EQ_in = EQ_upper, LT_in = LT_upper\n\nFinal result:\n  A>B = GT_upper + (EQ_upper \u00b7 GT_lower)\n  A=B = EQ_upper \u00b7 EQ_lower\n  A<B = LT_upper + (EQ_upper \u00b7 LT_lower)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Block Diagram:\n\n    A [n-1:0]     B [n-1:0]\n        |              |\n        v              v\n  +---------------------------+\n  |          ALU              |\n  |                           |\n  |   [Arithmetic Unit]      |\n  |   [Logic Unit]           |\n  |   [Shifter]              |\n  |                           |\n  |   [Output MUX] <-- OpSel |\n  +---------------------------+\n        |         |\n   Result[n-1:0]  Flags (Z,N,C,V)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// 4-bit Magnitude Comparator\nmodule comparator_4bit(\n    input  wire [3:0] A,\n    input  wire [3:0] B,\n    output wire       A_gt_B,\n    output wire       A_eq_B,\n    output wire       A_lt_B\n);\n    assign A_gt_B = (A > B);\n    assign A_eq_B = (A == B);\n    assign A_lt_B = (A < B);\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Complete 8-bit ALU\nmodule alu_8bit(\n    input  wire [7:0] A,\n    input  wire [7:0] B,\n    input  wire [2:0] op_sel,\n    output reg  [7:0] result,\n    output wire       zero,\n    output wire       negative,\n    output reg        carry,\n    output reg        overflow\n);\n    wire [8:0] add_result;\n    wire [8:0] sub_result;\n    \n    assign add_result = {1'b0, A} + {1'b0, B};\n    assign sub_result = {1'b0, A} - {1'b0, B};\n    \n    always @(*) begin\n        carry = 1'b0;\n        overflow = 1'b0;\n        \n        case(op_sel)\n            3'b000: begin  // Addition\n                result = add_result[7:0];\n                carry = add_result[8];\n                overflow = (A[7] == B[7]) && (result[7] != A[7]);\n            end\n            3'b001: begin  // Subtraction\n                result = sub_result[7:0];\n                carry = sub_result[8];\n                overflow = (A[7] != B[7]) && (result[7] != A[7]);\n            end\n            3'b010: result = A & B;      // AND\n            3'b011: result = A | B;      // OR\n            3'b100: result = A ^ B;      // XOR\n            3'b101: result = ~A;         // NOT\n            3'b110: begin                // Shift left\n                result = A << 1;\n                carry = A[7];\n            end\n            3'b111: begin                // Shift right\n                result = A >> 1;\n                carry = A[0];\n            end\n        endcase\n    end\n    \n    assign zero = (result == 8'b0);\n    assign negative = result[7];\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// ALU Testbench\nmodule test_alu;\n    reg [7:0] A, B;\n    reg [2:0] op;\n    wire [7:0] result;\n    wire zero, negative, carry, overflow;\n    \n    alu_8bit uut(\n        .A(A), .B(B), .op_sel(op),\n        .result(result), .zero(zero),\n        .negative(negative), .carry(carry), .overflow(overflow)\n    );\n    \n    initial begin\n        // Test addition\n        A = 8'd25; B = 8'd17; op = 3'b000; #10;\n        $display(\"25 + 17 = %d, Z=%b N=%b C=%b V=%b\", result, zero, negative, carry, overflow);\n        \n        // Test subtraction\n        A = 8'd25; B = 8'd17; op = 3'b001; #10;\n        $display(\"25 - 17 = %d, Z=%b N=%b C=%b V=%b\", result, zero, negative, carry, overflow);\n        \n        // Test overflow\n        A = 8'd127; B = 8'd1; op = 3'b000; #10;\n        $display(\"127 + 1 = %d (signed: %d), V=%b\", result, $signed(result), overflow);\n    end\nendmodule"
        ]
      ]
    }
