    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module all_gates(\n    input  wire A,\n    input  wire B,\n    output wire and_out,\n    output wire or_out,\n    output wire not_out,\n    output wire nand_out,\n    output wire nor_out,\n    output wire xor_out,\n    output wire xnor_out\n);\n    assign and_out  = A & B;\n    assign or_out   = A | B;\n    assign not_out  = ~A;\n    assign nand_out = ~(A & B);\n    assign nor_out  = ~(A | B);\n    assign xor_out  = A ^ B;\n    assign xnor_out = ~(A ^ B);\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Testbench: exhaustive verification\nmodule test_all_gates;\n    reg A, B;\n    wire and_out, or_out, not_out, nand_out, nor_out, xor_out, xnor_out;\n    \n    all_gates uut(.*);\n    \n    initial begin\n        $display(\"A B | AND OR NOT NAND NOR XOR XNOR\");\n        for (integer i = 0; i < 4; i = i + 1) begin\n            {A, B} = i;\n            #10;\n            $display(\"%b %b |  %b   %b   %b    %b    %b   %b    %b\",\n                     A, B, and_out, or_out, not_out,\n                     nand_out, nor_out, xor_out, xnor_out);\n        end\n    end\nendmodule"
        ]
      ]
    }
  ],
