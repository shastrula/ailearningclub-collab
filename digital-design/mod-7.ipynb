          "python",
          "BC=00  BC=01  BC=11  BC=10\n         +------+------+------+------+\n   A=0   | m0   | m1   | m3   | m2   |\n         +------+------+------+------+\n   A=1   | m4   | m5   | m7   | m6   |\n         +------+------+------+------+"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "BC=00  BC=01  BC=11  BC=10\n         +------+------+------+------+\n   A=0   |  1   |  0   |  0   |  1   |\n         +------+------+------+------+\n   A=1   |  1   |  1   |  0   |  1   |\n         +------+------+------+------+\n\nGroups:\n- Group 1: m0, m2, m4, m6 (all four corners = wrap-around)\n  These cells have C=0: gives C'\n- Group 2: m4, m5 (row A=1, columns BC=00 and BC=01)\n  These have A=1, B=0: gives AB'\n\nF = C' + AB'"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "CD=00  CD=01  CD=11  CD=10\n           +------+------+------+------+\n  AB=00    | m0   | m1   | m3   | m2   |\n           +------+------+------+------+\n  AB=01    | m4   | m5   | m7   | m6   |\n           +------+------+------+------+\n  AB=11    | m12  | m13  | m15  | m14  |\n           +------+------+------+------+\n  AB=10    | m8   | m9   | m11  | m10  |\n           +------+------+------+------+"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "CD=00  CD=01  CD=11  CD=10\n           +------+------+------+------+\n  AB=00    |  1   |  1   |  0   |  1   |\n           +------+------+------+------+\n  AB=01    |  0   |  1   |  0   |  0   |\n           +------+------+------+------+\n  AB=11    |  0   |  0   |  0   |  0   |\n           +------+------+------+------+\n  AB=10    |  1   |  1   |  0   |  1   |\n           +------+------+------+------+\n\nGroups:\n- Group 1: m0, m1, m8, m9 (wrap top-bottom, columns CD=00,01)\n  B'D' ... wait, let me identify correctly:\n  Cells (AB=00,CD=00), (AB=00,CD=01), (AB=10,CD=00), (AB=10,CD=01)\n  Common: B=0, D changes, C=0: gives B'C'\n\n- Group 2: m0, m2, m8, m10 (wrap top-bottom, columns CD=00,10)\n  Common: B=0, D=0: gives B'D'\n\n- Group 3: m1, m5 (AB=00,CD=01), (AB=01,CD=01)\n  Common: A=0, C=0, D=1: gives A'C'D\n\nF = B'C' + B'D' + A'C'D"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "CD=00  CD=01  CD=11  CD=10\n           +------+------+------+------+\n  AB=00    |  1   |  0   |  0   |  1   |\n           +------+------+------+------+\n  AB=01    |  X   |  0   |  0   |  X   |\n           +------+------+------+------+\n  AB=11    |  1   |  0   |  0   |  1   |\n           +------+------+------+------+\n  AB=10    |  X   |  0   |  0   |  X   |\n           +------+------+------+------+\n\nWithout don't-cares: F = A'B'D' + ABD' (two terms)\nWith don't-cares: treat X as 1 in column CD=00 and CD=10\n  Group all 8 cells in those columns: F = D'  (one term!)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module kmap_example(\n    input  wire A, B, C, D,\n    output wire F_unsimplified,\n    output wire F_simplified\n);\n    // Original: sum of minterms (7 terms, 7 AND gates + OR)\n    assign F_unsimplified = (~A & ~B & ~C & ~D) | (~A & ~B & ~C & D) |\n                            (~A & ~B & C & ~D) | (~A & B & ~C & D) |\n                            (A & ~B & ~C & ~D) | (A & ~B & ~C & D) |\n                            (A & ~B & C & ~D);\n    \n    // K-map simplified: 3 terms\n    assign F_simplified = (~B & ~C) | (~B & ~D) | (~A & ~C & D);\nendmodule"
        ]
      ]
    }
