    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Simple digital signal representation in Verilog\nmodule digital_basics;\n    // Single-bit signals\n    reg signal_high = 1'b1;   // Logic HIGH\n    reg signal_low  = 1'b0;   // Logic LOW\n    \n    // Multi-bit signal (8-bit byte)\n    reg [7:0] data_byte = 8'b10110011;\n    \n    // Display values\n    initial begin\n        $display(\"HIGH = %b\", signal_high);\n        $display(\"LOW  = %b\", signal_low);\n        $display(\"Byte = %b (decimal %d)\", data_byte, data_byte);\n    end\nendmodule"
        ]
      ]
    }
