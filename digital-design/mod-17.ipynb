      "source": [
        [
          "python",
          "D[n-1:0]\n                    \u2502\n                    \u25bc\n  \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n  \u2502  [D FF] [D FF] ... [D FF]\u2502 \u2190 CLK\n  \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n                    \u2502\n                    \u25bc\n                 Q[n-1:0]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "When LOAD=1: Q(next) = D (load new data)\nWhen LOAD=0: Q(next) = Q (hold current value)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "SI \u2192 [FF0] \u2192 [FF1] \u2192 [FF2] \u2192 [FF3] \u2192 SO\n\nData enters one bit at a time and exits one bit at a time.\nTakes n clock cycles to load n bits."
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "SI \u2192 [FF0] \u2192 [FF1] \u2192 [FF2] \u2192 [FF3]\n       Q0      Q1      Q2      Q3\n\nData enters serially, all bits available simultaneously after n clocks.\nUsed in: serial-to-parallel conversion (UART receivers)."
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "D0      D1      D2      D3   (parallel load)\n      \u2193       \u2193       \u2193       \u2193\n    [FF0] \u2192 [FF1] \u2192 [FF2] \u2192 [FF3] \u2192 SO\n\nLoad all bits at once, then shift out one at a time.\nUsed in: parallel-to-serial conversion (UART transmitters)."
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "This is simply a parallel load register (covered above).\nAll bits loaded and available simultaneously."
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Clock  | SI | Q3 | Q2 | Q1 | Q0 (SO)\n-------|----|----|----|----|----\nInit   | -  |  0 |  0 |  0 |  0\nCLK 1  | 1  |  1 |  0 |  0 |  0\nCLK 2  | 0  |  0 |  1 |  0 |  0\nCLK 3  | 1  |  1 |  0 |  1 |  0\nCLK 4  | 1  |  1 |  1 |  0 |  1"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "When DIR=0: Shift right (Q[i] \u2190 Q[i+1])\nWhen DIR=1: Shift left  (Q[i] \u2190 Q[i-1])"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Pattern: 1000 \u2192 0100 \u2192 0010 \u2192 0001 \u2192 1000 (repeats)\n4 states with 4 flip-flops"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Pattern: 0000 \u2192 1000 \u2192 1100 \u2192 1110 \u2192 1111 \u2192 0111 \u2192 0011 \u2192 0001 \u2192 0000\n8 states with 4 flip-flops (2n states with n flip-flops)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Used for: pseudo-random number generation, CRC calculation,\n          built-in self-test (BIST), scrambling/descrambling"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// 8-bit Register with load enable and reset\nmodule register_8bit(\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire       load,\n    input  wire [7:0] data_in,\n    output reg  [7:0] data_out\n);\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            data_out <= 8'b0;\n        else if (load)\n            data_out <= data_in;\n    end\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// 8-bit Shift Register (SIPO)\nmodule shift_register_sipo(\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire       serial_in,\n    output wire [7:0] parallel_out\n);\n    reg [7:0] shift_reg;\n    \n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            shift_reg <= 8'b0;\n        else\n            shift_reg <= {serial_in, shift_reg[7:1]};  // Shift right\n    end\n    \n    assign parallel_out = shift_reg;\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Universal Shift Register\nmodule universal_shift_reg #(parameter N = 8)(\n    input  wire         clk,\n    input  wire         rst_n,\n    input  wire [1:0]   mode,       // 00=hold, 01=shift_right, 10=shift_left, 11=load\n    input  wire         si_right,   // Serial input for right shift\n    input  wire         si_left,    // Serial input for left shift\n    input  wire [N-1:0] par_in,     // Parallel input\n    output reg  [N-1:0] data,\n    output wire         so_right,   // Serial output (right)\n    output wire         so_left     // Serial output (left)\n);\n    assign so_right = data[0];\n    assign so_left  = data[N-1];\n    \n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            data <= {N{1'b0}};\n        else begin\n            case (mode)\n                2'b00: data <= data;                          // Hold\n                2'b01: data <= {si_right, data[N-1:1]};      // Shift right\n                2'b10: data <= {data[N-2:0], si_left};       // Shift left\n                2'b11: data <= par_in;                        // Parallel load\n            endcase\n        end\n    end\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// LFSR - 8-bit pseudo-random number generator\nmodule lfsr_8bit(\n    input  wire       clk,\n    input  wire       rst_n,\n    output reg  [7:0] random\n);\n    wire feedback;\n    // Polynomial: x^8 + x^6 + x^5 + x^4 + 1\n    assign feedback = random[7] ^ random[5] ^ random[4] ^ random[3];\n    \n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            random <= 8'b00000001;  // Non-zero seed required\n        else\n            random <= {random[6:0], feedback};\n    end\nendmodule"
        ]
      ]
    }
