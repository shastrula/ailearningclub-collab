        [
          "python",
          "\u2502  N  \u2502\n            \u2502  S  \u2502\n     \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518     \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n E-W                   E-W\n     \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510     \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n            \u2502  N  \u2502\n            \u2502  S  \u2502\n\nTwo roads: North-South (NS) and East-West (EW)\nEach direction has: Green, Yellow, Red lights\nPedestrian signals: Walk, Don't Walk for each crossing"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n                    \u25bc                                          \u2502\nRESET \u2500\u2500\u2192 ALL_RED_1 \u2500\u2500\u2192 NS_GREEN \u2500\u2500\u2192 NS_YELLOW \u2500\u2500\u2192 ALL_RED_2 \u2500\u2524\n                                                               \u2502\n              \u250c\u2500\u2500\u2500 EW_YELLOW \u2190\u2500\u2500 EW_GREEN \u2190\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n              \u2502         (skip if no EW traffic)\n              \u25bc\n          ALL_RED_1 (back to start)\n          \nEMERGENCY (from any state): \u2192 ALL_RED \u2192 EMERG_GREEN \u2192 return"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module traffic_light_controller(\n    input  wire       clk,          // System clock (assume 1 Hz for simplicity)\n    input  wire       rst_n,        // Active-low reset\n    input  wire       sensor_ew,    // Car detected on EW road\n    input  wire       ped_button,   // Pedestrian crossing request\n    input  wire       emergency,    // Emergency vehicle detected\n    input  wire       emerg_dir,    // 0=NS, 1=EW direction of emergency\n    output reg  [2:0] ns_light,     // {Green, Yellow, Red}\n    output reg  [2:0] ew_light,     // {Green, Yellow, Red}\n    output reg        ns_walk,      // NS pedestrian walk signal\n    output reg        ew_walk,      // EW pedestrian walk signal\n    output reg  [5:0] time_remaining // Display countdown\n);\n\n    // State encoding\n    localparam ALL_RED_1   = 4'd0;\n    localparam NS_GREEN    = 4'd1;\n    localparam NS_YELLOW   = 4'd2;\n    localparam ALL_RED_2   = 4'd3;\n    localparam EW_GREEN    = 4'd4;\n    localparam EW_YELLOW   = 4'd5;\n    localparam EMERGENCY   = 4'd6;\n    localparam EMERG_GREEN = 4'd7;\n    localparam ALL_RED_RET = 4'd8;\n\n    // Light encodings\n    localparam GREEN  = 3'b100;\n    localparam YELLOW = 3'b010;\n    localparam RED    = 3'b001;\n\n    // Timing constants (in clock cycles, assuming 1 Hz clock)\n    localparam T_ALL_RED   = 6'd2;\n    localparam T_NS_GREEN  = 6'd30;\n    localparam T_NS_YELLOW = 6'd5;\n    localparam T_EW_GREEN  = 6'd25;\n    localparam T_EW_YELLOW = 6'd5;\n    localparam T_PED_EXT   = 6'd10;\n    localparam T_EMERG     = 6'd10;\n\n    // Internal registers\n    reg [3:0] state, next_state;\n    reg [5:0] timer, next_timer;\n    reg [3:0] return_state;       // State to return to after emergency\n    reg       ped_served;          // Pedestrian extension already granted\n    reg       ped_request;         // Latched pedestrian request\n\n    // Timer countdown logic\n    wire timer_expired = (timer == 6'd0);\n\n    // Latch pedestrian request\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            ped_request <= 1'b0;\n        else if (ped_button && !ped_served)\n            ped_request <= 1'b1;\n        else if (state == NS_GREEN || state == EW_GREEN)\n            ped_request <= ped_request;  // Hold during green\n        else\n            ped_request <= 1'b0;\n    end\n\n    // State register and timer\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            state      <= ALL_RED_1;\n            timer      <= T_ALL_RED;\n            return_state <= ALL_RED_1;\n            ped_served <= 1'b0;\n        end else begin\n            state <= next_state;\n            \n            if (next_state != state)\n                timer <= next_timer;  // Load new timer on state change\n            else if (!timer_expired)\n                timer <= timer - 6'd1; // Count down\n                \n            // Track emergency return state\n            if (emergency && state != EMERGENCY && state != EMERG_GREEN)\n                return_state <= state;\n                \n            // Track pedestrian service\n            if (state == ALL_RED_1 || state == ALL_RED_2)\n                ped_served <= 1'b0;\n            else if (ped_request && timer_expired && \n                     (state == NS_GREEN || state == EW_GREEN))\n                ped_served <= 1'b1;\n        end\n    end\n\n    // Next-state logic\n    always @(*) begin\n        next_state = state;\n        next_timer = 6'd0;\n        \n        case (state)\n            ALL_RED_1: begin\n                if (timer_expired) begin\n                    next_state = NS_GREEN;\n                    next_timer = T_NS_GREEN;\n                end\n            end\n            \n            NS_GREEN: begin\n                if (emergency) begin\n                    next_state = EMERGENCY;\n                    next_timer = T_ALL_RED;\n                end else if (timer_expired) begin\n                    if (ped_request && !ped_served) begin\n                        next_state = NS_GREEN;  // Extend\n                        next_timer = T_PED_EXT;\n                    end else begin\n                        next_state = NS_YELLOW;\n                        next_timer = T_NS_YELLOW;\n                    end\n                end\n            end\n            \n            NS_YELLOW: begin\n                if (emergency) begin\n                    next_state = EMERGENCY;\n                    next_timer = T_ALL_RED;\n                end else if (timer_expired) begin\n                    next_state = ALL_RED_2;\n                    next_timer = T_ALL_RED;\n                end\n            end\n            \n            ALL_RED_2: begin\n                if (timer_expired) begin\n                    if (sensor_ew) begin\n                        next_state = EW_GREEN;\n                        next_timer = T_EW_GREEN;\n                    end else begin\n                        next_state = ALL_RED_1;  // Skip EW, restart\n                        next_timer = T_ALL_RED;\n                    end\n                end\n            end\n            \n            EW_GREEN: begin\n                if (emergency) begin\n                    next_state = EMERGENCY;\n                    next_timer = T_ALL_RED;\n                end else if (timer_expired) begin\n                    if (ped_request && !ped_served) begin\n                        next_state = EW_GREEN;\n                        next_timer = T_PED_EXT;\n                    end else begin\n                        next_state = EW_YELLOW;\n                        next_timer = T_EW_YELLOW;\n                    end\n                end\n            end\n            \n            EW_YELLOW: begin\n                if (emergency) begin\n                    next_state = EMERGENCY;\n                    next_timer = T_ALL_RED;\n                end else if (timer_expired) begin\n                    next_state = ALL_RED_1;\n                    next_timer = T_ALL_RED;\n                end\n            end\n            \n            EMERGENCY: begin\n                if (timer_expired) begin\n                    next_state = EMERG_GREEN;\n                    next_timer = T_EMERG;\n                end\n            end\n            \n            EMERG_GREEN: begin\n                if (timer_expired || !emergency) begin\n                    next_state = ALL_RED_RET;\n                    next_timer = T_ALL_RED;\n                end\n            end\n            \n            ALL_RED_RET: begin\n                if (timer_expired) begin\n                    next_state = ALL_RED_1;\n                    next_timer = T_ALL_RED;\n                end\n            end\n            \n            default: begin\n                next_state = ALL_RED_1;\n                next_timer = T_ALL_RED;\n            end\n        endcase\n    end\n\n    // Output logic (Moore - based on state only)\n    always @(*) begin\n        // Default: all red\n        ns_light = RED;\n        ew_light = RED;\n        ns_walk  = 1'b0;\n        ew_walk  = 1'b0;\n        time_remaining = timer;\n        \n        case (state)\n            NS_GREEN: begin\n                ns_light = GREEN;\n                ns_walk  = 1'b1;\n            end\n            NS_YELLOW: begin\n                ns_light = YELLOW;\n            end\n            EW_GREEN: begin\n                ew_light = GREEN;\n                ew_walk  = 1'b1;\n            end\n            EW_YELLOW: begin\n                ew_light = YELLOW;\n            end\n            EMERG_GREEN: begin\n                if (emerg_dir == 1'b0)\n                    ns_light = GREEN;\n                else\n                    ew_light = GREEN;\n            end\n            // ALL_RED states: default (all red) applies\n        endcase\n    end\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module tb_traffic_light;\n    reg        clk, rst_n;\n    reg        sensor_ew, ped_button, emergency, emerg_dir;\n    wire [2:0] ns_light, ew_light;\n    wire       ns_walk, ew_walk;\n    wire [5:0] time_remaining;\n    \n    traffic_light_controller uut(.*);\n    \n    initial clk = 0;\n    always #500 clk = ~clk;  // 1 Hz (500ms half period for simulation)\n    \n    // Light name decoder for display\n    function [6*8-1:0] light_name;\n        input [2:0] light;\n        case (light)\n            3'b100:  light_name = \"GREEN \";\n            3'b010:  light_name = \"YELLOW\";\n            3'b001:  light_name = \"RED   \";\n            default: light_name = \"UNKNWN\";\n        endcase\n    endfunction\n    \n    initial begin\n        // Initialize\n        rst_n = 0; sensor_ew = 1; ped_button = 0;\n        emergency = 0; emerg_dir = 0;\n        #2000 rst_n = 1;\n        \n        // Normal operation (let it run through a full cycle)\n        #70000;\n        \n        // Test: No EW traffic (should skip EW green)\n        sensor_ew = 0;\n        #50000;\n        \n        // Test: Pedestrian button\n        sensor_ew = 1;\n        #10000;\n        ped_button = 1;\n        #2000;\n        ped_button = 0;\n        #50000;\n        \n        // Test: Emergency vehicle\n        emergency = 1; emerg_dir = 1;  // EW emergency\n        #15000;\n        emergency = 0;\n        #10000;\n        \n        $finish;\n    end\n    \n    // Monitor output\n    always @(posedge clk) begin\n        $display(\"t=%0t NS=%s EW=%s Walk:NS=%b,EW=%b Timer=%d\",\n                 $time, light_name(ns_light), light_name(ew_light),\n                 ns_walk, ew_walk, time_remaining);\n    end\nendmodule"
        ]
      ]
    }
  ],
