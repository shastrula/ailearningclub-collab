      "outputs": [],
      "source": [
        [
          "verilog",
          "module mux_param #(\n    parameter WIDTH = 8,\n    parameter INPUTS = 4,\n    parameter SEL_WIDTH = $clog2(INPUTS)\n)(\n    input  wire [INPUTS*WIDTH-1:0] data_in,\n    input  wire [SEL_WIDTH-1:0]    sel,\n    output wire [WIDTH-1:0]        data_out\n);\n    assign data_out = data_in[sel*WIDTH +: WIDTH];\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module priority_arbiter #(parameter N = 4)(\n    input  wire [N-1:0] request,\n    output wire [N-1:0] grant\n);\n    wire [N-1:0] higher_pri_mask;\n    \n    assign higher_pri_mask[0] = 1'b0;\n    \n    genvar i;\n    generate\n        for (i = 1; i < N; i = i + 1) begin : mask_gen\n            assign higher_pri_mask[i] = higher_pri_mask[i-1] | request[i-1];\n        end\n    endgenerate\n    \n    assign grant = request & ~higher_pri_mask;\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module barrel_shifter #(parameter WIDTH = 8)(\n    input  wire [WIDTH-1:0]        data_in,\n    input  wire [$clog2(WIDTH)-1:0] shift_amt,\n    input  wire                     direction,  // 0=left, 1=right\n    output wire [WIDTH-1:0]        data_out\n);\n    wire [WIDTH-1:0] shifted_left;\n    wire [WIDTH-1:0] shifted_right;\n    \n    assign shifted_left  = data_in << shift_amt;\n    assign shifted_right = data_in >> shift_amt;\n    assign data_out = direction ? shifted_right : shifted_left;\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module bin_to_gray #(parameter WIDTH = 4)(\n    input  wire [WIDTH-1:0] binary,\n    output wire [WIDTH-1:0] gray\n);\n    assign gray = binary ^ (binary >> 1);\nendmodule\n\nmodule gray_to_bin #(parameter WIDTH = 4)(\n    input  wire [WIDTH-1:0] gray,\n    output wire [WIDTH-1:0] binary\n);\n    genvar i;\n    assign binary[WIDTH-1] = gray[WIDTH-1];\n    generate\n        for (i = WIDTH-2; i >= 0; i = i - 1) begin : decode\n            assign binary[i] = binary[i+1] ^ gray[i];\n        end\n    endgenerate\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module edge_detector(\n    input  wire clk,\n    input  wire rst_n,\n    input  wire signal_in,\n    output wire rising_edge,\n    output wire falling_edge,\n    output wire any_edge\n);\n    reg signal_delayed;\n    \n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            signal_delayed <= 1'b0;\n        else\n            signal_delayed <= signal_in;\n    end\n    \n    assign rising_edge  = signal_in & ~signal_delayed;\n    assign falling_edge = ~signal_in & signal_delayed;\n    assign any_edge     = signal_in ^ signal_delayed;\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module debounce #(\n    parameter COUNTER_WIDTH = 16  // ~655us at 100MHz\n)(\n    input  wire clk,\n    input  wire rst_n,\n    input  wire noisy_in,\n    output reg  clean_out\n);\n    reg [COUNTER_WIDTH-1:0] counter;\n    reg                     sync_input;\n    reg                     input_reg;\n    \n    // Synchronize input (prevent metastability)\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            sync_input <= 1'b0;\n            input_reg  <= 1'b0;\n        end else begin\n            input_reg  <= noisy_in;\n            sync_input <= input_reg;\n        end\n    end\n    \n    // Debounce counter\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            counter   <= {COUNTER_WIDTH{1'b0}};\n            clean_out <= 1'b0;\n        end else begin\n            if (sync_input != clean_out) begin\n                counter <= counter + 1'b1;\n                if (&counter)  // Counter overflow\n                    clean_out <= sync_input;\n            end else begin\n                counter <= {COUNTER_WIDTH{1'b0}};\n            end\n        end\n    end\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module sync_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter DEPTH = 16,\n    parameter ADDR_WIDTH = $clog2(DEPTH)\n)(\n    input  wire                  clk,\n    input  wire                  rst_n,\n    input  wire                  write_en,\n    input  wire                  read_en,\n    input  wire [DATA_WIDTH-1:0] write_data,\n    output wire [DATA_WIDTH-1:0] read_data,\n    output wire                  full,\n    output wire                  empty,\n    output wire [ADDR_WIDTH:0]   count\n);\n    reg [DATA_WIDTH-1:0] memory [0:DEPTH-1];\n    reg [ADDR_WIDTH:0]   write_ptr;\n    reg [ADDR_WIDTH:0]   read_ptr;\n    \n    assign count = write_ptr - read_ptr;\n    assign full  = (count == DEPTH);\n    assign empty = (count == 0);\n    assign read_data = memory[read_ptr[ADDR_WIDTH-1:0]];\n    \n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            write_ptr <= {(ADDR_WIDTH+1){1'b0}};\n            read_ptr  <= {(ADDR_WIDTH+1){1'b0}};\n        end else begin\n            if (write_en && !full) begin\n                memory[write_ptr[ADDR_WIDTH-1:0]] <= write_data;\n                write_ptr <= write_ptr + 1'b1;\n            end\n            if (read_en && !empty)\n                read_ptr <= read_ptr + 1'b1;\n        end\n    end\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module clock_divider #(parameter DIVISOR = 100_000_000)(\n    input  wire clk,\n    input  wire rst_n,\n    output reg  clk_out\n);\n    reg [$clog2(DIVISOR)-1:0] counter;\n    \n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            counter <= 0;\n            clk_out <= 1'b0;\n        end else begin\n            if (counter == (DIVISOR/2 - 1)) begin\n                counter <= 0;\n                clk_out <= ~clk_out;\n            end else begin\n                counter <= counter + 1'b1;\n            end\n        end\n    end\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module pwm_generator #(\n    parameter RESOLUTION = 8  // 256 levels\n)(\n    input  wire                   clk,\n    input  wire                   rst_n,\n    input  wire [RESOLUTION-1:0]  duty_cycle,\n    output reg                    pwm_out\n);\n    reg [RESOLUTION-1:0] counter;\n    \n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            counter <= {RESOLUTION{1'b0}};\n            pwm_out <= 1'b0;\n        end else begin\n            counter <= counter + 1'b1;\n            pwm_out <= (counter < duty_cycle);\n        end\n    end\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module tb_fifo;\n    parameter DATA_WIDTH = 8;\n    parameter DEPTH = 4;\n    \n    reg                   clk, rst_n;\n    reg                   wr_en, rd_en;\n    reg  [DATA_WIDTH-1:0] wr_data;\n    wire [DATA_WIDTH-1:0] rd_data;\n    wire                  full, empty;\n    \n    sync_fifo #(.DATA_WIDTH(DATA_WIDTH), .DEPTH(DEPTH)) uut(\n        .clk(clk), .rst_n(rst_n),\n        .write_en(wr_en), .read_en(rd_en),\n        .write_data(wr_data), .read_data(rd_data),\n        .full(full), .empty(empty), .count()\n    );\n    \n    initial clk = 0;\n    always #5 clk = ~clk;\n    \n    task write_item(input [DATA_WIDTH-1:0] data);\n        @(posedge clk);\n        wr_en = 1; wr_data = data;\n        @(posedge clk);\n        wr_en = 0;\n    endtask\n    \n    task read_item;\n        @(posedge clk);\n        rd_en = 1;\n        @(posedge clk);\n        rd_en = 0;\n    endtask\n    \n    initial begin\n        rst_n = 0; wr_en = 0; rd_en = 0; wr_data = 0;\n        #20 rst_n = 1;\n        \n        // Fill FIFO\n        write_item(8'hAA);\n        write_item(8'hBB);\n        write_item(8'hCC);\n        write_item(8'hDD);\n        \n        // Verify full\n        if (!full) $display(\"ERROR: FIFO should be full\");\n        \n        // Read back\n        read_item;\n        if (rd_data != 8'hAA) $display(\"ERROR: Expected AA, got %h\", rd_data);\n        \n        #50 $finish;\n    end\nendmodule"
        ]
      ]
    }
