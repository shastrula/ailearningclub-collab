      "source": [
        "# Digital Design - mod-10\n\n",
        "**Course:** digital-design\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Y0 = A1' \u00b7 A0'\nY1 = A1' \u00b7 A0\nY2 = A1  \u00b7 A0'\nY3 = A1  \u00b7 A0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Inputs: A2, A1, A0\nOutputs: Y0 through Y7\n\nY0 = A2'A1'A0'  (minterm 0)\nY1 = A2'A1'A0   (minterm 1)\nY2 = A2'A1 A0'  (minterm 2)\nY3 = A2'A1 A0   (minterm 3)\nY4 = A2 A1'A0'  (minterm 4)\nY5 = A2 A1'A0   (minterm 5)\nY6 = A2 A1 A0'  (minterm 6)\nY7 = A2 A1 A0   (minterm 7)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "When E=0: all outputs = 0 (decoder disabled)\nWhen E=1: decoder operates normally\n\nY0 = E \u00b7 A1' \u00b7 A0'\nY1 = E \u00b7 A1' \u00b7 A0\nY2 = E \u00b7 A1  \u00b7 A0'\nY3 = E \u00b7 A1  \u00b7 A0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Connect A,B,C to decoder inputs\nF = Y1 + Y3 + Y5 + Y7 (OR gate on selected outputs)\n\nNote: this function simplifies to F = C, but the decoder approach\nworks for ANY function without simplification."
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Architecture:\n- Use MSB (A3) to enable one decoder or the other\n- Decoder 1 (E = A3'): produces outputs Y0-Y7\n- Decoder 2 (E = A3):  produces outputs Y8-Y15\n- Both decoders share A2, A1, A0 as inputs"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Y1 = I2 + I3\nY0 = I1 + I3"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Y1 = I3 + I2\nY0 = I3 + I1\u00b7I2'\nValid = I3 + I2 + I1 + I0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// 3-to-8 Decoder with enable\nmodule decoder_3to8(\n    input  wire [2:0] addr,\n    input  wire       enable,\n    output reg  [7:0] y\n);\n    always @(*) begin\n        y = 8'b0;\n        if (enable)\n            y[addr] = 1'b1;\n    end\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// 8-to-3 Priority Encoder\nmodule priority_encoder_8to3(\n    input  wire [7:0] request,\n    output reg  [2:0] code,\n    output wire       valid\n);\n    assign valid = |request;\n    \n    always @(*) begin\n        casez(request)\n            8'b1???????: code = 3'd7;\n            8'b01??????: code = 3'd6;\n            8'b001?????: code = 3'd5;\n            8'b0001????: code = 3'd4;\n            8'b00001???: code = 3'd3;\n            8'b000001??: code = 3'd2;\n            8'b0000001?: code = 3'd1;\n            8'b00000001: code = 3'd0;\n            default:     code = 3'd0;\n        endcase\n    end\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Using decoder for function implementation\nmodule function_with_decoder(\n    input  wire A, B, C,\n    output wire F\n);\n    wire [7:0] minterm;\n    \n    decoder_3to8 dec(\n        .addr({A, B, C}),\n        .enable(1'b1),\n        .y(minterm)\n    );\n    \n    // F = Sigma m(1,3,5,7) = C\n    assign F = minterm[1] | minterm[3] | minterm[5] | minterm[7];\nendmodule"
        ]
      ]
    }
  ],
