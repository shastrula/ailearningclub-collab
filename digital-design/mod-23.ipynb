        "# Digital Design - mod-23\n\n",
        "**Course:** digital-design\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module module_name(\n    input  wire       clk,        // Single-bit input\n    input  wire       rst_n,      // Active-low reset\n    input  wire [7:0] data_in,    // 8-bit input bus\n    output wire       valid,      // Combinational output\n    output reg  [7:0] data_out    // Registered output\n);\n    // Internal declarations\n    // Logic description\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "wire [7:0] bus_a;          // 8-bit wire\nreg  [3:0] counter;        // 4-bit register\nreg        flag;           // 1-bit register\n\ninteger i;                 // 32-bit signed (simulation)\nparameter WIDTH = 8;       // Compile-time constant\nlocalparam IDLE = 2'b00;   // Local constant (not overridable)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "4'b1010          // 4-bit binary: 10\n8'hFF            // 8-bit hex: 255\n8'd200           // 8-bit decimal: 200\n16'o377          // 16-bit octal: 255\n32'hDEAD_BEEF   // Underscores for readability"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Arithmetic\na + b    a - b    a * b    a / b    a % b\n\n// Logical (result is 1-bit)\na && b   a || b   !a\n\n// Bitwise (result is same width as operands)\na & b    a | b    a ^ b    ~a    a ~^ b\n\n// Relational (result is 1-bit)\na == b   a != b   a < b    a > b   a <= b   a >= b\n\n// Shift\na << n   a >> n   a <<< n  a >>> n  (arithmetic shift)\n\n// Concatenation and replication\n{a, b, c}         // Concatenate\n{4{a}}            // Replicate a four times\n\n// Reduction (reduces vector to single bit)\n&a    |a    ^a    // AND, OR, XOR reduction\n~&a   ~|a   ~^a  // NAND, NOR, XNOR reduction\n\n// Conditional (ternary)\ncondition ? true_value : false_value"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "wire [7:0] sum;\nwire       carry;\n\nassign sum = a + b;\nassign carry = (a[7] & b[7]) | ((a[7] ^ b[7]) & sum[7]);\nassign mux_out = sel ? input_1 : input_0;"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "always @(*) begin          // Sensitivity: all inputs\n    if (sel == 2'b00)\n        y = a;\n    else if (sel == 2'b01)\n        y = b;\n    else\n        y = c;\nend"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "always @(posedge clk or negedge rst_n) begin\n    if (!rst_n)\n        q <= 8'b0;         // Async reset\n    else if (enable)\n        q <= d;            // Synchronous load\nend"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// BLOCKING (=): executes sequentially within the block\n// Use for COMBINATIONAL logic\nalways @(*) begin\n    temp = a & b;\n    result = temp | c;    // Uses new value of temp\nend\n\n// NON-BLOCKING (<=): all execute simultaneously\n// Use for SEQUENTIAL logic\nalways @(posedge clk) begin\n    q1 <= d;\n    q2 <= q1;    // Uses OLD value of q1 (shift register)\n    q3 <= q2;    // Uses OLD value of q2\nend"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module top_level(\n    input  wire       clk,\n    input  wire       rst_n,\n    input  wire [7:0] a, b,\n    output wire [8:0] result\n);\n    wire [7:0] sum;\n    wire       carry;\n    \n    // Named port connection (preferred)\n    adder_8bit u_adder(\n        .a(a),\n        .b(b),\n        .cin(1'b0),\n        .sum(sum),\n        .cout(carry)\n    );\n    \n    assign result = {carry, sum};\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module ripple_adder #(parameter N = 8)(\n    input  wire [N-1:0] a, b,\n    input  wire         cin,\n    output wire [N-1:0] sum,\n    output wire         cout\n);\n    wire [N:0] carry;\n    assign carry[0] = cin;\n    assign cout = carry[N];\n    \n    genvar i;\n    generate\n        for (i = 0; i < N; i = i + 1) begin : fa_chain\n            full_adder fa(\n                .a(a[i]), .b(b[i]), .cin(carry[i]),\n                .sum(sum[i]), .cout(carry[i+1])\n            );\n        end\n    endgenerate\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module testbench;\n    reg clk, rst_n;\n    reg [7:0] test_input;\n    wire [7:0] test_output;\n    \n    // Device under test\n    my_design uut(.clk(clk), .rst_n(rst_n), .din(test_input), .dout(test_output));\n    \n    // Clock generation\n    initial clk = 0;\n    always #5 clk = ~clk;  // 10ns period = 100MHz\n    \n    // Stimulus\n    initial begin\n        rst_n = 0;\n        test_input = 8'h00;\n        #20;\n        rst_n = 1;\n        #10;\n        test_input = 8'hAA;\n        #100;\n        $finish;\n    end\n    \n    // Monitoring\n    initial begin\n        $monitor(\"t=%0t rst=%b in=%h out=%h\", $time, rst_n, test_input, test_output);\n    end\nendmodule"
        ]
      ]
    }
