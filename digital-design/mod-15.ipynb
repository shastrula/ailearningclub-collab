        "# Digital Design - mod-15\n\n",
        "**Course:** digital-design\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Circuit:\n  S \u2500\u2500\u2192[NOR]\u2500\u2500\u2192 Q \u2500\u2500\u2510\n         \u2191           \u2502\n         \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2502\u2500\u2500\u2500\u2500 (feedback from Q')\n                     \u2502\n  R \u2500\u2500\u2192[NOR]\u2500\u2500\u2192 Q'\u2500\u2500\u2518\n         \u2191           \u2502\n         \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u2500\u2500 (feedback from Q)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "S' \u2500\u2500\u2192[NAND]\u2500\u2500\u2192 Q \u2500\u2500\u2510\n           \u2191           \u2502\n           \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2502\u2500\n                       \u2502\n  R' \u2500\u2500\u2192[NAND]\u2500\u2500\u2192 Q'\u2500\u2500\u2518\n           \u2191           \u2502\n           \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "S \u2500\u2500\u2192[AND]\u2500\u2500\u2192 S_internal \u2500\u2500\u2192[SR Latch]\u2500\u2500\u2192 Q\n  E \u2500\u2500\u2192     \u2502\n             \u2502\n  R \u2500\u2500\u2192[AND]\u2500\u2500\u2192 R_internal \u2500\u2500\u2192            \u2500\u2500\u2192 Q'\n  E \u2500\u2500\u2192"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "D \u2500\u2500\u2192\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2192 S \u2500\u2500\u2192[SR Latch]\u2500\u2500\u2192 Q\n       \u2502\n       \u2514\u2500\u2500\u2192[NOT]\u2500\u2500\u2192 R \u2500\u2500\u2192            \u2500\u2500\u2192 Q'\n  \n  E (Enable) gates both paths"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "E:    ____--------________--------____\nD:    __----____------__----__--------\nQ:    __--????----????--__--????------\n         \u2191 transparent  \u2191 transparent\n         (Q follows D when E=1)\n         \nWhen E=1: Q = D (transparent, output tracks input)\nWhen E=0: Q = last value of D before E went low (latched)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// SR Latch (NOR implementation)\nmodule sr_latch_nor(\n    input  wire S,\n    input  wire R,\n    output reg  Q,\n    output wire Qn\n);\n    assign Qn = ~Q;\n    \n    always @(S, R) begin\n        case ({S, R})\n            2'b01: Q = 1'b0;    // Reset\n            2'b10: Q = 1'b1;    // Set\n            2'b11: Q = 1'bx;    // Forbidden (undefined)\n            default: Q = Q;      // Hold\n        endcase\n    end\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// D Latch (level-sensitive)\nmodule d_latch(\n    input  wire D,\n    input  wire Enable,\n    output reg  Q,\n    output wire Qn\n);\n    assign Qn = ~Q;\n    \n    always @(Enable, D) begin\n        if (Enable)\n            Q = D;      // Transparent: output follows input\n        // else: Q retains value (latched)\n    end\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Gated SR Latch\nmodule gated_sr_latch(\n    input  wire S,\n    input  wire R,\n    input  wire E,\n    output reg  Q\n);\n    always @(S, R, E) begin\n        if (E) begin\n            case ({S, R})\n                2'b01: Q = 1'b0;\n                2'b10: Q = 1'b1;\n                2'b11: Q = 1'bx;\n                default: Q = Q;\n            endcase\n        end\n    end\nendmodule"
        ]
      ]
    }
  ],
