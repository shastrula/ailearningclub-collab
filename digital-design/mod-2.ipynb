          "python",
          "(d_n d_{n-1} ... d_1 d_0 . d_{-1} d_{-2} ...)_b\n\nValue = d_n \u00d7 b^n + d_{n-1} \u00d7 b^{n-1} + ... + d_0 \u00d7 b^0 + d_{-1} \u00d7 b^{-1} + ..."
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Position:  7   6   5   4   3   2   1   0\nBits:      1   0   1   1   0   1   0   1\nWeight:   128  64  32  16   8   4   2   1\n\nValue = 128 + 0 + 32 + 16 + 0 + 4 + 0 + 1 = 181"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Binary:  1  0  1  1  0  1  1  0  1\nGroup:  (001)(011)(011)(001)    \u2190 group from right, pad left with zeros\nOctal:    1    3    3    1      \u2190 read each group\n\nResult: 101101101\u2082 = 1331\u2088"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Binary:  1  0  1  1  0  1  0  1  1  1  0  0\nGroup:  (1011)(0101)(1100)    \u2190 group from right in sets of 4\nHex:      B     5     C\n\nResult: 101101011100\u2082 = B5C\u2081\u2086"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "module number_systems;\n    reg [7:0] val_bin  = 8'b10110011;   // Binary: 179\n    reg [7:0] val_oct  = 8'o263;         // Octal: 179\n    reg [7:0] val_dec  = 8'd179;         // Decimal: 179\n    reg [7:0] val_hex  = 8'hB3;          // Hexadecimal: 179\n    \n    initial begin\n        $display(\"Binary:      %b\", val_bin);\n        $display(\"Octal:       %o\", val_oct);\n        $display(\"Decimal:     %d\", val_dec);\n        $display(\"Hexadecimal: %h\", val_hex);\n        // All display the same value: 179\n    end\nendmodule"
        ]
      ]
    },
