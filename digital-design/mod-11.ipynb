      "source": [
        "# Digital Design - mod-11\n\n",
        "**Course:** digital-design\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Sum   = A XOR B = A'B + AB'\nCarry = A AND B = AB"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Sum  = A XOR B XOR Cin\nCout = AB + Cin(A XOR B)\n     = AB + ACin + BCin  (majority function)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Half Adder 1: P = A XOR B,  G = AB\nHalf Adder 2: Sum = P XOR Cin,  C2 = P\u00b7Cin\nCout = G + C2 = AB + (A XOR B)\u00b7Cin"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "A3 B3      A2 B2      A1 B1      A0 B0\n        |  |       |  |       |  |       |  |\n       [FA3]------[FA2]------[FA1]------[FA0]---Cin\n        |  |       |  |       |  |       |  |\n      Cout S3      c2 S2      c1 S1      c0 S0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Gi = Ai \u00b7 Bi    (generate: carry created at position i)\nPi = Ai XOR Bi  (propagate: carry passes through position i)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "C0 = Cin\nC1 = G0 + P0\u00b7C0\nC2 = G1 + P1\u00b7G0 + P1\u00b7P0\u00b7C0\nC3 = G2 + P2\u00b7G1 + P2\u00b7P1\u00b7G0 + P2\u00b7P1\u00b7P0\u00b7C0\nC4 = G3 + P3\u00b7G2 + P3\u00b7P2\u00b7G1 + P3\u00b7P2\u00b7P1\u00b7G0 + P3\u00b7P2\u00b7P1\u00b7P0\u00b7C0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "When M=0: Addition (A + B)\nWhen M=1: Subtraction (A - B = A + B' + 1)\n\nImplementation:\n- XOR each Bi with M: when M=1, this inverts B (one's complement)\n- Connect M to Cin: when M=1, adds 1 (completing two's complement)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "B3  B2  B1  B0\n    |   |   |   |\n   XOR XOR XOR XOR \u2190 M (subtract control)\n    |   |   |   |\n   [FA3]-[FA2]-[FA1]-[FA0]---M (Cin)\n    |       |       |       |\n   A3      A2      A1      A0"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Overflow = Cn XOR Cn-1\n\nWhere Cn is carry out of MSB, Cn-1 is carry into MSB."
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Full Adder - structural\nmodule full_adder(\n    input  wire a, b, cin,\n    output wire sum, cout\n);\n    assign sum  = a ^ b ^ cin;\n    assign cout = (a & b) | (cin & (a ^ b));\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// 4-bit Ripple-Carry Adder\nmodule ripple_carry_adder_4bit(\n    input  wire [3:0] A,\n    input  wire [3:0] B,\n    input  wire       Cin,\n    output wire [3:0] Sum,\n    output wire       Cout\n);\n    wire [3:1] carry;\n    \n    full_adder fa0(.a(A[0]), .b(B[0]), .cin(Cin),      .sum(Sum[0]), .cout(carry[1]));\n    full_adder fa1(.a(A[1]), .b(B[1]), .cin(carry[1]), .sum(Sum[1]), .cout(carry[2]));\n    full_adder fa2(.a(A[2]), .b(B[2]), .cin(carry[2]), .sum(Sum[2]), .cout(carry[3]));\n    full_adder fa3(.a(A[3]), .b(B[3]), .cin(carry[3]), .sum(Sum[3]), .cout(Cout));\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// 4-bit Adder-Subtractor\nmodule adder_subtractor_4bit(\n    input  wire [3:0] A,\n    input  wire [3:0] B,\n    input  wire       Mode,     // 0=Add, 1=Subtract\n    output wire [3:0] Result,\n    output wire       Cout,\n    output wire       Overflow\n);\n    wire [3:0] B_modified;\n    wire carry_out;\n    wire [3:1] carry;\n    \n    // XOR B with Mode: inverts B when subtracting\n    assign B_modified = B ^ {4{Mode}};\n    \n    // Ripple carry adder with Mode as Cin\n    full_adder fa0(.a(A[0]), .b(B_modified[0]), .cin(Mode),     .sum(Result[0]), .cout(carry[1]));\n    full_adder fa1(.a(A[1]), .b(B_modified[1]), .cin(carry[1]), .sum(Result[1]), .cout(carry[2]));\n    full_adder fa2(.a(A[2]), .b(B_modified[2]), .cin(carry[2]), .sum(Result[2]), .cout(carry[3]));\n    full_adder fa3(.a(A[3]), .b(B_modified[3]), .cin(carry[3]), .sum(Result[3]), .cout(Cout));\n    \n    // Overflow detection\n    assign Overflow = carry[3] ^ Cout;\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Behavioral n-bit adder (simpler, synthesizer optimizes)\nmodule adder_nbits #(parameter N = 8)(\n    input  wire [N-1:0] A,\n    input  wire [N-1:0] B,\n    input  wire         Cin,\n    output wire [N-1:0] Sum,\n    output wire         Cout\n);\n    assign {Cout, Sum} = A + B + Cin;\nendmodule"
        ]
      ]
    }
