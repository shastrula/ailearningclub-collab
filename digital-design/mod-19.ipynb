        "# Digital Design - mod-19\n\n",
        "**Course:** digital-design\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Inputs\n               \u2502\n               \u25bc\n    \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n    \u2502  Next-State     \u2502\n    \u2502  Logic          \u2502\u2500\u2500\u2192 Next State\n    \u2502  (Combinational)\u2502\n    \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n               \u2191\n         Current State\n               \u2502\n    \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n    \u2502  State Register \u2502\u2190\u2500\u2500 CLK\n    \u2502  (Flip-Flops)   \u2502\n    \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n               \u2502\n         Current State\n               \u2502\n               \u25bc\n    \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n    \u2502  Output Logic   \u2502\n    \u2502  (Combinational)\u2502\u2500\u2500\u2192 Outputs\n    \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n\nKey: Outputs depend ONLY on current state (no direct path from inputs to outputs)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "States:\n  S0: Initial state (no relevant bits received)\n  S1: Received \"1\"\n  S2: Received \"10\"\n  S3: Received \"101\" (output = 1)\n\nState diagram:\n  S0 --1--> S1 --0--> S2 --1--> S3\n  S0 --0--> S0                     \u2502\n  S1 --1--> S1              (output=1)\n  S2 --0--> S0                     \u2502\n  S3 --0--> S2  (overlap: \"101\" \u2192 \"10\" already received)\n  S3 --1--> S1"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "S0 = 00\nS1 = 01\nS2 = 10\nS3 = 11"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Q1_next = Q0\u00b7X' + Q1\u00b7Q0'\u00b7X  (from K-map simplification)\nQ0_next = X"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Output = Q1 \u00b7 Q0  (only in state S3 = 11)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Moore FSM: Sequence detector for \"101\"\nmodule sequence_detector_101(\n    input  wire clk,\n    input  wire rst_n,\n    input  wire x,\n    output reg  detected\n);\n    // State encoding\n    localparam S0 = 2'b00;  // Initial\n    localparam S1 = 2'b01;  // Got \"1\"\n    localparam S2 = 2'b10;  // Got \"10\"\n    localparam S3 = 2'b11;  // Got \"101\" - output 1\n    \n    reg [1:0] state, next_state;\n    \n    // State register (sequential)\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            state <= S0;\n        else\n            state <= next_state;\n    end\n    \n    // Next-state logic (combinational)\n    always @(*) begin\n        case (state)\n            S0: next_state = x ? S1 : S0;\n            S1: next_state = x ? S1 : S2;\n            S2: next_state = x ? S3 : S0;\n            S3: next_state = x ? S1 : S2;\n            default: next_state = S0;\n        endcase\n    end\n    \n    // Output logic (Moore: depends only on state)\n    always @(*) begin\n        detected = (state == S3);\n    end\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Moore FSM with one-hot encoding\nmodule fsm_onehot(\n    input  wire clk,\n    input  wire rst_n,\n    input  wire x,\n    output wire detected\n);\n    reg [3:0] state;\n    \n    localparam S0 = 4'b0001;\n    localparam S1 = 4'b0010;\n    localparam S2 = 4'b0100;\n    localparam S3 = 4'b1000;\n    \n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            state <= S0;\n        else begin\n            case (1'b1)  // synthesis parallel_case\n                state[0]: state <= x ? S1 : S0;\n                state[1]: state <= x ? S1 : S2;\n                state[2]: state <= x ? S3 : S0;\n                state[3]: state <= x ? S1 : S2;\n                default:  state <= S0;\n            endcase\n        end\n    end\n    \n    assign detected = state[3];  // One-hot: simple bit check\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Testbench for sequence detector\nmodule test_seq_det;\n    reg clk, rst_n, x;\n    wire detected;\n    \n    sequence_detector_101 uut(.*);\n    \n    initial clk = 0;\n    always #5 clk = ~clk;\n    \n    initial begin\n        rst_n = 0; x = 0;\n        @(posedge clk) rst_n = 1;\n        \n        // Feed sequence: 1 0 1 0 1 1 0 1\n        @(posedge clk) x = 1;\n        @(posedge clk) x = 0;\n        @(posedge clk) x = 1;  // Should detect here (next clock)\n        @(posedge clk) x = 0;\n        @(posedge clk) x = 1;  // Should detect (overlapping)\n        @(posedge clk) x = 1;\n        @(posedge clk) x = 0;\n        @(posedge clk) x = 1;  // Should detect\n        @(posedge clk);\n        \n        $finish;\n    end\nendmodule"
        ]
      ]
    }
