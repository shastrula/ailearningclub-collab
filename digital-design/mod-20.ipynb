          "python",
          "Inputs \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n               \u2502                        \u2502\n               \u25bc                        \u25bc\n    \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510      \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n    \u2502  Next-State     \u2502      \u2502  Output Logic   \u2502\n    \u2502  Logic          \u2502      \u2502  (Combinational)\u2502\u2500\u2500\u2192 Outputs\n    \u2502  (Combinational)\u2502      \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n    \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518               \u2191\n               \u2191                      \u2502\n         Current State \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n               \u2502\n    \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n    \u2502  State Register \u2502\u2190\u2500\u2500 CLK\n    \u2502  (Flip-Flops)   \u2502\n    \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n\nKey: Outputs depend on BOTH current state AND inputs\n     (direct path from inputs to outputs)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Input arrives at time T:\n- Moore: Output changes at T+1 (next clock edge after state transition)\n- Mealy: Output changes at T (combinational path, same clock cycle)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "States needed: Only 3 (compared to 4 for Moore!)\n  S0: No relevant bits received\n  S1: Received \"1\"\n  S2: Received \"10\"\n\nTransitions (format: input/output):\n  S0 --0/0--> S0\n  S0 --1/0--> S1\n  S1 --0/0--> S2\n  S1 --1/0--> S1\n  S2 --0/0--> S0\n  S2 --1/1--> S1  \u2190 Output happens HERE (on the transition)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Input sequence: 1, 0, 1, 0, 1\n\nMoore (4 states):\nCLK:   _|\u203e|_|\u203e|_|\u203e|_|\u203e|_|\u203e|_|\u203e|_\nInput:    1   0   1   0   1\nState: S0 S1  S2  S3  S2  S3\nOutput: 0   0   0   1   0   1\n                    \u2191       \u2191\n              Detection delayed by 1 clock\n\nMealy (3 states):\nCLK:   _|\u203e|_|\u203e|_|\u203e|_|\u203e|_|\u203e|_|\u203e|_\nInput:    1   0   1   0   1\nState: S0 S1  S2  S1  S2  S1\nOutput: 0   0   1   0   1\n                \u2191       \u2191\n          Detected immediately when \"1\" arrives in S2"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "S_EVEN: Even number of 1s received so far\nS_ODD:  Odd number of 1s received so far\n\nTransitions:\n  S_EVEN --0/0--> S_EVEN\n  S_EVEN --1/1--> S_ODD   (output = new parity)\n  S_ODD  --0/1--> S_ODD\n  S_ODD  --1/0--> S_EVEN  (output = new parity)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Inputs\n               \u2502\n               \u25bc\n    \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n    \u2502  Output Logic   \u2502\u2500\u2500\u2192 [D-FF] \u2500\u2500\u2192 Registered Output\n    \u2502  (Combinational)\u2502        \u2191\n    \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518        CLK\n               \u2191\n         Current State"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Mealy FSM: Sequence detector for \"101\"\nmodule mealy_seq_det_101(\n    input  wire clk,\n    input  wire rst_n,\n    input  wire x,\n    output reg  detected\n);\n    localparam S0 = 2'b00;  // Initial\n    localparam S1 = 2'b01;  // Got \"1\"\n    localparam S2 = 2'b10;  // Got \"10\"\n    \n    reg [1:0] state, next_state;\n    \n    // State register\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n)\n            state <= S0;\n        else\n            state <= next_state;\n    end\n    \n    // Next-state logic (combinational)\n    always @(*) begin\n        case (state)\n            S0: next_state = x ? S1 : S0;\n            S1: next_state = x ? S1 : S2;\n            S2: next_state = x ? S1 : S0;\n            default: next_state = S0;\n        endcase\n    end\n    \n    // Output logic (Mealy: depends on state AND input)\n    always @(*) begin\n        case (state)\n            S2:     detected = x;   // Output 1 only in S2 with input=1\n            default: detected = 1'b0;\n        endcase\n    end\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Mealy with registered output (glitch-free)\nmodule mealy_registered_101(\n    input  wire clk,\n    input  wire rst_n,\n    input  wire x,\n    output reg  detected\n);\n    localparam S0 = 2'b00;\n    localparam S1 = 2'b01;\n    localparam S2 = 2'b10;\n    \n    reg [1:0] state, next_state;\n    reg next_detected;\n    \n    // State register + output register\n    always @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            state <= S0;\n            detected <= 1'b0;\n        end else begin\n            state <= next_state;\n            detected <= next_detected;  // Registered output\n        end\n    end\n    \n    // Next-state logic\n    always @(*) begin\n        case (state)\n            S0: next_state = x ? S1 : S0;\n            S1: next_state = x ? S1 : S2;\n            S2: next_state = x ? S1 : S0;\n            default: next_state = S0;\n        endcase\n    end\n    \n    // Mealy output logic\n    always @(*) begin\n        next_detected = (state == S2) & x;\n    end\nendmodule"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "verilog",
          "// Testbench comparing Moore and Mealy timing\nmodule test_moore_vs_mealy;\n    reg clk, rst_n, x;\n    wire moore_det, mealy_det;\n    \n    sequence_detector_101 moore_uut(.clk(clk), .rst_n(rst_n), .x(x), .detected(moore_det));\n    mealy_seq_det_101     mealy_uut(.clk(clk), .rst_n(rst_n), .x(x), .detected(mealy_det));\n    \n    initial clk = 0;\n    always #5 clk = ~clk;\n    \n    initial begin\n        rst_n = 0; x = 0;\n        @(posedge clk) rst_n = 1;\n        \n        @(posedge clk) x = 1;\n        @(posedge clk) x = 0;\n        @(posedge clk) x = 1;  // Mealy detects NOW, Moore detects NEXT cycle\n        @(posedge clk) x = 0;\n        @(posedge clk) x = 1;  // Another detection\n        @(posedge clk) x = 0;\n        @(posedge clk);\n        \n        $finish;\n    end\n    \n    initial begin\n        $monitor(\"t=%0t clk=%b x=%b | Moore=%b Mealy=%b\",\n                 $time, clk, x, moore_det, mealy_det);\n    end\nendmodule"
        ]
      ]
    }
