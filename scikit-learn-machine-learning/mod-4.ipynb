        [
          "python",
          "from sklearn.preprocessing import StandardScaler\nfrom sklearn.linear_model import LinearRegression\nimport pandas as pd\n\n# Create interpretable data\ndata = pd.DataFrame({\n    'age': [25, 35, 45, 55, 65],\n    'income': [30000, 50000, 70000, 90000, 110000],\n    'years_experience': [1, 5, 10, 20, 30]\n})\n\nX = data[['age', 'years_experience']]\ny = data['income']\n\nmodel = LinearRegression()\nmodel.fit(X, y)\n\nprint(f\"Intercept: ${model.intercept_:,.0f}\")\nfor feature, coef in zip(X.columns, model.coef_):\n    print(f\"{feature}: ${coef:,.0f} per unit increase\")\n\n# Interpretation: Each additional year of experience adds $coef to expected income\n# Each additional year of age adds $coef to expected income"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
