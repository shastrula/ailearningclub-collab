    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.decomposition import PCA\nfrom sklearn.datasets import load_iris\nimport matplotlib.pyplot as plt\n\nX, y = load_iris(return_X_y=True)\n\n# Fit PCA to reduce to 2 dimensions\npca = PCA(n_components=2)\nX_pca = pca.fit_transform(X)\n\nprint(f\"Original shape: {X.shape}\")\nprint(f\"Reduced shape: {X_pca.shape}\")\nprint(f\"Explained variance ratio: {pca.explained_variance_ratio_}\")\nprint(f\"Total variance retained: {pca.explained_variance_ratio_.sum():.3f}\")\n\n# Plot\nplt.figure(figsize=(8, 6))\ncolors = ['red', 'green', 'blue']\nfor i in range(3):\n    plt.scatter(X_pca[y == i, 0], X_pca[y == i, 1], label=f\"Class {i}\", c=colors[i])\nplt.xlabel(f\"PC1 ({pca.explained_variance_ratio_[0]:.1%})\")\nplt.ylabel(f\"PC2 ({pca.explained_variance_ratio_[1]:.1%})\")\nplt.legend()\nplt.show()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.decomposition import PCA\n\n# Fit PCA with all components\npca_full = PCA()\npca_full.fit(X)\n\n# Cumulative explained variance\ncumsum = np.cumsum(pca_full.explained_variance_ratio_)\n\n# Find number of components to explain 95% of variance\nn_components_95 = np.argmax(cumsum >= 0.95) + 1\nprint(f\"Components for 95% variance: {n_components_95}\")\n\n# Plot\nplt.figure(figsize=(10, 5))\nplt.plot(cumsum, 'bo-')\nplt.axhline(y=0.95, color='r', linestyle='--', label='95% variance')\nplt.axvline(x=n_components_95, color='g', linestyle='--', label=f'n={n_components_95}')\nplt.xlabel('Number of Components')\nplt.ylabel('Cumulative Explained Variance')\nplt.legend()\nplt.show()\n\n# Or use n_components='auto' (requires scikit-learn >= 0.24)\n# pca = PCA(n_components='auto', svd_solver='full')"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.decomposition import TruncatedSVD\nfrom sklearn.feature_extraction.text import TfidfVectorizer\n\n# Text data\ndocuments = [\n    \"machine learning is great\",\n    \"deep learning networks\",\n    \"machine learning and AI\",\n    \"neural networks for classification\"\n]\n\n# Convert to TF-IDF matrix (sparse)\ntfidf = TfidfVectorizer()\nX_sparse = tfidf.fit_transform(documents)\n\nprint(f\"Original sparse matrix shape: {X_sparse.shape}\")\nprint(f\"Sparsity: {1 - X_sparse.nnz / (X_sparse.shape[0] * X_sparse.shape[1]):.2%}\")\n\n# Apply TruncatedSVD\nsvd = TruncatedSVD(n_components=2)\nX_reduced = svd.fit_transform(X_sparse)\n\nprint(f\"Reduced shape: {X_reduced.shape}\")\nprint(f\"Explained variance: {svd.explained_variance_ratio_.sum():.3f}\")"
        ]
      ]
    },
