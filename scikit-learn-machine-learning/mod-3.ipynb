      "source": [
        [
          "python",
          "from sklearn.model_selection import cross_validate, GridSearchCV\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.datasets import load_iris\nimport numpy as np\n\nX, y = load_iris(return_X_y=True)\n\n# Outer CV: 5 folds for final evaluation\n# Inner CV: 3 folds for hyperparameter tuning\ndef nested_cv():\n    from sklearn.model_selection import KFold\n    outer_cv = KFold(n_splits=5, shuffle=True, random_state=42)\n    scores = []\n    \n    for train_idx, test_idx in outer_cv.split(X):\n        X_train_outer, X_test_outer = X[train_idx], X[test_idx]\n        y_train_outer, y_test_outer = y[train_idx], y[test_idx]\n        \n        # Inner CV for tuning\n        param_grid = {'max_depth': [3, 5, 10], 'n_estimators': [50, 100]}\n        inner_cv = KFold(n_splits=3, shuffle=True, random_state=42)\n        \n        grid = GridSearchCV(\n            RandomForestClassifier(random_state=42),\n            param_grid, cv=inner_cv\n        )\n        grid.fit(X_train_outer, y_train_outer)\n        \n        # Evaluate on outer test fold\n        score = grid.score(X_test_outer, y_test_outer)\n        scores.append(score)\n    \n    return scores\n\nscores = nested_cv()\nprint(f\"Nested CV scores: {scores}\")\nprint(f\"Mean: {np.mean(scores):.4f}, Std: {np.std(scores):.4f}\")"
        ]
      ]
    },
