          "python",
          "from sklearn.inspection import permutation_importance\n\nmodel = RandomForestClassifier(random_state=42)\nmodel.fit(X_train, y_train)\n\n# Feature importance (tree-based)\nimportances = model.feature_importances_\nfeature_names = load_breast_cancer().feature_names\n\nprint(\"Top 5 features (model-based):\")\nfor idx in np.argsort(importances)[-5:]:\n    print(f\"  {feature_names[idx]}: {importances[idx]:.4f}\")\n\n# Permutation importance (model-agnostic)\nresult = permutation_importance(model, X_test, y_test, n_repeats=10)\nprint(\"\\nTop 5 features (permutation):\")\nfor idx in np.argsort(result.importances_mean)[-5:]:\n    print(f\"  {feature_names[idx]}: {result.importances_mean[idx]:.4f}\")"
