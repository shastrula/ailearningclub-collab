          "python",
          "from sklearn.impute import SimpleImputer, KNNImputer\nimport numpy as np\n\n# Create data with missing values\nX_with_missing = X_train.copy()\nmask = np.random.rand(*X_with_missing.shape) < 0.1\nX_with_missing[mask] = np.nan\n\n# Strategy 1: Drop rows/columns\nX_dropped = pd.DataFrame(X_with_missing).dropna()\n\n# Strategy 2: Mean imputation\nimputer = SimpleImputer(strategy='mean')\nX_mean_imputed = imputer.fit_transform(X_with_missing)\n\n# Strategy 3: KNN imputation (better; uses similar samples)\nknn_imputer = KNNImputer(n_neighbors=5)\nX_knn_imputed = knn_imputer.fit_transform(X_with_missing)\n\n# Use in pipeline\npipeline = Pipeline([\n    ('imputation', KNNImputer(n_neighbors=5)),\n    ('scaler', StandardScaler()),\n    ('classifier', LogisticRegression(random_state=42))\n])"
