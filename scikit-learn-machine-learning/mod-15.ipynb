    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "class ModelValidator:\n    def __init__(self, model, X_train, X_test, y_train, y_test):\n        self.model = model\n        self.X_train, self.X_test = X_train, X_test\n        self.y_train, self.y_test = y_train, y_test\n    \n    def check_train_test_separation(self):\n        \"\"\"Ensure no leakage\"\"\"\n        # Model should learn, not memorize\n        train_score = self.model.score(self.X_train, self.y_train)\n        test_score = self.model.score(self.X_test, self.y_test)\n        print(f\"Train: {train_score:.3f}, Test: {test_score:.3f}\")\n        \n        if train_score - test_score > 0.1:\n            print(\"WARNING: Large gap suggests overfitting\")\n    \n    def check_feature_engineering(self):\n        \"\"\"Verify features make sense\"\"\"\n        print(f\"Input shape: {self.X_train.shape}\")\n        print(f\"No NaN values: {not np.isnan(self.X_train).any()}\")\n        print(f\"No infinite values: {not np.isinf(self.X_train).any()}\")\n    \n    def check_calibration(self):\n        \"\"\"Are probabilities reliable?\"\"\"\n        from sklearn.calibration import calibration_curve\n        \n        y_pred_proba = self.model.predict_proba(self.X_test)[:, 1]\n        prob_true, prob_pred = calibration_curve(self.y_test, y_pred_proba, n_bins=10)\n        \n        # If prob_true \u2248 prob_pred, model is well-calibrated\n        print(f\"Calibration error: {np.mean(np.abs(prob_true - prob_pred)):.3f}\")\n\n# Use\nvalidator = ModelValidator(model, X_train, X_test, y_train, y_test)\nvalidator.check_train_test_separation()\nvalidator.check_feature_engineering()\nvalidator.check_calibration()"
        ]
      ]
