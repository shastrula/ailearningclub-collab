        [
          "python",
          "from scipy.stats import ks_2samp\nimport numpy as np\n\ndef detect_data_drift(reference_data, current_data, threshold=0.05):\n    \"\"\"\n    Use Kolmogorov-Smirnov test to detect univariate drift.\n    Returns True if drift is detected (p-value < threshold).\n    \"\"\"\n    drifts = []\n    for i in range(reference_data.shape[1]):\n        statistic, p_value = ks_2samp(reference_data[:, i], current_data[:, i])\n        drifts.append((i, p_value < threshold))\n    \n    return drifts\n\n# Example: Training data vs. recent production data\nX_train_sample = X_train[:100]  # Reference distribution\nX_recent = X_test[:50]          # Recent production data\n\ndrifts = detect_data_drift(X_train_sample, X_recent, threshold=0.05)\n\nprint(\"Data drift detection results:\")\nfor feature_idx, has_drift in drifts:\n    status = \"DRIFT DETECTED\" if has_drift else \"OK\"\n    print(f\"  Feature {feature_idx}: {status}\")\n\n# Concept drift: track model performance over time\ndef monitor_concept_drift(y_true, y_pred, window_size=100):\n    \"\"\"Monitor model performance in rolling windows.\"\"\"\n    n_windows = len(y_true) // window_size\n    accuracies = []\n    \n    for i in range(n_windows):\n        start_idx = i * window_size\n        end_idx = (i + 1) * window_size\n        window_acc = (y_true[start_idx:end_idx] == y_pred[start_idx:end_idx]).mean()\n        accuracies.append(window_acc)\n    \n    return accuracies\n\n# Simulate predictions over time\ny_pred_stream = np.array([y_test[i % len(y_test)] for i in range(1000)])\ny_true_stream = np.array([y_test[i % len(y_test)] for i in range(1000)])\n\naccuracies = monitor_concept_drift(y_true_stream, y_pred_stream, window_size=100)\nprint(f\"\\nConcept drift monitoring (window accuracy):\")\nprint(f\"  Window accuracies: {[f'{acc:.3f}' for acc in accuracies]}\")\n\nif min(accuracies) < 0.8 and max(accuracies) > 0.9:\n    print(\"  \u26a0 Significant drift detected: retraining recommended\")"
        ]
      ]
    },
