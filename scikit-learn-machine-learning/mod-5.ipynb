          "python",
          "from sklearn.tree import DecisionTreeClassifier\nimport pandas as pd\n\n# Simple dataset with interpretable features\ndata = pd.DataFrame({\n    'age': [25, 35, 45, 55, 65, 28, 38, 48, 58, 68],\n    'income': [30000, 50000, 70000, 80000, 90000, 35000, 55000, 75000, 85000, 95000],\n    'purchased': [0, 0, 1, 1, 1, 0, 0, 1, 1, 1]\n})\n\nX = data[['age', 'income']]\ny = data['purchased']\n\ntree = DecisionTreeClassifier(max_depth=2, random_state=42)\ntree.fit(X, y)\n\n# Print decision rules\nfrom sklearn.tree import export_text\ntree_rules = export_text(tree, feature_names=['age', 'income'])\nprint(tree_rules)"
