          "python",
          "from sklearn.model_selection import GridSearchCV\n\nparam_grid = {\n    'feature_selection__k': [5, 10, 15, 20],\n    'model__C': [0.1, 1, 10]\n}\n\ngrid = GridSearchCV(\n    Pipeline([\n        ('feature_selection', SelectKBest(f_classif)),\n        ('model', LogisticRegression())\n    ]),\n    param_grid,\n    cv=5\n)\n\ngrid.fit(X, y)\nprint(f\"Best k: {grid.best_params_['feature_selection__k']}\")\nprint(f\"Best C: {grid.best_params_['model__C']}\")"
