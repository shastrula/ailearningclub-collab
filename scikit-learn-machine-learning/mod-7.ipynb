          "python",
          "from sklearn.feature_selection import SelectKBest, f_classif\n\nselected_features_by_fold = []\nfor train_idx, val_idx in KFold(5, shuffle=True).split(X):\n    X_train, y_train = X[train_idx], y[train_idx]\n    \n    selector = SelectKBest(f_classif, k=10)\n    selector.fit(X_train, y_train)\n    selected = selector.get_support()\n    selected_features_by_fold.append(selected)\n\n# Check stability: how many times was each feature selected?\nstability = sum(selected_features_by_fold) / len(selected_features_by_fold)\nprint(f\"Feature stability: {stability}\")  # All 1.0 = stable, varied = unstable"
