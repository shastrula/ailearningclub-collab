      "source": [
        "# Scikit Learn Machine Learning - mod-12\n\n",
        "**Course:** scikit-learn-machine-learning\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.compose import ColumnTransformer\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.linear_model import LogisticRegression\nimport pandas as pd\n\n# Create mixed-type data\ndata = pd.DataFrame({\n    'age': [25, 45, 35, 28],\n    'income': [50000, 120000, 80000, 60000],\n    'education': ['HS', 'BS', 'MS', 'HS'],\n    'employed': ['Yes', 'Yes', 'No', 'Yes']\n})\n\n# Define column groups\nnumeric_features = ['age', 'income']\ncategorical_features = ['education', 'employed']\n\n# Create preprocessor with ColumnTransformer\npreprocessor = ColumnTransformer(\n    transformers=[\n        ('num', StandardScaler(), numeric_features),\n        ('cat', OneHotEncoder(drop='first'), categorical_features)\n    ]\n)\n\n# Full pipeline\npipeline = Pipeline([\n    ('preprocessor', preprocessor),\n    ('classifier', LogisticRegression(random_state=42))\n])\n\n# Get X, y\nX = data.drop('employed', axis=1)\ny = (data['employed'] == 'Yes').astype(int)\n\n# Fit and predict\npipeline.fit(X, y)\npredictions = pipeline.predict(X)\nprint(f\"Predictions: {predictions}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.pipeline import FeatureUnion, Pipeline\nfrom sklearn.decomposition import PCA\nfrom sklearn.feature_selection import SelectKBest, f_classif\n\n# Create FeatureUnion combining PCA and feature selection\nfeature_union = FeatureUnion([\n    ('pca', PCA(n_components=2)),\n    ('selection', SelectKBest(f_classif, k=3))\n])\n\n# Pipeline: scale \u2192 combine features \u2192 classify\npipeline = Pipeline([\n    ('scaler', StandardScaler()),\n    ('features', feature_union),\n    ('classifier', LogisticRegression(random_state=42))\n])\n\nfrom sklearn.datasets import load_iris\nX, y = load_iris(return_X_y=True)\n\npipeline.fit(X, y)\npredictions = pipeline.predict(X)\nprint(f\"Predictions shape: {predictions.shape}\")\n\n# Check feature dimension\ntransformed_features = pipeline.named_steps['features'].transform(X[:1])\nprint(f\"Combined features: {transformed_features.shape}\")  # (1, 5) = 2 from PCA + 3 from selection"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.base import BaseEstimator, TransformerMixin\nimport numpy as np\n\nclass LogTransformer(BaseEstimator, TransformerMixin):\n    \"\"\"Apply log transformation to positive features\"\"\"\n    \n    def __init__(self, columns=None):\n        self.columns = columns\n    \n    def fit(self, X, y=None):\n        return self\n    \n    def transform(self, X):\n        X_copy = X.copy()\n        cols = self.columns if self.columns else range(X.shape[1])\n        for col in cols:\n            X_copy[:, col] = np.log1p(X_copy[:, col])\n        return X_copy\n\n# Use in pipeline\npipeline = Pipeline([\n    ('log_transform', LogTransformer(columns=[0, 1])),\n    ('scaler', StandardScaler()),\n    ('classifier', LogisticRegression(random_state=42))\n])\n\nX, y = load_iris(return_X_y=True)\npipeline.fit(X, y)\nprint(f\"Score: {pipeline.score(X, y):.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.preprocessing import FunctionTransformer\n\n# Define a function\ndef scale_by_max(X):\n    return X / X.max(axis=0)\n\n# Wrap as transformer\nscaler_func = FunctionTransformer(scale_by_max, validate=True)\n\n# Use in pipeline\npipeline = Pipeline([\n    ('custom_scale', scaler_func),\n    ('classifier', LogisticRegression(random_state=42))\n])\n\npipeline.fit(X, y)\nprint(f\"Score: {pipeline.score(X, y):.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.pipeline import Pipeline\nfrom tempfile import mkdtemp\nimport shutil\n\n# Create temporary cache directory\ncache_dir = mkdtemp()\n\n# Pipeline with caching\npipeline = Pipeline([\n    ('scaler', StandardScaler()),\n    ('pca', PCA(n_components=2)),\n    ('classifier', LogisticRegression(random_state=42))\n], memory=cache_dir)\n\n# First fit: transforms computed and cached\npipeline.fit(X, y)\n\n# Second fit: cached transforms reused (much faster)\npipeline.fit(X, y)\n\n# Clean up\nshutil.rmtree(cache_dir)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.pipeline import Pipeline\n\n# Only cache the PCA step\npipeline = Pipeline([\n    ('scaler', StandardScaler()),\n    ('pca', PCA(n_components=2)),\n    ('classifier', LogisticRegression(random_state=42))\n], memory=cache_dir)\n\n# During fit, PCA output is cached but scaler output is not\n# This saves memory while caching the expensive step"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from sklearn.compose import ColumnTransformer\nfrom sklearn.pipeline import Pipeline, FeatureUnion\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\nfrom sklearn.feature_selection import SelectKBest, f_classif\nfrom sklearn.decomposition import PCA\n\n# Assume data with numeric and categorical columns\nnumeric_features = ['age', 'income']\ncategorical_features = ['education']\n\n# Numeric preprocessing\nnumeric_transformer = Pipeline(steps=[\n    ('scaler', StandardScaler()),\n    ('features', FeatureUnion([\n        ('pca', PCA(n_components=1)),\n        ('selection', SelectKBest(f_classif, k=1))\n    ]))\n])\n\n# Categorical preprocessing\ncategorical_transformer = OneHotEncoder(drop='first', sparse_output=False)\n\n# Combine\npreprocessor = ColumnTransformer(\n    transformers=[\n        ('num', numeric_transformer, numeric_features),\n        ('cat', categorical_transformer, categorical_features)\n    ]\n)\n\n# Full pipeline\nfull_pipeline = Pipeline([\n    ('preprocessor', preprocessor),\n    ('classifier', LogisticRegression(random_state=42))\n])\n\n# This complex pipeline handles mixed data types with multiple feature engineering techniques"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
