          "java",
          "public interface WeatherService {\n    String getForecast(String city);\n}\n\npublic class RealWeatherService implements WeatherService {\n    @Override\n    public String getForecast(String city) {\n        System.out.println(\"Fetching weather from API for: \" + city);\n        return \"Sunny, 72F in \" + city;\n    }\n}\n\npublic class CachingWeatherProxy implements WeatherService {\n    private final WeatherService delegate;\n    private final Map<String, CacheEntry> cache = new HashMap<>();\n    private final long ttlMillis;\n\n    record CacheEntry(String value, long timestamp) {\n        boolean isExpired(long ttl) {\n            return System.currentTimeMillis() - timestamp > ttl;\n        }\n    }\n\n    public CachingWeatherProxy(WeatherService delegate, long ttlMillis) {\n        this.delegate = delegate;\n        this.ttlMillis = ttlMillis;\n    }\n\n    @Override\n    public String getForecast(String city) {\n        CacheEntry entry = cache.get(city);\n        if (entry != null && !entry.isExpired(ttlMillis)) {\n            System.out.println(\"Cache hit for: \" + city);\n            return entry.value();\n        }\n        String result = delegate.getForecast(city);\n        cache.put(city, new CacheEntry(result, System.currentTimeMillis()));\n        return result;\n    }\n}"
        ]
      ]
