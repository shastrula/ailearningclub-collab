          "java",
          "// Service interface\npublic interface ImageLoader {\n    byte[] load(String path);\n    int getWidth();\n    int getHeight();\n}\n\n// Real implementation - expensive to create\npublic class RealImage implements ImageLoader {\n    private final String path;\n    private byte[] data;\n    private int width;\n    private int height;\n\n    public RealImage(String path) {\n        this.path = path;\n        loadFromDisk(); // Expensive operation\n    }\n\n    private void loadFromDisk() {\n        System.out.println(\"Loading image from disk: \" + path);\n        this.data = new byte[1024 * 1024]; // Simulate large image\n        this.width = 1920;\n        this.height = 1080;\n    }\n\n    @Override\n    public byte[] load(String path) { return data; }\n    @Override\n    public int getWidth() { return width; }\n    @Override\n    public int getHeight() { return height; }\n}\n\n// Lazy-loading proxy\npublic class LazyImageProxy implements ImageLoader {\n    private final String path;\n    private RealImage realImage;\n\n    public LazyImageProxy(String path) {\n        this.path = path;\n        // Does NOT load the image yet\n    }\n\n    private RealImage getRealImage() {\n        if (realImage == null) {\n            realImage = new RealImage(path); // Load on first use\n        }\n        return realImage;\n    }\n\n    @Override\n    public byte[] load(String path) { return getRealImage().load(path); }\n    @Override\n    public int getWidth() { return getRealImage().getWidth(); }\n    @Override\n    public int getHeight() { return getRealImage().getHeight(); }\n}"
        ]
      ]
