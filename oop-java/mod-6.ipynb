          "java",
          "public class AnimalShelter {\n    public Animal adopt() {\n        return new Animal(\"Unknown\");\n    }\n}\n\npublic class DogShelter extends AnimalShelter {\n    @Override\n    public Dog adopt() {  // Returns Dog instead of Animal - valid!\n        return new Dog(\"Mixed Breed\");\n    }\n}"
