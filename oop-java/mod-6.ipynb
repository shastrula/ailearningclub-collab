          "java",
          "public class BadExample extends Notification {\n    public BadExample(String r, String m) { super(r, m); }\n\n    // BUG: Typo! This does NOT override send() - it creates a new method\n    public void sned() {\n        System.out.println(\"This never gets called polymorphically\");\n    }\n\n    // With @Override, the compiler catches the error immediately\n    // @Override\n    // public void sned() { } // COMPILE ERROR: method does not override\n}"
