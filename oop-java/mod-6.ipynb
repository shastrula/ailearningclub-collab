        [
          "java",
          "public class Parent {\n    public String process(String input) {\n        return input.toUpperCase();\n    }\n\n    protected void log(String msg) {\n        System.out.println(\"[LOG] \" + msg);\n    }\n\n    public final void critical() {\n        // Cannot be overridden - marked final\n    }\n}\n\npublic class Child extends Parent {\n    // VALID: Same signature, same or wider access\n    @Override\n    public String process(String input) {\n        return input.trim().toUpperCase();\n    }\n\n    // VALID: Widening access from protected to public\n    @Override\n    public void log(String msg) {\n        System.out.println(\"[CHILD-LOG] \" + msg);\n    }\n\n    // INVALID: Cannot narrow access (public to private)\n    // @Override\n    // private String process(String input) { } // COMPILE ERROR\n\n    // INVALID: Cannot override final methods\n    // @Override\n    // public void critical() { } // COMPILE ERROR\n}"
        ]
      ]
    },
