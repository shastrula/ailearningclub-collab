          "java",
          "// Core interfaces\npublic interface UserRepository {\n    void save(User user);\n    Optional<User> findById(String id);\n    Optional<User> findByEmail(String email);\n}\n\npublic interface PasswordHasher {\n    String hash(String password);\n    boolean verify(String password, String hash);\n}\n\npublic interface EventPublisher {\n    void publish(Object event);\n}\n\n// Service with injected dependencies\npublic class AuthenticationService {\n    private final UserRepository users;\n    private final PasswordHasher hasher;\n    private final EventPublisher events;\n\n    public AuthenticationService(UserRepository users,\n                                  PasswordHasher hasher,\n                                  EventPublisher events) {\n        this.users = users;\n        this.hasher = hasher;\n        this.events = events;\n    }\n\n    public User register(String email, String password, String name) {\n        if (users.findByEmail(email).isPresent()) {\n            throw new IllegalStateException(\"Email already registered: \" + email);\n        }\n\n        String hashedPassword = hasher.hash(password);\n        User user = new User(UUID.randomUUID().toString(), name, email, hashedPassword);\n        users.save(user);\n        events.publish(new UserRegistered(user.id(), email));\n        return user;\n    }\n\n    public Optional<User> authenticate(String email, String password) {\n        return users.findByEmail(email)\n            .filter(user -> hasher.verify(password, user.passwordHash()));\n    }\n}\n\nrecord User(String id, String name, String email, String passwordHash) {}\nrecord UserRegistered(String userId, String email) {}"
        ]
      ]
    },
