          "java",
          "// Testing is easy with DI\nclass AuthenticationServiceTest {\n    private Map<String, User> userStore;\n    private List<Object> publishedEvents;\n    private AuthenticationService auth;\n\n    @BeforeEach\n    void setUp() {\n        userStore = new HashMap<>();\n        publishedEvents = new ArrayList<>();\n\n        auth = new AuthenticationService(\n            new UserRepository() {\n                @Override public void save(User u) { userStore.put(u.id(), u); }\n                @Override public Optional<User> findById(String id) {\n                    return Optional.ofNullable(userStore.get(id));\n                }\n                @Override public Optional<User> findByEmail(String email) {\n                    return userStore.values().stream()\n                        .filter(u -> u.email().equals(email)).findFirst();\n                }\n            },\n            new PasswordHasher() {\n                @Override public String hash(String p) { return \"hashed_\" + p; }\n                @Override public boolean verify(String p, String h) {\n                    return h.equals(\"hashed_\" + p);\n                }\n            },\n            publishedEvents::add\n        );\n    }\n\n    @Test\n    void registerCreatesUser() {\n        User user = auth.register(\"alice@test.com\", \"password123\", \"Alice\");\n        assertEquals(\"Alice\", user.name());\n        assertEquals(1, userStore.size());\n        assertEquals(1, publishedEvents.size());\n    }\n\n    @Test\n    void authenticateWithCorrectPassword() {\n        auth.register(\"bob@test.com\", \"secret\", \"Bob\");\n        Optional<User> result = auth.authenticate(\"bob@test.com\", \"secret\");\n        assertTrue(result.isPresent());\n    }\n}"
        ]
      ]
