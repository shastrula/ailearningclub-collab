          "java",
          "// Starts simple...\npublic class Animal {\n    public void eat() { System.out.println(\"Eating\"); }\n    public void sleep() { System.out.println(\"Sleeping\"); }\n}\n\npublic class Bird extends Animal {\n    public void fly() { System.out.println(\"Flying\"); }\n}\n\npublic class Penguin extends Bird {\n    // Problem! Penguins cannot fly but inherit fly()\n    @Override\n    public void fly() {\n        throw new UnsupportedOperationException(\"Penguins cannot fly!\");\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "public interface MovementBehavior {\n    void move();\n}\n\npublic class FlyingBehavior implements MovementBehavior {\n    @Override\n    public void move() { System.out.println(\"Flying through the air\"); }\n}\n\npublic class SwimmingBehavior implements MovementBehavior {\n    @Override\n    public void move() { System.out.println(\"Swimming in water\"); }\n}\n\npublic class WalkingBehavior implements MovementBehavior {\n    @Override\n    public void move() { System.out.println(\"Walking on land\"); }\n}\n\npublic class Animal {\n    private final String name;\n    private final List<MovementBehavior> movements;\n\n    public Animal(String name, List<MovementBehavior> movements) {\n        this.name = name;\n        this.movements = List.copyOf(movements);\n    }\n\n    public void move() {\n        System.out.println(name + \" can:\");\n        movements.forEach(MovementBehavior::move);\n    }\n}"
        ]
      ]
