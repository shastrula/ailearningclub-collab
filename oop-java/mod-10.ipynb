      "outputs": [],
      "source": [
        [
          "java",
          "public interface MessageFormatter {\n    String format(String message, Map<String, String> context);\n}\n\npublic interface DeliveryChannel {\n    void deliver(String recipient, String formattedMessage);\n    boolean supports(String recipientType);\n}\n\npublic interface RetryPolicy {\n    boolean shouldRetry(int attemptNumber, Exception lastError);\n    long getDelayMillis(int attemptNumber);\n}\n\n// Concrete implementations\npublic class HtmlFormatter implements MessageFormatter {\n    @Override\n    public String format(String message, Map<String, String> context) {\n        var sb = new StringBuilder(\"<div class='notification'>\");\n        sb.append(\"<p>\").append(message).append(\"</p>\");\n        if (!context.isEmpty()) {\n            sb.append(\"<ul>\");\n            context.forEach((k, v) -> sb.append(\"<li>\").append(k).append(\": \").append(v).append(\"</li>\"));\n            sb.append(\"</ul>\");\n        }\n        sb.append(\"</div>\");\n        return sb.toString();\n    }\n}\n\npublic class ExponentialBackoff implements RetryPolicy {\n    private final int maxRetries;\n\n    public ExponentialBackoff(int maxRetries) {\n        this.maxRetries = maxRetries;\n    }\n\n    @Override\n    public boolean shouldRetry(int attempt, Exception lastError) {\n        return attempt < maxRetries;\n    }\n\n    @Override\n    public long getDelayMillis(int attempt) {\n        return (long) Math.pow(2, attempt) * 1000;\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
