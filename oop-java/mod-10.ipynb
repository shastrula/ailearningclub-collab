          "java",
          "// 1. There is a genuine \"is-a\" relationship with shared state\npublic abstract class HttpServlet {\n    public final void service(Request req, Response res) {\n        switch (req.getMethod()) {\n            case \"GET\" -> doGet(req, res);\n            case \"POST\" -> doPost(req, res);\n        }\n    }\n\n    protected abstract void doGet(Request req, Response res);\n    protected abstract void doPost(Request req, Response res);\n}\n\n// 2. Template Method pattern with controlled extension points\npublic abstract class TestCase {\n    public final void run() {\n        setUp();\n        try {\n            execute();\n        } finally {\n            tearDown();\n        }\n    }\n\n    protected void setUp() {}\n    protected abstract void execute();\n    protected void tearDown() {}\n}"
        ]
      ]
