          "java",
          "public class LoggingList<T> {\n    private final List<T> delegate;\n    private final List<String> log = new ArrayList<>();\n\n    public LoggingList(List<T> delegate) {\n        this.delegate = delegate;\n    }\n\n    public void add(T item) {\n        log.add(\"Added: \" + item);\n        delegate.add(item);\n    }\n\n    public boolean remove(T item) {\n        log.add(\"Removed: \" + item);\n        return delegate.remove(item);\n    }\n\n    public T get(int index) {\n        return delegate.get(index);\n    }\n\n    public int size() {\n        return delegate.size();\n    }\n\n    public List<String> getLog() {\n        return List.copyOf(log);\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "// FRAGILE: If ArrayList's addAll() changes to not call add(),\n// our count breaks\npublic class CountingList<T> extends ArrayList<T> {\n    private int addCount = 0;\n\n    @Override\n    public boolean add(T item) {\n        addCount++;\n        return super.add(item);\n    }\n\n    @Override\n    public boolean addAll(Collection<? extends T> c) {\n        addCount += c.size();\n        return super.addAll(c); // May call add() internally - double count!\n    }\n}"
        ]
      ]
    },
    {
