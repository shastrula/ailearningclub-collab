      "source": [
        [
          "java",
          "public class NotificationService {\n    private final MessageFormatter formatter;\n    private final List<DeliveryChannel> channels;\n    private final RetryPolicy retryPolicy;\n\n    public NotificationService(MessageFormatter formatter,\n                               List<DeliveryChannel> channels,\n                               RetryPolicy retryPolicy) {\n        this.formatter = formatter;\n        this.channels = List.copyOf(channels);\n        this.retryPolicy = retryPolicy;\n    }\n\n    public void notify(String recipient, String message, Map<String, String> context) {\n        String formatted = formatter.format(message, context);\n\n        for (DeliveryChannel channel : channels) {\n            if (channel.supports(recipient)) {\n                deliverWithRetry(channel, recipient, formatted);\n            }\n        }\n    }\n\n    private void deliverWithRetry(DeliveryChannel channel, String recipient, String message) {\n        int attempt = 0;\n        while (true) {\n            try {\n                channel.deliver(recipient, message);\n                return;\n            } catch (Exception e) {\n                attempt++;\n                if (!retryPolicy.shouldRetry(attempt, e)) {\n                    System.err.println(\"Delivery failed after \" + attempt + \" attempts\");\n                    return;\n                }\n            }\n        }\n    }\n}"
        ]
      ]
    },
