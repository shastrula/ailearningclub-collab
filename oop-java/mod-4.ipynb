          "java",
          "class TaxCalculator {\n    double calculateTax(double amount, String state) {\n        return switch (state) {\n            case \"CA\" -> amount * 0.0725;\n            case \"TX\" -> amount * 0.0625;\n            default -> amount * 0.05;\n        };\n    }\n}\n\npublic class BillingService {\n    private final TaxCalculator taxCalc = new TaxCalculator();\n\n    public double calculateTotal(double subtotal, String state) {\n        double tax = taxCalc.calculateTax(subtotal, state);\n        return subtotal + tax;\n    }\n}"
        ]
      ]
