        [
          "java",
          "public class EventSchedule {\n    private final String eventName;\n    private final List<LocalDateTime> sessions;\n\n    public EventSchedule(String eventName, List<LocalDateTime> sessions) {\n        this.eventName = eventName;\n        this.sessions = new ArrayList<>(sessions);\n    }\n\n    public List<LocalDateTime> getSessions() {\n        return List.copyOf(sessions);\n    }\n\n    public void addSession(LocalDateTime dateTime) {\n        if (dateTime.isBefore(LocalDateTime.now())) {\n            throw new IllegalArgumentException(\"Cannot schedule in the past\");\n        }\n        sessions.add(dateTime);\n    }\n}"
        ]
      ]
