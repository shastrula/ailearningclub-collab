          "java",
          "public enum DayOfWeek {\n    MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY;\n\n    public boolean isWeekend() {\n        return this == SATURDAY || this == SUNDAY;\n    }\n\n    public boolean isWeekday() {\n        return !isWeekend();\n    }\n}"
