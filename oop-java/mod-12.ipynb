        [
          "java",
          "public sealed class Expression\n    permits Literal, Variable, BinaryOp, UnaryOp {\n\n    public abstract double evaluate(Map<String, Double> variables);\n}\n\npublic final class Literal extends Expression {\n    private final double value;\n\n    public Literal(double value) { this.value = value; }\n\n    @Override\n    public double evaluate(Map<String, Double> variables) {\n        return value;\n    }\n}\n\npublic final class Variable extends Expression {\n    private final String name;\n\n    public Variable(String name) { this.name = name; }\n\n    @Override\n    public double evaluate(Map<String, Double> variables) {\n        if (!variables.containsKey(name)) {\n            throw new IllegalArgumentException(\"Undefined variable: \" + name);\n        }\n        return variables.get(name);\n    }\n}\n\npublic final class BinaryOp extends Expression {\n    private final Expression left;\n    private final Expression right;\n    private final Operation op;\n\n    public BinaryOp(Expression left, Operation op, Expression right) {\n        this.left = left;\n        this.op = op;\n        this.right = right;\n    }\n\n    @Override\n    public double evaluate(Map<String, Double> variables) {\n        return op.apply(left.evaluate(variables), right.evaluate(variables));\n    }\n}\n\npublic final class UnaryOp extends Expression {\n    private final Expression operand;\n    private final UnaryOperator<Double> op;\n\n    public UnaryOp(Expression operand, UnaryOperator<Double> op) {\n        this.operand = operand;\n        this.op = op;\n    }\n\n    @Override\n    public double evaluate(Map<String, Double> variables) {\n        return op.apply(operand.evaluate(variables));\n    }\n}"
        ]
      ]
    },
