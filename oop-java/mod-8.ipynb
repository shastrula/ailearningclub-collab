          "java",
          "public abstract class Document {\n    private String title;\n    private String author;\n    private LocalDateTime createdAt;\n\n    public Document(String title, String author) {\n        this.title = title;\n        this.author = author;\n        this.createdAt = LocalDateTime.now();\n    }\n\n    // Abstract methods - subclasses MUST implement\n    public abstract String render();\n    public abstract int getWordCount();\n\n    // Concrete methods - shared behavior\n    public String getMetadata() {\n        return String.format(\"Title: %s | Author: %s | Created: %s\",\n            title, author, createdAt.toLocalDate());\n    }\n\n    public String getTitle() { return title; }\n    public String getAuthor() { return author; }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "public class MarkdownDocument extends Document {\n    private String content;\n\n    public MarkdownDocument(String title, String author, String content) {\n        super(title, author);\n        this.content = content;\n    }\n\n    @Override\n    public String render() {\n        return content\n            .replaceAll(\"\\\\*\\\\*(.*?)\\\\*\\\\*\", \"<strong>$1</strong>\")\n            .replaceAll(\"\\\\*(.*?)\\\\*\", \"<em>$1</em>\")\n            .replaceAll(\"# (.*)\", \"<h1>$1</h1>\");\n    }\n\n    @Override\n    public int getWordCount() {\n        return content.split(\"\\\\s+\").length;\n    }\n}\n\npublic class SpreadsheetDocument extends Document {\n    private String[][] cells;\n\n    public SpreadsheetDocument(String title, String author, String[][] cells) {\n        super(title, author);\n        this.cells = cells;\n    }\n\n    @Override\n    public String render() {\n        var sb = new StringBuilder(\"<table>\");\n        for (String[] row : cells) {\n            sb.append(\"<tr>\");\n            for (String cell : row) {\n                sb.append(\"<td>\").append(cell).append(\"</td>\");\n            }\n            sb.append(\"</tr>\");\n        }\n        sb.append(\"</table>\");\n        return sb.toString();\n    }\n\n    @Override\n    public int getWordCount() {\n        int count = 0;\n        for (String[] row : cells) {\n            for (String cell : row) {\n                count += cell.split(\"\\\\s+\").length;\n            }\n        }\n        return count;\n    }\n}"
        ]
      ]
    },
