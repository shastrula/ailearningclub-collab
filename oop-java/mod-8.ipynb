          "java",
          "public abstract class GameCharacter {\n    private String name;\n    private int health;\n    private int maxHealth;\n    private int level;\n\n    public GameCharacter(String name, int maxHealth) {\n        this.name = name;\n        this.maxHealth = maxHealth;\n        this.health = maxHealth;\n        this.level = 1;\n    }\n\n    // Abstract - each character attacks differently\n    public abstract int attack();\n    public abstract String getCharacterClass();\n\n    // Concrete - shared behavior\n    public void takeDamage(int damage) {\n        int reduced = Math.max(0, damage - getDefense());\n        health = Math.max(0, health - reduced);\n        System.out.printf(\"%s takes %d damage (reduced from %d). HP: %d/%d%n\",\n            name, reduced, damage, health, maxHealth);\n    }\n\n    public void heal(int amount) {\n        health = Math.min(maxHealth, health + amount);\n        System.out.printf(\"%s heals for %d. HP: %d/%d%n\",\n            name, amount, health, maxHealth);\n    }\n\n    public boolean isAlive() { return health > 0; }\n\n    // Hook method - subclasses CAN override but do not have to\n    protected int getDefense() { return level; }\n\n    public String getName() { return name; }\n    public int getLevel() { return level; }\n\n    public void levelUp() {\n        level++;\n        maxHealth += 10;\n        health = maxHealth;\n    }\n}\n\npublic class Warrior extends GameCharacter {\n    private int strength;\n\n    public Warrior(String name) {\n        super(name, 120);\n        this.strength = 15;\n    }\n\n    @Override\n    public int attack() {\n        return strength + getLevel() * 2;\n    }\n\n    @Override\n    public String getCharacterClass() { return \"Warrior\"; }\n\n    @Override\n    protected int getDefense() {\n        return super.getDefense() + 5; // Extra armor\n    }\n}\n\npublic class Mage extends GameCharacter {\n    private int mana;\n\n    public Mage(String name) {\n        super(name, 80);\n        this.mana = 100;\n    }\n\n    @Override\n    public int attack() {\n        if (mana >= 20) {\n            mana -= 20;\n            return 30 + getLevel() * 3; // Powerful spell\n        }\n        return 5; // Weak staff hit\n    }\n\n    @Override\n    public String getCharacterClass() { return \"Mage\"; }\n}"
        ]
      ]
    }
