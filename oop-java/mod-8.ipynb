          "java",
          "// 1. Cannot instantiate abstract classes\n// Document doc = new Document(\"Test\", \"Author\"); // COMPILE ERROR\n\n// 2. Can have constructors (called by subclasses via super)\n// 3. Can have fields (both instance and static)\n// 4. Can have concrete methods\n// 5. Can have abstract methods (or none at all)\n// 6. If a class has any abstract method, the class must be abstract\n// 7. Subclass must implement ALL abstract methods or itself be abstract\n\npublic abstract class PartialImplementation extends Document {\n    public PartialImplementation(String title, String author) {\n        super(title, author);\n    }\n\n    @Override\n    public int getWordCount() {\n        return 0; // Implements one abstract method\n    }\n\n    // Still abstract because render() is not implemented\n    // Another subclass must implement render()\n}"
        ]
      ]
    },
