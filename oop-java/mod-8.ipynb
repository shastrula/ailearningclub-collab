        [
          "java",
          "public abstract class DataProcessor {\n    // Template method - defines the algorithm structure\n    public final void process(String source) {\n        var data = readData(source);\n        var validated = validate(data);\n        var transformed = transform(validated);\n        save(transformed);\n        System.out.println(\"Processing complete: \" + source);\n    }\n\n    // Steps that subclasses must implement\n    protected abstract List<String> readData(String source);\n    protected abstract List<String> validate(List<String> data);\n    protected abstract List<String> transform(List<String> data);\n    protected abstract void save(List<String> data);\n}\n\npublic class CsvProcessor extends DataProcessor {\n    @Override\n    protected List<String> readData(String source) {\n        System.out.println(\"Reading CSV from: \" + source);\n        return List.of(\"header,data\", \"row1,value1\", \"row2,value2\");\n    }\n\n    @Override\n    protected List<String> validate(List<String> data) {\n        return data.stream()\n            .filter(line -> line.contains(\",\"))\n            .toList();\n    }\n\n    @Override\n    protected List<String> transform(List<String> data) {\n        return data.stream()\n            .map(String::toUpperCase)\n            .toList();\n    }\n\n    @Override\n    protected void save(List<String> data) {\n        System.out.println(\"Saved \" + data.size() + \" CSV records\");\n    }\n}\n\npublic class JsonProcessor extends DataProcessor {\n    @Override\n    protected List<String> readData(String source) {\n        System.out.println(\"Reading JSON from: \" + source);\n        return List.of(\"{\\\"name\\\":\\\"Alice\\\"}\", \"{\\\"name\\\":\\\"Bob\\\"}\");\n    }\n\n    @Override\n    protected List<String> validate(List<String> data) {\n        return data.stream()\n            .filter(json -> json.startsWith(\"{\") && json.endsWith(\"}\"))\n            .toList();\n    }\n\n    @Override\n    protected List<String> transform(List<String> data) {\n        return data; // No transformation needed\n    }\n\n    @Override\n    protected void save(List<String> data) {\n        System.out.println(\"Saved \" + data.size() + \" JSON documents\");\n    }\n}"
        ]
      ]
    },
