          "java",
          "public class PassingDemo {\n    // Cannot change the caller's primitive\n    public static void tryToModify(int x) {\n        x = 999; // Only changes the local copy\n    }\n\n    // CAN modify the object the reference points to\n    public static void addPrefix(StringBuilder sb) {\n        sb.insert(0, \"Hello, \"); // Modifies the same object\n    }\n\n    // CANNOT make the caller's reference point elsewhere\n    public static void tryToReassign(StringBuilder sb) {\n        sb = new StringBuilder(\"New value\"); // Only changes local reference\n    }\n\n    public static void main(String[] args) {\n        int num = 42;\n        tryToModify(num);\n        System.out.println(num); // Still 42\n\n        StringBuilder greeting = new StringBuilder(\"World\");\n        addPrefix(greeting);\n        System.out.println(greeting); // \"Hello, World\"\n\n        tryToReassign(greeting);\n        System.out.println(greeting); // Still \"Hello, World\"\n    }\n}"
        ]
      ]
