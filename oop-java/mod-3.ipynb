        [
          "java",
          "public class Calculator {\n    private double lastResult;\n\n    // [access modifier] [other modifiers] [return type] [name]([parameters])\n    public double add(double a, double b) {\n        lastResult = a + b;\n        return lastResult;\n    }\n\n    // void means no return value\n    public void reset() {\n        lastResult = 0;\n    }\n\n    // Multiple return statements\n    public double absoluteValue(double number) {\n        if (number < 0) {\n            return -number;\n        }\n        return number;\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "public class ShoppingCart {\n    private List<CartItem> items = new ArrayList<>();\n    private String customerId;\n\n    public ShoppingCart(String customerId) {\n        this.customerId = customerId;\n    }\n\n    // Instance method \u2014 operates on this cart's items\n    public void addItem(String product, double price, int quantity) {\n        items.add(new CartItem(product, price, quantity));\n    }\n\n    public double getTotal() {\n        double total = 0;\n        for (CartItem item : items) {\n            total += item.price() * item.quantity();\n        }\n        return total;\n    }\n\n    public int getItemCount() {\n        return items.size();\n    }\n\n    public boolean isEmpty() {\n        return items.isEmpty();\n    }\n\n    // Method that returns the object itself for fluent chaining\n    public ShoppingCart withItem(String product, double price, int quantity) {\n        addItem(product, price, quantity);\n        return this;\n    }\n}\n\nrecord CartItem(String product, double price, int quantity) {}"
        ]
      ]
    },
