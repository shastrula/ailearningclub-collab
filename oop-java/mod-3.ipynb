          "java",
          "public class Logger {\n    private String context;\n\n    public Logger(String context) {\n        this.context = context;\n    }\n\n    // Overloaded log methods\n    public void log(String message) {\n        System.out.println(\"[\" + context + \"] \" + message);\n    }\n\n    public void log(String message, String level) {\n        System.out.println(\"[\" + context + \"][\" + level + \"] \" + message);\n    }\n\n    public void log(String message, String level, Throwable error) {\n        System.out.println(\"[\" + context + \"][\" + level + \"] \" + message);\n        error.printStackTrace(System.out);\n    }\n\n    public void log(int errorCode, String message) {\n        System.out.println(\"[\" + context + \"][ERROR-\" + errorCode + \"] \" + message);\n    }\n}"
        ]
      ]
    },
