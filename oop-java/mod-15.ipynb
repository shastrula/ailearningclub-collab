        [
          "java",
          "public class FlatMapDemo {\n    record Student(String name, List<String> courses) {}\n\n    public static void main(String[] args) {\n        List<Student> students = List.of(\n            new Student(\"Alice\", List.of(\"Math\", \"Physics\", \"CS\")),\n            new Student(\"Bob\", List.of(\"Math\", \"Chemistry\")),\n            new Student(\"Charlie\", List.of(\"CS\", \"Physics\", \"Biology\"))\n        );\n\n        // All unique courses\n        Set<String> allCourses = students.stream()\n            .flatMap(student -> student.courses().stream())\n            .collect(Collectors.toSet());\n        // [Math, Physics, CS, Chemistry, Biology]\n\n        // Students taking CS\n        List<String> csStudents = students.stream()\n            .filter(s -> s.courses().contains(\"CS\"))\n            .map(Student::name)\n            .toList();\n        // [Alice, Charlie]\n    }\n}"
        ]
      ]
