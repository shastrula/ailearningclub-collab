        [
          "java",
          "public class OrderAnalytics {\n    record Order(String customerId, double amount, LocalDate date) {}\n\n    public static void main(String[] args) {\n        List<Order> orders = List.of(\n            new Order(\"C1\", 150.0, LocalDate.of(2024, 1, 15)),\n            new Order(\"C2\", 200.0, LocalDate.of(2024, 1, 20)),\n            new Order(\"C1\", 75.0, LocalDate.of(2024, 2, 10)),\n            new Order(\"C3\", 300.0, LocalDate.of(2024, 2, 15)),\n            new Order(\"C2\", 125.0, LocalDate.of(2024, 3, 1))\n        );\n\n        // Summary statistics\n        DoubleSummaryStatistics stats = orders.stream()\n            .collect(Collectors.summarizingDouble(Order::amount));\n        System.out.printf(\"Count: %d, Sum: %.2f, Avg: %.2f, Max: %.2f%n\",\n            stats.getCount(), stats.getSum(), stats.getAverage(), stats.getMax());\n\n        // Total per customer sorted by total descending\n        orders.stream()\n            .collect(Collectors.groupingBy(\n                Order::customerId,\n                Collectors.summingDouble(Order::amount)))\n            .entrySet().stream()\n            .sorted(Map.Entry.<String, Double>comparingByValue().reversed())\n            .forEach(e -> System.out.printf(\"%s: $%.2f%n\", e.getKey(), e.getValue()));\n    }\n}"
        ]
      ]
    }
