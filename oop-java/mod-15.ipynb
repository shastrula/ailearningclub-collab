        [
          "java",
          "public class StreamOperations {\n    record Product(String name, String category, double price, int stock) {}\n\n    public static void main(String[] args) {\n        List<Product> products = List.of(\n            new Product(\"Laptop\", \"Electronics\", 999.99, 50),\n            new Product(\"Mouse\", \"Electronics\", 29.99, 200),\n            new Product(\"Desk\", \"Furniture\", 249.99, 30),\n            new Product(\"Chair\", \"Furniture\", 399.99, 45),\n            new Product(\"Monitor\", \"Electronics\", 449.99, 75),\n            new Product(\"Lamp\", \"Furniture\", 59.99, 120)\n        );\n\n        // Group by category\n        Map<String, List<Product>> byCategory = products.stream()\n            .collect(Collectors.groupingBy(Product::category));\n\n        // Average price by category\n        Map<String, Double> avgPriceByCategory = products.stream()\n            .collect(Collectors.groupingBy(\n                Product::category,\n                Collectors.averagingDouble(Product::price)\n            ));\n\n        // Most expensive product per category\n        Map<String, Optional<Product>> mostExpensive = products.stream()\n            .collect(Collectors.groupingBy(\n                Product::category,\n                Collectors.maxBy(Comparator.comparingDouble(Product::price))\n            ));\n\n        // Total inventory value\n        double totalValue = products.stream()\n            .mapToDouble(p -> p.price() * p.stock())\n            .sum();\n\n        // Partition: in stock vs out of stock\n        Map<Boolean, List<Product>> partitioned = products.stream()\n            .collect(Collectors.partitioningBy(p -> p.stock() > 50));\n    }\n}"
        ]
      ]
