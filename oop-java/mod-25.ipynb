        [
          "java",
          "public class LibraryService {\n    private final BookRepository bookRepo;\n    private final MemberRepository memberRepo;\n    private final LoanRepository loanRepo;\n    private final EventBus eventBus;\n\n    public LibraryService(BookRepository bookRepo, MemberRepository memberRepo,\n                          LoanRepository loanRepo, EventBus eventBus) {\n        this.bookRepo = bookRepo;\n        this.memberRepo = memberRepo;\n        this.loanRepo = loanRepo;\n        this.eventBus = eventBus;\n    }\n\n    public Loan borrowBook(String memberId, String isbn) {\n        Member member = memberRepo.findById(memberId)\n            .orElseThrow(() -> new IllegalArgumentException(\"Member not found: \" + memberId));\n\n        if (!member.canBorrow()) {\n            throw new MemberLimitExceededException(memberId, member.getMaxLoans());\n        }\n\n        Book book = bookRepo.findByIsbn(isbn)\n            .orElseThrow(() -> new IllegalArgumentException(\"Book not found: \" + isbn));\n\n        if (!book.isAvailable()) {\n            throw new BookNotAvailableException(isbn);\n        }\n\n        // Update book availability\n        bookRepo.save(book.checkOut());\n\n        // Create loan\n        int loanDays = switch (member.type()) {\n            case FACULTY -> 30;\n            case STUDENT -> 14;\n            case PUBLIC -> 21;\n        };\n\n        Loan loan = new Loan(\n            UUID.randomUUID().toString(),\n            memberId,\n            isbn,\n            LocalDate.now(),\n            LocalDate.now().plusDays(loanDays),\n            null,\n            LoanStatus.ACTIVE\n        );\n\n        Loan saved = loanRepo.save(loan);\n        eventBus.publish(new BookBorrowed(memberId, isbn, loan.dueDate()));\n        return saved;\n    }\n\n    public Loan returnBook(String loanId) {\n        Loan loan = loanRepo.findById(loanId)\n            .orElseThrow(() -> new LoanNotFoundException(loanId));\n\n        Book book = bookRepo.findByIsbn(loan.bookIsbn())\n            .orElseThrow(() -> new IllegalStateException(\"Book missing: \" + loan.bookIsbn()));\n\n        bookRepo.save(book.checkIn());\n        Loan returned = loanRepo.save(loan.markReturned());\n\n        eventBus.publish(new BookReturned(loan.memberId(), loan.bookIsbn(), loan.isOverdue()));\n        return returned;\n    }\n\n    public Member registerMember(String name, String email, MemberType type) {\n        if (memberRepo.findByEmail(email).isPresent()) {\n            throw new IllegalStateException(\"Email already registered: \" + email);\n        }\n\n        Member member = new Member(\n            UUID.randomUUID().toString(),\n            name, email, type,\n            LocalDate.now(),\n            List.of()\n        );\n\n        Member saved = memberRepo.save(member);\n        eventBus.publish(new MemberRegistered(saved.id(), name));\n        return saved;\n    }\n\n    public List<Book> searchBooks(String query) {\n        return bookRepo.search(query);\n    }\n\n    public LibraryStats getStatistics() {\n        long totalBooks = bookRepo.findAll().size();\n        long activeLoans = loanRepo.findActiveLoans().size();\n        long overdueLoans = loanRepo.findOverdueLoans().size();\n        return new LibraryStats(totalBooks, activeLoans, overdueLoans);\n    }\n}\n\npublic record LibraryStats(long totalBooks, long activeLoans, long overdueLoans) {}"
        ]
      ]
