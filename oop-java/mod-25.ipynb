          "java",
          "public record Book(\n    String isbn,\n    String title,\n    String author,\n    Genre genre,\n    int publishYear,\n    int totalCopies,\n    int availableCopies\n) {\n    public Book {\n        Objects.requireNonNull(isbn, \"ISBN required\");\n        Objects.requireNonNull(title, \"Title required\");\n        if (totalCopies < 0) throw new IllegalArgumentException(\"Copies cannot be negative\");\n    }\n\n    public boolean isAvailable() { return availableCopies > 0; }\n\n    public Book checkOut() {\n        if (!isAvailable()) throw new IllegalStateException(\"No copies available\");\n        return new Book(isbn, title, author, genre, publishYear, totalCopies, availableCopies - 1);\n    }\n\n    public Book checkIn() {\n        if (availableCopies >= totalCopies) throw new IllegalStateException(\"All copies already returned\");\n        return new Book(isbn, title, author, genre, publishYear, totalCopies, availableCopies + 1);\n    }\n}\n\npublic enum Genre { FICTION, NON_FICTION, SCIENCE, HISTORY, TECHNOLOGY, BIOGRAPHY }\n\npublic record Member(\n    String id,\n    String name,\n    String email,\n    MemberType type,\n    LocalDate joinDate,\n    List<Loan> activeLoans\n) {\n    public int getMaxLoans() {\n        return switch (type) {\n            case STUDENT -> 3;\n            case FACULTY -> 10;\n            case PUBLIC -> 5;\n        };\n    }\n\n    public boolean canBorrow() {\n        return activeLoans.size() < getMaxLoans();\n    }\n}\n\npublic enum MemberType { STUDENT, FACULTY, PUBLIC }\n\npublic record Loan(\n    String id,\n    String memberId,\n    String bookIsbn,\n    LocalDate borrowDate,\n    LocalDate dueDate,\n    LocalDate returnDate,\n    LoanStatus status\n) {\n    public boolean isOverdue() {\n        return status == LoanStatus.ACTIVE && LocalDate.now().isAfter(dueDate);\n    }\n\n    public Loan markReturned() {\n        return new Loan(id, memberId, bookIsbn, borrowDate, dueDate, LocalDate.now(), LoanStatus.RETURNED);\n    }\n}\n\npublic enum LoanStatus { ACTIVE, RETURNED, OVERDUE }"
        ]
      ]
