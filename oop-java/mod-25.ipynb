          "java",
          "public sealed class LibraryException extends RuntimeException\n    permits BookNotAvailableException, MemberLimitExceededException, LoanNotFoundException {\n\n    public LibraryException(String message) { super(message); }\n}\n\npublic final class BookNotAvailableException extends LibraryException {\n    public BookNotAvailableException(String isbn) {\n        super(\"Book not available: \" + isbn);\n    }\n}\n\npublic final class MemberLimitExceededException extends LibraryException {\n    public MemberLimitExceededException(String memberId, int max) {\n        super(\"Member %s has reached loan limit of %d\".formatted(memberId, max));\n    }\n}\n\npublic final class LoanNotFoundException extends LibraryException {\n    public LoanNotFoundException(String loanId) {\n        super(\"Loan not found: \" + loanId);\n    }\n}"
        ]
      ]
