          "java",
          "public class LibraryApplication {\n    public static void main(String[] args) {\n        // Composition root - wire all dependencies\n        var bookRepo = new InMemoryBookRepository();\n        var memberRepo = new InMemoryMemberRepository();\n        var loanRepo = new InMemoryLoanRepository();\n        var eventBus = new EventBus();\n\n        // Register event handlers\n        eventBus.subscribe(BookBorrowed.class, event ->\n            System.out.printf(\"Notification: Book %s borrowed, due %s%n\",\n                event.isbn(), event.dueDate()));\n        eventBus.subscribe(BookReturned.class, event ->\n            System.out.printf(\"Notification: Book %s returned%s%n\",\n                event.isbn(), event.wasOverdue() ? \" (was overdue!)\" : \"\"));\n        eventBus.subscribe(MemberRegistered.class, event ->\n            System.out.printf(\"Welcome email sent to %s%n\", event.name()));\n\n        // Create service\n        var library = new LibraryService(bookRepo, memberRepo, loanRepo, eventBus);\n\n        // Seed data\n        bookRepo.save(new Book(\"978-0134685991\", \"Effective Java\", \"Joshua Bloch\",\n            Genre.TECHNOLOGY, 2018, 3, 3));\n        bookRepo.save(new Book(\"978-0132350884\", \"Clean Code\", \"Robert C. Martin\",\n            Genre.TECHNOLOGY, 2008, 2, 2));\n        bookRepo.save(new Book(\"978-0596007126\", \"Head First Design Patterns\",\n            \"Eric Freeman\", Genre.TECHNOLOGY, 2004, 2, 2));\n\n        // Demo workflow\n        Member alice = library.registerMember(\"Alice\", \"alice@university.edu\", MemberType.STUDENT);\n        Loan loan = library.borrowBook(alice.id(), \"978-0134685991\");\n        System.out.println(\"Loan created: \" + loan.id());\n        System.out.println(\"Due: \" + loan.dueDate());\n\n        library.returnBook(loan.id());\n\n        var stats = library.getStatistics();\n        System.out.printf(\"Library: %d books, %d active loans, %d overdue%n\",\n            stats.totalBooks(), stats.activeLoans(), stats.overdueLoans());\n    }\n}"
        ]
