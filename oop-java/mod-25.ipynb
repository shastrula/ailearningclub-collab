          "java",
          "public sealed interface LibraryEvent permits BookBorrowed, BookReturned, MemberRegistered, LoanOverdue {}\n\npublic record BookBorrowed(String memberId, String isbn, LocalDate dueDate) implements LibraryEvent {}\npublic record BookReturned(String memberId, String isbn, boolean wasOverdue) implements LibraryEvent {}\npublic record MemberRegistered(String memberId, String name) implements LibraryEvent {}\npublic record LoanOverdue(String memberId, String isbn, long daysOverdue) implements LibraryEvent {}\n\n@FunctionalInterface\npublic interface EventListener<T extends LibraryEvent> {\n    void handle(T event);\n}\n\npublic class EventBus {\n    private final Map<Class<?>, List<EventListener<?>>> listeners = new HashMap<>();\n\n    public <T extends LibraryEvent> void subscribe(Class<T> type, EventListener<T> listener) {\n        listeners.computeIfAbsent(type, k -> new ArrayList<>()).add(listener);\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    public void publish(LibraryEvent event) {\n        var handlers = listeners.getOrDefault(event.getClass(), List.of());\n        for (var listener : handlers) {\n            ((EventListener<LibraryEvent>) listener).handle(event);\n        }\n    }\n}"
