        [
          "java",
          "public class Vehicle {\n    private String make;\n    private String model;\n    private int year;\n    private double fuelLevel;\n\n    public Vehicle(String make, String model, int year) {\n        this.make = make;\n        this.model = model;\n        this.year = year;\n        this.fuelLevel = 100.0;\n    }\n\n    public void start() {\n        System.out.println(getDescription() + \" engine started.\");\n    }\n\n    public void refuel(double amount) {\n        fuelLevel = Math.min(100.0, fuelLevel + amount);\n    }\n\n    public String getDescription() {\n        return year + \" \" + make + \" \" + model;\n    }\n\n    public double getFuelLevel() { return fuelLevel; }\n    protected void setFuelLevel(double level) { this.fuelLevel = level; }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "public class ElectricVehicle extends Vehicle {\n    private double batteryCapacity;\n    private double chargeLevel;\n\n    public ElectricVehicle(String make, String model, int year,\n                           double batteryCapacity) {\n        super(make, model, year);  // MUST call parent constructor\n        this.batteryCapacity = batteryCapacity;\n        this.chargeLevel = 100.0;\n    }\n\n    public void charge(double percentage) {\n        chargeLevel = Math.min(100.0, chargeLevel + percentage);\n        System.out.println(getDescription() + \" charged to \" + chargeLevel + \"%\");\n    }\n\n    public double getRange() {\n        return (chargeLevel / 100.0) * batteryCapacity * 4;\n    }\n}"
        ]
      ]
    },
    {
