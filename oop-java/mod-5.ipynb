          "java",
          "public class Shape {\n    private String color;\n    private boolean filled;\n\n    public Shape(String color, boolean filled) {\n        this.color = color;\n        this.filled = filled;\n    }\n\n    public String getColor() { return color; }\n    public boolean isFilled() { return filled; }\n}\n\npublic class Circle extends Shape {\n    private double radius;\n\n    public Circle(String color, boolean filled, double radius) {\n        super(color, filled); // Must be first statement\n        this.radius = radius;\n    }\n\n    public double getArea() {\n        return Math.PI * radius * radius;\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "public class LoggingCircle extends Circle {\n    public LoggingCircle(String color, double radius) {\n        super(color, true, radius);\n    }\n\n    @Override\n    public double getArea() {\n        double area = super.getArea(); // Call Circle's getArea()\n        System.out.println(\"Area calculated: \" + area);\n        return area;\n    }\n}"
        ]
      ]
