        [
          "java",
          "public class Main {\n    public static void main(String[] args) {\n        ElectricVehicle tesla = new ElectricVehicle(\"Tesla\", \"Model 3\", 2024, 75);\n        tesla.start();           // Inherited method\n        tesla.charge(20);        // Own method\n        System.out.println(\"Range: \" + tesla.getRange() + \" miles\");\n    }\n}"
        ]
