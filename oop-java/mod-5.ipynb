          "public class Animal {\n    private String species;\n\n    public Animal(String species) {\n        this.species = species;\n        System.out.println(\"Animal constructor: \" + species);\n    }\n\n    public String getSpecies() { return species; }\n}\n\npublic class Dog extends Animal {\n    private String breed;\n\n    public Dog(String breed) {\n        super(\"Canine\");\n        this.breed = breed;\n        System.out.println(\"Dog constructor: \" + breed);\n    }\n\n    public String getBreed() { return breed; }\n}\n\npublic class ServiceDog extends Dog {\n    private String task;\n\n    public ServiceDog(String breed, String task) {\n        super(breed);\n        this.task = task;\n        System.out.println(\"ServiceDog constructor: \" + task);\n    }\n}"
