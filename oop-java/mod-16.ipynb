          "// Throwable\n//   \u251c\u2500\u2500 Error (JVM problems - don't catch)\n//   \u2502     \u251c\u2500\u2500 OutOfMemoryError\n//   \u2502     \u2514\u2500\u2500 StackOverflowError\n//   \u2514\u2500\u2500 Exception\n//         \u251c\u2500\u2500 RuntimeException (unchecked)\n//         \u2502     \u251c\u2500\u2500 NullPointerException\n//         \u2502     \u251c\u2500\u2500 IllegalArgumentException\n//         \u2502     \u251c\u2500\u2500 IndexOutOfBoundsException\n//         \u2502     \u2514\u2500\u2500 ClassCastException\n//         \u2514\u2500\u2500 Checked exceptions\n//               \u251c\u2500\u2500 IOException\n//               \u251c\u2500\u2500 SQLException\n//               \u2514\u2500\u2500 FileNotFoundException"
