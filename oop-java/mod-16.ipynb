          "java",
          "public class ExceptionTypes {\n    // Checked: caller MUST handle or declare\n    public String fetchUrl(String url) throws IOException {\n        // If this fails, caller must deal with it\n        var connection = new URL(url).openConnection();\n        try (var stream = connection.getInputStream()) {\n            return new String(stream.readAllBytes());\n        }\n    }\n\n    // Unchecked: programmer error - fix the code, don't catch\n    public double divide(double a, double b) {\n        if (b == 0) {\n            throw new IllegalArgumentException(\"Divisor cannot be zero\");\n        }\n        return a / b;\n    }\n\n    // Unchecked: precondition violation\n    public void setAge(int age) {\n        if (age < 0 || age > 150) {\n            throw new IllegalArgumentException(\n                \"Age must be between 0 and 150, got: \" + age);\n        }\n    }\n}"
        ]
      ]
