          "java",
          "public class ExceptionBestPractices {\n    // 1. Be specific in what you catch\n    public void good() {\n        try {\n            riskyOperation();\n        } catch (FileNotFoundException e) {\n            // Handle missing file specifically\n        } catch (IOException e) {\n            // Handle other IO errors\n        }\n        // AVOID: catch (Exception e) - too broad\n    }\n\n    // 2. Don't use exceptions for control flow\n    public boolean isNumber(String s) {\n        // BAD:\n        // try { Integer.parseInt(s); return true; }\n        // catch (NumberFormatException e) { return false; }\n\n        // GOOD:\n        return s != null && s.matches(\"-?\\\\d+\");\n    }\n\n    // 3. Include context in exception messages\n    public void validateOrder(Order order) {\n        if (order.getItems().isEmpty()) {\n            throw new IllegalStateException(\n                \"Order \" + order.getId() + \" has no items. \" +\n                \"Customer: \" + order.getCustomerId());\n        }\n    }\n\n    // 4. Use try-with-resources for all AutoCloseable resources\n    // 5. Throw early, catch late\n    // 6. Never catch and silently ignore\n}"
        ]
