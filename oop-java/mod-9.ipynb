          "java",
          "public interface Printable {\n    default String format() {\n        return \"Printable format\";\n    }\n}\n\npublic interface Displayable {\n    default String format() {\n        return \"Displayable format\";\n    }\n}\n\npublic class Report implements Printable, Displayable {\n    @Override\n    public String format() {\n        // Must resolve the conflict explicitly\n        // Can choose one, combine both, or provide entirely new implementation\n        return Printable.super.format() + \" | \" + Displayable.super.format();\n    }\n}"
