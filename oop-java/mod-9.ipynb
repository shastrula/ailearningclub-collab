          "// Using lambdas as functional interface implementations\nvar pipeline = new DataPipeline<>(List.of(\"Alice\", \"Bob\", \"Charlie\", \"David\"));\n\nList<String> result = pipeline\n    .filter(name -> name.length() > 3)     // Predicate<String>\n    .map(String::toUpperCase)               // Transformer<String, String>\n    .toList();\n// [ALICE, CHARLIE, DAVID]"
