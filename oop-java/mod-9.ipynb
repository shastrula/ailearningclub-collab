          "java",
          "public class DataPipeline<T> {\n    private final List<T> data;\n\n    public DataPipeline(List<T> data) {\n        this.data = new ArrayList<>(data);\n    }\n\n    public DataPipeline<T> filter(Predicate<T> predicate) {\n        List<T> filtered = data.stream()\n            .filter(predicate::test)\n            .toList();\n        return new DataPipeline<>(filtered);\n    }\n\n    public <R> DataPipeline<R> map(Transformer<T, R> transformer) {\n        List<R> mapped = data.stream()\n            .map(transformer::transform)\n            .toList();\n        return new DataPipeline<>(mapped);\n    }\n\n    public List<T> toList() {\n        return List.copyOf(data);\n    }\n}"
        ]
      ]
