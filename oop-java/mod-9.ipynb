          "java",
          "public interface Collection<T> {\n    void add(T item);\n    boolean remove(T item);\n    int size();\n    boolean contains(T item);\n\n    // Default method - derived from other methods\n    default boolean isEmpty() {\n        return size() == 0;\n    }\n\n    default void addAll(List<T> items) {\n        for (T item : items) {\n            add(item);\n        }\n    }\n}"
