          "java",
          "// GOOD: Square is genuinely substitutable\npublic class PaymentMethod {\n    private String name;\n    private boolean active;\n\n    public PaymentMethod(String name) {\n        this.name = name;\n        this.active = true;\n    }\n\n    public boolean authorize(double amount) {\n        return active && amount > 0;\n    }\n\n    public String getName() { return name; }\n}\n\npublic class CreditCard extends PaymentMethod {\n    private double limit;\n    private double used;\n\n    public CreditCard(String name, double limit) {\n        super(name);\n        this.limit = limit;\n    }\n\n    @Override\n    public boolean authorize(double amount) {\n        return super.authorize(amount) && (used + amount <= limit);\n    }\n}\n\npublic class DebitCard extends PaymentMethod {\n    private double balance;\n\n    public DebitCard(String name, double balance) {\n        super(name);\n        this.balance = balance;\n    }\n\n    @Override\n    public boolean authorize(double amount) {\n        return super.authorize(amount) && amount <= balance;\n    }\n}"
        ]
      ]
    },
