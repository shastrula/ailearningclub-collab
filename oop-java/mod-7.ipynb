          "java",
          "public interface Plugin {\n    String getName();\n    void initialize();\n    void execute(Map<String, Object> context);\n    void shutdown();\n}\n\npublic class LoggingPlugin implements Plugin {\n    @Override public String getName() { return \"Logging\"; }\n    @Override public void initialize() { System.out.println(\"Logger ready\"); }\n    @Override public void execute(Map<String, Object> context) {\n        System.out.println(\"[LOG] \" + context.get(\"action\"));\n    }\n    @Override public void shutdown() { System.out.println(\"Logger closed\"); }\n}\n\npublic class MetricsPlugin implements Plugin {\n    private int eventCount = 0;\n    @Override public String getName() { return \"Metrics\"; }\n    @Override public void initialize() { eventCount = 0; }\n    @Override public void execute(Map<String, Object> context) {\n        eventCount++;\n    }\n    @Override public void shutdown() {\n        System.out.println(\"Total events: \" + eventCount);\n    }\n}\n\npublic class PluginManager {\n    private final List<Plugin> plugins = new ArrayList<>();\n\n    public void register(Plugin plugin) {\n        plugins.add(plugin);\n        plugin.initialize();\n    }\n\n    public void dispatch(Map<String, Object> context) {\n        for (Plugin plugin : plugins) {\n            plugin.execute(context);  // Polymorphic call\n        }\n    }\n\n    public void shutdownAll() {\n        plugins.forEach(Plugin::shutdown);\n    }\n}"
        ]
      ]
    }
