          "java",
          "public class NotificationService {\n    private final List<Notification> pending = new ArrayList<>();\n\n    public void queue(Notification notification) {\n        pending.add(notification);\n    }\n\n    public void sendAll() {\n        for (Notification n : pending) {\n            n.send(); // Each type sends differently\n        }\n        pending.clear();\n    }\n}\n\n// Usage\nNotificationService service = new NotificationService();\nservice.queue(new EmailNotification(\"alice@test.com\", \"Hello\", \"Greetings\"));\nservice.queue(new SmsNotification(\"+1234567890\", \"Quick update\"));\nservice.queue(new PushNotification(\"user-42\", \"New message\"));\nservice.sendAll(); // Each sends in its own way"
        ]
      ]
