          "java",
          "public interface Sortable {\n    int getSortKey();\n}\n\npublic interface Exportable {\n    String toCSV();\n    String toJSON();\n}\n\npublic class Product implements Sortable, Exportable {\n    private String name;\n    private double price;\n    private int stock;\n\n    public Product(String name, double price, int stock) {\n        this.name = name;\n        this.price = price;\n        this.stock = stock;\n    }\n\n    @Override\n    public int getSortKey() { return stock; }\n\n    @Override\n    public String toCSV() {\n        return name + \",\" + price + \",\" + stock;\n    }\n\n    @Override\n    public String toJSON() {\n        return \"{\\\"name\\\":\\\"\" + name + \"\\\",\\\"price\\\":\" + price + \"}\";\n    }\n}"
        ]
      ]
