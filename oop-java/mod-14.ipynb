          "java",
          "public class MapDemo {\n    public static void main(String[] args) {\n        Map<String, Integer> wordCount = new HashMap<>();\n\n        // Put key-value pairs\n        wordCount.put(\"hello\", 5);\n        wordCount.put(\"world\", 3);\n        wordCount.put(\"java\", 10);\n\n        // Get value by key\n        int count = wordCount.get(\"java\"); // 10\n        Integer missing = wordCount.get(\"python\"); // null\n\n        // Safe access\n        int safeCount = wordCount.getOrDefault(\"python\", 0); // 0\n\n        // Check existence\n        boolean hasKey = wordCount.containsKey(\"hello\"); // true\n        boolean hasValue = wordCount.containsValue(5);   // true\n\n        // Compute if absent\n        wordCount.computeIfAbsent(\"newword\", key -> key.length());\n\n        // Merge\n        wordCount.merge(\"hello\", 1, Integer::sum); // hello -> 6\n\n        // Iterate entries\n        for (Map.Entry<String, Integer> entry : wordCount.entrySet()) {\n            System.out.println(entry.getKey() + \": \" + entry.getValue());\n        }\n\n        // Immutable map (Java 9+)\n        Map<String, String> env = Map.of(\n            \"APP_NAME\", \"MyApp\",\n            \"PORT\", \"8080\",\n            \"ENV\", \"production\"\n        );\n    }\n}"
        ]
      ]
