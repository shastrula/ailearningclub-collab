        [
          "java",
          "public class SetDemo {\n    public static void main(String[] args) {\n        // HashSet - no order guarantee, fastest\n        Set<String> emails = new HashSet<>();\n        emails.add(\"alice@test.com\");\n        emails.add(\"bob@test.com\");\n        emails.add(\"alice@test.com\"); // Ignored - duplicate\n        System.out.println(emails.size()); // 2\n\n        // LinkedHashSet - maintains insertion order\n        Set<String> insertionOrdered = new LinkedHashSet<>();\n        insertionOrdered.add(\"first\");\n        insertionOrdered.add(\"second\");\n        insertionOrdered.add(\"third\");\n        // Iteration always: first, second, third\n\n        // TreeSet - sorted order\n        Set<Integer> sorted = new TreeSet<>();\n        sorted.add(42);\n        sorted.add(7);\n        sorted.add(23);\n        sorted.add(15);\n        System.out.println(sorted); // [7, 15, 23, 42]\n\n        // Set operations\n        Set<String> teamA = Set.of(\"Alice\", \"Bob\", \"Charlie\");\n        Set<String> teamB = Set.of(\"Bob\", \"David\", \"Alice\");\n\n        // Union\n        Set<String> union = new HashSet<>(teamA);\n        union.addAll(teamB);\n\n        // Intersection\n        Set<String> intersection = new HashSet<>(teamA);\n        intersection.retainAll(teamB);\n\n        // Difference\n        Set<String> difference = new HashSet<>(teamA);\n        difference.removeAll(teamB);\n    }\n}"
        ]
      ]
    },
