          "java",
          "public class ListDemo {\n    public static void main(String[] args) {\n        // ArrayList - fast random access, O(1) get\n        List<String> tasks = new ArrayList<>();\n        tasks.add(\"Design API\");\n        tasks.add(\"Write tests\");\n        tasks.add(\"Implement feature\");\n        tasks.add(\"Write tests\"); // Duplicates allowed\n\n        // Access by index\n        String first = tasks.get(0); // \"Design API\"\n        tasks.set(1, \"Write unit tests\"); // Replace element\n\n        // Insert at position\n        tasks.add(0, \"Review requirements\");\n\n        // Remove\n        tasks.remove(\"Write tests\"); // Removes first occurrence\n        tasks.remove(2);              // Removes by index\n\n        // Immutable list (Java 9+)\n        List<String> colors = List.of(\"red\", \"green\", \"blue\");\n        // colors.add(\"yellow\"); // throws UnsupportedOperationException\n\n        // Mutable copy of immutable list\n        List<String> mutableColors = new ArrayList<>(colors);\n        mutableColors.add(\"yellow\"); // OK\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
