          "java",
          "public class QueueDemo {\n    public static void main(String[] args) {\n        // Queue - FIFO\n        Queue<String> taskQueue = new LinkedList<>();\n        taskQueue.offer(\"Task 1\"); // Add to back\n        taskQueue.offer(\"Task 2\");\n        taskQueue.offer(\"Task 3\");\n\n        String next = taskQueue.poll(); // Remove from front: \"Task 1\"\n        String peek = taskQueue.peek(); // Look at front without removing: \"Task 2\"\n\n        // PriorityQueue - ordered by natural ordering or Comparator\n        Queue<Integer> priorities = new PriorityQueue<>();\n        priorities.offer(5);\n        priorities.offer(1);\n        priorities.offer(3);\n        System.out.println(priorities.poll()); // 1 (lowest first)\n        System.out.println(priorities.poll()); // 3\n\n        // Deque - double-ended\n        Deque<String> deque = new ArrayDeque<>();\n        deque.offerFirst(\"A\"); // Add to front\n        deque.offerLast(\"B\");  // Add to back\n        deque.offerFirst(\"C\"); // Add to front\n        // Order: C, A, B\n\n        String front = deque.pollFirst(); // \"C\"\n        String back = deque.pollLast();   // \"B\"\n    }\n}"
        ]
      ]
