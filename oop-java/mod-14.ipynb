          "java",
          "public class GradeBook {\n    private final Map<String, List<Double>> studentGrades = new LinkedHashMap<>();\n\n    public void addGrade(String student, double grade) {\n        studentGrades.computeIfAbsent(student, k -> new ArrayList<>()).add(grade);\n    }\n\n    public double getAverage(String student) {\n        List<Double> grades = studentGrades.getOrDefault(student, List.of());\n        return grades.stream().mapToDouble(Double::doubleValue).average().orElse(0.0);\n    }\n\n    public Set<String> getHonorRoll(double threshold) {\n        Set<String> honors = new TreeSet<>();\n        for (var entry : studentGrades.entrySet()) {\n            if (getAverage(entry.getKey()) >= threshold) {\n                honors.add(entry.getKey());\n            }\n        }\n        return honors;\n    }\n\n    public Map<String, Double> getAllAverages() {\n        Map<String, Double> averages = new LinkedHashMap<>();\n        for (String student : studentGrades.keySet()) {\n            averages.put(student, getAverage(student));\n        }\n        return averages;\n    }\n\n    public Queue<String> getRankingQueue() {\n        PriorityQueue<String> ranking = new PriorityQueue<>(\n            (a, b) -> Double.compare(getAverage(b), getAverage(a)) // Descending\n        );\n        ranking.addAll(studentGrades.keySet());\n        return ranking;\n    }\n}"
        ]
      ]
    },
