          "java",
          "public class TransferUtils {\n    // Source produces T values (extends), destination consumes T values (super)\n    public static <T> void transfer(List<? extends T> source,\n                                     List<? super T> destination) {\n        for (T item : source) {\n            destination.add(item);\n        }\n    }\n}"
        ]
      ]
