        [
          "java",
          "public class JdbcUserDao implements UserDao {\n    private final DataSource dataSource;\n\n    public JdbcUserDao(DataSource dataSource) {\n        this.dataSource = Objects.requireNonNull(dataSource);\n    }\n\n    @Override\n    public Optional<User> findById(Long id) {\n        String sql = \"SELECT id, name, email, created_at FROM users WHERE id = ?\";\n        try (var conn = dataSource.getConnection();\n             var pstmt = conn.prepareStatement(sql)) {\n            pstmt.setLong(1, id);\n            try (var rs = pstmt.executeQuery()) {\n                if (rs.next()) return Optional.of(mapRow(rs));\n            }\n        } catch (SQLException e) {\n            throw new DataAccessException(\"Error finding user by ID: \" + id, e);\n        }\n        return Optional.empty();\n    }\n\n    @Override\n    public List<User> findAll() {\n        String sql = \"SELECT id, name, email, created_at FROM users ORDER BY name\";\n        List<User> users = new ArrayList<>();\n        try (var conn = dataSource.getConnection();\n             var stmt = conn.createStatement();\n             var rs = stmt.executeQuery(sql)) {\n            while (rs.next()) {\n                users.add(mapRow(rs));\n            }\n        } catch (SQLException e) {\n            throw new DataAccessException(\"Error finding all users\", e);\n        }\n        return users;\n    }\n\n    @Override\n    public User save(User user) {\n        String sql = \"INSERT INTO users (name, email, created_at) VALUES (?, ?, ?) RETURNING id\";\n        try (var conn = dataSource.getConnection();\n             var pstmt = conn.prepareStatement(sql)) {\n            pstmt.setString(1, user.name());\n            pstmt.setString(2, user.email());\n            pstmt.setTimestamp(3, Timestamp.valueOf(LocalDateTime.now()));\n            try (var rs = pstmt.executeQuery()) {\n                if (rs.next()) {\n                    long id = rs.getLong(\"id\");\n                    return new User(id, user.name(), user.email(), LocalDateTime.now());\n                }\n            }\n        } catch (SQLException e) {\n            throw new DataAccessException(\"Error saving user: \" + user.email(), e);\n        }\n        throw new DataAccessException(\"Failed to retrieve generated ID\");\n    }\n\n    @Override\n    public void update(User user) {\n        String sql = \"UPDATE users SET name = ?, email = ? WHERE id = ?\";\n        try (var conn = dataSource.getConnection();\n             var pstmt = conn.prepareStatement(sql)) {\n            pstmt.setString(1, user.name());\n            pstmt.setString(2, user.email());\n            pstmt.setLong(3, user.id());\n            int affected = pstmt.executeUpdate();\n            if (affected == 0) {\n                throw new DataAccessException(\"User not found: \" + user.id());\n            }\n        } catch (SQLException e) {\n            throw new DataAccessException(\"Error updating user: \" + user.id(), e);\n        }\n    }\n\n    @Override\n    public void deleteById(Long id) {\n        String sql = \"DELETE FROM users WHERE id = ?\";\n        try (var conn = dataSource.getConnection();\n             var pstmt = conn.prepareStatement(sql)) {\n            pstmt.setLong(1, id);\n            pstmt.executeUpdate();\n        } catch (SQLException e) {\n            throw new DataAccessException(\"Error deleting user: \" + id, e);\n        }\n    }\n\n    @Override\n    public long count() {\n        String sql = \"SELECT COUNT(*) FROM users\";\n        try (var conn = dataSource.getConnection();\n             var stmt = conn.createStatement();\n             var rs = stmt.executeQuery(sql)) {\n            if (rs.next()) return rs.getLong(1);\n        } catch (SQLException e) {\n            throw new DataAccessException(\"Error counting users\", e);\n        }\n        return 0;\n    }\n\n    @Override\n    public Optional<User> findByEmail(String email) {\n        String sql = \"SELECT id, name, email, created_at FROM users WHERE email = ?\";\n        try (var conn = dataSource.getConnection();\n             var pstmt = conn.prepareStatement(sql)) {\n            pstmt.setString(1, email);\n            try (var rs = pstmt.executeQuery()) {\n                if (rs.next()) return Optional.of(mapRow(rs));\n            }\n        } catch (SQLException e) {\n            throw new DataAccessException(\"Error finding user by email: \" + email, e);\n        }\n        return Optional.empty();\n    }\n\n    @Override\n    public List<User> findByNameContaining(String namePart) {\n        String sql = \"SELECT id, name, email, created_at FROM users WHERE name ILIKE ?\";\n        List<User> users = new ArrayList<>();\n        try (var conn = dataSource.getConnection();\n             var pstmt = conn.prepareStatement(sql)) {\n            pstmt.setString(1, \"%\" + namePart + \"%\");\n            try (var rs = pstmt.executeQuery()) {\n                while (rs.next()) users.add(mapRow(rs));\n            }\n        } catch (SQLException e) {\n            throw new DataAccessException(\"Error searching users\", e);\n        }\n        return users;\n    }\n\n    @Override\n    public List<User> findActiveUsers() {\n        String sql = \"\"\"\n            SELECT id, name, email, created_at FROM users\n            WHERE created_at > ? ORDER BY created_at DESC\n            \"\"\";\n        List<User> users = new ArrayList<>();\n        try (var conn = dataSource.getConnection();\n             var pstmt = conn.prepareStatement(sql)) {\n            pstmt.setTimestamp(1, Timestamp.valueOf(LocalDateTime.now().minusDays(30)));\n            try (var rs = pstmt.executeQuery()) {\n                while (rs.next()) users.add(mapRow(rs));\n            }\n        } catch (SQLException e) {\n            throw new DataAccessException(\"Error finding active users\", e);\n        }\n        return users;\n    }\n\n    private User mapRow(ResultSet rs) throws SQLException {\n        return new User(\n            rs.getLong(\"id\"),\n            rs.getString(\"name\"),\n            rs.getString(\"email\"),\n            rs.getTimestamp(\"created_at\").toLocalDateTime()\n        );\n    }\n}"
        ]
