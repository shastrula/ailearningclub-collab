          "public class Employee {\n    String name;\n    String department;\n    double salary;\n    boolean isActive;\n\n    // Constructor\n    public Employee(String name, String department, double salary) {\n        this.name = name;\n        this.department = department;\n        this.salary = salary;\n        this.isActive = true; // Default for all new employees\n    }\n}"
