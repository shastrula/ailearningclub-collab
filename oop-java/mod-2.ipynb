          "public class Order {\n    private String orderId;\n    private double total;\n\n    public Order(String orderId, double total) {\n        this.orderId = orderId;\n        this.total = total;\n    }\n\n    public void submitTo(OrderProcessor processor) {\n        processor.process(this); // Pass current Order to processor\n    }\n}"
