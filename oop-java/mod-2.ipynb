          "java",
          "public class Product {\n    private String name;\n    private double price;\n    private String category;\n    private boolean inStock;\n\n    // Full constructor\n    public Product(String name, double price, String category, boolean inStock) {\n        this.name = name;\n        this.price = price;\n        this.category = category;\n        this.inStock = inStock;\n    }\n\n    // Delegates to full constructor with defaults\n    public Product(String name, double price, String category) {\n        this(name, price, category, true); // Calls the 4-parameter constructor\n    }\n\n    // Minimal constructor\n    public Product(String name, double price) {\n        this(name, price, \"General\"); // Calls the 3-parameter constructor\n    }\n}"
        ]
      ]
    },
