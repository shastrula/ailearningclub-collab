          "java",
          "public sealed interface Shape permits Circle, Rectangle, Triangle {}\npublic record Circle(double radius) implements Shape {}\npublic record Rectangle(double width, double height) implements Shape {}\npublic record Triangle(double base, double height) implements Shape {}\n\npublic class Renderer {\n    public String describe(Shape shape) {\n        if (shape instanceof Circle c) {\n            return \"Circle with radius %.1f, area %.2f\".formatted(c.radius(), Math.PI * c.radius() * c.radius());\n        } else if (shape instanceof Rectangle r) {\n            return \"Rectangle %s%.1f x %.1f\".formatted(\n                r.width() == r.height() ? \"(square) \" : \"\", r.width(), r.height());\n        } else if (shape instanceof Triangle t) {\n            return \"Triangle with base %.1f and height %.1f\".formatted(t.base(), t.height());\n        }\n        return \"Unknown shape\";\n    }\n}"
        ]
      ]
    },
