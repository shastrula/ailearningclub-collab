        [
          "java",
          "public sealed interface ApiResponse permits Success, ClientError, ServerError {}\npublic record Success(Object data) implements ApiResponse {}\npublic record ClientError(int code, String message) implements ApiResponse {}\npublic record ServerError(String message, Throwable cause) implements ApiResponse {}\n\npublic class ResponseHandler {\n    public String handle(ApiResponse response) {\n        return switch (response) {\n            case Success s -> \"OK: \" + s.data();\n            case ClientError e when e.code() == 404 -> \"Not found: \" + e.message();\n            case ClientError e -> \"Client error \" + e.code() + \": \" + e.message();\n            case ServerError e -> \"Server error: \" + e.message();\n            // No default needed - all cases covered\n        };\n    }\n}"
        ]
      ]
