          "java",
          "public record Coordinate(double lat, double lng) {}\npublic record Address(String street, String city, Coordinate location) {}\n\npublic class GeoService {\n    public String describeLocation(Address address) {\n        return switch (address) {\n            case Address(var street, var city, Coordinate(var lat, var lng))\n                when lat > 60 -> \"Northern location: \" + city;\n            case Address(var street, var city, Coordinate(var lat, var lng))\n                when lat < -60 -> \"Southern location: \" + city;\n            case Address(_, var city, _) -> \"Location: \" + city;\n        };\n    }\n}"
        ]
