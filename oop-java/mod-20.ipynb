      "outputs": [],
      "source": [
        [
          "java",
          "Point p = new Point(3.0, 4.0);\nSystem.out.println(p.x());       // 3.0 (accessor, not getX())\nSystem.out.println(p);           // Point[x=3.0, y=4.0]\n\nPoint p2 = new Point(3.0, 4.0);\nSystem.out.println(p.equals(p2)); // true (value equality)\n\nRange r = new Range(1, 10);\nSystem.out.println(r.contains(5)); // true\n// new Range(10, 1); // throws IllegalArgumentException"
        ]
      ]
