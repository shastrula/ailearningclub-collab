      "source": [
        [
          "java",
          "public class TaskService {\n    private final TaskRepository repository;\n\n    public TaskService(TaskRepository repository) {\n        this.repository = Objects.requireNonNull(repository);\n    }\n\n    public Task createTask(CreateTaskRequest request) {\n        request.validate();\n\n        Task task = new Task(\n            UUID.randomUUID().toString(),\n            request.title().trim(),\n            request.description() != null ? request.description().trim() : \"\",\n            TaskStatus.TODO,\n            request.priority() != null\n                ? TaskPriority.valueOf(request.priority().toUpperCase())\n                : TaskPriority.MEDIUM,\n            request.assigneeId(),\n            LocalDateTime.now(),\n            LocalDateTime.now()\n        );\n\n        return repository.save(task);\n    }\n\n    public Task getTask(String id) {\n        return repository.findById(id)\n            .orElseThrow(() -> new ResourceNotFoundException(\"Task\", id));\n    }\n\n    public PagedResponse<TaskResponse> listTasks(int page, int pageSize) {\n        List<TaskResponse> tasks = repository.findAll(page, pageSize).stream()\n            .map(TaskResponse::from)\n            .toList();\n        return new PagedResponse<>(tasks, page, pageSize, repository.count());\n    }\n\n    public Task updateStatus(String id, String newStatus) {\n        Task task = getTask(id);\n        TaskStatus status = TaskStatus.valueOf(newStatus.toUpperCase());\n        validateStatusTransition(task.status(), status);\n        Task updated = task.withStatus(status);\n        return repository.save(updated);\n    }\n\n    public Task assignTask(String id, String assigneeId) {\n        Task task = getTask(id);\n        if (task.status() == TaskStatus.DONE) {\n            throw new BusinessRuleException(\"Cannot reassign a completed task\");\n        }\n        Task updated = task.withAssignee(assigneeId);\n        return repository.save(updated);\n    }\n\n    public void deleteTask(String id) {\n        getTask(id); // Verify exists\n        repository.deleteById(id);\n    }\n\n    private void validateStatusTransition(TaskStatus from, TaskStatus to) {\n        // Define valid transitions\n        Map<TaskStatus, Set<TaskStatus>> validTransitions = Map.of(\n            TaskStatus.TODO, Set.of(TaskStatus.IN_PROGRESS),\n            TaskStatus.IN_PROGRESS, Set.of(TaskStatus.IN_REVIEW, TaskStatus.TODO),\n            TaskStatus.IN_REVIEW, Set.of(TaskStatus.DONE, TaskStatus.IN_PROGRESS),\n            TaskStatus.DONE, Set.of()\n        );\n\n        if (!validTransitions.getOrDefault(from, Set.of()).contains(to)) {\n            throw new BusinessRuleException(\n                \"Invalid status transition: %s -> %s\".formatted(from, to));\n        }\n    }\n}"
        ]
      ]
    },
