          "java",
          "// Controller Layer - handles HTTP requests/responses\n// Service Layer - contains business logic\n// Repository Layer - data access (DAO pattern)\n\n// Each layer depends only on the layer below it\n// All communication happens through interfaces"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "public record Task(\n    String id,\n    String title,\n    String description,\n    TaskStatus status,\n    TaskPriority priority,\n    String assigneeId,\n    LocalDateTime createdAt,\n    LocalDateTime updatedAt\n) {\n    public Task withStatus(TaskStatus newStatus) {\n        return new Task(id, title, description, newStatus, priority,\n            assigneeId, createdAt, LocalDateTime.now());\n    }\n\n    public Task withAssignee(String newAssigneeId) {\n        return new Task(id, title, description, status, priority,\n            newAssigneeId, createdAt, LocalDateTime.now());\n    }\n}\n\npublic enum TaskStatus { TODO, IN_PROGRESS, IN_REVIEW, DONE }\npublic enum TaskPriority { LOW, MEDIUM, HIGH, CRITICAL }"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "// Request DTOs - what the client sends\npublic record CreateTaskRequest(\n    String title,\n    String description,\n    String priority,\n    String assigneeId\n) {\n    public void validate() {\n        if (title == null || title.isBlank()) {\n            throw new ValidationException(\"title\", \"Title is required\");\n        }\n        if (title.length() > 200) {\n            throw new ValidationException(\"title\", \"Title must be under 200 characters\");\n        }\n        if (priority != null) {\n            try {\n                TaskPriority.valueOf(priority.toUpperCase());\n            } catch (IllegalArgumentException e) {\n                throw new ValidationException(\"priority\", \"Invalid priority: \" + priority);\n            }\n        }\n    }\n}\n\npublic record UpdateTaskRequest(String title, String description, String status, String priority) {}\n\n// Response DTOs - what the client receives\npublic record TaskResponse(\n    String id,\n    String title,\n    String description,\n    String status,\n    String priority,\n    String assigneeId,\n    String createdAt,\n    String updatedAt\n) {\n    public static TaskResponse from(Task task) {\n        return new TaskResponse(\n            task.id(),\n            task.title(),\n            task.description(),\n            task.status().name(),\n            task.priority().name(),\n            task.assigneeId(),\n            task.createdAt().toString(),\n            task.updatedAt().toString()\n        );\n    }\n}\n\npublic record ErrorResponse(String error, String message, int status) {}\npublic record PagedResponse<T>(List<T> items, int page, int pageSize, long totalItems) {}"
        ]
      ]
    },
    {
