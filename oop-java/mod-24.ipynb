        [
          "java",
          "public class ValidationException extends RuntimeException {\n    private final String field;\n\n    public ValidationException(String field, String message) {\n        super(message);\n        this.field = field;\n    }\n\n    public String getField() { return field; }\n}\n\npublic class ResourceNotFoundException extends RuntimeException {\n    public ResourceNotFoundException(String resource, String id) {\n        super(resource + \" not found with ID: \" + id);\n    }\n}\n\npublic class BusinessRuleException extends RuntimeException {\n    public BusinessRuleException(String message) {\n        super(message);\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "public interface TaskRepository {\n    Optional<Task> findById(String id);\n    List<Task> findAll(int page, int pageSize);\n    List<Task> findByStatus(TaskStatus status);\n    List<Task> findByAssignee(String assigneeId);\n    Task save(Task task);\n    void deleteById(String id);\n    long count();\n}\n\npublic class InMemoryTaskRepository implements TaskRepository {\n    private final Map<String, Task> store = new ConcurrentHashMap<>();\n\n    @Override\n    public Optional<Task> findById(String id) {\n        return Optional.ofNullable(store.get(id));\n    }\n\n    @Override\n    public List<Task> findAll(int page, int pageSize) {\n        return store.values().stream()\n            .sorted(Comparator.comparing(Task::createdAt).reversed())\n            .skip((long) page * pageSize)\n            .limit(pageSize)\n            .toList();\n    }\n\n    @Override\n    public List<Task> findByStatus(TaskStatus status) {\n        return store.values().stream()\n            .filter(t -> t.status() == status)\n            .toList();\n    }\n\n    @Override\n    public List<Task> findByAssignee(String assigneeId) {\n        return store.values().stream()\n            .filter(t -> assigneeId.equals(t.assigneeId()))\n            .toList();\n    }\n\n    @Override\n    public Task save(Task task) {\n        store.put(task.id(), task);\n        return task;\n    }\n\n    @Override\n    public void deleteById(String id) {\n        store.remove(id);\n    }\n\n    @Override\n    public long count() {\n        return store.size();\n    }\n}"
        ]
      ]
    },
