          "java",
          "public class TaskController {\n    private final TaskService taskService;\n\n    public TaskController(TaskService taskService) {\n        this.taskService = taskService;\n    }\n\n    // GET /api/tasks\n    public ApiResponse listTasks(int page, int pageSize) {\n        var tasks = taskService.listTasks(page, pageSize);\n        return ApiResponse.ok(tasks);\n    }\n\n    // POST /api/tasks\n    public ApiResponse createTask(CreateTaskRequest request) {\n        Task task = taskService.createTask(request);\n        return ApiResponse.created(TaskResponse.from(task));\n    }\n\n    // GET /api/tasks/{id}\n    public ApiResponse getTask(String id) {\n        Task task = taskService.getTask(id);\n        return ApiResponse.ok(TaskResponse.from(task));\n    }\n\n    // PATCH /api/tasks/{id}/status\n    public ApiResponse updateStatus(String id, String status) {\n        Task task = taskService.updateStatus(id, status);\n        return ApiResponse.ok(TaskResponse.from(task));\n    }\n\n    // DELETE /api/tasks/{id}\n    public ApiResponse deleteTask(String id) {\n        taskService.deleteTask(id);\n        return ApiResponse.noContent();\n    }\n}\n\n// Generic API response wrapper\npublic record ApiResponse(int status, Object body) {\n    public static ApiResponse ok(Object body) { return new ApiResponse(200, body); }\n    public static ApiResponse created(Object body) { return new ApiResponse(201, body); }\n    public static ApiResponse noContent() { return new ApiResponse(204, null); }\n    public static ApiResponse error(int status, String message) {\n        return new ApiResponse(status, new ErrorResponse(\"error\", message, status));\n    }\n}"
        ]
      ]
