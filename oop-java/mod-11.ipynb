          "java",
          "// All principles applied in a cohesive design\npublic interface PaymentGateway {  // ISP: focused interface\n    PaymentResult charge(Money amount, PaymentDetails details);\n}\n\npublic record PaymentResult(boolean success, String transactionId, String error) {\n    public static PaymentResult success(String txId) {\n        return new PaymentResult(true, txId, null);\n    }\n    public static PaymentResult failure(String error) {\n        return new PaymentResult(false, null, error);\n    }\n}\n\npublic class StripeGateway implements PaymentGateway { // OCP: new gateway = new class\n    @Override\n    public PaymentResult charge(Money amount, PaymentDetails details) {\n        return PaymentResult.success(\"stripe_\" + UUID.randomUUID());\n    }\n}\n\npublic class CheckoutService { // SRP: only handles checkout flow\n    private final PaymentGateway gateway; // DIP: depends on abstraction\n\n    public CheckoutService(PaymentGateway gateway) {\n        this.gateway = gateway;\n    }\n\n    public PaymentResult checkout(Cart cart, PaymentDetails payment) {\n        Money total = cart.getTotal();\n        return gateway.charge(total, payment); // LSP: any gateway works\n    }\n}"
