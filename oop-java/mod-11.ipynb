          "java",
          "// VIOLATION: Square breaks Rectangle's contract\npublic class Rectangle {\n    protected double width;\n    protected double height;\n\n    public void setWidth(double w) { width = w; }\n    public void setHeight(double h) { height = h; }\n    public double area() { return width * height; }\n}\n\npublic class Square extends Rectangle {\n    @Override\n    public void setWidth(double w) { width = w; height = w; } // Surprise!\n    @Override\n    public void setHeight(double h) { width = h; height = h; } // Surprise!\n}\n\n// This test passes for Rectangle but FAILS for Square\nvoid testArea(Rectangle r) {\n    r.setWidth(5);\n    r.setHeight(4);\n    assert r.area() == 20; // Fails for Square! area = 16\n}"
