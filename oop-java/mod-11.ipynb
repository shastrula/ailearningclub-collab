          "java",
          "// VIOLATION: This class does too many things\npublic class UserManager {\n    public void createUser(String name, String email) { /* ... */ }\n    public void sendWelcomeEmail(String email) { /* ... */ }\n    public String generateReport() { /* ... */ }\n    public void saveToDatabase(Object data) { /* ... */ }\n}\n\n// CORRECT: Each class has one responsibility\npublic class UserService {\n    private final UserRepository repository;\n    private final EmailService emailService;\n\n    public UserService(UserRepository repository, EmailService emailService) {\n        this.repository = repository;\n        this.emailService = emailService;\n    }\n\n    public User createUser(String name, String email) {\n        User user = new User(name, email);\n        repository.save(user);\n        emailService.sendWelcome(user);\n        return user;\n    }\n}\n\npublic class UserRepository {\n    public void save(User user) {\n        System.out.println(\"Saving user to database: \" + user.name());\n    }\n\n    public User findByEmail(String email) {\n        return new User(\"Found\", email);\n    }\n}\n\npublic class EmailService {\n    public void sendWelcome(User user) {\n        System.out.println(\"Sending welcome email to: \" + user.email());\n    }\n}\n\npublic class UserReportGenerator {\n    private final UserRepository repository;\n\n    public UserReportGenerator(UserRepository repository) {\n        this.repository = repository;\n    }\n\n    public String generate() {\n        return \"User activity report...\";\n    }\n}\n\nrecord User(String name, String email) {}"
