        [
          "java",
          "public class Book {\n    String title;\n    String author;\n    String isbn;\n    boolean isCheckedOut;\n\n    void checkOut() {\n        if (!isCheckedOut) {\n            isCheckedOut = true;\n            System.out.println(\"'\" + title + \"' has been checked out.\");\n        } else {\n            System.out.println(\"'\" + title + \"' is already checked out.\");\n        }\n    }\n\n    void returnBook() {\n        if (isCheckedOut) {\n            isCheckedOut = false;\n            System.out.println(\"'\" + title + \"' has been returned.\");\n        } else {\n            System.out.println(\"'\" + title + \"' was not checked out.\");\n        }\n    }\n\n    String getStatus() {\n        return title + \" by \" + author + \" - \" +\n               (isCheckedOut ? \"Checked Out\" : \"Available\");\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "public class Library {\n    String name;\n    Book[] catalog;\n    int bookCount;\n\n    void addBook(Book book) {\n        if (bookCount < catalog.length) {\n            catalog[bookCount] = book;\n            bookCount++;\n        }\n    }\n\n    void printCatalog() {\n        System.out.println(\"=== \" + name + \" Catalog ===\");\n        for (int i = 0; i < bookCount; i++) {\n            System.out.println(catalog[i].getStatus());\n        }\n    }\n\n    public static void main(String[] args) {\n        Library library = new Library();\n        library.name = \"City Public Library\";\n        library.catalog = new Book[100];\n\n        Book book1 = new Book();\n        book1.title = \"Clean Code\";\n        book1.author = \"Robert C. Martin\";\n        book1.isbn = \"978-0132350884\";\n\n        Book book2 = new Book();\n        book2.title = \"Effective Java\";\n        book2.author = \"Joshua Bloch\";\n        book2.isbn = \"978-0134685991\";\n\n        library.addBook(book1);\n        library.addBook(book2);\n\n        library.printCatalog();\n        book1.checkOut();\n        library.printCatalog();\n    }\n}"
        ]
      ]
