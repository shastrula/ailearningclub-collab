          "java",
          "public class Car {\n    // Fields (properties)\n    String make;\n    String model;\n    int year;\n    double speed;\n\n    // Method (behavior)\n    void accelerate(double amount) {\n        speed += amount;\n    }\n\n    void brake(double amount) {\n        speed = Math.max(0, speed - amount);\n    }\n\n    String getDescription() {\n        return year + \" \" + make + \" \" + model;\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "public class Main {\n    public static void main(String[] args) {\n        // Creating objects using the 'new' keyword\n        Car myCar = new Car();\n        myCar.make = \"Toyota\";\n        myCar.model = \"Camry\";\n        myCar.year = 2024;\n\n        Car anotherCar = new Car();\n        anotherCar.make = \"Honda\";\n        anotherCar.model = \"Civic\";\n        anotherCar.year = 2023;\n\n        // Using object methods\n        myCar.accelerate(60.0);\n        System.out.println(myCar.getDescription()); // 2024 Toyota Camry\n        System.out.println(\"Speed: \" + myCar.speed); // Speed: 60.0\n\n        // Each object has its own state\n        System.out.println(anotherCar.speed); // 0.0\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "public class ReferenceDemo {\n    public static void main(String[] args) {\n        Car car1 = new Car();\n        car1.make = \"Tesla\";\n        car1.model = \"Model 3\";\n\n        // car2 points to the SAME object as car1\n        Car car2 = car1;\n        car2.model = \"Model Y\";\n\n        // Both references see the change\n        System.out.println(car1.model); // Model Y\n        System.out.println(car1 == car2); // true (same reference)\n\n        // Creating a separate object\n        Car car3 = new Car();\n        car3.make = \"Tesla\";\n        car3.model = \"Model Y\";\n\n        System.out.println(car1 == car3); // false (different objects)\n    }\n}"
        ]
      ]
    },
    {
