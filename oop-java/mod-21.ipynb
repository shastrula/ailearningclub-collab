        [
          "java",
          "class BankAccountTest {\n    private BankAccount account;\n\n    @BeforeEach\n    void setUp() {\n        account = new BankAccount(\"Alice\", 1000.0);\n    }\n\n    @Test\n    @DisplayName(\"New account has correct initial balance\")\n    void newAccountBalance() {\n        assertEquals(1000.0, account.getBalance());\n        assertEquals(\"Alice\", account.getOwner());\n    }\n\n    @Test\n    @DisplayName(\"Deposit increases balance\")\n    void depositIncreasesBalance() {\n        account.deposit(500.0);\n        assertEquals(1500.0, account.getBalance());\n    }\n\n    @Test\n    @DisplayName(\"Withdrawal decreases balance\")\n    void withdrawalDecreasesBalance() throws InsufficientFundsException {\n        account.withdraw(300.0);\n        assertEquals(700.0, account.getBalance());\n    }\n\n    @Test\n    @DisplayName(\"Withdrawal exceeding balance throws exception\")\n    void overdraftThrowsException() {\n        var ex = assertThrows(InsufficientFundsException.class,\n            () -> account.withdraw(1500.0));\n        assertEquals(1000.0, ex.getBalance());\n        assertEquals(1500.0, ex.getAmount());\n    }\n\n    @Test\n    @DisplayName(\"Negative deposit throws exception\")\n    void negativeDepositThrows() {\n        assertThrows(IllegalArgumentException.class,\n            () -> account.deposit(-100.0));\n    }\n\n    @Test\n    @DisplayName(\"Negative initial balance throws exception\")\n    void negativeInitialBalanceThrows() {\n        assertThrows(IllegalArgumentException.class,\n            () -> new BankAccount(\"Bob\", -500.0));\n    }\n}"
        ]
      ]
    },
