        [
          "java",
          "class AssertionExamplesTest {\n    @Test\n    void basicAssertions() {\n        assertEquals(4, 2 + 2);\n        assertNotEquals(\"hello\", \"world\");\n        assertTrue(10 > 5);\n        assertFalse(\"\".length() > 0);\n        assertNull(null);\n        assertNotNull(\"value\");\n    }\n\n    @Test\n    void objectEquality() {\n        var expected = new Customer(\"Alice\", \"alice@test.com\");\n        var actual = new Customer(\"Alice\", \"alice@test.com\");\n        assertEquals(expected, actual); // Uses equals()\n        assertNotSame(expected, actual); // Different references\n    }\n\n    @Test\n    void collectionAssertions() {\n        List<String> names = List.of(\"Alice\", \"Bob\", \"Charlie\");\n        assertEquals(3, names.size());\n        assertTrue(names.contains(\"Bob\"));\n        assertIterableEquals(List.of(\"Alice\", \"Bob\", \"Charlie\"), names);\n    }\n\n    @Test\n    void exceptionAssertions() {\n        var exception = assertThrows(IllegalArgumentException.class,\n            () -> new Range(-5, -10));\n        assertTrue(exception.getMessage().contains(\"min\"));\n    }\n\n    @Test\n    void groupedAssertions() {\n        Customer customer = new Customer(\"Alice\", \"alice@test.com\");\n        assertAll(\"customer properties\",\n            () -> assertEquals(\"Alice\", customer.name()),\n            () -> assertEquals(\"alice@test.com\", customer.email()),\n            () -> assertNotNull(customer.name())\n        );\n    }\n\n    @Test\n    void timeoutAssertion() {\n        assertTimeout(Duration.ofMillis(100), () -> {\n            // This must complete within 100ms\n            Thread.sleep(50);\n        });\n    }\n}\n\nrecord Customer(String name, String email) {}\nrecord Range(int min, int max) {\n    Range {\n        if (min > max) throw new IllegalArgumentException(\"min must not exceed max\");\n    }\n}"
        ]
      ]
    },
