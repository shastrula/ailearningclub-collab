          "java",
          "class LifecycleTest {\n    @BeforeAll\n    static void initializeOnce() {\n        // Runs once before all tests (must be static)\n        System.out.println(\"Setting up test class resources\");\n    }\n\n    @BeforeEach\n    void setUp() {\n        // Runs before each test\n        System.out.println(\"Setting up individual test\");\n    }\n\n    @Test\n    void firstTest() {\n        System.out.println(\"Running first test\");\n    }\n\n    @Test\n    void secondTest() {\n        System.out.println(\"Running second test\");\n    }\n\n    @AfterEach\n    void tearDown() {\n        // Runs after each test\n        System.out.println(\"Cleaning up after test\");\n    }\n\n    @AfterAll\n    static void cleanupOnce() {\n        // Runs once after all tests (must be static)\n        System.out.println(\"Cleaning up test class resources\");\n    }\n}"
        ]
      ]
