          "java",
          "class ParameterizedTestExamples {\n    @ParameterizedTest\n    @ValueSource(strings = {\"hello\", \"world\", \"java\"})\n    @DisplayName(\"String is not blank\")\n    void stringIsNotBlank(String input) {\n        assertFalse(input.isBlank());\n    }\n\n    @ParameterizedTest\n    @CsvSource({\n        \"1, 1, 2\",\n        \"5, 3, 8\",\n        \"10, -5, 5\",\n        \"0, 0, 0\"\n    })\n    @DisplayName(\"Addition with various inputs\")\n    void additionTests(int a, int b, int expected) {\n        assertEquals(expected, new Calculator().add(a, b));\n    }\n\n    @ParameterizedTest\n    @MethodSource(\"validEmailProvider\")\n    @DisplayName(\"Valid emails are accepted\")\n    void validEmails(String email) {\n        assertTrue(EmailValidator.isValid(email));\n    }\n\n    static Stream<String> validEmailProvider() {\n        return Stream.of(\n            \"user@example.com\",\n            \"test.name@domain.org\",\n            \"first+last@company.co.uk\"\n        );\n    }\n}"
