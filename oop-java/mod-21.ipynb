          "java",
          "// Interface for the dependency\npublic interface EmailService {\n    void sendEmail(String to, String subject, String body);\n}\n\n// Class under test\npublic class UserRegistration {\n    private final UserRepository repository;\n    private final EmailService emailService;\n\n    public UserRegistration(UserRepository repository, EmailService emailService) {\n        this.repository = repository;\n        this.emailService = emailService;\n    }\n\n    public User register(String name, String email) {\n        if (repository.existsByEmail(email)) {\n            throw new IllegalStateException(\"Email already registered\");\n        }\n        User user = new User(UUID.randomUUID().toString(), name, email);\n        repository.save(user);\n        emailService.sendEmail(email, \"Welcome!\", \"Hello \" + name);\n        return user;\n    }\n}\n\n// Test with manual test doubles\nclass UserRegistrationTest {\n    private List<User> savedUsers;\n    private List<String> sentEmails;\n    private UserRegistration registration;\n\n    @BeforeEach\n    void setUp() {\n        savedUsers = new ArrayList<>();\n        sentEmails = new ArrayList<>();\n\n        UserRepository fakeRepo = new UserRepository() {\n            @Override public void save(User user) { savedUsers.add(user); }\n            @Override public boolean existsByEmail(String email) {\n                return savedUsers.stream().anyMatch(u -> u.email().equals(email));\n            }\n        };\n\n        EmailService fakeEmail = (to, subject, body) -> sentEmails.add(to);\n\n        registration = new UserRegistration(fakeRepo, fakeEmail);\n    }\n\n    @Test\n    void successfulRegistration() {\n        User user = registration.register(\"Alice\", \"alice@test.com\");\n\n        assertEquals(\"Alice\", user.name());\n        assertEquals(1, savedUsers.size());\n        assertEquals(1, sentEmails.size());\n        assertEquals(\"alice@test.com\", sentEmails.get(0));\n    }\n\n    @Test\n    void duplicateEmailThrows() {\n        registration.register(\"Alice\", \"alice@test.com\");\n        assertThrows(IllegalStateException.class,\n            () -> registration.register(\"Bob\", \"alice@test.com\"));\n    }\n}\n\nrecord User(String id, String name, String email) {}\ninterface UserRepository {\n    void save(User user);\n    boolean existsByEmail(String email);\n}"
        ]
      ]
