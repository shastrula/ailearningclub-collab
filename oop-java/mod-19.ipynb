          "java",
          "public abstract class ReportGenerator {\n    // Template method - defines the algorithm structure\n    public final String generateReport(List<Map<String, Object>> data) {\n        String header = createHeader();\n        String body = formatData(data);\n        String summary = createSummary(data);\n        String footer = createFooter();\n        return header + body + summary + footer;\n    }\n\n    // Steps that subclasses implement\n    protected abstract String createHeader();\n    protected abstract String formatData(List<Map<String, Object>> data);\n    protected abstract String createFooter();\n\n    // Hook method with default implementation\n    protected String createSummary(List<Map<String, Object>> data) {\n        return \"\\nTotal records: \" + data.size() + \"\\n\";\n    }\n}\n\npublic class HtmlReportGenerator extends ReportGenerator {\n    @Override\n    protected String createHeader() {\n        return \"<html><body><h1>Report</h1>\\n\";\n    }\n\n    @Override\n    protected String formatData(List<Map<String, Object>> data) {\n        var sb = new StringBuilder(\"<table>\\n\");\n        for (var row : data) {\n            sb.append(\"<tr>\");\n            for (var value : row.values()) {\n                sb.append(\"<td>\").append(value).append(\"</td>\");\n            }\n            sb.append(\"</tr>\\n\");\n        }\n        sb.append(\"</table>\\n\");\n        return sb.toString();\n    }\n\n    @Override\n    protected String createFooter() {\n        return \"</body></html>\";\n    }\n}\n\npublic class CsvReportGenerator extends ReportGenerator {\n    @Override\n    protected String createHeader() {\n        return \"\"; // CSV has no header markup\n    }\n\n    @Override\n    protected String formatData(List<Map<String, Object>> data) {\n        var sb = new StringBuilder();\n        if (!data.isEmpty()) {\n            sb.append(String.join(\",\", data.get(0).keySet())).append(\"\\n\");\n        }\n        for (var row : data) {\n            sb.append(row.values().stream()\n                .map(Object::toString)\n                .collect(Collectors.joining(\",\"))).append(\"\\n\");\n        }\n        return sb.toString();\n    }\n\n    @Override\n    protected String createFooter() {\n        return \"\";\n    }\n\n    @Override\n    protected String createSummary(List<Map<String, Object>> data) {\n        return \"# Total: \" + data.size() + \" records\\n\";\n    }\n}"
        ]
      ]
    },
