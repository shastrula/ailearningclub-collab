          "java",
          "// Observer + Strategy: configurable event handling\npublic class OrderProcessor {\n    private final EventPublisher<OrderEvent> publisher = new EventPublisher<>();\n    private PricingStrategy pricing;\n\n    public OrderProcessor(PricingStrategy pricing) {\n        this.pricing = pricing;\n    }\n\n    public void onOrderPlaced(EventListener<OrderEvent> listener) {\n        publisher.subscribe(\"placed\", listener);\n    }\n\n    public double processOrder(String orderId, double basePrice, int quantity) {\n        double total = pricing.calculatePrice(basePrice, quantity);\n        publisher.publish(\"placed\",\n            new OrderEvent(orderId, \"PLACED\", LocalDateTime.now()));\n        return total;\n    }\n}"
        ]
      ]
