          "java",
          "// Event types\npublic record OrderEvent(String orderId, String status, LocalDateTime timestamp) {}\n\n// Observer interface\n@FunctionalInterface\npublic interface EventListener<T> {\n    void onEvent(T event);\n}\n\n// Subject (Publisher)\npublic class EventPublisher<T> {\n    private final Map<String, List<EventListener<T>>> listeners = new HashMap<>();\n\n    public void subscribe(String eventType, EventListener<T> listener) {\n        listeners.computeIfAbsent(eventType, k -> new ArrayList<>()).add(listener);\n    }\n\n    public void unsubscribe(String eventType, EventListener<T> listener) {\n        var list = listeners.get(eventType);\n        if (list != null) {\n            list.remove(listener);\n        }\n    }\n\n    public void publish(String eventType, T event) {\n        var list = listeners.getOrDefault(eventType, List.of());\n        for (var listener : list) {\n            listener.onEvent(event);\n        }\n    }\n}"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "java",
          "// Concrete observers\npublic class InventoryManager implements EventListener<OrderEvent> {\n    @Override\n    public void onEvent(OrderEvent event) {\n        if (\"CONFIRMED\".equals(event.status())) {\n            System.out.println(\"Inventory: Reserving stock for order \" + event.orderId());\n        }\n    }\n}\n\npublic class EmailNotifier implements EventListener<OrderEvent> {\n    @Override\n    public void onEvent(OrderEvent event) {\n        System.out.printf(\"Email: Order %s status changed to %s%n\",\n            event.orderId(), event.status());\n    }\n}\n\npublic class AnalyticsTracker implements EventListener<OrderEvent> {\n    private int orderCount = 0;\n\n    @Override\n    public void onEvent(OrderEvent event) {\n        if (\"CONFIRMED\".equals(event.status())) {\n            orderCount++;\n            System.out.println(\"Analytics: Total orders: \" + orderCount);\n        }\n    }\n}"
        ]
      ]
    },
    {
