          "java",
          "@FunctionalInterface\npublic interface ValidationStrategy {\n    boolean validate(String input);\n}\n\npublic class FormValidator {\n    private final Map<String, ValidationStrategy> fieldValidators = new LinkedHashMap<>();\n\n    public void addValidation(String fieldName, ValidationStrategy strategy) {\n        fieldValidators.put(fieldName, strategy);\n    }\n\n    public Map<String, Boolean> validate(Map<String, String> formData) {\n        Map<String, Boolean> results = new LinkedHashMap<>();\n        for (var entry : fieldValidators.entrySet()) {\n            String value = formData.getOrDefault(entry.getKey(), \"\");\n            results.put(entry.getKey(), entry.getValue().validate(value));\n        }\n        return results;\n    }\n\n    public List<String> getErrors(Map<String, String> formData) {\n        List<String> errors = new ArrayList<>();\n        for (var entry : fieldValidators.entrySet()) {\n            String value = formData.getOrDefault(entry.getKey(), \"\");\n            if (!entry.getValue().validate(value)) {\n                errors.add(entry.getKey() + \" is invalid\");\n            }\n        }\n        return errors;\n    }\n}"
        ]
      ]
    },
