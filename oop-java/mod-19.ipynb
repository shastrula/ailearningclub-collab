          "java",
          "// Usage\nvar publisher = new EventPublisher<OrderEvent>();\npublisher.subscribe(\"order\", new InventoryManager());\npublisher.subscribe(\"order\", new EmailNotifier());\npublisher.subscribe(\"order\", new AnalyticsTracker());\n\n// Using lambdas (since EventListener is a functional interface)\npublisher.subscribe(\"order\", event ->\n    System.out.println(\"Audit log: \" + event));\n\nvar event = new OrderEvent(\"ORD-001\", \"CONFIRMED\", LocalDateTime.now());\npublisher.publish(\"order\", event);"
        ]
