        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch.nn as nn\n\nclass CNN(nn.Module):\n    def __init__(self, num_classes=10):\n        super().__init__()\n        self.features = nn.Sequential(\n            nn.Conv2d(3, 32, kernel_size=3, padding=1),  # 3 channels -> 32 filters\n            nn.BatchNorm2d(32),\n            nn.ReLU(),\n            nn.MaxPool2d(2),  # halve spatial dimensions\n            \n            nn.Conv2d(32, 64, kernel_size=3, padding=1),\n            nn.BatchNorm2d(64),\n            nn.ReLU(),\n            nn.MaxPool2d(2),\n            \n            nn.Conv2d(64, 128, kernel_size=3, padding=1),\n            nn.BatchNorm2d(128),\n            nn.ReLU(),\n            nn.AdaptiveAvgPool2d(1),  # global average pooling\n        )\n        self.classifier = nn.Linear(128, num_classes)\n    \n    def forward(self, x):\n        x = self.features(x)\n        x = x.view(x.size(0), -1)  # flatten\n        return self.classifier(x)\n\nmodel = CNN(num_classes=10)\nx = torch.randn(4, 3, 32, 32)  # batch of 4 RGB images, 32x32\noutput = model(x)\nprint(f\"Output shape: {output.shape}\")  # [4, 10]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
