      "source": [
        [
          "python",
          "import torch\nimport torch.nn as nn\n\n# MSE Loss\ny_true = torch.tensor([1.0, 2.0, 3.0])\ny_pred = torch.tensor([1.1, 1.9, 3.2])\n\nmse_loss = nn.MSELoss()\nloss = mse_loss(y_pred, y_true)\nprint(f\"MSE Loss: {loss.item():.4f}\")  # Average of (0.1^2 + 0.1^2 + 0.2^2) = 0.02\n\n# Manual computation\nmanual_loss = ((y_pred - y_true) ** 2).mean()\nprint(f\"Manual MSE: {manual_loss.item():.4f}\")\n\n# With batch dimension\ny_true_batch = torch.randn(32, 10)  # 32 samples, 10 outputs\ny_pred_batch = torch.randn(32, 10)\nloss = mse_loss(y_pred_batch, y_true_batch)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport torch.nn as nn\n\n# Multi-class classification\nbatch_size, num_classes = 32, 10\nlogits = torch.randn(batch_size, num_classes)  # Raw network outputs\ntargets = torch.randint(0, num_classes, (batch_size,))  # True class indices\n\n# CrossEntropyLoss combines LogSoftmax + NLLLoss\nloss_fn = nn.CrossEntropyLoss()\nloss = loss_fn(logits, targets)\nprint(f\"Cross-Entropy Loss: {loss.item():.4f}\")\n\n# Manual computation\nprobabilities = torch.softmax(logits, dim=1)  # Convert to probabilities\nmanual_loss = -torch.log(probabilities[range(batch_size), targets]).mean()\nprint(f\"Manual CE Loss: {manual_loss.item():.4f}\")\n\n# Binary classification\nlogits_binary = torch.randn(32, 1)\ntargets_binary = torch.randint(0, 2, (32,)).float()\nbce_loss = nn.BCEWithLogitsLoss()  # Combines sigmoid + BCE\nloss = bce_loss(logits_binary, targets_binary)\nprint(f\"Binary CE Loss: {loss.item():.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport torch.nn as nn\n\ndef focal_loss(logits, targets, gamma=2.0, alpha=None):\n    \"\"\"Focal loss for imbalanced classification\"\"\"\n    ce_loss = nn.CrossEntropyLoss(reduction='none')\n    ce = ce_loss(logits, targets)\n    \n    # Get predicted probabilities\n    p = torch.softmax(logits, dim=1)\n    p_t = p.gather(1, targets.unsqueeze(1)).squeeze(1)\n    \n    # Focal loss\n    focal_weight = (1 - p_t) ** gamma\n    loss = (focal_weight * ce).mean()\n    \n    return loss\n\n# Example\nlogits = torch.randn(32, 10)\ntargets = torch.randint(0, 10, (32,))\nloss = focal_loss(logits, targets)\nprint(f\"Focal Loss: {loss.item():.4f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
