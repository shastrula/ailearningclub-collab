      "outputs": [],
      "source": [
        [
          "python",
          "import torch\n\n# Create tensors different ways\nx = torch.tensor([1.0, 2.0, 3.0])  # From Python list\ny = torch.zeros(3, 4)               # 3x4 zeros\nz = torch.ones(2, 5)                # 2x5 ones\nw = torch.randn(3, 3)               # Random normal distribution\nr = torch.arange(0, 10, 2)          # [0, 2, 4, 6, 8]\n\n# Check properties\nprint(f\"x shape: {x.shape}, dtype: {x.dtype}, device: {x.device}\")\n# Output: x shape: torch.Size([3]), dtype: torch.float32, device: cpu\n\n# Reshape\nflat = torch.arange(12)\nreshaped = flat.reshape(3, 4)  # or flat.view(3, 4)\nprint(f\"Reshaped: {reshaped.shape}\")\n\n# Move to GPU (if available)\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nx_gpu = x.to(device)\nprint(f\"x_gpu device: {x_gpu.device}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\n\n# Arithmetic\na = torch.tensor([1.0, 2.0, 3.0])\nb = torch.tensor([4.0, 5.0, 6.0])\nc = a + b  # [5, 7, 9]\nd = a * b  # [4, 10, 18]\n\n# Matrix multiplication\nA = torch.randn(3, 4)\nB = torch.randn(4, 5)\nC = torch.matmul(A, B)  # or A @ B, shape (3, 5)\n\n# Reduction operations\nt = torch.tensor([[1.0, 2.0], [3.0, 4.0]])\nprint(f\"Sum: {t.sum()}\")          # 10\nprint(f\"Mean: {t.mean()}\")        # 2.5\nprint(f\"Sum along axis 0: {t.sum(dim=0)}\")  # [4, 6]\nprint(f\"Max: {t.max()}\")          # 4\n\n# Indexing\nprint(f\"t[0]: {t[0]}\")            # [1, 2]\nprint(f\"t[:, 1]: {t[:, 1]}\")      # [2, 4]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\n\n# Enable gradient tracking\nx = torch.tensor(2.0, requires_grad=True)\ny = x ** 2  # y = 4\n\n# Compute gradient: dy/dx = 2x = 4\ny.backward()\nprint(f\"Gradient dy/dx: {x.grad}\")  # 4.0\n\n# Important: gradients accumulate. Zero them before next backward\nx.grad.zero_()\n\n# Another example: chain rule\na = torch.tensor(3.0, requires_grad=True)\nb = torch.tensor(2.0, requires_grad=True)\nc = a * b + a ** 2  # c = 6 + 9 = 15\n\nc.backward()\nprint(f\"dc/da: {a.grad}\")  # b + 2*a = 2 + 6 = 8\nprint(f\"dc/db: {b.grad}\")  # a = 3"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Example: z = (x + y) * (x - y)\n\nForward pass:\nx (requires_grad=True)  --\u2510\n                         \u251c\u2192 Add \u2192 (x+y)  --\u2510\ny (requires_grad=True)  --\u2524              \u251c\u2192 Mul \u2192 z\n                         \u251c\u2192 Sub \u2192 (x-y) --\u2518\n\nBackward pass (chain rule):\ndz/dz = 1\ndz/d(x+y) = (x-y)  [from Mul node]\ndz/d(x-y) = (x+y)  [from Mul node]\ndz/dx = dz/d(x+y) * 1 + dz/d(x-y) * 1 = (x-y) + (x+y) = 2*x\ndz/dy = dz/d(x+y) * 1 + dz/d(x-y) * (-1) = (x-y) - (x+y) = -2*y"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\n\n# Build computational graph\nx = torch.tensor(2.0, requires_grad=True)\ny = torch.tensor(3.0, requires_grad=True)\n\nz = (x + y) * (x - y)  # z = 5 * (-1) = -5\n\nz.backward()\nprint(f\"dz/dx: {x.grad}\")  # 2*x = 4\nprint(f\"dz/dy: {y.grad}\")  # -2*y = -6\n\n# With matrices\nA = torch.randn(2, 3, requires_grad=True)\nB = torch.randn(3, 4, requires_grad=True)\nC = torch.matmul(A, B)\nloss = C.sum()  # Scalar loss\nloss.backward()\nprint(f\"A.grad shape: {A.grad.shape}\")  # (2, 3)\nprint(f\"B.grad shape: {B.grad.shape}\")  # (3, 4)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport torch.nn as nn\nimport torch.optim as optim\n\n# Simple network\nmodel = nn.Sequential(\n    nn.Linear(10, 5),\n    nn.ReLU(),\n    nn.Linear(5, 1)\n)\n\n# Loss and optimizer\nloss_fn = nn.MSELoss()\noptimizer = optim.SGD(model.parameters(), lr=0.01)\n\n# Dummy data\nx = torch.randn(32, 10)  # batch of 32, 10 features\ny = torch.randn(32, 1)   # batch of 32, 1 target\n\n# Training step\noutput = model(x)\nloss = loss_fn(output, y)\nprint(f\"Initial loss: {loss.item():.4f}\")\n\n# Backward pass: compute gradients\nloss.backward()\n\n# Check gradients exist\nfor name, param in model.named_parameters():\n    if param.grad is not None:\n        print(f\"{name} gradient shape: {param.grad.shape}\")\n\n# Update weights\noptimizer.step()\n\n# Zero gradients for next iteration\noptimizer.zero_grad()\n\n# New forward pass shows lower loss\noutput = model(x)\nloss = loss_fn(output, y)\nprint(f\"After update: {loss.item():.4f}\")"
        ]
      ]
    },
    {
