        [
          "python",
          "import torch\n\ndef numerical_gradient(f, x, eps=1e-5):\n    \"\"\"Numerically approximate gradient using finite differences\"\"\"\n    grad = torch.zeros_like(x)\n    x_flat = x.flatten()\n    grad_flat = grad.flatten()\n    \n    for i in range(len(x_flat)):\n        x_flat[i] += eps\n        fxh = f(x.clone())\n        x_flat[i] -= 2 * eps\n        fxl = f(x.clone())\n        x_flat[i] += eps\n        grad_flat[i] = (fxh - fxl) / (2 * eps)\n    \n    return grad\n\n# Test\nx = torch.tensor([1.0, 2.0], requires_grad=True)\ndef f(t):\n    return (t ** 2).sum()\n\nanalytical_grad = torch.autograd.functional.jacobian(f, x)\nprint(f\"Analytical: {analytical_grad}\")"
        ]
      ]
