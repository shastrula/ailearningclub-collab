        [
          "python",
          "# Enable gradient tracking\nx = torch.tensor(3.0, requires_grad=True)\ny = x**2 + 2*x + 1  # y = x^2 + 2x + 1\n\ny.backward()  # compute dy/dx\nprint(f\"x = {x.item()}, dy/dx = {x.grad.item()}\")  # dy/dx = 2x + 2 = 8\n\n# This is how neural networks learn!\n# Forward: compute output\n# Backward: compute gradients of loss w.r.t. all parameters\n# Update: adjust parameters to reduce loss"
        ]
      ]
