      "source": [
        "# Deep Learning - mod-23\n\n",
        "**Course:** deep-learning\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# AdamW optimizer with weight decay\noptimizer = torch.optim.AdamW(model.parameters(), lr=0.001, weight_decay=1e-4)\n\n# Custom learning rate by layer\nparam_groups = [\n    {'params': model.layer1.parameters(), 'lr': 0.0001},\n    {'params': model.layer2.parameters(), 'lr': 0.0005},\n    {'params': model.layer3.parameters(), 'lr': 0.001}\n]\noptimizer = torch.optim.Adam(param_groups)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Gradient accumulation for large batches\naccumulation_steps = 4\noptimizer.zero_grad()\n\nfor i, (data, target) in enumerate(dataloader):\n    output = model(data)\n    loss = criterion(output, target) / accumulation_steps\n    loss.backward()\n    \n    if (i + 1) % accumulation_steps == 0:\n        optimizer.step()\n        optimizer.zero_grad()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Mixed precision training\nfrom torch.cuda.amp import autocast, GradScaler\n\nscaler = GradScaler()\n\nfor data, target in dataloader:\n    optimizer.zero_grad()\n    with autocast():\n        output = model(data)\n        loss = criterion(output, target)\n    scaler.scale(loss).backward()\n    scaler.step(optimizer)\n    scaler.update()"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Warm up learning rate\ndef linear_warmup_lr(current_step, num_warmup_steps, initial_lr):\n    if current_step < num_warmup_steps:\n        return initial_lr * (current_step / num_warmup_steps)\n    return initial_lr\n\ninitial_lr = 0.001\nnum_warmup_steps = 100\nfor step in range(num_warmup_steps + 1000):\n    lr = linear_warmup_lr(step, num_warmup_steps, initial_lr)\n    for param_group in optimizer.param_groups:\n        param_group['lr'] = lr"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Debugging NaN/Inf values\ndef check_for_nan_inf(tensor, name=\"\"):\n    if torch.isnan(tensor).any():\n        print(f\"WARNING: NaN detected in {name}\")\n    if torch.isinf(tensor).any():\n        print(f\"WARNING: Inf detected in {name}\")\n\n# In training loop\noutput = model(data)\ncheck_for_nan_inf(output, \"model output\")\nloss = criterion(output, target)\ncheck_for_nan_inf(loss, \"loss\")"
        ]
      ]
    }
