        [
          "python",
          "# Save model weights (recommended)\ntorch.save(model.state_dict(), 'model.pt')\n\n# Load\nmodel = MLP(784, 256, 10)\nmodel.load_state_dict(torch.load('model.pt'))\nmodel.eval()\n\n# Save entire model (less portable)\ntorch.save(model, 'full_model.pt')"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "dummy_input = torch.randn(1, 784)\ntorch.onnx.export(model, dummy_input, 'model.onnx',\n                  input_names=['input'], output_names=['output'],\n                  dynamic_axes={'input': {0: 'batch_size'}})"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from fastapi import FastAPI\nimport torch\n\napp = FastAPI()\nmodel = MLP(784, 256, 10)\nmodel.load_state_dict(torch.load('model.pt'))\nmodel.eval()\n\n@app.post('/predict')\ndef predict(features: list[float]):\n    x = torch.tensor(features).unsqueeze(0)\n    with torch.no_grad():\n        output = model(x)\n    return {'prediction': output.argmax(dim=1).item(),\n            'confidence': output.softmax(dim=1).max().item()}"
        ]
      ]
    }
  ],
