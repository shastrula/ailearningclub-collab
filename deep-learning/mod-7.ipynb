        [
          "python",
          "class VisionTransformer(nn.Module):\n    def __init__(self, image_size=224, patch_size=16, num_classes=1000, d_model=768):\n        super().__init__()\n        num_patches = (image_size // patch_size) ** 2\n        \n        # Convert image patches to embeddings\n        self.patch_embedding = nn.Conv2d(3, d_model, kernel_size=patch_size, stride=patch_size)\n        \n        # Learnable class token\n        self.class_token = nn.Parameter(torch.randn(1, 1, d_model))\n        \n        # Positional encoding for patches + class token\n        self.pos_embedding = nn.Parameter(torch.randn(1, num_patches + 1, d_model))\n        \n        # Transformer\n        self.transformer = Transformer(d_model=d_model, num_heads=12, num_layers=12, d_ff=3072)\n        \n        # Classification head\n        self.classification_head = nn.Linear(d_model, num_classes)\n    \n    def forward(self, x):  # x: (batch, 3, 224, 224)\n        # Patch embedding\n        x = self.patch_embedding(x)  # (batch, d_model, 14, 14)\n        x = x.flatten(2).transpose(1, 2)  # (batch, 196, d_model)\n        \n        # Add class token\n        batch_size = x.shape[0]\n        class_tokens = self.class_token.expand(batch_size, -1, -1)\n        x = torch.cat([class_tokens, x], dim=1)  # (batch, 197, d_model)\n        \n        # Add positional encoding\n        x = x + self.pos_embedding\n        \n        # Transformer\n        x = self.transformer(x)\n        \n        # Classification: use class token\n        x = x[:, 0, :]  # (batch, d_model)\n        x = self.classification_head(x)\n        return x"
        ]
