      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport torch.nn as nn\n\n# Text example: predict next character\ntext = \"hello world\"\nvocab = sorted(set(text))\nchar_to_idx = {c: i for i, c in enumerate(vocab)}\nidx_to_char = {i: c for c, i in char_to_idx.items()}\n\n# Convert to indices\ndata = torch.tensor([char_to_idx[c] for c in text])\nprint(f\"Data: {data}\")  # [0, 1, 2, 2, 3, 4, 5, 3, 6, 2, 7]\n\n# Simple RNN model\nclass CharRNN(nn.Module):\n    def __init__(self, vocab_size, hidden_size):\n        super().__init__()\n        self.embedding = nn.Embedding(vocab_size, 32)\n        self.rnn = nn.RNN(32, hidden_size, batch_first=True)\n        self.fc = nn.Linear(hidden_size, vocab_size)\n    \n    def forward(self, x):\n        x = self.embedding(x)  # (batch, seq_len) \u2192 (batch, seq_len, 32)\n        out, hidden = self.rnn(x)  # out: (batch, seq_len, hidden_size)\n        logits = self.fc(out)  # (batch, seq_len, vocab_size)\n        return logits\n\nmodel = CharRNN(len(vocab), hidden_size=64)\nprint(f\"Model: {model}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport torch.nn as nn\n\n# LSTM for sequence classification\nclass TextClassifier(nn.Module):\n    def __init__(self, vocab_size, embedding_dim, hidden_dim, num_classes):\n        super().__init__()\n        self.embedding = nn.Embedding(vocab_size, embedding_dim)\n        self.lstm = nn.LSTM(embedding_dim, hidden_dim, batch_first=True)\n        self.fc = nn.Linear(hidden_dim, num_classes)\n    \n    def forward(self, x):\n        embedded = self.embedding(x)  # (batch, seq_len) \u2192 (batch, seq_len, emb_dim)\n        # lstm_out: (batch, seq_len, hidden_dim)\n        # hidden: (batch, hidden_dim) - last hidden state\n        lstm_out, (hidden, cell) = self.lstm(embedded)\n        \n        # Use last hidden state for classification\n        output = self.fc(hidden[-1])  # hidden[-1] is last timestep\n        return output\n\n# Example\nmodel = TextClassifier(vocab_size=1000, embedding_dim=50, hidden_dim=100, num_classes=2)\nx = torch.randint(0, 1000, (32, 20))  # batch_size=32, seq_len=20\nlogits = model(x)\nprint(f\"Output shape: {logits.shape}\")  # (32, 2)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch.nn as nn\n\n# GRU version\nclass TextClassifierGRU(nn.Module):\n    def __init__(self, vocab_size, embedding_dim, hidden_dim, num_classes):\n        super().__init__()\n        self.embedding = nn.Embedding(vocab_size, embedding_dim)\n        self.gru = nn.GRU(embedding_dim, hidden_dim, batch_first=True)\n        self.fc = nn.Linear(hidden_dim, num_classes)\n    \n    def forward(self, x):\n        embedded = self.embedding(x)\n        gru_out, hidden = self.gru(embedded)  # hidden: (batch, hidden_dim)\n        output = self.fc(hidden[-1])\n        return output\n\nmodel = TextClassifierGRU(1000, 50, 100, 2)"
        ]
      ]
    },
