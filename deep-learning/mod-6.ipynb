        [
          "python",
          "import torch\nimport torch.nn as nn\n\nclass CharRNNGenerator(nn.Module):\n    def __init__(self, vocab_size, embedding_dim, hidden_dim):\n        super().__init__()\n        self.embedding = nn.Embedding(vocab_size, embedding_dim)\n        self.lstm = nn.LSTM(embedding_dim, hidden_dim, batch_first=True)\n        self.fc = nn.Linear(hidden_dim, vocab_size)\n    \n    def forward(self, x, hidden=None):\n        embedded = self.embedding(x)\n        out, hidden = self.lstm(embedded, hidden)\n        logits = self.fc(out[:, -1, :])  # Use last timestep\n        return logits, hidden\n\n# Training\nmodel = CharRNNGenerator(vocab_size=100, embedding_dim=50, hidden_dim=128)\noptimizer = torch.optim.Adam(model.parameters(), lr=0.001)\n\n# Generate text\ndef generate_text(model, start_char, length=100, temperature=1.0):\n    model.eval()\n    chars = [start_char]\n    hidden = None\n    \n    with torch.no_grad():\n        for _ in range(length):\n            x = torch.tensor([char_to_idx[chars[-1]]])\n            logits, hidden = model(x.unsqueeze(0), hidden)\n            \n            # Temperature controls randomness\n            logits = logits / temperature\n            probs = torch.softmax(logits, dim=-1)\n            next_char_idx = torch.multinomial(probs, 1).item()\n            chars.append(idx_to_char[next_char_idx])\n    \n    return ''.join(chars)"
        ]
      ]
    }
