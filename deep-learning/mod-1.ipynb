      "outputs": [],
      "source": [
        [
          "python",
          "import numpy as np\n\n# Simple neuron computation\ndef neuron(inputs, weights, bias, activation='relu'):\n    \"\"\"Single neuron: output = activation(inputs \u00b7 weights + bias)\"\"\"\n    z = np.dot(inputs, weights) + bias\n    \n    if activation == 'relu':\n        return np.maximum(0, z)\n    elif activation == 'sigmoid':\n        return 1 / (1 + np.exp(-z))\n    elif activation == 'linear':\n        return z\n    \n    return z\n\n# Example\ninputs = np.array([2.0, 3.0, 1.0])\nweights = np.array([0.5, -0.3, 0.8])\nbias = 0.1\noutput = neuron(inputs, weights, bias, 'relu')\nprint(f\"Neuron output: {output}\")  # 1.4"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nimport torch.nn as nn\n\n# Simple network that approximates a function\nmodel = nn.Sequential(\n    nn.Linear(1, 64),      # Input \u2192 64 neurons\n    nn.ReLU(),             # Activation\n    nn.Linear(64, 32),     # 64 \u2192 32 neurons\n    nn.ReLU(),\n    nn.Linear(32, 1)       # 32 \u2192 1 output\n)\n\n# This network can approximate complex relationships\nx = torch.linspace(-10, 10, 100).unsqueeze(1)\ny = model(x)\nprint(f\"Model output shape: {y.shape}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
