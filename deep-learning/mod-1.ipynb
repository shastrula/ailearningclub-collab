          "import torch\nimport torch.nn as nn\n\n# Define a simple network\nmodel = nn.Sequential(\n    nn.Linear(784, 128),  # input layer: 784 pixels -> 128 neurons\n    nn.ReLU(),            # activation function\n    nn.Linear(128, 10)    # output: 128 -> 10 classes (digits 0-9)\n)\n\n# Forward pass\nx = torch.randn(1, 784)  # one image flattened\noutput = model(x)\nprediction = output.argmax(dim=1)\nprint(f\"Predicted digit: {prediction.item()}\")"
