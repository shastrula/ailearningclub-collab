      "source": [
        "# Llm Fine Tuning - mod-1\n\n",
        "**Course:** llm-fine-tuning\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Pseudocode showing parameter difference\n\n# Full fine-tuning\nmodel.train()  # All parameters become trainable\nfor param in model.parameters():\n    param.requires_grad = True\n# 7B parameters \u00d7 4 (gradient, optimizer states) = 28GB+ memory\n\n# Parameter-efficient (LoRA)\nfrom peft import get_peft_model, LoraConfig\nconfig = LoraConfig(r=8, lora_alpha=16)\nmodel = get_peft_model(model, config)\n# ~1-2M trainable parameters, ~4GB memory"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "W_new = W_frozen + \u0394W\n\u0394W = BA (where B and A are low-rank)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Example: LoRA adaptation concept\nimport torch\n\nhidden_dim = 4096  # Typical LLM hidden dimension\nrank = 8  # LoRA rank\n\n# Without LoRA: update 4096 \u00d7 4096 = 16.7M parameters\n# With LoRA: update 2 \u00d7 rank \u00d7 hidden_dim = 65K parameters\nprint(f'Parameters without LoRA: {hidden_dim * hidden_dim / 1e6:.1f}M')\nprint(f'Parameters with LoRA (rank={rank}): {2 * rank * hidden_dim / 1e6:.1f}M')\nprint(f'Compression ratio: {(hidden_dim * hidden_dim) / (2 * rank * hidden_dim):.1f}x')\n\n# During forward pass:\n# y = Wx + (BA)x (frozen W + learnable BA)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Example: Task where fine-tuning helps\n\n# Prompt-engineered approach (inconsistent):\nprompt = \"\"\"Extract the company name from this text:\n'Acme Corp's Q4 earnings were strong.'\nCompany name:\"\"\"\n# Model might output \"Acme Corp\", \"Acme Corp's\", or \"Acme\"\n\n# After fine-tuning on examples (consistent):\n# With consistent format in training data, model reliably outputs \"Acme Corp\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Resource comparison\n\n# Full fine-tuning 7B model:\n# GPU memory needed: ~24-48GB\n# Training time for 10K examples: 8-24 hours (consumer GPU)\n# Inference overhead: none (model weights change)\n\n# LoRA 7B model:\n# GPU memory needed: ~6-12GB\n# Training time for 10K examples: 1-3 hours\n# Inference overhead: minimal (just A\u00d7B computation)\n\n# In practice, for resource-constrained users, parameter-efficient methods\n# open fine-tuning to consumer hardware"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from transformers import AutoModelForCausalLM, AutoTokenizer, TrainingArguments, Trainer\nfrom peft import LoraConfig, get_peft_model\nfrom datasets import Dataset\n\n# This pattern works for most models and tasks\nmodel_name = \"meta-llama/Llama-2-7b\"\nmodel = AutoModelForCausalLM.from_pretrained(model_name, load_in_8bit=True)\ntokenizer = AutoTokenizer.from_pretrained(model_name)\n\n# Apply LoRA\nconfig = LoraConfig(\n    r=16,\n    lora_alpha=32,\n    lora_dropout=0.05,\n    bias=\"none\",\n    task_type=\"CAUSAL_LM\"\n)\nmodel = get_peft_model(model, config)\n\n# Training setup\ntraining_args = TrainingArguments(\n    output_dir=\"./results\",\n    num_train_epochs=3,\n    per_device_train_batch_size=4,\n    gradient_accumulation_steps=4,\n    learning_rate=2e-4,\n    warmup_steps=100\n)\n\ntrainer = Trainer(\n    model=model,\n    args=training_args,\n    train_dataset=train_dataset\n)\n\ntrainer.train()"
        ]
      ]
    }
  ],
