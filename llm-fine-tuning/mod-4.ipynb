      "source": [
        "# Llm Fine Tuning - mod-4\n\n",
        "**Course:** llm-fine-tuning\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Floating-point weight: -2.7\n\u2192 Quantize (map to nearest 4-bit integer): -3\n\u2192 Store as 4-bit: 1101\n\u2192 Dequantize (reverse operation): -2.8\n\u2192 Use in forward pass\n\nError: 0.1 (typically acceptable)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "Data type values: [-1.0, -0.6961, -0.5250, -0.3949, -0.2844, -0.1848,\n                   -0.0911, 0, 0.0795, 0.1711, 0.2565, 0.3504,\n                   0.4762, 0.5484, 0.7227, 1.0]"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# NF4 vs standard quantization concept\n\nimport numpy as np\n\n# Simulate weight distribution (typically normal-ish)\nweights = np.random.normal(0, 0.5, 1000)\n\n# Standard 4-bit: 16 equally-spaced values from min to max\nstd_bins = np.linspace(weights.min(), weights.max(), 16)\n\n# NF4: 16 values optimized for normal distribution\nnf4_bins = [-1.0, -0.6961, -0.5250, -0.3949, -0.2844, -0.1848,\n            -0.0911, 0, 0.0795, 0.1711, 0.2565, 0.3504,\n            0.4762, 0.5484, 0.7227, 1.0]\n\n# Quantize using both schemes\nstd_quantized = np.digitize(weights, std_bins)\nnf4_quantized = np.digitize(weights, nf4_bins)\n\n# Reconstruction error\nstd_error = np.mean(np.abs(weights - std_bins[std_quantized]))\nnf4_error = np.mean(np.abs(weights - nf4_bins[nf4_quantized]))\n\nprint(f'Standard 4-bit error: {std_error:.4f}')\nprint(f'NF4 error: {nf4_error:.4f}')\n# NF4 typically 20-30% lower error"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Memory calculation for fine-tuning 7B model\n\n# Full precision training (16-bit)\nmodel_params = 7e9\nbytes_per_param_fp16 = 2\nmodel_memory_fp16 = model_params * bytes_per_param_fp16 / 1e9  # GB\n# Gradients + optimizer states (Adam): 4x model\ntotal_memory_fp16 = model_memory_fp16 * 4\nprint(f'Full fine-tuning (FP16): {total_memory_fp16:.1f} GB')\n\n# LoRA (16-bit frozen model, low-rank matrices)\nlora_rank = 8\nlora_params = 2 * lora_rank * 4096 * 50  # Approximate for all layers\ntotal_memory_lora = model_memory_fp16 + (lora_params * 2 * 4 / 1e9)\nprint(f'LoRA (16-bit): {total_memory_lora:.1f} GB')\n\n# QLoRA (4-bit frozen model, 16-bit LoRA)\nmodel_memory_4bit = model_params * 0.5 / 1e9  # 4-bit quantized\ntotal_memory_qlora = model_memory_4bit + (lora_params * 2 * 4 / 1e9)\nprint(f'QLoRA (4-bit + LoRA): {total_memory_qlora:.1f} GB')\n\n# Output:\n# Full fine-tuning (FP16): 56.0 GB\n# LoRA (16-bit): 28.0 GB\n# QLoRA (4-bit + LoRA): 6.5 GB\n\n# QLoRA is 8-9x more memory efficient than full fine-tuning"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "# Install required packages\npip install transformers peft bitsandbytes datasets torch\n\n# For GPU support, ensure CUDA is available\n# Check: python -c \"import torch; print(torch.cuda.is_available())\""
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "import torch\nfrom transformers import AutoModelForCausalLM, AutoTokenizer, TrainingArguments, Trainer\nfrom peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training\nfrom datasets import load_dataset\nfrom bitsandbytes.optim import PagedAdamW8bit\n\n# Step 1: Load model in 4-bit quantization\nmodel_name = \"meta-llama/Llama-2-7b-hf\"\nmodel = AutoModelForCausalLM.from_pretrained(\n    model_name,\n    quantization_config={\n        \"load_in_4bit\": True,\n        \"bnb_4bit_compute_dtype\": torch.float16,\n        \"bnb_4bit_use_double_quant\": True,\n        \"bnb_4bit_quant_type\": \"nf4\"\n    },\n    device_map=\"auto\"\n)\n\n# Prepare model for training with quantization\nmodel = prepare_model_for_kbit_training(model)\n\n# Step 2: Apply LoRA\nlora_config = LoraConfig(\n    r=16,                          # LoRA rank\n    lora_alpha=32,                 # LoRA scaling\n    target_modules=[\"q_proj\", \"v_proj\"],  # Which layers to apply LoRA\n    lora_dropout=0.05,\n    bias=\"none\",\n    task_type=\"CAUSAL_LM\"\n)\nmodel = get_peft_model(model, lora_config)\n\n# Step 3: Configure training\ntraining_args = TrainingArguments(\n    output_dir=\"./qlora_results\",\n    num_train_epochs=3,\n    per_device_train_batch_size=4,\n    gradient_accumulation_steps=4,\n    learning_rate=2e-4,\n    warmup_steps=100,\n    weight_decay=0.01,\n    optim=\"paged_adamw_8bit\",  # Memory-efficient optimizer\n    save_strategy=\"epoch\",\n    logging_steps=10\n)\n\n# Create trainer and train\ntokenizer = AutoTokenizer.from_pretrained(model_name)\ntrain_dataset = load_dataset(\"wikitext\", \"wikitext-2-raw-v1\", split=\"train[:5%]\")\n\ntrainer = Trainer(\n    model=model,\n    args=training_args,\n    train_dataset=train_dataset,\n    tokenizer=tokenizer\n)\n\ntrainer.train()\n\n# Save the fine-tuned LoRA weights\nmodel.save_pretrained(\"qlora_adapter\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from peft import AutoPeftModelForCausalLM\n\n# Load the quantized base model + LoRA adapter\nmodel = AutoPeftModelForCausalLM.from_pretrained(\n    \"qlora_adapter\",\n    device_map=\"auto\"\n)\n\n# Merge LoRA weights into base model (optional, for deployment)\nmerged_model = model.merge_and_unload()\n\n# Use for inference\ntokenizer = AutoTokenizer.from_pretrained(\"meta-llama/Llama-2-7b-hf\")\ninputs = tokenizer(\"Tell me about\", return_tensors=\"pt\").to(\"cuda\")\noutputs = model.generate(**inputs, max_length=100)\nprint(tokenizer.decode(outputs[0]))"
        ]
      ]
    }
