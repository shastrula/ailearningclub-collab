      "outputs": [],
      "source": [
        [
          "python",
          "# Fine-tune a model with LoRA (using PEFT)\nfrom peft import LoraConfig, get_peft_model\nfrom transformers import AutoModelForCausalLM\n\nmodel = AutoModelForCausalLM.from_pretrained(\"meta-llama/Llama-2-7b-hf\")\nlora_config = LoraConfig(r=8, lora_alpha=16, target_modules=[\"q_proj\", \"v_proj\"])\nmodel = get_peft_model(model, lora_config)\nprint(f\"Trainable params: {model.print_trainable_parameters()}\")"
        ]
      ]
    }
  ],
