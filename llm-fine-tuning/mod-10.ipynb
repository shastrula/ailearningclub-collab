        [
          "python",
          "- Use 31K prompts (mixed SFT + RL batches)\n- Generate outputs with current policy\n- Score using reward model + KL penalty (vs SFT model)\n- Update policy using PPO\n- Output: RLHF-trained model"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from trl import PPOTrainer, PPOConfig, AutoModelForCausalLMWithValueHead\nfrom transformers import AutoTokenizer, AutoModelForCausalLM\nimport torch\n\n# Setup\nmodel_name = \"meta-llama/Llama-2-7b-hf\"\nbase_model = AutoModelForCausalLM.from_pretrained(model_name)\nmodel = AutoModelForCausalLMWithValueHead.from_pretrained(model_name)\ntokenizer = AutoTokenizer.from_pretrained(model_name)\n\n# Reference model (frozen copy for KL penalty)\nref_model = AutoModelForCausalLM.from_pretrained(model_name)\n\n# Load pre-trained reward model\nreward_model = AutoModelForCausalLM.from_pretrained(\"path/to/reward_model\")\n\n# Configure PPO\nppo_config = PPOConfig(\n    model_name=model_name,\n    learning_rate=1e-5,\n    log_with=\"wandb\",\n    mini_batch_size=4,\n    batch_size=16,\n    gradient_accumulation_steps=1,\n    ppo_epochs=4,\n    target_kl=0.1\n)\n\n# Initialize trainer\nppo_trainer = PPOTrainer(\n    ppo_config,\n    model,\n    ref_model,\n    tokenizer,\n    dataset=train_dataset,\n    data_collator=collate_fn\n)\n\n# Training loop\nfor epoch in range(3):\n    for batch in ppo_trainer.dataloader:\n        queries = batch[\"input_ids\"]\n        \n        # Generate responses\n        responses = ppo_trainer.generate(\n            queries,\n            max_length=200,\n            temperature=0.7\n        )\n        \n        # Get rewards from reward model\n        rewards = reward_model(queries, responses)\n        \n        # PPO update\n        stats = ppo_trainer.step(queries, responses, rewards)\n        \n        print(f\"Loss: {stats['loss']:.3f}, Reward: {stats['mean_reward']:.3f}\")"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# DPO loss (simplified)\n# Rather than training reward_model + then PPO,\n# directly optimize: chosen_logprobs > rejected_logprobs\n\ndef dpo_loss(model, prompt, chosen, rejected, temperature=0.1):\n    \"\"\"Direct preference optimization loss\"\"\"\n    \n    # Get log probabilities\n    chosen_logprobs = model(prompt, chosen).log_probs.mean()\n    rejected_logprobs = model(prompt, rejected).log_probs.mean()\n    \n    # DPO objective: maximize difference in log probs\n    loss = -torch.log(\n        torch.sigmoid(temperature * (chosen_logprobs - rejected_logprobs))\n    )\n    \n    return loss"
        ]
      ]
    }
