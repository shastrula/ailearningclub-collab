    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# LLM Fine-tuning concepts (simplified)\n# In production: use Hugging Face transformers + PEFT\n\nfrom dataclasses import dataclass\n\n@dataclass\nclass FineTuneConfig:\n    base_model: str\n    method: str  # \"full\", \"lora\", \"qlora\"\n    learning_rate: float\n    epochs: int\n    batch_size: int\n    lora_rank: int = 8\n    lora_alpha: int = 16\n\n# Compare fine-tuning approaches\nconfigs = {\n    \"Full Fine-tune\": FineTuneConfig(\"llama-7b\", \"full\", 2e-5, 3, 4),\n    \"LoRA\": FineTuneConfig(\"llama-7b\", \"lora\", 3e-4, 3, 8, lora_rank=8),\n    \"QLoRA\": FineTuneConfig(\"llama-7b\", \"qlora\", 2e-4, 3, 4, lora_rank=16),\n}\n\nprint(\"Fine-tuning Methods Comparison:\")\nprint(f\"{'Method':<16} {'LR':<10} {'Rank':<6} {'Trainable %':<12}\")\nprint(\"-\" * 44)\nfor name, cfg in configs.items():\n    # Approximate trainable parameters\n    trainable = \"100%\" if cfg.method == \"full\" else f\"~{cfg.lora_rank * 2 * 4096 / 7e9 * 100:.2f}%\"\n    print(f\"{name:<16} {cfg.learning_rate:<10.0e} {cfg.lora_rank:<6} {trainable:<12}\")\n\n# Example training data format\ntraining_examples = [\n    {\"instruction\": \"Summarize this text\", \"input\": \"Long article...\", \"output\": \"Brief summary\"},\n    {\"instruction\": \"Translate to French\", \"input\": \"Hello world\", \"output\": \"Bonjour le monde\"},\n]\nprint(f\"\\nTraining examples: {len(training_examples)}\")"
        ]
      ]
    }
  ],
