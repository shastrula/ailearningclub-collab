  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Vllm Serving - mod-3\n\n",
        "**Course:** vllm-serving\n\n",
        "Run the code cells below to practice.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "bash",
          "pip install vllm\n\n# Launch an OpenAI-compatible server on port 8000\npython -m vllm.entrypoints.openai.api_server \\\n    --model meta-llama/Llama-3.1-8B-Instruct \\\n    --gpu-memory-utilization 0.90 \\\n    --max-model-len 8192 \\\n    --enable-prefix-caching"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from openai import OpenAI\n\nclient = OpenAI(base_url=\"http://localhost:8000/v1\", api_key=\"not-needed\")\n\nresp = client.chat.completions.create(\n    model=\"meta-llama/Llama-3.1-8B-Instruct\",\n    messages=[{\"role\": \"user\", \"content\": \"Explain KV cache in one sentence.\"}],\n    max_tokens=128,\n    temperature=0.2,\n)\nprint(resp.choices[0].message.content)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "stream = client.chat.completions.create(\n    model=\"meta-llama/Llama-3.1-8B-Instruct\",\n    messages=[{\"role\": \"user\", \"content\": \"Write a haiku about GPUs.\"}],\n    stream=True,\n)\nfor chunk in stream:\n    delta = chunk.choices[0].delta.content or \"\"\n    print(delta, end=\"\", flush=True)"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "from vllm import LLM, SamplingParams\n\nllm = LLM(model=\"meta-llama/Llama-3.1-8B-Instruct\", gpu_memory_utilization=0.9)\nparams = SamplingParams(temperature=0.0, max_tokens=256)\n\nprompts = [f\"Summarize: {doc}\" for doc in documents]   # thousands at once\noutputs = llm.generate(prompts, params)                # continuous batching under the hood\nfor o in outputs:\n    print(o.outputs[0].text)"
        ]
      ]
    }
  ],
