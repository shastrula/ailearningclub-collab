          "text",
          "Logical view (request A):   [tok0 tok1 tok2 tok3 tok4 tok5 ...]\nBlock table (A):            blk 7 -> blk 3 -> blk 9 ...\nPhysical blocks (shared):   [ ... 3 ... 7 ... 9 ... ]  <- reused across requests"
        ]
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        [
          "python",
          "# Conceptual scheduler loop (what vLLM does for you)\nwhile running or waiting:\n    batch = running + admit_new(waiting, free_kv_blocks())  # fill to memory budget\n    logits = model.step(batch)                              # one token each\n    for seq in batch:\n        seq.append(sample(logits[seq]))\n        if seq.is_finished():\n            free_blocks(seq); running.remove(seq)           # leave immediately"
        ]
      ]
    }
